#!/usr/bin/env bash
# tehas stop <issue>: end a cycle by hand and clear what it left on this host.
#
# A cycle that outlived its work takes six steps to clear by hand: stop the
# unit, remove the container, take away the lock and the markers that make this
# host think a cycle still runs, remove the workspace, its transcripts and its
# console file, and take tehas:running off the issue. This does the host's half
# at once, then the issue's: when it stopped or removed something here and
# nothing of that failed, it reads the issue's labels and takes tehas:running
# off when it is there and no cycle of this issue holds its lock again. It adds
# no other label and writes no comment. A run that found nothing to do on this
# host asks GitHub for nothing, so a second run is a no-op twice.
#
# What goes is only what says a cycle runs, is owed, or is parked:
#
#   state/cycles/<issue>.lock .cid .done .stalled .timed .oom
#                  .forks .nostart .nostart.new .progress.json .result.json
#   state/cycles/<issue>.stopped .stopped.new, left by an earlier stop
#   the issue's current park on the state store asks for nothing more: its
#                  question is taken off the record (its boxes start nothing)
#                  and its one retry is spent, so the dispatcher does not start
#                  the issue again on its own after a provider outage
#   live/console-<issue>.txt
#   ~/.pi/agent/ensemble-runs/issue-<issue>
#   work/<repo>-<issue>, with its .state, .before-retry and .images beside it,
#                  unless --keep-workspace
#
# Before the unit is asked to stop, one line goes to state/cycles/<issue>.stopped:
# the time and the account. tehasbot cycle reads it and says in the record that
# a person stopped the cycle. When it cannot be written, the stop goes through
# and says so on stderr.
#
# The park is cleared after that, before the lock file goes, and a park that
# cannot be cleared leaves everything where it is, says so, and exits 1. A
# park that still asks for something counts as something to stop; a park
# itself stays on record, with the cycle's history.
#
# A cycle killed outright never reports, and its record on the state store
# stays open. Once the unit is gone and the lock is free, this ends that record
# as stopped (cycle-end --stopped), before the lock file goes: an open record
# with no lock file reads as a cycle whose lock cannot be probed. A record that
# cannot be ended leaves the lock file and everything else where it is, says
# so, and exits 1: run it again. An open record counts as something to stop.
#
# What stays is the cycle's record and every log: its record, history and
# approval on the state store, state/cycles/<issue>.json, .manifest.json,
# .runner_exit and .status, and everything under logs/. A cycle stopped by hand
# did not end well, and nothing here records its pi-rukas as proven.
#
# Usage:
#   tehas stop <issue>                    end the cycle, take its workspace too
#   tehas stop <issue> --keep-workspace   end it and keep the workspace to read
#   tehas stop -h|--help                  print this text and exit 0
#
# Each path is built from TEHAS_HOME, the repository name in the settings and
# the issue number, never from a glob: stopping #5 touches nothing of #51 or
# #55. Nothing is removed while a cycle holds that issue's lock, and the lock is
# held for as long as the removals take, so no cycle starts among them.
#
# Exit: 0 the cycle is stopped and its leftovers are gone, or there was nothing
# to do, which makes a second run safe; 1 the cycle still holds its lock after
# the stop, or a stop or a removal failed, or tehas:running could not be read
# off the issue or taken off it, or a cycle of that issue took its lock again
# before the label was read, or the state store could not be read, did not
# end the open record or did not clear the park; 64 no issue number, an issue that is not a positive
# number, or an argument this does not know; 78 the instance settings are
# missing or malformed, or the state store is not installed or cannot be used,
# which changes nothing.
#
# Instance settings (lib/config.sh): TEHAS_REPO, for the name libexec/work gives
# the workspace and for the issue this reads its labels from and relabels.
set -uo pipefail

show_usage() {
  sed -n '2,/^[^#]/p' "$0" | sed -n '/^#/s/^# \{0,1\}//p'
}

issue=""
keep=0
while [ "$#" -gt 0 ]; do
  case "$1" in
    -h | --help)
      show_usage
      exit 0
      ;;
    --keep-workspace) keep=1 ;;
    -*)
      printf 'tehas stop: unknown argument: %s\n' "$1" >&2
      show_usage >&2
      exit 64
      ;;
    *)
      [ -z "$issue" ] || { echo "tehas stop: one issue number at most" >&2; exit 64; }
      issue=$1
      ;;
  esac
  shift
done
if [ -z "$issue" ]; then
  echo "tehas stop: it needs an issue number" >&2
  show_usage >&2
  exit 64
fi
[[ $issue =~ ^[1-9][0-9]{0,9}$ ]] || {
  printf 'tehas stop: not an issue number: %s\n' "$issue" >&2
  exit 64
}

here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source=lib/config.sh
. "$here/../lib/config.sh"
# shellcheck source=lib/cycles.sh
. "$here/../lib/cycles.sh"
# shellcheck source=lib/store.sh
. "$here/../lib/store.sh"
tehas_load || exit 78
tehas_require TEHAS_REPO
if ! tehas_store_ready; then
  echo "tehas stop: ERROR: the state store is not installed (run install.sh)" >&2
  exit 78
fi

n=$issue
unit=tehas-cycle@$n.service
container=tehas-work-$n
state=$TEHAS_HOME/state/cycles
lock=$state/$n.lock
# The workspace libexec/work clones for this issue and what it leaves beside
# it, named the way libexec/work names them, so this removes what a cycle made.
ws=$TEHAS_WORK_DIR-$n
runs=$HOME/.pi/agent/ensemble-runs/issue-$n
# The markers that say this issue's cycle runs, owes something, or is parked.
# The one sibling name belongs here too: a write of a note is made beside it and
# moved into place, and a stop that takes the note takes the name of a write
# that never finished, as libexec/work's own clear of these files does.
notes=(lock cid "done" stalled timed stopped oom forks nostart nostart.new progress.json result.json)

# said <path>: one line for a thing that went, in the shape a person types.
said() {
  local p=$1
  case "$p" in
    "$TEHAS_HOME"/*) printf 'removed %s\n' "${p#"$TEHAS_HOME"/}" ;;
    "$HOME"/*) printf 'removed ~/%s\n' "${p#"$HOME"/}" ;;
    *) printf 'removed %s\n' "$p" ;;
  esac
}

# open_attempt <issue>: sets open_at to the attempt of the cycle's record when
# it is open, empty when it has ended or there is none. Exits when the store
# could not answer: nothing has changed yet, or the step after it waits.
open_attempt() {
  open_at=""
  if ! tehas_store cycle-show "$1"; then
    printf 'tehas stop: the record of #%s could not be read from the state store: %s\n' "$1" "$tehas_store_line" >&2
    [ "$tehas_store_rc" = 1 ] && exit 1
    exit 78
  fi
  open_at=$(tehas_store_get '.cycle | select(. != null and .ended_at == null) | .attempt')
}

# park_owed <issue>: sets park_q to the question of the issue's current park,
# park_retry to 1 when its one retry is not spent, and park_owes to 1 when
# either is so. Exits when the store could not answer, as open_attempt does.
park_owed() {
  park_q="" park_retry=0 park_owes=0
  if ! tehas_store park-show "$1"; then
    printf 'tehas stop: the park of #%s could not be read from the state store: %s\n' "$1" "$tehas_store_line" >&2
    [ "$tehas_store_rc" = 1 ] && exit 1
    exit 78
  fi
  park_q=$(tehas_store_get '.park.question // empty')
  [ "$(tehas_store_get '.park.retries')" != 0 ] || park_retry=1
  [ -z "$park_q" ] && [ "$park_retry" = 0 ] || park_owes=1
}

# What is here, read before anything changes: a run that has nothing to do says
# so and touches nothing, so running this twice is safe.
open_attempt "$n"
park_owed "$n"
present=()
for e in "${notes[@]}"; do
  [ -e "$state/$n.$e" ] && present+=("$state/$n.$e")
done
for f in "$TEHAS_HOME/live/console-$n.txt" "$runs"; do
  [ -e "$f" ] && present+=("$f")
done
if [ "$keep" = 0 ]; then
  for f in "$ws" "$ws.state" "$ws.before-retry" "$ws.images"; do
    [ -e "$f" ] && present+=("$f")
  done
fi

# The unit and the container, read the same way. A container name is matched as
# a whole line: tehas-work-5 is not tehas-work-51.
unit_state=$(timeout 10 systemctl --user show -p ActiveState --value "$unit" 2>/dev/null) || unit_state=""
case "$unit_state" in active | activating) unit_live=1 ;; *) unit_live=0 ;; esac
names=$(timeout 10 docker ps -a --format '{{.Names}}' 2>/dev/null) || names=""
container_live=0
case $'\n'"$names"$'\n' in
  *$'\n'"$container"$'\n'*) container_live=1 ;;
esac
lock_held=0
tehas_cycle_running "$n" && lock_held=1

if [ "$unit_live" = 0 ] && [ "$container_live" = 0 ] && [ "$lock_held" = 0 ] &&
  [ "${#present[@]}" = 0 ] && [ -z "$open_at" ] && [ "$park_owes" = 0 ]; then
  printf 'nothing to stop for #%s\n' "$n"
  exit 0
fi

# The marker of this stop: the epoch seconds and the account, written before
# the unit is asked to stop, since the cycle may report as soon as it stops.
# It goes through a temporary name and is read back; when it cannot be written
# or read back, that is said on stderr and the stop goes through all the same.
# A run that only clears leftovers writes none.
asked_to_stop=0
marker_this=1
stopped_marker=$state/$n.stopped
if [ "$unit_live" = 1 ] || [ "$lock_held" = 1 ]; then
  asked_to_stop=1
  mkdir -p "$state" 2>/dev/null
  # Read back: a name the move could not replace, such as a directory, keeps
  # what it held.
  if ! printf '%s %s\n' "$(date +%s)" "$(id -un)" >"$stopped_marker.new" 2>/dev/null ||
    ! mv -f -- "$stopped_marker.new" "$stopped_marker" 2>/dev/null ||
    ! read -r marker_at marker_by _ <"$stopped_marker" 2>/dev/null ||
    [[ ! $marker_at =~ ^(0|[1-9][0-9]{0,9})$ ]] ||
    [[ ! $marker_by =~ ^[A-Za-z0-9._-]{1,64}$ ]]; then
    rm -f -- "$stopped_marker.new" 2>/dev/null
    printf 'tehas stop: %s could not be written, so nothing says a person stopped this cycle\n' \
      "${stopped_marker#"$TEHAS_HOME"/}" >&2
    marker_this=0
  fi
fi

# A marker this run did not write, or wrote and could not read back, goes with
# the leftovers.
if [ "$asked_to_stop" = 0 ] || [ "$marker_this" = 0 ]; then
  for f in "$stopped_marker" "$stopped_marker.new"; do
    [ -e "$f" ] && present+=("$f")
  done
fi

rc=0
# Stop the unit and wait for its cycle to let go of its lock, as the poll does
# when it stops a cycle whose work is done: the runner reports as it stops.
if [ "$unit_live" = 1 ] || [ "$lock_held" = 1 ]; then
  if timeout -k 5 30 systemctl --user stop "$unit" 2>&1; then
    printf 'stopped %s\n' "$unit"
  else
    printf 'tehas stop: could not stop %s\n' "$unit" >&2
    rc=1
  fi
  for ((i = 0; i < 20; i++)); do
    tehas_cycle_running "$n" || break
    sleep 0.5
  done
  if tehas_cycle_running "$n"; then
    printf 'tehas stop: the cycle for #%s still holds its lock after the stop, so nothing was removed. It needs a person: stop it with systemctl --user stop %s and run this again.\n' \
      "$n" "$unit" >&2
    exit 1
  fi
fi

# The container of a cycle whose client died works on with the bot's token, and
# the next start under its name would fail.
if [ "$container_live" = 1 ]; then
  if timeout 30 docker rm -f "$container" >/dev/null 2>&1; then
    printf 'removed the container %s\n' "$container"
  else
    printf 'tehas stop: could not remove the container %s\n' "$container" >&2
    rc=1
  fi
fi

# A lock that is not a plain file says nothing about this issue, and taking it
# would write through it. Nothing is removed for such a file.
if [ -e "$lock" ] && { [ -L "$lock" ] || [ ! -f "$lock" ]; }; then
  printf 'tehas stop: %s is not a lock file, so nothing was removed.\n' "${lock#"$TEHAS_HOME"/}" >&2
  exit 1
fi

# The lock is held for the removals, as the workspace sweep holds it: no cycle
# of this issue starts while its leftovers go. It goes with them, so a later
# cycle takes a fresh one, and the file this opened is removed whatever it was
# before, which is why its line is said only when it was here to begin with.
mkdir -p "$state" || { echo "tehas stop: $state could not be created" >&2; exit 1; }
exec 9>"$lock"
# The record of a cycle killed outright is ended now, while its lock file is
# there and free: the cycle reported if it could, so a record still open is one
# that never will.
open_attempt "$n"
if [ -n "$open_at" ]; then
  if ! tehas_store_try 3 cycle-end "$n" --attempt "$open_at" --stopped; then
    if [ "$tehas_store_word" = running ]; then
      printf 'tehas stop: a cycle for #%s holds its lock, so nothing was removed.\n' "$n" >&2
    else
      printf 'tehas stop: the record of #%s could not be ended as stopped (%s), so nothing was removed. Run this again.\n' \
        "$n" "$tehas_store_line" >&2
    fi
    exit 1
  fi
  printf 'ended the record of the cycle of #%s as stopped\n' "$n"
fi
if ! flock -n 9; then
  printf 'tehas stop: a cycle for #%s holds its lock, so nothing was removed.\n' "$n" >&2
  exit 1
fi
# The park as the cycle left it, read again: a cycle that stopped just now
# may have parked as it reported.
park_owed "$n"
if [ -n "$park_q" ]; then
  if ! tehas_store_try 3 question-answered "$n" --id "$park_q" --withdraw && [ "$tehas_store_word" != unknown ]; then
    printf 'tehas stop: the park question of #%s could not be taken off the record (%s), so nothing was removed. Run this again.\n' \
      "$n" "$tehas_store_line" >&2
    exit 1
  fi
  printf 'took the park question of #%s off the record\n' "$n"
fi
if [ "$park_retry" = 1 ]; then
  if ! tehas_store_try 3 park-retry "$n" && [ "$tehas_store_word" != unparked ]; then
    printf 'tehas stop: the retry of the park of #%s could not be spent (%s), so nothing was removed. Run this again.\n' \
      "$n" "$tehas_store_line" >&2
    exit 1
  fi
  printf 'spent the retry of the park of #%s\n' "$n"
fi
had_lock=0
for f in "${present[@]}"; do
  if [ "$f" = "$lock" ]; then
    had_lock=1
    continue
  fi
  if rm -rf -- "$f" 2>/dev/null; then
    said "$f"
  else
    printf 'tehas stop: could not remove %s\n' "$f" >&2
    rc=1
  fi
done
if rm -f -- "$lock" 2>/dev/null; then
  [ "$had_lock" = 1 ] && said "$lock"
else
  printf 'tehas stop: could not remove %s\n' "$lock" >&2
  rc=1
fi
exec 9>&-

# The last step, the issue's half. A run with nothing to do here exited above,
# so reaching it means this stopped or removed something, and it runs only when
# nothing of that failed, because tehas:running comes off an issue whose cycle
# really ended. Each call is bounded, as the cycle bounds its own: gh reads an
# issue's labels as an object, so the filter is .labels[].name.
if [ "$rc" = 0 ]; then
  if ! labels=$(timeout 10 gh issue view "$n" --repo "$TEHAS_REPO" --json labels \
    --jq '.labels[].name' 2>/dev/null); then
    printf 'WARN: the labels of #%s could not be read, so tehas:running stays on the issue\n' "$n" >&2
    rc=1
  else
    # A label name is matched as a whole line: tehas:running is not a longer
    # name that starts with it.
    running=0
    case $'\n'"$labels"$'\n' in
      *$'\n'tehas:running$'\n'*) running=1 ;;
    esac
    if [ "$running" = 1 ]; then
      # The lock is checked before the edit, as tidy checks it before its own:
      # a cycle that took this issue's lock again while the host was cleared
      # owns tehas:running now.
      if tehas_cycle_running "$n"; then
        printf 'WARN: a cycle for #%s holds its lock again, so tehas:running stays on the issue\n' "$n" >&2
        rc=1
      elif timeout 10 gh issue edit "$n" --repo "$TEHAS_REPO" \
        --remove-label tehas:running >/dev/null 2>&1; then
        printf 'removed tehas:running from #%s\n' "$n"
      else
        printf 'WARN: tehas:running could not be taken off #%s\n' "$n" >&2
        rc=1
      fi
    fi
  fi
fi

exit "$rc"
