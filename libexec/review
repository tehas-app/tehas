#!/usr/bin/env bash
# Review what the default branch gained since the last reviewed commit, with
# pi-rukas's lens reviewer running headless in the sandbox image.
#
# Part of the review loop. This command runs the review and records what it
# read; it files nothing. Filing the findings is #508, and the unit that runs
# it on a timer is #509.
#
# Each run is one turn of pi-rukas's headless runner,
# `pi-rukas-headless lens-review --since <commit> --json`, over a clone of the
# default branch made fresh for the run and removed when it is over. Where to
# start from is read from $TEHAS_HOME/state/review.json: the commit the last
# review read. With none there - a host that never reviewed anything, or one
# whose record is gone - the run starts at the commit 7 days back on the
# branch, or at the root when the branch is younger than that.
#
# What a review is for is the whole range, so a run that failed records
# nothing: the next one reads the same commits again. Only the exits that mean
# the reviewer answered (0, 10 and 20 below) move the record on.
#
# Usage:
#   tehasbot review             one review
#   tehasbot review -h|--help   print this text and exit 0
#
# The exits that mean the reviewer answered - 0, 10 and 20 - record the commit
# that was read; anything else leaves the record exactly as it was, so the same
# range is read again. What the runner writes and the status of its container
# have to agree before either is believed. The table of exits, what the
# container is given and where the workspace and the logs go are in
# host/docs/tools.md, which is the one account of them.
#
# Exit status: 0 the review answered with no findings, 10, or 20 - the status
#              the runner gave,
#             2 the runner failed, ran out of time, or its record could not be
#               written down,
#            64 an argument this command does not know, or no git identity for
#              the clone; nothing ran,
#            78 the instance settings are invalid, tehas.slice is not usable
#               on this host, or the image's runner has no lens-review verb
#               (its --capabilities answer has no verbs["lens-review"]); nothing
#               was cloned and nothing ran.
#
# Instance settings (lib/config.sh; defaults in brackets):
#   TEHAS_PLAN_TIMEOUT  seconds before a review is given up [7200, the ceiling
#                       TEHAS_PLAN_TIMEOUT_MAX in lib/config.sh]: the bound of
#                       one headless turn, which is what this is too
#   and those of tehas work for the checkout and the container's limits.
set -uo pipefail

show_usage() {
  sed -n '2,/^[^#]/p' "$0" | sed -n '/^#/s/^# \{0,1\}//p'
}

unknown_argument() {
  printf 'tehasbot review: unknown argument: %s\n' "$1" >&2
  show_usage >&2
  exit 64
}

case "${1-}" in
  -h | --help)
    [ "$#" = 1 ] || unknown_argument "$2"
    show_usage
    exit 0
    ;;
  "") ;;
  *) unknown_argument "$1" ;;
esac
[ "$#" -le 1 ] || unknown_argument "$2"

here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source=lib/config.sh
. "$here/../lib/config.sh"
# shellcheck source=lib/sandbox.sh
. "$here/../lib/sandbox.sh"
# shellcheck source=lib/slice.sh
. "$here/../lib/slice.sh"
# shellcheck source=lib/headless.sh
. "$here/../lib/headless.sh"
tehas_load || exit 78
# A review runs an agent on a timer with no person in front of it, so it asks
# for the whole instance and not the three settings of a planning turn: the
# command that decides who may start work on this host is the one whose
# settings are checked here, and a host that lost one of them reviews nothing.
tehas_require_instance_settings
tehas_sandbox_settings_ok || exit 78
# Docker would create a missing mount source as a root-owned directory.
tehas_checkout || exit 78
branch=$(tehas_branch) || exit 78
# No container starts outside the slice, and none with half its limits.
TEHAS_SLICE_LIMITS=()
tehas_slice_ok || { echo "tehas review: $TEHAS_SLICE_WHY" >&2; exit 78; }
tehas_slice_limits_ok || {
  echo "tehas review: the container limits could not be made, not starting" >&2
  exit 78
}
src=$TEHAS_WORK_REPO
# The workspace inside the container, and the directory on the host behind it.
repo=$TEHAS_WORK_DIR
tree=$TEHAS_WORK_DIR-review
image=$PI_ENSEMBLE_IMAGE
limit=$TEHAS_PLAN_TIMEOUT
# How far back a host that never reviewed anything reads.
days=7
# Where a git that could not read the branch says why, so that "the branch is
# younger than the window" and "the object database is broken" are not the same
# line in the timer's log. Made by the run that reads the branch, and gone when
# it is done with it: a run that never reached this point made nothing.
git_err=$(mktemp "${TMPDIR:-/tmp}/tehas-review-git.XXXXXX") || git_err=""
git_note() { # what git said, when it said anything
  [ -n "${git_err:-}" ] && [ -s "$git_err" ] || return 0
  echo "tehas review: git said: $(tr '\n' ' ' <"$git_err" | cut -c 1-200)"
}
log=$TEHAS_HOME/logs/review-$(date -u +%y%m%d-%H%M%S).jsonl
# The runner's one JSON document, beside its NDJSON progress.
doc=${log%.jsonl}.json
runner=/opt/pi-rukas/bin/pi-rukas-headless
name=tehas-review
runs=$HOME/.pi/agent/ensemble-runs/review
# The run's own state on the host, beside the workspace and not in it.
container=$tree.state
index=$(tehas_index_dir)
record=$TEHAS_HOME/state/review.json

# Neither of them is made here: the run that needs one makes it, above. A
# command that refused an argument, or found the settings wrong, or never
# reached the point of starting, leaves nothing behind under the home.

# The committer of the clone. The runner commits nothing, but git needs an
# identity for the branch it checks out, and tehas_sandbox_env hands one to the
# container. The bot's identity is the tehas user's own.
bot_name=$(git config --global user.name || true)
bot_email=$(git config --global user.email || true)
[ -n "$bot_name" ] && [ -n "$bot_email" ] ||
  { echo "tehas review: git user.name and user.email are not set for $(id -un)" >&2; exit 64; }

# The names the console hides (lib/private.sh), for the two files this run
# leaves in logs/. The host's aliases, the model endpoints and the bot's email:
# what a review agent could print that belongs to the host and nobody else.
# shellcheck source=lib/private.sh
. "$here/../lib/private.sh"
private=()
while IFS= read -r private_name; do
  private+=(--private "$private_name")
done < <(tehas_private_names "$(tehas_models_file)" "$bot_email")

# A review reads the code and writes nothing to the tracker, so the container
# is given no token at all: no-token says so where the list is made, the way a
# planning turn keeps back the names of its own session by unsetting them
# before the call. So are the four names of a planning turn - the issue, the
# session, its attachments and the cache of one - and with them the cycle's
# settings of its own, which this run asks nothing of: it writes no code and
# runs no gate.
unset PI_ENSEMBLE_EXTRA_IMAGE_DIRS PI_ENSEMBLE_PLAN_ISSUE \
  PI_ENSEMBLE_PLAN_SESSION_DIR PI_ENSEMBLE_PLAN_CACHE_TTL_MS \
  PI_ENSEMBLE_MAX_WORKSTREAMS PI_ENSEMBLE_VERIFY_TIMEOUT_MS \
  PI_ENSEMBLE_INTEGRATION_VERIFY_TIMEOUT_MS
mapfile -d '' -t envs < <(tehas_sandbox_env "$repo" "$bot_name" "$bot_email" no-token)

mapfile -d '' -t hosts < <(tehas_sandbox_hosts)
mapfile -d '' -t sec < <(tehas_sandbox_security)
# The two lists are the library's, read as the pairs of options they are: an
# -e with no value after it would reach docker as a truncated argument list.
[ "${#envs[@]}" -gt 0 ] && [ $(( ${#envs[@]} % 2 )) = 0 ] && [ "${#sec[@]}" -eq 8 ] ||
  { echo "tehas review: could not prepare the sandbox, not starting a review" >&2; exit 78; }

# What the review's own environment is made of, and nothing else. The
# sandbox library adds the PI_ENSEMBLE_* of the environment to every
# container, which is right for a cycle: the dispatcher decides those settings,
# and libexec/work asks the image which inputs a host may set and refuses any
# name the answer does not name. A review is started by no dispatcher and asks
# nothing of the image, so the same family arriving by the environment would
# carry levers of the runner this run has no business carrying. Every name
# that reaches the container is one of these, or one the image itself lists as
# an input a host may set; anything else stops the run.
# The names of a token, of a planning turn and of a cycle's own are dropped
# above, before the list is made, and are named nowhere here.
tehas_review_env_wanted=(PI_ENSEMBLE_SANDBOX_MODE PI_ENSEMBLE_WORKSPACE_ROOT
  CBM_CACHE_DIR GIT_CONFIG_COUNT GIT_CONFIG_KEY_0 GIT_CONFIG_KEY_1 GIT_CONFIG_KEY_2
  GIT_CONFIG_KEY_3 GIT_CONFIG_VALUE_0 GIT_CONFIG_VALUE_1 GIT_CONFIG_VALUE_2
  GIT_CONFIG_VALUE_3 GIT_TERMINAL_PROMPT PI_ENSEMBLE_SUBAGENT_MODEL
  PI_ENSEMBLE_SUBAGENT_PROVIDER)

tehas_review_env_refused() { # <caps>
  local e name ok
  for e in "${envs[@]}"; do
    case "$e" in
      -e) continue ;;
      *=*) name=${e%%=*} ;;
      *) name=$e ;;
    esac
    for ok in "${tehas_review_env_wanted[@]}"; do
      [ "$name" = "$ok" ] && continue 2
    done
    # A token by any name, and the names of a planning turn or of a cycle: a
    # review is read-only on the tracker and runs no gate, so none of these
    # belongs in its container, whatever the image thinks of them.
    case "$name" in
      *TOKEN* | *SECRET* | *KEY) continue ;;
      PI_ENSEMBLE_PLAN_* | PI_ENSEMBLE_EXTRA_IMAGE_DIRS | \
        PI_ENSEMBLE_HANDOFF_* | PI_ENSEMBLE_CYCLE_DEADLINE | \
        PI_ENSEMBLE_VERIFY_CONCURRENCY) continue ;;
    esac
    # Anything else the library put there, the PI_ENSEMBLE_* of the
    # environment among them, is given only when the image says a host may
    # set it: the same proof libexec/work asks for a cycle. A name the image
    # does not list is a lever this run was never vetted for.
    [ "${name#PI_ENSEMBLE_}" != "$name" ] || continue
    if ! jq -e --arg n "$name" 'type == "object" and
      any(.inputs[]? | objects; (.name | strings) == $n and
        ((.scope // "") == "cycle" or (.scope // "") == "sandbox"))' \
      >/dev/null 2>&1 <<<"$1"; then
      printf '%s\n' "$name"
    fi
  done
}

# An image whose runner has no lens-review verb reviews nothing, and one whose
# docker does not answer is not such an image: the two are said apart, so an
# operator is never told to rebuild an image that is fine. The verbs are a
# different key of the answer from the features, so lib/headless.sh reads them
# here rather than this command writing its own test of them.
caps=$(tehas_headless_caps "$image" "$runner") || caps_rc=$?
caps_rc=${caps_rc:-0}
if [ "$caps_rc" != 0 ]; then
  echo "tehas review: $image gave no --capabilities answer (exit $caps_rc), not starting" >&2
  exit 78
fi
if ! tehas_headless_verb "$caps" lens-review "--since --json"; then
  echo "tehas review: $image runs no review (its --capabilities has no verbs lens-review), not starting" >&2
  exit 78
fi
# Asked of the answer that has been read, so no run starts with a lever in it
# that only the image could vouch for.
refused=$(tehas_review_env_refused "$caps")
if [ -n "$refused" ]; then
  echo "tehas review: $image does not take what this review would be given, not starting:" >&2
  printf '%s\n' "$refused" | sed 's/^/    /' >&2
  exit 78
fi

# What to read from: the commit the last review recorded, else the one 7 days
# back on the branch, else the root of the branch. Read from the checkout the
# run clones from, which is where tehas_sandbox_clone takes its commits from
# too; one that has no commit of that branch starts nothing rather than
# reviewing from nothing.
#
# The tip is read once, before the record is trusted, and is the commit the
# rewind below starts from and the one the record gets. The record names a
# commit, not a prefix of one: a short or wrong string that still resolves in
# the repository would review a range nobody asked for and then record the tip
# as read, skipping what lay between. So it must be forty characters, must
# still be an object of this checkout, and must be an ancestor of the tip: a
# record left by a force-push, or one written by another hand, names a commit
# the branch no longer reaches, and then the window below is used instead.
head=$(git -C "$src" rev-parse -q --verify "refs/remotes/origin/$branch^{commit}") ||
  { echo "tehas review: $src has no origin/$branch, nothing was reviewed" >&2; exit 2; }
since=$(jq -r '.commit // "" | strings | select(test("^[0-9a-f]{40}$"))' "$record" 2>/dev/null) || since=""
if [ -n "$since" ] && ! git -C "$src" merge-base --is-ancestor "$since" "$head" 2>/dev/null; then
  echo "tehas review: $record names ${since:0:12}, which origin/$branch no longer reaches: reading the $days days instead"
  since=""
fi
from=record
[ -n "$since" ] || {
  # The commit 7 days back on the branch, or its root when every commit of it
  # is younger than that: rev-list reads the branch newest first and answers
  # the first commit older than the date, and the root when there is none. A
  # git that fails here is not a young branch, and is said as itself: the
  # three starts are told apart by what rev-list actually answered.
  older=$(git -C "$src" rev-list -1 --before="$days.days ago" "$head" 2>"$git_err" </dev/null) || older=""
  if [ -n "$older" ] && [ "$older" != "$head" ]; then
    since=$older
    from="$days days"
  else
    # Nothing older than the window: the root of the branch, which is the tip
    # itself when the branch is one commit.
    since=$(git -C "$src" rev-list --max-parents=0 "$head" 2>>"$git_err" </dev/null | tail -n 1) || since=""
    [ -n "$since" ] || since=$head
    [ "$since" = "$head" ] && from=root || from="$days days"
  fi
  git_note
  [ -n "${git_err:-}" ] && rm -f "$git_err"
}
# Nothing to read: the last review ended at the tip, so this one would clone a
# tree, copy an index and start a container to find an empty range. Said and
# done before any of that is paid for.
if [ "$since" = "$head" ] && [ -f "$record" ]; then
  echo "tehas review: branch=$branch nothing new since ${head:0:12}"
  exit 0
fi

# One review at a time, and this lock is what makes it so rather than the
# timer that will start these runs (#509). The container, the workspace and
# the record are each one per host, so two runs would remove each other's
# container mid-review and both rm -rf the same workspace: the record would
# then move on for a range neither finished. A run that could not take the
# lock says so and leaves the range to the one that holds it, which is a
# different answer from a review that failed, and is not recorded as one. The
# directories of the home are made only now, so a run that refused an
# argument, or found the settings wrong, or never reached the point of
# starting, leaves nothing behind under it.
mkdir -p "$(dirname "$record")" ||
  { echo "tehas review: could not make the directories under $TEHAS_HOME, nothing was reviewed" >&2; exit 78; }
rm -f "$git_err" 2>/dev/null || true
exec 9>"$TEHAS_HOME/state/review.lock" ||
  { echo "tehas review: could not open $TEHAS_HOME/state/review.lock, nothing was reviewed" >&2; exit 78; }
flock -n 9 || {
  echo "tehas review: another review is going, nothing was reviewed"
  exit 0
}

# A fresh workspace for this run, as a cycle's turn gets one. Only a directory
# tehas made is ever removed.
works=$(dirname "$tree")
if [ -e "$works" ] && [ ! -f "$works/.tehas-workspaces" ]; then
  echo "tehas review: $works exists and was not made by tehas, not touching it" >&2
  exit 78
fi
if ! { mkdir -p "$works" && : >"$works/.tehas-workspaces" && rm -rf "$tree" "$container" &&
  tehas_sandbox_clone "$src" "$tree" "$branch"; }; then
  # The clone made a tree and could not finish it, or made nothing. Either way
  # the two directories of this run are its own to remove: nothing else ever
  # names them, and a run that never came up would leave them under the home
  # until a person noticed. Held to directories tehas made, as the removal
  # after the run is.
  rm -rf "$tree" "$container"
  echo "tehas review: could not make the workspace $tree, not starting a review" >&2
  exit 78
fi
# From here the run owns the two directories, and a step that fails on the way
# to the container - the mounts, the log's directory - must not leave them
# behind: nothing else removes what this name is called, and the next run
# would only remove it by accident. Removed at the end of the run as before.
trap 'rm -rf "$tree" "$container"' EXIT

# The run's own copy of the host's code index, asked for only once this run
# will start: a run that never began leaves no copy behind. Said when the
# index is of another commit than the one being reviewed: the search inside the
# container then falls back to reading files, which is the slower path, and the
# report is where an operator can tell that happened.
if [ "$(jq -r '.commit // ""' "$TEHAS_HOME/state/index.json" 2>/dev/null)" != "$head" ]; then
  echo "tehas review: the host's code index is not of ${head:0:12}, so this run may search an older one"
fi
tehas_sandbox_seed "$container" "$index" ||
  echo "tehas review: the code index could not be copied into $container/cache, this run searches without one"
# The mounts name directories that only exist now.
mapfile -d '' -t mounts < <(tehas_sandbox_mounts "$repo" "$tree" "$container" "$runs")
[ "${#mounts[@]}" -gt 0 ] ||
  { echo "tehas review: could not prepare the sandbox, not starting a review" >&2; exit 78; }

# A container under this name outlived the client that started it: this run
# holds the lock, so it is no review's. Left, it idles for ever in the slice
# and Docker would refuse the name. Bounded, because a dockerd that stopped
# answering must not be the last thing this run does: libexec/work bounds its
# equivalents for the same reason.
stop_wait=${TEHAS_STOP_WAIT:-60}
timeout -k 10 "$stop_wait" docker rm -f "$name" >/dev/null 2>&1
# stop_review <grace>: docker stop, bounded, then docker kill, also bounded.
# The end of a run has to be reported, and a stop that hangs cannot be the
# thing that stops it being reported.
stop_review() {
  timeout -k 5 "$stop_wait" docker stop -t "$1" "$name" >/dev/null 2>&1
  case $? in
    124 | 137) ;;
    *) return 0 ;;
  esac
  echo "tehas review: docker stop of $name did not end within ${stop_wait}s, killing it" >&2
  timeout -k 5 "$stop_wait" docker kill "$name" >/dev/null 2>&1 ||
    echo "tehas review: docker kill of $name did not work either" >&2
}
user="$(id -u):$(id -g)"
# The log's directory is made by the run that writes a log.
mkdir -p "$(dirname "$log")" ||
  { echo "tehas review: could not make $(dirname "$log"), not starting a review" >&2; exit 78; }
echo "tehas review: $branch from ${since:0:12} ($from), log $log"
# The client is bounded too: a docker that blocks before the container comes
# up would leave the poll below looking at a child that never starts, and the
# limit would never be evaluated. TEHAS_PLAN_TIMEOUT is the bound of one
# headless turn, which is what this is too; the runner bounds its own review
# loop and each of its lenses shorter than this.
docker run --rm --init --name "$name" \
  "${TEHAS_SLICE_LIMITS[@]}" "${sec[@]}" --user "$user" \
  -w "$repo" "${mounts[@]}" \
  "${envs[@]}" "${hosts[@]}" \
  "$image" "$runner" lens-review --since "$since" --json </dev/null >"$doc" 2>"$log" &
pid=$!
started=$(date +%s)
trap 'stop_review 10' TERM INT

timed_out=0
while kill -0 "$pid" 2>/dev/null; do
  if [ $(($(date +%s) - started)) -ge "$limit" ]; then
    echo "tehas review: time limit of ${limit}s passed"
    timed_out=1
    stop_review 20
    break
  fi
  sleep 1
done
wait "$pid" 2>/dev/null
rc=$?
rm -rf "$tree" "$container" || echo "tehas review: could not remove the workspace $tree" >&2
trap - EXIT

# The two files are what an agent wrote into them: model output, tool output,
# and anything the run printed of its own environment. Every other log an agent
# can see in the factory goes through the console's mask on its way to a reader
# - the dashboard by the console, tehas export by the same program, the MCP
# server again by it - and none of those readers reaches a file named
# review-<time>, so nothing would mask these later. They are masked here, once,
# before they are kept. The program is found as tehas export finds it: beside
# this command on a host, else the one on PATH; with neither the files are kept
# as the run wrote them and that is said, because a log that cannot be read at
# all is worse than one whose mask is missing. TEHAS_CONSOLE names it outright,
# as the other waits of the test hooks do, so a test of this command is not at
# the mercy of what the machine it runs on happens to have beside the checkout.
masker=${TEHAS_CONSOLE:-}
[ -n "$masker" ] || masker=$here/console
[ -n "$masker" ] && [ -x "$masker" ] || masker=""
[ -n "$masker" ] ||
  echo "tehas review: no console to mask the run's logs with, so they are kept as they came; run install.sh" >&2
# An empty list of names is no arguments at all: under set -u an expansion of
# an empty array is an error, and the mask would fail on a host that set no
# aliases and has one provider.
private_args=()
[ "${#private[@]}" = 0 ] || private_args=("${private[@]}")

mask_review_log() { # <file>
  local from=$1 masked
  [ -n "$masker" ] || return 0
  [ -s "$from" ] || return 0
  masked=$from.masking
  rm -f "$masked"
  if ! "$masker" --mask "${private_args[@]}" <"$from" >"$masked" 2>/dev/null; then
    rm -f "$masked"
    echo "tehas review: $from was kept unmasked: the console would not read it" >&2
    return 0
  fi
  # Bytes the mask swallowed are bytes nobody can read back, so a file that was
  # not empty and came out empty is kept as it was, as tehas export does for
  # the same answer of the mask.
  if [ ! -s "$masked" ]; then
    rm -f "$masked"
    return 0
  fi
  mv "$masked" "$from" || { rm -f "$masked"; echo "tehas review: could not replace $from" >&2; }
}
mask_review_log "$doc"
mask_review_log "$log"

# One timeout, decoded in one place: the flag is what says the run was stopped,
# so the container's own status is never overwritten with a number a runner is
# allowed to answer itself.
if [ "$timed_out" = 1 ]; then
  echo "tehas review: branch=$branch runner_exit=$rc recorded=no, the run ran out of time, see $log"
  exit 2
fi

# The runner's own document is read before anything is recorded, as libexec/
# work reads its result and libexec/plan reads its answer: the status of the
# docker client and the exitCode the runner wrote must say the same thing about
# the range. A document that contradicts its own process is no proof the range
# was read, so the record is left exactly as it was and the two answers are
# named.
doc_rc=$(jq -r 'select(type == "object") | .exitCode | select(type == "number")' "$doc" 2>/dev/null) || doc_rc=""
if [ -n "$doc_rc" ] && [ "$doc_rc" != "$rc" ]; then
  echo "tehas review: branch=$branch runner_exit=$rc document_exit=$doc_rc recorded=no, the two disagree, see $doc"
  exit 2
fi

# The record moves on only for the exits that mean the reviewer answered.
# Anything else leaves the file exactly as it was, so the same range is read
# again.
case "$rc" in
  0 | 10 | 20) ;;
  *)
    echo "tehas review: branch=$branch runner_exit=${doc_rc:-$rc} recorded=no, see $log"
    exit 2
    ;;
esac
mkdir -p "$(dirname "$record")" ||
  { echo "tehas review: could not make $(dirname "$record"), the record of what was reviewed is unchanged" >&2; exit 2; }
if ! jq -n --arg commit "$head" --arg at "$(date -u +%FT%TZ)" --argjson rc "$rc" \
  '{commit: $commit, at: $at, exit: $rc}' >"$record.new" ||
  ! mv "$record.new" "$record"; then
  rm -f "$record.new"
  echo "tehas review: could not write $record, the record of what was reviewed is unchanged" >&2
  exit 2
fi
echo "tehas review: branch=$branch from=${since:0:12} to=${head:0:12} runner_exit=$rc recorded=yes seconds=$(($(date +%s) - started))"
exit "$rc"
