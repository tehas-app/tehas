#!/usr/bin/env bash
# Review what the default branch gained since the last reviewed commit, with
# pi-rukas's lens reviewer running headless in the sandbox image.
#
# One turn of `pi-rukas-headless lens-review --since <commit> --json` over a
# fresh clone of the default branch. TEHAS_REVIEW other than 1 exits 0 at once
# and calls nothing, so the weekly tehas-review.timer costs a host that left the
# loop off nothing. A run that ended with findings files them as one issue in
# TEHAS_REVIEW_REPO, or nowhere until the instance names one. The store renders
# their words (`store review-issue`) and q_clean masks them on their way out
# (lib/questions.sh). The start is the commit in $TEHAS_HOME/state/review.json,
# else the commit 7 days back, else the root. Only exits 0, 10 and 20 move the
# record on, so a failed run leaves it and the next one reads the same range.
# What the container is given and where the logs go are in host/docs/tools.md.
# This prepares the sandbox; the console beside it (console/src/review.rs) reads
# the range, checks what the image is given, and runs and bounds the container.
#
# Usage:
#   tehasbot review             one review
#   tehasbot review -h|--help   print this text and exit 0
#
# Exit status: 0 the review answered with no findings, 10, or 20 - the status
#              the runner gave, which no filing changes (a filing that failed
#              is said on standard error and the record still moves on),
#             2 the runner failed, ran out of time, or its record could not be
#               written down,
#            64 an argument this command does not know, or no git identity for
#              the clone; nothing ran,
#            78 the instance settings are invalid, tehas.slice is not usable on
#               this host, the console is not installed beside this command, or
#               the image has no lens-review verb: nothing was cloned or run.
#
# Instance settings (lib/config.sh): TEHAS_REVIEW, 1 to let this command review
# anything; TEHAS_PLAN_TIMEOUT, the seconds before a review is given up, at the
# ceiling TEHAS_PLAN_TIMEOUT_MAX there, the bound of one headless turn which this
# is too; TEHAS_REVIEW_REPO, owner/name the findings go to, refused equal to
# TEHAS_REPO, the product; and those of tehas work for the checkout, the
# container and its limits.
set -uo pipefail

show_usage() {
  sed -n '2,/^[^#]/p' "$0" | sed -n '/^#/s/^# \{0,1\}//p'
}

unknown_argument() {
  printf 'tehasbot review: unknown argument: %s\n' "$1" >&2
  show_usage >&2
  exit 64
}

case "${1-}" in
  -h | --help)
    [ "$#" = 1 ] || unknown_argument "$2"
    show_usage
    exit 0
    ;;
  "") ;;
  *) unknown_argument "$1" ;;
esac
[ "$#" -le 1 ] || unknown_argument "$2"

here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source=lib/config.sh
. "$here/../lib/config.sh"
# shellcheck source=lib/sandbox.sh
. "$here/../lib/sandbox.sh"
# shellcheck source=lib/slice.sh
. "$here/../lib/slice.sh"
# shellcheck source=lib/headless.sh
. "$here/../lib/headless.sh"
# shellcheck source=lib/questions.sh
. "$here/../lib/questions.sh"
# shellcheck source=lib/store.sh
. "$here/../lib/store.sh"
tehas_load || exit 78
# A review runs an agent on a timer with no person in front of it. The gate sits
# below the check of the settings it needs, so a weekly run says 78 for an
# instance that could not review rather than exiting 0 on it.
tehas_require_instance_settings
[ "${TEHAS_REVIEW:-0}" = 1 ] || exit 0
tehas_sandbox_settings_ok || exit 78
# Docker would create a missing mount source as a root-owned directory.
tehas_checkout || exit 78
branch=$(tehas_branch) || exit 78
# No container starts outside the slice, and none with half its limits.
TEHAS_SLICE_LIMITS=()
tehas_slice_ok || { echo "tehas review: $TEHAS_SLICE_WHY" >&2; exit 78; }
tehas_slice_limits || true
if [ "${#TEHAS_SLICE_LIMITS[@]}" != 14 ] || [ "${TEHAS_SLICE_LIMITS[1]}" != tehas.slice ]; then
  echo "tehas review: the container limits could not be made, not starting" >&2
  exit 78
fi
src=$TEHAS_WORK_REPO
# The workspace inside the container, the directory on the host behind it, and
# the run's own state beside that, not in it.
repo=$TEHAS_WORK_DIR
tree=$TEHAS_WORK_DIR-review
container=$tree.state
image=$PI_ENSEMBLE_IMAGE
limit=$TEHAS_PLAN_TIMEOUT
log=$TEHAS_HOME/logs/review-$(date -u +%y%m%d-%H%M%S).jsonl
# The runner's one JSON document, beside its NDJSON progress.
doc=${log%.jsonl}.json
runner=/opt/pi-rukas/bin/pi-rukas-headless
name=tehas-review
runs=$HOME/.pi/agent/ensemble-runs/review
index=$(tehas_index_dir)
record=$TEHAS_HOME/state/review.json
console=$here/console

# The committer of the clone: git needs an identity for the branch it checks out,
# and tehas_sandbox_env hands one to the container. The bot's is the tehas
# user's own, and the runner commits nothing.
bot_name=$(git config --global user.name || true)
bot_email=$(git config --global user.email || true)
[ -n "$bot_name" ] && [ -n "$bot_email" ] ||
  { echo "tehas review: git user.name and user.email are not set for $(id -un)" >&2; exit 64; }

# The names the console hides (lib/private.sh) in the two files this run
# leaves in logs/. The host's aliases, the model endpoints and the bot's email:
# what a review agent could print that belongs to the host and nobody else.
# shellcheck source=lib/private.sh
. "$here/../lib/private.sh"
private=()
while IFS= read -r private_name; do
  private+=(--private "$private_name")
done < <(tehas_private_names "$(tehas_models_file)" "$bot_email")

# A review writes nothing to the tracker: no token (no-token), and none of the
# names of a planning turn or of a cycle's gate.
unset PI_ENSEMBLE_EXTRA_IMAGE_DIRS PI_ENSEMBLE_PLAN_ISSUE \
  PI_ENSEMBLE_PLAN_SESSION_DIR PI_ENSEMBLE_PLAN_CACHE_TTL_MS \
  PI_ENSEMBLE_MAX_WORKSTREAMS PI_ENSEMBLE_VERIFY_TIMEOUT_MS \
  PI_ENSEMBLE_INTEGRATION_VERIFY_TIMEOUT_MS
mapfile -d '' -t envs < <(tehas_sandbox_env "$repo" "$bot_name" "$bot_email" no-token)

mapfile -d '' -t hosts < <(tehas_sandbox_hosts)
# The -e options are read as the pairs they are: an -e with no value after it
# would reach docker as a truncated argument list.
[ "${#envs[@]}" -gt 0 ] && [ $(( ${#envs[@]} % 2 )) = 0 ] ||
  { echo "tehas review: could not prepare the sandbox, not starting a review" >&2; exit 78; }
tehas_sandbox_security_take "tehas review" "a review" || exit 78

# The findings of a run are filed by the questions library, which owns the
# agent's words on their way to a public issue. Its last line is this command's
# own, so no finding can become it; the backquotes are GitHub's (SC2016).
# shellcheck disable=SC2016  # the backquotes are literal, by intent
q_file_ask='Apply `tehas:refine` to plan this into parts sized for one cycle.'

# A docker that does not answer is said apart from an image with no lens-review
# verb, so nobody rebuilds an image that is fine.
caps=$(tehas_headless_caps "$image" "$runner") || caps_rc=$?
caps_rc=${caps_rc:-0}
if [ "$caps_rc" != 0 ]; then
  echo "tehas review: $image gave no --capabilities answer (exit $caps_rc), not starting" >&2
  exit 78
fi
tehas_headless_verb "$caps" lens-review "--since --json" || {
  echo "tehas review: $image runs no review (its --capabilities has no verbs lens-review), not starting" >&2
  exit 78
}
[ -x "$console" ] ||
  { echo "tehas review: no console beside this command ($console), run install.sh" >&2; exit 78; }
# Which PI_ENSEMBLE_* the image does not list for a host to set, and so a lever
# of the runner this run was never vetted for.
refused=$("$console" review refused "${envs[@]%%=*}" <<<"$caps")
if [ -n "$refused" ]; then
  echo "tehas review: $image does not take what this review would be given, not starting:" >&2
  printf '%s\n' "$refused" | sed 's/^/    /' >&2
  exit 78
fi

# The range, read before anything is made: nothing new starts nothing.
range=$("$console" review since "$src" "$branch" "$record")
case $? in
  0) read -r head since from <<<"$range" ;;
  3) exit 0 ;;
  *) exit 2 ;;
esac

# One review at a time: the container, the workspace and the record are one per
# host; the home's directories are made only now.
mkdir -p "$(dirname "$record")" ||
  { echo "tehas review: could not make the directories under $TEHAS_HOME, nothing was reviewed" >&2; exit 78; }
exec 9>"$TEHAS_HOME/state/review.lock" ||
  { echo "tehas review: could not open $TEHAS_HOME/state/review.lock, nothing was reviewed" >&2; exit 78; }
flock -n 9 || {
  echo "tehas review: another review is going, nothing was reviewed"
  exit 0
}

# A fresh workspace for this run, as a cycle's turn gets one. Only a directory
# tehas made is ever removed.
works=$(dirname "$tree")
if [ -e "$works" ] && [ ! -f "$works/.tehas-workspaces" ]; then
  echo "tehas review: $works exists and was not made by tehas, not touching it" >&2
  exit 78
fi
if ! { mkdir -p "$works" && : >"$works/.tehas-workspaces" && rm -rf "$tree" "$container" &&
  tehas_sandbox_clone "$src" "$tree" "$branch"; }; then
  rm -rf "$tree" "$container"
  echo "tehas review: could not make the workspace $tree, not starting a review" >&2
  exit 78
fi
# From here a step that fails removes the run's two directories.
trap 'rm -rf "$tree" "$container"' EXIT

# The run's own copy of the host's code index, and a word when it is not of this
# commit, since the search then falls back to reading files.
if [ "$(jq -r '.commit // ""' "$TEHAS_HOME/state/index.json" 2>/dev/null)" != "$head" ]; then
  echo "tehas review: the host's code index is not of ${head:0:12}, so this run may search an older one"
fi
tehas_sandbox_seed "$container" "$index" ||
  echo "tehas review: the code index could not be copied into $container/cache, this run searches without one"
# The mounts name directories that only exist now.
mapfile -d '' -t mounts < <(tehas_sandbox_mounts "$repo" "$tree" "$container" "$runs" no-token)
[ "${#mounts[@]}" -gt 0 ] ||
  { echo "tehas review: could not prepare the sandbox, not starting a review" >&2; exit 78; }

user="$(id -u):$(id -g)"
# The log's directory is made here; the document beside it by the console.
mkdir -p "$(dirname "$log")" ||
  { echo "tehas review: could not make $(dirname "$log"), not starting a review" >&2; exit 78; }
echo "tehas review: $branch from ${since:0:12} ($from), log $log"
# The console removes the two directories when the run is over, and holds the
# lock while it goes. TEHAS_PLAN_TIMEOUT bounds the run, as it bounds one
# headless turn; TEHAS_STOP_WAIT bounds each docker call and the client. The
# document it writes beside the log is the one the store renders into the issue.
set -- docker run --rm --init --name "$name" \
  "${TEHAS_SLICE_LIMITS[@]}" "${sec[@]}" --user "$user" \
  -w "$repo" "${mounts[@]}" \
  "${envs[@]}" "${hosts[@]}" \
  "$image" "$runner" lens-review --since "$since" --json
"$console" review run "${private[@]}" --branch "$branch" --head "$head" \
  --since "$since" --record "$record" --limit "$limit" --stop-wait "${TEHAS_STOP_WAIT:-60}" \
  --name "$name" --doc "$doc" --log "$log" --remove "$tree" --remove "$container" -- "$@"
rc=$?
[ "$rc" = 10 ] || [ "$rc" = 20 ] || exit "$rc"
q_file_findings || echo "tehas review: the findings were not filed: $q_file_why" >&2
exit "$rc"
