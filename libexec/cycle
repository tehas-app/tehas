#!/usr/bin/env bash
# One tehas cycle for one issue, and its report.
#
# Deterministic, no model. The dispatcher starts it as tehas-cycle@<issue>.service,
# after it has checked who labelled the issue and marked it tehas:running. This
# command checks no authorisation, as tehas work checks none: run by hand it runs
# a cycle for any open issue. A closed issue and a pull request are refused
# before a label is changed or a container starts.
#
# Usage:
#   tehasbot cycle <issue>
#
# Exit: 0 the cycle ran and was reported, whatever its outcome; 3 a cycle for
# this issue is already running; 64 the argument is not an issue number; 65 the
# number is not work the factory takes: a pull request, a closed issue, or an
# answer GitHub could not give after three tries; 75 the state store was busy
# and did not start the cycle's record after three tries, or timed out on the
# start (a start it took then is ended as refused); 77 the state store
# refused the start: no approval of the dispatcher's is waiting for it, or the
# lock is not held as the store sees it; 78 instance settings are missing or
# malformed, the state store cannot be used, or there is no tehas-cycle beside
# this script; 70 the cycle's end is not on record. 75, 77 and 78 come before
# any label, comment or container.
#
# This script loads the settings and takes state/cycles/<issue>.lock as fd 9,
# then execs `tehas-cycle cycle` (console/cycle/src/supervise.rs), which stays
# the unit's main process: it puts the start on record, asks GitHub what the
# number is, runs tehas work, passes a TERM, INT or HUP on to it, and makes the
# report (console/cycle/src/apply.rs). The dispatcher counts the held locks, so
# a cycle that dies frees its place. What the report says and writes for each
# end is in the manual (host/docs/tools.md, tehasbot cycle).
#
# Instance settings (lib/config.sh): TEHAS_REPO, TEHAS_WORK_DIR,
# TEHAS_IMPROVE_REPO, TEHAS_ANALYTICS.
# From the environment: TEHAS_CYCLE_FROM=unit, which tehas-cycle@.service sets.
# tehas work is run with TEHAS_CYCLE_ATTEMPT, the attempt of this start.
# For tests: TEHAS_WORK_CMD, TEHAS_STATUS_CMD, TEHAS_CONSOLE_CMD,
# TEHAS_CYCLE_RETRY_WAIT (seconds between two tries of a GitHub call [5]) and
# TEHAS_CYCLE_STOP_GH_WAIT (seconds a GitHub call may take after a stop [20]).
set -uo pipefail

issue=${1:-}
if [ "$#" != 1 ] || ! [[ $issue =~ ^[1-9][0-9]*$ ]]; then
  echo "usage: tehasbot cycle <issue>" >&2
  exit 64
fi

here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source=lib/config.sh
. "$here/../lib/config.sh"
tehas_load || exit 78
tehas_require TEHAS_REPO

log() { TZ=UTC0 printf '%(%FT%TZ)T %s\n' -1 "$*"; }

# Before the lock is opened: the program and a database that is a file.
store=$TEHAS_HOME/libexec/store db=$TEHAS_HOME/state/tehas.db
if ! [ -f "$store" ] || ! [ -x "$store" ] || ! [ -f "$db" ] || [ -L "$db" ]; then
  log "ERROR: the state store is not installed (run install.sh)"
  exit 78
fi

work=${TEHAS_WORK_CMD:-$here/work}
status_cmd=${TEHAS_STATUS_CMD:-$here/../bin/tehasbot}
status_args=()
[ -n "${TEHAS_STATUS_CMD:-}" ] || status_args=(--status-arg status)
console=${TEHAS_CONSOLE_CMD:-$here/console}
# Beside this script: a pinned cycle runs its own copy.
tc=$here/tehas-cycle
cycles=$TEHAS_HOME/state/cycles

mkdir -p "$cycles" "$TEHAS_HOME/logs"
# The runner and the docker client it starts inherit this lock. If this
# process is killed outright the place stays taken until they are gone too.
exec 9>"$cycles/$issue.lock"
flock -w 5 9 || { log "a cycle for #$issue is already running"; exit 3; }
if [ ! -x "$tc" ]; then
  log "ERROR: #$issue: no tehas-cycle at $tc, run install.sh"
  exit 78
fi
exec "$tc" cycle "$issue" --work "$work" --status-cmd "$status_cmd" "${status_args[@]}" --console "$console"
