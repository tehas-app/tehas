#!/usr/bin/env bash
# One tehas cycle for one issue, and its report.
#
# Deterministic, no model. It runs tehas work for the issue and reports the
# outcome on the issue (and the token usage on the pull request). The
# dispatcher starts it as tehas-cycle@<issue>.service, after it has checked who
# labelled the issue and marked it tehas:running. This command checks no
# authorisation, as tehas work checks none: run by hand it runs a cycle for any
# open issue. It does check the number itself: a closed issue and a pull request
# are refused before a label is changed or a container starts.
#
# Usage:
#   tehasbot cycle <issue>
#
# Exit: 0 the cycle ran and was reported, whatever its outcome; 3 a cycle for
# this issue is already running; 64 the argument is not an issue number; 65 the
# number is not work the factory takes: a pull request, a closed issue, or an
# answer GitHub could not give after three tries; 78 instance settings are
# missing or malformed.
#
# It holds state/cycles/<issue>.lock for as long as it runs. The dispatcher
# counts the held locks, so a cycle that dies frees its place. Once it holds
# the lock it writes state/cycles/<issue>.taken, which is what the dispatcher
# waits for. A cycle that then refuses its number leaves that file: the unit
# did come up, and the issue keeps tehas:running until the next poll clears it.
#
# A TERM, INT or HUP is passed on to tehas work, which stops the container. The
# cycle is then reported like any other that stopped without a pull request,
# but with one try for each call to GitHub, each bounded, and no refresh of the
# status: systemd kills the unit TimeoutStopSec after the stop, and a report
# cut off there leaves the issue marked tehas:running.
#
# A runner that exits 137 while the cycle's state still says running, or says
# nothing, had its container killed: the status reported is "killed" and the
# issue is parked. tehas work leaves in state/cycles/<issue>.oom how many
# processes in the container were killed for memory. The file is read here as
# digits and removed, the number is said in the comment when it is above 0,
# and it goes into the record for the improvement loop. Nothing is read from
# the runner's output. state/cycles/<issue>.forks, how many starts of a process
# the container's pids limit refused, is read the same way and said in the
# comment: after the first one the cycle's own commands may not have run.
#
# tehas work stops a cycle whose Pi session ended while it ran, and leaves
# state/cycles/<issue>.ended. While the state still says running, the status
# reported is then "interrupted" and the comment says during which step.
#
# tehas work stops a cycle none of whose logs changed for TEHAS_WORK_STALL
# seconds and leaves the seconds in state/cycles/<issue>.stalled. While the
# state still says running, the status reported is then "stalled", the issue
# is parked and the comment says how long nothing moved and at which step.
#
# A runner that exits 4 started no cycle: the instance gives a cycle the
# images its issue links (TEHAS_WORK_IMAGES) and one could not be fetched. The
# issue is parked and the comment says that, not that a cycle stopped. The
# images of a cycle that ran are removed here when it is over: only the
# container read them. So is the cycle's own state directory, the copy of the
# code index, the memory and the sessions its agents wrote: no later cycle
# reads them.
#
# The state file is the container's word. Its "merged" counts only when the
# bot has a merged pull request for the issue on the cycle's branch; without
# one the issue is parked and nothing is removed. A pull request counts only
# when it names this issue: its head is feature/issue-<n>-..., as pi-rukas
# names a branch, or its body closes #<n>. A state file reached through a link
# is not read.
#
# A merged pull request for the issue ends the cycle as merged whatever the
# state says: a person may merge it while the cycle still reviews. The issue
# then only loses tehas:running, and tehasbot status labels it shipped. One a
# person closed without merging parks the issue without the retry boxes.
#
# Only a run that ended as handoff with an open pull request is reported as
# waiting for a merge. The label change that ends a cycle is tried three
# times, and so is the question about the pull request, and so is the call
# that asks what the number is. A pull request that could not be looked up is
# not taken for none: the issue is parked with a comment that says so and names
# the branch, which stays in state/cycles/<issue>.branch. If GitHub still refuses it, or the cycle is
# killed outright, the issue stays marked tehas:running and the dispatcher's
# next poll finds it.
#
# A cycle that stopped without a pull request asks what to do next, in a
# comment with boxes. The id of that comment goes on record in
# state/park-<issue>.id: the dispatcher takes a tick only in the comment named
# there.
#
# The pi-rukas commit of the sandbox image when the cycle starts goes to
# state/cycles/<issue>.rukas, and when the cycle ends as merged, or as a
# handoff with an open pull request, is added to state/rukas-proven. The dispatcher
# runs one cycle at a time on a commit that file does not name.
#
# Where the instance has an improvement loop (TEHAS_IMPROVE_REPO), it leaves
# the cycle's record for it at the end, in tmp/improve/window (lib/improve.sh).
#
# Instance settings (lib/config.sh): TEHAS_REPO, TEHAS_IMPROVE_REPO.
# From the environment, for tests: TEHAS_WORK_CMD, TEHAS_STATUS_CMD,
# TEHAS_CYCLE_RETRY_WAIT (seconds between two tries of a GitHub call [5]) and
# TEHAS_CYCLE_STOP_GH_WAIT (seconds a GitHub call may take after a stop [20]).
set -uo pipefail

issue=${1:-}
if [ "$#" != 1 ] || ! [[ $issue =~ ^[1-9][0-9]*$ ]]; then
  echo "usage: tehasbot cycle <issue>" >&2
  exit 64
fi

# Read before tehas_load, which clears TEHAS_* from the environment.
stop_gh_wait=${TEHAS_CYCLE_STOP_GH_WAIT:-20}
[[ $stop_gh_wait =~ ^[1-9][0-9]{0,3}$ ]] || stop_gh_wait=20

here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source=lib/config.sh
. "$here/../lib/config.sh"
# shellcheck source=lib/cycles.sh
. "$here/../lib/cycles.sh"
# shellcheck source=lib/improve.sh
. "$here/../lib/improve.sh"
tehas_load || exit 78
# shellcheck source=lib/questions.sh
. "$here/../lib/questions.sh"
tehas_require TEHAS_REPO

log() { printf '%s %s\n' "$(date -u +%FT%TZ)" "$*"; }

repo=$TEHAS_REPO
# The cycle's workspace on the host; tehas work makes it under this name.
workdir=$TEHAS_WORK_DIR-$issue
work=${TEHAS_WORK_CMD:-$here/work}
status_cmd=${TEHAS_STATUS_CMD:-$here/status}
cycles=$TEHAS_HOME/state/cycles

mkdir -p "$cycles" "$TEHAS_HOME/logs"
# The runner and the docker client it starts inherit this lock. If this
# process is killed outright the place stays taken until they are gone too.
exec 9>"$cycles/$issue.lock"
flock -w 5 9 || { log "a cycle for #$issue is already running"; exit 3; }
# The place is claimed with the lock. It is what the dispatcher waits for to
# know its unit came up, and a cycle that goes on to refuse its number still
# came up: leaving the file out would have the poll report a start that did
# happen as one that did not.
# Before .taken: the dispatcher counts this cycle as one on its pi-rukas from
# the moment it sees the cycle started.
rukas=$(tehas_rukas_commit)
printf '%s\n' "$rukas" >"$cycles/$issue.rukas" || log "WARN: could not record the pi-rukas commit of #$issue"
: >"$cycles/$issue.taken"
retry_wait=${TEHAS_CYCLE_RETRY_WAIT:-5}
# Open issues only. GitHub is asked what the number is before a label is
# changed, a comment is posted or a container starts. The dispatcher has often
# marked the issue tehas:running by now, so a call that only failed is tried
# again rather than refusing a cycle that was already authorized. A transport
# that never answers is a refusal too, said as itself.
asked="" answer=""
for try in 1 2 3; do
  if answer=$(gh api "repos/$repo/issues/$issue" 2>/dev/null); then asked=1; break; fi
  answer=""
  [ "$try" = 3 ] || sleep "$retry_wait"
done
if [ -z "$asked" ]; then
  log "refuse #$issue: GitHub could not be asked what the number is"
  exit 65
fi
tehas_work_kind "$answer" || {
  case "$tehas_work_why" in
    pr) log "refuse #$issue: it is a pull request, not an issue the factory works on" ;;
    closed) log "refuse #$issue: the issue is closed" ;;
    *) log "refuse #$issue: GitHub's answer for it could not be read" ;;
  esac
  exit 65
}

# A cycle stopped by a signal has until systemd's TimeoutStopSec to report:
# then every call to GitHub is tried once and bounded.
signalled=0
tries=3
gh_call() {
  if [ "$signalled" = 1 ]; then
    # KILL: the report ignores TERM, and gh inherits that.
    timeout -s KILL "$stop_gh_wait" gh "$@"
  else
    gh "$@"
  fi
}
comment() { gh_call issue comment "$issue" --repo "$repo" --body "$1" >/dev/null 2>&1 || log "WARN: comment on #$issue failed"; }
relabel() {
  local try
  for ((try = 1; try <= tries; try++)); do
    gh_call issue edit "$issue" --repo "$repo" "$@" >/dev/null 2>&1 && return 0
    [ "$try" = "$tries" ] || sleep "$retry_wait"
  done
  log "WARN: label change on #$issue failed: $*"
  return 1
}
# post_question <result.json>: post the park question. Its id is left in
# $posted. Returns 1 when it could not be posted.
posted=""
post_question() {
  local body
  body=$(q_render park "$issue" 1 "$1") || return 1
  posted=$(gh_call api "repos/$repo/issues/$issue/comments" -f body="$body" --jq .id 2>/dev/null) || return 1
  [ -n "$posted" ]
}
# A workspace is kept only while a person may want to read it, and so is the
# one tehas work moved aside when this issue was retried. Only a directory
# under one that tehas work marked is removed, as tehas work does. The cycle's
# own state directory is not named here: it went before this, whether or not
# the workspace was kept.
tidy() {
  if [ -f "$(dirname "$workdir")/.tehas-workspaces" ]; then
    rm -rf "$workdir" "$workdir.before-retry" ||
      log "WARN: could not remove the workspace $workdir"
  else
    log "WARN: $(dirname "$workdir") is not marked by tehas work, leaving the workspace $workdir"
  fi
}

# The pi-rukas this cycle ran with has ended well here.
proven() {
  [ -n "$rukas" ] || return 0
  tehas_rukas_proven "$rukas" && return 0
  printf '%s\n' "$rukas" >>"$TEHAS_HOME/state/rukas-proven" || log "WARN: could not record pi-rukas $rukas as proven"
}

started=$(date +%s)
# A relabelled issue gets a fresh cycle, not whatever the last one parked.
# The workspace is new every time, so the record of an earlier cycle is kept
# here, on the host.
restart=""
[ -e "$cycles/$issue" ] && restart=--restart
: >"$cycles/$issue"
# A count of kills still here is an earlier cycle's, one that was killed
# outright before it could report.
rm -f "${cycles:?}/${issue:?}.oom" "${cycles:?}/${issue:?}.forks" "${cycles:?}/${issue:?}.stalled" \
  "${cycles:?}/${issue:?}.ended" "${cycles:?}/${issue:?}.branch"
# The trap is set before the runner starts, so no signal falls between.
wpid=""
stopped=0
trap 'stopped=1 signalled=1; [ -z "$wpid" ] || kill -TERM "$wpid" 2>/dev/null' TERM INT HUP
"$work" "$issue" ${restart:+"$restart"} >>"$TEHAS_HOME/logs/dispatch-work-$issue.log" 2>&1 &
wpid=$!
[ "$stopped" = 0 ] || kill -TERM "$wpid" 2>/dev/null
wait "$wpid"
rc=$?
# A signal ends the wait early, with a status that is not the runner's. The
# runner is still stopping its container: wait again for its own status. A
# wait that answers 127 found the runner already reaped, so rc stands.
while [ "$stopped" = 1 ]; do
  stopped=0
  wait "$wpid"
  r=$?
  [ "$r" = 127 ] || rc=$r
done
# The report is made even if a stop arrives now: leaving tehas:running on the
# issue would park it for good.
trap '' TERM INT HUP
[ "$signalled" = 0 ] || tries=1
mins=$((($(date +%s) - started) / 60))
[ ! -f "$(dirname "$workdir")/.tehas-workspaces" ] || rm -rf "$workdir.images" ||
  log "WARN: could not remove the images $workdir.images"
# The cycle's own cache, memory and sessions, made by tehas work beside the
# workspace. A cycle that stopped without a pull request keeps its workspace
# for a person to read, and not what its agents wrote in their own directories.
[ ! -f "$(dirname "$workdir")/.tehas-workspaces" ] || rm -rf "$workdir.state" ||
  log "WARN: could not remove the cycle's state $workdir.state"

# The one thing read back from the tree the container wrote, and only as data.
# Not through a link, as the count files are not: the container could point
# the host at any file it can read.
state=$workdir/.pi/work-state/$issue.json
if [ -L "$workdir/.pi" ] || [ -L "$workdir/.pi/work-state" ] || [ -L "$state" ]; then
  log "WARN: the state file of #$issue is reached through a link, it is not read"
  state=/dev/null
fi
# The file is written inside the container, and what the bot posts from it is
# trusted later, so only plain characters are kept.
status=$(jq -r '.pipelineState.status // "unknown"' "$state" 2>/dev/null | tr -cd 'A-Za-z0-9_.-')
step=$(jq -r '.pipelineState.currentStep // "-"' "$state" 2>/dev/null | tr -cd 'A-Za-z0-9_.-')
status=${status:-unknown}
step=${step:--}
# The runner says 137 only for a container that was killed under it. A state
# that names an end has the last word.
if [ "$rc" = 137 ]; then
  case "$status" in running | unknown) status=killed ;; esac
fi
# How many processes in the container were killed for memory, as tehas work
# counted them. One short line of digits, or nothing.
kills=0
oom_file=${cycles:?}/${issue:?}.oom
if [ -f "$oom_file" ] && [ ! -L "$oom_file" ]; then
  kills=$(head -c 16 "$oom_file" 2>/dev/null | head -n 1)
  [[ $kills =~ ^(0|[1-9][0-9]{0,8})$ ]] || kills=0
fi
rm -f "${cycles:?}/${issue:?}.oom"
killed=""
[ "$kills" = 0 ] || killed=" $kills processes were killed for memory in its container."
forks=0
forks_file=${cycles:?}/${issue:?}.forks
if [ -f "$forks_file" ] && [ ! -L "$forks_file" ]; then
  forks=$(head -c 16 "$forks_file" 2>/dev/null | head -n 1)
  [[ $forks =~ ^(0|[1-9][0-9]{0,8})$ ]] || forks=0
fi
rm -f "${cycles:?}/${issue:?}.forks"
stalled=0
stall_file=${cycles:?}/${issue:?}.stalled
if [ -f "$stall_file" ] && [ ! -L "$stall_file" ]; then
  stalled=$(head -c 16 "$stall_file" 2>/dev/null | head -n 1)
  [[ $stalled =~ ^(0|[1-9][0-9]{0,8})$ ]] || stalled=0
fi
rm -f "$stall_file"
ended_file=${cycles:?}/${issue:?}.ended
if [ -f "$ended_file" ] && [ ! -L "$ended_file" ]; then
  case "$status" in running | unknown) status=interrupted ;; esac
  killed="$killed The Pi session ended during \`$step\`, so tehas stopped the cycle before its time limit."
fi
rm -f "$ended_file"
if [ "$stalled" != 0 ]; then
  case "$status" in running | unknown) status=stalled ;; esac
  killed="$killed None of its logs changed for $((stalled / 60)) min at step \`$step\`, so tehas stopped it before its time limit."
fi
[ "$forks" = 0 ] || killed="$killed Its container reached its limit of processes and $forks starts of a process were refused: what the cycle ran after that may not have run."
branch=$(jq -r '.pipelineState.branchName // ""' "$state" 2>/dev/null || echo "")
# The numbers are summed as numbers. Anything else in their place counts as
# nothing: a string would be joined up by the sum and posted word for word.
usage=$(jq -r '
  def n: tonumber? // 0;
  [.eventLog[] | select(.usage) | {role: ((.role // "driver" | tostring | gsub("[^A-Za-z0-9_.-]"; "")) as $r | if $r == "" then "driver" else $r end),
                                   u: (.usage | {turns: (.turns | n), input: (.input | n), output: (.output | n), cacheRead: (.cacheRead | n)})}] as $e
  | if ($e | length) == 0 then "" else
      (["| Role | Dispatches | Turns | Input | Output | Cache read |", "|---|---|---|---|---|---|"]
       + ($e | group_by(.role) | map("| \(.[0].role) | \(length) | \(map(.u.turns) | add) | \(map(.u.input) | add) | \(map(.u.output) | add) | \(map(.u.cacheRead) | add) |"))
       + ["| **total** | \($e | length) | \($e | map(.u.turns) | add) | \($e | map(.u.input) | add) | \($e | map(.u.output) | add) | \($e | map(.u.cacheRead) | add) |"])
      | join("\n") end' "$state" 2>/dev/null || echo "")

# The pull requests of the bot on the cycle's branch, in any state. The state
# file's word "merged" is a claim: it counts only with a merged pull request
# to show for it. A person may also merge or close one while the cycle runs.
# The branch name comes from a file the
# cycle wrote, so only a pull request the bot opened counts, and only one that
# names this issue: its head is the issue's branch as pi-rukas names it,
# feature/issue-<n>-..., or its body closes #<n>. A branch of another issue
# finds nothing. Without an answer a handoff would be taken for a cycle that
# left nothing.
# A list GitHub would not give is not an empty one: $unread says so.
prs="[]"
unread=0
if [ -n "$branch" ]; then
  for ((try = 1; try <= tries; try++)); do
    if prs=$(gh_call pr list --repo "$repo" --head "$branch" --author "@me" --state all \
      --json url,state,body,headRefName --limit 20 2>/dev/null) && jq -e 'type == "array"' >/dev/null 2>&1 <<<"$prs"; then
      break
    fi
    prs="[]"
    if [ "$try" = "$tries" ]; then
      unread=1
      log "WARN: the pull requests of $(tr -cd 'A-Za-z0-9_./-' <<<"$branch") could not be read"
    else
      sleep "$retry_wait"
    fi
  done
fi
# Whether a pull request names this issue, as jq.
# shellcheck disable=SC2016  # a jq program
names_issue='def mine: ((.headRefName // "") | tostring | (. == "feature/issue-\($n)" or startswith("feature/issue-\($n)-")))
  or ((.body // "") | tostring | test("(?i)\\b(close[sd]?|fix(e[sd])?|resolve[sd]?):?\\s+#\($n)([^0-9]|$)"));'
# pr_in <OPEN|MERGED|CLOSED>: the address of this issue's pull request in that
# state, or nothing.
pr_in() {
  jq -r --arg n "$issue" --arg st "$1" "$names_issue"'
    [.[] | select(type == "object" and ((.state // "") | ascii_upcase) == $st) | select(mine)
     | .url | strings | select(test("^https://[A-Za-z0-9./_-]+$"))] | first // ""' <<<"$prs" 2>/dev/null
}
pr=$(pr_in OPEN)
merged_pr=$(pr_in MERGED)
closed_pr=$(pr_in CLOSED)
# A pull request of the bot on the branch that names another issue is said, not
# taken.
foreign=""
if [ "$(jq --arg n "$issue" "$names_issue"'[.[] | select(type == "object") | select(mine | not)] | length' <<<"$prs" 2>/dev/null)" != 0 ] &&
  [ "$(jq --arg n "$issue" "$names_issue"'[.[] | select(type == "object") | select(mine)] | length' <<<"$prs" 2>/dev/null)" = 0 ]; then
  foreign=" The branch \`$(tr -cd 'A-Za-z0-9_./-' <<<"$branch")\` has a pull request of the bot that does not name this issue, so it is not taken as this cycle's."
fi
# Said in the comment when the label stayed: the issue then reads as running.
stuck=" The label of this issue could not be changed. The next poll of the dispatcher hands it to a human."

summary="status \`$status\`, last step \`$step\`, $mins min"
# park <text>: hand the issue to a human with the retry question.
park() {
  relabel --remove-label tehas:running --add-label needs-human-attention && stuck=""
  local parked="$1$stuck"
  jq -n --arg text "$parked

${usage}" '{text: $text, question: null}' >"$TEHAS_HOME/state/park-$issue.json"
  if post_question "$TEHAS_HOME/state/park-$issue.json"; then
    # On record before the label shows it: a tick counts only in the comment
    # named here. Without the record a tick starts nothing and says so.
    printf '%s\n' "$posted" >"$(park_id "$issue")" ||
      log "WARN: could not record the park question of #$issue, its boxes will not work"
    # A separate call: a repository without this label must still get the
    # parking label above. The poll only reads questions on issues that
    # carry this label, so without it the boxes do nothing: say so.
    if ! relabel --add-label tehas:question; then
      rm -f "$(park_id "$issue")"
      comment "The boxes above cannot be used: the label \`tehas:question\` could not be added (run \`tehas labels\` on the host). To retry, apply \`tehas:ready\`."
    fi
  else
    # Without the boxes there is nothing to tick: say the old way.
    comment "$parked To retry, apply \`tehas:ready\`.

${usage}"
  fi
  rm -f "$TEHAS_HOME/state/park-$issue.json"
}
log_where="the run log is \`~/tehas/logs/dispatch-work-$issue.log\` on \`$(hostname)\`"
if [ -n "$merged_pr" ]; then
  # A merge ends the cycle, whoever made it and whatever the state file says:
  # a person may merge while the cycle still reviews. tehasbot status labels
  # the closed issue as shipped.
  relabel --remove-label tehas:running && stuck=""
  if [ "$rc" = 0 ] && [ "$status" = merged ]; then
    comment "Tehas cycle finished: $summary. The change was merged: $merged_pr$killed$stuck"
    proven
  else
    comment "Tehas cycle ended: its pull request $merged_pr was merged while the cycle ran (last step \`$step\`, $mins min, runner exit $rc). Nothing more is needed here.$killed$stuck"
  fi
  status=merged
  pr=$merged_pr
  tidy
elif [ "$unread" = 1 ]; then
  # Whether the cycle left a pull request is not known. The branch stays on
  # record for whoever looks again.
  printf '%s\n' "$(tr -cd 'A-Za-z0-9_./-' <<<"$branch")" >"$cycles/$issue.branch" ||
    log "WARN: could not record the branch of #$issue"
  park "Tehas cycle stopped, and its pull request could not be looked up: GitHub did not list the pull requests of the branch \`$(tr -cd 'A-Za-z0-9_./-' <<<"$branch")\` ($summary, runner exit $rc). Look for one there before you retry. The workspace is kept; $log_where.$killed"
elif [ "$rc" = 0 ] && [ "$status" = merged ]; then
  # A claim the container wrote. Without the merge to show for it the
  # workspaces are kept: what they hold may exist nowhere else.
  park "Tehas cycle stopped: its state says \`merged\`, but the bot has no merged pull request for this issue on \`$(tr -cd 'A-Za-z0-9_./-' <<<"${branch:-none}")\` ($summary). Nothing was removed; $log_where.$killed${pr:+ Its branch has an open pull request: $pr}$foreign"
elif [ "$rc" = 0 ] && [ "$status" = handoff ] && [ -n "$pr" ]; then
  relabel --remove-label tehas:running --add-label tehas:awaiting-merge && stuck=""
  comment "Tehas cycle finished: $summary. Pull request waiting for a human: $pr$killed$stuck"
  gh_call pr comment "$pr" --body "Tehas cycle for #$issue: $summary.

${usage:-No token usage was recorded for this cycle.}" >/dev/null 2>&1 || log "WARN: comment on $pr failed"
  proven
  tidy
elif [ -z "$pr" ] && [ -n "$closed_pr" ] && [ "$rc" != 4 ]; then
  # A person closed the pull request without merging it: whether to try again
  # is theirs to say, with the label. No retry box.
  relabel --remove-label tehas:running --add-label needs-human-attention && stuck=""
  comment "Tehas cycle stopped: its pull request $closed_pr was closed without being merged ($summary, runner exit $rc). The workspace is kept; $log_where.$killed$stuck To retry, apply \`tehas:ready\`."
else
  parked="Tehas cycle stopped without a pull request: $summary (runner exit $rc). Read the handoff comment if there is one; $log_where.$killed${pr:+ Its branch has an open pull request: $pr}$foreign"
  [ "$rc" != 4 ] || parked="Tehas started no cycle: an image the issue links could not be fetched, or the issue could not be read for its images (runner exit $rc). The comment before this one names it; $log_where."
  park "$parked"
fi
log "done #$issue rc=$rc status=$status step=$step minutes=$mins pr=${pr:-none} oom_kills=$kills forks_refused=$forks"
# For the improvement loop, where the instance has one. The cycle is reported
# by now, and a record that cannot be written is the loop's loss only.
tehas_improve_record "$issue" "$started" "$rc" "$status" "$step" "$pr" "$kills" || log "WARN: no record of #$issue for the improvement loop"
# The next poll refreshes the status. A stopped cycle leaves it to that poll.
[ "$signalled" = 1 ] || "$status_cmd"
exit 0
