#!/usr/bin/env bash
# tehas dev: an interactive Pi session on the factory host. The session is the
# console's, and console/src/usage/dev.txt is the usage and its exit statuses.
# This loads the settings, gets the bot's token and, with --issue, the issue's
# images and files, which lib/attachments.sh fetches.
set -uo pipefail

here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
console=$here/console
[ -x "$console" ] || { echo "tehas dev: no console beside this command at $console, run install.sh" >&2; exit 78; }
"$console" check tehas dev "$@"
rc=$?
[ "$rc" != 99 ] || exit 0
[ "$rc" = 0 ] || exit "$rc"

# shellcheck source=lib/config.sh
. "$here/../lib/config.sh"
# shellcheck source=lib/sandbox.sh
. "$here/../lib/sandbox.sh"
# shellcheck source=lib/cycles.sh
. "$here/../lib/cycles.sh"
# shellcheck source=lib/attachments.sh
. "$here/../lib/attachments.sh"
# shellcheck source=lib/labels.sh
. "$here/../lib/labels.sh"
# shellcheck source=lib/github-app.sh
. "$here/../lib/github-app.sh"
tehas_load || exit 78
tehas_require TEHAS_REPO PI_ENSEMBLE_SUBAGENT_MODEL PI_ENSEMBLE_SUBAGENT_PROVIDER
tehas_sandbox_ok || exit 78
tehas_checkout || exit 78
tehas_branch >/dev/null || exit 78

tehas_github_env || { echo "tehas dev: no GitHub token for the app" >&2; exit 1; }
[ -n "${GH_TOKEN:-}" ] || { echo "tehas dev: GH_TOKEN is not set (source ~/tehas/env.sh)" >&2; exit 64; }

read -r name issue < <("$console" dev words "$@")
if [ "$issue" != - ]; then
  if [ "$TEHAS_WORK_IMAGES" != 1 ] && [ "$TEHAS_WORK_FILES" != 1 ]; then
    echo "tehas dev: this instance gives no images or files (TEHAS_WORK_IMAGES, TEHAS_WORK_FILES), so --issue has nothing to give" >&2
    exit 78
  fi
  images=$TEHAS_HOME/dev/$name.images
  mkdir -p "$TEHAS_HOME/dev" || exit 78
  approved=""
  tehas_label_allowed "$issue" tehas:ready
  case $? in
    0) approved=approved ;;
    2) approved=unread ;;
  esac
  image_why="the issue's label events could not be read for its images"
  if [ "$approved" = unread ] || ! tehas_issue_images "$issue" "$images" "$approved"; then
    rm -rf "$images"
    echo "tehas dev: $image_why, not starting a session" >&2
    exit 4
  fi
  said=$(tehas_issue_images_said "$images" session "$(tehas_rukas_reads_images)")
  [ -z "$said" ] || printf '%s\n' "$said" | sed 's/^/tehas dev: /'
fi

exec "$console" dev run "$@"
