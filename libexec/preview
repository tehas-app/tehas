#!/usr/bin/env bash
# Keep a running preview of every open pull request: a container that serves
# the product as that pull request has it, reached through the edge router as
# uat-<number>.<TEHAS_DOMAIN> (edge/router.Caddyfile).
#
#   which ones      Open pull requests whose head branch is in the product
#                   repository itself, opened by an owner, member or
#                   collaborator of the repository. A pull request from a
#                   fork is never built. Nor is one by anyone else: on a
#                   public repository anyone can open a pull request between
#                   two branches it already has.
#   what it is      The image that preview/Dockerfile of that commit builds,
#                   answering HTTP on port 8080. A commit without that file
#                   has no preview.
#   what it gets    Nothing of the host: no mount, no variable, no port, no
#                   token, a read-only root, and a network that has the
#                   router and the other previews on it and nothing else:
#                   not the internet and not the host. The build gets the
#                   commit as an archive on standard input and nothing else.
#   what it writes  Nothing on the host's disk but its output, which Docker
#                   keeps to two files of 10 MB. /tmp, /config and /data are
#                   in memory. A recipe that declares a volume anywhere else
#                   is not run: Docker would put that volume on the disk.
#   how many        The newest TEHAS_PREVIEW_MAX. The rest say "over-limit".
#                   All the open pull requests are read, in pages of 100; a
#                   run that cannot finish reading them builds and removes
#                   nothing.
#   when it goes    At the next run after the pull request is merged or
#                   closed: the container, the image, the fetched ref and
#                   the state. Nothing is removed before GitHub is asked about
#                   that pull request by itself: a list read in pages is not
#                   one answer taken at one moment.
#   what it says    A notice at the top of the pull request's own description,
#                   between two marker lines, edited in place: the address, or
#                   "Unable to create a preview" with the reason, for a failed
#                   build and for a full disk. A pull request that falls over
#                   the limit or loses its recipe has that notice say there is
#                   no preview. It gets no notice if it had none. Everything
#                   between the two marker lines at the very top is this
#                   command's to replace, and only when it is one of the notices
#                   it writes; anything else there, or any other marker line, is
#                   left as GitHub gave it. A notice a person removes, or one
#                   someone writes in the shape of the bot's, is put right at the
#                   next run.
#   a full disk     Under TEHAS_PREVIEW_MIN_FREE of free space nothing is
#                   built. What serves stays, and removal still runs. The
#                   figures are in previews.json at every run, and tehasbot
#                   health reads them.
#
# Each pull request has a state in $TEHAS_HOME/preview/<number>/state.json:
# serving, building, no-recipe, build-failed, no-space or over-limit. Serving
# is a container that was still running a few seconds after its start. The list
# for the dashboard is $TEHAS_HOME/live/previews.json. A build's output is in
# $TEHAS_HOME/logs/preview-<number>.log. Deterministic, no model.
#
# Usage: tehasbot preview            bring the previews in step with the pull requests
#        tehasbot preview --sweep    the three hour check of what is left on the host
#
# The sweep is the second check that nothing of a merged or closed pull
# request stays on the host. It works from the containers, images, fetched
# refs and directories it finds, not from GitHub's list, and asks about each
# pull request by itself. It waits for a run to end and a run does not start
# while it works. A line "swept" in the log is something the five minute run
# missed.
#
# Exit: 0 done, or GitHub or Docker did not answer and what runs was left
#       running; 1 it cannot write under $TEHAS_HOME; 64 a wrong argument;
#       78 the instance settings are invalid or TEHAS_PREVIEWS is not 1.
set -uo pipefail
umask 022

here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source=lib/config.sh
. "$here/../lib/config.sh"
# shellcheck source=lib/edge.sh
. "$here/../lib/edge.sh"

mode=run
case "${1:-}" in
  "") ;;
  --sweep) mode=sweep ;;
  *)
    echo "usage: tehasbot preview [--sweep]" >&2
    exit 64
    ;;
esac

# Taken before the settings are loaded: loading drops every TEHAS_ variable
# the environment has. See "settle" below.
settle_asked=${TEHAS_PREVIEW_SETTLE:-}
tehas_load || exit 78
tehas_require TEHAS_REPO
if [ "$TEHAS_PREVIEWS" != 1 ]; then
  tehas_err "TEHAS_PREVIEWS is not 1: this instance has no previews"
  exit 78
fi

repo=$TEHAS_REPO
root=$TEHAS_PROJECT_HOME/preview
bare=$root/repo.git
live=$TEHAS_PROJECT_HOME/live
logs=$TEHAS_PROJECT_HOME/logs
net=tehas-previews
# A pull request's number, wherever one is matched here: one to nine digits,
# no zero in front. tehas_edge_name and the jq program of the run have the same.
number='^[1-9][0-9]{0,8}$'
recipe=preview/Dockerfile
build_limit=900
# The open pull requests are read in pages, newest first, and 100 is what
# GitHub answers with at most. Beyond pull_pages of them the run has not read
# the list, and it does not remove anything on a list it has not read. When
# page pull_pages comes back full one more answer says whether the list ends
# there, so that a list of exactly pull_pages * pull_page_size is read.
pull_page_size=100
pull_pages=10
# The seconds between a container's start and the question whether it still
# runs. TEHAS_PREVIEW_SETTLE is there for the tests, so that they do not wait.
# It is not documented as a setting, but a line in instance.env reaches it all
# the same, through env.sh. So it can only shorten the wait: a whole number
# below the default is taken, and anything else is the default.
settle=5
if [[ $settle_asked =~ ^[0-4]$ ]]; then settle=$settle_asked; fi
# The notice in a description is this command's only between these two lines,
# only when the first of them is the first line of the description, and only
# when everything between them is one of the notices it writes.
marker='<!-- tehas-preview -->'
marker_end='<!-- /tehas-preview -->'
# How the three notice lines begin, and the one sentence two of them are
# followed by. tell builds a notice from these; the jq program that decides
# whether a block is this command's reads the same two values, so rewording a
# notice changes this pair and nothing else.
notice_starts=('Preview of `' 'Unable to create a preview' 'There is no preview')
notice_tail='It is rebuilt when the branch changes and removed when this pull request is closed.'
# The same beginnings as one JSON array, for that jq program. Made once here.
notice_json=$(jq -cn '$ARGS.positional' --args "${notice_starts[@]}")
min_kb=$((TEHAS_PREVIEW_MIN_FREE_MB * 1024))
free=""
low=false

mkdir -p "$root" "$live" "$logs" "$TEHAS_HOME/tmp" || exit 1
# scratch <prefix>: a temporary file under $TEHAS_HOME/tmp, named
# preview-<prefix>.<six characters>; scratch_file names it. Every file made here
# is remembered, and the trap below removes them all, whatever ends this run - a
# signal included, because bash runs the EXIT trap when a signal ends it. Without
# it a run that was stopped leaves a file the next run does not know about. A
# caller that can do without one takes /dev/null instead. scratch is not called
# in a command substitution: the file has to be remembered by this shell.
scratch_files=()
scratch_file=""
scratch() {
  local f
  if ! f=$(mktemp "$TEHAS_HOME/tmp/preview-$1.XXXXXX" 2>/dev/null); then
    scratch_file=""
    return 1
  fi
  scratch_files+=("$f")
  scratch_file=$f
}
trap 'for f in "${scratch_files[@]+"${scratch_files[@]}"}"; do rm -f "$f"; done' EXIT
# The sweep waits for a run to end; a run does not wait for anything.
if [ "$mode" = sweep ]; then
  edge_lock preview 1800 || { echo "the lock was not free in 30 minutes, nothing was swept"; exit 0; }
else
  edge_lock preview || { echo "another tehasbot preview is running"; exit 0; }
fi

# --- The state of one pull request -------------------------------------------
field() { jq -r --arg k "$2" '.[$k] // ""' "$root/$1/state.json" 2>/dev/null; }
# mark <number> <commit> <state> [reason]: written only when it differs, so
# "time" is when the state began.
mark() {
  local n=$1 sha=$2 state=$3 reason=${4:-} pull=$root/$1/pull.json
  if [ "$(field "$n" sha)" = "$sha" ] && [ "$(field "$n" state)" = "$state" ]; then return 0; fi
  mkdir -p "$root/$n" || return 1
  [ -f "$pull" ] || echo '{}' >"$pull"
  # shellcheck disable=SC2016  # a jq program: the variables are jq's
  edge_put "$root/$n/state.json" jq -n --argjson n "$n" --arg sha "$sha" --arg state "$state" \
    --arg reason "$reason" --arg now "$(date -u +%FT%TZ)" --slurpfile pull "$pull" '
    {number: $n, sha: $sha, state: $state, reason: $reason, time: $now,
     title: ($pull[0].title // ""), url: ($pull[0].url // null)}' || return 1
  echo "#$n: $state${reason:+ ($reason)}"
}
# retitle <number>: a pull request that got a new title has it in its state,
# whatever the state is. Nothing else of the state changes: no state began, so
# "time" stays and no line is written. A state that cannot be read is left
# for mark.
retitle() {
  local n=$1 pull=$root/$1/pull.json
  [ -f "$root/$n/state.json" ] || return 0
  [ "$(field "$n" title)" != "$(jq -r '.title // ""' "$pull" 2>/dev/null)" ] || return 0
  # shellcheck disable=SC2016  # a jq program: the variables are jq's
  edge_put "$root/$n/state.json" jq --slurpfile pull "$pull" \
    '. + {title: ($pull[0].title // ""), url: ($pull[0].url // null)}' "$root/$n/state.json" 2>/dev/null
  return 0
}

# --- Docker ------------------------------------------------------------------
serving() { # <number> <commit>: is a container of that commit running?
  [ -n "$(docker ps --quiet --filter "name=^$(tehas_name preview "$1")\$" --filter "label=tehas.sha=$2" 2>/dev/null)" ]
}
# A container goes with -v: a volume Docker made for it goes too. No preview
# should have one, see volume_fault, and nothing is left on the disk if one has.
stop() { # <number>: the container and the image
  docker rm -f -v "$(tehas_name preview "$1")" >/dev/null 2>&1
  docker image rm -f "$(tehas_name preview-image "$1")" >/dev/null 2>&1
  return 0
}
# is_id <text>: is it a container id as a listing prints one? Only such a
# word is handed to "docker rm -f", which would take anything else as a name
# or an option.
is_id() { [[ $1 =~ ^[0-9a-f]+$ ]]; }
purge() { # <number>: everything of one pull request
  stop "$1"
  git -C "$bare" update-ref -d "refs/preview/$1" 2>/dev/null
  rm -rf "${root:?}/$1" "$logs/preview-$1.log"
}

# --- Free space --------------------------------------------------------------
# free_kb: the free kilobytes of the host, the smaller of the file system of
# $TEHAS_HOME and the one Docker keeps its images on. Fails when the first
# cannot be read: no figure is not the same as plenty.
free_kb() {
  local a b dir
  a=$(df -Pk "$TEHAS_HOME" 2>/dev/null | awk 'NR == 2 {print $4}')
  [[ $a =~ ^[0-9]+$ ]] || return 1
  dir=$(docker info --format '{{.DockerRootDir}}' 2>/dev/null)
  b=$(df -Pk "${dir:-/var/lib/docker}" 2>/dev/null | awk 'NR == 2 {print $4}')
  [[ $b =~ ^[0-9]+$ ]] || b=$a
  echo $((a < b ? a : b))
}
# measure: set "free" and "low" for this run. Space that cannot be read is
# low: nothing is built on a guess.
measure() {
  if free=$(free_kb); then
    [ "$free" -ge "$min_kb" ] || low=true
  else
    free=""
    low=true
  fi
}
gb() { awk -v kb="$1" 'BEGIN { printf "%.1f GB", kb / 1048576 }'; }

# --- The notice in the pull request's description ----------------------------
# What this command already said about one pull request is on record in
# $root/<number>/.notice, as "<commit> <state> <outcome> <attempts> <time>":
# none (there was nothing to say), said (the notice is there), refused (the block
# at the top of the description is not this command's), failed, with how many
# writes GitHub did not take, or gaveup, after three of them were not taken. The
# time is the one GitHub gave for that pull request when this command last looked
# at its description.
# A record ends the talk about that commit and state: a full disk is not an edit
# every five minutes, and a notice GitHub will not take is said about once for
# each attempt and then left to the next commit or state, not at every run until
# one comes. It does not end the looking. A description edited at the top is
# found at the next run, because GitHub's time for the pull request is then later
# than the one on record: the description is read again, so a notice a person
# removed comes back and one written by someone else in the shape of the bot's is
# written over. Ownership of a description is only what its text says, so it is
# looked at again whenever the text can have changed. Only a read that failed
# leaves nothing on record, so the next run asks again.
# notice_said <number> <key>: "<outcome> <attempts> <time>" for that commit and
# state, and nothing at all when there is no record or the key is another one.
notice_said() {
  local sha state what tries seen
  read -r sha state what tries seen <<<"$(cat "$root/$1/.notice" 2>/dev/null)" || return 0
  [ "$sha $state" = "$2" ] || return 0
  echo "${what:-} ${tries:-0} ${seen:-}"
}
# notice_record <number> <key> <outcome> [attempts] [time]: put that on record. A
# record this command cannot write is said in the log, because without it the
# same notice would be written at every run.
notice_record() {
  local line
  line="$2 $3 ${4:-0}"
  if [ -n "${5-}" ]; then
    line="$line $5"
  fi
  printf '%s\n' "$line" >"$root/$1/.notice" ||
    echo "#$1: the notice was not recorded on the host, tried again at the next run"
}
# why_failed <file>: one short reason for a call or a program that failed, from
# what it wrote to that file. As in the sweep: a token that lost access gets 404
# for every pull request, which an operator can tell from a moment of rate limit
# or from a call that never came back. Control characters go and the text is cut
# short.
why_failed() {
  local line
  line=$(tail -n 1 "$1" 2>/dev/null | tr -d '[:cntrl:]' | sed 's/^jq: error ([^)]*): //')
  case "$line" in
    *"HTTP 404"*) echo "no such pull request (HTTP 404)" ;;
    *"HTTP 403"* | *"HTTP 429"* | *"rate limit"*) echo "GitHub refused the call (HTTP 403)" ;;
    "") echo "no answer" ;;
    *) echo "${line:0:80}" ;;
  esac
}
# notice_plan <number> <block> <create>: ask GitHub what it has as that pull
# request's description at this moment, and decide what to do with it. Said is
# the decision as one JSON object: the action (write, none, refuse or closed),
# the description GitHub had, for a write the whole new description, and the time
# GitHub gives for that pull request, which is what goes on record with what was
# said about it.
# Returns 0 with a decision in Said, 1 when GitHub did not answer, 2 when it
# answered and this command could not make sense of the answer.
Said=""
notice_plan() {
  local n=$1 block=$2 create=$3 answer err reason
  if scratch tell; then err=$scratch_file; else err=/dev/null; fi
  if ! answer=$(gh api "repos/$repo/pulls/$n" --jq '{number, body, state, updated_at}' 2>"$err"); then
    reason=$(why_failed "$err")
    [ "$err" = /dev/null ] || rm -f "$err"
    echo "#$n: the description could not be read ($reason), tried again at the next run"
    return 1
  fi
  # shellcheck disable=SC2016  # a jq program: the variables are jq's
  Said=$(jq -c --argjson n "$n" --arg marker_open "$marker" \
    --arg marker_close "$marker_end" --arg notice_tail "$notice_tail" \
    --argjson notice_starts "$notice_json" --arg block "$block" \
    --argjson notice_create "$create" '
    def description: if has("body") | not then error("no description")
              elif (.body | type) == "string" then .body
              elif .body == null then ""
              else error("no description") end;
    # A line of a description, without the carriage return a CRLF line ending
    # leaves.
    def bare: sub("\r$"; "");
    def at($lines; $m): [range(0; $lines | length) | select(($lines[.] | bare) == $m)];
    # The new description: the block, then everything after the closing marker
    # line as GitHub gave it. Everything between the two marker lines is
    # replaced, all of it, because that region belongs to this command. With no
    # line under the closing one the block ends the description with the newline
    # that closing line ended with, so a description that is only the notice, or
    # one that ends in a blank line under it, keeps its shape and is not written
    # again at the next look.
    def splice($i): (.[($i + 1):]) as $rest |
      if ($rest | length) == 0 then $block + "\n"
      else $block + "\n" + ($rest | join("\n")) end;
    # A line of a notice this command writes begins like one of its beginnings.
    def mine($line): ($line // "") | bare as $text |
      any($notice_starts[]; . as $p | $text | startswith($p));
    # All of the region between two marker lines that belongs to this command:
    # its notice line, and for a preview that was made or attempted, the fixed
    # sentence after a blank line. A blank line under the opening marker is how
    # the notice is written, so that it is not part of the HTML comment; one is
    # allowed there. Either notice is owned whichever one this run would write
    # now. It owns nothing else.
    def ours($lines):
      (if (($lines[0] // "") | bare) == "" then $lines[1:] else $lines end) as $r
      | mine($r[0]) and (($r | length) == 1 or
          (($r | length) == 3 and ($r[1] | bare) == "" and
           ($r[2] | bare) == $notice_tail));
    if (.number | type) != "number" or .number != $n then error("not this pull request") else . end
    | (.state // "") as $state
    # The time GitHub gives for the pull request. It moves when the description
    # does, and it is the only sign of a description this command did not write.
    | (.updated_at | if type == "string" then . else "" end) as $seen
    | description as $b
    | ($b | split("\n")) as $L
    | at($L; $marker_open) as $opens
    | at($L; $marker_close) as $closes
    # A closing marker of the first line is not under a block of ours.
    | [($closes[] | select(. > 0))] as $under
    # What GitHub says about the pull request at this moment, not what the run
    # was told minutes ago: a merged or closed one keeps its description.
    | if $state != "open" then {action: "closed", old: $b, seen: $seen}
      # No marker line anywhere: add the notice, or say nothing at all.
      elif ($opens | length) == 0 and ($closes | length) == 0 then
        (if $notice_create
         then {action: "write", old: $b, seen: $seen,
               body: (if $b == "" then $block else $block + "\n\n" + $b end)}
         else {action: "none", old: $b, seen: $seen} end)
      # The block this command owns is the one at the very top. Marker lines
      # anywhere else are text of someone else and stay where they are.
      elif ($opens | length) >= 1 and $opens[0] == 0 and ($under | length) >= 1 and
        ours($L[1:$under[0]]) then
        {action: "write", old: $b, seen: $seen, body: ($L | splice($under[0]))}
      else {action: "refuse", old: $b, seen: $seen} end' \
    <<<"$answer" 2>"$err") || Said=""
  if [ -z "$Said" ]; then
    # jq runs its program on no input at all and says nothing with exit 0, so an
    # empty answer here is one this command could not make sense of.
    reason=$(why_failed "$err")
    [ "$err" = /dev/null ] || rm -f "$err"
    echo "#$n: the answer about this pull request was not understood ($reason), tried again at the next run"
    return 2
  fi
  [ "$err" = /dev/null ] || rm -f "$err"
  return 0
}
# tell <number> <time>: say where the preview is, or that it could not be created
# and why, at the top of the pull request's own description, between the marker
# lines. <time> is the one GitHub gives for that pull request in the list the run
# was given. Once for each commit and state, on record in
# $root/<number>/.notice: what this command said about a commit and state is not
# said again until one of them changes, or until GitHub says the pull request
# moved since the last look. A call that failed is tried at the next run; three
# writes GitHub did not take are enough for that commit and state, and the line
# about it is said with the third of them, not at every run after it. Over the
# limit and without a recipe there is nothing to say here, so a pull request whose
# description has no notice gets none for those. One that has a notice has it
# changed: it would otherwise go on giving an address that answers 404.
# The description is asked for at the moment of the edit, not from the list the
# run was given minutes ago, so that a person who changed it before that read is
# kept. GitHub takes no condition on a write of a description, so an edit made
# between the read and the write is lost: what was read is kept in
# $root/<number>/.description, mode 0600, and every write is said in the log.
# Only a notice this command wrote is changed, and all of it. Anyone can write
# the marker lines, so a block is this one's only when it opens the description
# and everything between its two marker lines is one of the notices this command
# writes. Text between markers it does not own, or marker lines anywhere else,
# stay as GitHub gave them. Because that test is only the text of a description,
# it is run again whenever GitHub says the pull request changed: a notice a person
# removes comes back at the next run, and so is one someone wrote at the top in
# the shape of the bot's.
tell() {
  local n=$1 stamp=${2-} sha state reason key record outcome='' tries=0 was='' seen=''
  local action text block old new create=true answer after=''
  sha=$(field "$n" sha)
  state=$(field "$n" state)
  reason=$(field "$n" reason)
  key="$sha $state"
  record=$(notice_said "$n" "$key")
  if [ -n "$record" ]; then
    read -r outcome tries was <<<"$record"
  fi
  case "$tries" in
    [0-9]) ;;
    *) tries=0 ;;
  esac
  case "$outcome" in
    said | none | refused | gaveup)
      # The record stands while GitHub gives the same time for the pull request
      # as it did when this command last looked. A later time is a description
      # someone changed, and the description is read again: no write and no log
      # line follow unless the read asks for one, so a pull request with a lot of
      # talk on it costs one read and nothing else.
      if [ "$was" = "$stamp" ]; then
        return 0
      fi
      ;;
    failed)
      if [ "$tries" -ge 3 ]; then
        # The line about it was said with the third write GitHub did not take.
        # Put the giving-up on record so that no later run says it again.
        notice_record "$n" "$key" gaveup "$tries" "$was"
        return 0
      fi
      ;;
  esac
  case "$state" in
    # The first beginning ends with the backtick that opens the commit id.
    serving) text="${notice_starts[0]}${sha:0:7}\`: https://$(tehas_edge_name uat "$n")/" ;;
    build-failed | no-space) text="${notice_starts[1]} of \`${sha:0:7}\`. $reason" ;;
    over-limit | no-recipe)
      text="${notice_starts[2]} of \`${sha:0:7}\`. $reason"
      create=false
      ;;
    *) return 0 ;;
  esac
  # The blank line under the opening marker keeps the notice out of the HTML
  # comment: without it the notice is part of that comment and renders as raw
  # text, which is the line that carries the address.
  block="$marker

$text"
  [ "$create" = false ] || block="$block

$notice_tail"
  block="$block
$marker_end"
  notice_plan "$n" "$block" "$create" || return 0
  # The action and the time GitHub gives for the pull request, read from an
  # answer whose shape this command can use. An answer of another shape is not
  # acted on.
  action=$(jq -er 'select((.action | type) == "string" and (.old | type) == "string"
      and (.action != "write" or (.body | type) == "string")) | .action' <<<"$Said") || {
    echo "#$n: the answer about this pull request was not understood, tried again at the next run"
    return 0
  }
  seen=$(jq -r 'if (.seen | type) == "string" then .seen else "" end' <<<"$Said" 2>/dev/null) || seen=""
  case "$action" in
    none) notice_record "$n" "$key" none 0 "$seen"; return 0 ;;
    closed)
      # Merged or closed between the list the run was given and this read. The
      # description keeps what it has, and the next run removes the preview.
      notice_record "$n" "$key" none 0 "$seen"
      echo "#$n: the pull request is no longer open, nothing was written"
      return 0 ;;
    refuse)
      # The block at the top is not this command's. The line is said once for
      # this commit and state, not again for every later look at the same
      # description: the description is read again whenever GitHub says it
      # changed, and a person who clears those marker lines gets the notice then.
      notice_record "$n" "$key" refused 0 "$seen"
      if [ "$outcome" != refused ]; then
        echo "#$n: the description has a preview notice that is not this one, left alone"
      fi
      return 0 ;;
    write) ;;
    *)
      # Not an action this command's program answers with. Nothing is written.
      echo "#$n: the answer about this pull request was not understood ($action), tried again at the next run"
      return 0 ;;
  esac
  # The description GitHub had and the one to write, byte for byte. The X is
  # there because a command substitution takes the trailing newlines off, and a
  # person's blank line at the end of a description is kept.
  old=$(jq -r '(.old // "") + "X"' <<<"$Said")
  old=${old%X}
  new=$(jq -r '(.body // "") + "X"' <<<"$Said")
  new=${new%X}
  if [ "$new" = "$old" ]; then
    # The description already says exactly this: nothing to write and nothing to
    # keep a copy of.
    notice_record "$n" "$key" none 0 "$seen"
    return 0
  fi
  # What GitHub had as the description before this command changed it, for the
  # tehas user only. An edit written over by mistake can be read back from here.
  (umask 077; printf '%s' "$old" >"$root/$n/.description") || {
    echo "#$n: the description was not backed up, the notice was not written, tried again at the next run"
    return 0
  }
  # GitHub answers a write of a description with the pull request as it has it
  # then, and that answer carries the new time. The record keeps it, so that the
  # notice this command wrote is not read back at the next run only to find it
  # unchanged.
  if answer=$(gh api -X PATCH "repos/$repo/pulls/$n" -f body="$new" 2>/dev/null); then
    after=$(jq -r 'if (.updated_at | type) == "string" then .updated_at else "" end' \
      <<<"$answer" 2>/dev/null) || after=""
  else
    tries=$((tries + 1))
    if [ "$tries" -ge 3 ]; then
      # Said once, with the third write that GitHub did not take: the record ends
      # the writes for that commit and state, so a pull request whose description
      # GitHub will not take says nothing more until the commit or the state
      # changes, or until GitHub says the description did. A later look at the
      # same giving-up does not say the line a second time.
      notice_record "$n" "$key" gaveup "$tries" "$seen"
      if [ "$outcome" != gaveup ]; then
        echo "#$n: the notice was not written three times, left to the next commit or state"
      fi
    else
      notice_record "$n" "$key" failed "$tries" "$seen"
      echo "#$n: the notice was not written, tried again at the next run"
    fi
    return 0
  fi
  notice_record "$n" "$key" said 0 "${after:-$seen}"
  echo "#$n: the notice was written"
}

# --- One build ---------------------------------------------------------------
# start_failed <number> <commit> <failed starts so far> <reason>: the image was
# built and no container of it stayed up. The host may have hiccuped, not the
# commit: the next runs try again. Three tries ride out a hiccup, and a recipe
# that cannot start does not loop.
start_failed() {
  [ "$3" -ge 3 ] || echo "$2 $(($3 + 1))" >"$root/$1/.retry"
  mark "$1" "$2" build-failed "$4"
}

# volume_fault <number> <log>: says nothing and returns 0 when the image built
# for that pull request declares no volume outside /tmp, /config and /data,
# which the container has in memory. Otherwise prints why and returns 1. For a
# path anywhere else Docker makes a volume on the host's disk: it can be written
# under a read-only root, it is outside the memory limit, and it stays when the
# container goes. No answer, or one that is not a set of paths, is not a
# "none".
# The path is text of the recipe's own, so it goes in that pull request's build
# log. What is printed here reaches state.json and the notice in the pull
# request's description, where the bot's own account would be quoting someone
# else's commit.
volume_fault() {
  local said found
  said=$(docker image inspect --format '{{json .Config.Volumes}}' "$(tehas_name preview-image "$1")" 2>/dev/null {edge_lock_fd}>&-) || said=""
  # The path is the recipe's own text: it is printed without control
  # characters and cut short.
  found=$(jq -r -s '
    if length != 1 then error("not one answer") else .[0] end
    | if . == null then "ok"
      elif type != "object" then error("not volumes")
      else [keys_unsorted[] | select(IN("/tmp", "/config", "/data") | not)]
           | if length == 0 then "ok" else "at:" + (.[0] | gsub("[[:cntrl:]]"; "") | .[0:80]) end
      end' <<<"$said" 2>/dev/null) || found=""
  case "$found" in
    ok) return 0 ;;
    at:*)
      printf 'The recipe declares a volume at %s. A preview may write to /tmp, /config and /data only.\n' \
        "${found#at:}" >>"$2"
      echo "The recipe declares a volume outside /tmp, /config and /data. Its path is in logs/preview-$1.log on the host." ;;
    *) echo "The image's volumes could not be read." ;;
  esac
  return 1
}

# build <number>: fetch the pull request's head, build its recipe, replace the
# container. The commit is the one fetched, which is the one built.
build() {
  local n=$1 sha log=$logs/preview-$1.log old retry=$root/$1/.retry tries=0 mark_sha mark_n fault
  if [ ! -d "$bare" ]; then
    git init -q --bare "$bare" || return 1
    # The product checkout knows the address and how to sign in to it.
    git -C "$bare" remote add origin \
      "$(git -C "${TEHAS_WORK_REPO:-/nonexistent}" config --get remote.origin.url 2>/dev/null ||
        echo "https://github.com/$repo.git")" || return 1
  fi
  : >"$log"
  # Close the lock's descriptor on every command that can outlive the run: a
  # descriptor they inherit would hold the lock after the run has ended (a
  # detached gc, a daemon).
  if ! git -C "$bare" fetch --quiet --no-tags origin "+refs/pull/$n/head:refs/preview/$n" >>"$log" 2>&1 {edge_lock_fd}>&-; then
    # No state: a fetch that failed says nothing about the commit.
    echo "#$n: the commit could not be fetched, tried again at the next run"
    return 1
  fi
  sha=$(git -C "$bare" rev-parse --verify --quiet "refs/preview/$n^{commit}") || return 1
  # The retry marker is "<commit> <failed starts so far>". It is read here and
  # cleared whatever this build turns out to be, so no path keeps a stale one.
  # The file is looked for first: bash reports a redirection from a file that
  # is not there by itself, into the run's log, at nearly every build.
  if [ -f "$retry" ] && read -r mark_sha mark_n <"$retry" && [ "$mark_sha" = "$sha" ]; then
    case "$mark_n" in [0-9]) tries=$mark_n ;; esac
  fi
  rm -f "$retry"
  if ! git -C "$bare" cat-file -e "$sha:$recipe" 2>/dev/null; then
    stop "$n"
    mark "$n" "$sha" no-recipe "The commit has no $recipe."
    return 0
  fi
  mark "$n" "$sha" building
  old=$(docker image inspect --format '{{.Id}}' "$(tehas_name preview-image "$n")" 2>/dev/null) || old=""
  # git's own complaint goes to this pull request's log, as the build's does.
  if ! git -C "$bare" archive "$sha" 2>>"$log" {edge_lock_fd}>&- | timeout "$build_limit" docker build --quiet \
    -f "$recipe" -t "$(tehas_name preview-image "$n")" \
    --label "tehas.preview=$n" --label "tehas.sha=$sha" --label "tehas.repo=$repo" - >>"$log" 2>&1 {edge_lock_fd}>&-; then
    mark "$n" "$sha" build-failed "The build failed or ran over $((build_limit / 60)) minutes. Its output is in logs/preview-$n.log on the host."
    return 1
  fi
  # Asked before the old container goes, so this is a failed build like any
  # other: the earlier preview keeps serving and the commit is not tried
  # again. The image is of no use and is removed.
  if ! fault=$(volume_fault "$n" "$log"); then
    docker image rm "$(tehas_name preview-image "$n")" >/dev/null 2>&1 {edge_lock_fd}>&-
    mark "$n" "$sha" build-failed "$fault"
    return 1
  fi
  # The same name cannot run twice, so the old container goes first. It is a
  # few seconds of the router's 404.
  docker rm -f -v "$(tehas_name preview "$n")" >/dev/null 2>&1
  if ! docker run --detach --name "$(tehas_name preview "$n")" --network "$net" \
    --read-only --tmpfs /tmp --tmpfs /config --tmpfs /data \
    --cap-drop ALL --cap-add NET_BIND_SERVICE --security-opt no-new-privileges:true \
    --memory 256m --cpus 1 --pids-limit 128 --log-opt max-size=10m --log-opt max-file=2 \
    --restart unless-stopped \
    --label "tehas.preview=$n" --label "tehas.sha=$sha" --label "tehas.repo=$repo" \
    "$(tehas_name preview-image "$n")" >>"$log" 2>&1 {edge_lock_fd}>&-; then
    start_failed "$n" "$sha" "$tries" "The container did not start. See logs/preview-$n.log on the host."
    return 1
  fi
  # docker run answers once the process is started. One that stops at once,
  # because it writes outside its three directories or misses a variable, would
  # be called serving and be started again for ever. So it is asked a moment
  # later: still running, and never restarted.
  sleep "$settle"
  if [ "$(docker inspect --format '{{.State.Running}} {{.RestartCount}}' "$(tehas_name preview "$n")" 2>/dev/null {edge_lock_fd}>&-)" != "true 0" ]; then
    {
      echo "docker logs of $(tehas_name preview "$n"), which started and stopped:"
      docker logs --tail 40 "$(tehas_name preview "$n")" {edge_lock_fd}>&-
    } >>"$log" 2>&1
    docker rm -f -v "$(tehas_name preview "$n")" >/dev/null 2>&1 {edge_lock_fd}>&-
    start_failed "$n" "$sha" "$tries" "The container started and stopped. See \"docker logs\" in logs/preview-$n.log on the host."
    return 1
  fi
  if [ -n "$old" ] && [ "$old" != "$(docker image inspect --format '{{.Id}}' "$(tehas_name preview-image "$n")" 2>/dev/null)" ]; then
    docker image rm "$old" >/dev/null 2>&1
  fi
  mark "$n" "$sha" serving
}

# --- The list for the dashboard ----------------------------------------------
write_list() {
  local files=() f sweep=$root/sweep.json
  for f in "$root"/*/state.json; do
    [ -f "$f" ] && files+=("$f")
  done
  [ -f "$sweep" ] || sweep=/dev/null
  # shellcheck disable=SC2016  # a jq program: the variables are jq's
  edge_put "$live/previews.json" jq -s --arg now "$(date -u +%FT%TZ)" --arg domain "$TEHAS_DOMAIN" \
    --arg free "$free" --argjson min "$min_kb" --argjson low "$low" --slurpfile sweep "$sweep" '
    {generatedAt: $now,
     disk: {freeBytes: (if $free == "" then null else ($free | tonumber) * 1024 end),
            minFreeBytes: ($min * 1024), low: $low},
     lastSweep: ($sweep[0] // null),
     previews: (sort_by(-.number) | map(. + {address:
       (if .state == "serving" then "https://uat-\(.number).\($domain)/" else null end)}))}' \
    "${files[@]}" </dev/null
}

# pull_verdict <number> <file for the error of a call that failed>: what GitHub
# says about one pull request, read as the sweep reads it. keep is an open pull
# request of this repository opened by one of ours; closed, gone, elsewhere and
# outside are each a reason to remove what is on the host for it; unclear is an
# answer that must not be acted on. The caller has already checked that $1 is a
# number, which is what lets it go in the jq program as one.
pull_verdict() { # <number> <file>
  local n=$1 err=$2 answer verdict
  if answer=$(gh api "repos/$repo/pulls/$n" 2>"$err"); then
    # Only "closed" is closed. An open pull request is elsewhere with a head
    # that is not in this repository, a deleted fork (a null repo) included.
    # With a head here it is ours when an owner, member or collaborator opened
    # it and outside when the answer names anyone else. Anything else, an
    # answer that does not say who opened it or one about another number
    # included, is unclear.
    # shellcheck disable=SC2016  # a jq program: $repo and $n are jq's variables
    verdict=$(jq -r --arg repo "$repo" --argjson n "$n" '
      if (.state | type) != "string" or (.number | type) != "number" or .number != $n then "unclear"
      elif .state == "closed" then "closed"
      elif .state != "open" then "unclear"
      elif (.head | type) != "object" then "unclear"
      elif ((.head.repo.full_name // "") | ascii_downcase) == ($repo | ascii_downcase) then
        (if (.author_association | type) != "string" then "unclear"
         elif (.author_association | IN("OWNER", "MEMBER", "COLLABORATOR")) then "keep"
         else "outside" end)
      elif .head.repo == null or ((.head.repo.full_name | type) == "string") then "elsewhere"
      else "unclear" end' <<<"$answer" 2>/dev/null) || verdict=unclear
  elif grep -q 'HTTP 404' "$err" 2>/dev/null; then
    # No such pull request. The sweep checks that GitHub shows the repository
    # at all before it reads a 404 this way; a caller that got an answer from
    # repos/<repo>/pulls a moment ago has that evidence already.
    verdict=gone
  else
    verdict=unclear
  fi
  echo "${verdict:-unclear}"
}

# --- The five minute run -----------------------------------------------------
run() {
  local page pr n sha seen i=0 open=" " wanted=() elsewhere=0 outside=0 have item fault
  local pages count ours_file probe err verdict
  # A run that stops here or at the network still writes the list. Its time
  # is what the dashboard shows and what tehasbot health goes by, and a list
  # that stopped changing would look like a timer that stopped. Without
  # Docker the free space is not measured: the list has no figure and says
  # low, as for any space that cannot be read, so that it does not read as a
  # host where all is well.
  if ! docker info --format '{{.DockerRootDir}}' >/dev/null 2>&1; then
    echo "Docker does not answer; nothing was built or removed"
    free=""
    low=true
    write_list
    return 0
  fi
  measure
  # A preview runs the pull request's own code. Nothing is built unless the
  # network keeps it from the host: see edge_net_fault for what that takes. An
  # old Docker is not asked to make the network: it does not know the option
  # that keeps the host out, and what it makes of it was not tried.
  if fault=$(edge_docker_fault); then
    docker network inspect "$net" >/dev/null 2>&1 || edge_net_create "$net"
    fault=$(edge_net_fault "$net")
  fi
  if [ -n "$fault" ]; then
    echo "the network $net does not keep the host out ($fault); nothing was built"
    write_list
    return 0
  fi

  # All the open pull requests, in pages of 100, newest first. Only the newest
  # page was asked for at first, which is a limit with teeth: a hundred newer
  # pull requests from forks or from outsiders push every one of ours off that
  # page, and the run then finds none of them open and removes every preview
  # that serves until they close. The pages are read until one is short, which
  # is where GitHub ends. Past pull_pages of them the list was not read, and a
  # run does not build or remove on a list it did not read. Each page is an
  # answer of its own, taken at its own moment: what is done with the merged
  # list below takes that into account.
  if ! scratch ours; then
    echo "no scratch file for the list of open pull requests; nothing was built or removed"
    write_list
    return 0
  fi
  ours_file=$scratch_file
  : >"$ours_file" || { write_list; return 0; }
  # Ours: a number, a commit id, a head in this repository and no other, and
  # opened by people of the repository: an owner, member or collaborator, as
  # for the Protolab's attachments. The head alone is not enough. On a public
  # repository anyone can open a pull request between two branches that are
  # already there, and a handful of those would take every preview.
  # shellcheck disable=SC2016  # a jq program: the variables are jq's
  local parts='
    def ours: IN("OWNER", "MEMBER", "COLLABORATOR");
    def numbered: (.number | type) == "number" and (.number | tostring | test("^[1-9][0-9]{0,8}$"));
    def committed: (.head.sha // "") | test("^[0-9a-f]{40}$");
    def here: ((.head.repo.full_name // "") | ascii_downcase) == ($repo | ascii_downcase);
    def by_us: .author_association | ours;'
  pages=0
  while :; do
    page=$(gh api "repos/$repo/pulls?state=open&sort=created&direction=desc&per_page=$pull_page_size&page=$((pages + 1))" 2>/dev/null) ||
      { write_list; return 0; }
    # An empty answer with exit 0 is no answer: jq would run its program on no
    # input and say nothing, and every preview would look closed.
    jq -e 'type == "array"' <<<"$page" >/dev/null 2>&1 || { write_list; return 0; }
    count=$(jq 'length' <<<"$page") || { write_list; return 0; }
    # A page that does not say who opened one of ours is not a clear answer.
    # Reading it as "an outsider's" would remove a preview that serves, where
    # the sweep keeps on the same answer.
    if ! jq -e --arg repo "$repo" "$parts"'
        all(.[]; (numbered and committed and here | not) or (.author_association | type) == "string")' \
        <<<"$page" >/dev/null 2>&1; then
      echo "the list of open pull requests does not say who opened each; nothing was built or removed"
      write_list
      return 0
    fi
    jq -c --arg repo "$repo" "$parts"'
      if type != "array" then error("not a list") else . end
      | map(select(numbered and committed and here and by_us)
            | {number, sha: .head.sha, title: ((.title // "") | .[0:180]), url: (.html_url // null),
               seen: (.updated_at | if type == "string" then . else "" end)})
      | .[]' <<<"$page" >>"$ours_file" 2>/dev/null || { write_list; return 0; }
    # Those whose head is elsewhere, and those that would have been built but
    # for who opened them.
    elsewhere=$((elsewhere + $(jq --arg repo "$repo" '
      [.[] | select(((.head.repo.full_name // "") | ascii_downcase) != ($repo | ascii_downcase))] | length' \
      <<<"$page" 2>/dev/null || echo 0)))
    outside=$((outside + $(jq --arg repo "$repo" "$parts"'
      [.[] | select(numbered and committed and here and (by_us | not))] | length' \
      <<<"$page" 2>/dev/null || echo 0)))
    pages=$((pages + 1))
    [ "$count" -lt "$pull_page_size" ] && break
    if [ "$pages" -ge "$pull_pages" ]; then
      # The last page this run may ask for came back full, so the list may end
      # there or go past it. One more answer tells them apart: an empty one
      # means every open pull request was read, and a thousand of them is a
      # list that was read.
      probe=$(gh api "repos/$repo/pulls?state=open&sort=created&direction=desc&per_page=$pull_page_size&page=$((pages + 1))" 2>/dev/null) ||
        { write_list; return 0; }
      jq -e 'type == "array"' <<<"$probe" >/dev/null 2>&1 || { write_list; return 0; }
      count=$(jq 'length' <<<"$probe") || { write_list; return 0; }
      if [ "$count" != 0 ]; then
        echo "the open pull requests are more than $((pull_pages * pull_page_size)): the list was not read, nothing was built or removed"
        write_list
        return 0
      fi
      break
    fi
  done
  if [ "$elsewhere" = 1 ]; then
    echo "1 pull request from elsewhere, not built"
  elif [ "$elsewhere" != 0 ]; then
    echo "$elsewhere pull requests from elsewhere, not built"
  fi
  if [ "$outside" = 1 ]; then
    echo "1 pull request opened by someone outside the repository, not built"
  elif [ "$outside" != 0 ]; then
    echo "$outside pull requests opened by someone outside the repository, not built"
  fi

  while IFS= read -r pr; do
    [ -n "$pr" ] || continue
    n=$(jq -r .number <<<"$pr")
    # The pages are asked for one at a time, and the list moves between them:
    # a pull request opened while they are read comes back on two of them. It
    # counts once, so that it does not take a preview from another.
    case "$open" in *" $n "*) continue ;; esac
    sha=$(jq -r .sha <<<"$pr")
    seen=$(jq -r '.seen // ""' <<<"$pr")
    open="$open$n "
    mkdir -p "$root/$n" || return 1
    edge_put "$root/$n/pull.json" jq -c '{title, url}' <<<"$pr" || return 1
    retitle "$n"
    i=$((i + 1))
    if [ "$i" -gt "$TEHAS_PREVIEW_MAX" ]; then
      # Stopped when it falls over the limit, not at every run after that:
      # the state says so for this commit and Docker lists no container of
      # the name. A stop that failed leaves one listed, and is tried again.
      if [ "$(field "$n" sha)" != "$sha" ] || [ "$(field "$n" state)" != over-limit ] ||
        [ -n "$(docker ps -a --quiet --filter "name=^$(tehas_name preview "$n")\$" 2>/dev/null)" ]; then
        stop "$n"
      fi
      mark "$n" "$sha" over-limit "More than $TEHAS_PREVIEW_MAX pull requests are open."
      tell "$n" "$seen"
      continue
    fi
    wanted+=("$n $sha")
  done <"$ours_file"

  # What is on the host and no longer open: by directory and by container.
  # Only a container whose label names this repository gives a number, in any
  # capitals, as in the sweep: another's is not this run's to speak of.
  have=$({
    edge_numbers "$root"
    docker ps -a --filter label=tehas.preview \
      --format '{{.ID}} {{.Label "tehas.preview"}} {{.Label "tehas.repo"}}' 2>/dev/null |
      awk -v repo="$repo" 'tolower($3) == tolower(repo) {print $2}'
  } | grep -E "$number" | sort -un)
  # Membership in that list is not enough to remove something. The pages are
  # asked for one at a time: when the list moves while they are read a pull
  # request can fall between two of them and be in neither, and one that is
  # open would then look closed. So the run asks about each number it means to
  # remove, as the sweep does, and keeps what GitHub says is open of ours.
  if scratch remove; then err=$scratch_file; else err=/dev/null; fi
  while IFS= read -r n; do
    [ -n "$n" ] || continue
    case "$open" in *" $n "*) continue ;; esac
    verdict=$(pull_verdict "$n" "$err")
    case "$verdict" in
      closed | gone)
        purge "$n"
        echo "#$n: pull request no longer open, removed"
        ;;
      elsewhere)
        purge "$n"
        echo "#$n: its branch is not in $repo, removed"
        ;;
      outside)
        purge "$n"
        echo "#$n: it was not opened by someone of $repo, removed"
        ;;
      keep) echo "#$n: open though the list did not say so, kept" ;;
      *) echo "#$n: no answer from GitHub, kept" ;;
    esac
  done <<<"$have"

  for item in "${wanted[@]+"${wanted[@]}"}"; do
    n=${item%% *}
    sha=${item#* }
    if serving "$n" "$sha"; then
      mark "$n" "$sha" serving
    elif [ "$(field "$n" sha)" = "$sha" ] && case "$(field "$n" state)" in build-failed | no-recipe) [ ! -e "$root/$n/.retry" ] ;; *) false ;; esac; then
      : # that commit was tried; a new one is tried again
    elif [ "$low" = true ]; then
      no_space "$n" "$sha"
    else
      build "$n" "$sha"
    fi
    tell "$n" "$seen"
  done
  write_list
}

# no_space <number> <commit>: nothing is built, and the reason has the figures.
no_space() {
  if [ -n "$free" ]; then
    mark "$1" "$2" no-space "The host is low on disk: $(gb "$free") is free and $(gb "$min_kb") is needed."
  else
    mark "$1" "$2" no-space "The free space of the host could not be read."
  fi
}

# --- The three hour check ----------------------------------------------------
# The five minute run removes what GitHub's list of open pull requests no
# longer has. This does not trust that list or that run. It starts from what
# is on the host, asks GitHub about each pull request by itself, and removes
# what is merged, closed, not there, not ours or not opened by one of ours.
# An answer that is not clear keeps everything: a sweep never removes on a
# failed call.
sweep() {
  local removed=0 numbers n id tag owner name err verdict info listing stuck
  local fmt='{{.ID}} {{.Label "tehas.preview"}} {{.Label "tehas.repo"}} {{.Names}}'
  if ! docker info --format '{{.DockerRootDir}}' >/dev/null 2>&1; then
    echo "Docker does not answer; nothing was swept"
    return 0
  fi

  # Containers that carry the label and are no pull request of this repository.
  # GitHub takes a repository's name in any capitals, and so does every
  # comparison here: the label was written from TEHAS_REPO as it was spelled
  # that day, and a setting spelled otherwise since must not make every
  # preview another repository's.
  while read -r id n owner name; do
    [ -n "$id" ] || continue
    if [[ $n =~ $number ]] && [ "${owner,,}" = "${repo,,}" ]; then continue; fi
    is_id "$id" || { echo "an id that is not one, skipped"; continue; }
    if docker rm -f -v "$id" >/dev/null 2>&1; then
      echo "container $id: swept, it belongs to no pull request of $repo"
      removed=$((removed + 1))
    fi
  done < <(docker ps -a --filter label=tehas.preview --format "$fmt" 2>/dev/null)

  # Images: one that is not tagged for a number is what a rebuild left, and
  # one of another repository is not ours. Docker refuses to remove an image a
  # container runs, which is the wanted answer.
  while read -r id tag; do
    [ -n "$id" ] || continue
    owner=$(docker image inspect --format '{{index .Config.Labels "tehas.repo"}}' "$id" 2>/dev/null)
    if [[ $tag =~ ^tehas-preview:[1-9][0-9]{0,8}$ ]] && { [ -z "$owner" ] || [ "${owner,,}" = "${repo,,}" ]; }; then continue; fi
    if docker image rm "$id" >/dev/null 2>&1; then
      echo "image $id: swept, it belongs to no preview"
      removed=$((removed + 1))
    fi
  done < <(docker image ls --filter label=tehas.preview --format '{{.ID}} {{.Repository}}:{{.Tag}}' 2>/dev/null)

  numbers=$({
    edge_numbers "$root"
    docker ps -a --filter label=tehas.preview --format "$fmt" 2>/dev/null |
      awk -v repo="$repo" 'tolower($3) == tolower(repo) {print $2}'
    docker image ls --filter label=tehas.preview --format '{{.ID}} {{.Repository}}:{{.Tag}}' 2>/dev/null |
      sed -n 's/^[^ ]* tehas-preview:\([0-9]*\)$/\1/p'
    [ ! -d "$bare" ] || git -C "$bare" for-each-ref --format='%(refname)' refs/preview 2>/dev/null | sed 's|.*/||'
  } | grep -E "$number" | sort -un)

  # A 404 means "no such pull request" only when GitHub shows the repository
  # at all: a token that lost access gets a 404 for every pull request, and
  # that must not remove every preview.
  # shellcheck disable=SC2016  # a jq program: $repo is jq's variable
  if ! info=$(gh api "repos/$repo" 2>/dev/null) ||
    ! jq -e --arg repo "$repo" '(.full_name | type) == "string" and (.full_name | ascii_downcase) == ($repo | ascii_downcase)' \
      <<<"$info" >/dev/null 2>&1; then
    echo "GitHub does not show $repo; nothing was swept by its word"
    numbers=""
  fi

  if scratch sweep; then err=$scratch_file; else err=/dev/null; fi
  while IFS= read -r n; do
    [ -n "$n" ] || continue
    verdict=$(pull_verdict "$n" "$err")
    # Containers of the number are listed again here: a purge removes the
    # name tehas-preview-<n> only, and a labelled container of any other name
    # would stay for ever and be swept again at every check.
    listing=$(docker ps -a --filter label=tehas.preview --format "$fmt" 2>/dev/null |
      awk -v n="$n" -v repo="$repo" '$2 == n && tolower($3) == tolower(repo) {print $1, $4}')
    case "$verdict" in
      keep)
        # A second container is one that has a name and none of its names is
        # the preview's. Docker gives several names with commas between them
        # when a legacy link points at a container, and a line with no name
        # says nothing: neither may take the serving container away.
        while read -r id name; do
          [ -n "$id" ] || continue
          case ",$name," in ",," | *",tehas-preview-$n,"*) continue ;; esac
          is_id "$id" || { echo "an id that is not one, skipped"; continue; }
          if docker rm -f -v "$id" >/dev/null 2>&1; then
            echo "container $id: swept, a second container of #$n"
            removed=$((removed + 1))
          fi
        done <<<"$listing"
        ;;
      closed | gone | elsewhere | outside)
        stuck=false
        while read -r id name; do
          [ -n "$id" ] || continue
          is_id "$id" || { echo "an id that is not one, skipped"; stuck=true; continue; }
          docker rm -f -v "$id" >/dev/null 2>&1 || stuck=true
        done <<<"$listing"
        # Swept is said and counted when it is true. With a container still
        # there the rest stays too, so the next sweep finds the number again.
        if [ "$stuck" = true ]; then
          echo "#$n: a container could not be removed, tried again at the next sweep"
          continue
        fi
        purge "$n"
        removed=$((removed + 1))
        case "$verdict" in
          closed) echo "#$n: swept, the pull request is closed" ;;
          gone) echo "#$n: swept, there is no such pull request" ;;
          outside) echo "#$n: swept, it was not opened by someone of $repo" ;;
          *) echo "#$n: swept, its branch is not in $repo" ;;
        esac
        ;;
      *) echo "#$n: no answer from GitHub, kept" ;;
    esac
  done <<<"$numbers"
  [ "$err" = /dev/null ] || rm -f "$err"

  # shellcheck disable=SC2016  # a jq program: the variables are jq's
  edge_put "$root/sweep.json" jq -n --arg now "$(date -u +%FT%TZ)" --argjson removed "$removed" \
    '{time: $now, removed: $removed}' || return 1
  measure
  write_list
}

case "$mode" in
  run) run || exit 1 ;;
  sweep) sweep || exit 1 ;;
esac
exit 0
