#!/usr/bin/env bash
# Keep a running preview of every open pull request. This loads the settings;
# the console does the rest (console/src/preview.rs says what and why).
#
# Usage: tehasbot preview            bring the previews in step with the pull requests
#        tehasbot preview --sweep    the three hour check of what is left on the host
#
# Exit: 0 done, or GitHub or Docker did not answer and what runs was left
#       running; 1 it cannot write under $TEHAS_HOME; 64 a wrong argument;
#       78 the instance settings are invalid, TEHAS_PREVIEWS is not 1, or the
#       console is not installed beside this command.
set -uo pipefail
umask 022

here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source=lib/config.sh
. "$here/../lib/config.sh"

mode=run
case "${1:-}" in
  "") ;;
  --sweep) mode=sweep ;;
  *)
    echo "usage: tehasbot preview [--sweep]" >&2
    exit 64
    ;;
esac

# Taken before the settings are loaded: loading drops every TEHAS_ variable
# the environment has.
settle_asked=${TEHAS_PREVIEW_SETTLE:-}
tehas_load || exit 78
tehas_require TEHAS_REPO
if [ "$TEHAS_PREVIEWS" != 1 ]; then
  tehas_err "TEHAS_PREVIEWS is not 1: this instance has no previews"
  exit 78
fi
console=$here/console
[ -x "$console" ] || { tehas_err "no console beside this command ($console), run install.sh"; exit 78; }

TEHAS_PREVIEW_SETTLE=$settle_asked exec "$console" preview "$mode"
