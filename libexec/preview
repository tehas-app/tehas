#!/usr/bin/env bash
# Keep a running preview of every open pull request: a container that serves
# the product as that pull request has it, reached through the edge router as
# uat-<number>.<TEHAS_DOMAIN> (edge/router.Caddyfile).
#
#   which ones      Open pull requests whose head branch is in the product
#                   repository itself. Pushing there needs write access. A
#                   pull request from a fork is never built.
#   what it is      The image that preview/Dockerfile of that commit builds,
#                   answering HTTP on port 8080. A commit without that file
#                   has no preview.
#   what it gets    Nothing of the host: no mount, no variable, no port, no
#                   token, a read-only root, and a network that has the
#                   router and the other previews on it and nothing else:
#                   not the internet and not the host. The build gets the
#                   commit as an archive on standard input and nothing else.
#   how many        The newest TEHAS_PREVIEW_MAX. The rest say "over-limit".
#   when it goes    At the next run after the pull request is merged or
#                   closed: the container, the image, the fetched ref and
#                   the state.
#   what it says    One comment on the pull request, by the bot, edited in
#                   place: the address, or "Unable to create a preview" with
#                   the reason, for a failed build and for a full disk.
#   a full disk     Under TEHAS_PREVIEW_MIN_FREE of free space nothing is
#                   built. What serves stays, and removal still runs. The
#                   figures are in previews.json at every run, and tehasbot
#                   health reads them.
#
# Each pull request has a state in $TEHAS_HOME/preview/<number>/state.json:
# serving, building, no-recipe, build-failed, no-space or over-limit. Serving
# is a container that was still running a few seconds after its start. The list
# for the dashboard is $TEHAS_HOME/live/previews.json. A build's output is in
# $TEHAS_HOME/logs/preview-<number>.log. Deterministic, no model.
#
# Usage: tehasbot preview            bring the previews in step with the pull requests
#        tehasbot preview --sweep    the three hour check of what is left on the host
#
# The sweep is the second check that nothing of a merged or closed pull
# request stays on the host. It works from the containers, images, fetched
# refs and directories it finds, not from GitHub's list, and asks about each
# pull request by itself. It waits for a run to end and a run does not start
# while it works. A line "swept" in the log is something the five minute run
# missed.
#
# Exit: 0 done, or GitHub or Docker did not answer and what runs was left
#       running; 1 it cannot write under $TEHAS_HOME; 64 a wrong argument;
#       78 the instance settings are invalid or TEHAS_PREVIEWS is not 1.
set -uo pipefail
umask 022

here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source=lib/config.sh
. "$here/../lib/config.sh"
# shellcheck source=lib/edge.sh
. "$here/../lib/edge.sh"

mode=run
case "${1:-}" in
  "") ;;
  --sweep) mode=sweep ;;
  *)
    echo "usage: tehasbot preview [--sweep]" >&2
    exit 64
    ;;
esac

# Taken before the settings are loaded: loading drops every TEHAS_ variable
# the environment has. See "settle" below.
settle_asked=${TEHAS_PREVIEW_SETTLE:-}
tehas_load || exit 78
tehas_require TEHAS_REPO
if [ "$TEHAS_PREVIEWS" != 1 ]; then
  tehas_err "TEHAS_PREVIEWS is not 1: this instance has no previews"
  exit 78
fi

repo=$TEHAS_REPO
root=$TEHAS_HOME/preview
bare=$root/repo.git
live=$TEHAS_HOME/live
logs=$TEHAS_HOME/logs
net=tehas-previews
# The option that leaves the host without an address on the network. Docker
# 27.1 or later, and only on an internal network.
gateway=com.docker.network.bridge.gateway_mode_ipv4
recipe=preview/Dockerfile
build_limit=900
# The seconds between a container's start and the question whether it still
# runs. Not an instance setting: it is read from the environment only so the
# tests do not wait.
settle=5
case "$settle_asked" in "" | *[!0-9]*) ;; *) settle=$settle_asked ;; esac
marker='<!-- tehas-preview -->'
min_kb=$((TEHAS_PREVIEW_MIN_FREE_MB * 1024))
free=""
low=false
me=""

mkdir -p "$root" "$live" "$logs" "$TEHAS_HOME/tmp" || exit 1
# The sweep waits for a run to end; a run does not wait for anything.
if [ "$mode" = sweep ]; then
  edge_lock preview 1800 || { echo "the lock was not free in 30 minutes, nothing was swept"; exit 0; }
else
  edge_lock preview || { echo "another tehasbot preview is running"; exit 0; }
fi

# --- The state of one pull request -------------------------------------------
field() { jq -r --arg k "$2" '.[$k] // ""' "$root/$1/state.json" 2>/dev/null; }
# mark <number> <commit> <state> [reason]: written only when it differs, so
# "time" is when the state began.
mark() {
  local n=$1 sha=$2 state=$3 reason=${4:-} pull=$root/$1/pull.json
  if [ "$(field "$n" sha)" = "$sha" ] && [ "$(field "$n" state)" = "$state" ]; then return 0; fi
  mkdir -p "$root/$n" || return 1
  [ -f "$pull" ] || echo '{}' >"$pull"
  # shellcheck disable=SC2016  # a jq program: the variables are jq's
  edge_put "$root/$n/state.json" jq -n --argjson n "$n" --arg sha "$sha" --arg state "$state" \
    --arg reason "$reason" --arg now "$(date -u +%FT%TZ)" --slurpfile pull "$pull" '
    {number: $n, sha: $sha, state: $state, reason: $reason, time: $now,
     title: ($pull[0].title // ""), url: ($pull[0].url // null)}' || return 1
  echo "#$n: $state${reason:+ ($reason)}"
}

# --- Docker ------------------------------------------------------------------
serving() { # <number> <commit>: is a container of that commit running?
  [ -n "$(docker ps --quiet --filter "name=^tehas-preview-$1\$" --filter "label=tehas.sha=$2" 2>/dev/null)" ]
}
stop() { # <number>: the container and the image
  docker rm -f "tehas-preview-$1" >/dev/null 2>&1
  docker image rm -f "tehas-preview:$1" >/dev/null 2>&1
  return 0
}
purge() { # <number>: everything of one pull request
  stop "$1"
  git -C "$bare" update-ref -d "refs/preview/$1" 2>/dev/null
  rm -rf "${root:?}/$1" "$logs/preview-$1.log"
}

# --- Free space --------------------------------------------------------------
# free_kb: the free kilobytes of the host, the smaller of the file system of
# $TEHAS_HOME and the one Docker keeps its images on. Fails when the first
# cannot be read: no figure is not the same as plenty.
free_kb() {
  local a b dir
  a=$(df -Pk "$TEHAS_HOME" 2>/dev/null | awk 'NR == 2 {print $4}')
  [[ $a =~ ^[0-9]+$ ]] || return 1
  dir=$(docker info --format '{{.DockerRootDir}}' 2>/dev/null)
  b=$(df -Pk "${dir:-/var/lib/docker}" 2>/dev/null | awk 'NR == 2 {print $4}')
  [[ $b =~ ^[0-9]+$ ]] || b=$a
  echo $((a < b ? a : b))
}
gb() { awk -v kb="$1" 'BEGIN { printf "%.1f GB", kb / 1048576 }'; }

# --- The comment on the pull request -----------------------------------------
# comment <number>: say where the preview is, or that it could not be created
# and why. One comment per pull request, the bot's own, found by its first
# line and edited in place. Said once per commit and state, so a full disk is
# not a comment every five minutes. A call that fails is tried at the next run.
comment() {
  local n=$1 sha state reason key text body id
  sha=$(field "$n" sha)
  state=$(field "$n" state)
  reason=$(field "$n" reason)
  key="$sha $state"
  [ "$(cat "$root/$n/.commented" 2>/dev/null)" != "$key" ] || return 0
  case "$state" in
    serving) text="Preview of \`${sha:0:7}\`: https://$(tehas_edge_name uat "$n")/" ;;
    build-failed | no-space) text="Unable to create a preview of \`${sha:0:7}\`. $reason" ;;
    *) return 0 ;;
  esac
  body="$marker
$text

It is rebuilt when the branch changes and removed when this pull request is closed."
  # Only a comment of this account: anyone can write the marker.
  [ -n "$me" ] || me=$(gh api user 2>/dev/null | jq -r '.login // empty' 2>/dev/null) || me=""
  [ -n "$me" ] || return 0
  # shellcheck disable=SC2016  # a jq program: the variables are jq's
  id=$(gh api "repos/$repo/issues/$n/comments?per_page=100" 2>/dev/null |
    jq -r --arg me "$me" --arg marker "$marker" '
      [.[] | select(.user.login == $me and ((.body // "") | startswith($marker)))][0].id // empty' 2>/dev/null) ||
    return 0
  if [ -n "$id" ]; then
    gh api -X PATCH "repos/$repo/issues/comments/$id" -f body="$body" >/dev/null 2>&1 || return 0
  else
    gh api -X POST "repos/$repo/issues/$n/comments" -f body="$body" >/dev/null 2>&1 || return 0
  fi
  printf '%s\n' "$key" >"$root/$n/.commented"
}

# --- One build ---------------------------------------------------------------
# start_failed <number> <commit> <failed starts so far> <reason>: the image was
# built and no container of it stayed up. The host may have hiccuped, not the
# commit: the next runs try again. Three tries ride out a hiccup, and a recipe
# that cannot start does not loop.
start_failed() {
  [ "$3" -ge 3 ] || echo "$2 $(($3 + 1))" >"$root/$1/.retry"
  mark "$1" "$2" build-failed "$4"
}

# build <number>: fetch the pull request's head, build its recipe, replace the
# container. The commit is the one fetched, which is the one built.
build() {
  local n=$1 sha log=$logs/preview-$1.log old retry=$root/$1/.retry tries=0 mark_sha mark_n
  if [ ! -d "$bare" ]; then
    git init -q --bare "$bare" || return 1
    # The product checkout knows the address and how to sign in to it.
    git -C "$bare" remote add origin \
      "$(git -C "${TEHAS_WORK_REPO:-/nonexistent}" config --get remote.origin.url 2>/dev/null ||
        echo "https://github.com/$repo.git")" || return 1
  fi
  : >"$log"
  # 9>&- on every command that can outlive the run: a descriptor 9 they inherit
  # would hold the lock after the run has ended (a detached gc, a daemon).
  if ! git -C "$bare" fetch --quiet --no-tags origin "+refs/pull/$n/head:refs/preview/$n" >>"$log" 2>&1 9>&-; then
    # No state: a fetch that failed says nothing about the commit.
    echo "#$n: the commit could not be fetched, tried again at the next run"
    return 1
  fi
  sha=$(git -C "$bare" rev-parse --verify --quiet "refs/preview/$n^{commit}") || return 1
  # The retry marker is "<commit> <failed starts so far>". It is read here and
  # cleared whatever this build turns out to be, so no path keeps a stale one.
  if read -r mark_sha mark_n <"$retry" 2>/dev/null && [ "$mark_sha" = "$sha" ]; then
    case "$mark_n" in [0-9]) tries=$mark_n ;; esac
  fi
  rm -f "$retry"
  if ! git -C "$bare" cat-file -e "$sha:$recipe" 2>/dev/null; then
    stop "$n"
    mark "$n" "$sha" no-recipe "The commit has no $recipe."
    return 0
  fi
  mark "$n" "$sha" building
  old=$(docker image inspect --format '{{.Id}}' "tehas-preview:$n" 2>/dev/null) || old=""
  if ! git -C "$bare" archive "$sha" 9>&- | timeout "$build_limit" docker build --quiet \
    -f "$recipe" -t "tehas-preview:$n" \
    --label "tehas.preview=$n" --label "tehas.sha=$sha" --label "tehas.repo=$repo" - >>"$log" 2>&1 9>&-; then
    mark "$n" "$sha" build-failed "The build failed or ran over $((build_limit / 60)) minutes. Its output is in logs/preview-$n.log on the host."
    return 1
  fi
  # The same name cannot run twice, so the old container goes first. It is a
  # few seconds of the router's 404.
  docker rm -f "tehas-preview-$n" >/dev/null 2>&1
  if ! docker run --detach --name "tehas-preview-$n" --network "$net" \
    --read-only --tmpfs /tmp --tmpfs /config --tmpfs /data \
    --cap-drop ALL --cap-add NET_BIND_SERVICE --security-opt no-new-privileges:true \
    --memory 256m --cpus 1 --pids-limit 128 --restart unless-stopped \
    --label "tehas.preview=$n" --label "tehas.sha=$sha" --label "tehas.repo=$repo" \
    "tehas-preview:$n" >>"$log" 2>&1 9>&-; then
    start_failed "$n" "$sha" "$tries" "The container did not start. See logs/preview-$n.log on the host."
    return 1
  fi
  # docker run answers once the process is started. One that stops at once,
  # because it writes outside its three directories or misses a variable, would
  # be called serving and be started again for ever. So it is asked a moment
  # later: still running, and never restarted.
  sleep "$settle"
  if [ "$(docker inspect --format '{{.State.Running}} {{.RestartCount}}' "tehas-preview-$n" 2>/dev/null 9>&-)" != "true 0" ]; then
    {
      echo "docker logs of tehas-preview-$n, which started and stopped:"
      docker logs --tail 40 "tehas-preview-$n" 9>&-
    } >>"$log" 2>&1
    docker rm -f "tehas-preview-$n" >/dev/null 2>&1 9>&-
    start_failed "$n" "$sha" "$tries" "The container started and stopped. See \"docker logs\" in logs/preview-$n.log on the host."
    return 1
  fi
  if [ -n "$old" ] && [ "$old" != "$(docker image inspect --format '{{.Id}}' "tehas-preview:$n" 2>/dev/null)" ]; then
    docker image rm "$old" >/dev/null 2>&1
  fi
  mark "$n" "$sha" serving
}

# --- The list for the dashboard ----------------------------------------------
write_list() {
  local files=() f sweep=$root/sweep.json
  for f in "$root"/*/state.json; do
    [ -f "$f" ] && files+=("$f")
  done
  [ -f "$sweep" ] || sweep=/dev/null
  # shellcheck disable=SC2016  # a jq program: the variables are jq's
  edge_put "$live/previews.json" jq -s --arg now "$(date -u +%FT%TZ)" --arg domain "$TEHAS_DOMAIN" \
    --arg free "$free" --argjson min "$min_kb" --argjson low "$low" --slurpfile sweep "$sweep" '
    {generatedAt: $now,
     disk: {freeBytes: (if $free == "" then null else ($free | tonumber) * 1024 end),
            minFreeBytes: ($min * 1024), low: $low},
     lastSweep: ($sweep[0] // null),
     previews: (sort_by(-.number) | map(. + {address:
       (if .state == "serving" then "https://uat-\(.number).\($domain)/" else null end)}))}' \
    "${files[@]}" </dev/null
}

# --- The five minute run -----------------------------------------------------
run() {
  local pulls ours pr n sha i=0 open=" " wanted=() elsewhere have item
  if ! docker info --format '{{.DockerRootDir}}' >/dev/null 2>&1; then
    echo "Docker does not answer; nothing was built or removed"
    return 0
  fi
  docker network inspect "$net" >/dev/null 2>&1 ||
    docker network create --internal -o "$gateway=isolated" "$net" >/dev/null 2>&1
  # A network that is not internal would give a preview the internet and the
  # model host. One that is internal and no more still gives it the host: every
  # service the host listens on at all addresses answers at the bridge's
  # gateway address. Nothing is built on either.
  if [ "$(docker network inspect --format "{{.Internal}} {{index .Options \"$gateway\"}}" "$net" 2>/dev/null)" != "true isolated" ]; then
    echo "the network $net is not internal and isolated from the host; nothing was built"
    return 0
  fi

  if free=$(free_kb); then
    [ "$free" -ge "$min_kb" ] || low=true
  else
    free=""
    low=true
  fi

  pulls=$(gh api "repos/$repo/pulls?state=open&sort=created&direction=desc&per_page=100" 2>/dev/null) ||
    { write_list; return 0; }
  # An empty answer with exit 0 is no answer: jq would run its program on no
  # input and say nothing, and every preview would look closed.
  jq -e 'type == "array"' <<<"$pulls" >/dev/null 2>&1 || { write_list; return 0; }
  # Ours: a number, a commit id, and a head in this repository and no other.
  ours=$(jq -c --arg repo "$repo" '
    if type != "array" then error("not a list") else . end
    | map(select((.number | type) == "number"
                 and (.number | tostring | test("^[1-9][0-9]{0,8}$"))
                 and ((.head.sha // "") | test("^[0-9a-f]{40}$"))
                 and ((.head.repo.full_name // "") | ascii_downcase) == ($repo | ascii_downcase))
          | {number, sha: .head.sha, title: ((.title // "") | .[0:180]), url: (.html_url // null)})
    | .[]' <<<"$pulls" 2>/dev/null) || { write_list; return 0; }
  elsewhere=$(jq --arg repo "$repo" '
    [.[] | select(((.head.repo.full_name // "") | ascii_downcase) != ($repo | ascii_downcase))] | length' \
    <<<"$pulls" 2>/dev/null) || elsewhere=0
  if [ "$elsewhere" = 1 ]; then
    echo "1 pull request from elsewhere, not built"
  elif [ "$elsewhere" != 0 ]; then
    echo "$elsewhere pull requests from elsewhere, not built"
  fi

  while IFS= read -r pr; do
    [ -n "$pr" ] || continue
    n=$(jq -r .number <<<"$pr")
    sha=$(jq -r .sha <<<"$pr")
    open="$open$n "
    mkdir -p "$root/$n" || return 1
    edge_put "$root/$n/pull.json" jq -c '{title, url}' <<<"$pr" || return 1
    i=$((i + 1))
    if [ "$i" -gt "$TEHAS_PREVIEW_MAX" ]; then
      stop "$n"
      mark "$n" "$sha" over-limit "More than $TEHAS_PREVIEW_MAX pull requests are open."
      continue
    fi
    wanted+=("$n $sha")
  done <<<"$ours"

  # What is on the host and no longer open: by directory and by container.
  have=$({
    edge_numbers "$root"
    docker ps -a --filter label=tehas.preview \
      --format '{{.ID}} {{.Label "tehas.preview"}} {{.Label "tehas.repo"}}' 2>/dev/null | awk '{print $2}'
  } | grep -E '^[1-9][0-9]*$' | sort -un)
  while IFS= read -r n; do
    [ -n "$n" ] || continue
    case "$open" in *" $n "*) continue ;; esac
    purge "$n"
    echo "#$n: pull request no longer open, removed"
  done <<<"$have"

  for item in "${wanted[@]+"${wanted[@]}"}"; do
    n=${item%% *}
    sha=${item#* }
    if serving "$n" "$sha"; then
      mark "$n" "$sha" serving
    elif [ "$(field "$n" sha)" = "$sha" ] && case "$(field "$n" state)" in build-failed | no-recipe) [ ! -e "$root/$n/.retry" ] ;; *) false ;; esac; then
      : # that commit was tried; a new one is tried again
    elif [ "$low" = true ]; then
      no_space "$n" "$sha"
    else
      build "$n" "$sha"
    fi
    comment "$n"
  done
  write_list
}

# no_space <number> <commit>: nothing is built, and the reason has the figures.
no_space() {
  if [ -n "$free" ]; then
    mark "$1" "$2" no-space "The host is low on disk: $(gb "$free") is free and $(gb "$min_kb") is needed."
  else
    mark "$1" "$2" no-space "The free space of the host could not be read."
  fi
}

# --- The three hour check ----------------------------------------------------
# The five minute run removes what GitHub's list of open pull requests no
# longer has. This does not trust that list or that run. It starts from what
# is on the host, asks GitHub about each pull request by itself, and removes
# what is merged, closed, not there or not ours. An answer that is not clear
# keeps everything: a sweep never removes on a failed call.
sweep() {
  local removed=0 numbers n id tag owner name answer err verdict info listing
  local fmt='{{.ID}} {{.Label "tehas.preview"}} {{.Label "tehas.repo"}} {{.Names}}'
  if ! docker info --format '{{.DockerRootDir}}' >/dev/null 2>&1; then
    echo "Docker does not answer; nothing was swept"
    return 0
  fi

  # Containers that carry the label and are no pull request of this repository.
  while read -r id n owner name; do
    [ -n "$id" ] || continue
    if [[ $n =~ ^[1-9][0-9]*$ ]] && [ "$owner" = "$repo" ]; then continue; fi
    if docker rm -f "$id" >/dev/null 2>&1; then
      echo "container $id: swept, it belongs to no pull request of $repo"
      removed=$((removed + 1))
    fi
  done < <(docker ps -a --filter label=tehas.preview --format "$fmt" 2>/dev/null)

  # Images: one that is not tagged for a number is what a rebuild left, and
  # one of another repository is not ours. Docker refuses to remove an image a
  # container runs, which is the wanted answer.
  while read -r id tag; do
    [ -n "$id" ] || continue
    owner=$(docker image inspect --format '{{index .Config.Labels "tehas.repo"}}' "$id" 2>/dev/null)
    if [[ $tag =~ ^tehas-preview:[1-9][0-9]*$ ]] && { [ -z "$owner" ] || [ "$owner" = "$repo" ]; }; then continue; fi
    if docker image rm "$id" >/dev/null 2>&1; then
      echo "image $id: swept, it belongs to no preview"
      removed=$((removed + 1))
    fi
  done < <(docker image ls --filter label=tehas.preview --format '{{.ID}} {{.Repository}}:{{.Tag}}' 2>/dev/null)

  numbers=$({
    edge_numbers "$root"
    docker ps -a --filter label=tehas.preview --format "$fmt" 2>/dev/null |
      awk -v repo="$repo" '$3 == repo {print $2}'
    docker image ls --filter label=tehas.preview --format '{{.ID}} {{.Repository}}:{{.Tag}}' 2>/dev/null |
      sed -n 's/^[^ ]* tehas-preview:\([0-9]*\)$/\1/p'
    [ ! -d "$bare" ] || git -C "$bare" for-each-ref --format='%(refname)' refs/preview 2>/dev/null | sed 's|.*/||'
  } | grep -E '^[1-9][0-9]*$' | sort -un)

  # A 404 means "no such pull request" only when GitHub shows the repository
  # at all: a token that lost access gets a 404 for every pull request, and
  # that must not remove every preview.
  # shellcheck disable=SC2016  # a jq program: $repo is jq's variable
  if ! info=$(gh api "repos/$repo" 2>/dev/null) ||
    ! jq -e --arg repo "$repo" '(.full_name | type) == "string" and (.full_name | ascii_downcase) == ($repo | ascii_downcase)' \
      <<<"$info" >/dev/null 2>&1; then
    echo "GitHub does not show $repo; nothing was swept by its word"
    numbers=""
  fi

  err=$(mktemp "$TEHAS_HOME/tmp/preview-sweep.XXXXXX" 2>/dev/null) || err=/dev/null
  while IFS= read -r n; do
    [ -n "$n" ] || continue
    verdict=keep
    if answer=$(gh api "repos/$repo/pulls/$n" 2>"$err"); then
      # Only "closed" is closed. An open pull request is ours with a head in
      # this repository and elsewhere with any other head, a deleted fork
      # (a null repo) included. Anything else, or an answer about another
      # number, is unclear.
      # shellcheck disable=SC2016  # a jq program: $repo and $n are jq's variables
      verdict=$(jq -r --arg repo "$repo" --argjson n "$n" '
        if (.state | type) != "string" or (.number | type) != "number" or .number != $n then "unclear"
        elif .state == "closed" then "closed"
        elif .state != "open" then "unclear"
        elif (.head | type) != "object" then "unclear"
        elif ((.head.repo.full_name // "") | ascii_downcase) == ($repo | ascii_downcase) then "keep"
        elif .head.repo == null or ((.head.repo.full_name | type) == "string") then "elsewhere"
        else "unclear" end' <<<"$answer" 2>/dev/null) || verdict=unclear
    elif grep -q 'HTTP 404' "$err" 2>/dev/null; then
      verdict=gone
    else
      verdict=unclear
    fi
    # Containers of the number are listed again here: a purge removes the
    # name tehas-preview-<n> only, and a labelled container of any other name
    # would stay for ever and be swept again at every check.
    listing=$(docker ps -a --filter label=tehas.preview --format "$fmt" 2>/dev/null |
      awk -v n="$n" -v repo="$repo" '$2 == n && $3 == repo {print $1, $4}')
    case "$verdict" in
      keep)
        while read -r id name; do
          [ -n "$id" ] && [ "$name" != "tehas-preview-$n" ] || continue
          if docker rm -f "$id" >/dev/null 2>&1; then
            echo "container $id: swept, a second container of #$n"
            removed=$((removed + 1))
          fi
        done <<<"$listing"
        ;;
      closed | gone | elsewhere)
        while read -r id name; do
          [ -n "$id" ] || continue
          docker rm -f "$id" >/dev/null 2>&1
        done <<<"$listing"
        purge "$n"
        removed=$((removed + 1))
        case "$verdict" in
          closed) echo "#$n: swept, the pull request is closed" ;;
          gone) echo "#$n: swept, there is no such pull request" ;;
          *) echo "#$n: swept, its branch is not in $repo" ;;
        esac
        ;;
      *) echo "#$n: no answer from GitHub, kept" ;;
    esac
  done <<<"$numbers"
  [ "$err" = /dev/null ] || rm -f "$err"

  # shellcheck disable=SC2016  # a jq program: the variables are jq's
  edge_put "$root/sweep.json" jq -n --arg now "$(date -u +%FT%TZ)" --argjson removed "$removed" \
    '{time: $now, removed: $removed}' || return 1
  if free=$(free_kb); then
    [ "$free" -ge "$min_kb" ] || low=true
  else
    free=""
    low=true
  fi
  write_list
}

case "$mode" in
  run) run || exit 1 ;;
  sweep) sweep || exit 1 ;;
esac
exit 0
