#!/usr/bin/env bash
# tehas drain: start no new work, and wait for the running cycles to end.
#
# The same as `tehas limit set --cycles 0 --plan off --reason draining`: no cycle,
# planning turn or improvement run starts until tehas limit clear, and the limit
# does not expire. Running cycles are not stopped, and with --wait it waits up to
# that many seconds for them to end. Drained means no poll can start a cycle
# either: the poll's lock is taken before the count, so a poll already past its
# read of the limit is waited for and its cycles counted. For a reboot or a disk
# change, or before an upgrade or a move. TEHAS_CONSOLE is passed on to limit.
#
# Usage: tehas drain [--wait SECONDS] [--json], which prints one object: api 1,
# drained, running (the issues whose cycles still run) and limit as tehas limit
# --json prints it. Exit 0 no cycle is running; 1 some still are at the end of the
# wait, or a poll held its lock for the whole of it; 64 a bad argument, which
# writes nothing; 78 the instance settings are missing or malformed.
#
#   limit     0 cycles at once, planning off, until cleared: draining
#   drained: no poll can start a cycle, and none is running
set -uo pipefail

usage() { echo "usage: tehas drain [--wait SECONDS] [--json]" >&2; exit 64; }

wait_for="" json=0
while [ "$#" -gt 0 ]; do
  case "$1" in
    --wait) [ -z "$wait_for" ] && [ "$#" -ge 2 ] || usage; [[ $2 =~ ^(0|[1-9][0-9]{0,6})$ ]] || usage; wait_for=$2; shift ;;
    --json) [ "$json" = 0 ] || usage; json=1 ;;
    *) usage ;;
  esac
  shift
done

here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd) console=${TEHAS_CONSOLE:-}
# shellcheck source=lib/config.sh
. "$here/../lib/config.sh"
tehas_load || exit 78
# shellcheck source=lib/cycles.sh
. "$here/../lib/cycles.sh"

said=$(TEHAS_CONSOLE=$console "$here/with-settings" tehas limit set --cycles 0 --plan off --reason draining) || exit $?
# The limit holds only a poll that has yet to read it: one past that read starts
# its cycles whatever the file says. So the poll's lock is taken and released
# before the count, and its cycles are in it: --wait bounds it, or 600.
exec 8>>"$TEHAS_HOME/state/dispatch.lock"
flock -w "${wait_for:-600}" 8 || exit 1
exec 8>&-
deadline=$(($(date +%s) + ${wait_for:-0}))
while :; do
  running=$(tehas_cycles_running | sort -n | tr '\n' ' ')
  running=${running% }
  [ -n "$running" ] && [ "$(date +%s)" -lt "$deadline" ] || break
  sleep 1
done

if [ "$json" = 1 ]; then
  jq -nc --arg running "$running" --argjson limit "$(TEHAS_CONSOLE=$console "$here/with-settings" tehas limit --json)" '
    ($running | split(" ") | map(select(. != "") | tonumber)) as $r
    | {api: 1, drained: ($r == []), running: $r, limit: ($limit | del(.api))}'
elif [ -z "$running" ]; then
  printf '%s\n%s\n' "$said" "drained: no cycle is running"
else
  printf '%s\n%s\n' "$said" "still running: #${running// /, #}"
fi
[ -z "$running" ]
