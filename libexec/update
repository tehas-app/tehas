#!/usr/bin/env bash
# Bring this host up to date in one step, from a release or from the platform
# checkout.
#
# The three things an update takes - move to the new code, run install.sh, then
# finish each follow-up it asks for - in order, one line per step, stopping at
# the first failure.
#
# Where the new code comes from is TEHAS_UPDATE_FROM in instance.env. Without
# it, a host with ~/tehas/current updates from releases and one with a platform
# checkout from that checkout, so a host installed before the setting existed
# goes on as it did.
#
# From a release (TEHAS_UPDATE_FROM=release): the releases are read from
# TEHAS_RELEASE_REPO (versions.env carries the platform's own; the instance may
# name another), with gh when it is signed in, which reaches a private
# repository with the bot's token, and with curl from the public address
# otherwise. The tarball is checked against its .sha256 and its minisign
# signature with the key install.sh put in ~/tehas/release/minisign.pub, never a
# key from the download, and unpacked into ~/tehas/versions/<version>. The
# instance is checked against that version's own lib/config.sh, with the
# example value of any setting it is missing, and a TEHAS_ key that version
# never names is warned about. Only then is ~/tehas/current pointed at it, and
# install.sh runs from current, so the commands and the units are the copies it
# makes from that version. The sandbox image each version ran with keeps a tag,
# tehas/pi-rukas:release-<version>, so going back to it reuses the image. The
# version current names and the two switched to before it stay on disk, the
# rest are removed with their image tags.
#
# From the checkout (TEHAS_UPDATE_FROM=git), for a host that develops tehas: it
# fast-forwards the platform checkout. It changes nothing when the checkout
# has local changes or cannot be fast-forwarded.
#
# What it does not do: enable or start a systemd unit or a container that is
# not already running. A changed unit is restarted only when it was active, and a
# compose server is recreated only where its container is already up - recreated,
# because what changes is the config file it mounts and it reads that when its
# process starts. An instance with no edge router does not get one from an
# update.
#
# The follow-ups are named by id, never by command text. install.sh prints
# "next: <step line>" for the steps its changed files call for, and records the
# same lines in $TEHAS_HOME/state/update-pending as it copies each file. This
# command runs only the ids lib/update-steps.sh defines, each as its own command
# with the arguments written on that line - and the arguments are part of the
# step: a docs or edge line without the --force-recreate those steps need is
# refused, because the weaker renewal would leave a running container serving the
# config it loaded at its start and still be counted as done. An id that file does
# not define is not run and is said out loud: a step this command cannot perform
# leaves the run red rather than green, and its line stays in the record, so
# install.sh --check keeps reporting it until a command that knows it runs. Steps
# owed in that record are finished too, and each one comes off the record only
# after it has run, so a run that stopped partway - or one whose install.sh knew a
# step this version does not - does not turn into a green "tehas is up to date".
# A record that exists but cannot be read stops the run too: answering "nothing
# is owed" for a file this account cannot open would let the next write replace
# steps somebody else recorded.
#
# pi-rukas is not pinned. Last, where the installed versions.env names a branch
# for it, the sandbox image is moved to that branch's head when the head is not
# the commit the image was built on, also when no file of tehas changed. A run
# that built the image already, or whose steps failed, skips this. --check only
# says whether the head moved. The host's clone of pi-rukas follows only when
# bootstrap.sh user runs, so a run that left the image on a commit the clone is
# not on prints the follow-up: one later: line naming that command, whether or
# not versions.env changed, and with no change to the exit status.
#
# A step line recorded as "protolab <flag>" by an earlier version is the edge
# step: lib/update-steps.sh answers that for every reader of a step line, so no
# command here spells the alias itself.
#
# Whether a service runs is a question put to Docker or to systemd, and only
# their answer means anything - never their exit status on its own. The units step
# asks systemd to reload its unit files before it restarts anything, because a
# copied unit file is not in effect until that has happened, and only silence next
# to exit 0 says it did: a reload that failed, or answered with text, stops the
# step and leaves it owed rather than report a changed unit as applied while
# systemd still holds the old definition. systemd is asked without --quiet so it
# names the state, and only its own state words are read: the active family
# restarts the unit, inactive, failed and unknown (no such unit on this host)
# leave it alone. When the question cannot be asked - no daemon, no compose
# plugin, no user bus, a systemctl wrapper that prints an error and exits 0 - this
# command stops with exit 1 rather than report the service as absent: on a host
# that does run it, a failed query read as "not running" would leave the changed
# file unapplied and the update green. Every call outside this command is bounded
# by a limit named in the message that reports it - install.sh's own run included
# - so a daemon or a remote that stops answering fails instead of hanging an
# update halfway through.
#
# The platform checkout is $TEHAS_HOME/platform, where the manual says a host
# keeps it. It has to be a git checkout - a clone, a worktree or a submodule -
# with an install.sh; without one this command stops rather than guess at
# another directory.
#
# While $TEHAS_HOME/state/update-hold exists an update refuses to run, with
# exit 1, and --check says the hold is there. A person who rolled the platform
# back makes that file, so the next update does not move it forward again.
# --to names its version and is not held.
#
# Usage:
#   tehas update             move to the newest release, or pull the checkout;
#                            install, run the follow-ups that apply
#   tehas update --to vX.Y.Z install that release, older ones included
#   tehas update --check [--to vX.Y.Z]
#                            from a release: the installed version, the newest,
#                            and the notes of the releases between them with
#                            their Adopter action; then install.sh --check of
#                            the version installed. It downloads nothing.
#   tehas update --check     report what would change and change no file of the
#                            checkout or of the host - including the follow-ups
#                            an earlier run left undone, which it reports and
#                            does not run. It does contact the remote, so the
#                            remote-tracking refs under origin/ are brought to
#                            what the remote has - origin/<branch> moves, and a
#                            branch the remote deleted stops being reported. It
#                            runs install.sh --check, which runs the tests.
#                            It asks upstream which pi-rukas commit to follow.
#                            Nothing is merged, installed, built or started, and
#                            it exits 1 when there is something to update.
#   tehas update -h|--help   print this text and exit 0
#
# Exit: 0 updated, or already up to date,
#       1 another update is running (it holds $TEHAS_HOME/state/update.lock),
#         after waiting up to TEHAS_UPDATE_LOCK_WAIT seconds (10 by default) for
#         it, the checkout has local changes, is not on a branch, cannot be
#         fast-forwarded, has no commit yet, a step failed or timed out, install.sh
#         gave no answer within its limit, systemd did not reload the unit files, a
#         follow-up install.sh asked for is one this command does not know, or
#         --check found something to update (a checkout behind, steps left
#         over from an earlier run, or a pi-rukas head the image is not on) or
#         something an update does not fix (the host's tools, the slice, root's
#         copy of the command, the tests), each said apart, or the image could
#         not be moved to the pi-rukas head. A record of steps owed that exists but this
#         account cannot read is a failure too: reading it as "nothing is owed"
#         would let the next write replace steps somebody else recorded. A status
#         of install.sh that this command does not know (126 when its exec bit is
#         gone, say) is reported as 1 with its number named. Steps run in the order lib/update-steps.sh lists
#         them - systemd first - so a step that fails after another one leaves
#         that one applied, and after install.sh copied files leaves those copies
#         in place; install.sh keeps each replaced file as <name>.prev. What was
#         asked for and did not run stays recorded for the next run, and so does
#         a step line this command does not know.
#         From a release, 1 also when the releases cannot be listed, the version
#         asked for is not published, or a download is missing a file, does
#         not match its .sha256 or is not signed by the installed key; nothing is
#         switched then.
#       64 --help with another argument, --to without a version or with one not
#         shaped vX.Y.Z, --to on a host that updates from its checkout, or an
#         argument this command does not know
#       78 the instance settings are missing or malformed, there is no
#         platform checkout, the host has neither one nor ~/tehas/current and
#         no TEHAS_UPDATE_FROM, or the release to switch to asks for a setting
#         the instance does not have (nothing is switched)
set -uo pipefail

# How long to wait for state/update.lock before saying another update is
# running. The name is read by tehas_update_lock_wait, which lib/update-steps.sh
# owns, and that call is made here - before lib/config.sh is sourced below -
# because tehas_load unsets every TEHAS_* it does not know, and this is not one of
# them: it is a knob for the tests and for an operator who does not want to wait,
# not a setting of an instance, so it is deliberately not in lib/config.sh's list
# of settings and is named in the manual instead. A run that stops partway can
# leave the lock held a moment by a child that outlived it, and a person who
# runs the command again right after such a stop would read that as another
# update running, so the lock is waited for rather than refused at once: long
# enough for a child on a loaded host to be reaped, short enough that a real
# second run is refused soon.
here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source=lib/update-steps.sh
. "$here/../lib/update-steps.sh"
lock_wait=$(tehas_update_lock_wait)

# Timeouts for the calls outside this command. Each is generous next to the work
# it bounds; its job is to turn a daemon or a remote that stopped answering into
# a failure that says so, rather than an update that hangs after install.sh has
# already copied files.
fetch_limit=120    # git fetch from origin
install_limit=1800 # install.sh: the copies, the dependency check and the tests.
                   # install.sh bounds one cargo build with TEHAS_BUILD_TIMEOUT
                   # (1800s by default), so keep this the larger of the two:
                   # otherwise a build that is cut off is reported as this
                   # timeout, not as install.sh's own message
compose_limit=180  # docker ps and docker compose up
systemd_limit=60   # systemctl daemon-reload, is-active and restart
build_limit=1800   # sandbox image build

# How long the mark of a half-finished takeover stands (see edge_up). Long
# enough to fix the cause and run the update again, short enough that a mark
# some earlier run left does not start a router an operator has stopped.
takeover_mark_age=86400

show_usage() {
  sed -n '2,/^[^#]/p' "$0" | sed -n '/^#/s/^# \{0,1\}//p'
}
unknown_argument() {
  printf 'tehas update: unknown argument: %s\n' "$1" >&2
  show_usage >&2
  exit 64
}

# Arguments first, as in the dispatcher: --help answers on a host with no
# instance settings yet, and an argument this command does not know reaches
# neither git nor Docker. Decided before anything is run.
mode=update
pending=0
to=""
case " $* " in
  *" -h "* | *" --help "*)
    if [ "$#" != 1 ]; then
      printf 'tehas update: --help takes no other argument, got %s\n' "$*" >&2
      show_usage >&2
      exit 64
    fi
    ;;
esac
while [ "$#" -gt 0 ]; do
  case "$1" in
    --check) mode=check ;;
    -h | --help) show_usage; exit 0 ;;
    --to)
      [ "$#" -ge 2 ] || { echo "tehas update: --to needs a version" >&2; exit 64; }
      to=$2
      shift
      ;;
    *) unknown_argument "$1" ;;
  esac
  shift
done
if [ -n "$to" ] && [[ ! $to =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
  echo "tehas update: --to takes a version vX.Y.Z, got: $to" >&2
  exit 64
fi

here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source=lib/config.sh
. "$here/../lib/config.sh"
# shellcheck source=lib/update-steps.sh
. "$here/../lib/update-steps.sh"
tehas_load || exit 78
# The settings an instance has to set for itself, in the one list lib/config.sh
# owns: the same list install.sh and the dispatcher check. Checking it here is
# what stops an instance with a required line still commented out before the
# checkout moves, not after install.sh has installed from the new code.
tehas_require_instance_settings

# shellcheck source=lib/update-release.sh
. "$here/../lib/update-release.sh"
from=$(tehas_update_source) || exit 78
if [ -n "$to" ] && [ "$from" != release ]; then
  echo "tehas update: --to installs a release, and this host updates from its platform checkout (TEHAS_UPDATE_FROM=git); nothing was changed" >&2
  exit 64
fi

# --to names its version, so it is not held: the hold keeps a plain update from
# moving the host on after a person moved it.
hold=$TEHAS_HOME/state/update-hold
if [ -e "$hold" ] && [ -z "$to" ]; then
  if [ "$mode" = update ]; then
    echo "tehas update: $hold exists, the platform is held where it is; nothing was changed. Remove the file to update." >&2
    exit 1
  fi
  echo "tehas update: $hold exists; an update will not move the checkout until it is removed" >&2
fi

checkout=$TEHAS_HOME/platform
# .git is a directory in a clone and a file in a worktree or a submodule.
if [ "$from" = git ] && { [ ! -e "$checkout/.git" ] || [ ! -f "$checkout/install.sh" ]; }; then
  echo "tehas update: no platform checkout at $checkout. Clone the platform repository there, or run ./install.sh from wherever you keep it." >&2
  exit 78
fi

# One update at a time: two side by side build the image twice and each rewrite
# the record of steps owed with its own view. install.sh takes the same lock;
# the descriptor this one holds it on is handed to it, so it does not refuse its
# own parent. --check changes nothing on the host and takes no lock.
if [ "$mode" = update ]; then
  update_lock=$TEHAS_HOME/state/update.lock
  if ! mkdir -p "$TEHAS_HOME/state" || ! exec 7>>"$update_lock"; then
    echo "tehas update: cannot open $update_lock; nothing was changed" >&2
    exit 1
  fi
  if ! flock -w "$lock_wait" 7; then
    echo "tehas update: another update is running ($update_lock), still held after ${lock_wait}s; nothing was changed" >&2
    exit 1
  fi
  export TEHAS_UPDATE_LOCK_FD=7
fi

# Descriptor 7 is the lock, and bash hands an open descriptor to every child, so a
# child that outlives this run - a build.sh that ends in a git that reads a remote,
# an install.sh that runs tehas labels - keeps the lock after the run itself has
# ended, and the next update reads that as another update running. install.sh is
# the one child meant to inherit it: it is named the descriptor in
# TEHAS_UPDATE_LOCK_FD and takes the lock on it rather than refusing its parent,
# which is what test/update_test.sh checks. For every other child the descriptor is
# closed for that child alone, written on the call that starts it as 7>&-, as the
# dispatcher does for the children of its own lock (libexec/dispatch: 8>&-). The
# lock stays held here; nothing a child starts can hold it after the child is gone.
# A redirection cannot be kept in a variable and expanded into place, so it is
# written on each of those lines.

# Steps an earlier run was asked for and did not finish are still owed, and this
# command finishes them: install.sh's report of what changed is spent by the run
# that made the copies, so a run that stopped partway would otherwise look green
# from here on. A line in that record that is not a step lib/update-steps.sh knows
# is not owed work this command can do; it is named, kept in the record, and the
# run ends red until something that knows it runs.
pending_file=$(tehas_pending_file)
leftover=()
unknown=()
record=$(tehas_read_steps) || {
  echo "update: the follow-up record is there but cannot be read; nothing was run" >&2
  exit 1
}
while IFS= read -r line; do
  [ -n "$line" ] || continue
  if tehas_valid_step "$line"; then leftover+=("$line"); else unknown+=("$line"); fi
done <<<"$record"
if [ "${#leftover[@]}" != 0 ]; then
  printf 'update: %s follow-up(s) an earlier run did not finish (see %s)\n' \
    "${#leftover[@]}" "$pending_file" >&2
  printf '  next: %s\n' "${leftover[@]}" >&2
fi

# The step lines this run was given that no step here knows. They are named, and
# they stay in the record: a producer that has moved ahead of this consumer is a
# difference between two versions of tehas, not work that has been done.
warn_unknown() {
  if [ "${#unknown[@]}" = 0 ]; then return 0; fi
  printf 'WARN: %s step line(s) name no step this command knows (see lib/update-steps.sh); they were not run and stay recorded in %s\n' \
    "${#unknown[@]}" "$pending_file" >&2
  printf '  next: %s\n' "${unknown[@]}" >&2
  return 0
}

if [ "$from" = git ]; then
  # --- 1. The checkout ---------------------------------------------------------
  # A branch, and nothing uncommitted: an update that carried on past either one
  # would merge into a tree somebody is editing.
  branch=$(git -C "$checkout" symbolic-ref --quiet --short HEAD 2>/dev/null) || branch=""
  if [ -z "$branch" ]; then
    echo "checkout: $checkout is not on a branch (detached HEAD); nothing was changed" >&2
    exit 1
  fi

  # A branch with no commit yet - a clone taken before the repository had one -
  # has no HEAD to compare with origin, and saying that is truer than the
  # fast-forward complaint an empty value would otherwise end in. Full commit ids,
  # not the short ones git abbreviates to whatever length suits the object count:
  # two calls either side of a fetch can abbreviate the same commit differently, and
  # a comparison of those would be a comparison of two different strings.
  head_sha=$(git -C "$checkout" rev-parse --quiet --verify HEAD 2>/dev/null) || head_sha=""
  if [ -z "$head_sha" ]; then
    echo "checkout: $checkout is on branch $branch with no commit yet; nothing was changed" >&2
    exit 1
  fi

  # A clone records the remote's default branch in refs/remotes/origin/HEAD. A
  # checkout left on another branch updates and installs that branch, which is
  # usually not what a person means, so it is said out loud before anything runs.
  default=$(git -C "$checkout" symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null) || default=""
  default=${default#origin/}
  if [ -n "$default" ] && [ "$default" != "$branch" ]; then
    printf 'checkout: %s is on branch %s; the default branch of origin is %s. This update uses %s.\n' \
      "$checkout" "$branch" "$default" "$branch" >&2
  fi

  # stdout only: a git warning is not a changed path, and git's own error text
  # reaches the operator on stderr either way.
  changes=$(git -C "$checkout" status --porcelain) || {
    echo "checkout: git status failed in $checkout; nothing was changed" >&2
    exit 1
  }
  if [ -n "$changes" ]; then
    printf 'checkout: %s has local changes; nothing was changed\n' "$checkout" >&2
    printf '%s\n' "$changes" | sed 's/^/  /' >&2
    exit 1
  fi

  out=$(timeout "$fetch_limit" git -C "$checkout" fetch --prune origin 7>&- 2>&1)
  rc=$?
  if [ "$rc" != 0 ]; then
    printf 'checkout: could not fetch from origin; nothing was changed\n' >&2
    [ "$rc" = 124 ] && echo "  the fetch gave no answer in ${fetch_limit}s" >&2
    [ -n "$out" ] && printf '%s\n' "$out" | sed 's/^/  /' >&2
    exit 1
  fi

  remote_sha=$(git -C "$checkout" rev-parse --quiet --verify "refs/remotes/origin/$branch" 2>/dev/null) || remote_sha=""
  if [ -z "$remote_sha" ]; then
    echo "checkout: origin has no branch $branch in $checkout; nothing was changed" >&2
    exit 1
  fi

  # Twelve of each for the lines an operator reads: long enough to tell two commits
  # apart, short enough to fit the message.
  head_short=${head_sha:0:12}
  remote_short=${remote_sha:0:12}

  if [ "$head_sha" = "$remote_sha" ]; then
    echo "checkout: $branch is up to date at $head_short"
  else
    # Fast-forward only. Local commits of its own, or a branch that was rewritten
    # on the remote, are a question for a person, not for an update.
    if ! git -C "$checkout" merge-base --is-ancestor HEAD "refs/remotes/origin/$branch" 2>/dev/null; then
      printf 'checkout: %s cannot fast-forward to origin/%s (%s); nothing was changed\n' \
        "$checkout" "$branch" "$remote_short" >&2
      echo "  the checkout has commits of its own, or origin/$branch was rewritten. Reconcile it by hand." >&2
      exit 1
    fi
    behind=$(git -C "$checkout" rev-list --count "HEAD..refs/remotes/origin/$branch")
    if [ "$mode" = check ]; then
      echo "checkout: would fast-forward $head_short -> $remote_short ($behind commits)"
      pending=1
    elif ! out=$(git -C "$checkout" merge --ff-only "refs/remotes/origin/$branch" 2>&1); then
      printf 'checkout: the fast-forward failed; nothing was installed\n' >&2
      [ -n "$out" ] && printf '%s\n' "$out" | sed 's/^/  /' >&2
      exit 1
    else
      echo "checkout: fast-forwarded $head_short -> $remote_short ($behind commits)"
      # The rules install.sh is about to use are the ones in the checkout it just
      # pulled, not the ones this command loaded from the installed copy. A change
      # that adds a required setting, or tightens what a setting may be, has to be
      # answered before anything of the host is touched - which is now, since the
      # merge moved only the checkout. Nothing here writes: it reads instance.env
      # and checks it against the pulled library.
      out=$(bash -c '
        if [ ! -r "$1/lib/config.sh" ]; then
          echo "this checkout has no lib/config.sh; install.sh will report it"
          exit 0
        fi
        . "$1/lib/config.sh"
        if [ "$(type -t tehas_load 2>/dev/null)" != function ]; then
          echo "this checkout does not define tehas_load; install.sh will check the settings itself"
          exit 0
        fi
        if [ "$(type -t tehas_require_instance_settings 2>/dev/null)" != function ]; then
          echo "this checkout does not define tehas_require_instance_settings; install.sh will check the settings itself"
          exit 0
        fi
        tehas_load && tehas_require_instance_settings
      ' _ "$checkout" 2>&1)
      rc=$?
      if [ "$rc" != 0 ]; then
        printf 'settings: the checkout this update pulled asks for settings this instance does not have; nothing was installed\n' >&2
        [ -n "$out" ] && printf '%s\n' "$out" | sed 's/^/  /' >&2
        echo "  $checkout is at the new code; fix the instance settings, or reset the checkout to what was installed before." >&2
        exit 78
      fi
      [ -n "$out" ] && printf 'settings: %s\n' "$out"
    fi
  fi
else
  # --- 1. The release ----------------------------------------------------------
  # The version to run is unpacked beside the others and checked before current
  # is moved to it, so a download that fails a check, or a release that asks for
  # a setting this instance lacks, leaves the host on the version it runs.
  installed=$(tehas_release_installed)
  list=$(tehas_release_list) || exit $?
  tags=$(jq -r .tag <<<"$list")
  newest=$(head -n 1 <<<"$tags")
  if [ -z "$newest" ]; then
    echo "release: $(tehas_release_repo) has no published release; nothing was changed" >&2
    exit 1
  fi
  if [ -n "$to" ] && ! grep -qxF -- "$to" <<<"$tags"; then
    echo "release: there is no published release $to; nothing was changed" >&2
    exit 1
  fi
  target=${to:-$newest}
  # The notes a person reads start at the version the host came from: what is
  # installed, or, for a host that ran from its platform checkout, the tag of
  # that checkout. It has no installed version, so it still has to switch to a
  # release even when the tag names the newest one. Without a tag the notes are
  # every release, as they were before.
  from_note=$installed
  checkout_tag=""
  if [ -z "$installed" ]; then
    checkout_tag=$(tehas_release_checkout_tag "$checkout")
  fi
  if [ -n "$checkout_tag" ]; then
    echo "release: installed none, this host ran from its platform checkout at $checkout_tag, newest $newest"
    from_note=$checkout_tag
  else
    echo "release: installed ${installed:-none, this host ran from its platform checkout}, newest $newest"
  fi
  if [ -z "$to" ] && [ -n "$installed" ] && tehas_release_older "$newest" "$installed"; then
    echo "release: $installed is newer than the newest release; tehas update --to moves it back"
    target=$installed
  fi

  # The notes a person reads before moving: each release's own section of the
  # changelog, its Adopter action among them. Going back, the ones undone.
  if [ "$target" != "$installed" ]; then
    if [ -n "$from_note" ] && tehas_release_older "$target" "$from_note"; then
      echo "release: going back to $target undoes these releases:"
      notes=$(tehas_release_between "$target" "$from_note" "$list")
    else
      echo "release: the notes up to $target:"
      notes=$(tehas_release_between "$from_note" "$target" "$list")
    fi
    while IFS= read -r line; do
      [ -n "$line" ] || continue
      printf '\n== %s\n' "$(jq -r .tag <<<"$line")"
      jq -r .body <<<"$line" | sed 's/^/  /'
    done <<<"$notes"
    echo
  fi

  if [ "$mode" = check ]; then
    if [ "$target" != "$installed" ]; then
      echo "release: would switch to $target"
      pending=1
    fi
    # What is installed is checked by the install.sh it came from.
    if [ -L "$TEHAS_HOME/current" ]; then
      checkout=$TEHAS_HOME/current
    elif [ ! -f "$checkout/install.sh" ]; then
      exit "$pending"
    fi
  elif [ "$target" = "$installed" ]; then
    echo "release: $installed is the version installed"
    checkout=$TEHAS_HOME/current
  else
    tree=$TEHAS_HOME/versions/$target
    if [ "$(head -n 1 "$tree/VERSION" 2>/dev/null)" = "$target" ]; then
      echo "release: $target is on this host from before; it is not downloaded again"
    else
      mkdir -p "$TEHAS_HOME/tmp"
      download=$(mktemp -d "$TEHAS_HOME/tmp/release.XXXXXX") || {
        echo "release: cannot make a directory to download into; nothing was changed" >&2
        exit 1
      }
      if ! tehas_release_fetch "$target" "$download" || ! tehas_release_verify "$target" "$download" ||
        ! tehas_release_unpack "$target" "$download"; then
        rm -rf "$download"
        echo "release: $target was not installed; nothing was changed" >&2
        exit 1
      fi
      rm -rf "$download"
      echo "release: $target downloaded, checked against its .sha256 and its signature, unpacked in $tree"
    fi
    if ! tehas_release_settings "$tree"; then
      echo "settings: $target asks for settings this instance does not have; nothing was switched" >&2
      exit 78
    fi
    while IFS= read -r key; do
      [ -n "$key" ] && echo "WARN: $TEHAS_INSTANCE_DIR/instance.env sets $key, which $target does not know" >&2
    done < <(tehas_release_unknown_keys "$tree")
    if ! tehas_release_switch "$target"; then
      echo "release: current could not be pointed at $target; nothing was installed" >&2
      exit 1
    fi
    echo "release: current is $target, was ${installed:-the platform checkout}"
    checkout=$TEHAS_HOME/current
    # A version that ran here before has its sandbox image still tagged, so going
    # back to it is a tag and not a build.
    if timeout "$compose_limit" docker image inspect "tehas/pi-rukas:release-$target" 7>&- >/dev/null 2>&1 &&
      timeout "$compose_limit" docker tag "tehas/pi-rukas:release-$target" "$PI_ENSEMBLE_IMAGE" 7>&- >/dev/null 2>&1; then
      echo "sandbox: the image $target ran with is in use again"
      reused=1
    fi
  fi
fi

# pi-rukas is not pinned: the sandbox image follows the commit the installed
# versions.env names by PI_RUKAS_FOLLOW, so an update looks upstream even when
# no file of tehas changed. A host whose versions.env has no PI_RUKAS_FOLLOW is
# left as it is.
follows_rukas() {
  grep -q '^PI_RUKAS_FOLLOW=' "$TEHAS_HOME/versions.env" 2>/dev/null && [ -x "$TEHAS_HOME/sandbox/build.sh" ]
}
rukas_step() { # --if-moved | --check
  local out rc
  out=$(timeout "$build_limit" "$TEHAS_HOME/sandbox/build.sh" "$1" 7>&- 2>&1)
  rc=$?
  [ -n "$out" ] && printf '%s\n' "$out"
  if [ "$rc" = 124 ]; then
    echo "pi-rukas: the build gave no answer in ${build_limit}s" >&2
  fi
  return "$rc"
}

# The host's clone of pi-rukas lags the sandbox image whenever the followed
# commit moved, and the only thing that moves it is bootstrap.sh user. install.sh
# prints that follow-up for a changed versions.env; a followed commit can move
# with no file of tehas changing, so the line is printed here too. It is called
# where a run left the image on the commit it follows, so what is compared is the
# pair install.sh --check will report on.
# Not a step: bootstrap.sh user fetches from the network and replaces the tools
# and the checkout, so this command never runs it. Nothing is decided on a
# missing answer - no image, no label, no clone - because that is not evidence
# the clone is behind. The answer of docker is read before the clone is asked
# anything: a host with an image already on the followed commit prints nothing,
# whether or not it has a clone.
rukas_later() {
  local image clone
  image=$(timeout "$compose_limit" docker image inspect \
    --format '{{index .Config.Labels "tehas.rukas"}}' "$PI_ENSEMBLE_IMAGE" 7>&- 2>/dev/null) || image=""
  # Docker's own words for "no such image" are not an answer about a commit.
  case "$image" in '' | *"No such image"*) return 0 ;; esac
  clone=$(git -C "$TEHAS_HOME/repos/pi-rukas" rev-parse HEAD 2>/dev/null) || clone=""
  [ -n "$clone" ] || return 0
  [ "$image" != "$clone" ] || return 0
  echo "later: $checkout/bootstrap.sh user   (pi-rukas moved to ${image:0:7}; until it runs, --check says Dependencies: NOT OK)"
}

# --- 2. install.sh -----------------------------------------------------------
# Its stdout is printed as it is; its stderr goes on this command's stderr, where
# a diagnostic belongs, so what happened to be written as an error can never be
# taken for a step to run. Its follow-ups are read twice: from the lines it
# printed, and from the record it wrote as it copied.
run=("$checkout/install.sh")
[ "$mode" = check ] && run+=(--check)
# install.sh is the step that does the real work on the host - copies, a
# dependency check, the tests, and one call to a remote - so it carries a limit of
# its own. Without one, a remote that stops answering hangs an update halfway
# through, after the files are already copied.
scratch=${TMPDIR:-/tmp}
mkdir -p "$scratch" 2>/dev/null || scratch=/tmp
err_file=$(mktemp "$scratch/tehas-update.XXXXXX") || {
  echo "tehas update: could not make a scratch file to keep install.sh's diagnostics apart" >&2
  exit 1
}
trap 'rm -f "$err_file"' EXIT
# install.sh is the one child that keeps the descriptor: it is named there in
# TEHAS_UPDATE_LOCK_FD and takes the lock on it rather than refusing its parent,
# which is what test/update_test.sh checks.
out=$(timeout "$install_limit" "${run[@]}" 2>"$err_file")
rc=$?
# Print what install.sh reported, but not a follow-up line: this command runs
# the ones it knows, and names the ones it does not as a WARN below. An operator
# reading the log sees each step and its answer, not a line that looks like work
# left over, and install.sh's own diagnostics arrive on stderr where they belong.
if [ -n "$out" ]; then
  printf '%s\n' "$out" | while IFS= read -r line; do
    case "$line" in
      next:*) : ;;
      *) printf '%s\n' "$line" ;;
    esac
  done
fi
[ -s "$err_file" ] && cat -- "$err_file" >&2
if [ "$rc" = 124 ]; then
  warn_unknown
  if [ "$mode" = check ]; then
    printf 'install: install.sh --check gave no answer in %ss and was stopped; it changes nothing, so nothing was installed.\n' \
      "$install_limit" >&2
  else
    printf 'install: install.sh gave no answer in %ss and was stopped; what it had copied is installed, and any follow-up it recorded in %s is still owed.\n' \
      "$install_limit" "$pending_file" >&2
  fi
  exit 1
fi
if [ "$rc" != 0 ]; then
  warn_unknown
  if [ "$mode" = check ]; then
    # install.sh --check answers 1 when it found something. That is its report,
    # not a failed step: in check mode nothing was meant to run. Files that
    # differ and steps owed are what an update fixes; the host's tools, the
    # slice, root's copy of the command and the tests are not.
    found=0
    if grep -qE '^(Installed: +DRIFT|Follow-ups: +NOT DONE)' <<<"$out"; then
      echo "install: install.sh --check found something to update" >&2
      found=1
    fi
    if grep -qE '^(Dependencies: +NOT OK|Slice: +(MISSING|DIFFERS)|Login: +NOT CURRENT|Tests: +FAILED)' <<<"$out"; then
      echo "install: install.sh --check found something tehas update does not fix; its lines above say what" >&2
      found=1
    fi
    [ "$found" = 1 ] || echo "install: install.sh --check exited $rc" >&2
  else
    echo "install: install.sh exited $rc; no follow-up was run" >&2
  fi
  # Pass on the statuses install.sh documents. Anything else is a step that
  # failed, whatever number it came back with: bash answers 126 or 127 when the
  # file lost its exec bit, and this command documents 0, 1, 64 and 78.
  case "$rc" in 1 | 78) exit "$rc" ;; *) exit 1 ;; esac
fi

# The step library this command loaded is the one installed before this run.
# install.sh printed its lines from the checkout's, which may know a step or a
# unit the old one does not, so the lines are checked against that one.
if [ "$mode" = update ] && [ -r "$checkout/lib/update-steps.sh" ]; then
  # shellcheck source=lib/update-steps.sh
  . "$checkout/lib/update-steps.sh" || {
    echo "update: $checkout/lib/update-steps.sh could not be read; no follow-up was run" >&2
    exit 1
  }
fi

# --- 3. The follow-ups -------------------------------------------------------
# Every step line this run was given: the ones install.sh printed, and the ones
# its record holds. Those are not the same list - a run that died partway records
# what it copied and prints no report, and an id newer than this command is
# recorded before anything here can read it - so the record is read as well as the
# report. Each line is checked in lib/update-steps.sh before it runs, so an
# option-shaped token or a verb this command was not asked for never reaches
# systemctl or docker. --check starts no build, unit or container and writes
# nothing: it names what is waiting and exits 1.
given=()
add_given() { # one line once, whatever asked for it twice
  local have
  if [ "${#given[@]}" != 0 ]; then
    for have in "${given[@]}"; do
      [ "$have" = "$1" ] && return 0
    done
  fi
  given+=("$1")
}
while IFS= read -r line; do
  [ -n "$line" ] || continue
  add_given "$line"
done < <(printf '%s\n' "$out" | sed -n 's/^next: //p')
record=$(tehas_read_steps) || {
  echo "update: the follow-up record is there but cannot be read; no follow-up was run, and what install.sh copied stays installed" >&2
  exit 1
}
while IFS= read -r line; do
  [ -n "$line" ] || continue
  add_given "$line"
done <<<"$record"

asked=()
unknown=()
for line in "${given[@]}"; do
  if tehas_valid_step "$line"; then asked+=("$line"); else unknown+=("$line"); fi
done
warn_unknown

if [ "$mode" = check ]; then
  # Nothing was merged, installed, built or started. What is left to do is the
  # checkout moving, and any step an earlier run never finished.
  if [ "${#leftover[@]}" != 0 ] || [ "${#unknown[@]}" != 0 ]; then pending=1; fi
  if follows_rukas && ! rukas_step --check; then pending=1; fi
  exit "$pending"
fi

# A compose server is renewed only where it already runs: an update keeps a
# service the host is using current, it does not add one to the host. Whether it
# runs is asked of Docker with one plain ps on the project name the compose file
# pins (name: tehas-docs, name: tehas-edge); the shell tests assert those
# names are still in the files. The one other project asked about is
# tehas-protolab, the Protolab server of before the edge router (edge_up). docker compose is for the renewal only.
# The arguments are the ones written on install.sh's line, checked before use.
compose_up() { # name project file [argument...]
  local name=$1 project=$2 file=$3 running out rc
  shift 3
  if [ ! -f "$file" ]; then
    echo "$name: $file is not installed, left alone" >&2
    return 1
  fi
  # Containers of that project answer one id each; an empty answer means none is
  # running. A query that fails (no daemon, no docker, a bad filter) is not an
  # answer of "none", and this command cannot tell "not running" from it.
  running=$(timeout "$compose_limit" docker ps --quiet \
    --filter "label=com.docker.compose.project=$project" 7>&- 2>&1)
  rc=$?
  if [ "$rc" != 0 ]; then
    echo "$name: docker ps failed; the step is not done" >&2
    [ "$rc" = 124 ] && echo "  docker gave no answer in ${compose_limit}s" >&2
    [ -n "$running" ] && printf '%s\n' "$running" | sed 's/^/  /' >&2
    return 1
  fi
  if [ -z "$running" ]; then
    echo "$name: not running on this host, left alone"
    return 0
  fi
  echo "$name: updating the container"
  out=$(timeout "$compose_limit" docker compose -f "$file" up -d "$@" 7>&- 2>&1)
  rc=$?
  [ -n "$out" ] && printf '%s\n' "$out"
  if [ "$rc" = 124 ]; then
    echo "$name: docker compose gave no answer in ${compose_limit}s; the step is not done" >&2
    return 1
  fi
  if [ "$rc" != 0 ]; then
    echo "$name: docker compose exited $rc" >&2
    return 1
  fi
  return 0
}

# The edge router takes over from the Protolab's server of before it. An install
# that removes edge/protolab.* leaves that server's container running from the
# files it had open, holding port 8081, so the router could never start and the
# update would report "not running" and end green. Where the old project runs it
# is taken down and the router is brought up in its place; anywhere else this is
# compose_up, which renews the router only where it already runs.
#
# The takeover is two commands, and the first can succeed where the second
# fails. The next run would then find neither project running, say "left alone"
# and count the step done, with port 8081 dark. So a taken down project leaves a
# mark, $TEHAS_HOME/state/edge-takeover, holding the time it was made. While it
# is fresh the router is brought up whatever runs, and the mark goes only when
# that worked. An old one is not: an operator who stopped the router on purpose
# would otherwise have it started again weeks later by a mark of some run they
# already gave up on. It is said, removed, and the step is what it would have
# been without it - renew the router only where it already runs.
edge_up() { # argument...
  local file=$TEHAS_HOME/edge/router.compose.yaml mark=$TEHAS_HOME/state/edge-takeover old out rc made age
  if [ ! -f "$file" ]; then
    compose_up edge tehas-edge "$file" "$@"
    return
  fi
  if [ -e "$mark" ]; then
    made=$(head -n 1 "$mark" 2>/dev/null) || made=""
    case "$made" in '' | *[!0-9]*) made="" ;; esac
    age=-1
    [ -n "$made" ] && age=$(( $(date -u +%s) - made ))
    if [ "$age" -gt "$takeover_mark_age" ]; then
      printf 'edge: the mark of the takeover is %s hours old, and was left to you; start the router by hand if you want it\n' \
        "$((age / 3600))"
      rm -f "$mark"
      compose_up edge tehas-edge "$file" "$@"
      return
    fi
    # With no time on it the mark is one an older version wrote: it is honoured
    # once, and from here on it carries the time of this run.
    if [ -z "$made" ]; then
      echo "edge: finishing the takeover from the Protolab's server (tehas-protolab); the mark had no time on it"
      printf '%s\n' "$(date -u +%s)" >"$mark" 2>/dev/null || true
    else
      echo "edge: finishing the takeover from the Protolab's server (tehas-protolab)"
    fi
  else
    old=$(timeout "$compose_limit" docker ps --quiet \
      --filter "label=com.docker.compose.project=tehas-protolab" 7>&- 2>&1)
    rc=$?
    if [ "$rc" != 0 ]; then
      echo "edge: docker ps failed; the step is not done" >&2
      [ "$rc" = 124 ] && echo "  docker gave no answer in ${compose_limit}s" >&2
      [ -n "$old" ] && printf '%s\n' "$old" | sed 's/^/  /' >&2
      return 1
    fi
    if [ -z "$old" ]; then
      compose_up edge tehas-edge "$file" "$@"
      return
    fi
    echo "edge: taking over from the Protolab's server (tehas-protolab)"
    out=$(timeout "$compose_limit" docker compose -p tehas-protolab down 7>&- 2>&1)
    rc=$?
    [ -n "$out" ] && printf '%s\n' "$out"
    if [ "$rc" != 0 ]; then
      echo "edge: docker compose down of tehas-protolab exited $rc; the step is not done" >&2
      return 1
    fi
    # A mark that cannot be written does not stop the takeover: the router is
    # brought up now all the same, and only a failure of that is then lost.
    if ! printf '%s\n' "$(date -u +%s)" >"$mark" 2>/dev/null; then
      echo "edge: $mark could not be written" >&2
    fi
  fi
  out=$(timeout "$compose_limit" docker compose -f "$file" up -d "$@" 7>&- 2>&1)
  rc=$?
  [ -n "$out" ] && printf '%s\n' "$out"
  if [ "$rc" != 0 ]; then
    echo "edge: docker compose up exited $rc; the step is not done" >&2
    return 1
  fi
  rm -f "$mark"
  return 0
}

# install.sh asks for these by name. This command never enables a unit: it
# restarts the ones that were already active, which is what a changed unit file
# needs, and leaves the rest as the operator left them. The reload comes first,
# because a unit file copied onto the host is not in effect until systemd has read
# it - restarting before that applies the definitions systemd still holds.
restart_units() { # unit names install.sh asked for (checked by tehas_valid_step)
  local unit answer reason active=() out rc
  # Only silence next to exit 0 means the reload happened: a systemctl wrapper on
  # a host with no systemd prints an error and still answers 0. A reload that did
  # not happen stops the step, so the units stay owed and the run stays red rather
  # than report changed unit files as applied.
  out=$(timeout "$systemd_limit" systemctl --user daemon-reload 7>&- 2>&1)
  rc=$?
  if [ "$rc" = 124 ]; then
    echo "systemd: systemctl --user daemon-reload gave no answer in ${systemd_limit}s; no unit was restarted, and the step is not done" >&2
    return 1
  fi
  if [ "$rc" != 0 ] || [ -n "$out" ]; then
    reason="answered with text"
    if [ "$rc" != 0 ] && [ "$rc" != 124 ]; then reason="did not run"; fi
    echo "systemd: systemctl --user daemon-reload $reason; the changed unit files are not in effect, no unit was restarted, and the step is not done" >&2
    if [ -n "$out" ]; then printf '%s\n' "$out" | sed 's/^/  /' >&2; fi
    return 1
  fi
  for unit in "$@"; do
    # Ask without --quiet so there is an answer to read, and read only systemd's
    # own states: every state of the active family - including a unit that is
    # activating between restarts, or reloading - means this unit runs, so it
    # gets the new unit file. inactive and failed leave it alone; unknown means
    # systemd has no such unit on this host, which is an answer too. Anything
    # else - no user bus, a systemctl wrapper on a host with no systemd printing
    # "systemd is not running" while it exits 0 - says nothing about this unit,
    # so nothing is restarted and the step is not done. Exit status alone would
    # read that last one as active.
    answer=$(timeout "$systemd_limit" systemctl --user is-active "$unit" 7>&- 2>&1)
    rc=$?
    if [ "$rc" = 124 ]; then
      echo "systemd: systemctl is-active gave no answer for $unit in ${systemd_limit}s; no unit was restarted" >&2
      return 1
    fi
    case "$answer" in
      active | activating | reloading | refreshing | maintenance | deactivating) active+=("$unit") ;;
      inactive | failed | unknown) ;;
      *)
        echo "systemd: systemctl is-active gave no answer for $unit; no unit was restarted" >&2
        [ -n "$answer" ] && printf '%s\n' "$answer" | sed 's/^/  /' >&2
        return 1
        ;;
    esac
  done
  if [ "${#active[@]}" = 0 ]; then
    echo "systemd: none of them runs on this host, left alone"
    return 0
  fi
  echo "systemd: restarted ${active[*]}"
  out=$(timeout "$systemd_limit" systemctl --user restart "${active[@]}" 7>&- 2>&1)
  rc=$?
  if [ "$rc" = 124 ]; then
    echo "systemd: systemctl gave no answer in ${systemd_limit}s; the step is not done" >&2
    return 1
  fi
  if [ "$rc" != 0 ]; then
    echo "systemd: systemctl exited $rc" >&2
    [ -n "$out" ] && printf '%s\n' "$out" | sed 's/^/  /' >&2
    return 1
  fi
  return 0
}

# The sandbox image, when its Dockerfile or the versions it pins changed.
build_sandbox() {
  local out rc
  if [ ! -x "$TEHAS_HOME/sandbox/build.sh" ]; then
    echo "sandbox: $TEHAS_HOME/sandbox/build.sh is not installed" >&2
    return 1
  fi
  echo "sandbox: building the image"
  built=1
  out=$(timeout "$build_limit" "$TEHAS_HOME/sandbox/build.sh" 7>&- 2>&1)
  rc=$?
  [ -n "$out" ] && printf '%s\n' "$out"
  if [ "$rc" = 124 ]; then
    echo "sandbox: the build gave no answer in ${build_limit}s; the step is not done" >&2
    return 1
  fi
  if [ "$rc" != 0 ]; then
    echo "sandbox: the build exited $rc" >&2
    return 1
  fi
  return 0
}

# One step, run as this command's own words: the id says which, and the
# arguments on install.sh's line - checked by tehas_valid_step - say how. The
# helper answers with a status; whether that stops the run is decided here, in
# the one place that sequences the steps.
run_step() { # step line
  local argv=() id
  read -r -a argv <<<"$1"
  id=$(tehas_step_id "${argv[0]}")
  case "$id" in
    units) restart_units "${argv[@]:1}" ;;
    sandbox) build_sandbox ;;
    docs) compose_up docs tehas-docs "$TEHAS_HOME/edge/docs.compose.yaml" "${argv[@]:1}" ;;
    edge) edge_up "${argv[@]:1}" ;;
    *)
      echo "WARN: no step this command knows for: $1" >&2
      return 1
      ;;
  esac
}

# Record what was asked for before any of it runs, and drop each step from the
# record only once it has run. A run that stops partway therefore leaves the
# rest owed, in a file the next run reads - and install.sh --check reports -
# instead of losing them with its one-shot report. A line no step here knows is
# never run and is written back as it came. tehas_write_steps replaces the record
# through a temporary file, so a run that died mid-write leaves the old record
# rather than half of a new one.
write_pending() { # the steps still owed, in the order they run; none means gone
  local line owed=()
  if [ "$#" != 0 ]; then owed=("$@"); fi
  for line in "${unknown[@]}"; do owed+=("$line"); done
  tehas_write_steps "${owed[@]}"
}

# The work list, ordered by lib/update-steps.sh rather than by whoever wrote the
# lines: systemd first, because a unit file is not in effect until it is reloaded
# and its unit restarted. A step an earlier run owed runs in the same place as one
# this run was asked for, whatever order the two of them were recorded in.
steps=()
while IFS= read -r line; do steps+=("$line"); done < <(tehas_sort_steps "${asked[@]}")

status=0
built=0
if [ "${reused:-0}" = 1 ]; then
  kept=()
  for step in "${steps[@]}"; do
    [ "$(tehas_step_id "${step%% *}")" = sandbox ] || kept+=("$step")
  done
  steps=("${kept[@]}")
  built=1
fi
if [ "${#unknown[@]}" != 0 ]; then status=1; fi
if ! write_pending "${steps[@]}"; then exit 1; fi

ran=0
for step in "${steps[@]}"; do
  run_step "$step"
  rc=$?
  if [ "$rc" != 0 ]; then
    status=1
    break
  fi
  ran=$((ran + 1))
  if ! write_pending "${steps[@]:$ran}"; then
    status=1
    break
  fi
done

if [ "${#steps[@]}" != 0 ] && [ "$ran" -lt "${#steps[@]}" ]; then
  printf 'update: %s of %s follow-up(s) are not done, recorded in %s; tehas update runs them again\n' \
    $((${#steps[@]} - ran)) "${#steps[@]}" "$pending_file" >&2
fi

# A build this run made is already on the commit followed.
if [ "$status" = 0 ] && [ "$built" = 0 ] && follows_rukas && ! rukas_step --if-moved; then
  echo "pi-rukas: the image was not moved to the commit versions.env follows; tehas update tries again" >&2
  status=1
fi

# Whether the clone came along. A build this run made, or one it moved onto, is
# on the followed commit, and only bootstrap.sh user moves the clone to it; the
# answer of install.sh says whether that run already printed the line, so a
# person reads the follow-up once. --check changes nothing and asks for nothing.
if [ "$status" = 0 ] && [ "$mode" = update ] && follows_rukas; then
  case $out in
    *"later: "*"bootstrap.sh user"*) ;;
    *) rukas_later ;;
  esac
fi

# The image this version runs with keeps a tag of its own, so going back to the
# version later is a tag and not a build; prune drops the tags of versions it
# removes.
if [ "$status" = 0 ] && [ "$from" = release ]; then
  version=$(tehas_release_installed)
  if [ -n "$version" ] && ! timeout "$compose_limit" docker tag "$PI_ENSEMBLE_IMAGE" "tehas/pi-rukas:release-$version" 7>&- >/dev/null 2>&1; then
    echo "sandbox: $PI_ENSEMBLE_IMAGE could not be tagged for $version; going back to it builds the image again"
  fi
  tehas_release_prune
fi

exit "$status"
