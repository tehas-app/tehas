#!/usr/bin/env bash
# Bring this host up to date in one step, from a release or from the platform
# checkout. `tehas help update` says what it does. The console does all of it
# (console/ops/src/update/run.rs); this execs it with its own path, so the console
# install.sh leaves there, or the one it kept, finishes the run. A console that
# does not start cannot say so itself, so it is asked first.
#
# Exit: the console's; 1 the console does not answer; 78 no console stands
# beside this file.
set -uo pipefail

here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
console=${TEHAS_CONSOLE:-$here/console}
[ -x "$console" ] || { echo "tehas update: no console at $console: run install.sh" >&2; exit 78; }
api=$("$console" update api 2>/dev/null)
rc=$?
[ "$api" = 1 ] || { echo "tehas update: the console at $console does not answer (exit $rc), so this host cannot update itself; see What to do when tehas update says the console does not answer in the manual's troubleshooting page" >&2; exit 1; }
exec "$console" update run "$console" "$@"
