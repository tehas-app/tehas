#!/usr/bin/env bash
# The way into "tehas dev" for another account on the host. sudo runs this as
# the tehas user; nobody types it. /etc/sudoers.d/tehas-dev and host/login/tehas
# name this path, and a root step writes both. console/src/dev.rs is the rest.
#
# Usage: sudo -H -u <tehas user> dev-login "Name <email>" [-- <pi arguments>]
#
# Exit: that of the session; 64 not started by sudo, an account whose name
# cannot name a clone, or arguments other than the above. No container then.
here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
[ -x "$here/console" ] || { echo "tehas dev: no console beside this command at $here/console, run install.sh" >&2; exit 78; }
exec "$here/console" tehas dev-login "$@"
