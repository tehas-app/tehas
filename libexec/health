#!/usr/bin/env bash
# Write the factory's health file: $TEHAS_HOME/live/health.json, served by the
# docs server as /health (and /healthz).
#
# It reads only what the factory already writes under live/: status.json (the
# queue snapshot from tehasbot status), running.json (the running cycles
# and the last one, from tehas work) and dispatch.json (what holds cycles
# back and the slice's numbers, from the last poll of tehas dispatch). No
# network, no model, no systemctl and no docker. tehasbot status runs it on
# exit, so it is refreshed at every poll and at the end of every cycle.
#
# The file follows the health check response format (draft-inadarei-api-health-check):
#   status "pass"  the factory is taking work
#   status "warn"  it is paused (tehas:pause on the control issue), or the
#                  dispatcher holds everything because tehas.slice is missing
#                  or cannot be read, or there are no resources (the model
#                  endpoint does not answer or does not offer the model, as
#                  the last poll found), or the host is too low on disk to build
#                  previews, or its free space could not be read
#                  (live/previews.json, from tehasbot preview)
#   status "fail"  the last cycle ended as anything but merged or handoff and
#                  no cycle has started since, or there is no queue snapshot yet
# On "fail" it also creates live/health.down, which makes the docs server answer
# 503 with the same body; otherwise it removes that file.
#
# checks.failures names every failed ending it has seen: what the file recorded
# the last time, what is on disk under live/cycles, and the cycle that finished
# last. A failed cycle's file is kept for a day, but "fail" lasts only until a
# cycle starts after it, so the record is what keeps a short failure visible to
# a monitor that polls every few minutes. It holds at most 20 endings, each
# from the last 24 hours. An ending is one run of one cycle, told by its issue
# and when it started: the work script writes one ending twice when a cycle is
# stopped, and the last cycle is on disk and in the view as well, so each is
# named once. An ending whose time cannot be read is dropped, not stamped with
# now: one could never age out, and it would add an entry at every poll. An
# ending with no status word is not named either, because there is nothing to
# say about it.
#
# A stopped dispatcher cannot report itself: the file just stops changing. A
# monitor should treat a "time" older than about ten minutes as down.
#
# Usage: tehasbot health        (prints nothing; exit 0 unless the file cannot be written)
set -uo pipefail

: "${TEHAS_HOME:=$HOME/tehas}"
live=$TEHAS_HOME/live
mkdir -p "$live"
# This command runs at every poll and again at the end of a cycle, so two of
# them can be writing at once: the temporary file carries this process's id so
# neither overwrites the other's. It ends in .new, which the docs server hides.
tmp=$live/health.json.$$.new
# One that was killed outright leaves its file behind. Ten minutes is longer
# than this command takes, so an older one belongs to no run.
find "$live" -maxdepth 1 -name 'health.json.*.new' -mmin +10 -delete 2>/dev/null || true
trap 'rm -f "$tmp"' EXIT
here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source=lib/live.sh
. "$here/../lib/live.sh"

# What this file recorded last time. The record is carried from one write to
# the next because a failure is not always still on disk when it is read.
seen=$(jq -c '(.checks.failures | if type == "array" then . else [] end)
  | map(select(type == "object") | {issue, status, step, startedAt, time})' "$live/health.json" 2>/dev/null)
[ -n "$seen" ] || seen='[]'

# The cycle endings on disk, read before the assemble below keeps only the last
# one: a failure another cycle's heartbeat overtook must still be named.
endings='[]'
files=()
for f in "$live"/cycles/*.json; do
  # One file that is not an object is skipped, not fatal: the others still
  # reach the record.
  [ -e "$f" ] && jq -e 'type == "object"' "$f" >/dev/null 2>&1 && files+=("$f")
done
if [ "${#files[@]}" -gt 0 ]; then
  endings=$(jq -cs '
    [.[] | select((.running // false) != true) | {issue, status, step, startedAt, updatedAt}]' "${files[@]}" 2>/dev/null)
  [ -n "$endings" ] || endings='[]'
fi

# A cycle that died without a word stops being shown as running here.
tehas_live_assemble 2>/dev/null || true

status_file=$live/status.json
running_file=$live/running.json
queue=null
view=null
[ -s "$status_file" ] && queue=$(jq -c . "$status_file" 2>/dev/null || echo null)
[ -s "$running_file" ] && view=$(jq -c . "$running_file" 2>/dev/null || echo null)

# The free space of the host, as tehasbot preview measured it. A host without
# previews has no such file, and a figure that is no longer written is not
# believed after half an hour.
previews_file=$live/previews.json
disk=null
[ -s "$previews_file" ] && disk=$(jq -c '
  select((.disk | type) == "object" and (now - (.generatedAt | fromdateiso8601)) < 1800)
  | .disk + {time: .generatedAt}' "$previews_file" 2>/dev/null)
[ -n "$disk" ] || disk=null

# What the last poll said about the slice. The poll before this one wrote it,
# or this one when a cycle or a planning turn was started. A file older than
# ten minutes is from a dispatcher that no longer gets that far. It is read
# whole or not at all, so a file that is not one object cannot break the write.
dispatch_file=$live/dispatch.json
slice=null
[ -s "$dispatch_file" ] && slice=$(jq -cs '
  select(length == 1) | .[0]
  | select(type == "object" and (.why | type) == "string" and (now - (.time | fromdateiso8601)) < 600)
  | {time, why, hold, count, room, committed, max, reserve}' "$dispatch_file" 2>/dev/null)
[ -n "$slice" ] || slice=null

jq -n --argjson queue "$queue" --argjson view "$view" --argjson disk "$disk" --argjson slice "$slice" \
  --argjson seen "$seen" --argjson endings "$endings" --arg now "$(date -u +%FT%TZ)" '
  # A timestamp outside the range jq can convert is no time at all. It must
  # not stop the write: one bad number would lose every other ending too.
  def iso: if type == "number" then (try (todate) catch null) else null end;
  # Status and step are words of the agent that ran the cycle, from its own
  # state file, and have no length limit. In the record they stay short: at
  # most 20 entries would otherwise repeat one long string in a served file.
  def clip: if type == "string" then .[0:200] else null end;
  # A time as this record keeps it: a whole second in UTC. What the record
  # carried back is already in that shape, so it survives the round trip.
  def stamp: if type == "number" then (try (todate) catch null)
             elif type == "string" then (try (fromdateiso8601 | todate) catch null)
             else null end;
  def brief: {
    issue, running: (.running // false), status, step,
    startedAt: (.startedAt | iso), time: (.updatedAt | iso)
  };
  def failed: (.status // "") | IN("merged", "handoff") | not;
  # The view tehas work writes, or the one object an earlier version wrote.
  (if ($view | type) != "object" then {cycles: [], last: null}
   elif ($view | has("cycles")) then $view
   elif $view.running == true then {cycles: [$view], last: null}
   else {cycles: [], last: $view} end) as $v
  | ($v.cycles // []) as $running
  | $v.last as $last
  | ($last != null and ($last | failed)
     and ($running | map(select((.startedAt // 0) >= ($last.updatedAt // 0))) | length) == 0) as $failed
  # Nothing starts on a slice that is missing or cannot be read. The other
  # holds pass by themselves.
  | ($slice != null and ($slice.why | IN("slice", "unreadable"))) as $no_slice
  | ($slice != null and $slice.why == "resources") as $no_resources
  | (if $queue == null then "fail"
     elif $failed then "fail"
     elif $queue.paused then "warn"
     elif $no_slice then "warn"
     elif $no_resources then "warn"
     elif $disk != null and $disk.low then "warn"
     else "pass" end) as $status
  # What this file now records about failed endings: what it recorded before,
  # what is on disk under live/cycles, and the cycle that finished last. An
  # ending is one run of one cycle, told by its issue and when it started, and
  # it keeps the first time it was seen to end: the work script writes one
  # ending twice when a cycle is stopped, the last cycle is on disk and in the
  # view as well, and none of that may add an entry or move a time. Newest
  # first, a day deep, at most 20. An ending whose time cannot be read is not
  # kept, because it could never age out, and one with no status word is not
  # named, because there is nothing to say about it.
  | ($now | fromdateiso8601) as $epoch
  | ($seen + $endings + (if $failed then [$last] else [] end))
    | map(select(type == "object")
          | {issue, status, step,
             startedAt: (.startedAt | stamp),
             time: (if .updatedAt != null then (.updatedAt | stamp) else (.time | stamp) end)})
    | map(select((.issue | type) == "number" and (.status | type) == "string"
                  and (.status | IN("merged", "handoff") | not)
                  and (.time | type) == "string"
                  and ((.time | try fromdateiso8601 catch 0) > $epoch - 86400)
                  and ((.time | try fromdateiso8601 catch 0) <= $epoch)))
    | map({issue, status: (.status | clip), step: (.step | clip), startedAt, time})
    | group_by([.issue, .startedAt]) | map(min_by(.time)) | sort_by(.time) | reverse | .[:20]
    as $failures
  | {
      status: $status,
      time: $now,
      output: (if $queue == null then "No queue snapshot yet: the dispatcher has not written one."
               elif $failed then "The last cycle failed: #\($last.issue) ended as \($last.status)."
               elif $queue.paused then "The factory is paused."
               elif $no_slice then ($slice.hold // "holding")
               elif $no_resources then (($slice.hold // "") | sub("^holding: no resources: "; "No resources: ") + ".")
               elif $disk != null and $disk.low then
                 (if $disk.freeBytes == null then "The host\u0027s free disk space could not be read: previews are not being built."
                  else "The host is low on disk: previews are not being built." end)
               elif ($running | length) > 0 then "Working on \($running | map("#\(.issue)") | join(", "))."
               else "Idle, taking work." end),
      checks: {
        queue: (if $queue == null then null else {
          time: $queue.generatedAt,
          paused: ($queue.paused // false),
          inLine: ($queue.queued | length),
          building: ($queue.running | length),
          review: ($queue.awaiting | length),
          stopped: ($queue.stopped | length)
        } end),
        cycle: (($running[0] // $last) | if . == null then null else brief end),
        cycles: ($running | map(brief)),
        failures: $failures,
        disk: (if $disk == null then null else ($disk | {time, freeBytes, minFreeBytes, low}) end),
        slice: $slice
      }
    }' >"$tmp" 2>/dev/null || { rm -f "$tmp"; exit 1; }
mv "$tmp" "$live/health.json"

if [ "$(jq -r .status "$live/health.json")" = fail ]; then
  : >"$live/health.down"
else
  rm -f "$live/health.down"
fi
exit 0
