#!/usr/bin/env bash
# Write the factory's health file: $TEHAS_HOME/live/health.json, served by the
# docs server as /health (and /healthz). tehasbot status runs it on exit, at
# every poll and at the end of every cycle.
#
# The whole run is the console's: `console health run <home>`
# (console/src/health.rs), which makes the store's calls, the units read and
# the publish of the report itself. The budget of the idle polls is read from
# TEHAS_POLL_BUDGET here and given to the console as an argument, so the
# console names no setting of the host: the value is the instance's, and the
# load is the one place its shape is checked - a leading 0 or another order
# would take the warning out of the health file in silence.
#
# Usage: tehasbot health (prints nothing). Exit: 0 the file was written; 1 it
# could not be written or the store did not answer; 78 the settings are
# malformed, no console stands beside this command, or the store is not
# installed or cannot be used, which writes nothing. An ERROR: line says which.
set -uo pipefail

: "${TEHAS_HOME:=$HOME/tehas}"
# The console is named before the settings are loaded: tehas_load clears the
# TEHAS_* of the host from a command, and TEHAS_CONSOLE is not a setting, as
# lib/limit.sh has always found.
here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
console=${TEHAS_CONSOLE:-$here/console}

# shellcheck source=lib/config.sh
. "$here/../lib/config.sh"
tehas_load || exit 78
[ -x "$console" ] || { echo "tehasbot health: no console at $console: run install.sh" >&2; exit 78; }
exec "$console" health run "$TEHAS_HOME" --budget "${TEHAS_POLL_BUDGET:-cpu=5,wall=30,writes=0}"
