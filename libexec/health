#!/usr/bin/env bash
# Write the factory's health file: $TEHAS_HOME/live/health.json, served by the
# docs server as /health (and /healthz).
#
# It reads what the factory already writes under live/: status.json (the queue
# snapshot from tehasbot status), running.json (the running cycles and the last
# one, from tehas work), dispatch.json (what holds cycles back and the slice's
# numbers, from the last poll of tehas dispatch), demand.json (how many issues
# wait for room, from the same poll), this host's pause flag,
# $TEHAS_HOME/state/pause.json, so that a host paused while GitHub did not answer
# still reports itself paused, and the planning turns in flight: a record
# $TEHAS_HOME/state/plan-<issue>.json marked running whose lock the turn's unit
# holds. No network, no model, no systemctl and no docker.
# tehasbot status runs it on exit, so it is refreshed at every poll and at the
# end of every cycle.
#
# The file follows the health check response format (draft-inadarei-api-health-check):
#   status "pass"  the factory is taking work
#   status "warn"  the queue snapshot is older than ten minutes (GitHub did
#                  not answer the last polls), or it is paused (the pause flag
#                  tehas pause writes on this host, or tehas:pause on the control
#                  issue), or the dispatcher holds everything because tehas.slice is missing
#                  or cannot be read, or there are no resources (the model
#                  endpoint does not answer or does not offer the model, as
#                  the last poll found), or the host is too low on disk to build
#                  previews, or its free space could not be read
#                  (live/previews.json, from tehasbot preview), or the
#                  platform checkout has lacked a commit of origin's default
#                  branch for more than a day (live/platform.json, from
#                  tehasbot status)
#   status "fail"  the last cycle ended as anything but merged or handoff and
#                  no cycle has started since, or there is no queue snapshot yet
# On "fail" it also creates live/health.down, which makes the docs server answer
# 503 with the same body; otherwise it removes that file.
#
# A stopped dispatcher cannot report itself: the file just stops changing. A
# monitor should treat a "time" older than about ten minutes as down.
#
# Usage: tehasbot health        (prints nothing; exit 0 unless the file cannot be written)
set -uo pipefail

: "${TEHAS_HOME:=$HOME/tehas}"
live=$TEHAS_HOME/live
mkdir -p "$live"
here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source=lib/live.sh
. "$here/../lib/live.sh"
# shellcheck source=lib/status.sh
. "$here/../lib/status.sh"
# shellcheck source=lib/limit.sh
. "$here/../lib/limit.sh"
# A cycle that died without a word stops being shown as running here.
tehas_live_assemble 2>/dev/null || true

status_file=$live/status.json
running_file=$live/running.json
queue=null
view=null
[ -s "$status_file" ] && queue=$(jq -c . "$status_file" 2>/dev/null || echo null)
[ -s "$running_file" ] && view=$(jq -c . "$running_file" 2>/dev/null || echo null)
# The last ten endings, which lib/live.sh keeps. The status is still decided
# by the last one alone: one aborted cycle beside three working ones is a
# failure until a cycle starts after it. checks.failed lists the failed ones
# of the ten, so a failure a later success overtook is still there for a
# monitor that polls less often than cycles end.
endings=$(jq -c 'if type == "array" then . else [] end' "$live/endings.json" 2>/dev/null) || endings='[]'
[ -n "$endings" ] || endings='[]'

# The free space of the host, as tehasbot preview measured it. A host without
# previews has no such file, and a figure that is no longer written is not
# believed after half an hour.
previews_file=$live/previews.json
disk=null
[ -s "$previews_file" ] && disk=$(jq -c '
  select((.disk | type) == "object" and (now - (.generatedAt | fromdateiso8601)) < 1800)
  | .disk + {time: .generatedAt}' "$previews_file" 2>/dev/null)
[ -n "$disk" ] || disk=null

# The platform checkout against origin, as tehasbot status last read it.
platform=null
[ -s "$live/platform.json" ] && platform=$(jq -c 'select(type == "object" and (.behind | type) == "number")' "$live/platform.json" 2>/dev/null)
[ -n "$platform" ] || platform=null

# What the last poll said about the slice. The poll before this one wrote it,
# or this one when a cycle or a planning turn was started. A file older than
# ten minutes is from a dispatcher that no longer gets that far. It is read
# whole or not at all, so a file that is not one object cannot break the write.
dispatch_file=$live/dispatch.json
slice=null
[ -s "$dispatch_file" ] && slice=$(jq -cs '
  select(length == 1) | .[0]
  | select(type == "object" and (.why | type) == "string" and (now - (.time | fromdateiso8601)) < 600)
  | {time, why, hold, count, room, committed, max, reserve} + ({free, awaitRoom, limitRoom} | with_entries(select(.value != null)))' "$dispatch_file" 2>/dev/null)
[ -n "$slice" ] || slice=null

# How many issues wait for room, and since when the oldest, as the last poll
# counted them (live/demand.json, from tehas dispatch). Every poll writes it,
# a paused one too, so a file older than ten minutes is from a dispatcher that
# no longer polls.
demand=null
[ -s "$live/demand.json" ] && demand=$(jq -cs '
  select(length == 1) | .[0]
  | select(type == "object" and (.waiting | type) == "number" and (now - (.time | fromdateiso8601)) < 600)
  | {time, waiting} + (if (.oldest | type) == "string" then {oldest} else {} end)
    + (if (.refreshHold | type) == "string" then {refreshHold: (.refreshHold | .[0:300])} else {} end)' "$live/demand.json" 2>/dev/null)
[ -n "$demand" ] || demand=null

# The limit tehas limit sets, read here as the dispatcher reads it.
limit=$(tehas_limit_read)

# The planning turns in flight, each {issue, turn, startedAt}. A turn holds
# its lock while it runs (lib/planning.sh); one that left its exit status has
# ended and waits for the next poll to post it.
plans='[]'
for st in "$TEHAS_HOME"/state/plan-*.json; do
  [ -f "$st" ] && [ -f "$st.lock" ] && [ ! -e "$st.rc" ] || continue
  ! flock -n "$st.lock" true 2>/dev/null || continue
  n=${st##*/plan-}
  n=${n%.json}
  case "$n" in '' | *[!0-9]*) continue ;; esac
  turn=$(jq -c --argjson n "$n" 'select(type == "object" and .running == true)
    | {issue: $n, turn: ((if (.turns | type) == "number" then .turns else 0 end) + 1),
       startedAt: (if (.startedAt | type) == "string" then .startedAt else null end)}' "$st" 2>/dev/null) || continue
  [ -z "$turn" ] || plans=$(jq -c --argjson t "$turn" '. + [$t]' <<<"$plans")
done

# tehasbot status keeps the old snapshot when GitHub does not answer. Older
# than this, its counts and its pause are not news.
queue_max_age=600

# The two pause switches. The flag is this host's own file, read here as well as
# in the snapshot, so a host paused while GitHub did not answer still reports
# itself paused. The label comes from the snapshot, which is the only place this
# in the snapshot, and so does `lifted`: the label is off but a pause a stranger
# lifted still holds this host. `label` and `lifted` mean the same here as in the
# snapshot: the label is on the issue, and the label is off with no allowed
# account having taken it off. `by` is not carried: the health file is served.
pause_flag=$(tehas_pause_read "$TEHAS_HOME/state/pause.json")
case $? in
  0) pause_flag=$(jq -c '{at, reason}' <<<"$pause_flag") ;;
  1) pause_flag=null ;;
  2) pause_flag='{"at":null,"reason":null}' ;;
esac
label_paused=$(jq -rc 'if (.pause.label | type) == "boolean" then .pause.label
  elif (.paused | type) == "boolean" then .paused else false end' <<<"$queue" 2>/dev/null) || label_paused=false
lifted=$(jq -rc 'if (.pause.lifted | type) == "boolean" then .pause.lifted else false end' <<<"$queue" 2>/dev/null) || lifted=false
pause=$(jq -nc --argjson flag "$pause_flag" --argjson label "$label_paused" --argjson lifted "$lifted" \
  '{flag: $flag, label: $label, lifted: $lifted}')

jq -n --argjson queue "$queue" --argjson view "$view" --argjson disk "$disk" --argjson slice "$slice" --argjson demand "$demand" --argjson limit "$limit" --argjson plans "$plans" --arg now "$(date -u +%FT%TZ)" \
  --argjson queueMaxAge "$queue_max_age" --argjson endings "$endings" --argjson platform "$platform" --argjson pause "$pause" '
  def iso: if type == "number" then todate else null end;
  def ago: if . < 120 then "\(.) s" elif . < 7200 then "\(. / 60 | floor) min" else "\(. / 3600 | floor) h" end;
  def brief: {
    issue, running: (.running // false), status, step,
    startedAt: (.startedAt | iso), time: (.updatedAt | iso)
  };
  # The view tehas work writes, or the one object an earlier version wrote.
  (if ($view | type) != "object" then {cycles: [], last: null}
   elif ($view | has("cycles")) then $view
   elif $view.running == true then {cycles: [$view], last: null}
   else {cycles: [], last: $view} end) as $v
  | ($v.cycles // []) as $running
  | $v.last as $last
  | ($last != null and (($last.status // "") | IN("merged", "handoff") | not)
     and ($running | map(select((.startedAt // 0) >= ($last.updatedAt // 0))) | length) == 0) as $failed
  # Nothing starts on a slice that is missing or cannot be read. The other
  # holds pass by themselves.
  | ($slice != null and ($slice.why | IN("slice", "unreadable"))) as $no_slice
  | ($slice != null and $slice.why == "resources") as $no_resources
  # A fix merged for the factory runs only after tehas update. A day behind
  # is long enough to be news and short enough to matter.
  | ($platform != null and $platform.behind > 0
     and (($now | fromdateiso8601) - ($platform.behindSince | try fromdateiso8601 catch 0)) > 86400) as $behind
  # A time that cannot be read counts as old.
  | (if $queue == null then null
     else ($now | fromdateiso8601) - ($queue.generatedAt | try fromdateiso8601 catch 0) end) as $queue_age
  | ($queue_age != null and $queue_age > $queueMaxAge) as $old_queue
  | ($pause.flag != null or $pause.label == true or $pause.lifted == true) as $paused
  # A limit that expired or cannot be read holds every start.
  | ($limit.state | IN("expired", "unreadable")) as $limit_holds
  | (if $queue == null then "fail"
     elif $failed then "fail"
     elif $old_queue then "warn"
     elif $paused then "warn"
     elif $limit_holds then "warn"
     elif $no_slice then "warn"
     elif $no_resources then "warn"
     elif $disk != null and $disk.low then "warn"
     elif $behind then "warn"
     else "pass" end) as $status
  | {
      status: $status,
      time: $now,
      output: (if $queue == null then "No queue snapshot yet: the dispatcher has not written one."
               elif $failed then "The last cycle failed: #\($last.issue) ended as \($last.status)."
               elif $old_queue then
                 "The queue snapshot is \($queue_age | ago) old: GitHub did not answer the last polls."
               elif $paused then "The factory is paused."
               elif $limit_holds then
                 (if $limit.state == "expired" then "Nothing starts: the limit expired at \($limit.until). Set it again or clear it (tehas limit)."
                  else "Nothing starts: the limit cannot be read. Set it again or clear it (tehas limit)." end)
               elif $no_slice then ($slice.hold // "holding")
               elif $no_resources then (($slice.hold // "") | sub("^holding: no resources: "; "No resources: ") + ".")
               elif $disk != null and $disk.low then
                 (if $disk.freeBytes == null then "The host\u0027s free disk space could not be read: previews are not being built."
                  else "The host is low on disk: previews are not being built." end)
               elif $behind then
                 "The platform is \($platform.behind) commits behind \($platform.upstream) since \($platform.behindSince // "" | .[:10]): run tehas update."
               elif ($running | length) > 0 then "Working on \($running | map("#\(.issue)") | join(", "))."
               else "Idle, taking work." end),
      checks: {
        queue: (if $queue == null then null else {
          time: $queue.generatedAt,
          paused: $paused,
          inLine: ($queue.queued | length),
          building: ($queue.running | length),
          review: ($queue.awaiting | length),
          stopped: ($queue.stopped | length)
        } end),
        cycle: (($running[0] // $last) | if . == null then null else brief end),
        cycles: ($running | map(brief)),
        plans: $plans,
        failed: ($endings + (if $last == null then [] else [$last] end)
                 | map(objects | select((.status // "") | IN("merged", "handoff") | not))
                 | unique_by([.issue, .startedAt]) | sort_by(.updatedAt) | reverse
                 | map({issue, status, step, startedAt: (.startedAt | iso), time: (.updatedAt | iso)})),
        disk: (if $disk == null then null else ($disk | {time, freeBytes, minFreeBytes, low}) end),
        slice: $slice,
        demand: $demand,
        limit: $limit,
        # tehas:all-hands, from a snapshot young enough to be news; null when
        # it is not, or the snapshot could not read it.
        allHands: (if $queue == null or $old_queue then null else $queue.allHands end),
        pause: $pause,
        platform: $platform
      }
    }' >"$live/health.json.new" 2>/dev/null || exit 1
mv "$live/health.json.new" "$live/health.json"

if [ "$(jq -r .status "$live/health.json")" = fail ]; then
  : >"$live/health.down"
else
  rm -f "$live/health.down"
fi
exit 0
