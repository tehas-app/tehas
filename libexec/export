#!/usr/bin/env bash
# tehas export: copy what a person reading a cycle needs into a directory,
# masked, and change nothing in the factory.
#
# For every cycle tehas history would list, this writes <dir>/<cursor>/ with
# the cycle's result, its logs, its agents' transcripts and its Protolab page:
#
#   result.json        state/cycles/<issue>.result.json and .progress.json, as
#                      the cycle left them
#   history.json       the cycle's own line of history, as tehas history
#                      publishes it, so the copy says what the factory said
#   logs/              the runner's progress and its error and console streams,
#                      and the dispatcher's log of the cycle
#   transcripts/       the agents' transcripts of that cycle, under the name the
#                      console found them by
#   protolab/          the ticket's page and its files, when the ticket has one
#   plan.json          the planning session on the state store, for a kind:
#                      plan line, as plan-show gives it
#
# The copying is the console's (console export run, console/src/export.rs).
# Every file goes through its mask, with the same names of the host it is given
# when a cycle runs (the host aliases, the model hosts, the bot's email): a
# token, a key, a password or a private address that reached a log does not
# reach the copy. Only a file of a Protolab page that is not UTF-8 is copied as
# it is: an image or a video holds nothing to hide and a mask would only corrupt
# it. A log is masked whatever bytes it holds. The mask catches accidents; it
# cannot stop what no pattern knows, so an export is still a copy of what a
# cycle wrote.
#
# A cycle with no logs, no transcripts or no Protolab page is not an error:
# those directories are simply not there. The improvement loop removes logs
# after seven days, and a planning turn has no result file at all.
#
# Usage: tehas export [--json] --after CURSOR <dir>
#
#   --after CURSOR   required: the cursor tehas history printed as "next". The
#                    command writes what it copied, so a program that keeps the
#                    cursor it is given and calls again copies each cycle once
#   --json           the object on standard output; without it, one line per
#                    cycle and one for the directory
#   <dir>            where to put them, required, and not the factory's home or
#                    a link to it: an export is for somewhere else. It is made
#                    if it is not there, readable by anyone, so the person who
#                    reads the archive can be someone else. Its name may not be
#                    "." or ".."
#
# With --json, the object tehas history prints for what was copied, so the
# cursor to keep is the "next" of the object:
#
#   {"api": 1, "cycles": [...], "next": "1760700300-7-42", "to": "/home/boss/archive"}
#
# Exit: 0 copied, also when there was nothing to copy; 1 the state store did
# not answer (busy) for the history, which copies nothing, or a cycle could not
# be written, a planning turn whose session the store did not give among them,
# which the others are copied without; 64 a bad argument,
# an export into the factory's own home or a directory that cannot be made,
# which copies nothing; 78 the instance settings are missing or malformed, or
# the state store is not installed or cannot be used, which copies nothing.
set -uo pipefail

usage() {
  echo "usage: tehas export [--json] --after CURSOR <dir>" >&2
  exit 64
}

json=0 after="" dir=""
while [ "$#" -gt 0 ]; do
  case "$1" in
    --json)
      [ "$json" = 0 ] || usage
      json=1
      shift
      ;;
    --after)
      [ -z "$after" ] || usage
      [ "$#" -ge 2 ] || usage
      [[ $2 =~ ^[0-9]{1,25}-[1-9][0-9]{0,8}(-[1-9][0-9]*)?$ ]] || usage
      after=$2
      shift 2
      ;;
    -*)
      usage
      ;;
    *)
      [ -z "$dir" ] || usage
      case "$1" in . | .. | */. | */.. | ./* | ../*) usage ;; esac
      dir=$1
      shift
      ;;
  esac
done
[ -n "$after" ] || usage
[ -n "$dir" ] || usage

here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source=lib/config.sh
. "$here/../lib/config.sh"
# shellcheck source=lib/store.sh
. "$here/../lib/store.sh"
tehas_load || exit 78
# The cycles to copy are the history's, on the state store.
if ! tehas_store_ready; then
  echo "tehas export: ERROR: the state store is not installed (run install.sh)" >&2
  exit 78
fi

# Never an export into the factory's own home: it would put copies of logs
# where the dashboard and the units look for the originals. $TEHAS_HOME is what
# the settings name, so where it leads is settled before the directory is made,
# and both the name the caller wrote and the place it comes to are compared.
# Without the real paths a link made by hand would carry the copies into the
# home, or take what the home holds out of it.
home=$(cd "$TEHAS_HOME" 2>/dev/null && pwd -P) || home=$TEHAS_HOME
for candidate in "$dir" "$dir/cycles"; do
  case "$candidate" in
    "$TEHAS_HOME" | "$TEHAS_HOME"/*)
      echo "tehas export: $dir is in the factory's home ($TEHAS_HOME), choose another directory" >&2
      exit 64
      ;;
  esac
done

# The console copies and masks, and it is installed beside these scripts. A
# checkout has no console built, so a `console' on the PATH is taken too.
# Without either nothing is exported: an unmasked log would carry the bot's
# token into an archive.
console=$here/console
[ -x "$console" ] || console=$(command -v console 2>/dev/null) || console=""
if [ -z "$console" ] || [ ! -x "$console" ]; then
  echo "tehas export: no console to mask with; run install.sh" >&2
  exit 1
fi
if ! mkdir -p "$dir"; then
  echo "tehas export: could not make $dir" >&2
  exit 64
fi
abs=$(cd "$dir" && pwd) || {
  echo "tehas export: $dir is not a directory" >&2
  exit 64
}
# The directory the caller named, or what a link of theirs led to: an export is
# never the factory's home, read by its real path as well as by its name.
case "$(cd "$dir" && pwd -P)" in
  "$home" | "$home"/*)
    echo "tehas export: $dir is in the factory's home ($TEHAS_HOME), choose another directory" >&2
    exit 64
    ;;
esac

# The lines to copy, as tehas history prints them. Its exit status is this
# command's: a factory whose settings are wrong is not half-exported.
listing=$("$console" tehas history --json --after "$after") || exit $?
[ -n "$(jq -r '.cycles | length' <<<"$listing" 2>/dev/null)" ] || {
  echo "tehas export: tehas history gave no object" >&2
  exit 1
}

# What the console masks by name when a cycle runs: the host aliases, the model
# hosts and the bot's email. They are names, not secrets, so they may go on a
# command line; a token never does. A name under 4 characters would mask
# ordinary text. Without them the mask still catches every token-shaped string,
# and the copy would carry the host's own names as plainly as the logs do.
private=()
add_private() { if [ "${#1}" -ge 4 ]; then private+=(--private "$1"); fi; }
IFS=',' read -ra pairs <<<"${PI_ENSEMBLE_HOST_ALIASES:-}"
for pair in "${pairs[@]}"; do
  add_private "${pair%%:*}"
  [ "${pair#*:}" = "$pair" ] || add_private "${pair#*:}"
done
while read -r model_host; do
  model_host=${model_host#*://}
  model_host=${model_host%%/*}
  model_host=${model_host##*@}
  case "$model_host" in
    \[*) model_host=${model_host#[}; model_host=${model_host%%]*} ;;
    *) model_host=${model_host%%:*} ;;
  esac
  add_private "$model_host"
done < <(tehas_models | while read -r model_provider _; do
  jq -r --arg p "$model_provider" '.providers[$p] | .baseUrl, .backupBaseUrl | strings' "$HOME/.pi/agent/models.json" 2>/dev/null
done)
add_private "$(git config --global user.email 2>/dev/null || true)"
# The console makes cycles/ and every directory below it 0755 and every file
# 0644, whatever the umask: an archive is for somebody else to open.
jq -c '.cycles[]' <<<"$listing" |
  "$console" export run "$TEHAS_HOME" "$HOME/.pi/agent/ensemble-runs" "$abs" \
    "$(jq -r '.next // ""' <<<"$listing")" "$((1 - json))" "${private[@]}"
rc=${PIPESTATUS[1]}
[ "$json" = 0 ] || jq -c --arg to "$abs" '. + {to: $to}' <<<"$listing"
# A cycle that could not be written is said on standard error.
[ "$rc" = 0 ]
