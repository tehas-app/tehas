#!/usr/bin/env bash
# tehas export: copy what a person reading a cycle needs into a directory,
# masked, and change nothing in the factory.
#
# For every cycle tehas history would list, this writes <dir>/<cursor>/ with
# the cycle's result, its logs, its agents' transcripts and its Protolab page:
#
#   result.json        state/cycles/<issue>.result.json and .progress.json, as
#                      the cycle left them
#   history.json       the cycle's own line of history, as tehas history
#                      publishes it, so the copy says what the factory said
#   logs/              the runner's progress and its error and console streams,
#                      and the dispatcher's log of the cycle
#   transcripts/       the agents' transcripts of that cycle, under the name the
#                      console found them by
#   protolab/          the ticket's page and its files, when the ticket has one
#   plan.json          the planning session on the state store, for a kind:
#                      plan line, as plan-show gives it
#
# Every text file goes through the console's mask, the one masker tehas has
# (console --mask), with the same names of the host it is given when a cycle
# runs (the host aliases, the model hosts, the bot's email): a token, a key, a
# password or a private address that reached a log does not reach the copy. Only
# a file the mask itself will not read is copied as it is, because a mask would
# only corrupt it and what a cycle was given as an image or a video holds nothing
# to hide; a log with one stray NUL in it is a file the mask reads, so it is
# masked and not archived raw. The mask
# catches accidents; it cannot stop what no pattern knows, so an export is still
# a copy of what a cycle wrote.
#
# A cycle with no logs, no transcripts or no Protolab page is not an error:
# those directories are simply not there. The improvement loop removes logs
# after seven days, and a planning turn has no result file at all.
#
# Usage: tehas export [--json] --after CURSOR <dir>
#
#   --after CURSOR   required: the cursor tehas history printed as "next". The
#                    command writes what it copied, so a program that keeps the
#                    cursor it is given and calls again copies each cycle once
#   --json           the object on standard output; without it, one line per
#                    cycle and one for the directory
#   <dir>            where to put them, required, and not the factory's home or
#                    a link to it: an export is for somewhere else. It is made
#                    if it is not there, readable by anyone, so the person who
#                    reads the archive can be someone else. Its name may not be
#                    "." or ".."
#
# With --json, the object tehas history prints for what was copied, so the
# cursor to keep is the "next" of the object:
#
#   {"api": 1, "cycles": [...], "next": "1760700300-7", "to": "/home/boss/archive"}
#
# Exit: 0 copied, also when there was nothing to copy; 1 the state store did
# not answer (busy) for the history, which copies nothing, or a cycle could not
# be written, a planning turn whose session the store did not give among them,
# which the others are copied without; 64 a bad argument,
# an export into the factory's own home or a directory that cannot be made,
# which copies nothing; 78 the instance settings are missing or malformed, or
# the state store is not installed or cannot be used, which copies nothing.
set -uo pipefail

usage() {
  echo "usage: tehas export [--json] --after CURSOR <dir>" >&2
  exit 64
}

json=0 after="" dir=""
while [ "$#" -gt 0 ]; do
  case "$1" in
    --json)
      [ "$json" = 0 ] || usage
      json=1
      shift
      ;;
    --after)
      [ -z "$after" ] || usage
      [ "$#" -ge 2 ] || usage
      [[ $2 =~ ^[0-9]{1,25}-[1-9][0-9]{0,8}$ ]] || usage
      after=$2
      shift 2
      ;;
    -*)
      usage
      ;;
    *)
      [ -z "$dir" ] || usage
      case "$1" in . | .. | */. | */.. | ./* | ../*) usage ;; esac
      dir=$1
      shift
      ;;
  esac
done
[ -n "$after" ] || usage
[ -n "$dir" ] || usage

here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source=lib/config.sh
. "$here/../lib/config.sh"
# shellcheck source=lib/store.sh
. "$here/../lib/store.sh"
tehas_load || exit 78
# The cycles to copy are the history's, on the state store.
if ! tehas_store_ready; then
  echo "tehas export: ERROR: the state store is not installed (run install.sh)" >&2
  exit 78
fi

# Never an export into the factory's own home: it would put copies of logs
# where the dashboard and the units look for the originals. $TEHAS_HOME is what
# the settings name, so where it leads is settled before the directory is made,
# and both the name the caller wrote and the place it comes to are compared.
# Without the real paths a link made by hand would carry the copies into the
# home, or take what the home holds out of it.
home=$(cd "$TEHAS_HOME" 2>/dev/null && pwd -P) || home=$TEHAS_HOME
for candidate in "$dir" "$dir/cycles"; do
  case "$candidate" in
    "$TEHAS_HOME" | "$TEHAS_HOME"/*)
      echo "tehas export: $dir is in the factory's home ($TEHAS_HOME), choose another directory" >&2
      exit 64
      ;;
  esac
done

# The console is the one masker, and it is installed beside these scripts. A
# checkout has no console built, so a `console' on the PATH is taken too.
# Without either nothing is exported: an unmasked log would carry the bot's
# token into an archive.
masker=$here/console
[ -x "$masker" ] || masker=$(command -v console 2>/dev/null) || masker=""
if [ -z "$masker" ] || [ ! -x "$masker" ]; then
  echo "tehas export: no console to mask with; run install.sh" >&2
  exit 1
fi
if ! mkdir -p "$dir"; then
  echo "tehas export: could not make $dir" >&2
  exit 64
fi
abs=$(cd "$dir" && pwd) || {
  echo "tehas export: $dir is not a directory" >&2
  exit 64
}
# The directory the caller named, or what a link of theirs led to: an export is
# never the factory's home, read by its real path as well as by its name.
case "$(cd "$dir" && pwd -P)" in
  "$home" | "$home"/*)
    echo "tehas export: $dir is in the factory's home ($TEHAS_HOME), choose another directory" >&2
    exit 64
    ;;
esac

# Readable by anyone, whatever the umask of the shell that ran the command: an
# archive is for somebody else to open, and a copy made at 0777 or 0700 reads
# as a mistake either way.
make_dir() {
  local d
  for d in "$@"; do
    mkdir -p "$d" || return 1
    chmod 755 "$d" 2>/dev/null || true
  done
}
make_dir "$abs" "$abs/cycles" || {
  echo "tehas export: could not make $abs/cycles" >&2
  exit 1
}

# The lines to copy, as tehas history prints them. Its exit status is this
# command's: a factory whose settings are wrong is not half-exported.
listing=$("$here/history" --json --after "$after") || exit $?
[ -n "$(jq -r '.cycles | length' <<<"$listing" 2>/dev/null)" ] || {
  echo "tehas export: tehas history gave no object" >&2
  exit 1
}

# What the console masks by name when a cycle runs: the host aliases, the model
# hosts and the bot's email. They are names, not secrets, so they may go on a
# command line; a token never does. A name under 4 characters would mask
# ordinary text. Without them the mask still catches every token-shaped string,
# and the copy would carry the host's own names as plainly as the logs do.
private=()
add_private() { if [ "${#1}" -ge 4 ]; then private+=(--private "$1"); fi; }
IFS=',' read -ra pairs <<<"${PI_ENSEMBLE_HOST_ALIASES:-}"
for pair in "${pairs[@]}"; do
  add_private "${pair%%:*}"
  [ "${pair#*:}" = "$pair" ] || add_private "${pair#*:}"
done
while read -r model_host; do
  model_host=${model_host#*://}
  model_host=${model_host%%/*}
  model_host=${model_host##*@}
  case "$model_host" in
    \[*) model_host=${model_host#[}; model_host=${model_host%%]*} ;;
    *) model_host=${model_host%%:*} ;;
  esac
  add_private "$model_host"
done < <(tehas_models | while read -r model_provider _; do
  jq -r --arg p "$model_provider" '.providers[$p] | .baseUrl, .backupBaseUrl | strings' "$HOME/.pi/agent/models.json" 2>/dev/null
done)
add_private "$(git config --global user.email 2>/dev/null || true)"
# The name a planning turn's session is exported under.
plan_copy=plan.json

cycles=$abs/cycles

# copy_in <from> <to dir> <name>: one file, masked unless the mask itself will
# not read it. A file that is not there is no error, and a file over 32 MiB is
# left out: an export is for reading, not for whatever a cycle happened to write.
#
# The size is asked first, before anything of the file is read, so an oversized
# log costs a stat and nothing else. The bytes are then read once and kept: a
# second read of what standard input has already given up is empty, so the mask
# cannot be asked twice. Whatever the mask makes of the file is kept as it is
# written; a mask that will not read what it was given has nothing to say, so an
# empty result of a file that is not empty is its own word for bytes it would only
# corrupt, and those bytes go into the archive as they came. A log with one stray
# NUL in it has printable bytes, so the mask speaks of it and the log is masked
# like any other file.
copy_in() {
  local from=$1 to=$2 name=$3 size masked
  [ -f "$from" ] && [ ! -L "$from" ] || return 0
  size=$(stat -c %s "$from" 2>/dev/null) || return 0
  [[ $size =~ ^[0-9]+$ ]] || return 0
  [ "$size" -le 33554432 ] || return 0
  make_dir "$to" || return 1
  masked=$to/.tehas-masked.$$
  rm -f "$masked"
  if ! "$masker" --mask "${private[@]}" <"$from" >"$masked" 2>/dev/null; then
    rm -f "$masked"
    return 1
  fi
  if [ "$size" != 0 ] && [ ! -s "$masked" ]; then
    cp -p -- "$from" "$to/$name" || { rm -f "$masked"; return 1; }
  else
    mv "$masked" "$to/$name" || { rm -f "$masked"; return 1; }
  fi
  chmod 644 "$to/$name" 2>/dev/null || true
}

copied=0
failed=""
while IFS= read -r line; do
  cursor=$(jq -r .cursor <<<"$line")
  issue=$(jq -r .issue <<<"$line")
  kind=$(jq -r .kind <<<"$line")
  # The cursor is this command's own making and holds only digits and a dash.
  [[ $cursor =~ ^[0-9]+-[1-9][0-9]*$ ]] || { failed="$failed <unreadable>"; continue; }
  out=$cycles/$cursor
  # An old copy of this cycle is replaced whole, so a line that has since lost
  # a field cannot leave its value behind in the archive.
  rm -rf "$out" || { failed="$failed $cursor"; continue; }
  make_dir "$out" || { failed="$failed $cursor"; continue; }
  printf '%s\n' "$line" >"$out/history.json" || { failed="$failed $cursor"; continue; }
  chmod 644 "$out/history.json" 2>/dev/null || true

  if [ "$kind" = plan ]; then
    # The session as the store has it: an ended one stays until the next
    # tehas:plan of the issue replaces it, so a turn that never came into being
    # still brings the session it names. A session replaced since has no more
    # than its line of history: the store keeps one session an issue, so one
    # opened after the turn ended is another's. One the store could not read is
    # a cycle not written.
    if ! tehas_store plan-show "$issue"; then
      [ "$tehas_store_rc" = 1 ] || echo "tehas export: ERROR: the state store cannot be used: $tehas_store_line" >&2
      failed="$failed $cursor"
      continue
    fi
    ended=$(jq -r '.ended | fromdateiso8601' <<<"$line" 2>/dev/null) || ended=""
    [[ $ended =~ ^[0-9]+$ ]] || ended=0
    if [ "$(tehas_store_get ".planning | select(type == \"object\" and (.opened_at | type) == \"number\"
        and .opened_at <= $ended) | type")" = object ]; then
      session_file=$(mktemp "$out/.tehas-plan.XXXXXX") || { failed="$failed $cursor"; continue; }
      tehas_store_get '.planning' >"$session_file"
      copy_in "$session_file" "$out" "$plan_copy" || failed="$failed $cursor"
      rm -f "$session_file"
    fi
  else
    copy_in "$TEHAS_HOME/state/cycles/$issue.result.json" "$out/logs" result.json
    copy_in "$TEHAS_HOME/state/cycles/$issue.progress.json" "$out/logs" progress.json
    copy_in "$TEHAS_HOME/state/cycles/$issue.manifest.json" "$out/logs" manifest.json
    copy_in "$TEHAS_HOME/logs/dispatch-work-$issue.log" "$out/logs" dispatch-work.log
    # The runner's progress and its side streams, of this issue, whatever stamp
    # each carries: a cycle that was started twice has more than one and the
    # archive keeps them all. The loop's own copies of them, under tmp/, are
    # not taken: they are copies of what is here.
    for f in "$TEHAS_HOME/logs/work-$issue"-*.jsonl "$TEHAS_HOME/logs/work-$issue"-*.jsonl.err \
      "$TEHAS_HOME/logs/work-$issue"-*.jsonl.console "$TEHAS_HOME/logs/work-$issue"-*.jsonl.preflight; do
      [ -f "$f" ] && [ ! -L "$f" ] || continue
      copy_in "$f" "$out/logs" "${f##*/}"
    done
    for f in "$HOME/.pi/agent/ensemble-runs/issue-$issue"/*; do
      [ -f "$f" ] && [ ! -L "$f" ] || continue
      copy_in "$f" "$out/transcripts" "${f##*/}"
    done
  fi
  # The ticket's page and its files, when it has one. The directory is the
  # issue's number and holds no name a mask would miss.
  if [ -d "$TEHAS_HOME/protolab/$issue" ] && [ ! -L "$TEHAS_HOME/protolab/$issue" ]; then
    while IFS= read -r f; do
      copy_in "$f" "$out/protolab/$(dirname "${f#"$TEHAS_HOME/protolab/$issue/"}")" "${f##*/}"
    done < <(find "$TEHAS_HOME/protolab/$issue" -type f ! -name .stamp 2>/dev/null)
  fi
  copied=$((copied + 1))
done < <(jq -c '.cycles[]' <<<"$listing")

if [ -n "$failed" ]; then
  echo "tehas export: could not write$failed" >&2
fi

if [ "$json" = 1 ]; then
  jq -c --arg to "$abs" '. + {to: $to}' <<<"$listing"
else
  while IFS= read -r line; do
    printf '%s  %s  #%s\n' "$(jq -r .cursor <<<"$line")" "$(jq -r .kind <<<"$line")" "$(jq -r .issue <<<"$line")"
  done < <(jq -c '.cycles[]' <<<"$listing")
  printf 'exported  %s cycles to %s (next: %s)\n' "$copied" "$abs" "$(jq -r '.next // "none"' <<<"$listing")"
fi
# A cycle that could not be written is said above and is not claimed below.
[ -z "$failed" ]
