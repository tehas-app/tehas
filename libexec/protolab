#!/usr/bin/env bash
# Build the Protolab: a page for every ticket at the prototype stage, with the
# files attached to the ticket beside it. The console does it, see
# console/src/protolab.rs. This keeps the settings and the app's token, which
# are bash. A checkout has no console built, so a `console' on the PATH is taken
# too, as tehas export does.
#
# Usage: tehasbot protolab     (one line per ticket built or removed; exit 0 even
#                            when GitHub is down, what is there is then left in
#                            place; exit 78 when the instance settings are
#                            invalid; exit 1 when it cannot write)
set -uo pipefail
umask 022

here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source=lib/config.sh
. "$here/../lib/config.sh"
# shellcheck source=lib/github-app.sh
. "$here/../lib/github-app.sh"
tehas_load || exit 78
tehas_require TEHAS_REPO TEHAS_ALLOWED_LABELERS

console=$here/console
[ -x "$console" ] || console=$(command -v console 2>/dev/null) || console=""
if [ -z "$console" ] || [ ! -x "$console" ]; then
  echo "tehasbot protolab: no console to build the pages with; run install.sh" >&2
  exit 78
fi
tehas_github_env || { echo "tehasbot protolab: no GitHub token for the app" >&2; exit 1; }
exec "$console" protolab run
