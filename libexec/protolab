#!/usr/bin/env bash
# Build the Protolab: a page for every ticket at the prototype stage, with the
# files attached to the ticket beside it. Written to $TEHAS_HOME/protolab,
# which the edge router serves on port 8081 (edge/router.compose.yaml): by path,
# and with TEHAS_DOMAIN set, each ticket also under a name of its own,
# lab-<number>.<domain>.
#
# A ticket is at the prototype stage while it is open and carries
# tehas:prototype applied by an account the instance allows. Its page has the
# title, a link to the issue on GitHub and the attached files: images and videos
# shown as they are, HTML files shown in a frame, and the style sheets, scripts
# and data an HTML file refers to beside them. Everything is static. Nothing
# here runs a prototype.
#
#   which tickets   Open issues whose most recent tehas:prototype labelling is
#                   by an account in TEHAS_ALLOWED_LABELERS. One applied by
#                   anyone else, the bot included, counts as no label at all:
#                   the ticket gets no page, and a page it had is removed. The
#                   log names the issue and the account.
#   which files     Only links to GitHub's own attachment storage, in the issue
#                   text and its comments, written by an owner, member or
#                   collaborator of the repository. Nothing else is fetched.
#   which types     png jpg gif webp svg avif, mp4 webm mov, html htm, and
#                   css js mjs json txt. A zip is unpacked into a folder of
#                   its own by libexec/attach, which takes the same types and md;
#                   its files count against the same limits.
#   how much        10 megabytes a ticket, counted in the order the files were
#                   attached, and at most 40 files. What does not fit is left
#                   out and the page says so.
#   when it goes    The page and its files are removed when the ticket is
#                   closed, loses the label, or carries it from an account the
#                   instance does not allow. GitHub keeps the originals.
#
# Who applied a label is read by lib/labels.sh, the same reading the dispatcher
# uses for tehas:ready: authorisation is the account, not the label (AGENTS.md
# rule 5). Where the events of a ticket cannot be read at all, nothing is built
# and nothing is removed for that ticket; a page it had stays as it was. An
# instance that lists the bot's own login in TEHAS_ALLOWED_LABELERS is refused:
# an account in a cycle labels as the bot, so such a list would let an agent
# choose what this publishes. A pass that cannot read its own login ends there,
# with nothing built and nothing removed.
#
# A ticket whose issue has not changed since the last run is left alone, so a
# run with nothing new fetches no files: it makes one GitHub call for its own
# account, one for the list, and one for every ticket at the stage, its label
# events. Deterministic, no model.
#
# It also writes $TEHAS_HOME/live/protolab.json, the list the dashboard links
# from. TEHAS_PROTOLAB_URL in instance.env is the address people reach the
# Protolab at, when that is not port 8081 of the dashboard's own host.
#
# Usage: tehasbot protolab     (one line per ticket built or removed; exit 0 even
#                            when GitHub is down, what is there is then left in
#                            place; exit 78 when the instance settings are
#                            invalid; exit 1 when it cannot write)
set -uo pipefail
umask 022

here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source=lib/config.sh
. "$here/../lib/config.sh"
# shellcheck source=lib/edge.sh
. "$here/../lib/edge.sh"
# shellcheck source=lib/attachments.sh
. "$here/../lib/attachments.sh"
# shellcheck source=lib/labels.sh
. "$here/../lib/labels.sh"
# shellcheck source=lib/github-app.sh
. "$here/../lib/github-app.sh"
tehas_load || exit 78
tehas_require TEHAS_REPO TEHAS_ALLOWED_LABELERS
repo=$TEHAS_REPO
label=tehas:prototype
limit=$((10 * 1024 * 1024))
max_files=40
# With a domain every ticket has a name of its own and the list is elsewhere.
domain=${TEHAS_DOMAIN:-}
home=/
[ -z "$domain" ] || home=${TEHAS_PROTOLAB_URL}/
site=$TEHAS_HOME/protolab
live=$TEHAS_HOME/live
work=$site/.work
# A changed generator rebuilds every page.
gen="$(cat "${BASH_SOURCE[0]}" "$here/../lib/attachments.sh" "$here/../lib/labels.sh" | cksum | tr ' ' '-')-${domain:-path}"

mkdir -p "$site" "$live" || exit 1
edge_lock protolab || { echo "another tehasbot protolab is running"; exit 0; }
rm -rf "$work"
mkdir -p "$work" || exit 1
trap 'rm -rf "$work"' EXIT

tehas_github_env || { echo "tehasbot protolab: no GitHub token for the app" >&2; exit 1; }
token=${GH_TOKEN:-}
[ -n "$token" ] || token=$(gh auth token 2>/dev/null) || token=""

# --- The attachment links of one ticket --------------------------------------
# Input: $t the ticket, $c its comments. Only text by people of the repository
# counts; links by anyone else are counted, not fetched.
# shellcheck disable=SC2016  # a jq program: the variables are jq's
find_refs=$(tehas_attachment_links)'
  def uniq: reduce .[] as $x ([]; if any(.[]; . == $x) then . else . + [$x] end);
  def ours: IN("OWNER", "MEMBER", "COLLABORATOR");
  ([{who: $t.association, text: $t.body}]
    + [$c[0][] | {who: .author_association, text: (.body // "")}]) as $texts
  | {refs: ([$texts[] | select(.who | ours) | .text | links[]] | uniq),
     outside: ([$texts[] | select(.who | ours | not) | .text | links[]] | uniq | length)}'

# --- The pages ---------------------------------------------------------------
# One program for both: $mode "ticket" reads one ticket, "index" a list of them.
# Every value from GitHub goes through @html; file names are already reduced to
# letters, digits, dot, dash and underscore, and a slash for a file from a zip.
# shellcheck disable=SC2016  # a jq program: the variables are jq's
render='
  def h: tostring | @html;
  def home: $home | h;
  def door: if $domain == "" then "/\(.number)/" else "https://lab-\(.number).\($domain)/" end;
  def size: if . >= 1048576 then "\(((. / 104857.6) | round) / 10) MB"
            elif . >= 1024 then "\((. / 1024) | round) KB"
            else "\(.) B" end;
  def day: (try (fromdateiso8601 | strftime("%d %b %Y") | ascii_upcase) catch "-");
  def plural($one; $many): "\(.) \(if . == 1 then $one else $many end)";
  def issue: if (.url // "" | startswith("https://github.com/")) then .url else null end;
  # Ten blocks, one for each started tenth of the limit in use.
  def meter: ((.bytes * 10 / $limit) | ceil) as $on
    | "<span class=\"lab-meter\" aria-hidden=\"true\">"
      + ([range(10) | if . < $on then "<i class=\"on\"></i>" else "<i></i>" end] | join(""))
      + "</span>";

  def top($title; $menu):
    "<!doctype html>\n<html lang=\"en\">\n<head>\n"
    + "  <meta charset=\"utf-8\">\n"
    + "  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n"
    + "  <meta name=\"robots\" content=\"noindex, nofollow\">\n"
    + "  <title>\($title | h) - Protolab</title>\n"
    + "  <link rel=\"icon\" type=\"image/svg+xml\" href=\"/fun/favicon.svg\">\n"
    + "  <link rel=\"stylesheet\" href=\"/fun/theme.css\">\n"
    + "  <link rel=\"stylesheet\" href=\"/fun/game-view.css\">\n"
    + "  <link rel=\"stylesheet\" href=\"/fun/protolab.css\">\n"
    + "</head>\n<body id=\"top\">\n"
    + "  <a class=\"skip\" href=\"#page\">Skip to the page</a>\n"
    + "  <header class=\"topbar topbar-short\">\n"
    + "    <a class=\"brand\" href=\"\(home)\" aria-label=\"Protolab, every prototype\">\n"
    + "      <img src=\"/fun/factory.svg\" width=\"80\" height=\"50\" alt=\"\">\n"
    + "      <span>PROTOLAB</span>\n"
    + "    </a>\n"
    + "    <nav class=\"menu\" aria-label=\"Site\">\n"
    + "      <a href=\"\(home)\">ALL PROTOTYPES</a>\n" + $menu
    + "    </nav>\n"
    + "  </header>\n"
    + "  <main class=\"lab-stage\" id=\"page\">\n";

  def bottom:
    "  </main>\n"
    + "  <footer class=\"footer\">\n"
    + "    <p class=\"footer-note\">The Protolab holds tickets at the prototype stage: open issues labelled tehas:prototype by an allowed account. The files are copies of what is attached to the issue, at most \($limit | size) a ticket. This view is read-only; a page goes when its ticket is closed or loses the label.</p>\n"
    + "    <div class=\"ascii\"><pre role=\"img\" aria-label=\"Tehas ASCII art logo\">"
    + ("       __________________________.____    _________    ______\n"
       + "       \\___     ___/  __    /    |    \\ _/    _    \\ _/   __/__\n"
       + "__ __/\\ _/       \\_   \\____/__   _     \\__   _/     \\\\______   \\_ /\\___ ___ _\n"
       + "       \\____     /____      /___|      //___\\       /      ____/\n"
       + " - --------l____/----l_____/----l_____/------\\_____/_______/-----sQ!-- -- -" | h)
    + "</pre></div>\n"
    + "    <p class=\"credit\">ASCII ART: <a href=\"https://demozoo.org/sceners/26586/\" target=\"_blank\" rel=\"noopener noreferrer\">SQUAREPUSHER / TEHDAS</a>. PIXEL TYPE: <a href=\"https://github.com/rewtnull/amigafonts\" target=\"_blank\" rel=\"noopener noreferrer\">TOPAZPLUS A1200</a>, TRUETYPE VERSION BY DMG OF TRUESCHOOL AND DIVINE STYLERS. TOPAZ IS COPYRIGHT AMIGAINC.</p>\n"
    + "  </footer>\n</body>\n</html>";

  def caption($kind; $src; $open):
    "<figcaption><span class=\"asset-name\">\(.name | h)</span>"
    + "<span class=\"asset-fact\">\($kind), \(.bytes | size | ascii_upcase)</span>"
    + "<a href=\"\($src)\" target=\"_blank\" rel=\"noopener noreferrer\" aria-label=\"Open \(.name | h) by itself\">\($open)</a></figcaption>";

  def src: "files/" + (.name | split("/") | map(@uri) | join("/"));

  def asset:
    src as $src
    | if .kind == "image" then
        "        <figure class=\"asset\"><a class=\"asset-view\" href=\"\($src)\"><img src=\"\($src)\" alt=\"Image \(.name | h), attached to the ticket\" loading=\"lazy\"></a>"
        + caption("IMAGE"; $src; "OPEN") + "</figure>\n"
      elif .kind == "video" then
        "        <figure class=\"asset\"><div class=\"asset-view\"><video src=\"\($src)\" controls preload=\"metadata\" aria-label=\"Video \(.name | h), attached to the ticket\"></video></div>"
        + caption("VIDEO"; $src; "OPEN") + "</figure>\n"
      else
        "        <figure class=\"asset asset-app\"><div class=\"asset-view\"><iframe src=\"\($src)\" title=\"HTML prototype \(.name | h)\" sandbox=\"allow-scripts allow-forms allow-modals allow-pointer-lock\" loading=\"lazy\"></iframe></div>"
        + caption("HTML"; $src; "OPEN FULL SIZE") + "</figure>\n"
      end;

  def part:
    src as $src
    | "          <li><span>\(.name | h)</span><span class=\"asset-fact\">\(.bytes | size | ascii_upcase)</span>"
      + "<a href=\"\($src)\" target=\"_blank\" rel=\"noopener noreferrer\">OPEN</a></li>\n";

  def ticket:
    issue as $issue
    | ([.files[] | select(.kind != "part")]) as $shown
    | ([.files[] | select(.kind == "part")]) as $parts
    | top("#\(.number) \(.title)";
          if $issue then "      <a class=\"repo\" href=\"\($issue | h)\" target=\"_blank\" rel=\"noopener noreferrer\">TICKET ON GITHUB</a>\n" else "" end)
    + "    <section class=\"lab-ticket\" aria-labelledby=\"ticket-title\">\n"
    + "      <p class=\"lab-box-head\"><span>PROTOTYPE</span><b>#\(.number)</b></p>\n"
    + "      <div class=\"lab-ticket-body\">\n"
    + "        <h1 id=\"ticket-title\">\(.title | h)</h1>\n"
    + "        <dl class=\"lab-facts\">\n"
    + "          <div><dt>OPENED BY</dt><dd>\(.author // "-" | h)</dd></div>\n"
    + "          <div><dt>CHANGED</dt><dd>\(.updatedAt | day)</dd></div>\n"
    + "        </dl>\n"
    + (if $issue then "        <p><a class=\"button button-primary\" href=\"\($issue | h)\" target=\"_blank\" rel=\"noopener noreferrer\">OPEN THE TICKET ON GITHUB</a></p>\n" else "" end)
    + "      </div>\n"
    + "    </section>\n"
    + "    <section class=\"lab-box\" id=\"assets\" aria-labelledby=\"assets-title\">\n"
    + "      <div class=\"lab-box-head\"><h2 id=\"assets-title\">ASSETS</h2>"
    + "<p>\(.files | length | plural("FILE"; "FILES")), \(.bytes | size | ascii_upcase) OF \($limit | size | ascii_upcase) \(meter)</p></div>\n"
    + "      <div class=\"lab-box-body\">\n"
    + (if (.files | length) == 0 then
        "        <p class=\"lab-note\">No image, video or HTML file is attached to this ticket. Attach one to the issue on GitHub and it is here within a few minutes.</p>\n"
       else "" end)
    + ($shown | map(asset) | join(""))
    + (if ($parts | length) > 0 then
        "        <div class=\"lab-list\"><h3>FILES THE HTML USES</h3>\n        <ul>\n" + ($parts | map(part) | join("")) + "        </ul></div>\n"
       else "" end)
    + (if (.skipped | length) > 0 or .outside > 0 then
        "        <div class=\"lab-list\"><h3>LEFT OUT</h3>\n        <ul>\n"
        + (.skipped | map("          <li><span>\(.name | h)</span><span class=\"asset-fact\">\(.reason | h)</span></li>\n") | join(""))
        + (if .outside > 0 then "          <li><span>\(.outside | plural("link"; "links")) from outside the repository</span><span class=\"asset-fact\">Only files attached by an owner, member or collaborator are taken.</span></li>\n" else "" end)
        + "        </ul></div>\n"
       else "" end)
    + "      </div>\n"
    + "    </section>\n"
    + bottom;

  def row:
    "          <li><a class=\"row\" href=\"\(door | h)\"><b>#\(.number)</b><span class=\"row-title\">\(.title | h)</span>"
    + "<span class=\"row-stage\">\(if (.files | length) == 0 then "NO FILES" else "\(.files | length | plural("FILE"; "FILES")), \(.bytes | size | ascii_upcase)" end)</span></a></li>\n";

  def front:
    top("Prototypes"; "")
    + "    <section class=\"lab\" aria-labelledby=\"lab-title\">\n"
    + "      <div class=\"lab-head\"><h1 id=\"lab-title\">PROTOLAB</h1><p>\(length | plural("PROTOTYPE"; "PROTOTYPES"))</p></div>\n"
    + "      <div class=\"lab-body\">\n"
    + "        <ul class=\"rows\">\n"
    + (if length == 0 then "          <li class=\"rows-note\">Nothing in the lab. An allowed account labels an open ticket tehas:prototype to put it here.</li>\n"
       else (map(row) | join("")) end)
    + "        </ul>\n"
    + "        <figure class=\"lab-scene\">\n"
    + "          <img src=\"/fun/scene-lab.svg\" width=\"400\" height=\"280\" alt=\"Through an office window: one colleague has an idea, a second sketches it in a notebook, and a third reads it and passes it on.\">\n"
    + "          <figcaption>Each ticket has a page with its title, a link to the issue and the images, videos and HTML files attached to it.</figcaption>\n"
    + "        </figure>\n"
    + "      </div>\n"
    + "    </section>\n"
    + bottom;

  if $mode == "ticket" then ticket else front end'

# --- One ticket --------------------------------------------------------------
# build <number> <ticket JSON> <stamp>: make $work/<number> and put it in place.
# Returns 1 when the ticket could not be read; what is there is then kept.
build() {
  local n=$1 ticket=$2 stamp=$3 dir=$work/$1 comments='[]' found ref name ext kind type size rc
  local used=0 count=0 unnamed=0 retry=0 left named i
  mkdir -p "$dir/files" || return 1
  : >"$dir/.files"
  : >"$dir/.skipped"
  skip() { jq -n -c --arg name "$1" --arg reason "$2" '{name: $name, reason: $reason}' >>"$dir/.skipped"; }
  # unpack <folder name>: the zip in .part, into files/<folder name>. Its files
  # and what it leaves out are listed under that folder.
  unpack() {
    local base=$1 lines rc i=2
    [ -n "$base" ] || base=zip
    while [ -e "$dir/files/$base" ]; do
      base=$i-${base#[0-9]-}
      i=$((i + 1))
    done
    lines=$(tehas_unzip_into "$dir/.part" "$dir/files/$base" "$left" "$((max_files - count))")
    rc=$?
    rm -f "$dir/.part"
    if [ "$rc" != 0 ]; then
      rm -rf "${dir:?}/files/$base"
      skip "$name" "Not a zip the lab can read."
      return 0
    fi
    rmdir "$dir/files/$base" 2>/dev/null
    # shellcheck disable=SC2016  # a jq program
    jq -c --arg b "$base" 'select(.name) | {name: "\($b)/\(.name)", kind, bytes}' <<<"$lines" >>"$dir/.files" || return 1
    # shellcheck disable=SC2016  # a jq program
    jq -c --arg b "$base" --arg max "$max_files" 'select(.skip)
      | {name: "\($b)/\(.skip)",
         reason: (if .reason | startswith("More than ") and endswith(" files.") then "More than \($max) files." else .reason end)}' \
      <<<"$lines" >>"$dir/.skipped" || return 1
    used=$((used + $(jq -n '[inputs | .bytes // 0] | add // 0' <<<"$lines")))
    count=$((count + $(jq -n '[inputs | select(.name)] | length' <<<"$lines")))
  }

  if [ "$(jq -r '.comments // 0' <<<"$ticket")" != 0 ]; then
    comments=$(gh api "repos/$repo/issues/$n/comments?per_page=100" 2>/dev/null) || return 1
    jq -e 'type == "array"' <<<"$comments" >/dev/null 2>&1 || return 1
  fi
  found=$(jq -n -c --argjson t "$ticket" --slurpfile c <(printf '%s' "$comments") "$find_refs") || return 1

  while IFS= read -r ref; do
    [ -n "$ref" ] || continue
    name=${ref##*/}
    name=$(printf '%s' "${name%%\?*}" | tr -c 'A-Za-z0-9._-' '-' | sed 's/^[.-]*//' | cut -c1-80)
    [ -n "$name" ] || name="file"
    case "$ref" in
      https://github.com/user-attachments/assets/* | https://github.com/*/assets/*) named=0 ;;
      *) named=1 ;;
    esac
    if [ "$named" = 1 ]; then
      ext=""
      case "$name" in *.*) ext=${name##*.} ;; esac
      ext=${ext,,}
      if [ "$ext" = zip ]; then
        kind=zip
      else
        kind=$(tehas_attachment_kind "$ext") || { skip "$name" "Not a type the lab hosts."; continue; }
      fi
    fi
    if [ "$count" -ge "$max_files" ]; then skip "$name" "More than $max_files files."; continue; fi
    left=$((limit - used))
    if [ "$left" -le 0 ]; then skip "$name" "Over the 10 MB limit of a ticket."; continue; fi

    rm -f "$dir/.part"
    type=$(tehas_attachment_fetch "$ref" "$dir/.part" "$left" "$token")
    rc=$?
    case "$rc" in
      0) ;;
      63) skip "$name" "Over the 10 MB limit of a ticket."; continue ;;
      22) skip "$name" "GitHub did not hand it out."; continue ;;
      *) skip "$name" "Could not be fetched. The lab tries again."; retry=1; continue ;;
    esac
    size=$(stat -c %s "$dir/.part" 2>/dev/null) || size=0
    if [ "$size" = 0 ]; then skip "$name" "Empty."; continue; fi
    if [ "$size" -gt "$left" ]; then skip "$name" "Over the 10 MB limit of a ticket."; continue; fi
    if [ "$named" = 0 ]; then
      ext=$(tehas_attachment_ext "$type") || { skip "$name" "Not a type the lab hosts."; continue; }
      kind=$(tehas_attachment_kind "$ext")
      unnamed=$((unnamed + 1))
      name=$kind-$unnamed.$ext
    fi
    if [ "$kind" = zip ]; then
      unpack "${name%.*}" || return 1
      continue
    fi
    # Two attachments may carry one name.
    i=2
    while [ -e "$dir/files/$name" ]; do
      name=$i-${name#[0-9]-}
      i=$((i + 1))
    done
    mv "$dir/.part" "$dir/files/$name" || return 1
    chmod 644 "$dir/files/$name"
    used=$((used + size))
    count=$((count + 1))
    jq -n -c --arg name "$name" --arg kind "$kind" --argjson bytes "$size" \
      '{name: $name, kind: $kind, bytes: $bytes}' >>"$dir/.files"
  done < <(jq -r '.refs[]' <<<"$found")

  jq -n --argjson t "$ticket" --argjson found "$found" --slurpfile files "$dir/.files" \
    --slurpfile skipped "$dir/.skipped" '
    ($t | {number, title, url, author, updatedAt})
    + {files: $files, skipped: $skipped, outside: $found.outside, bytes: ($files | map(.bytes) | add // 0)}' \
    >"$dir/.meta.json" || return 1
  jq -r --arg mode ticket --arg domain "$domain" --arg home "$home" --argjson limit "$limit" "$render" "$dir/.meta.json" >"$dir/index.html" || return 1
  rm -f "$dir/.part" "$dir/.files" "$dir/.skipped"
  # Without a stamp the next run builds the ticket again.
  [ "$retry" = 1 ] || printf '%s\n' "$stamp" >"$dir/.stamp"

  edge_place "$dir" "$site/$n" || return 1
  echo "#$n: $(jq -r '"\(.files | length) files, \(.bytes) bytes, \(.skipped | length) left out"' "$site/$n/.meta.json")"
}

# The bot's own login, asked once before anything of a ticket is read, built or
# removed: whatever a cycle labels, it labels as the bot. A login that cannot be
# read ends the pass too, because no label below could then be checked against
# the allowed list. Nothing is built and nothing is removed on either outcome.
# A GitHub App's token cannot ask GET /user, so an app's login is the setting.
bot=${TEHAS_BOT_LOGIN:-}
[ -n "$bot" ] || bot=$(gh api user 2>/dev/null | jq -r '.login // empty' 2>/dev/null)
if [ -z "$bot" ]; then
  echo "the bot's own login could not be read, nothing built or removed"
  exit 0
fi
if tehas_allowed_labeler "$bot"; then
  echo "ERROR: the bot account $bot is in TEHAS_ALLOWED_LABELERS; the bot never authorises work"
  exit 78
fi

# --- Every ticket at the prototype stage -------------------------------------
# The first hundred; a failed or odd answer leaves everything as it is.
issues=$(gh api "repos/$repo/issues?state=open&labels=$label&per_page=100" 2>/dev/null) || exit 0
tickets=$(jq -c '
  if type != "array" then error("not a list") else . end
  | map(select(.pull_request == null and (.number | type) == "number" and (.title | type) == "string")
        | {number, title: .title[0:180], url: .html_url, author: .user.login,
           association: .author_association, updatedAt: .updated_at, comments, body: (.body // "")})
  | sort_by(-.number) | .[]' <<<"$issues" 2>/dev/null) || exit 0

keep=" "
while IFS= read -r ticket; do
  [ -n "$ticket" ] || continue
  n=$(jq -r .number <<<"$ticket")
  # The label is checked before the ticket is published: who applied it most
  # recently. An agent in a cycle holds the bot's token, and the bot can label.
  if ! events=$(gh api "repos/$repo/issues/$n/events?per_page=100" --paginate 2>/dev/null) ||
    ! line=$(tehas_label_actor "$label" <<<"$events"); then
    # Events that cannot be read are not a refusal: nothing is built for this
    # ticket, and the removal loop below keeps it.
    echo "#$n: its label events could not be read, nothing built or removed"
    keep="$keep$n "
    continue
  fi
  who=${line%%$'\t'*}
  if ! tehas_allowed_labeler "$who"; then
    printf '%s\n' "$(tehas_label_denied "$n" "$label" "$who")"
    continue
  fi
  keep="$keep$n "
  stamp="$gen $(jq -r .updatedAt <<<"$ticket")"
  if [ -f "$site/$n/.stamp" ] && [ "$(cat "$site/$n/.stamp")" = "$stamp" ]; then continue; fi
  build "$n" "$ticket" "$stamp" || echo "#$n: could not be read, left as it was"
done <<<"$tickets"

while IFS= read -r n; do
  [ -n "$n" ] || continue
  case "$keep" in *" $n "*) continue ;; esac
  rm -rf "${site:?}/$n" && echo "#$n: no longer at the prototype stage, removed"
done < <(edge_numbers "$site")

# --- The list: the lab's front page and the dashboard's file -----------------
metas=()
for f in "$site"/*/.meta.json; do
  [ -f "$f" ] && metas+=("$f")
done
all=$(jq -s -c 'sort_by(-.number)' "${metas[@]}" </dev/null) || exit 1
edge_put "$site/index.html" jq -r --arg mode index --arg domain "$domain" --arg home "$home" --argjson limit "$limit" "$render" <<<"$all" || exit 1
# shellcheck disable=SC2016  # a jq program: the variables are jq's
edge_put "$live/protolab.json" jq -n --slurpfile all <(printf '%s' "$all") --arg now "$(date -u +%FT%TZ)" \
  --arg url "${TEHAS_PROTOLAB_URL:-}" --arg domain "$domain" --argjson limit "$limit" '
  {generatedAt: $now, url: $url, limitBytes: $limit,
   tickets: ($all[0] | map({number, title, url, files: (.files | length), bytes,
     address: (if $domain == "" then null else "https://lab-\(.number).\($domain)/" end)}))}' || exit 1
exit 0
