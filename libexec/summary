#!/usr/bin/env bash
# Print the state of the factory: is it taking work, what is in the queue and
# what the current or last cycle is doing.
#
# It reads one file, $TEHAS_HOME/live/health.json, which the dispatcher
# refreshes at every poll and at the end of every cycle. No network, no
# model, no instance settings, and it writes nothing. What it prints is as old
# as that file, and the first line says how old. The slice line is what the
# dispatcher's last poll read of tehas.slice, with that poll's own age.
#
# A stopped dispatcher cannot report itself: the file just stops changing. So
# a file older than ten minutes is not believed, whatever it says: the first
# line then reads "stale" and the exit status is 1.
#
# The lines themselves come from lib/status.sh, which `tehas top` uses for the
# same two sections of its frame.
#
# Usage: tehas status [--json]
#
#   factory   pass: Idle, taking work. (40 s ago)
#   queue     2 in line, 0 building, 1 in review, 0 stopped (40 s ago)
#   cycle     #12 handoff at step review, 3 min ago
#   slice     room for 2 cycles (4 GiB of 20 GiB promised, reserve 2g, 40 s ago)
#   platform  cb6912a, 19 commits behind origin/main since 2026-10-13, fetched 20 min ago
#
# The slice line reads "holding: ..." when the last poll held cycles back,
# and "unknown: no poll has reported in 10 min" when no poll got as far as
# reading the slice in that time, as while the factory is paused. The
# platform line is there only on a host with a platform checkout.
#
# With --json the same facts as one object on standard output, for a program
# (host/docs/api.md has every field):
#   {"api": 1, "time": "...", "age": 40, "stale": false, "state": "pass",
#    "reasons": [], "paused": {"local": false, "label": false},
#    "allHands": false, "limit": {"state": "none"},
#    "running": [{"issue": 12, "since": "...", "step": "review"}],
#    "demand": {"waiting": 2, "oldestWait": 5400},
#    "hold": {"why": "count", "text": "holding: ..."},
#    "room": {"cycles": 0, "maxAwaiting": 3, "slice": 2}}
# Without a health file it prints nothing on standard output.
#
# Exit: 0 the factory is taking work or is paused (pass, warn); 1 it is not
# (fail), the file is older than ten minutes, or there is no health file yet;
# 64 an argument other than --json.
set -uo pipefail

json=0
case "$#:${1-}" in
  0:) ;;
  1:--json) json=1 ;;
  *) echo "usage: tehas status [--json]" >&2; exit 64 ;;
esac

: "${TEHAS_HOME:=$HOME/tehas}"
here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source=lib/status.sh
. "$here/../lib/status.sh"
file=$TEHAS_HOME/live/health.json

if ! tehas_health_readable "$file"; then
  echo "tehas status: no health file at $file yet: the dispatcher has not run" >&2
  exit 1
fi

now=$(date +%s)
stale=false
tehas_health_stale "$file" "$now" || stale=true

health=$(jq -c . "$file" 2>/dev/null) || { echo "tehas status: $file is not JSON" >&2; exit 1; }

if [ "$json" = 1 ]; then
  tehas_status_json "$health" "$now" "$stale" || exit 1
  [ "$stale" = false ] && [ "$(jq -r .status <<<"$health")" != fail ]
  exit
fi
tehas_state_lines "$health" "$now" "$stale" || exit 1

# The current or last cycle. Two cycles at once are two lines, as the health
# file lists them.
while IFS= read -r cycle; do
  tehas_cycle_line "$cycle" "$now" || exit 1
done < <(jq -c 'if ((.checks.cycles // []) | length) > 1 then .checks.cycles[] else (.checks.cycle // null) end' "$file")
tehas_slice_line "$health" "$now" || exit 1
tehas_platform_line "$health" "$now" || exit 1

[ "$stale" = false ] && [ "$(jq -r .status "$file")" != fail ]
