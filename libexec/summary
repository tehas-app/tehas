#!/usr/bin/env bash
# Print the state of the factory: is it taking work, what is in the queue and
# what the current or last cycle is doing.
#
# It reads one file, $TEHAS_HOME/live/health.json, which the dispatcher
# refreshes at every poll and every two minutes during a cycle. No network, no
# model, no instance settings, and it writes nothing. What it prints is as old
# as that file, and the first line says how old.
#
# Usage: tehas status
#
#   factory   pass: Idle, taking work. (40 s ago)
#   queue     2 in line, 0 building, 1 in review, 0 stopped
#   cycle     #12 handoff at step review, 3 min ago
#
# Exit: 0 the factory is taking work or is paused (pass, warn); 1 it is not
# (fail), or there is no health file yet; 64 an argument, this command takes
# none.
set -uo pipefail

[ "$#" = 0 ] || { echo "usage: tehas status" >&2; exit 64; }

: "${TEHAS_HOME:=$HOME/tehas}"
file=$TEHAS_HOME/live/health.json

if ! jq -e '.status | type == "string"' "$file" >/dev/null 2>&1; then
  echo "tehas status: no health file at $file yet: the dispatcher has not run" >&2
  exit 1
fi

jq -r --argjson now "$(date +%s)" '
  def ago: ($now - .) | if . < 0 then 0 else . end
    | if . < 120 then "\(.) s ago" elif . < 7200 then "\(. / 60 | floor) min ago" else "\(. / 3600 | floor) h ago" end;
  def age: (try (fromdateiso8601 | ago) catch "at an unknown time");
  "factory   \(.status): \(.output // "") (\(.time | age))",
  (.checks.queue // null | if . == null then "queue     no snapshot yet"
   else "queue     \(.inLine) in line, \(.building) building, \(.review) in review, \(.stopped) stopped"
        + (if .paused then ", paused" else "" end) end),
  (.checks.cycle // null | if . == null then "cycle     none yet"
   elif .running then "cycle     #\(.issue) running, step \(.step // "-"), started \(.startedAt // "" | age)"
   else "cycle     #\(.issue) \(.status // "unknown") at step \(.step // "-"), \(.time // "" | age)" end)
' "$file" || exit 1

[ "$(jq -r .status "$file")" != fail ]
