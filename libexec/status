#!/usr/bin/env bash
# Write the dashboard's data file: $TEHAS_HOME/live/status.json.
#
# One snapshot of the queue as GitHub sees it (which issues are in line, being
# worked on, waiting for a human, stopped, completed), whether the last poll
# found no resources (live/dispatch.json), and the words of the breakroom game.
# Deterministic, no model, five GitHub calls. The dispatcher runs it at every
# poll, and a cycle when it ends.
#
# The words are counted over the titles and labels of every issue of the
# repository, the newest thousand, whether the factory was ever given it or
# not. Only the hundred most used words and their counts are written: no
# title and no issue number. Without an answer to that call the snapshot is
# written with no words, and the page counts the tickets it does list.
#
# It also writes live/platform.json: what platform the host runs, so a host
# that needs tehas update says so. On a host with the platform checkout
# ($TEHAS_HOME/platform) that is the commit it is at and how many commits it
# is behind origin's default branch; the checkout is fetched at most once an
# hour, under a time limit, and a fetch that fails is tried again an hour
# later and changes nothing else. On a host that runs a release
# ($TEHAS_HOME/current) it is the installed version and the newest published
# one: {release, newest, behind: 0, upstream: "releases"}. The list of
# releases is read at most once an hour, under the same limit, and the last
# answer is kept in state/platform-newest, so a poll between reads and a read
# that fails keep the newest it had. A host with neither has no file.
#
# The snapshot says whether the factory is paused, and which of the two
# switches holds it: `paused: true` when either is set, and `pause: {flag,
# label, lifted}`, where `flag` is {at, reason} written by tehas pause or null,
# `label` is tehas:pause on the control issue, and `lifted` says the label is
# off but the account that took it off may not authorise work, which holds this
# host paused just as much. `allHands` is true while tehas:all-hands on the
# control issue was applied by an allowed account, null when that could not be
# read. The flag is read from this host, so pausing needs no
# answer from GitHub. `by`, the account that set the flag, stays out of the file:
# the page that reads it can be public.
#
# `planned` lists the open issues with tehas:plan or tehas:planning; `planning` counts them.
# It writes live/epics.json, the open epics and their sub-issues (console/src/epics.rs).
#
# `completedCount` is how many closed issues carry tehas:shipped, counted by a
# search of its own, so it keeps rising past the hundred items the `completed`
# list holds. It is the whole number the search answered, or no key at all when
# the search gave no such number, in which case the page counts the list. The
# one statement of the bound is the select below; host/docs/tools.md names the
# same contract for a reader outside this repository.
#
# It writes live/analytics.json, the ten-day report of the factory's analytics,
# and live/orders.json, what each listed issue's runs spent (analytics_report),
# at every run, early ends included. TEHAS_ANALYTICS=off removes both.
#
# Unless TEHAS_ANALYTICS=off, it records the issue events awaiting, stopped,
# merged and closed in the factory's analytics, state/analytics.db, by
# comparing the snapshot with the one it replaces (record_events below). Each
# call has a time limit, and one that fails is a WARN line on standard error:
# it changes nothing in the snapshot (lib/analytics.sh).
#
# The control issue that carries `tehas:pause` is not work, so it is left out of
# every count and every list: no label makes it count in line, being worked on,
# waiting for a human or waiting to be merged.
#
# Usage: tehasbot status          (prints nothing but an ignored all-hands label,
#                                 once, analytics warnings and a WARN line when
#                                 the snapshot cannot be written, on standard
#                                 error; exit 0 even when GitHub is down,
#                                 the previous file is then left in place;
#                                 exit 78 when the instance settings are invalid)
set -uo pipefail

here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
from_poll=${TEHAS_GH_TOKEN:+yes} # read before the load, which unsets the name
# shellcheck source=lib/config.sh
. "$here/../lib/config.sh"
# shellcheck source=lib/labels.sh
. "$here/../lib/labels.sh"
# shellcheck source=lib/status.sh
. "$here/../lib/status.sh"
# shellcheck source=lib/analytics.sh
. "$here/../lib/analytics.sh"
# shellcheck source=lib/update-release.sh
. "$here/../lib/update-release.sh"
tehas_load || exit 78
tehas_require TEHAS_REPO TEHAS_CONTROL_ISSUE TEHAS_ALLOWED_LABELERS
# The console decides what the read of what closed an issue means
# (console/src/shipped.rs): no shipped list and no label without it.
console=$here/console
[ -x "$console" ] || { printf 'tehasbot status: no console beside this command at %s, run install.sh\n' "$console" >&2; exit 78; }
# The one word the label of a merge is known by, read once from the console
# beside this command, and kept here as the fallback for a host whose console
# is older than that verb - the same word tehas tidy keeps.
shipped_label=$("$console" shipped label 2>/dev/null) || shipped_label=
shipped_label=${shipped_label:-tehas:shipped}
repo=$TEHAS_REPO
control=$TEHAS_CONTROL_ISSUE
live=$TEHAS_HOME/live
mkdir -p "$live"
log() { printf '%s %s\n' "$(date -u +%FT%TZ)" "$*" >&2; }

# The ten-day report of the factory's analytics, live/analytics.json, for
# the dashboard. Public, so only the keys named here reach it; what each
# holds is pinned by the program's tests. Off, or no program: no file. A
# report that fails or does not parse keeps the file there while it is less
# than analytics_keep seconds old: one poll that meets a locked database
# does not empty the section, and a database that keeps failing does not
# show old figures for long.
analytics_keep=600
analytics_keys='["report","from","to","shipped","planned","runs","planningTurns","handoffRate",
  "firstPassYield","leadTime","cycleTime","machineTime","tokens","availability","energy","daily",
  "stopReasons","stations","versions","refine"]'
# shellcheck disable=SC2329  # the EXIT trap below calls it
analytics_report() {
  # Names of this run: a cycle's end and a poll may run status at once. The
  # edge serves no *.new, so the unfiltered report is never public.
  local file=$live/analytics.json rc written
  local raw=$file.$$.raw.new new=$file.$$.new
  tehas_analytics_to /dev/null orders
  tehas_analytics_to "$raw" report --json
  rc=$?
  if [ "$rc" = 0 ] && jq -ce --argjson keys "$analytics_keys" '
      select(type == "object" and .report == 1) | with_entries(select(.key as $k | $keys | index($k)))' \
      "$raw" >"$new" 2>/dev/null && mv -f "$new" "$file"; then
    rm -f "$raw"
    return 0
  fi
  rm -f "$raw" "$new"
  if [ "$rc" = 2 ]; then
    rm -f "$file" "$live/orders.json"
    return 0
  fi
  [ "$rc" = 1 ] || log "WARN analytics report: not a report"
  written=$(stat -c %Y "$file" 2>/dev/null) || return 0
  [ $((EPOCHSECONDS - written)) -lt "$analytics_keep" ] || rm -f "$file"
}
# The private files of the MCP server, under mcp/ (never live/, which is
# public): sessions.jsonl, the last thirty days, and outcomes.jsonl, how the
# runs ended for a year back. The program makes the directory (700) and writes
# both itself (600, renamed into place), so the host neither reads nor writes
# them. A failed poll keeps a file younger than analytics_keep, not an older one.
# shellcheck disable=SC2329  # the two below and the EXIT trap call it
analytics_publish() {
  # <subcommand> <file>: the two differ in the command and the name alone.
  local subcommand=$1 file=$2 rc written
  (umask 077; tehas_analytics_to /dev/null "$subcommand" --out "$TEHAS_HOME/mcp")
  rc=$?
  [ "$rc" = 0 ] && return 0
  if [ "$rc" = 2 ]; then
    rm -f "$file"
    return 0
  fi
  [ "$rc" = 1 ] || log "WARN analytics $subcommand: not written"
  written=$(stat -c %Y "$file" 2>/dev/null) || return 0
  [ $((EPOCHSECONDS - written)) -lt "$analytics_keep" ] || rm -f "$file"
}
# shellcheck disable=SC2329  # the EXIT trap below calls it
analytics_sessions() { analytics_publish sessions "$TEHAS_HOME/mcp/sessions.jsonl"; }
# shellcheck disable=SC2329  # the EXIT trap below calls it
analytics_outcomes() { analytics_publish outcomes "$TEHAS_HOME/mcp/outcomes.jsonl"; }
# Write the report, and refresh health unless the poll ran this: it runs health next.
trap 'analytics_report; analytics_sessions; analytics_outcomes; [ -n "$from_poll" ] || "$here/with-settings" tehasbot health 2>/dev/null || true' EXIT

fetch_every=3600
fetch_limit=60
# What the host runs, in live/platform.json: the release when it runs one
# (platform_release), the checkout when it has one, and nothing when it has
# neither. Both halves read the outside world at most once an hour: the
# checkout is fetched, the releases are listed, and state/platform-fetch says
# when either was last tried.
platform() {
  local installed
  installed=$(tehas_release_installed) || return 0
  if [ -n "$installed" ]; then
    platform_release "$installed"
    return 0
  fi
  platform_checkout
}

# The newest published release, as tehas_release_list answers it: its tag, or
# nothing when GitHub does not answer, answers no release, or answers a tag
# that is no version. The list is newest first, so the first line is what the
# host should move to. Called only by the substitution below, so the tehas_err
# of a list that failed stays on standard error of this script instead of
# becoming the newest.
platform_newest_read() {
  local line tag
  line=$(tehas_release_list 2>/dev/null | head -n 1)
  [ -n "$line" ] || return 0
  tag=$(jq -r '.tag // ""' <<<"$line" 2>/dev/null) || return 0
  tehas_release_tag_ok "$tag" && printf '%s\n' "$tag"
}

# A host that runs a release: the version current points at, the newest there
# is, and nothing of a checkout it may still hold. The list is read once an
# hour under fetch_limit; the answer is kept in state/platform-newest and a
# poll between reads, or one whose read fails, says the newest it last had -
# unless the installed version is no version, or the cached answer is older
# than it: then the cache goes and the next read asks again.
platform_release() { # <installed version>
  local installed=$1 stamp=$TEHAS_HOME/state/platform-fetch newestfile=$TEHAS_HOME/state/platform-newest
  local last=0 now fetched="" newest=""
  now=$EPOCHSECONDS
  read -r last fetched 2>/dev/null <"$stamp" || true
  [[ $last =~ ^[0-9]+$ ]] || last=0
  [[ $fetched =~ ^[0-9]+$ ]] || fetched=""
  newest=$(head -n 1 "$newestfile" 2>/dev/null) || newest=""
  # What the cache may be said at all: a tag that is no version says nothing,
  # nor does one older than the version the host runs, which no published
  # release list of that repository holds.
  if [ -n "$newest" ]; then
    if ! tehas_release_tag_ok "$newest" || ! tehas_release_tag_ok "$installed" ||
      tehas_release_older "$newest" "$installed"; then
      rm -f "$newestfile"
      newest=""
    fi
  fi
  if [ $((now - last)) -ge "$fetch_every" ]; then
    # The attempt is remembered first, so a read that hangs or fails is not
    # tried at every poll.
    mkdir -p "${stamp%/*}"
    echo "$now $fetched" >"$stamp"
    local got
    got=$(platform_newest_read)
    if [ -n "$got" ]; then
      newest=$got
      fetched=$now
      printf '%s\n' "$newest" >"$newestfile"
      echo "$now $fetched" >"$stamp"
    fi
  fi
  [[ $newest =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]] || newest=""
  jq -n --arg now "$(date -u +%FT%TZ)" --arg release "$installed" --arg newest "$newest" \
    --arg fetched "$fetched" '
    def num: if test("^[0-9]+$") then tonumber else null end;
    {generatedAt: $now, release: $release, newest: (if $newest == "" then null else $newest end),
     behind: 0, upstream: "releases",
     fetchedAt: ($fetched | num | if . == null then null else todate end)}' \
    >"$live/platform.json.$$.new" 2>/dev/null &&
    mv "$live/platform.json.$$.new" "$live/platform.json" 2>/dev/null
  rm -f "$live/platform.json.$$.new"
}

platform_checkout() {
  local co=$TEHAS_HOME/platform stamp=$TEHAS_HOME/state/platform-fetch last=0 now upstream head behind since fetched=""
  [ -e "$co/.git" ] || { rm -f "$live/platform.json"; return 0; }
  now=$EPOCHSECONDS
  read -r last fetched 2>/dev/null <"$stamp" || true
  [[ $last =~ ^[0-9]+$ ]] || last=0
  [[ $fetched =~ ^[0-9]+$ ]] || fetched=""
  if [ $((now - last)) -ge "$fetch_every" ]; then
    # The attempt is remembered first, so a fetch that hangs or fails is not
    # tried at every poll.
    mkdir -p "${stamp%/*}"
    echo "$now $fetched" >"$stamp"
    if timeout "$fetch_limit" git -C "$co" fetch -q origin >/dev/null 2>&1 </dev/null; then
      fetched=$now
      echo "$now $fetched" >"$stamp"
    fi
  fi
  upstream=$(git -C "$co" symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null) ||
    upstream=origin/$(git -C "$co" symbolic-ref --quiet --short HEAD 2>/dev/null)
  head=$(git -C "$co" rev-parse --quiet --verify HEAD 2>/dev/null) || head=""
  behind=$(git -C "$co" rev-list --count "HEAD..$upstream" 2>/dev/null) || behind=""
  # When the oldest commit main has and this checkout lacks landed there.
  since=$(git -C "$co" log --first-parent --reverse --format=%ct "HEAD..$upstream" 2>/dev/null | head -n 1)
  jq -n --arg now "$(date -u +%FT%TZ)" --arg commit "$head" --arg upstream "$upstream" --arg behind "$behind" \
    --arg since "$since" --arg fetched "$fetched" '
    def num: if test("^[0-9]+$") then tonumber else null end;
    {generatedAt: $now, commit: (if $commit == "" then null else $commit end),
     upstream: $upstream, behind: ($behind | num),
     behindSince: ($since | num | if . == null then null else todate end),
     fetchedAt: ($fetched | num | if . == null then null else todate end)}' \
    >"$live/platform.json.$$.new" 2>/dev/null &&
    mv "$live/platform.json.$$.new" "$live/platform.json" 2>/dev/null
  rm -f "$live/platform.json.$$.new"
}
platform

issues=$(gh issue list --repo "$repo" --state all --limit 200 \
  --search 'label:"tehas:ready","tehas:running","tehas:awaiting-merge","needs-human-attention","tehas:plan","tehas:planning" sort:updated-desc' \
  --json number,title,url,state,labels,createdAt,updatedAt,closedAt 2>/dev/null) || { log "WARN status: the list of issues could not be read, no snapshot was written"; exit 0; }
everything=$(gh issue list --repo "$repo" --state all --limit 1000 --json title,labels 2>/dev/null) || everything=null
jq -e 'type == "array"' <<<"$everything" >/dev/null 2>&1 || everything=null
# The closing pull request is only in the issue's closed event, so this one is
# GraphQL: the query and the acceptance rule are the console's (`console
# shipped`, console/src/shipped.rs), the same ones
# tehas tidy reads, so the two commands cannot disagree on what a merge closed.
search_wait=$fetch_limit
# The list of shipped work goes under the same bound as the count below it: a
# read that hangs costs the run this many seconds and is then no snapshot at all.
# shellcheck disable=SC2016  # $q is a GraphQL variable
if ! closers=$(timeout -k 1 "$search_wait" gh api graphql -f q="repo:$repo is:issue is:closed linked:pr sort:updated-desc" \
  -f query="$("$console" shipped query 2>/dev/null)" 2>/dev/null); then
  log "WARN status: the read of what closed these issues could not be read, no snapshot was written"
  exit 0
fi
# The console alone judges the answer, the way tehas tidy judges it, so the list
# here and the label there cannot disagree: the nodes it keeps are the ones whose
# closer was a merged pull request, in the order of their close, and each whole
# node is kept so the loop below reads its labels instead of asking the read again.
# A read that named issues and found no merged closer is a whole answer and a
# snapshot of no completed work; only a reply with no list of nodes in it is no
# snapshot, which is the case its 1 and the line above cover.
shipped=$(printf '%s' "$closers" | "$console" shipped list --control "$control" 2>/dev/null) ||
  printf '%s' "$closers" | "$console" shipped whole >/dev/null 2>&1 || { log "WARN status: the answer of what closed these issues was no list, no snapshot was written"; exit 0; }
# One object on a line is no list for jq, which wants one value: made one here,
# once, with the control issue already out of it.
shipped=$(jq -sc '.' <<<"$shipped") || exit 0
# The figure of the Shipped stage: every closed issue with the label, not the
# page this script reads. The query is written once here and shared with
# links.completed below, so the figure and the list's "all" link cannot drift
# apart.
shipped_query="is:issue is:closed label:$shipped_label"
# The same limit the platform reads go under: a search that hangs costs the run
# this many seconds and is then a figure with no key, as a search that answered
# nothing is. first: 0 asks for the total and no nodes.
# shellcheck disable=SC2016  # $q is a GraphQL variable
completed_raw=$(timeout -k 1 "$search_wait" gh api graphql -f q="repo:$repo $shipped_query" -f query='
  query($q: String!) { search(type: ISSUE, query: $q, first: 0) { issueCount } }' 2>/dev/null) || completed_raw=""
# The figure is published only as a whole number of issues: nothing negative,
# fractional or beyond what a JavaScript number holds exactly, 2^53 - 1 the
# largest. The reader, host/fun/business-view.js, shows what this publishes and
# rejects the rest, so the bound is stated once.
completed_count=$(jq -ce '.data.search.issueCount
  | select(type == "number" and . >= 0 and . == floor and . < 9007199254740992)' <<<"$completed_raw" 2>/dev/null) || completed_count=""
# The control issue's labels, read once for both of its switches.
control_read=true
control_labels=" $(gh issue view "$control" --repo "$repo" --json labels \
  --jq '[.labels[].name] | join(" ")' 2>/dev/null) " || control_read=false
paused=false
[[ $control_labels != *" tehas:pause "* ]] || paused=true
# The label works one way, so its absence is not always a resume. The poll
# decides that from lib/labels.sh before it starts anything; this reports the
# same verdict, so that a factory held by a pause a stranger lifted is not
# published as taking work. An answer that cannot be read reports nothing extra:
# the poll, which acts on it, ends when it cannot read the events.
lifted=false
events=""
events_read=false
control_events() {
  [ "$events_read" = false ] || return 0
  events_read=true
  events=$(gh api "repos/$repo/issues/$control/events?per_page=100" --paginate 2>/dev/null) || events=""
}
if [ "$paused" = false ]; then
  control_events
  if [ -n "$events" ]; then
    tehas_pause_holds <<<"$events" >/dev/null && lifted=true
  fi
fi
# tehas:all-hands on the control issue holds while it is on the issue and the
# account that applied it is allowed (rule 5). It is reported and changes
# nothing in the factory. A label anyone else applied is said once, here on
# standard error, which the dispatcher's log keeps; state/all-hands.ignored
# remembers which application was said. null is a label that could not be read.
all_hands=false
ignored=$TEHAS_HOME/state/all-hands.ignored
if [ "$control_read" = false ]; then
  all_hands=null
elif [[ $control_labels == *" tehas:all-hands "* ]]; then
  control_events
  if [ -z "$events" ] || ! line=$(tehas_label_actor tehas:all-hands <<<"$events"); then
    all_hands=null
  elif tehas_allowed_labeler "${line%%$'\t'*}"; then
    all_hands=true
    rm -f "$ignored"
  elif [ ! -e "$ignored" ] || [ "$(<"$ignored")" != "$line" ]; then
    echo "tehasbot status: tehas:all-hands on #$control was applied by '${line%%$'\t'*}', not an allowed account: ignored" >&2
    mkdir -p "${ignored%/*}"
    printf '%s\n' "$line" >"$ignored"
  fi
else
  rm -f "$ignored"
fi
# The host's own switch, read without asking GitHub anything. A flag that cannot
# be read counts as paused and has nothing to say for itself beyond that.
pause_flag=$(tehas_pause_read "$TEHAS_HOME/state/pause.json")
case $? in
  0) pause_flag=$(jq -c '{at, reason}' <<<"$pause_flag"); flag_paused=true ;;
  1) pause_flag=null; flag_paused=false ;;
  2) pause_flag='{"at":null,"reason":null}'; flag_paused=true ;;
esac

# The model endpoint as the last poll found it, for the pages. A file older
# than ten minutes is from a dispatcher that no longer gets that far.
no_resources=$(jq -s 'length == 1 and (.[0] | type == "object" and .why == "resources"
  and (now - (.time | fromdateiso8601)) < 600)' "$live/dispatch.json" 2>/dev/null) || no_resources=false

# The snapshot this one replaces, for the events below: none when it is not
# one, or older than an hour, so a change it missed is not dated now.
before=null
if [ "$TEHAS_ANALYTICS" = on ]; then
  before=$(jq -cs 'if length == 1 and (.[0] | type == "object")
      and (now - (.[0].generatedAt | try fromdateiso8601 catch 0)) < 3600 then .[0] else null end' \
    "$live/status.json" 2>/dev/null) || before=null
  [ -n "$before" ] || before=null
fi

# GitHub's lists go in as files: one argument is at most 128 KiB on Linux, and
# the list of every issue is more than that on a big repository.
written=0
jq -n --slurpfile issues <(printf '%s' "$issues") --slurpfile shipped <(printf '%s' "$shipped") \
  --slurpfile everything <(printf '%s' "$everything") --argjson paused "$paused" \
  --argjson noResources "${no_resources:-false}" --argjson pauseFlag "$pause_flag" --argjson flagPaused "$flag_paused" \
  --argjson lifted "$lifted" --argjson allHands "$all_hands" \
  --argjson completedCount "${completed_count:-null}" --arg shippedQuery "$shipped_query" --arg control "$control" \
  --arg repo "$repo" --arg now "$(date -u +%FT%TZ)" '
  $issues[0] as $issues | $shipped[0] as $shipped | $everything[0] as $everything
  | def has($l): (.labels | map(.name) | index($l)) != null;
  def slim: {number, title, url, createdAt, updatedAt, closedAt};
  def listurl($q): "https://github.com/\($repo)/issues?q=" + ($q | @uri);
  # The control issue holds the pause label and no outcome. It is not work, so
  # it is never counted in line, being worked on, waiting for a human or waiting
  # to be merged, whatever label someone gives it. The dispatcher starts nothing
  # on the same number.
  ($issues | map(select(.state == "OPEN" and (.number | tostring) != $control))) as $open
  | {
      generatedAt: $now, repo: $repo,
      paused: ($paused or $flagPaused or $lifted),
      pause: {flag: $pauseFlag, label: $paused, lifted: $lifted},
      allHands: $allHands,
      noResources: $noResources,
      running: ($open | map(select(has("tehas:running")) | slim)),
      queued: ($open | map(select(has("tehas:ready") and (has("tehas:running") | not)) | slim) | sort_by(.number)),
      awaiting: ($open | map(select(has("tehas:awaiting-merge")) | slim)),
      stopped: ($open | map(select(has("needs-human-attention") and (has("tehas:running") | not)) | slim)),
      planned: ($open | map(select(has("tehas:plan") or has("tehas:planning")) | slim) | sort_by(.number)),
      planning: ($open | map(select(has("tehas:plan") or has("tehas:planning"))) | length),
      completed: ($shipped | map(slim) | sort_by(.closedAt) | reverse),
      completedCount: $completedCount,
      links: {
        queued: listurl("is:issue is:open label:tehas:ready"),
        awaiting: listurl("is:issue is:open label:tehas:awaiting-merge"),
        stopped: listurl("is:issue is:open label:needs-human-attention"),
        completed: listurl($shippedQuery),
        all: "https://github.com/\($repo)/issues"
      }
    }
  | with_entries(select(.key != "completedCount" or .value != null))
  + (if $everything == null then {} else {
      buzzwords: ([$everything[] | objects
                   | ([.title | strings] + [.labels[]?.name? | strings] | join(" ") | ascii_downcase)
                   | scan("[a-z][a-z0-9-]{2,}")]
                  | group_by(.) | map({word: .[0], count: length})
                  | sort_by(-.count, .word) | .[:100])
    } end)' >"$live/status.json.$$.new" 2>"$live/status.json.$$.err.new" && mv "$live/status.json.$$.new" "$live/status.json" && written=1
[ "$written" = 1 ] || log "WARN status.json not written: $(head -n 1 "$live/status.json.$$.err.new")"
rm -f "$live/status.json.$$.new" "$live/status.json.$$.err.new"
timeout -k 1 "$search_wait" "$console" epics "$repo" "$live/epics.json"

# An issue this read finds shipped carries the label whatever the reason, and
# the read names its labels, so an issue that already holds it is not asked for
# it: `gh issue edit` reads the issue and sends a mutation every time, and the 45
# of them one poll made cost that poll a minute. The console answers which of
# the shipped issues lack the label, in one call for the poll and no question
# per issue, and the labels the read did not answer count as missing, as before
# it read them.
for n in $(printf '%s' "$closers" | "$console" shipped list --numbers \
  --lacking "$shipped_label" --control "$control" 2>/dev/null); do
  gh issue edit "$n" --repo "$repo" --add-label "$shipped_label" >/dev/null 2>&1 || true
done

# The issue events of the factory's analytics, from what changed since the
# snapshot before: newly awaiting a merge or stopped, now; newly completed,
# merged at the time it was closed; closed and not completed, having been in
# line, running or stopped before, closed at that time. One that was awaiting
# a merge is not closed: the search for completed work lags, and its merged
# comes when it catches up. A run with no snapshot before it records only the
# merged and closed, which carry their own time. Nothing older than ten days,
# the report's window. No call starts after three calls' time limits, so a
# database that hangs delays the run by four at most (about 21 seconds). An event whose call fails or runs out of time is lost: the next
# run compares with this snapshot and does not try it again.
record_events() {
  local list n event at stop
  list=$(jq -r --slurpfile before <(printf '%s' "$before") --slurpfile issues <(printf '%s' "$issues") \
    --arg control "$control" '
    $before[0] as $before | $issues[0] as $issues
    | def nums($k): [.[$k] | arrays | .[] | objects | .number | numbers];
    def recent: .closedAt | strings | (try fromdateiso8601 catch null) | numbers
      | select(. >= now - 864000) | floor;
    def new($k; $s): ($s | nums($k)) - ($before | nums($k)) | .[] | "\(.) \($k)";
    . as $s
    | ($s | nums("completed")) as $done
    | (if $before == null then [] else $before | (nums("queued") + nums("running") + nums("stopped")) - nums("awaiting") end) as $was
    | (if $before == null then empty else new("awaiting"; $s), new("stopped"; $s) end),
      ($s.completed[] | . as $i
        | select($before == null or ($before | nums("completed") | any(. == $i.number) | not))
        | "\(.number) merged \(recent)"),
      ($issues[] | . as $i
        | select(.state == "CLOSED" and (.number | tostring) != $control and ($done | any(. == $i.number) | not))
        | select($before == null or ($was | any(. == $i.number)))
        | "\(.number) closed \(recent)")' "$live/status.json" 2>/dev/null) || return 0
  # In microseconds: whole seconds would start the count up to one second late.
  stop=$((${EPOCHREALTIME/[.,]/} + 3 * $(tehas_analytics_wait) * 1000000))
  while read -r n event at; do
    [ -n "$n" ] || continue
    if [ "${EPOCHREALTIME/[.,]/}" -ge "$stop" ]; then
      log "WARN analytics: out of time, the other events of this run are left out"
      break
    fi
    tehas_analytics event "$n" "$event" ${at:+--at "$at"}
  done <<<"$list"
}
[ "$written" = 0 ] || [ "$TEHAS_ANALYTICS" != on ] || record_events
exit 0
