#!/usr/bin/env bash
# Write the dashboard's data file: $TEHAS_HOME/live/status.json.
#
# One snapshot of the queue as GitHub sees it (which issues are in line, being
# worked on, waiting for a human, stopped, completed), whether the last poll
# found no resources (live/dispatch.json), and the words of the breakroom game.
# Deterministic, no model, four GitHub calls. The dispatcher runs it at every
# poll, and a cycle when it ends.
#
# The words are counted over the titles and labels of every issue of the
# repository, the newest thousand, whether the factory was ever given it or
# not. Only the hundred most used words and their counts are written: no
# title and no issue number. Without an answer to that call the snapshot is
# written with no words, and the page counts the tickets it does list.
#
# It also writes live/platform.json: the commit the platform checkout
# ($TEHAS_HOME/platform) is at and how many commits it is behind origin's
# default branch, so a host that needs tehas update says so. The checkout is
# fetched at most once an hour, under a time limit; a fetch that fails is
# tried again an hour later and changes nothing else. A host with no such
# checkout has no file.
#
# The snapshot says whether the factory is paused, and which of the two
# switches holds it: `paused: true` when either is set, and `pause: {flag,
# label, lifted}`, where `flag` is {at, reason} written by tehas pause or null,
# `label` is tehas:pause on the control issue, and `lifted` says the label is
# off but the account that took it off may not authorise work, which holds this
# host paused just as much. `allHands` is true while tehas:all-hands on the
# control issue was applied by an allowed account, null when that could not be
# read. The flag is read from this host, so pausing needs no
# answer from GitHub. `by`, the account that set the flag, stays out of the file:
# the page that reads it can be public.
#
# `planning` is how many open issues carry tehas:plan or tehas:planning: the
# work being planned, a count only. The same search as the lists finds them.
#
# It writes live/analytics.json, the ten-day report of the factory's
# analytics (analytics_report below), at every run, the runs that end early
# when GitHub does not answer too. TEHAS_ANALYTICS=off removes it.
#
# Unless TEHAS_ANALYTICS=off, it records the issue events awaiting, stopped,
# merged and closed in the factory's analytics, state/analytics.db, by
# comparing the snapshot with the one it replaces (record_events below). Each
# call has a time limit, and one that fails is a WARN line on standard error:
# it changes nothing in the snapshot (lib/analytics.sh).
#
# The control issue that carries `tehas:pause` is not work, so it is left out of
# every count and every list: no label makes it count in line, being worked on,
# waiting for a human or waiting to be merged.
#
# Usage: tehasbot status          (prints nothing but an ignored all-hands label,
#                                 once, and analytics warnings, on standard
#                                 error; exit 0 even when GitHub is down,
#                                 the previous file is then left in place;
#                                 exit 78 when the instance settings are invalid)
set -uo pipefail

here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source=lib/config.sh
. "$here/../lib/config.sh"
# shellcheck source=lib/labels.sh
. "$here/../lib/labels.sh"
# shellcheck source=lib/status.sh
. "$here/../lib/status.sh"
# shellcheck source=lib/analytics.sh
. "$here/../lib/analytics.sh"
tehas_load || exit 78
tehas_require TEHAS_REPO TEHAS_CONTROL_ISSUE TEHAS_ALLOWED_LABELERS
repo=$TEHAS_REPO
control=$TEHAS_CONTROL_ISSUE
live=$TEHAS_HOME/live
mkdir -p "$live"
log() { printf '%s %s\n' "$(date -u +%FT%TZ)" "$*" >&2; }

# The ten-day report of the factory's analytics, live/analytics.json, for
# the dashboard. Public, so only the keys named here reach it; what each
# holds is pinned by the program's tests. Off, or no program: no file. A
# report that fails or does not parse keeps the file there while it is less
# than analytics_keep seconds old: one poll that meets a locked database
# does not empty the section, and a database that keeps failing does not
# show old figures for long.
analytics_keep=600
analytics_keys='["report","from","to","shipped","planned","runs","planningTurns","handoffRate",
  "firstPassYield","leadTime","cycleTime","machineTime","tokens","availability","energy","daily",
  "stopReasons","stations","versions"]'
# shellcheck disable=SC2329  # the EXIT trap below calls it
analytics_report() {
  # Names of this run: a cycle's end and a poll may run status at once. The
  # edge serves no *.new, so the unfiltered report is never public.
  local file=$live/analytics.json rc written
  local raw=$file.$$.raw.new new=$file.$$.new
  tehas_analytics_to "$raw" report --json
  rc=$?
  if [ "$rc" = 0 ] && jq -ce --argjson keys "$analytics_keys" '
      select(type == "object" and .report == 1) | with_entries(select(.key as $k | $keys | index($k)))' \
      "$raw" >"$new" 2>/dev/null && mv -f "$new" "$file"; then
    rm -f "$raw"
    return 0
  fi
  rm -f "$raw" "$new"
  if [ "$rc" = 2 ]; then
    rm -f "$file"
    return 0
  fi
  [ "$rc" = 1 ] || log "WARN analytics report: not a report"
  written=$(stat -c %Y "$file" 2>/dev/null) || return 0
  [ $(($(date +%s) - written)) -lt "$analytics_keep" ] || rm -f "$file"
}
# Whatever happens below, write the report, and refresh the health file
# from what is on disk.
trap 'analytics_report; "$here/health" 2>/dev/null || true' EXIT

fetch_every=3600
fetch_limit=60
platform() {
  local co=$TEHAS_HOME/platform stamp=$TEHAS_HOME/state/platform-fetch last=0 now upstream head behind since fetched=""
  [ -e "$co/.git" ] || { rm -f "$live/platform.json"; return 0; }
  now=$(date +%s)
  read -r last fetched 2>/dev/null <"$stamp" || true
  [[ $last =~ ^[0-9]+$ ]] || last=0
  [[ $fetched =~ ^[0-9]+$ ]] || fetched=""
  if [ $((now - last)) -ge "$fetch_every" ]; then
    # The attempt is remembered first, so a fetch that hangs or fails is not
    # tried at every poll.
    mkdir -p "${stamp%/*}"
    echo "$now $fetched" >"$stamp"
    if timeout "$fetch_limit" git -C "$co" fetch -q origin >/dev/null 2>&1 </dev/null; then
      fetched=$now
      echo "$now $fetched" >"$stamp"
    fi
  fi
  upstream=$(git -C "$co" symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null) ||
    upstream=origin/$(git -C "$co" symbolic-ref --quiet --short HEAD 2>/dev/null)
  head=$(git -C "$co" rev-parse --quiet --verify HEAD 2>/dev/null) || head=""
  behind=$(git -C "$co" rev-list --count "HEAD..$upstream" 2>/dev/null) || behind=""
  # When the oldest commit main has and this checkout lacks landed there.
  since=$(git -C "$co" log --first-parent --reverse --format=%ct "HEAD..$upstream" 2>/dev/null | head -n 1)
  jq -n --arg now "$(date -u +%FT%TZ)" --arg commit "$head" --arg upstream "$upstream" --arg behind "$behind" \
    --arg since "$since" --arg fetched "$fetched" '
    def num: if test("^[0-9]+$") then tonumber else null end;
    {generatedAt: $now, commit: (if $commit == "" then null else $commit end),
     upstream: $upstream, behind: ($behind | num),
     behindSince: ($since | num | if . == null then null else todate end),
     fetchedAt: ($fetched | num | if . == null then null else todate end)}' \
    >"$live/platform.json.new" 2>/dev/null && mv "$live/platform.json.new" "$live/platform.json"
}
platform

issues=$(gh issue list --repo "$repo" --state all --limit 200 \
  --search 'label:"tehas:ready","tehas:running","tehas:awaiting-merge","needs-human-attention","tehas:plan","tehas:planning" sort:updated-desc' \
  --json number,title,url,state,labels,updatedAt,closedAt 2>/dev/null) || exit 0
everything=$(gh issue list --repo "$repo" --state all --limit 1000 --json title,labels 2>/dev/null) || everything=null
jq -e 'type == "array"' <<<"$everything" >/dev/null 2>&1 || everything=null
# The closing pull request is only in the issue's closed event, so this one is GraphQL.
# shellcheck disable=SC2016  # $q is a GraphQL variable
shipped=$(gh api graphql -f q="repo:$repo is:issue is:closed linked:pr sort:updated-desc" -f query='
  query($q: String!) { search(type: ISSUE, query: $q, first: 50) { nodes { ... on Issue {
    number title url updatedAt closedAt labels(first: 50) { nodes { name } }
    timelineItems(itemTypes: [CLOSED_EVENT], last: 1) { nodes { ... on ClosedEvent {
      closer { ... on PullRequest { merged } } } } } } } } }' 2>/dev/null) || exit 0
shipped=$(jq -ce '.data.search.nodes | map(select(.number != null and .timelineItems.nodes[0].closer.merged == true)
  | {number, title, url, updatedAt, closedAt, labels: [.labels.nodes[].name]})' <<<"$shipped" 2>/dev/null) || exit 0
# The control issue's labels, read once for both of its switches.
control_read=true
control_labels=" $(gh issue view "$control" --repo "$repo" --json labels \
  --jq '[.labels[].name] | join(" ")' 2>/dev/null) " || control_read=false
paused=false
[[ $control_labels != *" tehas:pause "* ]] || paused=true
# The label works one way, so its absence is not always a resume. The poll
# decides that from lib/labels.sh before it starts anything; this reports the
# same verdict, so that a factory held by a pause a stranger lifted is not
# published as taking work. An answer that cannot be read reports nothing extra:
# the poll, which acts on it, ends when it cannot read the events.
lifted=false
events=""
events_read=false
control_events() {
  [ "$events_read" = false ] || return 0
  events_read=true
  events=$(gh api "repos/$repo/issues/$control/events?per_page=100" --paginate 2>/dev/null) || events=""
}
if [ "$paused" = false ]; then
  control_events
  if [ -n "$events" ]; then
    tehas_pause_holds <<<"$events" >/dev/null && lifted=true
  fi
fi
# tehas:all-hands on the control issue holds while it is on the issue and the
# account that applied it is allowed (rule 5). It is reported and changes
# nothing in the factory. A label anyone else applied is said once, here on
# standard error, which the dispatcher's log keeps; state/all-hands.ignored
# remembers which application was said. null is a label that could not be read.
all_hands=false
ignored=$TEHAS_HOME/state/all-hands.ignored
if [ "$control_read" = false ]; then
  all_hands=null
elif [[ $control_labels == *" tehas:all-hands "* ]]; then
  control_events
  if [ -z "$events" ] || ! line=$(tehas_label_actor tehas:all-hands <<<"$events"); then
    all_hands=null
  elif tehas_allowed_labeler "${line%%$'\t'*}"; then
    all_hands=true
    rm -f "$ignored"
  elif [ "$(cat "$ignored" 2>/dev/null)" != "$line" ]; then
    echo "tehasbot status: tehas:all-hands on #$control was applied by '${line%%$'\t'*}', not an allowed account: ignored" >&2
    mkdir -p "${ignored%/*}"
    printf '%s\n' "$line" >"$ignored"
  fi
else
  rm -f "$ignored"
fi
# The host's own switch, read without asking GitHub anything. A flag that cannot
# be read counts as paused and has nothing to say for itself beyond that.
pause_flag=$(tehas_pause_read "$TEHAS_HOME/state/pause.json")
case $? in
  0) pause_flag=$(jq -c '{at, reason}' <<<"$pause_flag"); flag_paused=true ;;
  1) pause_flag=null; flag_paused=false ;;
  2) pause_flag='{"at":null,"reason":null}'; flag_paused=true ;;
esac

# The model endpoint as the last poll found it, for the pages. A file older
# than ten minutes is from a dispatcher that no longer gets that far.
no_resources=$(jq -s 'length == 1 and (.[0] | type == "object" and .why == "resources"
  and (now - (.time | fromdateiso8601)) < 600)' "$live/dispatch.json" 2>/dev/null) || no_resources=false

# The snapshot this one replaces, for the events below: none when it is not
# one, or older than an hour, so a change it missed is not dated now.
before=null
if [ "$TEHAS_ANALYTICS" = on ]; then
  before=$(jq -cs 'if length == 1 and (.[0] | type == "object")
      and (now - (.[0].generatedAt | try fromdateiso8601 catch 0)) < 3600 then .[0] else null end' \
    "$live/status.json" 2>/dev/null) || before=null
  [ -n "$before" ] || before=null
fi

written=0
jq -n --argjson issues "$issues" --argjson shipped "$shipped" --argjson paused "$paused" --argjson everything "$everything" \
  --argjson noResources "${no_resources:-false}" --argjson pauseFlag "$pause_flag" --argjson flagPaused "$flag_paused" \
  --argjson lifted "$lifted" --argjson allHands "$all_hands" \
  --arg control "$control" \
  --arg repo "$repo" --arg now "$(date -u +%FT%TZ)" '
  def has($l): (.labels | map(.name) | index($l)) != null;
  def slim: {number, title, url, updatedAt, closedAt};
  def listurl($q): "https://github.com/\($repo)/issues?q=" + ($q | @uri);
  # The control issue holds the pause label and no outcome. It is not work, so
  # it is never counted in line, being worked on, waiting for a human or waiting
  # to be merged, whatever label someone gives it. The dispatcher starts nothing
  # on the same number.
  ($issues | map(select(.state == "OPEN" and (.number | tostring) != $control))) as $open
  | {
      generatedAt: $now, repo: $repo,
      paused: ($paused or $flagPaused or $lifted),
      pause: {flag: $pauseFlag, label: $paused, lifted: $lifted},
      allHands: $allHands,
      noResources: $noResources,
      running: ($open | map(select(has("tehas:running")) | slim)),
      queued: ($open | map(select(has("tehas:ready") and (has("tehas:running") | not)) | slim) | sort_by(.number)),
      awaiting: ($open | map(select(has("tehas:awaiting-merge")) | slim)),
      stopped: ($open | map(select(has("needs-human-attention") and (has("tehas:running") | not)) | slim)),
      planning: ($open | map(select(has("tehas:plan") or has("tehas:planning"))) | length),
      completed: ($shipped | map(slim) | sort_by(.closedAt) | reverse),
      links: {
        queued: listurl("is:issue is:open label:tehas:ready"),
        awaiting: listurl("is:issue is:open label:tehas:awaiting-merge"),
        stopped: listurl("is:issue is:open label:needs-human-attention"),
        completed: listurl("is:issue is:closed label:tehas:shipped"),
        all: "https://github.com/\($repo)/issues"
      }
    }
  + (if $everything == null then {} else {
      buzzwords: ([$everything[] | objects
                   | ([.title | strings] + [.labels[]?.name? | strings] | join(" ") | ascii_downcase)
                   | scan("[a-z][a-z0-9-]{2,}")]
                  | group_by(.) | map({word: .[0], count: length})
                  | sort_by(-.count, .word) | .[:100])
    } end)' >"$live/status.json.new" 2>/dev/null && mv "$live/status.json.new" "$live/status.json" && written=1

for n in $(jq -r '.[] | select(.labels | index("tehas:shipped") | not) | .number' <<<"$shipped"); do
  gh issue edit "$n" --repo "$repo" --add-label tehas:shipped >/dev/null 2>&1 || true
done

# The issue events of the factory's analytics, from what changed since the
# snapshot before: newly awaiting a merge or stopped, now; newly completed,
# merged at the time it was closed; closed and not completed, having been in
# line, running or stopped before, closed at that time. One that was awaiting
# a merge is not closed: the search for completed work lags, and its merged
# comes when it catches up. A run with no snapshot before it records only the
# merged and closed, which carry their own time. Nothing older than ten days,
# which the program would prune. No call starts after three calls' time
# limits, so a database that hangs delays the run by four at most (about 21
# seconds). An event whose call fails or runs out of time is lost: the next
# run compares with this snapshot and does not try it again.
record_events() {
  local list n event at stop
  list=$(jq -r --argjson before "$before" --argjson issues "$issues" --arg control "$control" '
    def nums($k): [.[$k] | arrays | .[] | objects | .number | numbers];
    def recent: .closedAt | strings | (try fromdateiso8601 catch null) | numbers
      | select(. >= now - 864000) | floor;
    def new($k; $s): ($s | nums($k)) - ($before | nums($k)) | .[] | "\(.) \($k)";
    . as $s
    | ($s | nums("completed")) as $done
    | (if $before == null then [] else $before | (nums("queued") + nums("running") + nums("stopped")) - nums("awaiting") end) as $was
    | (if $before == null then empty else new("awaiting"; $s), new("stopped"; $s) end),
      ($s.completed[] | . as $i
        | select($before == null or ($before | nums("completed") | any(. == $i.number) | not))
        | "\(.number) merged \(recent)"),
      ($issues[] | . as $i
        | select(.state == "CLOSED" and (.number | tostring) != $control and ($done | any(. == $i.number) | not))
        | select($before == null or ($was | any(. == $i.number)))
        | "\(.number) closed \(recent)")' "$live/status.json" 2>/dev/null) || return 0
  stop=$((SECONDS + 3 * $(tehas_analytics_wait)))
  while read -r n event at; do
    [ -n "$n" ] || continue
    if [ "$SECONDS" -ge "$stop" ]; then
      log "WARN analytics: out of time, the other events of this run are left out"
      break
    fi
    tehas_analytics event "$n" "$event" ${at:+--at "$at"}
  done <<<"$list"
}
[ "$written" = 0 ] || [ "$TEHAS_ANALYTICS" != on ] || record_events
exit 0
