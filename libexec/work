#!/usr/bin/env bash
# Run one pi-rukas /work cycle headless, in the sandbox image, and wait for it.
#
# The container's command is pi-rukas's one-shot runner, `pi-rukas-headless
# work <issue> --timeout <minutes> --json`. It writes one JSON result to its
# standard output and NDJSON progress to its error stream, and exits with a
# status of its own. Nothing is read from the cycle's tree: the outcome is the
# result, which this command writes to state/cycles/<issue>.result.json.
#
# Before anything is moved or fetched, the image is asked what it supports
# (`pi-rukas-headless --capabilities`). The cycle starts only when the image
# speaks the contract versions read here (exit codes 1, result schema 5, stable
# NDJSON 1), takes the flags passed, lists every PI_ENSEMBLE_* variable the
# container is given as an input a host may set, and has the features this
# command relies on: the host handoff channel, the cycle deadline when one is
# given and, with --restart, a restart that clears needs-human-attention.
# A refresh, a start whose approval record has how "refresh", passes
# --continue-pr (pi-rukas#1468): the cycle checks out the issue's open pull
# request, merges the branch into it and pushes to the same branch. An image
# that does not take the flag refuses the refresh with 78, before anything is
# moved; no other start passes it.
# Anything else is exit 78. So is an entry of TEHAS_RUKAS_WORKAROUNDS whose
# release the image's pi-rukas has reached: the workaround has expired.
#
# Four PI_ENSEMBLE_* values are this command's, whatever the instance says:
#   PI_ENSEMBLE_HANDOFF_CHANNEL=host  pi-rukas posts no handoff comment and
#                       applies no label; tehasbot cycle posts the one comment
#                       from the result's handoff and labels the issue.
#   PI_ENSEMBLE_HANDOFF_TIMEOUT_MS  the handoff allowance, 480000 (8 minutes,
#                       pi-rukas's own default): the time the cycle's handoff
#                       may take. It is the one allowance: the margin below
#                       is sized from it, so the handoff never lands on the
#                       container's stop.
#   PI_ENSEMBLE_CYCLE_DEADLINE   the time after which the cycle starts no new
#                       step and parks with cap "deadline", in milliseconds
#                       since the epoch: the start, plus TEHAS_WORK_TIMEOUT,
#                       less a margin. With an image whose --capabilities has
#                       features.cycleDeadlineHandoffAllowance the margin is
#                       the handoff allowance: that runner bounds every step
#                       by the deadline. Otherwise it is a quarter of the
#                       limit, or one run of the gate and the handoff
#                       allowance when that is longer, for a step that runs
#                       past the deadline. None when that leaves no time.
#                       PI_ENSEMBLE_CYCLE_BUDGET_MS is not passed.
#   PI_ENSEMBLE_VERIFY_CONCURRENCY  runs of the gate at once, from the
#                       container's share of the CPUs and memory ceiling
#                       (tehas_slice_verify).
#
# Usage: tehas work <issue-number> [--restart]
#
# Exit status: the runner's own when it ran and wrote its result:
#               0 merged, 10 handoff, 11 handoff for clarification,
#              20 aborted, 21 interrupted, 30 crash or its own time limit,
#              40 refused to start.
#              2 the cycle was stopped here as stalled or at the time limit
#                (status "timeout", state/cycles/<issue>.timed),
#                or the runner ended without a result.
#              A stall file holds the seconds and, on a second line, the step
#              in flight as the runner's progress last said it, or "-".
#              A runner that stopped itself at the time limit, its result
#              naming no cap and no end, keeps its own exit status; its status
#              is "timeout" and it leaves state/cycles/<issue>.timed too.
#              That file holds the limit in seconds, who stopped the cycle
#              (tehas or runner) and the step it was in.
#              3 the sandbox cannot push to the repository; no cycle was started.
#              4 no cycle was started. Where the dispatcher recorded its
#                approval: the issue's text is not the text it approved, the
#                approval could not be read, or the issue could not be read for
#                its text. Under tehasbot cycle (TEHAS_CYCLE_ATTEMPT set): no
#                approval of that start is on record and it was no start by
#                hand, the state store could not be read, or the image the
#                container starts from could not be put on the cycle's
#                record. Where the instance gives a cycle the issue's
#                images or files: one could not be fetched, the issue could not
#                be read for them, or a file is not the one first fetched for
#                that approval. In both cases the issue is told which, with no
#                host path in what it is told.
#              5 a cycle for this issue is running already; nothing was
#                touched.
#
#              It leaves state/cycles/<issue>.runner_exit beside the result:
#              the runner's own exit status, whatever this command exits with.
#              tehasbot cycle names that in its comment, not this status. A
#              container it saw killed leaves state/cycles/<issue>.status with
#              the word `killed`, which is the only account of the end when the
#              runner wrote no result at all. A container it watched to its end
#              that wrote no result and not one line of its stream leaves
#              state/cycles/<issue>.nostart with the container's own exit
#              status: one line, plain digits, 1 to 999, no sign and no leading
#              zero. tehasbot cycle makes that as tehas's own cap
#              `runner-never-started`. One this command stopped, killed outright
#              with no result, or ended at the time limit leaves no such note.
#
#             64 no bot token or no git identity; no cycle was started.
#             78 the instance settings are invalid, the state store is not
#                installed, tehas.slice is not
#                usable on this host, the image does not support what the
#                cycle is given, or the product names no gate in
#                .pi/verify-cmd and holds neither package.json nor Cargo.toml
#                at the commit the cycle's clone was made at; no cycle was
#                started, nothing was pushed, and the workspace made for the
#                cycle is left where it is.
#            137 the container was killed while the cycle was running: out of
#                memory, or stopped from outside. Not by this command's own
#                stop, and not once the runner wrote its result.
#
# Instance settings (lib/config.sh; defaults in brackets):
#   TEHAS_WORK_REPO     the product checkout a cycle is cloned from
#                       [$TEHAS_HOME/repos/<name>]
#   TEHAS_WORK_TIMEOUT  seconds a cycle may take [21600]. The runner is given
#                       them in whole minutes, at least 1, and stops itself;
#                       this command stops the container TEHAS_WORK_GRACE
#                       seconds later if it has not.
#   TEHAS_WORK_STALL    seconds with no line added to any of the cycle's logs
#                       before it is stopped as stalled [3600]
#   TEHAS_CYCLE_RESERVE the container's memory floor [2g]
#   TEHAS_RUKAS_WORKAROUNDS  settings that work around a pi-rukas defect, as
#                       NAME@VERSION: VERSION is the release that fixes it []
#   TEHAS_WORK_IMAGES   1 gives the cycle the images its issue links [0]
#   TEHAS_WORK_DESCRIBE 1 has the model describe those images first [0]
#   TEHAS_WORK_FILES    1 gives the cycle the text files its issue links [0]
#   TEHAS_WORK_COMMENTS 1 takes those of the issue's comments too [0]
#   TEHAS_WORK_ZIPS     1 unpacks a zip its issue links into the same
#                       directory [0]; needs TEHAS_WORK_IMAGES or
#                       TEHAS_WORK_FILES
# From the environment, for tests: TEHAS_PREFLIGHT_WAIT (seconds the push check
# may take [300]), TEHAS_WORK_GRACE (seconds past the time limit [300]),
# TEHAS_STOP_WAIT (seconds a docker stop may take before
# the container is killed [60]), TEHAS_CONSOLE_WAIT (seconds the console
# may take to stop before it is killed [30]) and TEHAS_TEXT_WAIT (seconds the
# read of the issue's text may take, and every comment that names why a start
# stopped [60]).
#
# TEHAS_WORK_TIMEOUT bounds the watch loop. Every call to Docker or git
# outside it is bounded too: a dockerd that stops answering, or a network
# that swallows the push check, must not hold the issue's lock and its slot
# for ever.
#
# What the container is given is deliberate and pinned by test/work_test.sh:
# the bot token (pi-rukas pushes and opens the pull request from inside), the
# PI_ENSEMBLE_* settings, the bot's git identity, the cycle's workspace, and a
# directory of its own for what it writes: its copy of the code index, its
# memory and Pi's sessions. Nothing it writes there is what a later cycle of
# another issue reads. Not the Docker socket, SSH keys or ~/.config/tehas.
#
# With TEHAS_WORK_IMAGES=1 it is given two things more: the issue's images,
# read-only, and PI_ENSEMBLE_EXTRA_IMAGE_DIRS, their path inside the container.
# The images are fetched here, before anything starts:
#   which     Links to GitHub's own attachment storage in the issue's text.
#             Comments only with TEHAS_WORK_COMMENTS=1, and only from the
#             record: see below. Only when an allowed
#             account approved the start, or the issue was opened by an owner,
#             member or collaborator. Where the dispatcher recorded its
#             approval on the state store, the links are the approval's and
#             the approver its own; a body whose hash is not the approval's
#             stops the start. By hand, without one, the links are the body's
#             and the approver is who applied the last tehas:ready.
#   types     png, jpg, webp and gif, told by the file's first bytes. Not svg:
#             it is text and can carry instructions.
#   how much  At most 8 images and 10 megabytes together.
#
# With TEHAS_WORK_FILES=1 it is given the same directory and the same variable,
# whether or not TEHAS_WORK_IMAGES is 1, and the directory holds the issue's
# text files too, by the same rule of which links and whose approval:
#   types     md, txt, csv, json, yaml, yml, log, html, css and js, by the
#             name's extension, then checked: valid UTF-8 and no NUL byte.
#             html is text here; rendering it is the Protolab's job.
#   how much  At most 16 files, 1 megabyte each and 4 megabytes together.
# They are named file-1.md and so on and listed under "files" in the manifest
# with their original name. The pi-rukas that tehas pins does not read them
# yet.
#
# With TEHAS_WORK_ZIPS=1 the same directory also holds what a zip the issue
# links contains, and this adds no mount and no variable more:
#   which     A link whose first four bytes are those of a zip archive, not one
#             named .zip that is something else: that is left out and said.
#             At most 2 archives per issue, each downloaded at most 4 MB.
#   what      Every file of the archive through the checks above: an image by
#             its first bytes, a text file by its extension and its encoding.
#             Anything else, an svg or a nested archive among them, is left
#             out with its path in the archive and the reason.
#   how much  The unpacked files count against the limits above, the images'
#             and the files', as the ones the issue links do. The archive is
#             unpacked on the room left of the files' 4 MB.
# They are named on from the linked ones, image-1.png and file-1.md, and each
# manifest entry says the zip it came from under "zip" and its path inside the
# archive under "path". The archive itself is not kept, and the directory it
# was unpacked into is removed whatever it held.
# They go to $TEHAS_HOME/work/<name>-<issue>.images, beside the workspace and
# not in it, so a patch cannot commit them, under names made here, with a
# manifest.json that lists each file, the link it came from, its type, size
# and sha256, the approval, and what was left out and why. The directory is
# remade for every cycle. The manifest is kept as
# state/cycles/<issue>.manifest.json, with images.md and retry-context.md
# beside it as <issue>.images.md and <issue>.retry-context.md when the cycle
# has them, for the improvement loop's record, and a later fetch of the same
# approval whose link gives other bytes stops the start. An image that is left
# out is said in a comment on the issue, and each one given with its sha256.
# That comment says whether the cycle was shown them, which is what the sandbox
# image's own label answers: only when it says its pi-rukas reads the manifest
# does tehas say a cycle was given images. An image that could not be fetched
# stops the start: a cycle that works without a picture the issue relies on
# builds the wrong thing.
#
# With TEHAS_WORK_COMMENTS=1 the record's comment_links are fetched too, after
# the body's links, under the same limits counted together: links of comments
# an allowed account wrote and nobody edited after the approval, as the
# dispatcher found them. Each is taken only while its author is still allowed.
# Every manifest entry has a source, "body", "comment:<id>" or, for a retry,
# "pr-comment:<id>". By hand there is no record, and only the body is read. A
# record of a retry tick may carry retry_context, what reviewers wrote on the
# pull request: it goes to retry-context.md in the same directory, headed as
# untrusted, every line quoted, cut at 32000 characters. No mount and no
# variable more.
#
# With neither setting a cycle is given nothing: no directory is mounted and
# no PI_ENSEMBLE_EXTRA_IMAGE_DIRS is passed on, whatever the instance file
# says. The issue is still read once, for its text, and held to the
# dispatcher's record (exit 4). That one read is the one the images and the
# files are fetched from too, so a start asks GitHub for the issue once
# whatever it is given. By hand, where this host holds no record, the run is
# its own approval and GitHub is asked for nothing.
# When the dispatcher's approval
# record lists attachment links, the gap is said rather than left for an agent
# to find from a file that is not there: one line naming how many links and
# which approval it read, on this command's error stream and in $log.err,
# which is err.txt of the cycle's improvement record, and a manifest kept as
# state/cycles/<issue>.manifest.json. What the line and the manifest say, and
# why, is tehas_issue_images_left_out.
#
# A cycle that ended at a cap, or was aborted, with nothing in $log.err gets that
# account there: the cap with the reason the progress read for it, or the abort
# that ended the cycle with no cap, the lines of the cycle's own stream that carry
# the driver's own warning, kill, failure or cancellation, and the name of the
# file that holds them all. Never a claim that the record says nothing more
# without looking at the stream first.
#
# With TEHAS_WORK_DESCRIBE=1 the model endpoint describes each image in words
# first (lib/describe.sh), into images.md in the same directory, for the steps
# that are not shown the pixels. It is in the directory already mounted: no
# mount and no variable more. A description that fails says so in the file and
# stops nothing.
#
# The container runs in tehas.slice, as every sandbox container does, with the
# limits lib/slice.sh makes: a memory ceiling of a quarter of the slice, no
# swap, the reserve as its floor, a CPU quota of the host less one CPU, a pids
# limit that follows its share of that and a CPU weight.
# It has an init (--init): Pi collects only its own children, and a process
# that outlives its parent would count against the pids limit until the
# container ends. A pass of the shell tests leaves several hundred.
# Without a usable slice nothing is cloned and nothing starts. The check that
# the sandbox can push is a container of a few seconds and is not in the slice.
#
# Which approval is this start's: under tehasbot cycle, TEHAS_CYCLE_ATTEMPT
# names the attempt the state store gave the start, and only the approval that
# attempt used counts (tehas_approval_view, lib/store.sh). A start the store
# has on record as one by hand is a run by hand. Anything else stops the start
# with exit 4: a store that cannot be read is never taken for a run by hand.
# Run on its own (tehas work by hand), the approval of the issue's latest start
# counts, and none is a run by hand.
#
# As the container starts, the image's id and the pi-rukas commit of its label
# tehas.rukas go on the cycle's record on the state store (cycle-image), for
# the cycle's report. So do the PI_ENSEMBLE_* values the container is given,
# the TEHAS_* settings that shape a cycle and how many cycles hold their lock,
# this one with them (lib/improve.sh). Only under tehasbot cycle: a run on its
# own has no attempt to put them on.
#
# Docker writes the container's id to state/cycles/<issue>.cid, which is how
# the dispatcher tells this cycle's container from the others in the slice.
# The file is removed at the end. While the cycle runs, this command reads how
# many processes the kernel killed for memory in the container, from the
# container's own cgroup. A count above 0 is printed and left in
# state/cycles/<issue>.oom for tehasbot cycle. The starts of a process that the
# pids limit refused are counted the same way, into state/cycles/<issue>.forks.
#
# It holds the issue's lock, state/cycles/<issue>.lock, for as long as it
# runs, so a run by hand and the unit's cycle never share a workspace. Under
# tehasbot cycle it inherits that lock as fd 9, already held, and goes on.
#
# The workspace is $TEHAS_HOME/work/<name>-<issue>, a fresh clone made here for
# every cycle. What a stopped cycle of the same issue left there is kept
# beside it as <name>-<issue>.before-retry. Every cycle has its workspace at the same path inside its
# container, $TEHAS_HOME/work/<name>: the code index is kept under that path,
# so one index serves all cycles. The container never sees the product
# checkout: an agent can write anything into the tree it works in, hooks and
# git configuration included, and the host runs git in the product checkout.
# So the host runs git only in a tree no container has touched, and reads
# nothing from the workspace afterwards.
#
# Beside the workspace is <name>-<issue>.state, the cycle's own: cache holds its
# copy of the code index $TEHAS_HOME/state/index, memory its own store of what
# its agents learned, sessions Pi's session files. It is made fresh for every
# cycle and removed with the workspace by tehasbot cycle. The cycle's agents
# index nothing of another cycle's and their caches start cold.
#
# The agents' transcripts go to ~/.pi/agent/ensemble-runs/issue-<issue>, so a
# cycle sees its own and the console shows no other cycle's agents.
#
# A cycle that writes nothing is stopped before its time limit. While the
# runner's progress, its error stream and the agents' transcripts all stay as
# they are for TEHAS_WORK_STALL seconds, the cycle is taken as stalled: a step
# that hangs on a child process, or a gate that never returns, does not hold a
# slot for hours. The status is then "stalled", and state/cycles/<issue>.stalled
# holds the seconds and the step in flight for tehasbot cycle, as .timed does.
# The limit is longer than one run of the product's gate may take, which can
# print nothing.
#
# The console and the dashboard's line are fed from the stable kinds of the
# runner's NDJSON only. At the end, the per-role usage and why the cycle
# stopped at its cap go to state/cycles/<issue>.progress.json for the report
# (tehas_headless_progress). They come from the result where the image's
# --capabilities answer says it carries them (features.usageByRole,
# features.failureReason). An image that does not (v0.12.80) gives the usage
# of the stable dispatch-completed lines and a reason read from lines the
# runner marks unstable, which may be empty.
set -uo pipefail

issue=${1:-}
case "$issue" in '' | *[!0-9]*) echo "usage: tehas work <issue-number> [--restart]" >&2; exit 64 ;; esac
flags=""
[ "${2:-}" = "--restart" ] && flags=" --restart"

here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source=lib/config.sh
. "$here/../lib/config.sh"
# shellcheck source=lib/sandbox.sh
. "$here/../lib/sandbox.sh"
# shellcheck source=lib/live.sh
. "$here/../lib/live.sh"
# shellcheck source=lib/slice.sh
. "$here/../lib/slice.sh"
# shellcheck source=lib/attachments.sh
. "$here/../lib/attachments.sh"
# shellcheck source=lib/describe.sh
. "$here/../lib/describe.sh"
# shellcheck source=lib/labels.sh
. "$here/../lib/labels.sh"
# shellcheck source=lib/fixer.sh
. "$here/../lib/fixer.sh"
# shellcheck source=lib/cycles.sh
. "$here/../lib/cycles.sh"
# shellcheck source=lib/improve.sh
. "$here/../lib/improve.sh"
# shellcheck source=lib/headless.sh
. "$here/../lib/headless.sh"
# shellcheck source=lib/private.sh
. "$here/../lib/private.sh"
# shellcheck source=lib/github-app.sh
. "$here/../lib/github-app.sh"
# shellcheck source=lib/sizing.sh
. "$here/../lib/sizing.sh"
# shellcheck source=lib/store.sh
. "$here/../lib/store.sh"
tehas_load || exit 78
tehas_require TEHAS_REPO PI_ENSEMBLE_SUBAGENT_MODEL PI_ENSEMBLE_SUBAGENT_PROVIDER
# Every start reads an approval from the store.
if ! tehas_store_ready; then
  echo "tehas work: ERROR: the state store is not installed (run install.sh)" >&2
  exit 78
fi
tehas_sandbox_settings_ok || exit 78
# Docker would create a missing mount source as a root-owned directory.
tehas_checkout || exit 78
branch=$(tehas_branch) || exit 78
# No container starts outside the slice, and none with half its limits.
TEHAS_SLICE_LIMITS=()
tehas_slice_ok || { echo "tehas work: $TEHAS_SLICE_WHY" >&2; exit 78; }
tehas_slice_limits || true
if [ "${#TEHAS_SLICE_LIMITS[@]}" != 14 ] || [ "${TEHAS_SLICE_LIMITS[1]}" != tehas.slice ]; then
  echo "tehas work: the container limits could not be made, not starting" >&2
  exit 78
fi
src=$TEHAS_WORK_REPO
# The workspace inside the container, and the directory on the host behind it.
repo=$TEHAS_WORK_DIR
tree=$TEHAS_WORK_DIR-$issue
# The issue's images on the host, and where the container has them.
images=$tree.images
images_inside=$repo.images
image=$PI_ENSEMBLE_IMAGE
limit=$TEHAS_WORK_TIMEOUT
# The runner's NDJSON progress, which it writes to its error stream. Named as
# the improvement loop looks for it.
log=$TEHAS_HOME/logs/work-$issue-$(date -u +%y%m%d-%H%M%S).jsonl
name=tehas-work-$issue
agent=$HOME/.pi/agent
runs=$agent/ensemble-runs/issue-$issue
# The cycle's own state on the host, beside the workspace and not in it.
container=$tree.state
index=$(tehas_index_dir)
cid_file=$TEHAS_HOME/state/cycles/$issue.cid
oom_file=$TEHAS_HOME/state/cycles/$issue.oom
forks_file=$TEHAS_HOME/state/cycles/$issue.forks
stall_file=$TEHAS_HOME/state/cycles/$issue.stalled
timed_file=$TEHAS_HOME/state/cycles/$issue.timed
# The ledger of the sizes tehas work records at an approved start, kept by
# tehas_size_record (lib/sizing.sh), which says what it holds and how long.
sizes_file=$TEHAS_HOME/state/sizes.jsonl
# The manifest of the last fetch, kept.
kept=$TEHAS_HOME/state/cycles/$issue.manifest.json
result_file=$TEHAS_HOME/state/cycles/$issue.result.json
progress_file=$TEHAS_HOME/state/cycles/$issue.progress.json
# The runner's own exit status, written below for tehasbot cycle to report, and
# the word of the end this command saw of the container: `killed` for one it saw
# killed. Both are read and removed by tehasbot cycle.
runner_exit_file=$TEHAS_HOME/state/cycles/$issue.runner_exit
status_file=$TEHAS_HOME/state/cycles/$issue.status
# The word of the end for a container that wrote no result and no line of its
# stream: its own exit status, one line of plain digits. Read and removed by
# tehasbot cycle.
nostart_file=$TEHAS_HOME/state/cycles/$issue.nostart
stall=$TEHAS_WORK_STALL
preflight_wait=${TEHAS_PREFLIGHT_WAIT:-300}
grace=${TEHAS_WORK_GRACE:-300}
[[ $grace =~ ^[0-9]{1,5}$ ]] || grace=300
caps_wait=${TEHAS_CAPS_WAIT:-120}
[[ $caps_wait =~ ^[1-9][0-9]{0,3}$ ]] || caps_wait=120
stop_wait=${TEHAS_STOP_WAIT:-60}
console_wait=${TEHAS_CONSOLE_WAIT:-30}
[[ $console_wait =~ ^[1-9][0-9]{0,3}$ ]] || console_wait=30
text_wait=${TEHAS_TEXT_WAIT:-60}
[[ $text_wait =~ ^[1-9][0-9]{0,3}$ ]] || text_wait=60

tehas_github_env || { echo "tehas work: no GitHub token for the app" >&2; exit 1; }
[ -n "${GH_TOKEN:-}" ] || { echo "tehas work: GH_TOKEN is not set (source ~/tehas/env.sh)" >&2; exit 64; }
mkdir -p "$TEHAS_HOME/logs" "$TEHAS_HOME/state/cycles"
# Before anything is moved: a second run would move the running cycle's tree
# from under it. tehasbot cycle hands its own lock down as fd 9, and taking it
# again through that fd succeeds.
lock=$TEHAS_HOME/state/cycles/$issue.lock
[ /dev/fd/9 -ef "$lock" ] 2>/dev/null || exec 9>"$lock"
flock -n 9 || { echo "tehas work: a cycle for #$issue is running, not starting another" >&2; exit 5; }

# What the dispatcher approved for this start, from the state store, as a
# private file in the shape the readers below know (tehas_approval_view). It
# goes when this command ends. Read before anything of the cycle is written;
# what stops a start for it is said below, with the issue's text.
record=""
record_why=""
attempt=${TEHAS_CYCLE_ATTEMPT:-}
trap 'rm -f "${record:-}"' EXIT
if [ -n "$attempt" ]; then
  if ! [[ $attempt =~ ^[1-9][0-9]{0,8}$ ]]; then
    record_why="its start names no attempt this host can read"
  else
    record=$(tehas_approval_view "$issue" "$attempt")
    case $? in
      0) ;;
      1)
        # None used by this start: a start by hand, as the store has it, or
        # one whose approval is gone.
        record=""
        if ! tehas_store cycle-show "$issue"; then
          record_why="the approval of this start could not be read"
        elif [ "$(jq -r --argjson a "$attempt" '.cycle | select(. != null and .attempt == $a) | .how' \
          <<<"$tehas_store_out" 2>/dev/null)" != hand ]; then
          record_why="no approval of this start is on record"
        fi
        ;;
      *)
        record=""
        record_why="the approval of this start could not be read"
        ;;
    esac
  fi
else
  record=$(tehas_approval_view "$issue")
  case $? in
    0) ;;
    1) record="" ;;
    *)
      record=""
      record_why="the approval of this issue could not be read"
      ;;
  esac
fi

# The bot's identity is the tehas user's own. What the container is given is
# assembled in lib/sandbox.sh, which tehas dev uses too.
bot_name=$(git config --global user.name || true)
bot_email=$(git config --global user.email || true)
[ -n "$bot_name" ] && [ -n "$bot_email" ] ||
  { echo "tehas work: git user.name and user.email are not set for $(id -un)" >&2; exit 64; }
# The images and the text files share one directory, given to the container
# when the instance gives either kind.
give=0
kinds=images
if [ "$TEHAS_WORK_FILES" = 1 ]; then
  give=1
  kinds=files
  [ "$TEHAS_WORK_IMAGES" != 1 ] || kinds="images and files"
fi
[ "$TEHAS_WORK_IMAGES" != 1 ] || give=1
# Its path is this command's to give, not the instance's: dropped whether or
# not this cycle is given attachments, so no container names a directory tehas
# did not mount.
unset PI_ENSEMBLE_EXTRA_IMAGE_DIRS
# So are who reports a handoff, the time it may take, the cycle's deadline and
# how many gate runs it makes at once.
unset PI_ENSEMBLE_HANDOFF_CHANNEL PI_ENSEMBLE_HANDOFF_TIMEOUT_MS PI_ENSEMBLE_CYCLE_DEADLINE PI_ENSEMBLE_CYCLE_BUDGET_MS PI_ENSEMBLE_VERIFY_CONCURRENCY
mapfile -d '' -t envs < <(tehas_sandbox_env "$repo" "$bot_name" "$bot_email")
mapfile -d '' -t hosts < <(tehas_sandbox_hosts)
mapfile -d '' -t sec < <(tehas_sandbox_security)
if ! { [ "${#sec[@]}" -gt 0 ] && [ "${#sec[@]}" -eq "$(tehas_sandbox_security_count)" ] &&
      tehas_sandbox_security_ok; }; then
  echo "tehas work: tehas_sandbox_security gave ${#sec[@]} words, wants $(tehas_sandbox_security_count): not starting a cycle" >&2
  exit 78
fi
[ "${#envs[@]}" -gt 0 ] ||
  { echo "tehas work: could not prepare the sandbox, not starting a cycle" >&2; exit 78; }
verify_at_once=$(tehas_slice_verify) ||
  { echo "tehas work: the container limits could not be made, not starting" >&2; exit 78; }
# The handoff allowance, in seconds: the one budget the cycle's handoff has,
# given to pi-rukas and kept clear of the stop by the margin below.
handoff=480
# tehasbot cycle posts the one comment of a handoff and labels the issue.
envs+=(-e PI_ENSEMBLE_HANDOFF_CHANNEL=host -e "PI_ENSEMBLE_HANDOFF_TIMEOUT_MS=$((handoff * 1000))"
  -e "PI_ENSEMBLE_VERIFY_CONCURRENCY=$verify_at_once")
features=handoffChannel
# The runner by its path in the image: the link to it on PATH does not find
# its own source (pi-rukas v0.12.80).
runner=/opt/pi-rukas/bin/pi-rukas-headless
# What the image supports, asked before anything is moved or fetched. The
# answer is checked below, once everything the cycle is given is known.
caps=$(timeout -k 10 "$caps_wait" docker run --rm --init "$image" "$runner" --capabilities 2>/dev/null)
caps_rc=$?
# No step starts after the deadline: the cycle parks with a handoff instead.
# A runner whose answer has features.cycleDeadlineHandoffAllowance bounds
# every step by the deadline and keeps its handoff inside the allowance
# (pi-rukas#1603), so the deadline is the limit less the allowance. With any
# other runner a step that started before the deadline may run past it, so
# the margin holds the longest step there is room for and then the handoff:
# a quarter of the limit, and never less than one run of the gate and the
# handoff allowance.
if [ "$(tehas_headless_mode "$caps" cycleDeadlineHandoffAllowance)" = native ]; then
  margin=$handoff
else
  margin=$((limit / 4))
  [ "$margin" -ge $((TEHAS_VERIFY_TIMEOUT + handoff)) ] || margin=$((TEHAS_VERIFY_TIMEOUT + handoff))
fi
if [ "$margin" -lt "$limit" ]; then
  envs+=(-e "PI_ENSEMBLE_CYCLE_DEADLINE=$(((EPOCHSECONDS + limit - margin) * 1000))")
  features+=" cycleDeadline"
else
  echo "tehas work: the time limit of ${limit}s leaves no room for a deadline before it, the cycle has none"
fi

# A fresh workspace for this cycle, at the tip the product checkout last
# fetched for the branch. A workspace is still here only when this issue's last
# cycle stopped without a pull request, and what it holds may exist nowhere
# else: commits that were never pushed. It is moved aside, not removed, and
# replaces the one moved aside before it. No container is given it and the
# host runs nothing in it. Only a directory this command made is ever moved or
# removed, and never another issue's.
works=$(dirname "$tree")
if [ -e "$works" ] && [ ! -f "$works/.tehas-workspaces" ]; then
  echo "tehas work: $works exists and was not made by tehas, not touching it" >&2
  exit 78
fi
run_flags=(--timeout "$(((limit + 59) / 60))" --json)
[ -z "$flags" ] || { run_flags+=(--restart); features+=" restartClearsAttention"; }
if tehas_record_is_file "$record" && [ "$(jq -r '.how // "" | strings' "$record" 2>/dev/null)" = refresh ]; then
  run_flags+=(--continue-pr)
fi
# What the image supports, against what this cycle is given.
names=""
for e in "${envs[@]}"; do
  case "$e" in PI_ENSEMBLE_*) names+=" ${e%%=*}" ;; esac
done
[ "$give" != 1 ] || names+=" PI_ENSEMBLE_EXTRA_IMAGE_DIRS"
if [ "$caps_rc" != 0 ] || ! unsupported=$(tehas_headless_unsupported "$caps" "${run_flags[*]}" "$names" "$features"); then
  echo "tehas work: $image gave no --capabilities answer (exit $caps_rc), not starting a cycle" >&2
  exit 78
fi
if [ -n "$unsupported" ]; then
  echo "tehas work: $image does not support what this cycle is given, not starting a cycle:" >&2
  printf '%s\n' "$unsupported" | sed 's/^/    /' >&2
  exit 78
fi
# A workaround the instance carries for a pi-rukas defect ends with the
# release that fixes it.
expired=$(tehas_headless_expired "$caps" "$TEHAS_RUKAS_WORKAROUNDS")
if [ -n "$expired" ]; then
  echo "tehas work: TEHAS_RUKAS_WORKAROUNDS names a workaround this image no longer needs, not starting a cycle:" >&2
  printf '%s\n' "$expired" | sed 's/^/    /' >&2
  echo "    Remove the setting and its entry from $TEHAS_INSTANCE_DIR/instance.env." >&2
  exit 78
fi

# The words a cycle works on are the words somebody approved. The dispatcher
# wrote what it approved into its record; read the issue once here, before
# anything of this cycle is written, and hold it to that, so a body or a title
# edited after the label starts no cycle. This is the last place on the host that
# can still compare them, and it compares as it starts: what the container reads
# afterwards is the issue as it is then. The title is bound here as well as by
# the dispatcher's read of the label events: the record carries its hash, and a
# record that carries none is checked on the body alone.
# Where this host holds no record the run is by hand, and the person who ran
# this command is the approval.
text_why="" # why this start stops, empty when the text is the approved one
text_path="" # the record that could not be read, when that is the reason
issue_now="" # the issue as GitHub answers for it now, read once for all of it
measured=0 # 1 when this start had an approval record, and so a body to measure
if [ -n "$record_why" ]; then
  text_why=$record_why
elif tehas_record_is_file "$record"; then
  measured=1
  # Bounded like every other call before the container: a network that swallows
  # this read must not hold the issue's lock and its slot for ever. gh's own
  # words go to $log.err, where a person can see which failure it was.
  issue_now=$(timeout -k 10 "$text_wait" gh api "repos/$TEHAS_REPO/issues/$issue" 2>>"$log.err")
  issue_rc=$?
  case $issue_rc in
    0) ;;
    124 | 137) text_why="the issue could not be read for its text: no answer within ${text_wait}s" ;;
    *) text_why="the issue could not be read for its text: GitHub refused the read" ;;
  esac
  if [ -z "$text_why" ]; then
    # An answer that is a pull request, or an issue nobody can start a cycle
    # on, is refused before its text is hashed or anything is said on it.
    case $(jq -r 'if type != "object" or (.body != null and (.body | type) != "string") then "unread"
        elif .pull_request != null or ((.state // "") != "open") then "wrong" else "ok" end' \
      <<<"$issue_now" 2>/dev/null) in
      ok) tehas_approval_text "$record" "$issue_now" ;;
      wrong) text_why="#${issue} is not an open issue, as GitHub answers for it" ;;
      *) text_why="the issue could not be read for its text" ;;
    esac
  fi
else
  echo "tehas work: no approval is recorded on this host for #$issue; a run by hand is its own approval" >&2
fi
if [ -n "$text_why" ]; then
  # The path of the record stays on the host. What the issue is told names which
  # rule stopped the start, and nothing of where this instance keeps its state.
  echo "tehas work: $text_why${text_path:+ ($text_path)}, not starting a cycle" >&2
  timeout -k 10 "$text_wait" gh issue comment "$issue" --repo "$TEHAS_REPO" \
    --body "Tehas started no cycle: $text_why. To retry, apply \`tehas:ready\`." >/dev/null 2>&1 ||
    echo "tehas work: the comment on #$issue failed" >&2
  exit 4
fi

# What the cycle starts with, measured. Only a start that had the approval
# record to check is measured: the body is the one in $issue_now, already read
# above, so this asks GitHub nothing more, and a run by hand, which has no
# approved body, records nothing. lib/sizing.sh says what the ledger is and
# keeps it bounded. A line that cannot be written is one word on this command's
# error stream: the measure is a record of the start, never a reason to stop
# one.
if [ "$measured" = 1 ]; then
  mkdir -p "$(dirname "$sizes_file")" 2>/dev/null || true
  size_body=$(jq -r 'if (.body | type) == "string" then .body else "" end' <<<"$issue_now" 2>/dev/null) || size_body=""
  if ! tehas_size_record "$issue" "$size_body" "$sizes_file"; then
    echo "tehas work: could not record the size of #$issue in $sizes_file ($tehas_size_why), starting the cycle all the same" >&2
  fi
fi

# The issue's images, where the instance gives a cycle any. Before the
# workspace: a start that fails here must not move aside what the last cycle
# left.
if ! { mkdir -p "$works" && : >"$works/.tehas-workspaces"; }; then
  echo "tehas work: could not make $works, not starting a cycle" >&2
  exit 78
fi
image_opts=()
if [ "$give" = 1 ]; then
  approved=""
  if tehas_record_is_file "$record"; then
    # The dispatcher's record of the start: who approved and which links.
    from=$record
    # A start of the fixer's counts on the person's approval it rests on.
    if tehas_allowed_labeler "$(jq -r '.by // ""' "$record" 2>/dev/null)" ||
      { tehas_fixer_is "$(jq -r '.by // ""' "$record" 2>/dev/null)" && tehas_fixer_base "$record" >/dev/null; }; then
      approved=approved
    fi
  else
    # By hand. The label approved the text, links and all.
    from=""
    tehas_label_allowed "$issue" tehas:ready
    case $? in
      0) approved=approved ;;
      2) approved=unread ;;
    esac
  fi
  image_why="the issue's label events could not be read for its images"
  if [ "$approved" = unread ] || ! tehas_issue_images "$issue" "$images" "$approved" "$from" "$issue_now" ||
    ! tehas_issue_images_changed "$kept" "$images"; then
    rm -rf "$images"
    echo "tehas work: $image_why, not starting a cycle" >&2
    timeout -k 10 "$text_wait" gh issue comment "$issue" --repo "$TEHAS_REPO" --body "Tehas started no cycle: $image_why. This instance gives a cycle the $kinds an issue links, and a cycle that works without one of them may build the wrong thing. To retry, apply \`tehas:ready\`." >/dev/null 2>&1 ||
      echo "tehas work: the comment on #$issue failed" >&2
    exit 4
  fi
  if [ "$TEHAS_WORK_DESCRIBE" = 1 ] && ! tehas_describe_images "$images"; then
    echo "tehas work: the descriptions of the images could not be written, the cycle goes on without them" >&2
  fi
  { cp "$images/manifest.json" "$kept.new" && mv "$kept.new" "$kept"; } 2>/dev/null ||
    echo "tehas work: could not keep the manifest as $kept" >&2
  # Kept beside it for the improvement loop's record: the directory is removed
  # when the cycle ends. Only this cycle's: an earlier one's would mislead.
  for f in images.md retry-context.md; do
    rm -f "${kept%.manifest.json}.$f"
    [ ! -f "$images/$f" ] || cp "$images/$f" "${kept%.manifest.json}.$f" 2>/dev/null ||
      echo "tehas work: could not keep $f beside $kept" >&2
  done
  said=$(tehas_issue_images_said "$images" cycle "$(tehas_rukas_reads_images)")
  if [ -n "$said" ]; then
    gh issue comment "$issue" --repo "$TEHAS_REPO" --body "$said" >/dev/null 2>&1 ||
      echo "tehas work: the comment on #$issue failed" >&2
  fi
  image_opts=(-v "$images:$images_inside:ro" -e "PI_ENSEMBLE_EXTRA_IMAGE_DIRS=$images_inside")
fi

aside() {
  [ -e "$tree" ] || return 0
  rm -rf "$tree.before-retry" && mv "$tree" "$tree.before-retry"
}
if ! { mkdir -p "$works" && : >"$works/.tehas-workspaces" && aside &&
  rm -rf "$container" && tehas_sandbox_clone "$src" "$tree" "$branch" &&
  # pi-rukas writes these into the tree; excluded here, a product needs no
  # .gitignore lines for them and a cycle never commits them.
  printf '%s\n' /.pi/work-state/ /.pi/permissions.json /.pi/decisions.json >>"$tree/.git/info/exclude"; }; then
  echo "tehas work: could not make the workspace $tree, not starting a cycle" >&2
  exit 78
fi
# The product names its gate in .pi/verify-cmd: the first line that is not
# empty and not a comment. pi-rukas reads that file; nothing here read it, so a
# product on a stack it cannot guess - neither package.json nor Cargo.toml -
# ran cycles that verified nothing and still opened a pull request. Read the
# clone on the host: the tree is a container's to write, not to run, and one
# that has not started has written nothing.
#
# Only the commit the clone was made at is read, and only through git: origin
# was fetched from the checkout, so the checkout's own worktree is not read at
# all. A file that is not in the commit is not read either, so what a person
# leaves uncommitted or untracked in the tree they work in cannot park a cycle
# or start one. With no gate tehas still runs a cycle when the stack is one
# pi-rukas can guess a gate for, so only a product with none of the three
# parks. The check is one of presence: pi-rukas takes any file at those paths
# for a gate, so a stub satisfies it. It is a start-cost guard, not proof that
# a real gate exists.
gate=$(timeout -k 10 60 git -C "$tree" show "origin/$branch:.pi/verify-cmd" 2>/dev/null |
  sed -n '/^[[:space:]]*[#]/d; /^[[:space:]]*$/d; p; q')
stack=$(timeout -k 10 60 git -C "$tree" ls-tree --name-only "origin/$branch" -- \
  package.json Cargo.toml 2>/dev/null | head -n 1)
if [ -z "$gate" ] && [ -z "$stack" ]; then
  echo "tehas work: $TEHAS_REPO has no .pi/verify-cmd and no package.json or Cargo.toml in origin/$branch, so a cycle could verify nothing" >&2
  echo "tehas work: $tree is left in place with what it holds, and $tree.before-retry holds what the last cycle left, if any" >&2
  exit 78
fi
# Before spending an hour of model time: can the sandbox push at all? A dry
# run needs the same credentials a real push does and creates nothing. The
# client passes the timeout's TERM on to git in the container.
timeout -k 10 "$preflight_wait" docker run --rm "${sec[@]}" --user "$(id -u):$(id -g)" -e HOME=/home/vscode "${envs[@]}" \
  -w "$repo" -v "$tree:$repo" --entrypoint git "$image" \
  push --dry-run origin HEAD:refs/heads/tehas-preflight >"$log.preflight" 2>&1
pushed=$?
if [ "$pushed" != 0 ]; then
  case $pushed in 124 | 137) echo "the push check did not end within ${preflight_wait}s" >>"$log.preflight" ;; esac
  echo "tehas work: the sandbox cannot push to origin, not starting a cycle:"
  tail -n 3 "$log.preflight" | sed 's/^/    /'
  exit 3
fi
retry=$(tehas_sandbox_retry "$tree")
echo "$retry" >>"$log.preflight"
echo "tehas work: $retry"
# The cycle's own copy of the host's code index, asked for only once this cycle
# can start: a cycle that never began leaves no copy behind. Without one the
# agents search by reading files, which is slower and finds less; a copy that
# fails is not worth stopping a cycle for.
tehas_sandbox_seed "$container" "$index" ||
  echo "tehas work: the code index could not be copied into $container/cache, this cycle searches without one"
# The mounts name directories that only exist now.
mapfile -d '' -t mounts < <(tehas_sandbox_mounts "$repo" "$tree" "$container" "$runs")
[ "${#mounts[@]}" -gt 0 ] ||
  { echo "tehas work: could not prepare the sandbox, not starting a cycle" >&2; exit 78; }
while read -r model_provider _; do
  [ -n "$model_provider" ] || continue
  echo "model endpoint: provider $model_provider is on its backup" >>"$log.preflight"
  echo "tehas work: model endpoint: provider $model_provider is on its backup"
done <"$container/endpoints"

# Said only once the cycle can start: a start that fails at the workspace or
# the push check leaves no claim about a cycle that never ran. The line is the
# library's, so this command prints what it composed.
if [ "$give" != 1 ]; then
  tehas_issue_images_left_out "$issue" "$kept" "$record"
  case $? in
    0) gap_said="tehas work: $image_gap" ;;
    2) gap_said="tehas work: the approval record of issue $issue, or the manifest kept for it, could not be read: nothing is said about what this cycle was not given" ;;
    *) gap_said="" ;;
  esac
  if [ -n "$gap_said" ]; then
    printf '%s\n' "$gap_said" >&2
    printf '%s\n' "$gap_said" >>"$log.err" || echo "tehas work: could not write $log.err" >&2
  fi
fi

# Docker refuses a cid file that is already there. One is left only by a cycle
# that was killed outright, and so is a count of kills, and so is the name a
# write of one of these files was made beside before it was moved into place.
rm -f "$cid_file" "$oom_file" "$forks_file" "$stall_file" "$timed_file" "$result_file" "$progress_file" "$runner_exit_file" "$status_file" \
  "$nostart_file" "$nostart_file.new" \
  "$runner_exit_file.new" "$status_file.new"
# A container under this name outlived the client that started it: this
# command holds the issue's lock, so no cycle owns it. It would work on with
# the bot's token, and Docker would refuse the name below.
timeout -k 10 "$stop_wait" docker rm -f "$name" >/dev/null 2>&1

# stop_container <grace>: docker stop, bounded. When dockerd does not answer
# in time the container is killed, also bounded: the end must be reported.
stop_container() {
  timeout -k 5 "$stop_wait" docker stop -t "$1" "$name" >/dev/null 2>&1
  case $? in 124 | 137) ;; *) return 0 ;; esac
  echo "tehas work: docker stop of $name did not end within ${stop_wait}s, killing it"
  timeout -k 5 "$stop_wait" docker kill "$name" >/dev/null 2>&1 ||
    echo "tehas work: docker kill of $name did not work either"
}

# The image the cycle runs, as the container starts: a rebuild or a new pin
# while the cycle runs does not change what it ran. On the cycle's record with
# what the container is given of the settings, and how many cycles run now,
# this one with them. A record that is not this start's, or has ended, is no
# start to run; a store that is only busy costs the record, not the cycle.
if [ -n "$attempt" ]; then
  image_id="" image_rukas=""
  read -r image_id image_rukas _ < <(timeout -k 5 "$stop_wait" docker image inspect \
    --format '{{.Id}} {{index .Config.Labels "tehas.rukas"}}' "$image" 2>/dev/null)
  if [[ $image_id =~ ^sha256:[0-9a-f]{64}$ ]]; then
    [[ $image_rukas =~ ^[0-9a-f]{7,40}$ ]] || image_rukas=""
    image_args=("$issue" --attempt "$attempt" --image "$image_id")
    [ -z "$image_rukas" ] || image_args+=(--rukas "$image_rukas")
    settings_file=""
    [ -e "$TEHAS_HOME/tmp" ] || mkdir -m 700 "$TEHAS_HOME/tmp" 2>/dev/null
    if [ -d "$TEHAS_HOME/tmp" ] && [ ! -L "$TEHAS_HOME/tmp" ] &&
      settings_file=$(mktemp "$TEHAS_HOME/tmp/settings.XXXXXX" 2>/dev/null) &&
      tehas_improve_settings "$settings_file" "$(tehas_cycles_running | wc -l)" "${envs[@]}" "${image_opts[@]}"; then
      image_args+=(--settings "$settings_file")
    else
      echo "tehas work: the settings of this cycle could not be written for its record" >&2
    fi
    tehas_store cycle-image "${image_args[@]}"
    image_rc=$?
    [ -z "$settings_file" ] || rm -f "$settings_file"
    case "$image_rc $tehas_store_word" in
      0\ *) ;;
      "1 busy" | "1 timeout")
        echo "tehas work: the image of #$issue is not on its record: the state store did not answer ($tehas_store_word)" >&2
        ;;
      *)
        echo "tehas work: the state store did not take the image of this start ($tehas_store_line), not starting a cycle" >&2
        timeout -k 10 "$text_wait" gh issue comment "$issue" --repo "$TEHAS_REPO" \
          --body "Tehas started no cycle: its record on this host could not be updated as it started. To retry, apply \`tehas:ready\`." >/dev/null 2>&1 ||
          echo "tehas work: the comment on #$issue failed" >&2
        exit 4
        ;;
    esac
  fi
fi

# Set before the container starts, so no signal falls between. A stop ends the
# loop and is recorded as interrupted, not as running.
interrupted=0
cpid=""
# The live file says running only once the trap can say interrupted.
live_on=0
# A log is named to the second, so a cycle of this issue can be given the name a
# cycle before it used: the side file of its stream goes with the rest of the
# cycle's files, so what the improvement record copies as err.txt is only what
# this command writes into it. The name is known only here, where the log is
# named, which is after the gap of the attachments has been said into it: that
# line is one of the two that ever reach the file, so it is said again below.
rm -f "${log:?}.err"
if [ -n "${gap_said:-}" ]; then
  printf '%s\n' "$gap_said" >>"$log.err" ||
    echo "tehas work: could not write $log.err" >&2
fi

# The runner is the container's command, so a docker stop reaches it: it ends
# the cycle as interrupted and still writes its result.
# The container reads the app's token from a directory the host keeps fresh;
# the renewer ends with the container, or with this command.
renewer=$(tehas_github_renew)
trap 'interrupted=1; [ -z "$cpid" ] || kill "$cpid" 2>/dev/null; [ -z "$renewer" ] || kill "$renewer" 2>/dev/null; stop_container 10
[ "$live_on" = 0 ] || now_file false interrupted' TERM INT
docker run --rm --init --name "$name" \
  "${TEHAS_SLICE_LIMITS[@]}" "${sec[@]}" --user "$(id -u):$(id -g)" --cidfile "$cid_file" \
  -w "$repo" "${mounts[@]}" "${image_opts[@]}" \
  "${envs[@]}" "${hosts[@]}" \
  "$image" "$runner" work "$issue" "${run_flags[@]}" </dev/null >"$result_file" 2>"$log" &
pid=$!

started=$EPOCHSECONDS
echo "tehas work: issue $issue started, log $log"

# For the dashboard: a readable console of this cycle and its own "now" file.
live=$TEHAS_HOME/live
mkdir -p "$live/cycles"
console=$live/console-$issue.txt
: >"$console"
# The cycle does not depend on it: without a console it runs all the same,
# and this says why the dashboard shows none.
[ -x "$here/console" ] || echo "tehas work: no console at $here/console, so the dashboard shows none; run install.sh"
# The names for the console to mask (lib/private.sh).
private=()
while IFS= read -r private_name; do
  private+=(--private "$private_name")
done < <(tehas_private_names "$agent/models.json" "$bot_email")
"$here/console" --progress "$log" \
  --runs "$runs" --out "$console" --since "$((started - 5))" "${private[@]}" >/dev/null 2>"$log.console" &
cpid=$!
now_file() { # running? status
  local step="" text=""
  # The step and the driver's last notice, from the stable progress lines, in
  # one pass over the log. The notice is the driver's words and the file is
  # served by the dashboard: it goes through the console's mask, and without a
  # console it is not published at all.
  { read -r step; read -r text; } < <(tehas_headless_now "$log")
  [ -n "$step" ] || step=starting
  text=$(printf '%s' "$text" | "$here/console" --mask "${private[@]}" 2>/dev/null)
  jq -n --argjson issue "$issue" --argjson running "$1" --arg status "$2" --arg step "$step" \
    --arg text "$text" --argjson startedAt "$started" --argjson at "$EPOCHSECONDS" \
    '{issue: $issue, running: $running, status: $status, step: $step, statusText: $text,
      startedAt: $startedAt, updatedAt: $at, console: "console-\($issue).txt"}' \
    >"$live/cycles/$issue.json.new" 2>/dev/null && mv "$live/cycles/$issue.json.new" "$live/cycles/$issue.json"
  tehas_live_assemble
}
live_on=1
now_file true running

# How many processes the kernel has killed for memory in this container, and
# how many starts of a process its pids limit refused, from the container's
# own cgroup. The last numbers seen are kept: the cgroup goes with the
# container.
ooms=0
forks=0
oom_look() {
  local id="" scope key value
  [ -r "$cid_file" ] || return 0
  read -r id <"$cid_file" 2>/dev/null || true
  [[ $id =~ ^[0-9a-f]{64}$ ]] || return 0
  scope=${TEHAS_CGROUP_ROOT:-/sys/fs/cgroup}/tehas.slice/docker-$id.scope
  if [ -r "$scope/memory.events" ]; then
    while read -r key value; do
      if [ "$key" = oom_kill ] && [[ $value =~ ^[0-9]{1,9}$ ]]; then ooms=$value; fi
    done 2>/dev/null <"$scope/memory.events"
  fi
  if [ -r "$scope/pids.events" ]; then
    while read -r key value; do
      if [ "$key" = max ] && [[ $value =~ ^[0-9]{1,9}$ ]]; then forks=$value; fi
    done 2>/dev/null <"$scope/pids.events"
  fi
  return 0
}

# The newest change to any of the cycle's logs, in whole seconds since the
# epoch. Transcripts of an earlier cycle are older than this one's start.
moved() {
  find "$log" "$runs" -type f -printf '%T@\n' 2>/dev/null | sort -n | tail -n 1 | cut -d. -f1
}

status=running
stalled=0
timed=0
last=$started
# Set when this command stops the container itself, and when the container
# was killed while the cycle was running.
stopped=0
killed=0
while [ "$interrupted" = 0 ] && kill -0 "$pid" 2>/dev/null; do
  sleep 10
  [ "$interrupted" = 0 ] || break
  oom_look
  now_file true running
  # The runner stops itself at its --timeout. This is for one that does not.
  if [ $((EPOCHSECONDS - started)) -ge $((limit + grace)) ]; then
    echo "tehas work: time limit of ${limit}s passed"
    timed=1
    break
  fi
  m=$(moved)
  [[ $m =~ ^[0-9]+$ ]] && [ "$m" -gt "$last" ] && last=$m
  if [ $((EPOCHSECONDS - last)) -ge "$stall" ]; then
    echo "tehas work: none of the cycle's logs changed for ${stall}s, stopping it as stalled"
    stalled=1
    break
  fi
done

# A stop that came while the container was still being made found nothing to
# stop.
if [ "$interrupted" = 1 ] && kill -0 "$pid" 2>/dev/null; then
  stop_container 10
fi
if [ "$interrupted" = 0 ] && kill -0 "$pid" 2>/dev/null; then
  oom_look
  stopped=1
  stop_container 20
fi
wait "$pid" 2>/dev/null
rc=$?
[ -z "$renewer" ] || kill "$renewer" 2>/dev/null
rm -f "$cid_file"
have=0 error_only=0
outcome=$(tehas_headless_outcome "$result_file" "$issue") && have=1 || outcome='{}'
[ "$have" = 1 ] || ! tehas_headless_error_only "$result_file" || error_only=1
# What the runner ended with, whatever this command goes on to exit with. Said
# in the cycle's comment, which otherwise names only this command's status.
# Written once, as soon as the runner has ended: what the report makes of the
# run after this point may fail, and this word must not go with it. Written by
# a name beside it and moved into place, so tehasbot cycle sees either the word
# whole or no file at all: a file of the protocol that is there says this
# command watched the run, and one that a write lost is said of on the unit's
# error stream, where a person reads it, as much as in the cycle's own log.
write_note() { # <file> <text>: one file of the protocol, whole or not at all
  if ! printf '%s\n' "$2" >"$1.new" 2>/dev/null; then
    rm -f "$1.new" 2>/dev/null
    echo "tehas work: could not write $1" >&2
    printf '%s\n' "tehas work: could not write $1" >>"$log.err" 2>/dev/null ||
      echo "tehas work: could not say of $log.err that $1 was lost" >&2
    return 1
  elif ! mv "$1.new" "$1" 2>/dev/null; then
    rm -f "$1.new" 2>/dev/null
    echo "tehas work: could not write $1" >&2
    printf '%s\n' "tehas work: could not write $1" >>"$log.err" 2>/dev/null ||
      echo "tehas work: could not say of $log.err that $1 was lost" >&2
    return 1
  fi
  return 0
}
write_note "$runner_exit_file" "${rc:-2}"
if [ "$have" = 1 ]; then
  status=$(jq -r .status <<<"$outcome")
  status=${status:-unknown}
  # The runner ends a cycle stopped here as interrupted.
  [ "$stalled" = 0 ] || case "$status" in running | unknown | interrupted) status=stalled ;; esac
  [ "$timed" = 0 ] || case "$status" in running | unknown | interrupted) status=timeout ;; esac
else
  [ "$interrupted" = 0 ] || status=interrupted
  [ "$stalled" = 0 ] || status=stalled
  [ "$timed" = 0 ] || status=timeout
fi
# The runner stops itself at the --timeout it is given, which is this
# command's time limit. Its result then names no cap and no end, so the time
# limit ended the cycle as surely as a stop made here.
ran_out=0
if [ "$timed" = 0 ] && [ "$stalled" = 0 ] && [ "$interrupted" = 0 ] && [ "$rc" != 137 ] &&
  [ $((EPOCHSECONDS - started)) -ge "$limit" ] && [ -z "$(jq -r '.cap // ""' <<<"$outcome" 2>/dev/null)" ]; then
  case "$status" in running | unknown | interrupted) ran_out=1 status=timeout ;; esac
fi
inflight=$(jq -r '[.failedStep, .lastStep] | map(strings | select(. != "")) | first // ""' <<<"$outcome" 2>/dev/null)
# A result that names no step leaves the log to say which step the runner was
# in: one pass over it gives the last step it says it started.
[ -n "$inflight" ] || { read -r inflight; } < <(tehas_headless_now "$log")
inflight=$(printf '%s' "$inflight" | tr -cd 'A-Za-z0-9_.:-' | head -c 40)
inflight=${inflight:--}
if [ "$timed" = 1 ] || [ "$ran_out" = 1 ]; then
  # The limit, who stopped the cycle and the step it was in.
  by=tehas
  [ "$ran_out" = 0 ] || by=runner
  echo "$limit $by ${inflight:--}" >"$timed_file" || echo "tehas work: could not write $timed_file" >&2
fi
[ "$stalled" = 0 ] || printf '%s\n%s\n' "$stall" "$inflight" >"$stall_file" || echo "tehas work: could not write $stall_file" >&2
# A container that ended with 137 was killed. It is this cycle's end only when
# nobody here stopped it and the runner wrote no result.
if [ "$rc" = 137 ] && [ "$have" = 0 ] && [ "$error_only" = 0 ] && [ "$interrupted" = 0 ] && [ "$stopped" = 0 ]; then
  status=killed
  killed=1
  # Said with the summary, for the report of tehasbot cycle: a cycle that
  # writes no result has no word of its own for how it ended, and this is the
  # word of the one that watched the container. Lost with no other account of
  # the kill left behind, so it is said of twice: once to a person reading the
  # unit, once to the cycle's own record.
  write_note "$status_file" killed ||
    echo "tehas work: the account of the killed container is lost with it"
  echo "tehas work: the container was killed (137) while the cycle was running: out of memory, or stopped from outside"
fi
# A container that wrote no result and not one line of its stream never got as
# far as the driver's first event, so the record would say nothing but the
# status this command exits with. Named here, where the container's own end,
# its cgroup and the fact that its stream stayed empty are all still in scope;
# tehasbot cycle makes the cap of it. Not for one this command stopped, nor for
# a killed container or one that reached the time limit, each of which has an
# account of its own, and not for a container ended by SIGKILL, which is the end
# this command documents as leaving no note: the count of memory kills is
# carried by the oom file, as for every other end. The exit status is written in
# the shape the reader accepts, so the two cannot disagree about a note.
if [ "$have" = 0 ] && [ "$error_only" = 0 ] && [ "$interrupted" = 0 ] && [ "$stopped" = 0 ] &&
  [ "$killed" = 0 ] && [ "$timed" = 0 ] && [ "$ran_out" = 0 ] && [ "$stalled" = 0 ] &&
  [ "$rc" != 137 ] && [[ $rc =~ ^[1-9][0-9]{0,2}$ ]] && [ ! -s "$log" ]; then
  write_note "$nostart_file" "$rc" ||
    echo "tehas work: the account of the container that never started is lost with it"
  # One line for the cycle's record, where a person reads the end of a failed
  # cycle. The preflight file is named because it is the only file of the cycle
  # that holds anything for a run whose stream stayed empty, and what it holds
  # there is the provider-retry echo, which says nothing about this end. The two
  # words of the line are this command's own, reduced to what a record that is
  # filed in public can carry.
  nostart_rc=${rc//[^0-9]/}
  nostart_log=$(printf '%s' "${log##*/}" | tr -cd 'A-Za-z0-9._-')
  printf '%s\n' "tehas work: issue $issue ended with the container's exit $nostart_rc and no line of its stream: the runner wrote no event, so no step started. Its preflight is $nostart_log.preflight." \
    >>"$log.err" || echo "tehas work: could not write $log.err" >&2
fi
if [ "$ooms" -gt 0 ]; then
  echo "tehas work: $ooms processes in this cycle's container were killed for memory"
  echo "$ooms" >"$oom_file" || echo "tehas work: could not write $oom_file" >&2
fi
if [ "$forks" -gt 0 ]; then
  echo "tehas work: this cycle's container reached its limit of processes, $forks starts were refused"
  echo "$forks" >"$forks_file" || echo "tehas work: could not write $forks_file" >&2
fi
sleep 3 # let the console catch the last transcript lines
kill -TERM "$cpid" 2>/dev/null
# The console finishes its pass before it stops. A slow one must not hold the
# issue's lock and its slot.
for ((i = 0; i < console_wait * 5; i++)); do
  kill -0 "$cpid" 2>/dev/null || break
  sleep 0.2
done
if kill -0 "$cpid" 2>/dev/null; then
  echo "tehas work: the console did not stop within ${console_wait}s, killing it"
  kill -KILL "$cpid" 2>/dev/null
fi
wait "$cpid" 2>/dev/null
crc=$?
[ "$crc" = 0 ] || [ ! -x "$here/console" ] || echo "tehas work: the console ended with $crc, see $log.console"

step=$(jq -r '[.failedStep, .lastStep] | map(strings | select(. != "")) | first // "-"' <<<"$outcome" 2>/dev/null)
step=${step:--}
[ "$step" != - ] || { [ "$timed" = 0 ] && [ "$stalled" = 0 ] && [ "$ran_out" = 0 ]; } || step=$inflight
now_file false "$status"
cp "$result_file" "$log.result.json" 2>/dev/null || true
tehas_headless_progress "$log" "$caps" "$result_file" "$issue" >"$progress_file" || echo "tehas work: could not write $progress_file" >&2
cap=$(jq -r '.cap // ""' <<<"$outcome" 2>/dev/null)
# A stop this command made is its own cap, unless the runner had ended first.
case "$status" in
  timeout) cap=wall-clock ;;
  stalled) cap=stall ;;
esac
echo "tehas work: issue=$issue status=$status step=$step cap=${cap:--} runner_exit=$rc seconds=$((EPOCHSECONDS - started))"

# The kill is what this command saw of the container. A runner that wrote its
# result says how the cycle ended with its own exit status.
[ "$killed" = 0 ] || exit 137
[ "$stalled" = 0 ] && [ "$timed" = 0 ] || exit 2
if [ "$have" = 1 ]; then
  # It reaches err.txt of the cycle's improvement record. An abort is an end the
  # runner reports and no cap covers: its stream holds the driver's own cancel
  # lines, and an empty err.txt there reads as nothing happened.
  if [ ! -s "$log.err" ] && { [ -n "$cap" ] || [ "$status" = aborted ]; }; then
    # Why the runner stopped, as tehasbot cycle reads it for the park comment:
    # the reason of the last cap the progress holds, cut short as cycle cuts it.
    # An aborted cycle has no cap, so it is named as what the runner reported.
    reason=$(head -c 1000000 "$progress_file" 2>/dev/null |
      jq -j '.reason // "" | strings' 2>/dev/null | tr '\n' ' ' |
      tr -cd 'A-Za-z0-9 _.,:;/()=+-' | head -c 200)
    if [ -n "$cap" ]; then
      printf '%s\n' "tehas work: issue $issue ended at the cap $cap${reason:+: $reason}" \
        >>"$log.err" || echo "tehas work: could not write $log.err" >&2
    else
      printf '%s\n' "tehas work: issue $issue ended as aborted with no cap" \
        >>"$log.err" || echo "tehas work: could not write $log.err" >&2
    fi
    # The driver's own words for the refusal, as they stand in the cycle's
    # stream: the warning, kill, failure and cancellation lines. The last 20
    # of them are kept, because a stream that repeats one says it over and
    # over: each line is cut to 1000 characters and the whole to 64 KiB, for a
    # line of a stream can carry an error tail of any size, and this file goes
    # into the record the analyst reads.
    # Each bound is applied twice, so no line of it is broken: the one that
    # keeps the last 20 of a long stream, the one that cuts a line too long.
    diag=$(grep -a '\[pi-rukas\]' "$log" 2>/dev/null | grep -a -E 'WARN|killed|FAILED|cancelled' |
      tail -n 20 | cut -c 1-1000 | tail -c 65536 | tail -n 20 | cut -c 1-1000)
    [ -z "$diag" ] || printf '%s\n' "$diag" >>"$log.err" 2>/dev/null ||
      echo "tehas work: could not write $log.err" >&2
    # The stream is the file with the rest of it, whether or not a line of it
    # came here: say where it is rather than what the record does not hold.
    printf '%s\n' "tehas work: the driver's diagnostics are in $(basename "$log")" \
      >>"$log.err" || echo "tehas work: could not write $log.err" >&2
  fi
  # A result without an exit code of its own gives null here, which is none.
  for code in "$rc" "$(jq -r .exitCode <<<"$outcome")"; do
    case "$code" in 0 | 10 | 11 | 20 | 21 | 30 | 40) exit "$code" ;; esac
  done
elif [ "$error_only" = 1 ]; then
  # A result with no entry for the issue, such as a refusal that carries only
  # an error: the runner's own status still says how it ended.
  case "$rc" in 0 | 10 | 11 | 20 | 21 | 30 | 40) exit "$rc" ;; esac
fi
exit 2
