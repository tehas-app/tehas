#!/usr/bin/env bash
# tehas work: one pi-rukas /work cycle, run headless in the sandbox image, to
# its end. The cycle is `tehas-cycle work` (console/cycle/src/work.rs), which
# says what the container is given and what every exit status means.
#
# This script loads the settings, takes state/cycles/<issue>.lock as fd 9 and
# execs it. The lock is taken here because every program of the cycle, the
# docker client among them, inherits it, and safe Rust opens each file
# close-on-exec. Under tehasbot cycle the lock comes down as fd 9, already held,
# and taking it again through that fd succeeds.
#
# Usage: tehas work <issue-number> [--restart] [--driver lean|classic]
# The driver is the approval's, or classic; --driver wins over it.
#
# Exit: 64 the argument is not an issue number, or tehas-cycle refuses the
# options after it; 78 the settings are missing or
# malformed, or there is no tehas-cycle beside this script; 5 a cycle for this
# issue is running, nothing was touched; else tehas-cycle work's.
set -uo pipefail

issue=${1:-}
[[ $issue =~ ^[1-9][0-9]*$ ]] || { echo "usage: tehas work <issue-number> [--restart] [--driver lean|classic]" >&2; exit 64; }

here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source=lib/config.sh
. "$here/../lib/config.sh"
tehas_load || exit 78
tehas_require TEHAS_REPO PI_ENSEMBLE_SUBAGENT_MODEL PI_ENSEMBLE_SUBAGENT_PROVIDER
if [ ! -x "$here/tehas-cycle" ]; then
  echo "tehas work: the container limits could not be made, not starting: no tehas-cycle at $here/tehas-cycle (run install.sh)" >&2
  exit 78
fi

mkdir -p "$TEHAS_HOME/state/cycles"
lock=$TEHAS_HOME/state/cycles/$issue.lock
[ /dev/fd/9 -ef "$lock" ] 2>/dev/null || exec 9>"$lock"
flock -n 9 || { echo "tehas work: a cycle for #$issue is running, not starting another" >&2; exit 5; }
exec "$here/tehas-cycle" work "$issue" --console "$here/console" "${@:2}"
