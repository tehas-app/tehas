#!/usr/bin/env bash
# Run one pi-rukas /work cycle headless, in the sandbox image, and wait for it.
#
# pi-rukas has no headless entry and its wrapper always runs `docker run -it`.
# Pi's RPC mode needs no terminal and resolves extension commands, so this
# starts `pi --mode rpc` in the sandbox, sends "/work <issue>" as one RPC
# prompt, then watches the cycle's state file until it leaves "running".
#
# Usage: tehas work <issue-number> [--restart]
#
# Exit status: 0 the cycle ended as merged or handoff (parked for a human),
#              1 it ended as aborted,
#              2 Pi exited or the time limit passed while it was still running.
#              3 the sandbox cannot push to the repository; no cycle was started.
#
#             64 no bot token or no git identity; no cycle was started.
#             78 the instance settings are invalid; no cycle was started.
#
# Instance settings (lib/config.sh; defaults in brackets):
#   TEHAS_WORK_REPO     the product checkout a cycle is cloned from
#                       [$TEHAS_HOME/repos/<name>]
#   TEHAS_WORK_TIMEOUT  seconds before giving up [21600]
#   TEHAS_WORK_CPUS     docker --cpus for the cycle: a time quota, not pinning
#                       [the host's CPUs minus one]
#   TEHAS_WORK_MEMORY   docker --memory for the cycle, a hard limit
#                       [half the host's memory]
#
# What the container is given is deliberate and pinned by test/work_test.sh:
# the bot token (pi-rukas pushes and opens the pull request from inside), the
# PI_ENSEMBLE_* settings, the bot's git identity, the cycle's workspace and
# Pi's state directories. Not the Docker socket, SSH keys or ~/.config/tehas.
#
# The workspace is $TEHAS_HOME/work/<name>, a fresh clone made here for every
# cycle. The container never sees the product checkout: an agent can write
# anything into the tree it works in, hooks and git configuration included,
# and the host runs git in the product checkout. So the host runs git only in
# a tree no container has touched, and reads from the workspace afterwards
# nothing but the cycle's state file, as data.
set -uo pipefail

issue=${1:-}
case "$issue" in '' | *[!0-9]*) echo "usage: tehas work <issue-number> [--restart]" >&2; exit 64 ;; esac
flags=""
[ "${2:-}" = "--restart" ] && flags=" --restart"

here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source=lib/config.sh
. "$here/../lib/config.sh"
tehas_load || exit 78
tehas_require TEHAS_REPO PI_ENSEMBLE_SUBAGENT_MODEL PI_ENSEMBLE_SUBAGENT_PROVIDER
# Docker would create a missing mount source as a root-owned directory.
tehas_checkout || exit 78
branch=$(tehas_branch) || exit 78
src=$TEHAS_WORK_REPO
repo=$TEHAS_WORK_DIR
image=$PI_ENSEMBLE_IMAGE
limit=$TEHAS_WORK_TIMEOUT
state=$repo/.pi/work-state/$issue.json
log=$TEHAS_HOME/logs/work-$issue-$(date -u +%y%m%d-%H%M%S).jsonl
name=tehas-work-$issue
agent=$HOME/.pi/agent

[ -n "${GH_TOKEN:-}" ] || { echo "tehas work: GH_TOKEN is not set (source ~/tehas/env.sh)" >&2; exit 64; }
mkdir -p "$TEHAS_HOME/logs" "$agent/ensemble-runs" "$agent/sessions" "$HOME/.vipune"

hosts=()
IFS=',' read -ra pairs <<<"${PI_ENSEMBLE_HOST_ALIASES:-}"
for p in "${pairs[@]}"; do [ -n "$p" ] && hosts+=(--add-host="$p"); done

# The same mounts as the pi-rukas wrapper, minus the Docker socket, SSH keys
# and image directories. Only the bot token and PI_ENSEMBLE_* settings are
# passed in, not the whole host environment.
envs=(-e GH_TOKEN -e PI_ENSEMBLE_SANDBOX_MODE=1 -e "PI_ENSEMBLE_WORKSPACE_ROOT=$repo")

# git inside the sandbox has no configuration of its own: no credential helper
# and no identity. Without the helper the driver commits but cannot push, and
# the cycle parks after all the work is done. Hand git the bot's token through
# gh (which reads GH_TOKEN) and the bot's identity, as environment-level
# config: it outranks any file, reaches every agent process, and writes
# nothing into the checkout.
bot_name=$(git config --global user.name || true)
bot_email=$(git config --global user.email || true)
[ -n "$bot_name" ] && [ -n "$bot_email" ] ||
  { echo "tehas work: git user.name and user.email are not set for $(id -un)" >&2; exit 64; }
envs+=(-e GIT_CONFIG_COUNT=4
  -e "GIT_CONFIG_KEY_0=credential.https://github.com.helper" -e "GIT_CONFIG_VALUE_0="
  -e "GIT_CONFIG_KEY_1=credential.https://github.com.helper" -e "GIT_CONFIG_VALUE_1=!gh auth git-credential"
  -e "GIT_CONFIG_KEY_2=user.name" -e "GIT_CONFIG_VALUE_2=$bot_name"
  -e "GIT_CONFIG_KEY_3=user.email" -e "GIT_CONFIG_VALUE_3=$bot_email"
  -e GIT_TERMINAL_PROMPT=0)
while IFS='=' read -r var _; do
  case "$var" in PI_ENSEMBLE_IMAGE | PI_ENSEMBLE_HOST_ALIASES) ;; PI_ENSEMBLE_*) envs+=(-e "$var") ;; esac
done < <(env)

# A fresh workspace for this cycle, at the tip the product checkout last
# fetched for the branch. What an earlier cycle left behind goes with the old
# one. Only a directory this command made is ever removed.
base=$(git -C "$src" rev-parse -q --verify "refs/remotes/origin/$branch^{commit}") ||
  { echo "tehas work: $src has no origin/$branch, not starting a cycle" >&2; exit 78; }
url=$(git -C "$src" config --get remote.origin.url)
works=$(dirname "$repo")
if [ -e "$works" ] && [ ! -f "$works/.tehas-workspaces" ]; then
  echo "tehas work: $works exists and was not made by tehas, not touching it" >&2
  exit 78
fi
workspace() {
  mkdir -p "$works" && : >"$works/.tehas-workspaces" && rm -rf "$repo" &&
    git init -q -b "$branch" "$repo" &&
    git -C "$repo" remote add origin "$url" &&
    git -C "$repo" fetch -q --no-tags "$src" '+refs/remotes/origin/*:refs/remotes/origin/*' &&
    git -C "$repo" symbolic-ref refs/remotes/origin/HEAD "refs/remotes/origin/$branch" &&
    git -C "$repo" checkout -q -B "$branch" "$base" &&
    git -C "$repo" branch -q --set-upstream-to="origin/$branch" "$branch"
}
if ! workspace; then
  echo "tehas work: could not make the workspace $repo, not starting a cycle" >&2
  exit 78
fi

# Before spending an hour of model time: can the sandbox push at all? A dry
# run needs the same credentials a real push does and creates nothing.
if ! docker run --rm --user "$(id -u):$(id -g)" -e HOME=/home/vscode "${envs[@]}" \
  -w "$repo" -v "$repo:$repo" --entrypoint git "$image" \
  push --dry-run origin HEAD:refs/heads/tehas-preflight >"$log.preflight" 2>&1; then
  echo "tehas work: the sandbox cannot push to origin, not starting a cycle:"
  tail -n 3 "$log.preflight" | sed 's/^/    /'
  exit 3
fi

fifo=$(mktemp -u)
mkfifo "$fifo"
exec 3<>"$fifo"
rm "$fifo"

docker run --rm -i --name "$name" \
  --cpus "$TEHAS_WORK_CPUS" --memory "$TEHAS_WORK_MEMORY" \
  -w "$repo" -v "$repo:$repo" \
  -v "$HOME/.vipune:/home/vscode/.vipune" \
  -v "$agent/ensemble-runs:/home/vscode/.pi/agent/ensemble-runs" \
  -v "$agent/sessions:/home/vscode/.pi/agent/sessions" \
  -v "$agent/models.json:/home/vscode/.pi/agent/models.json:ro" \
  -v "$agent/mcp.json:/home/vscode/.pi/agent/mcp.json:ro" \
  -v pi-ensemble-cache:/home/vscode/.cache \
  -v pi-ensemble-bun-cache:/home/vscode/.bun \
  "${envs[@]}" "${hosts[@]}" \
  "$image" pi --mode rpc --approve <&3 >"$log" 2>"$log.err" &
pid=$!

started=$(date +%s)
printf '{"id":"work","type":"prompt","message":"/work %s%s"}\n' "$issue" "$flags" >&3
echo "tehas work: issue $issue started, log $log"

# For the dashboard: a readable console of this cycle and a small "now" file.
live=$TEHAS_HOME/live
mkdir -p "$live"
console=$live/console-$issue.txt
: >"$console"
deno run -A "$here/console.ts" --rpc "$log" \
  --runs "$agent/ensemble-runs" --out "$console" --since "$((started - 5))" >/dev/null 2>&1 &
cpid=$!
now_file() { # running? status step
  local text
  # The line is the agent's own words and the file is served by the dashboard:
  # private addresses are masked, as console.ts does for the console.
  text=$(tail -c 60000 "$log" 2>/dev/null | grep -o '"statusText":"[^"]*"' | tail -n 1 | cut -d'"' -f4 |
    sed -E 's/(^|[^0-9.])(10\.[0-9]{1,3}|192\.168|172\.(1[6-9]|2[0-9]|3[01])|169\.254|100\.(6[4-9]|[7-9][0-9]|1[01][0-9]|12[0-7]))\.[0-9]{1,3}\.[0-9]{1,3}/\1[private address]/g')
  jq -n --argjson issue "$issue" --argjson running "$1" --arg status "$2" --arg step "$3" \
    --arg text "$text" --argjson startedAt "$started" --argjson at "$(date +%s)" \
    '{issue: $issue, running: $running, status: $status, step: $step, statusText: $text,
      startedAt: $startedAt, updatedAt: $at, console: "console-\($issue).txt"}' \
    >"$live/running.json.new" 2>/dev/null && mv "$live/running.json.new" "$live/running.json"
}
now_file true running starting

trap 'kill "$cpid" 2>/dev/null; exec 3>&- 2>/dev/null; docker stop -t 10 "$name" 2>/dev/null; now_file false interrupted "killed by signal (TERM/INT)"' TERM INT

status=running
seen=0
while kill -0 "$pid" 2>/dev/null; do
  sleep 10
  now_file true "$status" "$(jq -r '.pipelineState.currentStep // "starting"' "$state" 2>/dev/null || echo starting)"
  # Ignore a state file left over from an earlier cycle.
  if [ -f "$state" ] && [ "$(stat -c %Y "$state")" -ge "$started" ]; then
    seen=1
    status=$(jq -r '.pipelineState.status // "running"' "$state" 2>/dev/null || echo running)
    [ "$status" != running ] && break
  fi
  if [ $(($(date +%s) - started)) -ge "$limit" ]; then
    echo "tehas work: time limit of ${limit}s passed"
    break
  fi
done

if kill -0 "$pid" 2>/dev/null; then
  # Give the driver a moment to post its handoff, then end the session.
  [ "$status" != running ] && sleep 20
  exec 3>&-
  sleep 5
  docker stop -t 20 "$name" >/dev/null 2>&1
fi
wait "$pid" 2>/dev/null
sleep 3 # let the console catch the last transcript lines
kill -TERM "$cpid" 2>/dev/null
wait "$cpid" 2>/dev/null

step=$(jq -r '.pipelineState.currentStep // "-"' "$state" 2>/dev/null || echo -)
now_file false "$status" "$step"
notices=$(jq -r 'select(.type=="extension_ui_request" and .method=="notify") | .message' "$log" 2>/dev/null | tail -n 5)
echo "tehas work: issue=$issue status=$status step=$step state_written=$seen seconds=$(($(date +%s) - started))"
[ -n "$notices" ] && printf '%s\n' "$notices" | sed 's/^/    /'

case "$status" in
  merged | handoff) exit 0 ;;
  aborted) exit 1 ;;
  *) exit 2 ;;
esac
