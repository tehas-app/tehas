#!/usr/bin/env bash
# Run one turn of a pi-rukas planning session headless, in the sandbox image.
#
# A planning session is a conversation with pi-rukas's planner that ends in a
# filed issue. It asks its operator questions on the way. Nobody is at a
# terminal here, so each turn is one run of pi-rukas's headless runner,
# `pi-rukas-headless plan`, which exits when it has something for the
# operator: questions, or a drafted plan to confirm. This command writes what
# the turn said and asked to a file and stops. The dispatcher posts it on the
# issue and, when an answer has come, runs the next turn in the same session.
# A tick on "Update this issue" makes a drafted plan the issue's text. One with
# no open points may need no tick. A refine also offers "File as a new issue".
#
# Usage:
#   tehas plan <issue-number> --out <file> --keep <dir> --brief <file> [--kind refine]
#       First turn. <file> holds the approved title and body of the issue.
#   tehas plan <issue-number> --out <file> --keep <dir> --session <id> --answer <file> [--comment <id>] [--kind refine]
#       A later turn. --kind refine: the session is a tehas:refine one. <file> holds the operator's answer. --comment names the
#       reply it came from, whose attachments the turn is given.
#
# <dir> is what the session carries from one turn to the next.
# console/src/plan/turn.rs says what it holds, what a turn runs and what the
# --out file holds. It prepares the turn, watches docker and ends the turn.
#
# Exit status: 0 the turn ended with something to say or ask, or it filed,
#              2 the runner failed, ran out of time, refused the turn, said
#                and asked nothing, its session is gone, or its outcome could
#                not be written down,
#              4 the instance gives images or files and one could not be
#                fetched, for a first turn or from a reply; said on the issue,
#                nothing ran,
#             64 a usage error, no bot token or no git identity; nothing ran,
#             78 the settings are invalid, the console is missing, tehas.slice
#                is not usable on this host, or the image runs no planning
#                turns (--capabilities has no features.planTurns); nothing ran.
#
# Instance settings (lib/config.sh; defaults in brackets):
#   TEHAS_PLAN_TIMEOUT  seconds before a turn is given up [7200, the ceiling
#                       in console/core/src/settings/rules.rs]
#   and those of tehas work for the checkout and the container's limits.
#
# The container is given exactly what a cycle's container is given: the same
# image, limits, mounts and variables, assembled by tehas-cycle sandbox and
# pinned by test/plan_test.sh, and the issue's images as a
# cycle gets them. It differs in its name, in its command and in having no cid
# file. Not the Docker socket, SSH keys or ~/.config/tehas. It runs in
# tehas.slice with a cycle's limits, so the dispatcher counts its memory with
# the cycles'. Without a usable slice nothing is cloned and nothing starts.
#
# The workspace is $TEHAS_HOME/work/<name>-plan-<issue>, a fresh clone made for
# every turn and removed when the turn is over. Inside the container it is at
# the path every cycle has its own, $TEHAS_HOME/work/<name>. The transcripts go
# to ~/.pi/agent/ensemble-runs/plan-<issue>, so a turn and a cycle see nothing
# of each other. Beside the workspace is <name>-plan-<issue>.state, the turn's
# own copy of the code index and its own memory, removed with the workspace.
set -uo pipefail

usage() {
  echo "usage: tehas plan <issue-number> --out <file> --keep <dir> (--brief <file> | --session <id> --answer <file> [--comment <id>]) [--kind refine]" >&2
  exit 64
}

issue=${1:-}
case "$issue" in '' | *[!0-9]*) usage ;; esac
shift
out="" keep="" brief="" answer="" session="" comment="" kind=""
while [ "$#" -gt 0 ]; do
  [ "$#" -ge 2 ] || usage
  case "$1" in
    --out) out=$2 ;;
    --keep) keep=$2 ;;
    --brief) brief=$2 ;;
    --answer) answer=$2 ;;
    --session) session=$2 ;;
    --comment) comment=$2 ;;
    --kind) [ "$2" = refine ] || usage; kind=$2 ;;
    *) usage ;;
  esac
  shift 2
done
[ -n "$out" ] && [ -n "$keep" ] || usage
if [ -n "$brief" ]; then
  [ -z "$session$answer$comment" ] && [ -r "$brief" ] || usage
else
  [ -n "$session" ] && [ -n "$answer" ] && [ -r "$answer" ] || usage
fi
# The id ends up on a command line: letters, digits and dashes only.
case "$session" in *[!A-Za-z0-9-]*) usage ;; esac
case "$comment" in *[!0-9]*) usage ;; esac

here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source=lib/config.sh
. "$here/../lib/config.sh"
# shellcheck source=lib/sandbox.sh
. "$here/../lib/sandbox.sh"
# shellcheck source=lib/attachments.sh
. "$here/../lib/attachments.sh"
# shellcheck source=lib/labels.sh
. "$here/../lib/labels.sh"
# shellcheck source=lib/cycles.sh
. "$here/../lib/cycles.sh"
# shellcheck source=lib/github-app.sh
. "$here/../lib/github-app.sh"
tehas_load || exit 78
tehas_require TEHAS_REPO PI_ENSEMBLE_SUBAGENT_MODEL PI_ENSEMBLE_SUBAGENT_PROVIDER
tehas_sandbox_ok || exit 78
# Docker would create a missing mount source as a root-owned directory.
tehas_checkout || exit 78
branch=$(tehas_branch) || exit 78
# No container starts outside the slice, and none with half its limits.
tehas_sandbox_limits "tehas plan" "a turn" || exit 78
src=$TEHAS_WORK_REPO
# The workspace inside the container, and the directory on the host behind it.
repo=$TEHAS_WORK_DIR
tree=$TEHAS_WORK_DIR-plan-$issue
image=$PI_ENSEMBLE_IMAGE
limit=$TEHAS_PLAN_TIMEOUT
log=$TEHAS_HOME/logs/plan-$issue-$(date -u +%y%m%d-%H%M%S).jsonl
runner=/opt/pi-rukas/bin/pi-rukas-headless
name=tehas-plan-$issue
runs=$HOME/.pi/agent/ensemble-runs/plan-$issue
# The turn's own state on the host, beside the workspace and not in it.
container=$tree.state
index=$(tehas_index_dir)
images=$keep/images
# What a turn's container is given of them: a copy beside the workspace, so no
# container sees the state directory.
images_given=$tree.images
images_inside=$repo.images

tehas_github_env || { echo "tehas plan: no GitHub token for the app" >&2; exit 1; }
[ -n "${GH_TOKEN:-}" ] || { echo "tehas plan: GH_TOKEN is not set (source ~/tehas/env.sh)" >&2; exit 64; }
mkdir -p "$TEHAS_HOME/logs"

# "Update this issue" after a drafted plan runs no container.
console=$here/console
[ -x "$console" ] || { echo "tehas plan: no console beside this command at $console, run install.sh" >&2; exit 78; }
if [ -z "$brief" ] && [ "$(cat "$keep/exit" 2>/dev/null)" = 12 ] && grep -q -E ' chose: Update this issue$' "$answer"; then
  gh issue view "$issue" --repo "$TEHAS_REPO" --json title,body 2>/dev/null | "$console" plan update "$session" "$keep" >"$out.new" &&
    mv "$out.new" "$out" && { echo "tehas plan: issue=$issue session=$session update=yes"; exit 0; }
  echo "tehas plan: the drafted plan or the text of #$issue could not be read" >&2
  exit 2
fi

# The bot's identity is the tehas user's own. What the container is given is
# assembled by tehas-cycle sandbox, by the calls tehas work makes.
bot_name=$(git config --global user.name || true)
bot_email=$(git config --global user.email || true)
[ -n "$bot_name" ] && [ -n "$bot_email" ] ||
  { echo "tehas plan: git user.name and user.email are not set for $(id -un)" >&2; exit 64; }
# The images and the text files share one directory, given to the container
# when the instance gives either kind.
give=0
kinds=images
if [ "$TEHAS_WORK_FILES" = 1 ]; then
  give=1
  kinds=files
  [ "$TEHAS_WORK_IMAGES" != 1 ] || kinds="images and files"
fi
[ "$TEHAS_WORK_IMAGES" != 1 ] || give=1
# Its path is this command's to give, not the instance's: dropped whether or
# not this turn is given attachments, so no container names a directory tehas
# did not mount. So is the issue.
unset PI_ENSEMBLE_EXTRA_IMAGE_DIRS
unset PI_ENSEMBLE_PLAN_ISSUE
# So is where the session lives: in the clone, carried between turns below.
unset PI_ENSEMBLE_PLAN_SESSION_DIR PI_ENSEMBLE_PLAN_CACHE_TTL_MS
mapfile -d '' -t envs < <("$here/tehas-cycle" sandbox env turn "$repo" "$bot_name" "$bot_email")
mapfile -d '' -t hosts < <("$here/tehas-cycle" sandbox hosts)
[ "${#envs[@]}" -gt 0 ] ||
  { echo "tehas plan: could not prepare the sandbox, not starting a turn" >&2; exit 78; }
# The mounts of the turn are checked where they are made, after the clone: they
# name directories that do not exist until then.
# An image whose runner does not take planning turns runs none, before anything
# is fetched or cloned.
caps_wait=${TEHAS_CAPS_WAIT:-120}
[[ $caps_wait =~ ^[1-9][0-9]{0,3}$ ]] || caps_wait=120
caps=$(timeout -k 10 "$caps_wait" docker run --rm --init "$image" "$runner" --capabilities 2>/dev/null) || caps=""
if [ "$("$here/tehas-cycle" caps mode planTurns <<<"$caps")" != native ]; then
  echo "tehas plan: $image runs no planning turns (its --capabilities has no features.planTurns), not starting a turn" >&2
  exit 78
fi

# A fresh workspace for this turn, as a cycle gets one. Only a directory tehas
# made is ever removed.
works=$(dirname "$tree")
"$console" plan workspace "$works" "$keep" ${brief:+"$brief" "$here/../lib/issue-brief.md"} || exit 78

# The issue's images, once per session, from the first turn.
image_opts=()
if [ "$give" = 1 ]; then
  if [ -n "$brief" ]; then
    # tehas:plan or tehas:refine approved the text, links and all, as
    # tehas:ready does a cycle's.
    approved=""
    for label in tehas:plan tehas:refine; do
      tehas_label_allowed "$issue" "$label"
      case $? in
        0) approved=approved; break ;;
        2) approved=unread; break ;;
      esac
    done
    image_why="the issue's label events could not be read for its images"
    if [ "$approved" = unread ] || ! tehas_issue_images "$issue" "$images" "$approved"; then
      rm -rf "$images"
      echo "tehas plan: $image_why, not starting a turn" >&2
      gh issue comment "$issue" --repo "$TEHAS_REPO" --body "Tehas started no planning session: $image_why. This instance gives a session the $kinds an issue links, and a plan made without one of them may be the wrong plan. To retry, apply \`tehas:plan\`." >/dev/null 2>&1 ||
        echo "tehas plan: the comment on #$issue failed" >&2
      exit 4
    fi
    if [ "$TEHAS_WORK_DESCRIBE" = 1 ] && ! "$here/tehas-cycle" describe "$images"; then
      echo "tehas plan: the descriptions of the images could not be written, the session goes on without them" >&2
    fi
    said=$(tehas_issue_images_said "$images" "planning session" "$(tehas_rukas_reads_images)")
    if [ -n "$said" ]; then
      gh issue comment "$issue" --repo "$TEHAS_REPO" --body "$said" >/dev/null 2>&1 ||
        echo "tehas plan: the comment on #$issue failed" >&2
    fi
  elif [ -n "$comment" ] && [ -f "$images/manifest.json" ]; then
    # What the reply links. A session that began without the directory goes on
    # without it.
    if ! tehas_answer_images "$images" "$answer" "$comment"; then
      echo "tehas plan: $image_why, not starting a turn" >&2
      gh issue comment "$issue" --repo "$TEHAS_REPO" --body "Tehas ran no planning turn: $image_why. This instance gives a session the $kinds a reply links, and a plan made without one of them may be the wrong plan. Reply again to run the turn." >/dev/null 2>&1 ||
        echo "tehas plan: the comment on #$issue failed" >&2
      exit 4
    fi
    if [ -n "$answer_left" ]; then
      gh issue comment "$issue" --repo "$TEHAS_REPO" --body "Tehas left out of your reply:
$answer_left" >/dev/null 2>&1 || echo "tehas plan: the comment on #$issue failed" >&2
    fi
  fi
fi

"$console" plan give "$works" "$images" "$images_given" "$give" || exit 78
if [ -d "$images_given" ]; then
  image_opts=(-v "$images_given:$images_inside:ro" -e "PI_ENSEMBLE_EXTRA_IMAGE_DIRS=$images_inside"
    -e "PI_ENSEMBLE_PLAN_ISSUE=$issue")
fi

if ! { mkdir -p "$works" && : >"$works/.tehas-workspaces" && rm -rf "$tree" "$container" &&
  tehas_sandbox_clone "$src" "$tree" "$branch"; }; then
  echo "tehas plan: could not make the workspace $tree, not starting a turn" >&2
  exit 78
fi
"$console" plan place "$tree" "$keep" "$branch" ${brief:+first} || exit 78

if [ -n "$brief" ]; then
  what=$("$console" plan descriptor "$keep/brief.md" "$issue") ||
    { echo "tehas plan: the console gave no descriptor for the brief of #$issue" >&2; exit 78; }
  named=""
  ! "$here/tehas-cycle" caps verb plan --issue <<<"$caps" || named=$issue
  mapfile -d '' -t run < <("$console" plan turn first "$keep" "$what" "$named")
else
  mapfile -d '' -t run < <("$console" plan turn later "$keep" "$session" "$answer" "$tree" "$repo" "${answer_new:-}")
fi
[ "${#run[@]}" -gt 0 ] || exit 78

# The turn's own copy of the host's code index, asked for only once this turn
# will start: a turn that never began leaves no copy behind.
tehas_sandbox_seed "$container" "$index" ||
  echo "tehas plan: the code index could not be copied into $container/cache, this turn searches without one"
# The mounts name directories that only exist now.
mapfile -d '' -t mounts < <(tehas_sandbox_mounts turn "$repo" "$tree" "$container" "$runs")
[ "${#mounts[@]}" -gt 0 ] ||
  { echo "tehas plan: could not prepare the sandbox, not starting a turn" >&2; exit 78; }

user="$(id -u):$(id -g)"
set -- docker run --rm --init --name "$name" \
  "${TEHAS_SLICE_LIMITS[@]}" "${sec[@]}" --user "$user" \
  -w "$repo" "${mounts[@]}" "${image_opts[@]}" \
  "${envs[@]}" "${hosts[@]}" \
  "$image" "$runner" "${run[@]}"
exec "$console" plan run "$issue" "$session" "$kind" "$out" "$keep" "$tree" "$container" "$images_given" "$limit" "$log" "$name" -- "$@"
