#!/usr/bin/env bash
# Run one turn of a pi-rukas planning session headless, in the sandbox image.
#
# A planning session is a conversation with pi-rukas's planner that ends in a
# filed issue. It asks its operator questions on the way. Nobody is at a
# terminal here, so each turn is one run of pi-rukas's headless runner,
# `pi-rukas-headless plan`, which exits when it has something for the
# operator: questions, or a drafted plan to confirm. This command writes what
# the turn said and asked to a file and stops. The dispatcher posts it on the
# issue and, when an answer has come, runs the next turn in the same session.
# A tick on "File this plan" after a drafted plan files it.
#
# Usage:
#   tehas plan <issue-number> --out <file> --keep <dir> --brief <file>
#       First turn. <file> holds the approved title and body of the issue.
#   tehas plan <issue-number> --out <file> --keep <dir> --session <id> --answer <file> [--comment <id>]
#       A later turn. <file> holds the operator's answer. --comment names the
#       reply it came from, whose attachments the turn is given.
#
# <dir> is what the session carries from one turn to the next. The first turn
# makes it anew; the caller removes it when the session ends. It holds:
#   brief.md        the approved text of the issue. Every turn's workspace has
#                   it as .tehas/brief.md. The first turn gives it to the
#                   planner: its first line, less the "# ", as what to plan,
#                   and the whole text as the context.
#   commit          the commit the first turn's workspace was at. Every later
#                   turn's workspace is at the same one, so the planner plans
#                   against the code it began with.
#   plan-sessions/  pi-rukas's record of the session, which it keeps in the
#                   clone's git directory (.git/pi-plan-sessions). It is copied
#                   here when a turn ends and back before the next one starts.
#                   Only plain files are carried, at most 1 MB each. Nothing
#                   new is mounted and the container is given nothing new.
#   exit            the runner's exit status of the last turn. After 12, a
#                   drafted plan, an answer that chose "File this plan" runs
#                   the confirm.
#   images/         the issue's images, with TEHAS_WORK_IMAGES=1, and its text
#                   files, with TEHAS_WORK_FILES=1: fetched on the first turn
#                   as tehas work fetches a cycle's. Each turn
#                   is given a copy, $TEHAS_HOME/work/<name>-plan-<issue>.images,
#                   read-only, with PI_ENSEMBLE_EXTRA_IMAGE_DIRS, and the copy
#                   is removed with the workspace. With TEHAS_WORK_DESCRIBE=1
#                   it holds images.md too, written on the first turn. A
#                   later turn with --comment adds what the reply links, by
#                   the same rules and limits, numbered on from the files
#                   there, source "answer:<id>", and the answer sent to the
#                   planner names the new files. The turn's container is then
#                   also told PI_ENSEMBLE_PLAN_ISSUE, the issue's number.
#                   The comment that says what a session was given says
#                   whether it was shown them, which is what the sandbox
#                   image's own label answers.
#
# What a turn runs, by the runner's own flags (docs/headless.md in pi-rukas):
#   first turn                    plan "<what to plan>" --start --context <brief>
#   after a plan was shown (12),
#     an answer "File this plan"  plan --resume <id> --confirm
#   any other answer              plan --resume <id> --answer <file>
# The runner writes one JSON document to stdout and NDJSON progress to stderr.
#
# On exit 0 the --out file holds
#   {"session": "<id>", "text": "<what the turn says>",
#    "question": null | {"question": "...", "options": [{"label", "description"}]},
#    "filed": ["<issue address>", ...]}
# for each runner exit as follows:
#   11 questions      the planner's questions; one is asked as it is, two or
#                     more as one numbered text. Answered by a reply.
#   12 shown          the drafted plan, its title and spec, after the turn's
#                     text; its open points with the planner's proposed
#                     resolutions; one option, "File this plan".
#   10 duplicate-risk the turn's text; answered by a reply.
#    0 filed          the issue the confirm filed, under "filed".
# "filed" holds the issues this session filed; with none there is no such key.
# The dispatcher posts them on the issue and names them to the next turn.
# On exit 2 it holds only {"session": "<id>"} when the session is known, and
# {"session": "<id>", "lost": true} when the runner says the session is gone
# (exit 41): the session cannot go on. When no session is known, nothing is
# written.
#
# Exit status: 0 the turn ended with something to say or ask, or it filed,
#              2 the runner failed, ran out of time, refused the turn, said
#                and asked nothing, its session is gone, or its outcome could
#                not be written down,
#              4 the instance gives images or files and one could not be
#                fetched, for a first turn or from a reply; said on the issue,
#                nothing ran,
#             64 a usage error, no bot token or no git identity; nothing ran,
#             78 the instance settings are invalid, tehas.slice is not usable
#                on this host, or the image runs no planning turns (its
#                --capabilities has no features.planTurns); nothing ran.
#
# Instance settings (lib/config.sh; defaults in brackets):
#   TEHAS_PLAN_TIMEOUT  seconds before a turn is given up [7200, the ceiling
#                       TEHAS_PLAN_TIMEOUT_MAX in lib/config.sh]
#   and those of tehas work for the checkout and the container's limits.
#
# The container is given exactly what a cycle's container is given: the same
# image, limits, mounts and variables, assembled by lib/sandbox.sh and
# lib/slice.sh and pinned by test/plan_test.sh, and the issue's images as a
# cycle gets them. It differs in its name, in its command and in having no cid
# file. Not the Docker socket, SSH keys or ~/.config/tehas. It runs in
# tehas.slice with a cycle's limits, so the dispatcher counts its memory with
# the cycles'. Without a usable slice nothing is cloned and nothing starts.
#
# The workspace is $TEHAS_HOME/work/<name>-plan-<issue>, a fresh clone made for
# every turn and removed when the turn is over. Inside the container it is at
# the path every cycle has its own, $TEHAS_HOME/work/<name>. The transcripts go
# to ~/.pi/agent/ensemble-runs/plan-<issue>, so a turn and a cycle see nothing
# of each other. Beside the workspace is <name>-plan-<issue>.state, the turn's
# own copy of the code index and its own memory, removed with the workspace.
set -uo pipefail

usage() {
  echo "usage: tehas plan <issue-number> --out <file> --keep <dir> (--brief <file> | --session <id> --answer <file> [--comment <id>])" >&2
  exit 64
}

issue=${1:-}
case "$issue" in '' | *[!0-9]*) usage ;; esac
shift
out=""
keep=""
brief=""
answer=""
session=""
comment=""
while [ "$#" -gt 0 ]; do
  [ "$#" -ge 2 ] || usage
  case "$1" in
    --out) out=$2 ;;
    --keep) keep=$2 ;;
    --brief) brief=$2 ;;
    --answer) answer=$2 ;;
    --session) session=$2 ;;
    --comment) comment=$2 ;;
    *) usage ;;
  esac
  shift 2
done
[ -n "$out" ] && [ -n "$keep" ] || usage
if [ -n "$brief" ]; then
  [ -z "$session$answer$comment" ] && [ -r "$brief" ] || usage
else
  [ -n "$session" ] && [ -n "$answer" ] && [ -r "$answer" ] || usage
fi
# The id ends up on a command line: letters, digits and dashes only.
case "$session" in *[!A-Za-z0-9-]*) usage ;; esac
case "$comment" in *[!0-9]*) usage ;; esac

here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source=lib/config.sh
. "$here/../lib/config.sh"
# shellcheck source=lib/sandbox.sh
. "$here/../lib/sandbox.sh"
# shellcheck source=lib/slice.sh
. "$here/../lib/slice.sh"
# shellcheck source=lib/attachments.sh
. "$here/../lib/attachments.sh"
# shellcheck source=lib/describe.sh
. "$here/../lib/describe.sh"
# shellcheck source=lib/labels.sh
. "$here/../lib/labels.sh"
# shellcheck source=lib/cycles.sh
. "$here/../lib/cycles.sh"
# shellcheck source=lib/headless.sh
. "$here/../lib/headless.sh"
tehas_load || exit 78
tehas_require TEHAS_REPO PI_ENSEMBLE_SUBAGENT_MODEL PI_ENSEMBLE_SUBAGENT_PROVIDER
tehas_sandbox_settings_ok || exit 78
# Docker would create a missing mount source as a root-owned directory.
tehas_checkout || exit 78
branch=$(tehas_branch) || exit 78
# No container starts outside the slice, and none with half its limits.
TEHAS_SLICE_LIMITS=()
tehas_slice_ok || { echo "tehas plan: $TEHAS_SLICE_WHY" >&2; exit 78; }
tehas_slice_limits || true
if [ "${#TEHAS_SLICE_LIMITS[@]}" != 14 ] || [ "${TEHAS_SLICE_LIMITS[1]}" != tehas.slice ]; then
  echo "tehas plan: the container limits could not be made, not starting" >&2
  exit 78
fi
src=$TEHAS_WORK_REPO
# The workspace inside the container, and the directory on the host behind it.
repo=$TEHAS_WORK_DIR
tree=$TEHAS_WORK_DIR-plan-$issue
image=$PI_ENSEMBLE_IMAGE
limit=$TEHAS_PLAN_TIMEOUT
log=$TEHAS_HOME/logs/plan-$issue-$(date -u +%y%m%d-%H%M%S).jsonl
# The runner's one JSON document, beside its NDJSON progress.
doc=${log%.jsonl}.json
runner=/opt/pi-rukas/bin/pi-rukas-headless
name=tehas-plan-$issue
runs=$HOME/.pi/agent/ensemble-runs/plan-$issue
# The turn's own state on the host, beside the workspace and not in it.
container=$tree.state
index=$(tehas_index_dir)
images=$keep/images
# What a turn's container is given of them: a copy beside the workspace, so no
# container sees the state directory.
images_given=$tree.images
images_inside=$repo.images
# pi-rukas keeps a session in the clone's git directory when
# PI_ENSEMBLE_PLAN_SESSION_DIR is unset, which is how it is left here.
sessions=$tree/.git/pi-plan-sessions

[ -n "${GH_TOKEN:-}" ] || { echo "tehas plan: GH_TOKEN is not set (source ~/tehas/env.sh)" >&2; exit 64; }
mkdir -p "$TEHAS_HOME/logs"

# The bot's identity is the tehas user's own. What the container is given is
# assembled in lib/sandbox.sh, by the calls tehas work makes.
bot_name=$(git config --global user.name || true)
bot_email=$(git config --global user.email || true)
[ -n "$bot_name" ] && [ -n "$bot_email" ] ||
  { echo "tehas plan: git user.name and user.email are not set for $(id -un)" >&2; exit 64; }
# The images and the text files share one directory, given to the container
# when the instance gives either kind.
give=0
kinds=images
if [ "$TEHAS_WORK_FILES" = 1 ]; then
  give=1
  kinds=files
  [ "$TEHAS_WORK_IMAGES" != 1 ] || kinds="images and files"
fi
[ "$TEHAS_WORK_IMAGES" != 1 ] || give=1
# Its path is this command's to give, not the instance's: dropped whether or
# not this turn is given attachments, so no container names a directory tehas
# did not mount. So is the issue.
unset PI_ENSEMBLE_EXTRA_IMAGE_DIRS
unset PI_ENSEMBLE_PLAN_ISSUE
# So is where the session lives: in the clone, carried between turns below.
unset PI_ENSEMBLE_PLAN_SESSION_DIR PI_ENSEMBLE_PLAN_CACHE_TTL_MS
mapfile -d '' -t envs < <(tehas_sandbox_env "$repo" "$bot_name" "$bot_email")
mapfile -d '' -t hosts < <(tehas_sandbox_hosts)
mapfile -d '' -t sec < <(tehas_sandbox_security)
[ "${#envs[@]}" -gt 0 ] && [ "${#sec[@]}" -eq 8 ] ||
  { echo "tehas plan: could not prepare the sandbox, not starting a turn" >&2; exit 78; }
# An image whose runner does not take planning turns runs none, before anything
# is fetched or cloned.
caps_wait=${TEHAS_CAPS_WAIT:-120}
[[ $caps_wait =~ ^[1-9][0-9]{0,3}$ ]] || caps_wait=120
caps=$(timeout -k 10 "$caps_wait" docker run --rm --init "$image" "$runner" --capabilities 2>/dev/null) || caps=""
if ! tehas_headless_plans "$caps"; then
  echo "tehas plan: $image runs no planning turns (its --capabilities has no features.planTurns), not starting a turn" >&2
  exit 78
fi

# A fresh workspace for this turn, as a cycle gets one. Only a directory tehas
# made is ever removed.
works=$(dirname "$tree")
if [ -e "$works" ] && [ ! -f "$works/.tehas-workspaces" ]; then
  echo "tehas plan: $works exists and was not made by tehas, not touching it" >&2
  exit 78
fi
if [ -n "$brief" ]; then
  rm -rf "$keep"
fi
if ! mkdir -p "$keep"; then
  echo "tehas plan: could not make $keep, not starting a turn" >&2
  exit 78
fi
if [ -n "$brief" ] && ! cp "$brief" "$keep/brief.md"; then
  echo "tehas plan: could not keep the brief in $keep, not starting a turn" >&2
  exit 78
fi

# The issue's images, once per session, from the first turn.
image_opts=()
if [ "$give" = 1 ]; then
  if [ -n "$brief" ]; then
    # tehas:plan or tehas:refine approved the text, links and all, as
    # tehas:ready does a cycle's.
    approved=""
    for label in tehas:plan tehas:refine; do
      tehas_label_allowed "$issue" "$label"
      case $? in
        0) approved=approved; break ;;
        2) approved=unread; break ;;
      esac
    done
    image_why="the issue's label events could not be read for its images"
    if [ "$approved" = unread ] || ! tehas_issue_images "$issue" "$images" "$approved"; then
      rm -rf "$images"
      echo "tehas plan: $image_why, not starting a turn" >&2
      gh issue comment "$issue" --repo "$TEHAS_REPO" --body "Tehas started no planning session: $image_why. This instance gives a session the $kinds an issue links, and a plan made without one of them may be the wrong plan. To retry, apply \`tehas:plan\`." >/dev/null 2>&1 ||
        echo "tehas plan: the comment on #$issue failed" >&2
      exit 4
    fi
    if [ "$TEHAS_WORK_DESCRIBE" = 1 ] && ! tehas_describe_images "$images"; then
      echo "tehas plan: the descriptions of the images could not be written, the session goes on without them" >&2
    fi
    said=$(tehas_issue_images_said "$images" "planning session" "$(tehas_rukas_reads_images)")
    if [ -n "$said" ]; then
      gh issue comment "$issue" --repo "$TEHAS_REPO" --body "$said" >/dev/null 2>&1 ||
        echo "tehas plan: the comment on #$issue failed" >&2
    fi
  elif [ -n "$comment" ] && [ -f "$images/manifest.json" ]; then
    # What the reply links. A session that began without the directory goes on
    # without it.
    if ! tehas_answer_images "$images" "$answer" "$comment"; then
      echo "tehas plan: $image_why, not starting a turn" >&2
      gh issue comment "$issue" --repo "$TEHAS_REPO" --body "Tehas ran no planning turn: $image_why. This instance gives a session the $kinds a reply links, and a plan made without one of them may be the wrong plan. Reply again to run the turn." >/dev/null 2>&1 ||
        echo "tehas plan: the comment on #$issue failed" >&2
      exit 4
    fi
    if [ -n "$answer_left" ]; then
      gh issue comment "$issue" --repo "$TEHAS_REPO" --body "Tehas left out of your reply:
$answer_left" >/dev/null 2>&1 || echo "tehas plan: the comment on #$issue failed" >&2
    fi
  fi
fi

if ! { mkdir -p "$works" && : >"$works/.tehas-workspaces" && rm -rf "$images_given"; }; then
  echo "tehas plan: could not make $works, not starting a turn" >&2
  exit 78
fi
# A session that began without them goes on without them.
if [ "$give" = 1 ] && [ -f "$images/manifest.json" ]; then
  if ! cp -r "$images" "$images_given"; then
    echo "tehas plan: could not copy the issue's images to $images_given, not starting a turn" >&2
    exit 78
  fi
  image_opts=(-v "$images_given:$images_inside:ro" -e "PI_ENSEMBLE_EXTRA_IMAGE_DIRS=$images_inside"
    -e "PI_ENSEMBLE_PLAN_ISSUE=$issue")
fi

if ! { mkdir -p "$works" && : >"$works/.tehas-workspaces" && rm -rf "$tree" "$container" &&
  tehas_sandbox_clone "$src" "$tree" "$branch"; }; then
  echo "tehas plan: could not make the workspace $tree, not starting a turn" >&2
  exit 78
fi
# carry <from> <to>: the plain files of one session directory into another,
# under the same relative paths, with what <to> held before dropped. A symlink
# or a file over 1 MB is left out. The copy is made beside <to> and moved into
# place, so a failure leaves what was there.
carry() {
  local f
  rm -rf "$2.new" || return 1
  if [ -d "$1" ]; then
    mkdir -p "$2.new" || return 1
    while IFS= read -r -d '' f; do
      if ! { mkdir -p "$2.new/$(dirname "$f")" && cp "$1/$f" "$2.new/$f"; }; then
        rm -rf "$2.new"
        return 1
      fi
    done < <(cd "$1" && find . -type f ! -size +1024k -print0)
  fi
  rm -rf "$2" || { rm -rf "$2.new"; return 1; }
  [ ! -d "$2.new" ] || mv "$2.new" "$2"
}
if [ -n "$brief" ]; then
  if ! git -C "$tree" rev-parse HEAD >"$keep/commit"; then
    echo "tehas plan: could not note the commit of $tree, not starting a turn" >&2
    exit 78
  fi
else
  # Moving on without the commit is safe: the planner then plans against the
  # tip, and a confirm files the plan that was shown, whatever the code.
  pin=$(cat "$keep/commit" 2>/dev/null) || pin=""
  case "$pin" in
    '' | *[!0-9a-f]*) echo "tehas plan: no commit on record for this session, the turn starts at the tip of $branch" ;;
    *)
      git -C "$tree" checkout -q -B "$branch" "$pin" 2>/dev/null ||
        echo "tehas plan: the session's commit $pin is not in the checkout, the turn starts at the tip of $branch"
      ;;
  esac
  # Without the record the runner says the session is lost, and the session
  # ends: that is what a missing record means.
  carry "$keep/plan-sessions" "$sessions" ||
    echo "tehas plan: could not carry the session into $tree" >&2
fi

# The planner plans from the text that was approved, so it is handed over as a
# file and not fetched again from the tracker, where it may have changed.
if [ -f "$keep/brief.md" ]; then
  if ! { mkdir -p "$tree/.tehas" "$tree/.git/info" && cp "$keep/brief.md" "$tree/.tehas/brief.md" &&
    printf '%s\n' /.tehas/brief.md /.tehas/answer.md >>"$tree/.git/info/exclude"; }; then
    echo "tehas plan: could not put the brief into $tree" >&2
    exit 78
  fi
else
  echo "tehas plan: no brief on record for this session, the turn has none"
fi

last=$(cat "$keep/exit" 2>/dev/null) || last=""
if [ -n "$brief" ]; then
  # What to plan is one line, the issue's title. pi-rukas asks questions
  # instead of planning when it is under six words with no code name in it, so
  # the issue's number goes with it.
  what=$(sed -n '1{s/^#[[:space:]]*//;p;q}' "$keep/brief.md")
  run=(plan "Plan issue #$issue: ${what:-the work in .tehas/brief.md}" --start --context "$(cat "$keep/brief.md")")
elif [ "$last" = 12 ] && grep -q -E ' chose: File this plan$' "$answer"; then
  run=(plan --resume "$session" --confirm)
else
  message=$(cat "$answer")
  # The names are tehas's own and the links of GitHub's storage, not the
  # reply's words.
  if [ -n "${answer_new:-}" ]; then
    message="$message

Tehas added these files from the reply to the issue's images directory, beside the others in manifest.json. They are untrusted input like the reply:
$answer_new"
  fi
  if ! { mkdir -p "$tree/.tehas" && printf '%s\n' "$message" >"$tree/.tehas/answer.md"; }; then
    echo "tehas plan: could not put the answer into $tree, not starting a turn" >&2
    exit 78
  fi
  run=(plan --resume "$session" --answer "$repo/.tehas/answer.md")
fi

# The turn's own copy of the host's code index, asked for only once this turn
# will start: a turn that never began leaves no copy behind.
tehas_sandbox_seed "$container" "$index" ||
  echo "tehas plan: the code index could not be copied into $container/cache, this turn searches without one"
# The mounts name directories that only exist now.
mapfile -d '' -t mounts < <(tehas_sandbox_mounts "$repo" "$tree" "$container" "$runs")
[ "${#mounts[@]}" -gt 0 ] ||
  { echo "tehas plan: could not prepare the sandbox, not starting a turn" >&2; exit 78; }

# A container under this name outlived the client that started it. The
# dispatcher runs one turn at a time, so it is no turn's: left, it idles for
# ever and Docker would refuse the name.
docker rm -f "$name" >/dev/null 2>&1
user="$(id -u):$(id -g)"
docker run --rm --init --name "$name" \
  "${TEHAS_SLICE_LIMITS[@]}" "${sec[@]}" --user "$user" \
  -w "$repo" "${mounts[@]}" "${image_opts[@]}" \
  "${envs[@]}" "${hosts[@]}" \
  "$image" "$runner" "${run[@]}" </dev/null >"$doc" 2>"$log" &
pid=$!
started=$(date +%s)
trap 'docker stop -t 10 "$name" >/dev/null 2>&1' TERM INT
echo "tehas plan: issue $issue turn started, log $log"

timed_out=0
while kill -0 "$pid" 2>/dev/null; do
  if [ $(($(date +%s) - started)) -ge "$limit" ]; then
    echo "tehas plan: time limit of ${limit}s passed"
    timed_out=1
    docker stop -t 20 "$name" >/dev/null 2>&1
    break
  fi
  sleep 1
done
wait "$pid" 2>/dev/null
rc=$?
[ "$timed_out" = 0 ] || rc=124

# The session, before the workspace goes: it is all a later turn has of this
# one. A turn whose runner kept none replaces what an earlier turn kept.
carry "$sessions" "$keep/plan-sessions" || echo "tehas plan: could not keep the session of $tree" >&2
printf '%s\n' "$rc" >"$keep/exit" || echo "tehas plan: could not keep the exit status in $keep" >&2
rm -rf "$tree" "$container" "$images_given" || echo "tehas plan: could not remove the workspace $tree" >&2

answer_doc=$(jq -c 'objects' "$doc" 2>/dev/null | head -n 1)
[ -n "$answer_doc" ] || answer_doc='{}'
sid=$(jq -r '.session.id // "" | strings | select(test("^[A-Za-z0-9-]+$"))' <<<"$answer_doc")
[ -n "$sid" ] || sid=$session

# give_up <what happened> [lost]: the turn failed. The session, when it is
# known, is all that is left for the caller. With "lost" the outcome says the
# session is gone, so the caller ends it.
give_up() {
  echo "tehas plan: issue=$issue $1, see $log"
  if [ -n "$sid" ]; then
    if ! jq -n --arg session "$sid" --arg lost "${2:-}" '{session: $session} + (if $lost == "" then {} else {lost: true} end)' >"$out.new" ||
      ! mv "$out.new" "$out"; then
      echo "tehas plan: could not write $out" >&2
    fi
  fi
  exit 2
}

why=$(jq -r '[.error.code, .error.message, .failure.reason, .failure.detail] | map(strings) | join(": ")' <<<"$answer_doc")
case "$rc" in
  0 | 10 | 11 | 12) ;;
  41) give_up "the session $session is gone: the runner has no record of it" lost ;;
  124) give_up "the turn ran out of time" ;;
  *) give_up "the runner exited $rc${why:+ ($why)}" ;;
esac
[ -n "$sid" ] || give_up "the session id is unknown"

# The comment holds the plan, so a spec too long for one GitHub comment is cut.
outcome=$(jq -c --argjson rc "$rc" '
  def clip: if length > 40000 then .[0:40000] + "\n\n(cut: the plan is longer than a comment holds)" else . end;
  (.questions // [] | map(select(type == "object"))) as $qs
  | ($qs | map("\(.question // "")" + (if (.resolution // "") == "" then "" else "\n   Proposed: \(.resolution)" end))) as $asked
  | ($asked | to_entries | map("\(.key + 1). \(.value)") | join("\n\n")) as $numbered
  | if $rc == 0 then
      {text: ("Filed " + ((.url // .issueUrl // "") | tostring) + (if (.title // "") == "" then "" else ": \(.title)" end) + "."),
       question: null,
       filed: [(.url // .issueUrl) | strings | select(test("^https://github\\.com/[^/]+/[^/]+/issues/[0-9]+$"))]}
    elif $rc == 12 then
      {text: ((.text // "") + "\n\n### \(.title // "The plan")\n\n" + ((.spec // "") | tostring | clip)),
       question: {question: ((if ($qs | length) == 0 then "" else "Open points, with the planner'"'"'s proposals:\n\n\($numbered)\n\n" end)
                    + "Tick File this plan to file it as shown, proposals included, or reply to change it."),
                  options: [{label: "File this plan", description: "file the plan above as one issue"}]}}
    elif $rc == 11 and ($qs | length) == 1 then
      {text: (.text // ""), question: {question: $asked[0], options: []}}
    elif $rc == 11 and ($qs | length) > 1 then
      {text: (.text // ""), question: {question: ("The planner asked \($qs | length) questions. Answer each by its number in a reply.\n\n" + $numbered), options: []}}
    elif $rc == 10 then
      {text: (.text // ""), question: {question: "pi-rukas thinks this plan duplicates open work. Reply to say why it does not, or end the session.", options: []}}
    else {text: (.text // ""), question: null} end
  | .filed = ((.filed // []) | unique)' <<<"$answer_doc" 2>/dev/null)
[ -n "$outcome" ] || give_up "the runner's answer could not be read"
if [ "$(jq -r '(.text | length > 0) or .question != null or (.filed | length > 0)' <<<"$outcome")" != true ]; then
  give_up "the turn said and asked nothing"
fi

if ! jq --arg session "$sid" '{session: $session, text, question} + (if .filed == [] then {} else {filed} end)' <<<"$outcome" >"$out.new" ||
  ! mv "$out.new" "$out"; then
  echo "tehas plan: could not write $out" >&2
  exit 2
fi
echo "tehas plan: issue=$issue session=$sid runner_exit=$rc asked=$(jq -r 'if .question == null then "no" else "yes" end' <<<"$outcome") seconds=$(($(date +%s) - started))"
