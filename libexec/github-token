#!/usr/bin/env bash
# The GitHub App's token: tehasbot github-token, console/src/github.rs. Only a
# path: the gh shim and the poll run this file, and the renewer of a cycle that
# started before an update names it under the home, whatever that update installs.
#
# Usage: github-token [--check]
#
# Exit: the command's; 78 no console.
here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
console=${TEHAS_CONSOLE:-$here/console}
[ -x "$console" ] || { echo "tehasbot github-token: no console at $console: run install.sh" >&2; exit 78; }
exec "$console" run "$here" "$EUID" "$BASH" tehasbot github-token "$@"
