#!/usr/bin/env bash
# tehas init-product: propose the contract files the product is missing, as a
# pull request opened by the bot.
#
# Usage:
#   tehas init-product             write the missing files on a branch, push it
#                                  and open a pull request
#   tehas init-product --dry-run   print the files it would write, change nothing
#
# What it writes, only where the default branch has no such file:
#   AGENTS.md             a short template for a person to fill in
#   .pi/verify-cmd        the gate, guessed from the product's stack
#   .pi/worktree-setup    the install step, guessed the same way, when there is one
#
# The stack is guessed from the default branch's Makefile (a test or check
# target), package.json, Cargo.toml, go.mod, pyproject.toml, or else the run
# steps of its CI workflows. Every guessed file says in a comment that a person
# should check it. With no guess, .pi/verify-cmd holds only that comment, and
# tehas check-product still fails on it.
#
# The work happens in a fresh clone under $TEHAS_HOME/tmp, removed afterwards.
# The branch is tehas/init-product; it never commits to the default branch.
# The push uses gh's credentials.
#
# Exit: 0 the pull request is open, or nothing is missing; 1 git or gh failed,
# or the branch is already on origin; 64 a wrong argument; 78 the instance
# settings are missing or malformed, or the checkout is not a clone of
# TEHAS_REPO.
#
# Instance settings (lib/config.sh): TEHAS_REPO, required; TEHAS_WORK_REPO,
# derived; TEHAS_BRANCH, optional.
set -uo pipefail

dry=0
case "$#:${1-}" in
  0:) ;;
  1:--dry-run) dry=1 ;;
  *) echo "usage: tehas init-product [--dry-run]" >&2; exit 64 ;;
esac

here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source=lib/config.sh
. "$here/../lib/config.sh"
tehas_load || exit 78
tehas_require TEHAS_REPO
tehas_checkout || exit 78
branch=$(tehas_branch) || exit 78
src=$TEHAS_WORK_REPO
head=tehas/init-product
[ "$head" != "$branch" ] || { echo "tehas init-product: the default branch is $head" >&2; exit 78; }

mkdir -p "$TEHAS_HOME/tmp" || exit 1
tree=$(mktemp -d "$TEHAS_HOME/tmp/init-product.XXXXXX") || exit 1
trap 'rm -rf "$tree"' EXIT
url=$(git -C "$src" config --get remote.origin.url)
if ! { git -C "$tree" init -q && git -C "$tree" remote add origin "$url" &&
  git -C "$tree" fetch -q --no-tags "$src" "refs/remotes/origin/$branch" &&
  git -C "$tree" checkout -q -b "$head" FETCH_HEAD; }; then
  echo "tehas init-product: $src has no origin/$branch to start from" >&2
  exit 1
fi

check="# Guessed by tehas init-product from the repository's files. A person should
# check it: the first line that is not empty or a comment is run."

# A Makefile target, when the Makefile has one of these names.
make_target() {
  local t
  for t in "$@"; do
    grep -q -E "^$t:" "$tree/Makefile" 2>/dev/null && { echo "$t"; return 0; }
  done
  return 1
}

# The tool a package.json's lockfile says, and its install command.
node_tool() {
  if [ -f "$tree/pnpm-lock.yaml" ]; then echo "pnpm|pnpm install --frozen-lockfile"
  elif [ -f "$tree/yarn.lock" ]; then echo "yarn|yarn install --frozen-lockfile"
  elif [ -f "$tree/bun.lockb" ] || [ -f "$tree/bun.lock" ]; then echo "bun|bun install --frozen-lockfile"
  elif [ -f "$tree/package-lock.json" ]; then echo "npm|npm ci"
  else echo "npm|npm install"
  fi
}

# Two lines: the stack, then the gate; a third, the install step, when there
# is one.
guess() {
  local t tool install run
  if [ -f "$tree/Makefile" ] && t=$(make_target test check verify); then
    printf '%s\n' Makefile "make $t"
  elif [ -f "$tree/package.json" ]; then
    IFS='|' read -r tool install < <(node_tool)
    for t in test check build; do
      if jq -e --arg s "$t" '.scripts[$s] // empty' "$tree/package.json" >/dev/null 2>&1; then
        run="$tool run $t"
        [ "$t" != test ] || run="$tool test"
        printf '%s\n' package.json "$run" "$install"
        return 0
      fi
    done
    printf '%s\n' package.json "" "$install"
  elif [ -f "$tree/Cargo.toml" ]; then
    printf '%s\n' Cargo.toml "cargo test" "cargo fetch"
  elif [ -f "$tree/go.mod" ]; then
    printf '%s\n' go.mod "go test ./..." "go mod download"
  elif [ -f "$tree/pyproject.toml" ]; then
    if [ -f "$tree/uv.lock" ]; then
      printf '%s\n' pyproject.toml "uv run pytest" "uv sync"
    else
      printf '%s\n' pyproject.toml "python -m pytest" "pip install -e ."
    fi
  elif run=$({ cat "$tree"/.github/workflows/*.yml "$tree"/.github/workflows/*.yaml 2>/dev/null || true; } |
    sed -n 's/^[[:space:]-]*run:[[:space:]]*\(.*[^[:space:]]\)[[:space:]]*$/\1/p' |
    grep -E -i 'test|check|verify|lint' | head -n 1) && [ -n "$run" ]; then
    printf '%s\n' "a CI workflow" "$run"
  else
    printf '%s\n' "nothing"
  fi
}

mapfile -t g < <(guess)
stack=${g[0]} gate=${g[1]:-} install=${g[2]:-}

wrote=()
put() { # <path> <text>
  if git -C "$tree" cat-file -e "HEAD:$1" 2>/dev/null; then
    return 0
  fi
  wrote+=("$1")
  if [ "$dry" = 1 ]; then
    printf '=== %s\n%s\n' "$1" "$2"
    return 0
  fi
  mkdir -p "$(dirname "$tree/$1")" && printf '%s\n' "$2" >"$tree/$1"
}

put AGENTS.md "# AGENTS.md

Rules for agents working in this repository.

## What this is

<What the product is and how the repository is laid out.>

## Rules

- <What never to touch, architecture rules, anything agents get wrong.>
- Open a pull request and stop. Never push to the default branch.

## Verify

\`.pi/verify-cmd\` is the fast gate. Run it before you say a change is done.

## Commits

<Commit style.>" || exit 1

if [ -n "$gate" ]; then
  put .pi/verify-cmd "$check
# Stack: $stack.
$gate" || exit 1
else
  put .pi/verify-cmd "# tehas init-product could not guess a gate from the repository's files.
# Write the command that tests the product on the first line that is not a comment." || exit 1
fi
if [ -n "$install" ]; then
  put .pi/worktree-setup "#!/bin/sh
$check
# Stack: $stack.
set -e
$install" || exit 1
fi

if [ "${#wrote[@]}" = 0 ]; then
  echo "tehas init-product: $TEHAS_REPO has every file this proposes"
  exit 0
fi
echo "tehas init-product: stack $stack; proposing ${wrote[*]}"
[ "$dry" = 0 ] || exit 0

if [ -n "$(git -C "$tree" ls-remote --heads origin "$head" 2>/dev/null)" ]; then
  echo "tehas init-product: $head is already on origin: review or close its pull request first" >&2
  exit 1
fi
[ ! -f "$tree/.pi/worktree-setup" ] || chmod +x "$tree/.pi/worktree-setup"
body="The files of the tehas contract that the default branch does not have yet: ${wrote[*]}.

The gate and the install step are guessed from the repository's files (stack: $stack). Check them, and fill in AGENTS.md, before you merge. \`tehas check-product\` says what is still missing."
if ! { git -C "$tree" add -- "${wrote[@]}" &&
  git -C "$tree" commit -q -m "The tehas contract files" &&
  git -C "$tree" -c credential.helper= -c 'credential.helper=!gh auth git-credential' push -q origin "$head"; }; then
  echo "tehas init-product: could not commit and push $head" >&2
  exit 1
fi
gh pr create --repo "$TEHAS_REPO" --base "$branch" --head "$head" \
  --title "The tehas contract files" --body "$body" || exit 1
