#!/usr/bin/env bash
# Say what this factory speaks: the API version, the release and commit it
# was installed from, its repository, the features this release has and the
# fixer's login. A program asks this first, before it relies on a feature.
#
# The release and commit are those install.sh wrote to
# $TEHAS_HOME/docs/version.txt: "v0.8.0+cb6912a" from a checkout, the bare tag
# "v0.10.2" from a release, or the bare commit from a checkout with no tag.
# Either is null when the install recorded only the other, and both when it
# recorded nothing. No network and no git, and it writes nothing.
#
# Usage: tehas api [--json]
#
#   api       1
#   tehas     v0.8.0 (cb6912a)
#   repo      tehas-app/tehas
#   features  status fixer-grant all-hands limit drain history export refresh-conflicts analytics
#   fixer     none
#
# With --json the same as one object on standard output:
#   {"api": 1, "tehas": "v0.8.0", "commit": "cb6912a", "repo": "tehas-app/tehas",
#    "features": ["status", "fixer-grant", "all-hands", "limit", "drain",
#                 "history", "export", "refresh-conflicts", "analytics"],
#    "fixer": null}
#
# Exit: 0 printed; 64 an argument this command does not know; 78 instance
# settings are missing or malformed.
set -uo pipefail

json=0
case "$#:${1-}" in
  0:) ;;
  1:--json) json=1 ;;
  *) echo "usage: tehas api [--json]" >&2; exit 64 ;;
esac

here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source=lib/config.sh
. "$here/../lib/config.sh"
TEHAS_SILENT_RENAMED=1 tehas_load || exit 78
tehas_require TEHAS_REPO

# What this release can do. A feature is added here in the release that
# brings it, and never taken out within api 1.
features='["status", "fixer-grant", "all-hands", "limit", "drain", "history", "export", "refresh-conflicts", "analytics"]'

# "v0.8.0+cb6912a" from a checkout, "v0.10.2" from a release, or "cb6912a"
# from a checkout with no tag.
# Read without a pipe: under pipefail the first head can die of SIGPIPE when
# the second has its line, and the version would be lost.
version=$(head -c 200 "$TEHAS_HOME/docs/version.txt" 2>/dev/null) || version=""
version=${version%%$'\n'*}
object=$(jq -nc --arg v "$version" --arg repo "$TEHAS_REPO" --arg fixer "${TEHAS_FIXER_LOGIN:-}" --argjson features "$features" '
  ($v | split("+")) as $p
  | (if ($p | length) == 1 and ($v | test("^v[0-9]+\\.[0-9]+\\.[0-9]+$")) then $v else null end) as $tag
  | {api: 1,
     tehas: (if $tag != null then $tag elif ($p | length) == 2 then $p[0] else null end),
     commit: (if $v == "" then null elif $tag != null then null else $p[-1] end),
     repo: $repo,
     features: $features,
     fixer: (if $fixer == "" then null else $fixer end)}') || exit 1

if [ "$json" = 1 ]; then
  printf '%s\n' "$object"
else
  jq -r '"api       \(.api)",
    "tehas     \(.tehas // "unknown")\(if .commit == null then "" else " (\(.commit))" end)",
    "repo      \(.repo)",
    "features  \(.features | join(" "))",
    "fixer     \(.fixer // "none")"' <<<"$object"
fi
