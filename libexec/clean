#!/usr/bin/env bash
# Remove what the host can make again: build output in kept workspaces,
# Docker's build cache, old sandbox and base images, and old files under
# ~/tehas/tmp.
#
# A full disk stops previews and fails clones. Most of what fills it is
# something the next build makes again, and a kept workspace is never built in
# again: every cycle clones fresh (libexec/work), so the build output of a kept
# one is dead weight until the 7-day sweep takes the workspace itself
# (sweep_workspaces in libexec/dispatch). The cleaner takes the weight first
# and leaves the workspace for a person to read.
#
# It removes only these, and only what has not been used for
# TEHAS_CLEAN_AFTER hours (24 by default):
#
#   1. build output in kept workspaces   every directory anywhere under an
#                                        issue's kept workspace whose name is
#                                        one of TEHAS_CLEAN_DIRS, and
#                                        <name>-<n>.state/cache, the cycle's
#                                        copy of the code index. The issue's
#                                        lock is held while they go, as the
#                                        sweep holds it, so no cycle starts
#                                        meanwhile. .git, sources, what the
#                                        agents wrote there, memory and
#                                        sessions stay. It asks git of those
#                                        trees only to name the gitdir of a
#                                        worktree, and fails closed when git
#                                        cannot answer: the one call it makes in
#                                        a tree a cycle wrote, pinned and bounded
#                                        at the call (see the comment there and
#                                        the header of libexec/work). It walks
#                                        the tree with find -P and -xdev,
#                                        follows no symlink, and does not go into
#                                        .git. Nothing under $TEHAS_HOME/dev is
#                                        in this step: the build output of a
#                                        manual session, <name>.state/target, is
#                                        walked for no build-output name and is
#                                        a person's call (see tehas dev).
#                                        The log lines and what the age rule
#                                        reads are in the manual's page for this
#                                        command. When less than
#                                        TEHAS_CLEAN_MIN_FREE is free, this step
#                                        and the next take what they name
#                                        whatever its age: a disk that is short
#                                        is emptied before the dispatcher stops
#                                        starting cycles (TEHAS_CYCLE_MIN_FREE).
#                                        A figure that cannot be read changes
#                                        nothing. The lock rule stays, so a
#                                        workspace whose lock is held is never
#                                        touched at that age either.
#   2. Docker's build cache              `docker builder prune -f --filter
#                                        until=<N>h`. That is the build cache
#                                        of the whole host's Docker daemon:
#                                        tehas is one project on one host, so
#                                        the manual says so.
#   3. host scratch                      files under $TEHAS_HOME/tmp/dl and
#                                        $TEHAS_HOME/tmp/node-compile-cache,
#                                        and $TEHAS_HOME/tmp/tehas-test.*
#                                        directories, that old. Nothing
#                                        elsewhere under $TEHAS_HOME, and
#                                        nothing outside it: not $TEHAS_HOME/dev,
#                                        so no directory under a session's
#                                        <name>.state is walked.
#   4. old sandbox images                dated tags of the sandbox image whose
#                                        image is older than that, except the
#                                        newest dated tag and any tag a
#                                        container or a uid tag holds. What a
#                                        build keeps is its newest three date
#                                        tags (host/sandbox/build.sh); what is
#                                        older than TEHAS_CLEAN_AFTER hours is
#                                        this step's.
#   5. the old base images               every `sha-` tag of the repository the
#                                        base image names (the part before its
#                                        tag), of that age, made no container
#                                        and standing under no `release-` tag
#                                        the host still holds. Each goes with
#                                        a `docker rmi` of its own name. No
#                                        other repository is named, no tag of
#                                        any other shape is offered, and
#                                        nothing without a tag of its own is
#                                        given to docker: no `image prune`.
#
# Docker volumes are never touched, a person's call (see the host manual).
#
# One line per removal, and a closing line with the bytes freed, go to
# $TEHAS_HOME/logs/clean.log. A docker step that fails is logged as a warning
# and the other steps still run. `tehasbot clean` runs it by hand;
# tehas-clean.timer runs it every hour. The pause label does not stop it: it
# starts no work.
#
# Usage:
#   tehasbot clean              one run
#   tehasbot clean --dry-run    log what it would remove and remove nothing
#   tehasbot clean -h|--help    print this text and exit 0
#
# Exit: 0 the run finished with every step working; 1 a step failed, or the log
# could not be written (what could be removed was removed); 3 another run holds
# its lock, which changes nothing; 64 an argument this command does not know;
# 78 instance settings are missing or malformed, before any docker, find or rm
# call.
set -uo pipefail

show_usage() {
  sed -n '2,/^[^#]/p' "$0" | sed -n '/^#/s/^# \{0,1\}//p'
}

unknown() {
  printf 'tehasbot clean: unknown argument: %s\n' "$1" >&2
  show_usage >&2
  exit 64
}

dry=0
case "${1-}" in
  -h | --help)
    [ "$#" = 1 ] || unknown "${2-}"
    show_usage
    exit 0
    ;;
  --dry-run) dry=1 ;;
  "") ;;
  *) unknown "$1" ;;
esac
[ "$#" -le 1 ] || unknown "$2"

here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source=lib/config.sh
. "$here/../lib/config.sh"
# shellcheck source=lib/cycles.sh
. "$here/../lib/cycles.sh"
# images_held, the one answer to what a container or a uid tag holds, and
# tehas_base_image, the base of the sandbox build by the one name it is
# known by. The sandbox build asks both for the same question. rukas.sh answers
# which commit the host follows, which is the other half of that name.
# shellcheck source=lib/rukas.sh
. "$here/../lib/rukas.sh"
# shellcheck source=lib/sandbox.sh
. "$here/../lib/sandbox.sh"
# tehas_free_kb, the one reader of the host's free disk, which says when this
# run is the low-disk one.
# shellcheck source=lib/disk.sh
. "$here/../lib/disk.sh"
tehas_load || exit 78
tehas_require_instance_settings

# The two ages of this run. `after` is TEHAS_CLEAN_AFTER and is what steps 3, 4
# and 5 ask for: scratch and images are never taken sooner, whatever the disk.
# `build_after` is the age step 1 and the build cache go by: $after, or 0 when
# the host is short of space, which takes build output and Docker's build cache
# whatever their age. A figure that cannot be read is not a short disk: the run
# then goes by the age alone, since nothing here removes on a guess. The read is
# made after the log is open, so the line it logs on a short host is in the log
# beside every removal it explains.
after=$TEHAS_CLEAN_AFTER
build_after=$after
works=${TEHAS_WORK_DIR%/*}
base=${TEHAS_WORK_DIR##*/}
logs=$TEHAS_HOME/logs
logfile=$logs/clean.log
tmp=$TEHAS_HOME/tmp
# The sandbox image, the dated tags of which step 4 takes: tehas gives a cycle
# that name (lib/config.sh), and it is the name the build tags what it builds
# with, which is why the repository comes from tehas_sandbox_image_repo rather
# than from a cut of the setting here. The tag of the image cycles run is not a
# dated tag, and this step works from the date tags alone.
sandbox_image=$(tehas_sandbox_image_repo) ||
  { printf 'tehas clean: %s\n' "PI_ENSEMBLE_IMAGE=${PI_ENSEMBLE_IMAGE:-} is not an image name" >&2; exit 78; }
mkdir -p "$logs" "$TEHAS_HOME/state" ||
  { printf 'tehas clean: %s could not be made\n' "$TEHAS_HOME/state" >&2; exit 1; }

# One run at a time. A run that found another working leaves it to that one.
exec 9>>"$TEHAS_HOME/state/clean.lock"
if ! flock -n 9; then
  printf '%s clean: another run holds the lock, nothing was removed\n' "$(date -u +%FT%TZ)"
  exit 3
fi

freed=0
rc=0
warn() { printf '%s WARN: clean: %s\n' "$(date -u +%FT%TZ)" "$1" | tee -a "$logfile" >&2; }
log() {
  printf '%s clean: %s\n' "$(date -u +%FT%TZ)" "$1" >>"$logfile" 2>/dev/null ||
    { printf '%s clean: the log %s could not be written\n' "$(date -u +%FT%TZ)" "$logfile" >&2; rc=1; }
  printf '%s clean: %s\n' "$(date -u +%FT%TZ)" "$1"
}
# GiB to one decimal, as the dispatcher words the same reading: the figure the
# low-disk line below names.
gib_of_kb() { printf '%d.%d GiB' $(($1 / 1048576)) $(($1 % 1048576 * 10 / 1048576)); }

# The reading that decides the two ages, asked once for this run. The lock is
# taken, the log is there to write, and no removal has been tried.
if free_kb=$(tehas_free_kb "$TEHAS_HOME") &&
  [ "$free_kb" -lt $((TEHAS_CLEAN_MIN_FREE_MB * 1024)) ]; then
  build_after=0
  log "low on disk: $(gib_of_kb "$free_kb") free, under TEHAS_CLEAN_MIN_FREE=$TEHAS_CLEAN_MIN_FREE: build output and build cache go whatever their age"
fi

# What one removal gave back, in bytes, measured before it goes.
bytes_of() { # <path> -> the bytes it holds
  local b
  if [ -d "$1" ]; then
    b=$(du -sb -- "$1" 2>/dev/null | awk '{print $1}')
  else
    b=$(stat -c %s -- "$1" 2>/dev/null)
  fi
  [[ ${b:-} =~ ^[0-9]+$ ]] || b=0
  printf '%s\n' "$b"
}

# find's -name tests for these directory names, as words of an array: each name
# is the argument of one -name, and the `(` `)` and the `-o` are words of their
# own, so a name that reads as a find operator -- `(`, `-o`, a quote -- is still
# matched as the characters it is and never becomes a fragment of find's grammar.
# The caller reads them into an array and hands them to find_build_output.
find_name_words() { # <names...> -> find's test words, one per line
  local d first=1
  printf -- '(\n'
  for d in "$@"; do
    [ "$first" = 1 ] || printf -- '-o\n'
    first=0
    printf -- '-name\n%s\n' "$d"
  done
  printf -- ')\n'
}

# The build output of one tree: every directory under it that find names, one
# path per record on standard output, each record ended by NUL. The tree arrives
# as an argument rather than a line of a listing because a directory name can
# hold a newline, and then a newline-separated listing cannot tell one tree from
# two. Nothing is removed here, so the dry run and the run ask the same question
# the same way.
#
# Every dot-name is pruned, wherever it sits. A workspace holds a clone and whatever a container wrote beside it, and the
# trees that matter there -- the objects, the agent state, the memory -- are all
# dot-names; every name an instance can put in TEHAS_CLEAN_DIRS is un-dotted,
# so the rule gives up no build output. Pruning the whole class, rather than
# naming the two trees lib/config.sh refuses, is also what keeps the protection
# from drifting: a name close to one of them, in any spelling, is not removed
# either. No symlink is followed, so a link named target stays a link and what
# it points at is not touched.
#
# The prune of every dot-name is also why the worktrees of a cycle are asked
# from their own roots: a cycle makes them under a dot-name of the workspace,
# which this walk never enters. roots_of names the roots step 1 asks instead.
find_build_output() { # <tree as one argument> <name tests as words> -> paths, NUL-terminated
  local p=$1
  shift
  [ -d "$p" ] || return 0
  find -P -- "$p" -xdev \( -name '.*' -prune \) -o \
    \( -type d ! -type l \( "$@" \) -print0 \) 2>/dev/null
}

# The roots of one issue that step 1 walks, one NUL-terminated path per record:
# the workspace, what a retry moved aside, and each git worktree made inside
# either. A cycle makes its worktrees inside the workspace it was given, under a
# dot-name, where the walk above never goes, and each holds a checkout of its own
# with the build output of that checkout under it. A retry leaves both trees where
# they are
# until the 7-day sweep takes them, so an idle week keeps the build output of
# all of them unless they are named here.
#
# A worktree is known by what its own tree says: its .git is a file naming the
# gitdir of the tree, where a clone's .git is a directory. Those bytes are
# container-writable, so the test is a heuristic that chooses which trees git is
# asked about, and never the answer to whether one is a worktree: git answers
# that for each candidate that passes, and a tree git cannot name a gitdir of is
# no root and no removal.
#
# A directory on another device is refused too, which is what find's -xdev on the
# listing and this last test of the candidate's own device hold between them. An
# ordinary directory of the checkout is not a root either, since its .git is not
# a file: what it holds belongs to the product and is the walk of the workspace's
# own, which takes what it names. The reach is the two trees of the issue and the
# directories under them, so no path under $TEHAS_HOME/dev is named by this.
is_worktree() { # <dir> <device of the root that holds it> -> 0 when git may be asked of the dir
  local d=$1 dev=$2
  # A link stands outside the workspace and can hold anything on the host, so it
  # is never a root: the listing that found this candidate is a physical walk, and
  # this test is the same refusal on the candidate's own path.
  [ -d "$d" ] || return 1
  [ ! -L "$d" ] || return 1
  [ -f "$d/.git" ] || return 1
  grep -q '^gitdir:' "$d/.git" 2>/dev/null || return 1
  [ "$(stat -c %d -- "$d" 2>/dev/null)" = "$dev" ]
}

# The depth the listing below asks find for: directories at exactly
# `worktree_depth` levels under the root. The runner of this host puts a cycle's
# worktrees one directory below the workspace, so its worktree answers at 2. It is
# an assumption about the runner, not a fact of git: git makes a worktree at any
# depth, so a runner that nests them deeper leaves their build output where it
# stands, with the log still reporting the issue walked.
roots_of() { # <the issue's workspace> -> roots, one NUL-terminated path per record
  local p=$1 t w dev worktree_depth=2
  # The workspace and the tree a retry moved aside are roots wherever they stand,
  # and no candidate of the listing below can stand in for them: that listing
  # reaches only the depth a worktree of the runner sits at, and asks of each
  # candidate at that depth whether git may be asked about it. Both roots and
  # their candidates come out of the one loop, each name of them once.
  for t in "$p" "$p.before-retry"; do
    [ -d "$t" ] || continue
    printf '%s\0' "$t"
    # The candidates are listed physically: a link is never descended into, so one
    # link in a tree a container wrote cannot make the traversal as large as
    # whatever it points at on the host.
    dev=$(stat -c %d -- "$t" 2>/dev/null) || continue
    [[ ${dev:-} =~ ^[0-9]+$ ]] || continue
    while IFS= read -r -d '' w; do
      is_worktree "$w" "$dev" && printf '%s\0' "$w"
    done < <(find -P "$t" -xdev -mindepth "$worktree_depth" \
      -maxdepth "$worktree_depth" -type d -print0 2>/dev/null)
  done
}

# The gitdir of a tree whose .git file names one, asked of git. 2 when git itself
# gives no answer, 1 when it answers but not with a directory the cleaner may
# date, 0 and the path on standard output when it does. The two are told apart
# because they read differently to the operator: one is a worktree record that no
# longer matches the tree, the other is a git that answered something unusable.
#
# The bytes of that .git file are container-writable, so this is the one git call
# the cleaner makes in a tree a cycle wrote, and it is confined: the bound and
# git itself are taken by absolute path before the environment is cleared, so
# neither name is answered by a helper a cycle planted in a directory of the
# tehas user's PATH; no config of any kind is read but the one -c option, and no
# home's, since a config a container can reach can name a helper to run on the
# host; and the answer is kept only when it names an existing directory under the
# work dir, so a planted file naming a directory elsewhere buys nothing. The tree
# is not named to git as a trusted one: git's own rule against a tree of another
# owner turns a planted tree down, and this call reads one name, so the cleaner
# has no reason to widen that rule.
gitdir_of() { # <tree> -> 0 and its gitdir, 1 or 2 when git gives no dateable one
  local p=$1 _git _timeout rc=0 gitdir
  [ -f "$p/.git" ] || return 2
  unset -f git timeout 2>/dev/null
  _git=$(command -v git) || return 2
  _timeout=$(command -v timeout) || return 2
  [[ $_git == /?* && $_timeout == /?* ]] || return 2
  gitdir=$("$_timeout" -k 5 30 env -i PATH=/usr/bin:/bin HOME=/nonexistent \
    GIT_CONFIG_NOSYSTEM=1 GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_COUNT=0 \
    "$_git" -C "$p" -c core.fsmonitor=false \
    rev-parse --absolute-git-dir 2>/dev/null) || rc=$?
  [ "$rc" = 0 ] || return 2
  [[ ${gitdir:-} =~ ^/ ]] || return 1
  [[ $gitdir == "$works/"* ]] || return 1
  [ -d "$gitdir" ] || return 1
  printf '%s\n' "$gitdir"
}

# The age rule of an issue: nothing of these paths, nor of the issue's own
# lock, has been touched within TEHAS_CLEAN_AFTER hours. Returns 1 as soon as
# one of them is younger than that, and also when find could not read one: a
# tree the cleaner cannot date is a tree it does not touch. A path that is not
# there has been touched as little as one that is, so it is skipped. 2 answers
# for a worktree whose gitdir git could not name, which is not a young tree and
# is told apart from one by the caller: the record git keeps of a worktree is the
# only proof a cycle is at work in it, so a stale worktree record keeps the issue
# whole too, and says which of the two it was.
untouched_for_hours() { # <issue> <paths...>
  local n=$1 p young gitdir
  shift
  for p in "$@" "$TEHAS_HOME/state/cycles/$n.lock"; do
    [ -e "$p" ] || continue
    young=$(find "$p" -maxdepth 0 -newermt "-$build_after hours" 2>/dev/null) || return 1
    [ -n "$young" ] && return 1
    if [ -f "$p/.git" ]; then
      gitdir=$(gitdir_of "$p") || return $?
      young=$(find "$gitdir" -maxdepth 0 -newermt "-$build_after hours" 2>/dev/null) ||
        return 1
      [ -n "$young" ] && return 1
    fi
  done
  return 0
}

# The cycle's copy of the code index: a real directory of the issue's own state
# tree, and only then. The tree sits beside the workspace, named <n>.state, and
# is not walked for names: what its agents learned and Pi's sessions are not
# build output.
is_cache_dir() { # <the issue's .state directory>
  [ -d "$1" ] && [ ! -L "$1" ] && [ -d "$1/cache" ] && [ ! -L "$1/cache" ]
}

# The issue's lock, held for the instant of one removal, as sweep_workspaces
# holds it: no cycle can start in the workspace meanwhile. A lock a cycle holds
# is not taken, the removal does not happen, and the caller says so.
# tehas_cycle_lock_free is asked first, because flock on a lock that is not
# there makes one: it would hold a lock no cycle takes and remove under a proof
# that proves nothing. The step asks it once per issue, before any removal, and
# the code it answers tells the two refusals apart: 1 when the poll could not
# tell the lock was free or a cycle holds it, and 2 when no plain file is there
# to hold a lock at all.
remove_under_lock() { # <issue> <path> -> 0 taken, 1 or 2 a refusal of that kind
  local lock=$TEHAS_HOME/state/cycles/$1.lock
  tehas_cycle_lock_free "$1" || return 1
  [ -f "$lock" ] && [ ! -L "$lock" ] || return 2
  flock -n "$lock" rm -rf -- "$2" 8>&-
}

# --- 1. build output in kept workspaces --------------------------------------
# Each issue's workspace, the tree a retry moved aside, and the worktrees of a
# cycle under either, taken with the directories beside them for the age rule
# alone: the lock and the age belong to the issue, so they are asked together,
# as the sweep of libexec/dispatch asks them. What goes is build output by name,
# anywhere in those trees, and the cycle's copy of the code index. What stays is
# .git, the sources, what the agents wrote there, memory and sessions: for a
# person to read, until the 7-day sweep takes the workspace itself.
clean_workspaces() {
  local -a dirs=() name_words=()
  local p n kb age_rc state retry took met_output refused lock_refusal failed=0
  local -a root_list=()
  local -A seen=()
  [ -d "$works" ] || return 0
  read -r -a dirs <<<"$TEHAS_CLEAN_DIRS"
  [ "${#dirs[@]}" -gt 0 ] || return 0
  # The names as words of an array, so that no name ever reaches find as anything
  # but the argument of its own -name.
  mapfile -t name_words < <(find_name_words "${dirs[@]}")
  # Each issue once, in the order its names sort. One glob reaches both the
  # workspace and the tree a retry moved aside, since the suffix of the second is
  # part of what `*` matches; the regex is what decides which names are an
  # issue's. An issue kept only by the tree of a retry is met too, which is the
  # shape of a host this step was written for: the workspace of the cycle that
  # merged is gone and the retry's tree is all the issue has beside its state.
  # `seen` asks of an issue once, so the sort that puts a retry's tree between two
  # workspaces neither logs an issue twice nor walks a root twice.
  for p in "$works/$base"-*; do
    [[ ${p##*/} =~ ^"$base"-([1-9][0-9]{0,9})(\.before-retry)?$ ]] || continue
    n=${BASH_REMATCH[1]}
    [ -z "${seen[$n]+set}" ] || continue
    seen[$n]=1
    # The workspace of the issue is the root the others hang from, whichever of
    # the two names this listing reached: the sweep of libexec/dispatch keeps the
    # trees of an issue together, so naming one names the issue.
    p=$works/$base-$n
    state=$p.state
    retry=$p.before-retry
    # A lock a cycle holds means a cycle may be writing there now: left alone,
    # as the sweep leaves it. The lock is the only proof read, so a lock held by
    # anything else is left alone for the same reason and says so.
    if tehas_cycle_running "$n"; then
      log "kept the build output of #$n: its lock is held"
      continue
    fi
    # The tree of a retry belongs to the issue and is walked with the workspace,
    # so it is part of the age rule too: a run of an issue retried a minute ago
    # takes nothing of it, whatever the age of the workspace beside it. The same
    # for each worktree, which is what makes the age rule ask of roots_of and be
    # answered before any of them is walked: a tree made a minute ago is a write
    # in the workspace that holds it, and its build output is the youngest thing
    # in it, so an issue with a young worktree is left whole.
    #
    # The one listing is what the age rule is answered for and what the walk
    # removes: a root the run never dated is not a root it takes away. NUL is the
    # separator end to end, so a path with a newline in it is one root rather than
    # two, and an issue with no root at all is asked of nothing rather than of one
    # path that is not a root.
    mapfile -t -d '' root_list < <(roots_of "$p")
    # Three answers from the age rule, three lines: a tree that was written to
    # within the age, and a worktree git could not name a gitdir of, are both
    # reasons to leave the issue whole, but they are different things for the
    # reader of clean.log to go and look at -- one is a cycle at work and the
    # other is a worktree record that no longer matches the tree. An issue whose
    # workspace went while the rule was being answered is asked of no more.
    untouched_for_hours "$n" "$p" "$state" "$retry" "${root_list[@]}" || {
      age_rc=$?
      [ -e "$p" ] || continue
      case $age_rc in
        1) log "kept the build output of #$n: something of it is younger than $build_after hours" ;;
        2) log "kept the build output of #$n: git could not name the gitdir of one of its worktrees" ;;
        *) return 1 ;;
      esac
      continue
    }
    # The lock is asked for once, before anything is taken, and the answer decides
    # what this issue can be told. flock of a lock that is not there makes one, so
    # an issue with no lock file has its removals refused before any of them is
    # tried: taking them would write a lock no cycle holds and remove under a proof
    # that proves nothing. `took` records that a removal of this issue was taken;
    # `met_output` that build output of the issue was seen, whether it went or not;
    # `refused` that the walk of this issue met a removal it could not take. All
    # three belong to one issue, so all start again at the top of each turn: an
    # earlier issue that removed under its lock says nothing of this one.
    took=0
    met_output=0
    refused=0
    lock_refusal=0
    # Asked of the file, not of flock: taking the lock of a name that is not
    # there makes that name, which is the one thing this refusal must not do. The
    # three answers are the three the caller can report, so no walk is started on
    # a lock that will refuse every removal of it.
    if [ ! -e "$TEHAS_HOME/state/cycles/$n.lock" ]; then
      lock_refusal=1
    elif ! tehas_cycle_lock_free "$n"; then
      lock_refusal=2
    fi
    for root in "${root_list[@]}"; do
      [ -n "$root" ] || continue
      while IFS= read -r -d '' found; do
        [ -n "$found" ] || continue
        [ -d "$found" ] && [ ! -L "$found" ] || continue
        met_output=1
        # The dry run answers the same question the removal asks and prints what
        # it would take: one walk, so a preview can never name a path the run
        # then leaves, nor leave one it names.
        if [ "$dry" = 1 ]; then
          log "would remove $found: build output of #$n, untouched for $build_after hours"
          continue
        fi
        if [ "$lock_refusal" = 0 ]; then
          # The bytes are read first: a tree this step is about to name is a tree
          # whose size the log reports beside it, as every other removal does.
          kb=$(bytes_of "$found")
          if remove_under_lock "$n" "$found"; then
            took=1
            freed=$((freed + kb))
            log "removed $found: build output of #$n, $kb bytes"
          elif [ -e "$found" ]; then
            refused=1
            warn "could not remove $found"
            failed=1
          fi
        else
          refused=1
        fi
      done < <(find_build_output "$root" "${name_words[@]}")
    done
    if is_cache_dir "$state"; then
      met_output=1
      if [ "$dry" = 1 ]; then
        log "would remove $state/cache: the code index copy of #$n, untouched for $build_after hours"
      elif [ "$lock_refusal" != 0 ]; then
        refused=1
      else
        kb=$(bytes_of "$state/cache")
        if remove_under_lock "$n" "$state/cache"; then
          took=1
          freed=$((freed + kb))
          log "removed $state/cache: the code index copy of #$n, $kb bytes"
        elif [ -e "$state/cache" ]; then
          refused=1
          warn "could not remove $state/cache"
          failed=1
        fi
      fi
    fi
    # One line for an issue from which nothing went, chosen by what the run met:
    # the age rule passed, so the two reasons left are a lock that was not there
    # to hold the removals, and trees that hold no build output at all. A removal
    # refused by a lock that exists but could not be taken is told by its warning
    # above and says nothing more here, since a lock held by a cycle is what the
    # running check already answers for.
    [ "$took" = 1 ] && continue
    [ "$dry" = 0 ] || continue
    if [ "$met_output" = 1 ]; then
      # Only the lock that is not there is reported: a lock that exists and could
      # not be taken is a cycle that started after the running check, and is what
      # the warning above the line already says.
      [ "$refused" = 1 ] && [ "$lock_refusal" = 1 ] &&
        log "kept the build output of #$n: no lock to hold, so nothing of it was removed"
    elif [ "$refused" = 0 ]; then
      log "nothing to remove in #$n"
    fi
  done
  return "$failed"
}

# --- 2. Docker's build cache -------------------------------------------------
# The whole host's build cache, filtered only by its age: tehas is one project
# on one host, and the cache of anything else on it is made again too.
clean_build_cache() {
  local out rc2
  # Bounded well inside the unit's own limit, so a slow prune ends this step
  # and the scratch cleaning after it still runs.
  out=$(timeout -k 30 600 docker builder prune -f --filter "until=${build_after}h" 2>&1)
  rc2=$?
  if [ "$rc2" = 124 ]; then
    warn "docker builder prune did not finish in 600 seconds"
    return 1
  elif [ "$rc2" != 0 ]; then
    warn "docker builder prune failed ($rc2): $(head -n 1 <<<"${out:-docker gave no reason}")"
    return 1
  fi
  log "docker builder prune: $(head -n 1 <<<"${out:-docker gave no answer}")"
  return 0
}

# --- 3. host scratch ---------------------------------------------------------
# The downloads bootstrap.sh keeps, the compile cache node leaves behind, and
# the scratch directories a test run left when its process died. Only these,
# only files and directories directly under them, and nothing elsewhere in
# $TEHAS_HOME or outside it.
clean_scratch() {
  local dir f kb failed=0
  for dir in "$tmp/dl" "$tmp/node-compile-cache"; do
    [ -d "$dir" ] || continue
    while IFS= read -r -d '' f; do
      [ -f "$f" ] && [ ! -L "$f" ] || continue
      if [ "$dry" = 1 ]; then
        log "would remove $f: host scratch untouched for $after hours"
        continue
      fi
      kb=$(bytes_of "$f")
      if rm -f -- "$f" 2>/dev/null; then
        freed=$((freed + kb))
        log "removed $f: host scratch, $kb bytes"
      else
        warn "could not remove $f"
        failed=1
      fi
    done < <(find -P "$dir" -xdev -mindepth 1 -maxdepth 1 -type f \
      ! -newermt "-$after hours" -print0 2>/dev/null)
  done
  for dir in "$tmp"/tehas-test.*; do
    [ -d "$dir" ] && [ ! -L "$dir" ] || continue
    if [ "$dry" = 1 ]; then
      log "would remove $dir: a test's scratch directory of that age"
      continue
    fi
    kb=$(bytes_of "$dir")
    if rm -rf -- "$dir" 2>/dev/null; then
      freed=$((freed + kb))
      log "removed $dir: a test's scratch directory, $kb bytes"
    else
      warn "could not remove $dir"
      failed=1
    fi
  done
  return "$failed"
}

# --- 4. old sandbox images ---------------------------------------------------
# The dated tags of the sandbox image that have gone past the age, keeping the
# newest of them: the build's own sweep counts the newest three date tags and
# removes nothing younger than that, so what is older than TEHAS_CLEAN_AFTER
# hours and past the newest is the part no build ever takes. A tag is kept
# while a container -- running or stopped -- was made from its image, or a uid
# tag names it, which is the proof host/sandbox/build.sh uses for its own
# sweep, asked of images_held in lib/sandbox.sh. The age is the image's own
# creation time, so an image a later container pulled up again is not old. A
# docker that answers no image list, or nothing about what is held, removes
# nothing: an unknown is never a reason to take an image away from a container.
# The age rule of one image, asked of the time docker answers for it: 0 only
# when that time parses and lies before the age. Anything it cannot read -- no
# answer, a stamp of a shape this parse does not know, a date that will not
# compute -- is 1, which keeps the image: the cleaner takes what it dated, and
# says so in the reason it logs.
image_old_enough() { # <a time docker answers> -> 0 when it is a parseable one and past the age
  local t=$1 now age
  [ -n "$t" ] || return 1
  [[ $t =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\.[0-9]+)?(Z|[+-][0-9]{2}:?[0-9]{2})?$ ]] ||
    return 1
  now=$(date +%s) || return 1
  age=$(date -d "$t" +%s 2>/dev/null) || return 1
  [ "$age" -lt $((now - after * 3600)) ]
}

# What one docker removal gave back, in bytes. A docker that answers no size
# says nothing was freed, which is the truth of an image still there.
image_size() { # <image id> -> the bytes of that image
  local b
  b=$(docker image inspect --format '{{.Size}}' "$1" 2>/dev/null | head -n 1)
  [[ ${b:-} =~ ^[0-9]+$ ]] || b=0
  printf '%s\n' "$b"
}

clean_sandbox_images() {
  local tags held tag id n=0 kb out undated=0 failed=0
  tags=$(timeout -k 30 600 docker image ls --no-trunc --format '{{.Tag}} {{.ID}}' "$sandbox_image" 2>/dev/null) ||
    { warn "docker gave no list of its $sandbox_image tags"; return 1; }
  [ -n "$tags" ] || return 0
  held=$(images_held "$tags") || { warn "docker said nothing about the containers on the host"; return 1; }
  # Newest first, as the build's sweep sorts them: the first dated tag is the
  # one that stays whatever else of its age goes.
  while read -r tag id; do
    n=$((n + 1))
    if [ "$n" = 1 ]; then
      log "kept $sandbox_image:$tag: the newest dated tag"
      continue
    fi
    if ! image_old_enough "$(timeout -k 30 600 docker image inspect --format '{{.Created}}' "$id" 2>/dev/null | head -n 1)"; then
      undated=$((undated + 1))
      log "kept $sandbox_image:$tag: docker did not date its image past $after hours"
      continue
    fi
    if grep -qxF "$id" <<<"$held"; then
      log "kept $sandbox_image:$tag: a container or a uid tag uses it"
      continue
    fi
    [ "$dry" = 1 ] && { log "would remove $sandbox_image:$tag: a sandbox image of that age"; continue; }
    kb=$(image_size "$id")
    # docker's own reason goes with the warning: a container that took the
    # image between the listing and this call, and a daemon that answers no
    # removal at all, are not the same trouble to the reader of clean.log.
    if out=$(timeout -k 30 600 docker rmi "$sandbox_image:$tag" 2>&1); then
      freed=$((freed + kb))
      log "removed $sandbox_image:$tag: a sandbox image of that age, $kb bytes"
    else
      warn "could not remove $sandbox_image:$tag: $(head -n 1 <<<"${out:-docker gave no reason}")"
      failed=1
    fi
  done < <(grep -E '^[0-9]{6}-[0-9]{4}(-product)? ' <<<"$tags" | LC_ALL=C sort -r)
  # A run that dated nothing is not a run that found nothing old: say which of
  # the two the log is reporting.
  [ "$undated" = 0 ] || warn "docker gave no date past $after hours for $undated image(s), none of them removed"
  return "$failed"
}

# --- 5. the pulled base images -----------------------------------------------
# The images the sandbox build starts from: upstream's images for pi-rukas
# commits, each named <repository>:sha-<twelve characters of its commit>. The
# one the build pulls today is answered by tehas_base_image in lib/sandbox.sh,
# and its repository -- the name before the tag, or before the @ of a pinned
# digest -- is the whole reach of this step: every `sha-` tag of it, and nothing
# of any other repository.
#
# A base no pin names is the trouble here. Each release pins the sandbox to the
# commit it shipped with, so an update leaves the base of the release before it
# on the host under a `sha-` tag no pin names, of several gigabytes, and the
# step used to offer docker only the one name the pin answers. It lists the
# repository's tags now and removes each old one by name, keeping three proofs:
#
#   age       the image's own creation time, past TEHAS_CLEAN_AFTER, read as
#             step 4 reads its dated tags: a base a later build pulled up again
#             is not old, and one docker will not date stays;
#   container no container on the host, running or stopped, was made from it --
#             images_held, the same proof step 4 and the build's sweep ask;
#   kept tag  no tag of the sandbox image that something still keeps names it.
#             A kept tag is a dated tag or a `uid` tag a container holds, or a
#             `release-<version>` tag of the build's own name: libexec/update
#             tags the image a release ran with so that going back to the
#             release is a tag and not a build, and lib/update-release.sh
#             removes that tag only when it removes the release. The kept
#             releases are the `release-` lines of this step's own listing, so no
#             version is ever assumed and none is left out. Each of those lines
#             is read as an id of its own and matched as one line of the kept
#             set, so a host that holds two releases keeps the base of each of
#             them rather than that of neither. The sandbox image is listed once
#             beside the bases and asked of images_held with them, so the tags
#             step 4 leaves standing are never taken from under here. A base a
#             cycle built on stands under one of those, so a sandbox image
#             still in use keeps its base.
#
# Each removal is one `docker rmi` of one `<repository>:<tag>`: no pattern, and
# never `docker image prune`, which would offer every image on the daemon that
# has lost its tag and passed the age, whatever left it nameless -- a preview of
# `tehasbot preview` among them, and a rollback tag whose tag a later update
# moved. A docker that lists nothing removes nothing, as it did with the one
# name.
clean_base_image() {
  local pulled repo tags base_lines held_lines line name keep_ids out kb total failed=0
  pulled=$(tehas_base_image) || {
    warn "kept the base: the host's pins name no base to prune (PI_RUKAS_REPO, PI_RUKAS_FOLLOW or PI_RUKAS_IMAGE_DIGEST in $TEHAS_HOME/versions.env or the instance's instance.env, or lib/rukas.sh is not sourced beside lib/sandbox.sh)"
    return 0
  }
  # The repository of the base: everything up to the tag, or up to the @ of a
  # pinned digest, which leaves ghcr.io/<owner>/<repo> and no tag at all. It is
  # cut from the name the puller uses, so this step lists exactly what that one
  # name is a tag of, and no repository that is not the base's is ever named.
  repo=${pulled%%@*}
  repo=${repo%:*}
  # The bases and the sandbox image, one listing each, as `docker image ls`
  # takes at most one name: the `sha-` tags of the base's repository are what
  # this step may take, and the tags of the sandbox image are the proof of what
  # a container holds and what a kept release stands on. Each line says which
  # repository it belongs to; nothing of a repository the pins do not name is
  # ever read from them. A docker that could not list is not a docker that
  # listed nothing: the first is an unknown and the second is a fact, and only
  # the fact is logged as one. An operator reading the log when the cleaner
  # frees nothing must not be told no base was pulled when docker would not say.
  local held
  if ! tags=$(timeout -k 30 600 docker image ls --no-trunc --format '{{.Repository}} {{.Tag}} {{.ID}}' "$repo" 2>/dev/null); then
    warn "docker gave no list of its base tags of $repo"
    return 1
  fi
  if ! held=$(timeout -k 30 600 docker image ls --no-trunc --format '{{.Repository}} {{.Tag}} {{.ID}}' "$sandbox_image" 2>/dev/null); then
    warn "docker gave no list of the tags of $sandbox_image"
    return 1
  fi
  tags+=$'\n'"$held"
  # Only the lines of the repository this step may take, which is what a
  # listing asked for one name answers. A line of another repository is not
  # this step's to remove, and one that carries no tag docker can name is an
  # unknown rather than an argument: both are a warning and no removal.
  tags=$(awk -v r="$repo" -v s="$sandbox_image" '
    $1 == r { print "base", $2, $3 }
    $1 == s { print "held", $2, $3 }' <<<"$tags") || tags=""
  local base_lines held_lines
  base_lines=$(awk '$1 == "base" { print $2, $3 }' <<<"$tags")
  held_lines=$(awk '$1 == "held" { print $2, $3 }' <<<"$tags")
  if [ -z "${base_lines//$'\n'/}" ]; then
    log "kept the base: no image of $repo is on the host"
    return 0
  fi
  # What the sandbox image's tags stand on, out of the same listing. Two proofs
  # keep a base. `images_held` is the one step 4 and the build's sweep ask: the
  # image each container was made from, and the id of every uid tag, which is
  # the tag under which the host's own build runs. The other is a `release-`
  # tag: it names the image its release ran with, and only the pruning of that
  # release takes it (lib/update-release.sh), so a tag docker still answers for
  # keeps the base that image was built on. No other tag of the build's name is
  # a proof: a dated tag is step 4's to take, and the newest of those is kept
  # only for being the newest, so a base under it is not kept by it here.
  keep_ids=$(images_held "$held_lines") ||
    { warn "docker said nothing about the containers on the host"; return 1; }
  # The `release-` tags read out of that same listing, not out of a list of
  # names: the release a host keeps is whatever `tehas update` last ran, and
  # versions are not bounded, so an enumeration of names would be a ceiling the
  # day the platform reaches v0.10.0 or v1.0.0 -- a kept release whose name was
  # never asked would keep nothing, and the base it was built on would go. The
  # daemon already answered for every tag of the sandbox image, so its answer is
  # the set of kept releases, and a host that holds none is a listing with no
  # `release-` line in it. Their ids keep a base beside the ids images_held
  # answers, and one id to a line: both proofs are matched whole-line below, so
  # ids joined by a space read as one name that is no id at all and keep nothing.
  # Two releases on the host are two lines, and the base of each of them stays.
  # The accumulator starts empty and is appended with `+=`: under `set -u` a bare
  # `name+=` of a name never assigned dies here rather than starting the list.
  local rid kept_ids_nl=""
  while read -r _ rid; do
    [ -n "$rid" ] || continue
    # An id of a shape docker does not answer is not something this step can
    # name to `docker rmi`, so the whole step is an unknown and nothing goes on
    # a part of it. The bases are checked the same way below, before any removal.
    [[ $rid =~ ^(sha256:)?[0-9a-f]{64}$ ]] || {
      warn "docker named $rid as a release tag of $sandbox_image, which is not an id"
      return 1
    }
    kept_ids_nl+="$rid"$'\n'
  done < <(awk '$1 == "held" && $2 ~ /^release-/ { print $2, $3 }' <<<"$tags")
  [ -z "${keep_ids:-}" ] || kept_ids_nl+="$keep_ids"$'\n'
  kept=${kept_ids_nl%$'\n'}
  # The candidates: one line per `sha-` tag of the base's repository that is
  # old, made no container and stands under no kept tag, as
  # "<name> <id> <bytes>". The shapes are checked before anything is asked of
  # docker: an answer this step cannot name to `docker rmi` is an unknown
  # rather than an argument, and nothing is removed on a part of it. A tag of
  # any other shape -- a dated build, a uid tag, a release tag, a preview's, a
  # `latest` -- is not a base and is never named. The names come from the
  # repository of the pins and the tag docker answered, never from the line
  # itself, so a listing of another repository could not be handed back as one.
  local cands="" ltag lid
  while read -r ltag lid; do
    if ! [[ $lid =~ ^(sha256:)?[0-9a-f]{64}$ ]]; then
      warn "docker named $lid as an image of $repo, which is not an id"
      failed=1
      continue
    fi
    [[ $ltag =~ ^sha-[0-9a-f]{12}$ ]] || {
      log "kept $repo:$ltag: not a base tag of sha- and twelve characters"
      continue
    }
    # Both proofs are read before the age: a base something on the host still
    # stands on stays whatever docker says of its age, and is never asked for,
    # which is what lets a case with a held base name no date for it at all.
    # Whole-line, fixed-string, on both proofs: an id is a line of its own in
    # each of them, and a substring of one line is not an id docker answered.
    if [ -n "$keep_ids" ] && grep -qxF "$lid" <<<"$keep_ids"; then
      log "kept $repo:$ltag: a container was made from it"
      continue
    fi
    if [ -n "$kept" ] && grep -qxF "$lid" <<<"$kept"; then
      log "kept $repo:$ltag: a kept sandbox tag was built on it"
      continue
    fi
    if ! image_old_enough "$(timeout -k 30 600 docker image inspect --format '{{.Created}}' "$lid" 2>/dev/null | head -n 1)"; then
      log "kept $repo:$ltag: docker did not date its image past $after hours"
      continue
    fi
    kb=$(image_size "$lid")
    cands+="$repo:$ltag $lid $kb"$'\n'
  done <<<"$base_lines"
  [ "$failed" = 0 ] || return 1
  cands=${cands%$'\n'}
  [ -n "$cands" ] || return 0
  if [ "$dry" = 1 ]; then
    while read -r line; do
      [ -n "$line" ] && log "would remove ${line%% *}: a base image of that age"
    done <<<"$cands"
    return 0
  fi
  # Bounded, as the cache step is, so a slow removal ends this step and the run
  # still closes. The candidate line is "<name> <id> <bytes>", three fields and
  # no more: the name holds no space, so the fields split the other way round
  # and the whole of what this asks docker to take is what the name says.
  total=0
  while read -r name _ kb; do
    [ -n "$name" ] || continue
    [[ $kb =~ ^[0-9]+$ ]] || kb=0
    if out=$(timeout -k 30 600 docker rmi "$name" 2>&1); then
      total=$((total + kb))
      log "removed $name: a base image of that age, $kb bytes"
    else
      warn "could not remove $name: $(head -n 1 <<<"${out:-docker gave no reason}")"
      failed=1
    fi
  done <<<"$cands"
  freed=$((freed + total))
  return "$failed"
}

# Every step runs, whatever the ones before it did.
clean_workspaces || rc=1
clean_build_cache || rc=1
clean_scratch || rc=1
clean_sandbox_images || rc=1
clean_base_image || rc=1

log "freed $freed bytes"
exit "$rc"
