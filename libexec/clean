#!/usr/bin/env bash
# Remove what the host can make again. This loads the settings and reads the
# free disk; the steps, the two image names and the help text are the console's
# (console/src/clean.rs). What the command removes: tehasbot clean --help.
#
# Usage:
#   tehasbot clean              one run
#   tehasbot clean --dry-run    log what it would remove and remove nothing
#   tehasbot clean -h|--help    print the help text and exit 0
#
# Exit: 0 the run finished with every step working; 1 a step failed, or the log
# could not be written; 3 another run holds its lock; 64 an argument this
# command does not know; 78 instance settings are missing or malformed, or no
# console is installed, before any docker, find or rm call.
set -uo pipefail

here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
console=$here/console
[ -x "$console" ] || { printf 'tehas clean: no console beside this command at %s, run install.sh\n' "$console" >&2; exit 78; }

case "${1-}" in
  "") dry=0 ;;
  --dry-run) dry=1 ;;
  *) exec "$console" clean usage "$@" ;;
esac
[ "$#" -le 1 ] || exec "$console" clean usage "$@"

# shellcheck source=lib/config.sh
. "$here/../lib/config.sh"
# shellcheck source=lib/disk.sh
. "$here/../lib/disk.sh"
tehas_load || exit 78
tehas_require_instance_settings

sandbox_image=$("$console" clean image "$PI_ENSEMBLE_IMAGE") || exit 78
# A free figure that cannot be read changes nothing.
free_kb=$(tehas_free_kb "$TEHAS_HOME") || free_kb=""
exec "$console" clean run "$dry" "$TEHAS_HOME" "$TEHAS_WORK_DIR" "$TEHAS_CLEAN_AFTER" \
  "$TEHAS_CLEAN_MIN_FREE_MB" "$TEHAS_CLEAN_MIN_FREE" "$free_kb" "$TEHAS_CLEAN_DIRS" \
  "$sandbox_image" "$TEHAS_HOME/logs/clean.log" "${TEHAS_SCRATCH_DIR:-}"
