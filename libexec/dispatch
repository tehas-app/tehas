#!/usr/bin/env bash
# The tehas dispatcher: one poll of the GitHub issue queue.
#
# Deterministic, no model. It picks the open issues labelled tehas:ready that
# there is room for, marks each tehas:running and starts its cycle as
# tehas-cycle@<issue>.service. It does not wait for a cycle: tehasbot cycle
# runs it and reports the outcome. The poll also starts one turn of a planning
# session, when an answer is waiting, as tehas-plan-<issue>.service, and does
# not wait for it either: a later poll posts its outcome. One planning turn
# runs at a time. On a host where no cycle runs, the code index is refreshed
# before cycles start, as tehas-index.service, and the cycles start on the
# poll after it. A systemd timer runs a poll every two minutes, whatever the
# cycles are doing, and a cycle that ends starts one.
# Every poll that gets past the bot's login ends by running libexec/tidy,
# which takes tehas's state labels off closed issues, with --dry-run on a dry
# run.
#
# Usage:
#   tehas dispatch               one poll
#   tehas dispatch --dry-run     say what a poll would do, change nothing
#   tehas dispatch -h|--help     print this text and exit 0
#
# Exit: 0 the poll ran, or there was nothing to do; 64 an argument this command
# does not know, which starts no poll; 78 instance settings are missing or
# malformed, or the state store is not installed or cannot be used (before any
# call to GitHub when it is not installed); 1 a call to GitHub failed or its
# answer could not be read, the state store could not be read, systemd cannot
# load the cycle unit (before any label changes), or a cycle could not be
# started.
#
# Rules, in order:
#   1. Two pause switches stop all dispatch: the flag $TEHAS_HOME/state/pause.json,
#      which tehas pause writes on this host and which is read before this poll
#      asks GitHub anything, and the label tehas:pause on the control issue, which
#      works from away from the host. The label works one way: anyone who may
#      label applies it, only an account in TEHAS_ALLOWED_LABELERS lifts it. When
#      the label is gone but its last tehas:pause event is a removal by anyone
#      else, or names nobody, the poll starts nothing and says who removed it.
#      A flag that cannot be read counts as paused, and events that cannot be
#      read end the poll. The switches say what this poll may start, not what it
#      may clean up: rules 2 and 3 run while the factory is paused, so a cycle
#      whose work is done or that nobody has heard from is stopped and a mark
#      with no cycle behind it is cleared. The poll ends after that, before
#      rule 4.
#   2. At most TEHAS_TICKET_CONCURRENCY cycles run at once. With
#      TEHAS_REFRESH_CONFLICTS=1 and TEHAS_REFRESH_SLOTS above 0, refreshes run
#      in a lane of their own: at most TEHAS_REFRESH_SLOTS of them, not
#      counted against TEHAS_TICKET_CONCURRENCY, and new cycles leave as many
#      containers of the slice's room as the lane has free. A running cycle is
#      a refresh when the state store says it started as one.
#      An open issue marked tehas:running whose cycle holds no lock on this
#      host is handed to a human, once a fresh read shows it still marked.
#      Nothing is started for it. A closed one only loses the mark. A cycle
#      that holds its lock but has not been heard from for 20 minutes is
#      stuck: its unit is stopped, and said once; a stop that was asked is
#      asked again, spaced, until it needs a person. A running cycle whose work
#      is done is stopped, and its slot is free on the same poll: its issue
#      is closed, or the bot's pull request for it, opened since the cycle
#      began, is merged or closed. The workspaces kept for an issue no cycle
#      has run on for 7 days are removed, three issues a poll at most.
#   3. Running cycles and tehas PRs that wait for a human together do not
#      exceed TEHAS_MAX_AWAITING. And a cycle starts only while tehas.slice,
#      the systemd slice every sandbox container runs in, has room for one
#      more TEHAS_CYCLE_RESERVE, holds fewer containers than their ceilings
#      fit and is not under full memory pressure. Every container in the
#      slice counts at its floor or its use, whichever is more, and a cycle
#      that has no container yet at one reserve. A slice that is missing, has
#      no limit or cannot be read starts nothing. A poll that starts fewer
#      cycles than there are free slots and waiting issues names the one
#      reason: the awaiting-merge limit, the slice's room, its memory
#      pressure or no resources. With TEHAS_BRANCH_CHECK set, no cycle starts
#      while that check failed on the head commit of the branch work lands
#      on: every cycle would find the gate red on its base. One call to
#      GitHub a poll asks for it. A check that is pending, missing or cannot
#      be read holds nothing, and the log says so when that changes.
#      Running cycles go on, and planning turns are not held.
#   4. A box ticked by an allowed account in the bot's question comment is an
#      answer: on a parked cycle, "Retry from a clean start" starts a fresh
#      cycle. Rules 2 and 3 hold that back too. The tick counts only on a
#      parked issue that GitHub still says is open, and it is unticked when it
#      is used. A tick on an issue closed since its cycle stopped starts
#      nothing. A comment is a
#      question only if this host has its id on record on the state store:
#      the question of the issue's open planning session, or of its current
#      park (question-known). A record that could not be read skips the issue
#      for this poll: no tick counts and none is undone.
#   4a. A cycle that tehasbot cycle parked for a provider outage starts again
#      once, without a tick, when nothing holds cycles back, on the word of the
#      account that started the parked one (park-show --automatic). Any start
#      of the issue spends that one retry (park-retry), and so does a park that
#      can start nothing. A second such park waits.
#   4c. A fresh tehas:ready on an issue whose last cycle parked asks for nothing
#      while the issue still carries the body that cycle ran on: the body its
#      start's approval bound, as the store names it for the park. When the two
#      are equal, the park was no provider outage and no start has spent it,
#      the poll starts no cycle, leaves the park and the labels where they are,
#      and logs why. It says so on the issue once for that park (park-told);
#      later polls only log. A body that changed, a tick of "Retry from a clean
#      start", the retry rule 4a makes and a park of a run by hand all start as
#      they did.
#   4b. A refresh request, state/refresh/<issue>.json from tehasbot refresh,
#      starts a cycle that merges the branch into the bot's pull request of
#      that issue and pushes to the same branch, on the word of the person
#      whose approval the pull request's cycle rests on. Only with
#      TEHAS_REFRESH_CONFLICTS=1 and a sandbox image whose pi-rukas takes
#      --continue-pr; otherwise it starts nothing, said once. Read again at the
#      start: the issue is open, carries tehas:awaiting-merge or
#      needs-human-attention (a handoff, and then not tehas:ready) and none of
#      tehas:running, tehas:question, tehas:fixer-escalated, tehas:plan, and
#      no cycle or planning session is open on it; its text is the text that
#      person approved, renamed or edited by nobody else since; the pull
#      request is still the one open pull request that closes it, the bot's,
#      at the head the request names, and GitHub says it is CONFLICTING.
#      Fewer than TEHAS_REFRESH_MAX refreshes of it since that approval, and
#      none that parked. A request that fails a check goes, and the log says
#      why; one held by its cap or a park says so on the issue once. A pull
#      request that carries tehas:refreshing waits. The start puts
#      tehas:refreshing on the pull request before it writes the approval
#      record or marks the issue, so a start whose label change fails leaves
#      no refresh in the count; rule 2 takes it off a pull request whose issue
#      has no cycle, and one that the bot did not apply. Rules 1 and 2, the
#      limit and the slice's room hold a refresh; the cap of rule 3 does not:
#      its pull request is open already, and the start takes
#      tehas:awaiting-merge off. A refresh of a handed-off issue is a restart:
#      tehas cycle passes --restart, which takes needs-human-attention off,
#      and the refresh's own end labels the issue.
#   5. A reply or a ticked option on a planning question runs the next turn
#      of that session. The millwright's reply or tick counts only when no
#      person answered, in a session an allowed account's tehas:plan
#      started, fewer than TEHAS_MILLWRIGHT_MAX_PLAN_ANSWERS times in the session,
#      never for two turns in a row and never as the way out; its reply
#      starts with <!-- tehas:fixer issue=<n> action=answer -->. Otherwise
#      a tick is undone and a reply is said once on the issue. An issue
#      whose tehas:plan or tehas:refine label was applied by an
#      allowed account starts a session, a parked one included: as with
#      tehas:ready, tehas:question is no bar to asking for a session, and the
#      start takes it off. tehas:planning and tehas:running are, and so is a
#      turn running on record (plan-begin refuses it). Neither waits
#      for rule 2, the cap of
#      rule 3 or the slice's room: a planning turn opens no pull request. A
#      slice that cannot be used holds them too, before a label or a comment
#      is spent: a turn's container would not start.
#   5a. A cycle that parked as underspecified or too-large is refined once
#      without a label, on the word of the account that started it
#      (park-show --refine), unless a person has acted on the issue since.
#   6. An issue is eligible only if its tehas:ready label was applied by an
#      account in TEHAS_ALLOWED_LABELERS. It never names the bot: every poll
#      reads its own login and stops when it is listed. An issue with an open
#      planning session on record is not eligible until it is ended; while the
#      open sessions cannot be read, no issue is. It is eligible only
#      while GitHub says the number is an open issue: a closed issue and a pull
#      request start nothing, whatever label they carry. Nothing else the issue
#      carries holds it back: tehas's labels of an earlier outcome go with
#      the start. needs-human-attention stays: the cycle passes --restart,
#      and pi-rukas takes it off. Every start takes tehas:ready off, so a label that is there was
#      applied after the last start. An issue that an open pull request
#      closes, as GitHub links them, is work already done: the poll takes
#      tehas:ready off and says so once on the issue. With TEHAS_WORK_IMAGES=1
#      an issue whose text links an attachment waits while the model does not
#      read images; the rest start. An issue whose text says a file goes there
#      ("SCREENSHOT GOES HERE", "IMAGE_GOES_HERE") while its text and its
#      approved record link no attachment at all waits for its owner on every
#      instance, with the setting off included: the cycle would be given no
#      file and no word of the gap. The hold is a line of the dispatch log;
#      nothing on the issue changes and no label is touched. While the
#      issue's own cycle is alive it waits, and starts when that cycle ended.
#      A tehas:ready from an account outside the list authorises nothing, so
#      the poll takes it off and says so once on the issue: left in place it
#      reads as a request for a cycle to everyone who reads the issue. A
#      tehas:plan from such an account is taken off the same way. The control
#      issue that carries tehas:pause is never work: whoever applies
#      tehas:ready or tehas:plan to the number TEHAS_CONTROL_ISSUE names, or
#      ticks a retry box on it, starts nothing, and the label stays where it
#      is. The poll says so once, as it says a label of an account that is not
#      allowed. The one exception is TEHAS_MILLWRIGHT_LOGIN, which is never the bot:
#      its tehas:ready starts a cycle on an issue an allowed account approved
#      before, whose body is still the body that account approved, at most
#      TEHAS_MILLWRIGHT_MAX_RETRIES times since (lib/millwright.sh). Otherwise the poll
#      takes its label off and says why. A start takes tehas:fixer-escalated
#      off, whoever made it.
#      An issue that carries tehas:blocked waits while any issue it names is
#      open. The names are in the newest comment with the marker
#      <!-- tehas:blocked by=12,34 --> by an allowed account or the fixer, one
#      nobody else edited. A label with no such comment, a malformed marker or
#      a state GitHub does not give holds it too, and the log says why.
#      Alone, on an issue in no other flow, it approves as tehas:ready does.
#      With TEHAS_SIZE_MAX_FILES set, the body the label approved is measured
#      (lib/sizing.sh), and an issue whose body names more files than the
#      setting is not started either: its tehas:ready comes off,
#      needs-human-attention goes on, and the issue says the counts, the
#      setting and the way out once. Unset, nothing here changes, and a refresh
#      is never held by it.
#   7. tehas:urgent first, then refreshes, then tehas:next, then the lowest
#      issue number. An issue the poll puts on neither the urgent list nor the
#      tehas:next list is of the lowest kind, so one whose tehas:next came from
#      an account it does not count is of that kind too. The
#      urgent label counts only when its most recent labelling is by an allowed
#      account, as tehas:ready does: one applied by the bot or anyone else is
#      ignored and logged, and the issue keeps its place by number. tehas:next,
#      and tehas:blocked in rule 6, count when their latest event applies them
#      and is by an allowed account or the fixer. A running cycle is never
#      stopped to make room. With TEHAS_LOW_GATE set, the poll runs that command
#      at most once, and only when an issue of the lowest kind would otherwise
#      start: it reads the exit status alone, and only
#      0 lets those issues start. A missing file, one that is not executable, a
#      run that outlives TEHAS_LOW_GATE_WAIT and any other status all hold them,
#      and the poll still ends 0. The run gets TEHAS_LOW_GATE_WAIT seconds, at
#      most 600 because the poll holds state/dispatch.lock while it waits, and
#      ten more to end after being asked to; one that ignores that is killed. It
#      is asked with nothing of the poll's environment but PATH, no input, and
#      with whatever it prints kept in logs/low-gate.log for the person, who is
#      the only reader of why a gate closed: it is not a sandbox, it runs as the
#      tehas user, and what keeps it small is that lib/config.sh refuses a
#      command under the trees a merged pull request writes. Once the answer is
#      known, every later issue of the lowest kind is held by that answer alone,
#      with its own line and no call to GitHub about it. The hold is marked by
#      state/low-gate.held, which carries nothing but its existence and names no
#      command, and its beginning and its end are said once each, however the
#      command's status changes while the hold lasts; a hold already on record
#      is said by each issue's line, not again as a beginning. Urgent issues,
#      tehas:next issues, refreshes and a poll with no issue of the lowest kind
#      ask nothing. Unset, nothing here changes.
#
# Instance settings (lib/config.sh; defaults in brackets):
#   TEHAS_REPO                owner/name of the product repository, required
#   TEHAS_CONTROL_ISSUE       issue that carries tehas:pause, required
#   TEHAS_ALLOWED_LABELERS    space-separated logins, required
#   TEHAS_MAX_AWAITING        open tehas:awaiting-merge issues plus running
#                             cycles allowed [TEHAS_TICKET_CONCURRENCY + 2]
#   TEHAS_TICKET_CONCURRENCY  the most cycles side by side [the host's CPUs
#                             minus one]
#   TEHAS_CYCLE_RESERVE       memory one container is promised, the unit the
#                             slice's room is counted in [2g]
#   TEHAS_WORK_REPO           checkout cycles are cloned from [$TEHAS_HOME/repos/<name>]
#   TEHAS_BRANCH              branch work lands on [the checkout's origin/HEAD]
#   TEHAS_PLAN_MAX_TURNS      turns a planning session may take [20]
#   TEHAS_PLAN_TIMEOUT        seconds before a turn is given up [7200]
#   TEHAS_WORK_COMMENTS       1 adds the links of comments to the approval
#                             record [0]
#   TEHAS_MILLWRIGHT_LOGIN         the millwright's account, none when unset
#   TEHAS_MILLWRIGHT_MAX_RETRIES   the millwright's starts on one issue since a person's
#                             approval [2]
#   TEHAS_MILLWRIGHT_MAX_PLAN_ANSWERS
#                             the millwright's answers in one planning session [3]
#   TEHAS_REFRESH_CONFLICTS   1 lets refresh requests start cycles [0]
#   TEHAS_BRANCH_CHECK        the check whose failure on the branch's head
#                             commit holds new cycles back, none when unset
#   TEHAS_REFRESH_MAX         refreshes of one pull request since the
#                             person's approval [2]
#   TEHAS_REFRESH_SLOTS       refreshes side by side in their own lane, 0 to
#                             share the cycles' slots [1]
#   TEHAS_SIZE_MAX_FILES      the most files an issue's body may name before
#                             the poll holds it back, none when unset
#   TEHAS_LOW_GATE            a command the poll asks before it starts the
#                             issues of the lowest kind, an absolute path, none
#                             when unset
#   TEHAS_LOW_GATE_WAIT       seconds that command gets before its answer is a
#                             closed gate, 1 to 600 [60]
# From the environment, for tests: TEHAS_STATUS_CMD, TEHAS_INDEX_CMD,
# TEHAS_TIDY_CMD (in place of libexec/tidy),
# TEHAS_PLAN_CMD, TEHAS_PLAN_START_CMD (in place of systemd-run, called with
# the issue and the turn's command line), TEHAS_INDEX_START_CMD (in place of
# systemd-run, called with the index run's command line), TEHAS_CYCLE_START_CMD and
# TEHAS_CYCLE_STOP_CMD (in place of systemctl, called with the issue), TEHAS_CYCLE_START_WAIT (seconds to wait for a started cycle
# [30]), TEHAS_CYCLE_DONE_WAIT (seconds the stop of a finished cycle may take
# [330]), TEHAS_CGROUP_ROOT (in place of /sys/fs/cgroup), TEHAS_FETCH_WAIT
# (seconds the fetch of the checkout may take [120]) and TEHAS_CHECK_WAIT
# (seconds the read of TEHAS_BRANCH_CHECK may take [30]).
#
# Before a start changes any label, the poll records what it rests on in the
# state store (lib/store.sh, approval-record): who approved and when, by the
# label or a retry tick, how, a sha256 of the body that approval was checked
# against (carriage returns dropped), a sha256 of the issue's title held the
# same way, and as the start's inputs the links to GitHub's attachment storage
# in that body. An answer that names no title records no title sha256, and
# tehas work then checks the body alone. The time is when the approval was
# given, as GitHub says, except for a refresh and the retry after an outage,
# which are on record at the time the poll decided them. An issue has one
# approval waiting at most, and an approval starts one cycle: the cycle's own
# start uses it (cycle-start), and a second poll that finds the same approval
# used starts nothing. tehas work and the cycle read it back in the shape
# below (tehas_approval_view). With TEHAS_WORK_COMMENTS=1
# it adds comment_links, [{link, source, by}]: the links in the issue's comments
# that an allowed account wrote and nobody edited after the approval, source
# "comment:<id>". On a retry tick it adds the links of the comments allowed
# accounts wrote on the parked cycle's pull request between the park and the
# tick, source "pr-comment:<id>", and their text as retry_context, [{source,
# by, at, text}]. tehas work fetches those links and no others, and only while
# the body still has that hash. A start of the fixer's has how "fixer", the
# person's approval it rests on as rests_on {at, by, how, body_sha256}, the
# fixer's starts since that approval as fixer_starts, and, whatever
# TEHAS_WORK_COMMENTS says, the fixer's marked comment on the issue written in
# the ten minutes before its label as retry_context, source "fixer:<id>". A
# refresh has how "refresh", by and at of the person's approval it rests on,
# that approval as rests_on, the refreshes since it as refreshes, what it
# refreshes as refresh_of {pr, head_sha, base_sha, branch}, the fixer's starts
# carried on as fixer_starts, and one fixed retry_context entry, source
# "refresh", the task tehas sets it: no comment text. An approval that cannot
# be recorded, or comments that cannot be read, start nothing, exit 1. A start
# that gives up after the record takes the approval off it again.
#
# Before the label the poll reads the attempt on record for the issue; then it
# starts the unit and waits up to TEHAS_CYCLE_START_WAIT seconds, by the clock,
# for a later attempt: the cycle starts its record once it holds its lock. A
# store that is busy is asked again within the wait. With no new attempt by
# then, a cycle that holds the issue's lock is taken as started, and anything
# else is a start that did not happen.
#
# A real poll that gets as far as rule 3 writes $TEHAS_HOME/live/dispatch.json:
# what holds cycles back, if anything, and the slice's numbers. Once the model
# endpoint has been settled it also names the subagent provider's endpoint, as
# "endpoint": "main" or "backup": the one word the energy sampler asks for,
# never an address, because live/ is public. tehasbot
# health copies it for tehas status. A hold is logged once, when its reason
# changes, and "released" once when it ends; a dry run prints it every time.
# Every real poll that gets past the bot's login, a paused one too, writes
# $TEHAS_HOME/live/demand.json, how many issues wait for room (report_demand),
# and refreshes the health file with it.
#
# The factory's analytics, state/analytics.db, unless TEHAS_ANALYTICS=off: a
# start records the events ready, at the approval record's time, and started
# of its issue, and every real poll that holds the lock, a paused, held or
# failed one too, ends with
# `analytics sample` (the counts of live/status.json, the hold and the cycles
# allowed of live/dispatch.json, the draw of live/energy.json) and `analytics
# prune`. Each call has a time limit, and one that fails or runs out of time is
# a WARN line: it changes nothing in the poll (lib/analytics.sh). A planning
# turn that ended is recorded with `analytics plan` as its end is posted
# (lib/planning.sh).
set -uo pipefail

# The usage is this file's own header comment: every line from the second to the
# first one that is not a comment, with the leading "# " removed. So the text
# cannot drift from the code; unlike a fixed line range it needs no number kept
# in step with the header.
show_usage() {
  sed -n '2,/^[^#]/p' "$0" | sed -n '/^#/s/^# \{0,1\}//p'
}

unknown_argument() {
  printf 'tehas dispatch: unknown argument: %s\n' "$1" >&2
  show_usage >&2
  exit 64
}

# Arguments are read before the instance settings, so --help answers on a host
# with no instance yet, and an argument this command does not know reaches
# neither gh nor $TEHAS_HOME. Before this check a poll ignored anything it did
# not recognise: a typo such as --dryrun ran a real poll and could start a cycle.
mode=poll
if [ "$#" -gt 0 ]; then
  case "$1" in
    -h | --help) mode=help ;;
    --dry-run) mode=dry ;;
    # An empty argument is an argument too: it is not a poll.
    *) unknown_argument "$1" ;;
  esac
fi
# At most one argument. A second is refused, never combined with the first, so
# --dry-run --help cannot be read as two intents at once.
if [ "$#" -gt 1 ]; then
  unknown_argument "$2"
fi
if [ "$mode" = help ]; then
  show_usage
  exit 0
fi
dry=0
[ "$mode" = dry ] && dry=1

here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source=lib/config.sh
. "$here/../lib/config.sh"
# shellcheck source=lib/cycles.sh
. "$here/../lib/cycles.sh"
# shellcheck source=lib/slice.sh
. "$here/../lib/slice.sh"
# shellcheck source=lib/disk.sh
. "$here/../lib/disk.sh"
# shellcheck source=lib/labels.sh
. "$here/../lib/labels.sh"
# shellcheck source=lib/millwright.sh
. "$here/../lib/millwright.sh"
# shellcheck source=lib/status.sh
. "$here/../lib/status.sh"
# shellcheck source=lib/limit.sh
. "$here/../lib/limit.sh"
# shellcheck source=lib/attachments.sh
. "$here/../lib/attachments.sh"
# shellcheck source=lib/models.sh
. "$here/../lib/models.sh"
# shellcheck source=lib/headless.sh
. "$here/../lib/headless.sh"
# shellcheck source=lib/refresh.sh
. "$here/../lib/refresh.sh"
# shellcheck source=lib/analytics.sh
. "$here/../lib/analytics.sh"
# shellcheck source=lib/store.sh
. "$here/../lib/store.sh"
# shellcheck source=lib/live.sh
. "$here/../lib/live.sh"
tehas_load || exit 78
# Sourced after tehas_load, as lib/questions.sh is below: the measure builds
# the tick of markdown into a jq program with a `file` of its own, and a
# command that sources a file before tehas_load would lose its own to it.
# shellcheck source=lib/sizing.sh
. "$here/../lib/sizing.sh"
# shellcheck source=lib/questions.sh
. "$here/../lib/questions.sh"

log() { printf '%s %s\n' "$(date -u +%FT%TZ)" "$*"; }

tehas_require_instance_settings
[ ! -f "$(tehas_models_file)" ] || tehas_model_keys_ok || exit 78
repo=$TEHAS_REPO
control=$TEHAS_CONTROL_ISSUE
max_awaiting=$TEHAS_MAX_AWAITING
checkout=$TEHAS_WORK_REPO
status_cmd=${TEHAS_STATUS_CMD:-$here/status}
index_cmd=${TEHAS_INDEX_CMD:-$here/index}
plan_cmd=${TEHAS_PLAN_CMD:-$here/plan}
start_wait=${TEHAS_CYCLE_START_WAIT:-30}
# Known before anything is touched: a cycle must never start from a guess,
# nor in a checkout of another repository.
tehas_checkout || exit 78
branch=$(tehas_branch) || exit 78

mkdir -p "$TEHAS_HOME/state/cycles" "$TEHAS_HOME/logs" "$TEHAS_HOME/live"
# Held for the poll only. A cycle holds the lock of its own issue. Opened
# without truncating it: a poll that finds it held changes nothing.
exec 8>>"$TEHAS_HOME/state/dispatch.lock"
# A cycle that ended asked for a poll, and this is it. Removed before the lock
# is tried, so tehas-dispatch.path does not start poll after poll while tehas
# a poll holds the lock: the timer polls once it is done.
[ "$dry" = 1 ] || rm -f "$TEHAS_HOME/state/dispatch.again"
# When the lock was last taken, and the take a hang was last said for.
taken=$TEHAS_HOME/state/dispatch.taken
stuck=$TEHAS_HOME/state/dispatch.stuck
if ! flock -n 8; then
  [ "$dry" = 0 ] || log "another poll holds the dispatcher's lock"
  # Every later poll stops here while one hangs, so the hang is said, once
  # for each take of the lock. A poll runs no planning turn and no index: it
  # calls GitHub, fetches, and waits for the cycles it starts.
  # Read without a pipe: under pipefail the first head can die of SIGPIPE when
  # the second has its line, and the hang would go unsaid.
  at=$(head -c 16 "$taken" 2>/dev/null) || at=""
  at=${at%%$'\n'*}
  bound=1800
  if [[ $at =~ ^[0-9]{1,12}$ ]] && [ $((EPOCHSECONDS - at)) -gt "$bound" ] &&
    { [ "$dry" = 1 ] || [ "$(head -c 16 "$stuck" 2>/dev/null)" != "$at" ]; }; then
    log "WARN: the dispatcher's lock has been held since $(date -u -d "@$at" +%FT%TZ), more than ${bound}s: a poll hangs, and no poll runs until it ends"
    [ "$dry" = 1 ] || echo "$at" >"$stuck" || log "WARN: could not write $stuck"
  fi
  exit 0
fi
date +%s >"$taken" || log "WARN: could not write $taken"
# The records a poll reads and writes are in the state store. Without it no
# label is read, and none changes.
if ! tehas_store_ready; then
  log "ERROR: the state store is not installed (run install.sh)"
  exit 78
fi
# The record files of an older tehas. install.sh imports them; one still here
# is an import that stopped, or a cycle that ran the old code across the
# update. The store has no row for it, and no row is not "none" (D2). The
# carriers, the .new of a killed writer and state/dispatch.taken never match.
old_records=('state/cycles/[1-9]*.'{approved.json,park,by,requeued,taken,rukas,quiet,image,settings,branch,history.jsonl}
  'state/park-[1-9]*.'{id,json} 'state/plan-[1-9]*.json' 'state/plan-[1-9]*.json.'{brief,answer,turn,keep}
  'state/cycles/plan-[1-9]*.history.jsonl' 'state/plan-[1-9]*.history.jsonl')
for old in "${old_records[@]}"; do
  if old=$(cd "$TEHAS_HOME" && compgen -G "$old"); then
    log "ERROR: records of an older tehas at $TEHAS_HOME/${old%%$'\n'*}; run install.sh again"
    exit 78
  fi
done

# Every real poll that holds the lock ends with one sample of the factory and
# a prune in its analytics, after its live files are written, however it
# ends: a paused, held or failed poll too. A poll that got past the bot's
# login runs libexec/tidy before them. The poll's exit status stays its own.
tidy_on=0
trap 'if [ "$tidy_on" = 1 ]; then
    if [ "$dry" = 1 ]; then "${TEHAS_TIDY_CMD:-$here/tidy}" --dry-run; else "${TEHAS_TIDY_CMD:-$here/tidy}"; fi
  fi
  [ "$dry" = 1 ] || { tehas_analytics sample; tehas_analytics prune; }' EXIT

# gh_json <gh arguments>: the answer in $json. A failed call ends the poll:
# no rule below may be decided on an answer that never came. Always call it as
# a plain command, never in a pipe or $( ), where its exit would be lost.
json=""
gh_json() { json=$(gh "$@" 2>/dev/null) || { log "ERROR: gh $1 $2 failed"; exit 1; }; }

# say <issue> <text>: comment on an issue. A failure is a warning in the log,
# not the end of the poll.
say() { gh issue comment "$1" --repo "$repo" --body "$2" >/dev/null 2>&1 || log "WARN: comment on #$1 failed"; }

# post_question <kind> <issue> <turn> <result.json> [line under the agent's
# words]: post a question comment. The line, when it is given, is the host's
# own and goes after the question and before the boxes. Its id is left in
# $posted. Returns 1 when it could not be posted.
posted=""
post_question() {
  local body
  body=$(q_render "$1" "$2" "$3" "$4" "${5:-}") || return 1
  posted=$(gh api "repos/$repo/issues/$2/comments" -f body="$body" --jq .id 2>/dev/null) || return 1
  [ -n "$posted" ]
}
# untick <issue> <answer> [note]: empty every box of a question comment. With
# a note, say it on the issue, but only once the untick has worked: if the box
# stays ticked the next poll sees the same tick, and the note would be posted
# every poll. Returns 1 when the comment could not be changed.
untick() {
  gh api -X PATCH "repos/$repo/issues/comments/$(jq -r .comment <<<"$2")" \
    -f body="$(jq -r .body <<<"$2" | q_untick)" >/dev/null 2>&1 || return 1
  [ -z "${3:-}" ] || say "$1" "$3"
}

# shellcheck source=lib/planning.sh
. "$here/../lib/planning.sh"

# Do not burn an issue on a model endpoint that cannot answer: every agent
# would fail and the issue would park. Leave it queued and look again next
# poll. mesh_check asks each provider's endpoint once, at rule 3, about every
# model the agents use on it (tehas_models: the subagent default and each
# role's own). A provider with a backupBaseUrl whose main endpoint fails is
# asked at its backup, and the cycle that starts goes there (lib/models.sh).
# Only when both fail is the first reason left in $mesh_hold. A provider with
# no baseUrl is not asked. $mesh_url and $mesh_key are the subagent
# provider's endpoint and token; $mesh_end is which of them it is, main or
# backup, the one word report_hold publishes. The text names no address: tehas
# status and the health file carry it, and they are served to whoever can read
# the dashboard.
mesh_hold=""
mesh_url=""
mesh_key=""
mesh_end=""
mesh_check() {
  local p url backup why why2
  local -a models
  mesh_hold=""
  mesh_url=""
  mesh_key=""
  # The word is set only when an endpoint is asked and answers. A poll that
  # asks nothing, or gets no answer, writes no word: the sampler then asks both
  # endpoints as it did before this field existed.
  mesh_end=""
  [ -n "$(tehas_endpoint_url "$PI_ENSEMBLE_SUBAGENT_PROVIDER" main)" ] && [ -n "$PI_ENSEMBLE_SUBAGENT_MODEL" ] || return 0
  while read -r p; do
    url=$(tehas_endpoint_url "$p" main)
    [ -n "$url" ] || continue
    mapfile -t models < <(tehas_models | awk -v p="$p" '$1 == p { print $2 }')
    if why=$(tehas_endpoint_ask "$url" "$(tehas_endpoint_key "$p" main)" "${models[@]}"); then
      [ "$p" != "$PI_ENSEMBLE_SUBAGENT_PROVIDER" ] ||
        { mesh_url=$url; mesh_key=$(tehas_endpoint_key "$p" main); mesh_end=main; }
      continue
    fi
    backup=$(tehas_endpoint_url "$p" backup)
    if [ -n "$backup" ]; then
      if why2=$(tehas_endpoint_ask "$backup" "$(tehas_endpoint_key "$p" backup)" "${models[@]}"); then
        log "model endpoint: provider $p is on its backup, the main endpoint $why"
        [ "$p" != "$PI_ENSEMBLE_SUBAGENT_PROVIDER" ] ||
          { mesh_url=$backup; mesh_key=$(tehas_endpoint_key "$p" backup); mesh_end=backup; }
        continue
      fi
      mesh_hold="holding: no resources: the model endpoint $why, and its backup $why2"
    else
      mesh_hold="holding: no resources: the model endpoint $why"
    fi
    return 0
  done < <(tehas_models | awk '!seen[$1]++ { print $1 }')
}

# Where the instance gives a cycle images (TEHAS_WORK_IMAGES), a cycle whose
# issue links one needs two readers: the pi-rukas in the sandbox image, which
# hands over the manifest tehas writes beside them, and a model that declares
# image input in models.json and answers a request that carries one. The
# image is asked first: its label answers without the network, and an image
# that says nothing is not held for it. image_ok <issue> asks only for such an
# issue, and only when it would otherwise start: an issue without images, and
# a planning turn, are never held by it, and a poll that can start nothing
# sends no picture to a backend that cycles are queueing on. The model is
# asked once a poll at most; the answer stands for the rest of it. Every
# attachment link counts, whatever its type: tehas work decides what it
# fetches, and a link it would take must not start a cycle on a model that
# cannot read it. Needs the issue's answer from work_ok. Returns 1, with the
# reason logged, when the issue waits.
image_asked=0
image_hold=""
# A png of one pixel.
mesh_pixel=iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mP8z8BQDwAEhQGAhKmMIQAAAABJRU5ErkJggg==
image_ok() {
  local n=$1 linked model=$PI_ENSEMBLE_SUBAGENT_MODEL commit
  [ "$TEHAS_WORK_IMAGES" = 1 ] || return 0
  linked=$(jq -r "$(tehas_attachment_links)"' (.body // "") | links | length > 0' <<<"${work_answer[$n]:-}" 2>/dev/null) || linked=""
  case "$linked" in
    false) return 0 ;;
    true) ;;
    *) log "ERROR: the text of #$n could not be read for its links"; exit 1 ;;
  esac
  if [ "$image_asked" = 0 ]; then
    image_asked=1
    if [ "$(tehas_rukas_reads_images)" = 0 ]; then
      commit=$(tehas_rukas_commit)
      image_hold="the pi-rukas in the sandbox image${commit:+ ${commit:0:12}} does not read them"
    elif [ -z "$mesh_url" ]; then
      :
    elif ! jq -e --arg p "$PI_ENSEMBLE_SUBAGENT_PROVIDER" --arg m "$model" \
      '.providers[$p].models // [] | any(.id == $m and ((.input // []) | index("image") != null))' \
      "$HOME/.pi/agent/models.json" >/dev/null 2>&1; then
      image_hold="$model does not declare image input in models.json"
    elif ! jq -n -c --arg m "$model" --arg px "$mesh_pixel" '{model: $m, max_tokens: 1, messages: [{role: "user", content: [
        {type: "text", text: "."}, {type: "image_url", image_url: {url: "data:image/png;base64,\($px)"}}]}]}' |
      curl -fsS -K <(_tehas_endpoint_auth "$mesh_key") -m 30 -H 'Content-Type: application/json' -d @- "$mesh_url/chat/completions" >/dev/null 2>&1; then
      image_hold="$model does not answer an image"
    fi
  fi
  [ -n "$image_hold" ] || return 0
  log "hold #$n: its text links an attachment and TEHAS_WORK_IMAGES is 1, but $image_hold"
  return 1
}

# image_missing_ok <issue>: does the issue hold back no attachment it promises?
# A body written around a picture ("SCREENSHOT GOES HERE") that links no
# attachment at all is a handover that stopped short: what is left of it is the
# owner's step, attach it, and a cycle cannot say so from what it is given --
# the manifest holds no entry for a file nobody linked, so the cycle spends its
# explore on a premise it cannot check and parks. The rule asks nothing of
# GitHub and nothing of the instance's settings: the text is the one work_ok
# already read, and a promised file holds whether or not this instance gives a
# cycle images. It is asked where a cycle would otherwise start and before
# units_ok, so a held issue has no label changed and no comment of the bot's
# posted: the hold is one line of the dispatch log. A planning turn is not held
# by it, as it is not held by image_ok. Returns 1, with the reason logged, when
# the issue waits for its owner.
image_missing_ok() {
  local n=$1
  [ -n "${work_answer[$n]:-}" ] || return 0
  tehas_texts_hold_attachment "${work_answer[$n]}" || return 0
  log "hold #$n: its text says $attach_promise and links no attachment, so the cycle would be given none; attach the file or write out what it shows, before applying \`tehas:ready\`"
  return 1
}
# A real poll has logged the hold at rule 3; a dry run says it where it ends.
mesh_ok() {
  [ -n "$mesh_hold" ] || return 0
  [ "$dry" != 1 ] || log "$mesh_hold"
  return 1
}

# A planning turn runs in a container in the slice. With no usable slice, or
# a slice whose use cannot be read, the turn would start blind after its label
# and comment were spent, so it waits. $slice_hold and $mem_why are set at
# rule 3, which also logs the hold: once in a real poll, and a dry run prints
# it where it ends.
slice_hold=""
mem_why=""
mem_note=""
slice_ok() { [ -z "$slice_hold" ] && [ "$mem_why" != unreadable ]; }

# The gate of the lowest issues (TEHAS_LOW_GATE): rule 7. low_gate <issue>
# answers whether an issue of that kind may start now, and says why it may not.
# What the code below cannot say:
#   - The wait runs under the poll's own lock, so lib/config.sh caps
#     TEHAS_LOW_GATE_WAIT at 600. A longer one holds every later poll too,
#     urgent issues and libexec/tidy included, and the timer polls two minutes
#     after this poll ends.
#   - state/low-gate.held carries nothing but its existence, and only says that
#     a hold was announced: it names no command, so one left by another
#     TEHAS_LOW_GATE is read as this gate's hold. A poll that runs no gate
#     leaves it alone.
#   - The poll reads only the exit status. What the command prints goes to
#     logs/low-gate.log, rewritten by every ask, which is where a gate says why
#     it answered what it did.
gate_asked=0
gate_answer=0
low_gate() { # <issue>
  local n=$1 file=$TEHAS_HOME/state/low-gate.held held marker
  [ -n "$TEHAS_LOW_GATE" ] || return 0
  if [ "$gate_asked" = 0 ]; then
    gate_asked=1
    held=no
    marker=yes
    if [ -L "$file" ]; then
      log "WARN: $file is not a regular file: no hold is read from it or written to it"
      marker=no
    elif [ -e "$file" ]; then
      held=yes
    fi
    gate_answer=0
    env -i PATH="$PATH" timeout -k 10 "$TEHAS_LOW_GATE_WAIT" "$TEHAS_LOW_GATE" 8>&- </dev/null \
      >"$TEHAS_HOME/logs/low-gate.log" 2>&1 || gate_answer=$?
    if [ "$gate_answer" != 0 ]; then
      # A hold already on record was announced by the poll that made it; a dry
      # run says it again because it writes nothing.
      if [ "$held" = no ] || [ "$dry" = 1 ]; then
        log "low issues wait: TEHAS_LOW_GATE answered $gate_answer"
      fi
      if [ "$dry" != 1 ] && [ "$marker" = yes ] && [ "$held" = no ]; then
        : >"$file" || log "WARN: could not write $file"
      fi
    elif [ "$held" = yes ]; then
      log "low issues may start: TEHAS_LOW_GATE answered 0"
      if [ "$dry" != 1 ]; then
        rm -f "$file" || log "WARN: could not remove $file"
      fi
    fi
  fi
  [ "$gate_answer" = 0 ] ||
    { log "wait #$n: the low-priority gate is closed (exit $gate_answer)"; return 1; }
  return 0
}

# branch_check: is the branch red? Asks GitHub once for the latest runs of
# TEHAS_BRANCH_CHECK on the branch's head commit. A run that failed, timed out
# or could not start sets $red_hold. Anything else holds nothing: a check that
# has not finished, is not there or cannot be read must not stop the factory,
# so the poll starts cycles and says why it could not tell (branch_note).
red_hold=""
branch_check() {
  local name=$TEHAS_BRANCH_CHECK answer state
  red_hold=""
  [ -n "$name" ] || return 0
  if answer=$(timeout -k 5 "${TEHAS_CHECK_WAIT:-30}" gh api \
    "repos/$repo/commits/$branch/check-runs?check_name=$(jq -rn --arg n "$name" '$n | @uri')&filter=latest" 2>/dev/null 8>&-); then
    state=$(jq -r '.check_runs | if type == "array" then . else error end
      | if length == 0 then "none"
        elif all(.[]; .head_sha | type == "string" and test("^[0-9a-f]{40}$")) | not then error
        else .[0].head_sha[0:12] as $sha
          | if any(.[]; .status == "completed" and (.conclusion | IN("failure", "timed_out", "startup_failure"))) then "red \($sha)"
            elif all(.[]; .status == "completed") then "done \($sha)"
            else "pending \($sha)" end end' <<<"$answer" 2>/dev/null) || state=""
  else
    state=""
  fi
  case "$state" in
    red\ *)
      red_hold="holding: $branch is red at ${state#red }"
      branch_note ""
      ;;
    done\ *) branch_note "" ;;
    pending\ *) branch_note "the check $name on $branch at ${state#pending } has not finished: cycles start" ;;
    none) branch_note "$branch has no check named $name on its head commit: cycles start" ;;
    *) branch_note "the check $name on $branch could not be read: cycles start" ;;
  esac
}
# branch_note <text>: log it when it is not what the last poll said, kept in
# state/branch-check. Empty says nothing and forgets it. A dry run says it
# every time and keeps nothing.
branch_note() {
  local file=$TEHAS_HOME/state/branch-check last
  if [ "$dry" = 1 ]; then
    [ -z "$1" ] || log "$1"
    return 0
  fi
  last=$(head -c 1000 "$file" 2>/dev/null) || last=""
  [ "$last" != "$1" ] || return 0
  [ -z "$1" ] || log "$1"
  printf '%s\n' "$1" >"$file" 2>/dev/null || log "WARN: could not write $file"
}

# gib <bytes>: the size for a person, to a tenth of a GiB, rounded down.
gib() { printf '%d.%d GiB' $(($1 / 1073741824)) $(($1 % 1073741824 * 10 / 1073741824)); }

# report_hold: write live/dispatch.json for tehas status and log a hold when
# its reason is not the one the last poll wrote, or when it keeps waiting
# issues from free slots ($short). The numbers in the text move between polls,
# so the one word in $why is compared. Needs $why, $hold, $short and the
# slice's numbers. $mesh_end, when mesh_check settled one, is which endpoint
# the subagent provider is on: main or backup. It is the one word the energy
# sampler asks, never an address: live/ is public. A poll that never asked
# (no provider, or an earlier hold) writes nothing. The report goes to a
# private file and from there to live/ through the store's publish
# (lib/live.sh). A file that cannot be written is a warning.
report_hold() {
  local file=$TEHAS_HOME/live/dispatch.json before report
  before=$(jq -r '.why // "" | strings' "$file" 2>/dev/null) || before=""
  if [ -n "$why" ]; then
    [ "$why" = "$before" ] && [ "$short" = 0 ] || log "$hold"
  elif [ -n "$before" ]; then
    log "released: cycles may start again"
  fi
  mkdir -p "$TEHAS_HOME/tmp" && chmod 700 "$TEHAS_HOME/tmp" &&
    report=$(mktemp "$TEHAS_HOME/tmp/dispatch.XXXXXX") || report=""
  if [ -n "$report" ] && jq -n --arg time "$(date -u +%FT%TZ)" --arg why "$why" --arg hold "$hold" --arg reserve "$TEHAS_CYCLE_RESERVE" \
    --argjson count "$count" --argjson room "$room_mem" --argjson committed "$committed" --argjson max "$slice_max" \
    --argjson free "$free" --argjson awaitRoom "${room:-null}" --argjson limitRoom "${limit_room:-null}" \
    --argjson refreshRoom "${lane:-null}" --arg endpoint "$mesh_end" \
    '{$time, $why, $hold, $count, $room, $committed, $max, $reserve, $free, $awaitRoom}
     + (if $limitRoom == null then {} else {$limitRoom} end)
     + (if $refreshRoom == null then {} else {$refreshRoom} end)
     + (if $endpoint == "" then {} else {$endpoint} end)' >"$report" 2>/dev/null; then
    tehas_live_publish --dispatch "$report" ||
      log "WARN: could not write $file ($tehas_store_word: $tehas_store_line)"
  else
    log "WARN: could not write $file"
  fi
  [ -z "$report" ] || rm -f "$report"
  # tehas status reads the health file, which was written when this poll
  # began. A hold that begins or ends is shown now, not a poll later.
  [ "$why" = "$before" ] || "$status_cmd"
}

# work_ok <issue>: is that number still work the factory takes? It asks GitHub
# what the number is, because the list this poll read can name an issue that was
# closed since. A call that fails, or an answer that cannot be read, ends the
# poll, as every other call here does. A pull request or a closed issue is a
# skip, logged once a poll at most like any other refusal.
#
# One issue can be on more than one of the poll's lists, and a number is asked
# once a poll: the answer first read stands for the rest of it, kept in
# $work_answer for image_ok, and a refusal
# is said once. Every call site sits after the checks that hold the issue back
# for other reasons, so the ask is paid only for an issue this poll would
# otherwise take.
work_refused=" " answered=" "
declare -A work_answer=()
work_ok() {
  case "$answered" in *" $1 "*) return 0 ;; esac
  case "$work_refused" in *" $1 "*) return 1 ;; esac
  gh_json api "repos/$repo/issues/$1"
  if tehas_work_kind "$json"; then
    answered="$answered$1 "
    work_answer[$1]=$json
    return 0
  fi
  case "$tehas_work_why" in
    pr | closed)
      work_refused="$work_refused$1 "
      if [ "$tehas_work_why" = pr ]; then
        log "skip #$1: it is a pull request, not an issue the factory works on"
      else
        log "skip #$1: it is closed, and a closed issue is never taken"
      fi
      ;;
    *)
      log "ERROR: GitHub's answer for #$1 could not be read"
      exit 1
      ;;
  esac
  return 1
}

# The events of one issue are read when a decision needs them and kept only
# while that issue is being decided: a poll holds no event payload between
# issues. Who applied one label of one issue is remembered for the poll in
# $actor_of, so a poll never asks GitHub the same question twice. An answer is
# used only by the decision that asked for it, and no label of that issue
# changes in between. A failed call to GitHub ends the poll. Which account an
# event names, and whether the instance allows it, is lib/labels.sh: the same
# reading tehasbot protolab uses for tehas:prototype.
events=""
events_for=""
declare -A actor_of=()

# issue_events <issue>: the issue's label events, fresh from GitHub, in $events.
issue_events() {
  local n=$1
  gh_json api "repos/$repo/issues/$n/events?per_page=100" --paginate
  events=$json
  events_for=$n
}

who=""
at=""

# The control issue is the pause switch, not work. It holds no outcome, so a
# cycle on it spends a slot, model time and an issue's worth of tokens on the
# label that stops the factory. Every ask to work on it is refused at the
# earliest moment this poll can tell that the issue is the control one and that
# nothing else holds the ask back. Whoever applied the label, and whether or not
# the account is allowed, the number of TEHAS_CONTROL_ISSUE is never picked, and
# the poll changes no label of it: it does not clear a switch. One line a poll at
# most, as the refusal of a label from an account outside the list is, so a
# control issue that keeps a label nobody will take off says itself once.
control_skipped=0
control_ask() { # <issue> <what was asked of it>: 0 when the issue is the control one
  [ "$1" = "$control" ] || return 1
  [ "$control_skipped" = 1 ] ||
    { log "skip #$1: the control issue is never worked on ($2)"; control_skipped=1; }
  return 0
}

# label_actor <issue> <label>: the account that applied the label most recently,
# and when, in $who and $at; both empty when no event applies to that label.
label_actor() {
  local n=$1 name=$2 line
  if [ -n "${actor_of["$n $name"]+set}" ]; then
    line=${actor_of["$n $name"]}
  else
    issue_events "$n"
    line=$(tehas_label_actor "$name" <<<"$events") ||
      { log "ERROR: unreadable label events of #$n"; exit 1; }
    actor_of["$n $name"]=$line
  fi
  who=${line%%$'\t'*}
  at=${line#*$'\t'}
}

ev=""
# label_state <issue> <label>: the label's latest event, as tehas_label_state
# reads it, in $ev, $who and $at. The issue's events are read unless they are
# already at hand.
label_state() {
  local n=$1 line
  [ "$events_for" = "$n" ] || issue_events "$n"
  line=$(tehas_label_state "$2" <<<"$events") || { log "ERROR: unreadable label events of #$n"; exit 1; }
  ev=${line%%$'\t'*}
  line=${line#*$'\t'}
  who=${line%%$'\t'*}
  at=${line#*$'\t'}
}

# order_label <issue> <label>: 0 when tehas:next or tehas:blocked stands: an
# allowed account or the fixer applied it last, and nobody took it off since.
# Otherwise the poll ignores it and says so.
order_label() {
  label_state "$1" "$2"
  if [ "$ev" = unlabeled ]; then
    log "ignore #$1: $2 was taken off by '${who:-unknown}' since it was applied"
    return 1
  fi
  tehas_allowed_labeler "$who" || tehas_millwright_is "$who" || { deny_label ignore "$1" "$2"; return 1; }
}

# blocked_ok <issue>: 0 unless tehas:blocked holds the issue back. The label
# stands as order_label says. The blockers are named in the newest of the last
# 100 comments that an allowed account or the fixer wrote with the marker
#   <!-- tehas:blocked by=12,34 -->
# up to 20 numbers. The issue waits while any of them is open. What cannot be
# read holds it too: no such comment, a malformed marker, a comment last edited
# by another account, a number whose state GitHub does not give. Returns 1 with
# the reason logged.
blocked_ok() {
  # Local, so the blocked label's account does not replace the ready label's.
  local n=$1 got list b q answer state why="" ev who at
  order_label "$n" tehas:blocked || return 0
  # shellcheck disable=SC2016  # $owner, $name and $number are GraphQL variables
  gh_json api graphql -F owner="${repo%%/*}" -F name="${repo##*/}" -F number="$n" \
    -f query='query($owner: String!, $name: String!, $number: Int!) {
      repository(owner: $owner, name: $name) { issue(number: $number) {
        comments(last: 100) { nodes { databaseId author { login } body createdAt lastEditedAt editor { login } } } } } }'
  # shellcheck disable=SC2016  # a jq program
  got=$(jq -r --arg allowed "$TEHAS_ALLOWED_LABELERS" --arg fixer "${TEHAS_MILLWRIGHT_LOGIN:-}" '
    .data.repository.issue.comments.nodes | if type == "array" then . else error("no comments") end
    | ($allowed | split(" ") + [$fixer] | map(select(. != ""))) as $list
    | map(select(type == "object" and (.body | type) == "string" and (.body | contains("<!-- tehas:blocked"))
        and ((.author.login // "") as $a | $list | index($a)) != null))
    | sort_by(.createdAt // "", .databaseId // 0) | last
    | if . == null then "none\t"
      elif .lastEditedAt != null and (.editor.login // "") != .author.login then "edited\t\(.editor.login // "")"
      else ((first(.body | capture("<!-- tehas:blocked by=(?<b>[1-9][0-9]{0,8}(,[1-9][0-9]{0,8}){0,19}) -->")) | .b) // "")
        | if . == "" then "malformed\t" else "by\t\(.)" end
      end' <<<"$json") || { log "ERROR: unreadable comments of #$n"; exit 1; }
  case "${got%%$'\t'*}" in
    none) why="no comment of an allowed account or the fixer names its blockers" ;;
    edited) why="the newest comment that names its blockers was edited by '${got#*$'\t'}'" ;;
    malformed) why="the newest comment that names its blockers cannot be read" ;;
    by)
      list=$(tr , '\n' <<<"${got#*$'\t'}" | sort -nu)
      # shellcheck disable=SC2016  # $owner and $name are GraphQL variables
      q='query($owner: String!, $name: String!) { repository(owner: $owner, name: $name) {'
      for b in $list; do
        q+=" b$b: issueOrPullRequest(number: $b) { ... on Issue { state } ... on PullRequest { state } }"
      done
      q+=' } }'
      # GitHub answers a number it does not know with an error beside the data,
      # and gh then fails: what it printed still names the rest.
      answer=$(gh api graphql -F owner="${repo%%/*}" -F name="${repo##*/}" -f query="$q" 2>/dev/null) || true
      for b in $list; do
        state=$(jq -r --arg k "b$b" '.data.repository[$k].state // "" | strings' <<<"$answer" 2>/dev/null) || state=""
        case "$state" in
          CLOSED | MERGED) ;;
          OPEN) why="#$b is open"; break ;;
          *) why="the state of #$b could not be read"; break ;;
        esac
      done
      ;;
  esac
  [ -n "$why" ] || return 0
  log "wait #$n: tehas:blocked holds it: $why"
  return 1
}

# deny_label <verb> <issue> <label>: the label came from an account outside the
# list. $who is the name GitHub gave, empty when its event names nobody.
deny_label() {
  log "$1 $(tehas_label_denied "$2" "$3" "$who")"
}

# approval <issue> <label>: who applied the label most recently, and when, in
# $who and $at; the issue's events in $events. Returns 1, with the reason
# logged, unless that was an allowed account and the text is still what it
# approved. The read is taken here, at the decision, so a label spent or moved
# earlier in this poll cannot stand for an approval given now. $refused is the
# account whose label was refused for not being allowed, empty for every other
# refusal and whenever the label does authorise.
refused=""
approval() {
  local n=$1 name=$2
  refused=""
  label_actor "$n" "$name"
  if ! tehas_allowed_labeler "$who"; then
    # The fixer's label is the caller's to weigh, and fixer_ok logs it.
    if [ "$name" != tehas:ready ] || ! tehas_millwright_is "$who"; then
      deny_label skip "$n" "$name"
    fi
    refused=${who:-unknown}
    return 1
  fi
  unchanged_since "$n" "$at" "$who applied $name"
}

# clear_unauthorised <issue> <label> <login>: GitHub lets any account with
# write access apply any label, so the list cannot be enforced there. A
# tehas:ready or tehas:plan from an account outside the list asks for nothing,
# and an issue that carries it reads as queued to whoever looks at the issue or
# the dashboard. Take it off and say so on the issue. The comment follows the
# label change: while the change fails, the next poll finds the same label and
# must not say the same once more.
clear_unauthorised() {
  local n=$1 name=$2 by=$3
  if [ "$dry" = 1 ]; then
    log "would take $name off #$n: it was applied by '$by'"
    return
  fi
  if gh issue edit "$n" --repo "$repo" --remove-label "$name" >/dev/null 2>&1; then
    log "clear #$n: $name off, applied by '$by' who may not authorise work here"
    say "$n" "Tehas took \`$name\` off this issue. It was applied by \`$by\`, an account that may not authorise work in this factory, so nothing was started and the issue is not queued. To ask again, an account named in \`TEHAS_ALLOWED_LABELERS\` applies \`$name\`."
  else
    log "WARN: label change on #$n failed: --remove-label $name"
  fi
}

# epic_ok <issue>: is that number work this factory starts? An issue with open
# sub-issues is an epic: a plan broken into issues, not a change one cycle can
# make. Starting one spends a slot and a stack of tokens and parks as too
# large, so it never starts.
#
# The count comes from the answer work_ok already read, so this asks GitHub
# nothing: a GitHub Enterprise without sub-issues answers without the field and
# the issue starts as any other. A total of no open sub-issue starts too, and so
# does an answer whose two numbers are not numbers, or one where the completed
# count is above the total.
#
# An epic that carries tehas:ready loses that label and says why on the issue
# once, as clear_unauthorised does, the comment following the label change. A
# retry tick is no label of tehas's to take off, and an epic need not carry
# tehas:ready at all, so on that path nothing of the issue is changed and
# nothing is said on it: its tick stays, as a tick a hold leaves, and a poll
# that finds it again says the one line in the log rather than comment on the
# issue every two minutes.
#
# Call it where a cycle is about to start, after work_ok, on the `tehas:ready`
# path and on the retry tick of a park question. A planning session on an epic
# is allowed: planning an epic is what planning is for.
# Returns 1 when the issue is an epic.
epic_ok() {
  local n=$1 open word
  open=$(jq -r 'if ((.sub_issues_summary // null) | type) == "object" and
                  ((.sub_issues_summary.total | type) == "number") and
                  ((.sub_issues_summary.completed | type) == "number")
                then (.sub_issues_summary.total - .sub_issues_summary.completed)
                else "" end' <<<"${work_answer[$n]:-}" 2>/dev/null) || open=""
  [[ $open =~ ^[0-9]+$ ]] || return 0
  # An answer where completed exceeds total does not add up: it starts as any
  # other, as one that cannot be read does.
  [ "$open" -gt 0 ] || return 0
  word=sub-issue
  [ "$open" = 1 ] || word=${word}s
  log "skip #$n: it is an epic with $open $word open, and an epic is never started"
  # Only the label that asked for the cycle comes off. A retry tick's issue
  # may carry none.
  [[ $have == *" $ask "* ]] || return 1
  if [ "$dry" = 1 ]; then
    log "would take $ask off #$n: it is an epic"
    return 1
  fi
  if gh issue edit "$n" --repo "$repo" --remove-label $ask >/dev/null 2>&1; then
    say "$n" "Tehas took \`$ask\` off this issue and started nothing. It has $open $word open, so it is an epic: a plan, not a change. An epic is never started. Apply \`tehas:ready\` to one of its sub-issues instead."
  else
    log "WARN: label change on #$n failed: --remove-label $ask"
  fi
  return 1
}

# The loop's own label, and its label for a finding whose fix needs a change on
# both sides of the factory and pi-rukas. libexec/improve puts the second beside
# the first, on the two halves of a boundary finding and on any finding whose
# text names a repository the loop knows of besides the one the issue is filed
# in, and says in each body which repository has which half. The three names are
# shared with libexec/improve; test/improve_repos_test.sh names them too.
loop_label=tehas:improvement
cross_label=cross-project

# cross_repo_holds <issue> <its labels>: does another repository hold this issue
# back? The improvement loop labels such a finding cross-project, beside its own
# label, because a cycle in this repository can make only one half of it. The
# cycle that takes one reads the text, reads the source it was pinned to, finds
# the change belongs in a repository this factory has no checkout of, and parks:
# hours of a slot to rediscover what the label already said, with a comment
# asking for a person on an issue no cycle here can fix. So the poll starts
# nothing while both labels stand, and asks GitHub nothing: the labels are read
# from the ready list this poll already has. As for an epic the issue and its
# labels stay as they are, so the log line is the whole tell; a comment every two
# minutes would be its own noise.
#
# Only an issue that also carries the loop's own label is held. That label says
# tehas put cross-project there, which is what makes the pair trustworthy: a
# cross-project anyone may apply is no reason to hold a person's issue back.
# A planning session is not held by it: deciding which repository a finding
# belongs in is what a planning turn is for, and a turn opens no pull request.
# A refresh takes no path through here, as no refresh carries either label.
#
# Call it where a cycle is about to start, after work_ok, on the `tehas:ready`
# path and on the retry tick of a park question, where the labels are the ones
# read for the issue. Returns 1 when the issue is held.
cross_repo_holds() {
  local n=$1 have=$2
  [[ $have == *" $cross_label "* ]] || return 0
  [[ $have == *" $loop_label "* ]] || return 0
  log "skip #$n: it carries $cross_label and $loop_label, so its fix needs a change in another repository too, and one cycle here cannot make it"
  return 1
}

# size_ok <issue> <its labels>: is that number small enough for one cycle? With
# TEHAS_SIZE_MAX_FILES set on the instance, the body the label approved is
# measured (lib/sizing.sh) and a body naming more files than the setting names
# is not started: it is a stack of changes wearing the shape of one issue, and
# the cycle would spend its explore and its plan before it parked. As for an
# epic, the label that asked for the cycle comes off, needs-human-attention
# goes on for the person to read, and the issue says the counts, the setting
# and the way out once: narrow the body or split the issue, then apply
# \`tehas:ready\` again. The comment follows the label changes, so a poll whose
# label change failed finds the same label next time and says nothing on the
# issue again. A body GitHub does not give as text ends the poll rather than
# starting a cycle on a count nobody read, as every other unreadable answer of
# GitHub's here does: the four zeros the measure gives an empty body are not a
# guess about a body it was never given. Unset, this asks nothing and nothing
# changes. The labels are the caller's second argument, as work_ok's answer
# holds the body and not the labels, and a refresh takes no path through here: a
# refresh is never held (rule 4b), and the label this path would take off is not
# one a refresh carries. Returns 1 when the issue is held.
size_ok() {
  local n=$1 have=$2 files
  [ -n "$TEHAS_SIZE_MAX_FILES" ] || return 0
  files=$(jq -r 'if ((.body // "") | type) == "string" then (.body // "") else "@@" end' <<<"${work_answer[$n]:-}") || files=""
  [ "$files" = "@@" ] || files=$(tehas_issue_size <<<"$files" | jq -r .files 2>/dev/null) || files=""
  [[ $files =~ ^[0-9]+$ ]] || {
    log "ERROR: the size of #$n could not be read"
    exit 1
  }
  [ "$files" -le "$TEHAS_SIZE_MAX_FILES" ] || {
    log "skip #$n: its body names $files files, more than TEHAS_SIZE_MAX_FILES ($TEHAS_SIZE_MAX_FILES), and one cycle does not make that many changes"
    # The labels are the caller's: the park and refresh paths write the global
    # $have for issues of their own.
    [[ $have == *" $ask "* ]] || return 1
    if [ "$dry" = 1 ]; then
      log "would take $ask off #$n and add needs-human-attention: its body names $files files, more than TEHAS_SIZE_MAX_FILES ($TEHAS_SIZE_MAX_FILES)"
      return 1
    fi
    if gh issue edit "$n" --repo "$repo" --remove-label $ask --add-label needs-human-attention >/dev/null 2>&1; then
      say "$n" "Tehas took \`$ask\` off this issue, put \`needs-human-attention\` on it and started nothing. Its body names $files files, more than the $TEHAS_SIZE_MAX_FILES of \`TEHAS_SIZE_MAX_FILES\`, so one cycle would be asked for too many changes at once. Narrow this issue to the part of it one cycle can make, or split it into issues of that size, and apply \`tehas:ready\` again to start one of them."
    else
      log "WARN: label change on #$n failed: --remove-label $ask --add-label needs-human-attention"
    fi
    return 1
  }
}

# open_pr <issue>: the url of an open pull request that GitHub says closes
# the issue, in $pr_url; empty when there is none. A cycle on such an issue
# would find the work done, after its explore and plan were paid for.
pr_url=""
open_pr() {
  # shellcheck disable=SC2016  # $owner, $name and $number are GraphQL variables
  gh_json api graphql -F owner="${repo%%/*}" -F name="${repo##*/}" -F number="$1" \
    -f query='query($owner: String!, $name: String!, $number: Int!) {
      repository(owner: $owner, name: $name) { issue(number: $number) {
        closedByPullRequestsReferences(first: 20) { nodes { url state } } } } }'
  pr_url=$(jq -r '.data.repository.issue.closedByPullRequestsReferences.nodes
            | if type == "array" then . else error end
            | map(select(.state == "OPEN")) | .[0].url // ""' <<<"$json") ||
    { log "ERROR: unreadable pull requests of #$1"; exit 1; }
}

# clear_pr_open <issue>: the label asks for work a pull request already does.
# Take it off and say so, as clear_unauthorised does, and on the same terms.
clear_pr_open() {
  local n=$1
  log "skip #$n: pull request $pr_url is open and closes it"
  [ "$dry" = 0 ] || return 0
  if gh issue edit "$n" --repo "$repo" --remove-label $ask >/dev/null 2>&1; then
    say "$n" "Tehas took \`$ask\` off this issue and started nothing: $pr_url is open and closes it. Merge or close that pull request, then apply \`tehas:ready\` if work is still needed."
  else
    log "WARN: label change on #$n failed: --remove-label $ask"
  fi
}

# fixer_ok <issue>: the fixer applied tehas:ready, at $at. 0 when its grant
# covers the start (lib/millwright.sh): the person's approval it rests on is left in
# $tehas_millwright_rests_on and the count of fixer starts in $tehas_millwright_count.
# Otherwise the label comes off and the issue says why, on the same terms as
# clear_unauthorised; a text changed since the label waits, as for anyone.
fixer_ok() {
  local n=$1 sum
  unchanged_since "$n" "$at" "the fixer applied tehas:ready" "the fixer or a person applies it again" || return 1
  sum=$(jq '.data.repository.issue // {}' <<<"${text_of[$n]}" | tehas_body_sha256) ||
    { log "ERROR: the text of #$n could not be read for its hash"; exit 1; }
  tehas_millwright_grant "$n" "$sum"
  case $? in
    0)
      # The body hash does not cover the title: a rename since the person's
      # approval was not approved either.
      unchanged_since "$n" "$(jq -r .at <<<"$tehas_millwright_rests_on")" "$(jq -r .by <<<"$tehas_millwright_rests_on") approved it" \
        "a person applies tehas:ready" && return 0
      tehas_millwright_why="its title or text was changed since $(jq -r .by <<<"$tehas_millwright_rests_on") approved it"
      ;;
    2)
      # Could not look: the label stays, and the next poll asks again.
      log "skip #$n: tehas:ready from the fixer waits: $tehas_millwright_why"
      return 1
      ;;
  esac
  log "skip #$n: tehas:ready from the fixer starts nothing: $tehas_millwright_why"
  if [ "$dry" = 1 ]; then
    log "would take tehas:ready off #$n"
    return 1
  fi
  if gh issue edit "$n" --repo "$repo" --remove-label tehas:ready >/dev/null 2>&1; then
    say "$n" "Tehas took \`tehas:ready\` off this issue and started nothing. The fixer applied it, and the fixer may not start this issue: $tehas_millwright_why. A person decides now: an account named in \`TEHAS_ALLOWED_LABELERS\` applies \`tehas:ready\` to start a cycle."
  else
    log "WARN: label change on #$n failed: --remove-label tehas:ready"
  fi
  return 1
}

# fixer_answer_ok <issue> <session> <answer> tick|reply: the fixer answered a
# planning question. <session> is the open session as plan_view writes it. 0
# when the answer may run the turn (tehas_millwright_answer in lib/millwright.sh, a
# marked reply, never the way out). Otherwise it is an outsider's: a tick is
# undone with a note, as a stranger's is, and a reply is logged and said on the
# issue once, its id noted with the session (plan-note --kind fixer-refused).
fixer_answer_ok() {
  local n=$1 view=$2 ans=$3 said=$4 why="" id
  # The way out is a person's, whether the fixer's tick or its reply is used.
  if [ "$(jq -r .tick.status <<<"$ans")" = fixer ] && [ "$(jq -r .tick.index <<<"$ans")" = "$(($(jq -r .boxes <<<"$ans") - 1))" ]; then
    why="it ticked End this planning session, which only a person may"
  elif [ "$said" = reply ] && [ "$(jq -r .fixer_reply.marked <<<"$ans")" != true ]; then
    why="its reply does not start with <!-- tehas:fixer issue=$n action=answer -->"
  elif ! tehas_millwright_answer "$view"; then
    why=$tehas_millwright_why
  else
    return 0
  fi
  if [ "$said" = tick ]; then
    log "skip #$n: the fixer's answer runs no turn: $why"
    [ "$dry" = 1 ] || untick "$n" "$ans" "The fixer's tick was not taken as an answer: $why. It was unticked. A person answers this question." ||
      log "WARN: could not untick the question on #$n"
    return 1
  fi
  id=$(jq -r '.fixer_reply.id | tostring' <<<"$ans")
  [[ $id =~ ^[1-9][0-9]{0,15}$ ]] || return 1
  jq -e --argjson id "$id" '(.fixer_refused // []) | type == "array" and index($id) == null' "$view" >/dev/null 2>&1 || return 1
  log "skip #$n: the fixer's answer runs no turn: $why"
  [ "$dry" = 0 ] || return 1
  if plan_store plan-note "$n" --kind fixer-refused --id "$id"; then
    [ "$(tehas_store_get .said)" != true ] ||
      say "$n" "Tehas did not take the fixer's reply as an answer: $why. A person answers this question."
  else
    log "WARN: the record of #$n could not be updated ($tehas_store_word)"
  fi
  return 1
}

# fixer_held <issue> <session> <answer>: the fixer saved the ticked question
# after someone else edited it, so the tick may be a person's. It is neither
# used nor undone: a person ticks again or replies. Said once a question, its
# id noted with the session (plan-note --kind held).
fixer_held() {
  local n=$1 view=$2 ans=$3 id
  id=$(jq -r '.comment | tostring' <<<"$ans")
  [[ $id =~ ^[1-9][0-9]{0,15}$ ]] || return 0
  jq -e --argjson id "$id" '(.held // []) | type == "array" and index($id) == null' "$view" >/dev/null 2>&1 || return 0
  log "skip #$n: the fixer saved the question after another account did, so who ticked it is not known"
  [ "$dry" = 0 ] || return 0
  if plan_store plan-note "$n" --kind held --id "$id"; then
    [ "$(tehas_store_get .said)" != true ] ||
      say "$n" "Tehas did not take the box ticked in this question as an answer: the fixer saved the comment after another account did, and GitHub does not say who ticked it. A person ticks the box again or replies."
  else
    log "WARN: the record of #$n could not be updated ($tehas_store_word)"
  fi
}

# unchanged_since <issue> <time> <what happened then> [how to approve again]
# Needs the label events of $n in $events; they are read when they are not
# already at hand. An approval covers the text that was there when it was given.
# A title or body changed afterwards by anyone else has not been approved by
# anybody: the issue waits until an allowed account approves it again. A change
# whose account GitHub no longer names, a deleted one, is by 'unknown'. Returns
# 1, with the reason logged, if that happened.
# The body comes in the same answer as the edit record, so the text kept in
# $text_of for the approval record is the text this check passed.
declare -A text_of=()
unchanged_since() {
  local n=$1 since=$2 what=$3 again=${4:-apply the label again} renamed edited editors edited_at stale e
  [ "$events_for" = "$n" ] || issue_events "$n"
  renamed=$(jq -rs --arg at "$since" 'add // [] | map(select(.event == "renamed" and ($at == "" or .created_at > $at)))
                  | map(.actor.login // "" | if . == "" then "unknown" else . end) | join(" ")' <<<"$events") ||
    { log "ERROR: unreadable label events of #$n"; exit 1; }
  # shellcheck disable=SC2016  # $owner, $name and $number are GraphQL variables
  gh_json api graphql -F owner="${repo%%/*}" -F name="${repo##*/}" -F number="$n" \
    -f query='query($owner: String!, $name: String!, $number: Int!) {
      repository(owner: $owner, name: $name) { issue(number: $number) { lastEditedAt editor { login } body title } } }'
  text_of[$n]=$json
  edited=$(jq -r '.data.repository.issue | "\(.editor.login // "") \(.lastEditedAt // "")"' <<<"$json") ||
    { log "ERROR: unreadable edit record of #$n"; exit 1; }
  editors=$renamed
  edited_at=${edited#* }
  if [ -n "$edited_at" ] && { [ -z "$since" ] || [[ $edited_at > $since ]]; }; then
    editors="$editors ${edited%% *}"
    [ -n "${edited%% *}" ] || editors="$editors unknown"
  fi
  stale=""
  for e in $editors; do
    tehas_allowed_labeler "$e" || stale=$e
  done
  if [ -n "$stale" ]; then
    log "skip #$n: its text was changed by '$stale' after $what; $again to approve it"
    return 1
  fi
}

# Cycles start from the product's default branch; keep the checkout current.
# tehas work clones the cycle's workspace from it. No container is ever given
# this checkout, so running git here runs nothing an agent wrote. Put it back
# on the branch only when it is clean: never discard someone's changes.
refresh_checkout() {
  if [ -z "$(git -C "$checkout" status --porcelain --untracked-files=no)" ]; then
    git -C "$checkout" checkout -q "$branch" || log "WARN: could not switch $checkout to $branch"
  else
    log "WARN: $checkout has uncommitted changes, leaving its branch alone"
  fi
  # Bounded: it runs under the poll's lock, and a hung fetch would stop every
  # later poll. What it starts does not take the lock with it.
  if ! timeout -k 10 "${TEHAS_FETCH_WAIT:-120}" git -C "$checkout" fetch -q origin 8>&- ||
    ! git -C "$checkout" merge -q --ff-only "origin/$branch"; then
    log "WARN: could not fast-forward $checkout"
  fi
}

# What a poll will start, and on whose word: the issues in $picked and, for
# each, who authorised it, the word for how in the log and in the comment, and
# the gh issue edit options that take it out of the queue it came from. For
# the approval record: when it was given and how, in one word.
picked=()
declare -A starter=() verb=() how=() drop=() given_at=() given_how=() given_since=() given_comment=()
# The time of the approval each start recorded, epoch seconds, by which a
# start that gives up takes it off the record again.
declare -A recorded_at=()
# A refresh's: the pull request to mark, its address, and what it refreshes.
# The store counts the refreshes and the fixer's starts from the approvals.
declare -A refresh_pr=() refresh_url=() refresh_of=()

# approved_record <issue>: record the approval of a start in the state store,
# its inputs with it, and its time in recorded_at. Returns 1 when it could not
# be recorded, with the store's word in record_word when the store said no:
# "used" is an approval that started a cycle already.
record_word=""
approved_record() {
  local n=$1 sum tsum from='[]' retry=null at input dir rc
  local -a args
  record_word=""
  [ -n "${text_of[$n]:-}" ] || return 1
  sum=$(jq '.data.repository.issue // {}' <<<"${text_of[$n]}" | tehas_body_sha256) || return 1
  # The title of the same answer. An answer that names none binds none.
  tsum=$(jq '.data.repository.issue // {}' <<<"${text_of[$n]}" | tehas_title_sha256 2>/dev/null) || tsum=""
  if [ "$TEHAS_WORK_COMMENTS" = 1 ]; then
    from=$(comment_links "$n" "${given_at[$n]}") || { log "ERROR: the comments of #$n could not be read"; return 1; }
    if [ "${given_how[$n]}" = retry-tick ]; then
      retry=$(pr_comments "$n" "${given_since[$n]:-}" "${given_at[$n]}") ||
        { log "ERROR: the comments on the pull request of #$n could not be read"; return 1; }
    fi
  fi
  if [ "${given_how[$n]}" = fixer ]; then
    retry=$(fixer_note "$n" "${given_at[$n]}") || { log "ERROR: the comments of #$n could not be read for the fixer's"; return 1; }
  fi
  [ "${given_how[$n]}" != refresh ] || retry=$(refresh_note "$n") || return 1
  # When the approval was given, as GitHub said. A refresh and the retry after
  # an outage rest on an approval that is on record already: they are on record
  # at the time the poll decided them, and so is an approval whose time GitHub
  # did not say.
  at=""
  case ${given_how[$n]} in
    refresh | outage-retry) ;;
    *) [ -z "${given_at[$n]}" ] || at=$(date -u -d "${given_at[$n]}" +%s 2>/dev/null) || at="" ;;
  esac
  [[ $at =~ ^[1-9][0-9]{0,10}$ ]] || at=$EPOCHSECONDS
  dir=$TEHAS_HOME/tmp
  [ -e "$dir" ] || mkdir -m 700 "$dir" 2>/dev/null
  [ -d "$dir" ] && [ ! -L "$dir" ] && input=$(mktemp "$dir/approval-input.XXXXXX" 2>/dev/null) || return 1
  if ! jq --argjson comments "$TEHAS_WORK_COMMENTS" --argjson from "$from" --argjson retry "$retry" \
    --arg how "${given_how[$n]}" --argjson of "${refresh_of[$n]:-null}" \
    "$(tehas_attachment_links)"'{links: (.data.repository.issue.body // "" | links | reduce .[] as $x ([]; if any(.[]; . == $x) then . else . + [$x] end))}
      + if $comments == 1 then {comment_links: ($from + ($retry.links // []))} else {} end
      + if $retry == null or ($retry.context | length) == 0 then {} else {retry_context: $retry.context} end
      + if $how == "refresh" then {refresh_of: $of} else {} end' \
    <<<"${text_of[$n]}" >"$input" 2>/dev/null; then
    rm -f "$input"
    return 1
  fi
  args=("$n" --at "$at" --by "${starter[$n]}" --how "${given_how[$n]}" --body-sha "$sum" --input-file "$input")
  case ${given_how[$n]} in label | fixer) args+=(--label tehas:ready) ;; esac
  [ -z "$tsum" ] || args+=(--title-sha "$tsum")
  [[ ${given_comment[$n]:-} =~ ^[1-9][0-9]{0,15}$ ]] && args+=(--comment-id "${given_comment[$n]}")
  [ -z "${refresh_pr[$n]:-}" ] ||
    args+=(--refresh-pr "${refresh_pr[$n]}" --refresh-head "$(jq -r .head_sha <<<"${refresh_of[$n]}")")
  tehas_store approval-record "${args[@]}"
  rc=$?
  rm -f "$input"
  if [ "$rc" != 0 ]; then
    record_word=$tehas_store_word
    [ -n "$record_word" ] || record_word=unusable
    return 1
  fi
  recorded_at[$n]=$at
}

# A jq definition, `window`: of the comments as the REST API lists them, one
# JSON list per page, those an allowed account wrote at or after $since and at
# or before $at, and that nobody edited after $at, in the order written. A
# comment later than the approval was not there to be approved. An $at that is
# empty takes none.
# shellcheck disable=SC2016  # a jq program
comment_window='def window: if any(.[]; type != "array") then error("not a list of comments") else . end
  | ($allowed | split(" ")) as $list
  | [add // [] | .[] | select(type == "object" and (.id | type) == "number" and (.body | type) == "string"
      and ((.user.login // "") as $a | $a != "" and ($list | index($a)) != null)
      and (.created_at | type) == "string" and (.updated_at | type) == "string"
      and $at != "" and .created_at >= $since and .created_at <= $at and .updated_at <= $at)]
  | sort_by(.created_at, .id);
  def dedupe: reduce .[] as $x ([]; if any(.[]; .link == $x.link) then . else . + [$x] end);'

# comment_links <issue> <time>: the attachment links in the issue's comments
# that the approval at <time> covers, as a JSON list of {link, source, by}.
# Fails when the comments cannot be read.
comment_links() {
  local list
  list=$(gh api "repos/$repo/issues/$1/comments?per_page=100" --paginate 2>/dev/null) || return 1
  jq -cs --arg since "" --arg at "$2" --arg allowed "$TEHAS_ALLOWED_LABELERS" "$(tehas_attachment_links)$comment_window"'
    window | [.[] | .id as $id | .user.login as $by | .body | links[] | {link: ., source: "comment:\($id)", by: $by}] | dedupe' \
    <<<"$list" 2>/dev/null
}

# pr_comments <issue> <park time> <tick time>: what a reviewer said on the
# parked cycle's pull request before the retry, as {links, context}. The pull
# requests are the bot's that name the issue, as tehasbot cycle finds a
# cycle's. Of their comments, those an allowed account wrote between the park
# and the tick and nobody edited after it: the tick approves them as it
# approves the text. links as comment_links has them, source
# "pr-comment:<id>"; context the first 20, each cut at 4000 characters, for
# retry-context.md. Fails when a list cannot be read.
pr_comments() {
  local prs pr list all=""
  prs=$(gh pr list --repo "$repo" --author "$bot" --state all --json number,body,headRefName --limit 100 2>/dev/null) || return 1
  prs=$(jq -r --arg n "$1" "$(tehas_names_issue)"'
    if type != "array" then error("not a list") else . end
    | [.[] | select(type == "object" and (.number | type) == "number") | select(mine) | .number] | sort | .[]' <<<"$prs" 2>/dev/null) ||
    return 1
  for pr in $prs; do
    list=$(gh api "repos/$repo/issues/$pr/comments?per_page=100" --paginate 2>/dev/null) || return 1
    all+=$list$'\n'
  done
  [ -n "$2" ] || all=""
  jq -cs --arg since "$2" --arg at "$3" --arg allowed "$TEHAS_ALLOWED_LABELERS" "$(tehas_attachment_links)$comment_window"'
    window
    | {links: ([.[] | .id as $id | .user.login as $by | .body | links[] | {link: ., source: "pr-comment:\($id)", by: $by}] | dedupe),
       context: [.[0:20][] | {source: "pr-comment:\(.id)", by: .user.login, at: .created_at, text: (.body | gsub("\r"; "") | .[0:4000])}]}' \
    <<<"$all" 2>/dev/null
}

# fixer_note <issue> <label time>: the fixer's comment behind its tehas:ready,
# as {links: [], context}: the newest comment of TEHAS_MILLWRIGHT_LOGIN with the
# fixer's marker for this issue, written in the ten minutes before the label
# and edited by nobody after it. The fixer comments and then labels, so an
# older one is an earlier decision's. context is [] when there is none. Fails
# when the comments cannot be read.
fixer_note() {
  local list since
  list=$(gh api "repos/$repo/issues/$1/comments?per_page=100" --paginate 2>/dev/null) || return 1
  since=$(date -u -d "$2 - 10 minutes" +%FT%TZ 2>/dev/null) || return 1
  jq -cs --arg n "$1" --arg since "$since" --arg at "$2" --arg fixer "$TEHAS_MILLWRIGHT_LOGIN" '
    if any(.[]; type != "array") then error("not a list of comments") else . end
    | [add // [] | .[] | select(type == "object" and (.id | type) == "number" and (.body | type) == "string"
        and (.user.login // "") == $fixer and (.created_at | type) == "string" and (.updated_at | type) == "string"
        and .created_at >= $since and .created_at <= $at and .updated_at <= $at
        and (.body | test("<!-- tehas:fixer issue=" + $n + " action=(retry|change) -->")))]
    | sort_by(.created_at, .id) | .[-1:]
    | {links: [], context: map({source: "fixer:\(.id)", by: .user.login, at: .created_at,
        text: (.body | gsub("\r"; "") | .[0:4000])})}' <<<"$list" 2>/dev/null
}

# refresh_note <issue>: the one retry_context entry of a refresh, as {links:
# [], context}. tehas writes it, so no comment reaches a cycle this way.
refresh_note() {
  local b
  b=$(jq -r .branch <<<"${refresh_of[$1]}") || return 1
  jq -n -c --arg at "$(date -u +%FT%TZ)" \
    --arg text "This pull request conflicts with \`$b\`. Merge \`$b\` into its branch, resolve the conflicts so the change still does what the issue asks, run the gate, and push to the same branch. Do no other work." \
    '{links: [], context: [{source: "refresh", by: "tehas", $at, $text}]}'
}

# The label that says a refresh works on a pull request.
refreshing_label=tehas:refreshing

# refresh_mark <pr>: put tehas:refreshing on a pull request. The REST issues
# endpoint, not `gh pr edit`: that one asks GitHub a GraphQL question the
# bot's token may not answer (issue #120), so a mark would fail on every
# pull request. Adding a label GitHub already has is not an error, so this is
# safe to call again.
refresh_mark() {
  gh api -X POST "repos/$repo/issues/$1/labels" -f "labels[]=$refreshing_label" \
    >/dev/null 2>&1
}

# refresh_unmark <pr>: take tehas:refreshing off a pull request. A 404 says
# the label is not there, which is the state wanted, so it counts as done.
refresh_unmark() {
  local out
  out=$(gh api -X DELETE "repos/$repo/issues/$1/labels/$refreshing_label" 2>&1) && return 0
  [[ $out == *"Not Found"* ]]
}

# restore_record <issue>: take the approval this poll recorded off the record
# again. A start that gives up after recording it must leave what was there
# before: the approval of the issue's last start is still the one its readers
# count on, and no refresh is counted that never ran. The undo is safe to
# repeat, so a busy store is asked again. Returns 1 when the approval stays.
restore_record() {
  [ -n "${recorded_at[$1]:-}" ] || return 0
  tehas_store_try 3 approval-record "$1" --undo --at "${recorded_at[$1]}" && return 0
  log "WARN: could not take the approval of #$1 off the record ($tehas_store_word)"
  return 1
}

# park_unask <issue>: take the question of the issue's current park off the
# record, so its boxes answer for nothing that starts now. An issue with no
# park, or no question, has nothing to take. The id taken is left in
# park_unasked[<issue>] for park_reask. Returns 1 when the store could not do
# it, with its word.
declare -A park_unasked=()
park_unask() {
  local q
  park_unasked[$1]=""
  park_now=false
  tehas_store park-show "$1" || return 1
  [ "$(tehas_store_get '.park != null')" = true ] || return 0
  park_now=true
  q=$(tehas_store_get '.park.question // empty') || return 1
  [ -n "$q" ] || return 0
  if tehas_store question-answered "$1" --id "$q" --withdraw; then
    park_unasked[$1]=$q
    return 0
  fi
  [ "$tehas_store_word" = unknown ] && return 0
  local rc=$tehas_store_rc word=$tehas_store_word line=$tehas_store_line
  # A withdraw that timed out may have been done all the same: the question
  # goes back, which changes nothing when it never left.
  if [ "$word" = timeout ]; then
    park_unasked[$1]=$q
    park_reask "$1"
  fi
  tehas_store_said "$rc" "$word" "$line"
  return 1
}

# park_spend <issue>: once a start is marked, and before its unit is started,
# the one retry of the issue's current park is spent, so a unit that never
# comes up leaves no retry behind. A mark that fails spends nothing: the next
# poll still owes the retry. A store that does not spend it is a warning: the
# cycle's start makes a new attempt, and the old park is no longer current.
park_spend() {
  [ "$park_now" = true ] || return 0
  tehas_store_try 3 park-retry "$1" && return 0
  [ "$tehas_store_word" = unparked ] && return 0
  log "WARN: #$1: the retry of its park could not be spent ($tehas_store_word)"
}

# park_reask <issue>: a start given up after park_unask puts the question it
# took back on the record, so the tick in it still counts on the next poll.
park_reask() {
  local q=${park_unasked[$1]:-}
  [ -n "$q" ] || return 0
  park_unasked[$1]=""
  tehas_store_try 3 question-asked "$1" --id "$q" --kind park && return 0
  log "WARN: could not put the park question of #$1 back on the record ($tehas_store_word): its boxes start nothing now"
  return 1
}

# stop_unit <issue>: stop the issue's cycle unit and wait for it, so a unit
# that comes up late cannot use an approval left on record.
stop_unit() {
  if [ -n "${TEHAS_CYCLE_STOP_CMD:-}" ]; then
    timeout -k 5 30 "$TEHAS_CYCLE_STOP_CMD" "$1" 8>&-
  else
    timeout -k 5 30 systemctl --user stop "tehas-cycle@$1.service" 8>&-
  fi
}

# Without systemd's answer every picked issue would be marked running and then
# parked, at every poll. A shell without the user's bus gets none.
# units_ok <issue>: returns 1, with the reason logged. Call it before any
# label changes.
units_ok() {
  local loadstate
  [ -z "${TEHAS_CYCLE_START_CMD:-}" ] || return 0
  loadstate=$(systemctl --user show -p LoadState --value "tehas-cycle@$1.service" 2>/dev/null) || loadstate=""
  if [ "$loadstate" != loaded ]; then
    log "ERROR: systemd cannot load tehas-cycle@.service (LoadState: ${loadstate:-no answer}): run install.sh and its units step, and run tehas dispatch as the tehas user's own session"
    return 1
  fi
}

# start_cycle <issue> <attempt before>: 0 once the cycle's start is on record:
# an attempt later than the one read before the label. Looking at the lock
# would miss a cycle that ended within the wait, and a cycle that refused its
# number after its start still came up. The wait is by the clock: a store
# that is busy is asked again until it ends. One that cannot be used ends it,
# and the lock decides. The poll's own lock is not passed on: a cycle outlives
# the poll.
start_cycle() {
  local n=$1 before=$2 got deadline
  if [ -n "${TEHAS_CYCLE_START_CMD:-}" ]; then
    "$TEHAS_CYCLE_START_CMD" "$n" 8>&- || return 1
  else
    systemctl --user start "tehas-cycle@$n.service" 8>&- || return 1
  fi
  deadline=$((SECONDS + start_wait))
  while [ "$SECONDS" -lt "$deadline" ]; do
    if tehas_store cycle-show "$n"; then
      got=$(tehas_store_get '.cycle.attempt // 0')
      [[ $got =~ ^[0-9]{1,9}$ ]] && [ "$got" -gt "$before" ] && return 0
    elif [ "$tehas_store_word" != busy ] && [ "$tehas_store_word" != timeout ]; then
      break
    fi
    sleep 0.5
  done
  # A loaded host, or a unit still active from before, can start a cycle late.
  if tehas_cycle_running "$n"; then
    log "WARN: the cycle for #$n holds its lock but did not say so in ${start_wait}s; taking it as started"
    return 0
  fi
  return 1
}

# The agents search an index of the tree a cycle is cloned from. On a host
# where no cycle runs, it is refreshed before cycles start, as its own unit,
# tehas-index.service, and no poll waits for it: the poll that starts it ends
# there, and the unit's end asks for the next poll, which starts the cycles.
# No cycle starts while the index is written. A cycle without a fresh index
# still works, so a run that failed is a warning, and one that failed at this
# tip is not tried again by a poll. A cycle started while another runs gets
# the index as it is.
fetched=0
index_rc=$TEHAS_HOME/state/index.rc
index_log=$TEHAS_HOME/logs/dispatch-index.log

# index_gate: returns when cycles may start now, ends the poll when they wait
# for the index. Call it after units_ok and before anything changes for the
# issues a poll starts: a poll that ends here leaves them as they were.
index_gate() {
  local base
  if [ "$count" != 0 ]; then
    log "the code index stays as it is: a cycle is running on #${running// /, #}"
    return 0
  fi
  refresh_checkout
  fetched=1
  if index_busy; then
    log "holding: the cycles wait for the code index, which tehas-index.service is refreshing"
    exit 0
  fi
  index_report || true
  base=$(git -C "$checkout" rev-parse -q --verify "refs/remotes/origin/$branch^{commit}") || return 0
  [ "$(tehas_index_state "$base")" = due ] || return 0
  if ! index_launch; then
    log "WARN: the code index was not refreshed: tehas-index.service did not start"
    return 0
  fi
  # A launcher that ran the index to its end: the poll it asked for is this one.
  if index_report; then
    rm -f "$TEHAS_HOME/state/dispatch.again"
    return 0
  fi
  log "holding: the code index is refreshed first, as tehas-index.service; the cycles start on the poll after it"
  exit 0
}

# index_report: say how the last index run ended, once. Returns 1 when no run
# has ended since the last report.
index_report() {
  local rc
  [ -f "$index_rc" ] || return 1
  rc=$(head -c 8 "$index_rc" 2>/dev/null) || rc=""
  rm -f "$index_rc"
  [ "$rc" = 0 ] || log "WARN: the code index was not refreshed, see $index_log"
  return 0
}

# index_busy: 0 while an index run holds its lock, or its unit runs and has
# not taken the lock yet. A run that left its exit status has ended, though
# systemd may still show its unit for the instant it asks for this poll.
index_busy() {
  local state
  flock -n "$TEHAS_HOME/state/index.lock" true 8>&- || return 0
  [ ! -f "$index_rc" ] || return 1
  state=$(systemctl --user show -p ActiveState --value tehas-index.service 2>/dev/null) || return 1
  case "$state" in active | activating) return 0 ;; esac
  return 1
}

# index_launch: start tehas index --before-cycle as tehas-index.service and
# return. The unit writes the exit status to $index_rc and asks for a poll
# when it ends. Its limit is the indexer's, with room to clone and clean up.
index_launch() {
  # shellcheck disable=SC2016  # expanded by the shell the unit runs
  set -- /bin/bash -c 'log=$1 rc=$2 again=$3; shift 3; "$@" >>"$log" 2>&1; echo "$?" >"$rc.new" && mv "$rc.new" "$rc"; : >"$again"' \
    index-run "$index_log" "$index_rc" "$TEHAS_HOME/state/dispatch.again" "$index_cmd" --before-cycle
  rm -f "$index_rc"
  if [ -n "${TEHAS_INDEX_START_CMD:-}" ]; then
    "$TEHAS_INDEX_START_CMD" "$@" 8>&-
    return
  fi
  # shellcheck disable=SC2016  # expanded by the shell the unit runs
  systemd-run --user --quiet --collect --unit tehas-index -p RuntimeMaxSec=2400 \
    /bin/bash -c '[ ! -r "$HOME/tehas/env.sh" ] || . "$HOME/tehas/env.sh"; exec "$@"' env-sh "$@" 8>&- >/dev/null 2>&1
}

# start_cycles: start a cycle for every issue in $picked. Returns 1 when a
# start gave up. A start that gave up is cleaned up as it goes, and the issues
# after it in the queue are for the next poll: each caller ends the poll on
# this call, so a later step of a caller cannot act as the start had worked.
start_cycles() {
  local n failed=0 accepted before done_any=0
  local -a out
  [ "$fetched" = 1 ] || refresh_checkout

  for n in "${picked[@]}"; do
    log "start #$n (${verb[$n]} by ${starter[$n]})"
    read -ra out <<<"${drop[$n]}"
    # A refresh marks its pull request before its approval is recorded, so a
    # start that cannot mark it leaves no approval for tehas_refresh_count
    # to read as a refresh: the limit is not spent on starts that never were.
    # A mark a person cannot see is worse than no refresh: it tells them to
    # merge or push to a pull request a cycle is about to rewrite.
    if [ -n "${refresh_pr[$n]:-}" ] && ! refresh_mark "${refresh_pr[$n]}"; then
      log "ERROR: could not mark pull request #${refresh_pr[$n]} as refreshing, not starting a cycle"
      failed=1
      continue
    fi
    # The refresh request file goes only once the cycle has started, which is
    # what makes a start at all.
    if ! approved_record "$n"; then
      case $record_word in
        used)
          # This approval started a cycle already (A3): it starts no other.
          log "skip #$n: its approval of ${given_at[$n]:-now} started a cycle already"
          continue
          ;;
        "" | busy | timeout | conflict | input) ;;
        *)
          log "ERROR: the state store cannot be used, not starting a cycle for #$n: $tehas_store_line"
          [ "$done_any" = 1 ] || exit 78
          failed=1
          break
          ;;
      esac
      log "ERROR: could not write the approval record of #$n${record_word:+ ($record_word)}, not starting a cycle"
      failed=1
      continue
    fi
    # The attempt on record before the label: the start waited for is a later
    # one. A start that cannot know it changes nothing.
    if ! tehas_cycle_attempt "$n"; then
      log "ERROR: #$n: the store could not say which attempt is on record ($tehas_store_word), not starting a cycle"
      restore_record "$n"
      failed=1
      continue
    fi
    before=$tehas_cycle_attempt_is
    # The question of the park this start answers goes before the label: a
    # tick in it would start the issue again.
    if ! park_unask "$n"; then
      log "ERROR: #$n: the question of its park could not be taken off the record ($tehas_store_word), not starting a cycle"
      restore_record "$n"
      failed=1
      continue
    fi
    # In the factory's analytics: ready, at the time the approval was given,
    # and without one at all when GitHub named none. The program keeps the
    # first one of each issue. A failure is a warning.
    accepted=""
    case ${given_how[$n]} in
      refresh | outage-retry) accepted=${recorded_at[$n]} ;;
      *) [ -z "${given_at[$n]}" ] || accepted=${recorded_at[$n]} ;;
    esac
    tehas_analytics event "$n" ready ${accepted:+--at "$accepted"}
    # The cycle starts only once the issue is marked as taken. If the label
    # cannot be changed, the issue would stay in its queue and every later
    # poll would start the same issue again.
    if ! gh issue edit "$n" --repo "$repo" --add-label tehas:running "${out[@]}" >/dev/null 2>&1; then
      restore_record "$n"
      park_reask "$n"
      log "ERROR: could not mark #$n as running, not starting a cycle"
      failed=1
      continue
    fi
    done_any=1
    park_spend "$n"
    [ -z "${refresh_pr[$n]:-}" ] || rm -f "$(tehas_refresh_dir)/$n.json"
    if [ -n "${refresh_pr[$n]:-}" ]; then
      say "$n" "Tehas refresh started on \`$(hostname)\` at $(date -u +'%F %H:%M') UTC: ${refresh_url[$n]} conflicts with \`$(jq -r .branch <<<"${refresh_of[$n]}")\`. This cycle merges that branch into it, resolves the conflicts and pushes to the same pull request. It rests on @${starter[$n]}'s ${how[$n]}. This issue is owned by the cycle until \`tehas:running\` is removed."
    else
      say "$n" "Tehas cycle started on \`$(hostname)\` at $(date -u +'%F %H:%M') UTC (authorized by @${starter[$n]}'s ${how[$n]}). This issue is owned by the cycle until \`tehas:running\` is removed."
    fi
    if start_cycle "$n" "$before"; then
      tehas_analytics event "$n" started
    else
      # A unit that comes up after this finds its approval gone and runs
      # nothing. When the approval stays on record, the unit is stopped.
      if ! restore_record "$n" && ! stop_unit "$n" >/dev/null 2>&1; then
        log "WARN: could not stop tehas-cycle@$n.service: a late start may still use its approval"
      fi
      log "ERROR: the cycle for #$n did not start"
      gh issue edit "$n" --repo "$repo" --remove-label tehas:running --add-label needs-human-attention >/dev/null 2>&1 ||
        log "WARN: label change on #$n failed"
      say "$n" "Tehas could not start the cycle for this issue on \`$(hostname)\`: \`tehas-cycle@$n.service\` did not come up. See \`journalctl --user -u tehas-cycle@$n\` and \`~/tehas/logs/dispatch.log\` there. To retry, apply \`tehas:ready\`."
      failed=1
    fi
  done
  "$status_cmd"
  return "$failed"
}

# refresh_requests: the issues with a refresh request, lowest first. Only
# plain files named for an issue: nothing else in the directory is one.
refresh_requests() {
  local f n
  for f in "$(tehas_refresh_dir)"/*.json; do
    [ -f "$f" ] && [ ! -L "$f" ] || continue
    n=${f##*/}
    n=${n%.json}
    [[ $n =~ ^[1-9][0-9]{0,9}$ ]] && printf '%s\n' "$n"
  done | sort -n
}

# refresh_held: why no refresh may start on this host, empty when one may.
refresh_held() {
  if [ "$TEHAS_REFRESH_CONFLICTS" != 1 ]; then
    echo "TEHAS_REFRESH_CONFLICTS is not 1"
  elif ! tehas_refresh_continues; then
    echo "the pi-rukas in the sandbox image $PI_ENSEMBLE_IMAGE does not take --continue-pr"
  fi
}

# refresh_drop <issue> <why>: the request starts nothing and goes.
refresh_drop() {
  log "drop the refresh of #$1: $2"
  [ "$dry" = 1 ] || rm -f "$(tehas_refresh_dir)/$1.json"
}

# refresh_say <issue> <key> <text>: a hold a person can act on, said on the
# issue once for each key. The request goes: tehasbot refresh writes it again
# while the pull request conflicts, and it is said no more.
refresh_say() {
  local note
  note=$(tehas_refresh_dir)/$1.said
  refresh_drop "$1" "$3"
  [ "$dry" = 0 ] || return 0
  [ "$(head -c 200 "$note" 2>/dev/null)" != "$2" ] || return 0
  say "$1" "Tehas does not refresh this issue's pull request on its own: $3. It conflicts with the branch, and a person resolves it or applies \`tehas:ready\` to start a fresh cycle."
  printf '%s' "$2" >"$note" || log "WARN: could not write $note"
}

# refresh_ok <issue>: 0 when its refresh request starts a cycle now, with
# what the start needs set for it. Otherwise 1: the request waits, or goes
# with the reason logged (refresh_drop).
refresh_ok() {
  local n=$1 file req pr head base record rests by at have sum node why count b
  file=$(tehas_refresh_dir)/$n.json
  why=$(refresh_held)
  if [ -n "$why" ]; then
    # A real poll has said it in report_demand, once; a dry run says it here.
    [ "$refresh_said" = 1 ] || log "hold refreshes: $why"
    refresh_said=1
    return 1
  fi
  req=$(jq -c 'select(type == "object" and (.pr | type) == "number" and (.head_sha | strings | test("^[0-9a-f]{40}$"))
      and (.base_sha | strings | test("^[0-9a-f]{40}$")))' "$file" 2>/dev/null) || req=""
  [ -n "$req" ] || { refresh_drop "$n" "its request cannot be read"; return 1; }
  pr=$(jq -r .pr <<<"$req")
  head=$(jq -r .head_sha <<<"$req")
  base=$(jq -r .base_sha <<<"$req")
  if tehas_cycle_running "$n"; then refresh_drop "$n" "a cycle runs on it"; return 1; fi
  # A list that could not be read is no reason to drop the request.
  if ! plan_sessions; then log "wait #$n: the open planning sessions could not be read ($plan_open_word)"; return 1; fi
  if plan_open "$n"; then refresh_drop "$n" "a planning session is open on it"; return 1; fi
  work_ok "$n" || { refresh_drop "$n" "it is not an open issue"; return 1; }
  have=" $(jq -r '[(.labels // [])[].name] | join(" ")' <<<"${work_answer[$n]}") "
  [[ $have == *" tehas:awaiting-merge "* || $have == *" needs-human-attention "* ]] ||
    { refresh_drop "$n" "it carries neither tehas:awaiting-merge nor needs-human-attention"; return 1; }
  # On a handed-off issue tehas:ready asks for a fresh cycle, which rule 6
  # starts: a refresh must not take its place.
  [[ $have != *" needs-human-attention "* || $have != *" tehas:ready "* ]] ||
    { refresh_drop "$n" "it was handed off and carries tehas:ready"; return 1; }
  for l in tehas:running tehas:question tehas:fixer-escalated tehas:plan tehas:planning; do
    [[ $have != *" $l "* ]] || { refresh_drop "$n" "it carries $l"; return 1; }
  done
  # The person whose approval the pull request's cycle rests on, and the
  # starts counted on it, from the approval of the issue's latest start. An
  # approval that cannot be read decides nothing: the request waits.
  record=$(tehas_approval_view "$n")
  case $? in
    0) ;;
    1)
      refresh_drop "$n" "this host has no approval of a person's that its pull request rests on"
      return 1
      ;;
    *)
      log "wait #$n: its approval could not be read"
      return 1
      ;;
  esac
  rests=$(tehas_millwright_base "$record") || rests=""
  count=$(tehas_refresh_count "$record" "${rests:-null}") || count=""
  rm -f "$record"
  [ -n "$rests" ] ||
    { refresh_drop "$n" "this host has no approval of a person's that its pull request rests on"; return 1; }
  by=$(jq -r .by <<<"$rests")
  at=$(jq -r .at <<<"$rests")
  issue_events "$n"
  unchanged_since "$n" "$at" "$by approved it" "a person applies tehas:ready" ||
    { refresh_drop "$n" "its title or text was changed since $by approved it"; return 1; }
  sum=$(jq '.data.repository.issue // {}' <<<"${text_of[$n]}" | tehas_body_sha256) ||
    { log "ERROR: the text of #$n could not be read for its hash"; exit 1; }
  [ "$sum" = "$(jq -r .body_sha256 <<<"$rests")" ] ||
    { refresh_drop "$n" "its text is not the text $by approved"; return 1; }
  # The pull request as GitHub has it now. A person who pushed to it since
  # the request is handling it.
  gh_json api graphql -F owner="${repo%%/*}" -F name="${repo##*/}" -F number="$pr" -f query="$(tehas_refresh_pr_query)"
  node=$(jq -c '.data.repository.pullRequest | objects' <<<"$json" 2>/dev/null) || node=""
  [ -n "$node" ] || { refresh_drop "$n" "pull request #$pr cannot be read"; return 1; }
  why=$(jq -r --arg bot "$bot" --arg repo "$repo" --argjson control "$control" --argjson n "$n" --arg head "$head" "$(tehas_refresh_rule)"'
    if .state != "OPEN" then "pull request #\(.number) is not open"
    elif refresh_why != "" then "pull request #\(.number): \(refresh_why)"
    elif .closingIssuesReferences.nodes[0].number != $n then "pull request #\(.number) does not close #\($n)"
    elif .headRefOid != $head then "pull request #\(.number) moved since the request"
    elif .mergeable == "UNKNOWN" then "wait"
    elif .mergeable != "CONFLICTING" then "pull request #\(.number) no longer conflicts"
    elif [(.labels.nodes // [])[]?.name] | index("tehas:refreshing") then "busy"
    else "" end' <<<"$node" 2>/dev/null) || why="pull request #$pr cannot be read"
  case "$why" in
    "") ;;
    wait) log "wait #$n: GitHub has not said yet whether pull request #$pr conflicts"; return 1 ;;
    busy) log "wait #$n: pull request #$pr carries tehas:refreshing"; return 1 ;;
    *) refresh_drop "$n" "$why"; return 1 ;;
  esac
  [[ $count =~ ^[0-9]{1,6}$ ]] ||
    { refresh_drop "$n" "its approval record does not say how many refreshes there were"; return 1; }
  if [ "$count" -ge "$TEHAS_REFRESH_MAX" ]; then
    refresh_say "$n" "cap $at $count" "it was refreshed $count times since $by approved it, the limit"
    return 1
  fi
  tehas_refresh_parked "$n" "$rests"
  case $? in
    0)
      refresh_say "$n" "park $at" "a refresh of it since $by approved it parked"
      return 1
      ;;
    2)
      log "wait #$n: its history could not be read"
      return 1
      ;;
  esac
  image_ok "$n" || return 1
  image_missing_ok "$n" || return 1
  b=$(jq -r '.baseRefName | strings' <<<"$node" | tr -cd 'A-Za-z0-9._/-')
  starter[$n]=$by
  verb[$n]=refresh
  how[$n]="approval of $at"
  given_at[$n]=$at
  given_how[$n]=refresh
  refresh_pr[$n]=$pr
  refresh_url[$n]=$(jq -r '.url | strings | select(test("^https://[A-Za-z0-9./_-]+$"))' <<<"$node")
  refresh_of[$n]=$(jq -n -c --argjson pr "$pr" --arg head "$head" --arg base "$base" --arg branch "${b:-$branch}" \
    '{$pr, head_sha: $head, base_sha: $base, $branch}')
  drop[$n]=""
  [[ $have != *" tehas:awaiting-merge "* ]] || drop[$n]="--remove-label tehas:awaiting-merge"
  [[ $have != *" tehas:ready "* ]] || drop[$n]+=" --remove-label tehas:ready"
}

# park_holds <issue>: does this issue's park hold a fresh tehas:ready back?
# The current park of its last cycle names the body that cycle ran on: the one
# its start's approval bound, as the store has it. The same text now, on a park
# that was no provider outage and that no start has spent, is the same ask the
# cycle already spent, so the poll starts nothing and says the reason in its
# log. A park of an outage is held by rule 4a's own rules, not here; a park
# that names no body (a run by hand) holds nothing. The comment is the one
# thing kept off the loop of polls: the park then says it has told
# (park-told), and the log carries the hold after it. Called once an issue is
# picked, where the text of the issue is the answer unchanged_since passed it,
# so no read of GitHub is spent on an issue this would hold in any case. A park
# that could not be read holds the issue for this poll. Returns 0 when the
# issue is held.
park_holds() {
  local n=$1 sum told cap now
  [ -n "${text_of[$n]:-}" ] || return 1
  if ! tehas_store park-show "$n"; then
    if [ "$tehas_store_rc" = 1 ]; then
      log "skip #$n: its park on record could not be read ($tehas_store_word)"
      return 0
    fi
    log "ERROR: the state store cannot be used: $tehas_store_line"
    exit 78
  fi
  read -r sum told cap < <(tehas_store_get '.park
    | select(. != null and .reason != "provider-outage" and .retries == 0
        and ((.body_sha256 | type) == "string") and (.body_sha256 | test("^[0-9a-f]{64}$")))
    | [.body_sha256, (.told_at != null), .reason] | map(tostring) | join(" ")')
  [ -n "${sum:-}" ] || return 1
  now=$(jq '.data.repository.issue // {}' <<<"${text_of[$n]}" | tehas_body_sha256 2>/dev/null) || now=""
  [[ $now =~ ^[0-9a-f]{64}$ ]] || return 1
  [ "$now" = "$sum" ] || return 1
  if [ "$told" != true ] && [ "$dry" = 0 ]; then
    say "$n" "Not started: the last cycle parked on \`${cap:-nothing}\` and the issue text has not changed since. Edit the body, or tick Retry in the park comment."
    # The record of the tell follows the comment: a park nobody was told about
    # has not told, and the next poll tells it. With no record the poll tells it
    # again, once more than the once asked for, and says so.
    tehas_store park-told "$n" || log "WARN: could not record the hold on the park of #$n ($tehas_store_word)"
  fi
  log "hold #$n: its last cycle parked on ${cap:-nothing} and the body has not changed since"
  return 0
}

# report_demand: write live/demand.json for tehas status, {time, waiting,
# oldest}: how many open issues would start if there were room, and when the
# oldest of them was accepted. That is a tehas:ready applied last by an
# allowed account or the fixer, on an issue with no cycle and no planning
# session open. It is written on every poll that gets this far, a paused one
# too. It is a report and decides nothing: its reads are its own, kept out of
# what a start rests on, and a read that fails removes the file and ends
# nothing.
refresh_said=0
report_demand() {
  local file=$TEHAS_HOME/live/demand.json list n ev line by at waiting=0 oldest="" held
  if ! list=$(gh issue list --repo "$repo" --state open --label tehas:ready --limit 1000 --json number,labels 2>/dev/null) ||
    ! list=$(jq -r '.[] | select((.labels // []) | any(.name == "tehas:running") | not) | .number | tonumber? // empty' <<<"$list" 2>/dev/null); then
    rm -f "$file"
    return 0
  fi
  for n in $list; do
    [ "$n" = "$control" ] && continue
    if plan_open "$n" || tehas_cycle_running "$n"; then continue; fi
    if ! ev=$(gh api "repos/$repo/issues/$n/events?per_page=100" --paginate 2>/dev/null) ||
      ! line=$(tehas_label_actor tehas:ready <<<"$ev"); then
      rm -f "$file"
      return 0
    fi
    by=${line%%$'\t'*}
    at=${line#*$'\t'}
    tehas_allowed_labeler "$by" || tehas_millwright_is "$by" || continue
    waiting=$((waiting + 1))
    if [ -n "$at" ] && { [ -z "$oldest" ] || [[ $at < $oldest ]]; }; then oldest=$at; fi
  done
  # A refresh request waits as a ready issue does, unless refreshes are held.
  # The hold is in the file for tehas status, and the log has it once.
  held=""
  list=$(refresh_requests)
  if [ -n "$list" ]; then
    held=$(refresh_held)
    if [ "$(head -c 300 "$(tehas_refresh_dir)/.held" 2>/dev/null)" != "$held" ]; then
      if [ -n "$held" ]; then
        log "hold refreshes: $held"
        printf '%s' "$held" >"$(tehas_refresh_dir)/.held" || log "WARN: could not write $(tehas_refresh_dir)/.held"
      else
        rm -f "$(tehas_refresh_dir)/.held"
      fi
    fi
    refresh_said=1
  else
    rm -f "$(tehas_refresh_dir)/.held"
  fi
  if [ -z "$held" ]; then
    for n in $list; do
      if plan_open "$n" || tehas_cycle_running "$n"; then continue; fi
      at=$(jq -r '.at | strings' "$(tehas_refresh_dir)/$n.json" 2>/dev/null) || at=""
      waiting=$((waiting + 1))
      if [ -n "$at" ] && { [ -z "$oldest" ] || [[ $at < $oldest ]]; }; then oldest=$at; fi
    done
  fi
  if jq -n --arg time "$(date -u +%FT%TZ)" --argjson waiting "$waiting" --arg oldest "$oldest" --arg held "$held" \
    '{$time, $waiting} + (if $oldest == "" then {} else {$oldest} end) + (if $held == "" then {} else {refreshHold: $held} end)' >"$file.new" 2>/dev/null; then
    mv "$file.new" "$file" || log "WARN: could not write $file"
  else
    rm -f "$file.new"
    log "WARN: could not write $file"
  fi
}

[ "$dry" = 0 ] && "$status_cmd"

# 1. Pause switches: what this poll may start. This host's flag is read first,
# before this poll asks GitHub anything: a host can be paused when GitHub does
# not answer. A flag that cannot be read or understood is a closed switch, never
# an absent one. The decision is taken here and acted on below, after the rules
# that stop cycles and clear marks: a paused factory still gives up the work it
# has finished.
pause_holds=""  # why this poll starts nothing; empty when nothing holds it
pause_news=0    # 1 when the reason is news, worth a line on a poll as well as a dry run
pause_flag=$(tehas_pause_read "$TEHAS_HOME/state/pause.json")
case $? in
  0) pause_holds="the flag tehas pause wrote at $(jq -r .at <<<"$pause_flag") holds this host" ;;
  2)
    log "WARN: $TEHAS_HOME/state/pause.json is not a pause flag: taking it as paused"
    pause_holds="the pause flag is there and cannot be read"
    ;;
esac

# The repository must still answer to its configured name. After a rename
# GitHub redirects some calls and answers others with an empty list, so the
# queue would look empty for ever with no error.
gh_json repo view "$repo" --json nameWithOwner
actual=$(jq -r '.nameWithOwner // ""' <<<"$json") || actual=""
if [ "${actual,,}" != "${repo,,}" ]; then
  log "ERROR: $repo is now ${actual:-unknown} on GitHub: set TEHAS_REPO in $TEHAS_INSTANCE_DIR/instance.env and the checkout's origin"
  exit 1
fi

# The bot's own login, read once for every poll before a label is read or
# changed and before an answer is read. Everything a cycle writes, it writes as
# the bot: a list that names the bot would let an agent approve its own work by
# labelling. A login that cannot be read ends the poll for the same reason:
# nothing below could be checked against the allowed list.
# A GitHub App's token cannot ask GET /user, so an app's login is the setting.
if [ -n "${TEHAS_BOT_LOGIN:-}" ]; then
  bot=$TEHAS_BOT_LOGIN
else
  gh_json api user
  bot=$(jq -r '.login // ""' <<<"$json") || bot=""
fi
[ -n "$bot" ] || { log "ERROR: the bot's own login could not be read"; exit 1; }
if tehas_allowed_labeler "$bot"; then
  log "ERROR: the bot account $bot is in TEHAS_ALLOWED_LABELERS; the bot never authorises work"
  exit 78
fi
if tehas_millwright_is "$bot"; then
  log "ERROR: the bot account $bot is TEHAS_MILLWRIGHT_LOGIN; every agent posts as the bot, so the millwright must be an account of its own"
  exit 78
fi
# Closed issues lose tehas's state labels once a poll, after the rest of it,
# however it ends: the trap above runs libexec/tidy from here on.
tidy_on=1

# The open planning sessions, read once before the poll acts: an open session
# holds its issue out of every start (plan_open). A list that cannot be read
# ends the poll. Read again after a planning write of this poll, a list that
# cannot be read then holds every issue (lib/planning.sh).
plan_sessions_must() {
  plan_sessions && return 0
  log "ERROR: the state store could not list the open planning sessions ($tehas_store_word)"
  [ "$tehas_store_rc" = 1 ] && exit 1
  exit 78
}
plan_sessions_must

# The demand is read from a repository that answers to its name, and the
# health file the snapshot above wrote is written again with it.
if [ "$dry" = 0 ]; then
  report_demand
  "$here/health" || log "WARN: the health file could not be written"
fi

# The label, when the flag has not already decided: it asks GitHub, so it comes
# after the checks that need a working repository. Stopping is the safe
# direction, so anyone with write access may do it. Starting again is the
# direction that needs authority, as tehas:ready does: it takes an account from
# TEHAS_ALLOWED_LABELERS. A pause applied by anyone else therefore holds this
# host until an allowed account lifts it, and a cycle cannot let itself out of
# it.
if [ -z "$pause_holds" ]; then
  gh_json issue view "$control" --repo "$repo" --json labels
  paused=$(jq -r '.labels | any(.name == "tehas:pause")' <<<"$json") || { log "ERROR: unreadable answer for issue #$control"; exit 1; }
  if [ "$paused" != false ]; then
    pause_holds="issue #$control carries tehas:pause"
  else
    # The label is off. Whether anything took it off, and who, decides.
    issue_events "$control"
    pause_event=$(tehas_pause_holds <<<"$events")
    case $? in
      0)
        pause_news=1
        pause_kind=${pause_event%%$'\t'*}
        pause_by=${pause_event#*$'\t'}
        if [ "$pause_kind" = unlabeled ]; then
          pause_holds="tehas:pause was taken off #$control by '${pause_by:-unknown}', who may not authorise work here; the factory stays paused until an allowed account applies tehas:pause and takes it off again"
        else
          # The label is gone and no event took it off: the label object was
          # deleted or renamed. No account was asked to lift the pause.
          pause_holds="tehas:pause is not on #$control, but its last tehas:pause event only applied it: nothing has taken the pause off"
        fi
        ;;
      2) log "ERROR: unreadable label events of #$control"; exit 1 ;;
    esac
    # The events of the control issue are not those of any other issue.
    events=""
    events_for=""
  fi
fi

# A cycle that holds its lock but has not been heard from for 20 minutes is
# stuck: a tehas work that hangs after its container ended, say. It would hold
# its slot and its reserve until a person stopped it, so its unit is stopped.
# tehas work records a heartbeat every 10 seconds from the host, also through
# a long gate in the container (cycle-heartbeat; cycle-show answers the newest
# as heard_at). A cycle that took its lock lately counts as heard from.
#
# The state store keeps such an episode said once. Its whole rule is here, and
# nowhere else:
#   the episode  is the time the cycle was last heard from: cycle-note keeps one
#                per cycle, a later time is a new episode, and the cycle's next
#                start removes it. It says how many times the poll has asked in
#                this episode, and when it last asked or said.
#   an ask       is recorded with cycle-stop-asked before the stop is asked,
#                whether or not the stop then works, so a slow stop does not
#                move the next ask. systemctl --no-block answers as soon as it
#                accepts the stop job, so the record means the stop was asked,
#                not that the unit stopped; what ends a unit that ignores the
#                job is the unit's own TimeoutStopSec and RuntimeMaxSec.
#   re-asked     at most once per quiet_retry, up to quiet_asks asks. After that
#                the poll says the episode is a person's and asks no more, so
#                one unit whose stop never completes cannot put a 35s wait in
#                front of every cycle start on every poll. The first time it
#                says so is recorded as one more (quiet_asks + 1), which is how
#                a later poll tells it from the last ask; after that the line is
#                said once per quiet_retry * quiet_asks (--said-only). The
#                store dates a record by its own clock, a moment after the
#                poll's: each wait is one second short, so a record that
#                crossed a second does not put the next ask off a whole poll.
# A poll that cannot record the episode asks nothing. A cycle with no open
# record is not the poll's to stop: it may be starting, or reporting after its
# end. While it stays quiet, every poll says so, for a person to stop it. A
# store that cannot be used ends the poll.
quiet_bound=1200 quiet_retry=600 quiet_asks=6

# quiet_due <times> <asked>: what the poll does now about an episode it has
# asked about <times> times, last at <asked>: stop, wait, again or line.
quiet_due() {
  local next=$(($2 + quiet_retry))
  [ "$1" -le "$quiet_asks" ] || next=$(($2 + quiet_retry * quiet_asks))
  if [ "$1" = 0 ]; then
    echo stop
  elif [ "$now" -lt $((next - 1)) ]; then
    echo wait
  elif [ "$1" -lt "$quiet_asks" ]; then
    echo again
  else
    echo line
  fi
}

# After a store call the quiet loop could not use: a refusal, busy or a
# timeout (1) is the caller's to say; anything else ends the poll.
quiet_store_usable() {
  [ "$tehas_store_rc" = 1 ] && return 0
  log "ERROR: the state store cannot be used: $tehas_store_line"
  exit 78
}

# When each running cycle started, as the state store has it: read once a
# poll, the first time a loop below needs it, into took_at. A lock held with
# no open row on record is 0. When it was last heard from goes in heard_at,
# also for a record that has ended: a refused or stopped end records no
# heartbeat. A list that cannot be read ends the poll before
# it acts on any cycle.
# How each started is kept beside it in took_how, for the refresh scan, and
# its quiet episode in quiet_for, quiet_at, quiet_asked and quiet_times, for a
# dry run to say what the poll would do.
declare -A took_at=() took_how=() quiet_for=() quiet_at=() quiet_asked=() quiet_times=() heard_at=()
took_read=0
running_starts() {
  local line
  [ "$took_read" = 0 ] || return 0
  if ! tehas_store cycle-show --running; then
    log "ERROR: the state store could not list the running cycles ($tehas_store_word)"
    [ "$tehas_store_rc" = 1 ] && exit 1
    exit 78
  fi
  while read -r line; do
    [[ $line =~ ^([1-9][0-9]{0,9})\ ([0-9]{1,12})\ ([a-z-]*)\ ([A-Za-z0-9_.:-]{1,64})\ ([0-9]{1,12})\ ([0-9]{1,12})\ ([0-9]{1,6})\ ([0-9]{1,12})$ ]] || continue
    took_at[${BASH_REMATCH[1]}]=${BASH_REMATCH[2]}
    took_how[${BASH_REMATCH[1]}]=${BASH_REMATCH[3]}
    quiet_for[${BASH_REMATCH[1]}]=${BASH_REMATCH[4]}
    quiet_at[${BASH_REMATCH[1]}]=${BASH_REMATCH[5]}
    quiet_asked[${BASH_REMATCH[1]}]=${BASH_REMATCH[6]}
    quiet_times[${BASH_REMATCH[1]}]=${BASH_REMATCH[7]}
    heard_at[${BASH_REMATCH[1]}]=${BASH_REMATCH[8]}
  done < <(tehas_store_get '.cycles[] | "\(.issue) \(.cycle
    | if . != null and .ended_at == null
      then "\(.started_at) \(.how) \(.quiet.said_for // "-") \(.quiet.at // 0) \(.stop_asked_at // 0) \(.stop_said_times // 0) \(.heard_at // 0)"
      else "0  - 0 0 0 \(if . == null then 0 else .heard_at // 0 end)" end)"')
  took_read=1
}

quiet_running=$(tehas_cycles_running)
[ -z "$quiet_running" ] || running_starts
for n in $quiet_running; do
  now=$EPOCHSECONDS
  heard=${heard_at[$n]:-0}
  took=${took_at[$n]:-0}
  [ "$took" -le "$heard" ] || heard=$took
  if [ "$heard" = 0 ]; then
    # Nothing is known about this cycle: neither a heartbeat nor its start
    # on record could be read. Nothing is said or recorded.
    continue
  fi
  # Heard from: no episode outstanding. One on record stays until the next
  # episode or the next start replaces it.
  [ $((now - heard)) -gt "$quiet_bound" ] || continue
  why="the cycle for #$n holds its lock but has not been heard from since $(date -u -d "@$heard" +%FT%TZ), more than ${quiet_bound}s"
  norecord="WARN: $why, and the state store has no open record of it, so the poll does not stop it: if it stays, a person can, with tehas stop $n or systemctl --user stop tehas-cycle@$n.service"
  if [ "$took" = 0 ]; then
    log "$norecord"
    continue
  fi
  if [ "$dry" = 1 ]; then
    asks=0 asked=${quiet_asked[$n]:-0}
    if [ "${quiet_for[$n]:-}" = "$heard" ] && [ "$asked" -ge "${quiet_at[$n]:-0}" ]; then
      asks=${quiet_times[$n]:-0}
    fi
    case $(quiet_due "$asks" "$asked") in
      stop) log "would stop tehas-cycle@$n.service: $why" ;;
      again) log "would ask tehas-cycle@$n.service to stop again: $why" ;;
      line) log "would say that tehas-cycle@$n.service needs a person and ask no more: $why" ;;
    esac
    continue
  fi
  if ! tehas_store cycle-note "$n" --kind quiet --said-for "$heard"; then
    quiet_store_usable
    case $tehas_store_word in
      ended | nocycle) log "$norecord" ;;
      *) log "WARN: $why, but the state store could not record it ($tehas_store_word), so the poll asks nothing this time" ;;
    esac
    continue
  fi
  asks=$(tehas_store_get '.times') || asks=""
  asked=$(tehas_store_get '.stop_asked_at // 0') || asked=""
  if ! [[ $asks =~ ^[0-9]{1,6}$ ]] || ! [[ $asked =~ ^[0-9]{1,12}$ ]]; then
    log "WARN: $why, but the state store's record of it does not read as one, so the poll asks nothing this time"
    continue
  fi
  case $(quiet_due "$asks" "$asked") in
    wait) continue ;;
    stop) log "WARN: $why: stopping tehas-cycle@$n.service" ;;
    again) log "WARN: $why: the poll asks tehas-cycle@$n.service to stop again" ;;
    line)
      log "WARN: $why: the poll asked ${quiet_asks} times to stop tehas-cycle@$n.service and asks no more: it needs a person, who can stop it with systemctl --user stop tehas-cycle@$n.service"
      only=()
      [ "$asks" = "$quiet_asks" ] || only=(--said-only)
      if ! tehas_store cycle-stop-asked "$n" "${only[@]}"; then
        quiet_store_usable
        log "WARN: the state store did not record that the poll asks no more of tehas-cycle@$n.service ($tehas_store_word)"
      fi
      continue
      ;;
  esac
  if ! tehas_store cycle-stop-asked "$n"; then
    quiet_store_usable
    log "WARN: the state store did not record the stop of tehas-cycle@$n.service ($tehas_store_word): the poll asks again"
  fi
  # Without waiting for it: the cycle reports as it stops, and the poll holds
  # its lock meanwhile.
  rc=0
  if [ -n "${TEHAS_CYCLE_STOP_CMD:-}" ]; then
    timeout -k 5 30 "$TEHAS_CYCLE_STOP_CMD" "$n" 8>&- || rc=$?
  else
    timeout -k 5 30 systemctl --user --no-block stop "tehas-cycle@$n.service" 8>&- || rc=$?
  fi
  [ "$rc" = 0 ] ||
    log "WARN: could not stop tehas-cycle@$n.service (exit $rc): it holds its slot, and the poll asks again"
done

# A cycle whose work is done holds its slot for nothing: its issue is closed,
# or the bot's pull request for it is merged or closed, and the cycle may
# still be reviewing for hours. Only a pull request opened since the cycle
# took its lock is its own: one of an earlier cycle of the issue says nothing
# about this one. The cycle is told why in <issue>.done before its unit is
# stopped, and reports as any stopped cycle does. The poll waits for the
# lock, so the slot counts as free below.
done_wait=${TEHAS_CYCLE_DONE_WAIT:-330}
running=$(tehas_cycles_running)
if [ -n "$running" ]; then
  running_starts
  gh_json pr list --repo "$repo" --author "$bot" --state all --json url,state,body,headRefName,createdAt --limit 100
  bot_prs=$json
  jq -e 'type == "array"' >/dev/null 2>&1 <<<"$bot_prs" || { log "ERROR: unreadable list of the bot's pull requests"; exit 1; }
fi
for n in $running; do
  took=${took_at[$n]:-0}
  [ "$took" != 0 ] || continue
  gh_json api "repos/$repo/issues/$n"
  if [ "$(jq -r '.state // "" | ascii_downcase' <<<"$json")" = closed ]; then
    done_why=closed
    done_text="its issue is closed"
  else
    # The newest of this cycle's pull requests decides: one it closed itself
    # and opened again is still open work.
    line=$(jq -r --arg n "$n" --arg since "$(date -u -d "@$took" +%FT%TZ)" "$(tehas_names_issue)"'
      [.[] | select(type == "object" and ((.createdAt // "") | strings) >= $since) | select(mine)]
      | sort_by(.createdAt) | last // {} | "\(.state // "")\t\(.url // "" | strings | select(test("^https://[A-Za-z0-9./_-]+$")) // "")"' <<<"$bot_prs") ||
      { log "ERROR: unreadable list of the bot's pull requests"; exit 1; }
    case "${line%%$'\t'*}" in
      MERGED) done_why=merged done_text="its pull request ${line#*$'\t'} is merged" ;;
      CLOSED) done_why=pr-closed done_text="its pull request ${line#*$'\t'} was closed without a merge" ;;
      *) continue ;;
    esac
  fi
  if [ "$dry" = 1 ]; then
    log "would stop tehas-cycle@$n.service: $done_text"
    continue
  fi
  log "stop #$n: $done_text"
  echo "$done_why" >"$TEHAS_HOME/state/cycles/$n.done" || log "WARN: could not write the reason for #$n"
  if [ -n "${TEHAS_CYCLE_STOP_CMD:-}" ]; then
    timeout -k 5 "$done_wait" "$TEHAS_CYCLE_STOP_CMD" "$n" 8>&-
  else
    timeout -k 5 "$done_wait" systemctl --user stop "tehas-cycle@$n.service" 8>&-
  fi || log "WARN: could not stop tehas-cycle@$n.service"
  for ((i = 0; i < 20; i++)); do
    tehas_cycle_running "$n" || break
    sleep 0.5
  done
  ! tehas_cycle_running "$n" || log "WARN: the cycle for #$n still holds its lock after its stop"
done

# 2. The slots. A cycle that died holds no lock and is not counted.
running=$(tehas_cycles_running | tr '\n' ' ')
running=${running% }
count=$(wc -w <<<"$running")
count=$((count))
# The refresh lane: $cycles is what counts against TEHAS_TICKET_CONCURRENCY,
# $lane the lane's free slots, empty without a lane. The limit, the slice and
# the review cap still count every container.
cycles=$count
lane=""
if [ "$TEHAS_REFRESH_CONFLICTS" = 1 ] && [ "$TEHAS_REFRESH_SLOTS" -gt 0 ]; then
  refreshing=0
  [ -z "$running" ] || running_starts
  for n in $running; do
    [ "${took_how[$n]:-}" != refresh ] || refreshing=$((refreshing + 1))
  done
  cycles=$((count - refreshing))
  lane=$((TEHAS_REFRESH_SLOTS - refreshing))
  [ "$lane" -ge 0 ] || lane=0
fi
free=$((TEHAS_TICKET_CONCURRENCY - cycles))

# The limit tehas limit sets, read on every poll that gets this far: the room
# under its cap of cycles, empty without a limit. One that expired or cannot
# be read holds every start, a planning turn and an answer included, and never
# counts as no limit. It holds starts only: rules 2 and 3 still clean up.
limit=$(tehas_limit_read)
limit_state=$(jq -r .state <<<"$limit")
limit_room=""
case "$limit_state" in
  ok)
    limit_room=$(($(jq -r .cycles <<<"$limit") - count))
    [ "$limit_room" -ge 0 ] || limit_room=0
    ;;
  expired | unreadable) limit_room=0 ;;
esac
limit_reason=$(jq -r '.reason // ""' <<<"$limit")
limit_cycles() { # the cap as words: "1 cycle", "3 cycles"
  local n
  n=$(jq -r .cycles <<<"$limit")
  if [ "$n" = 1 ]; then echo "1 cycle"; else echo "$n cycles"; fi
}
# limit_ok: the limit lets anything start. limit_plan_ok: a new planning turn too.
limit_ok() { [ "$limit_state" != expired ] && [ "$limit_state" != unreadable ]; }
limit_plan_ok() { limit_ok && [ "$(jq -r .plan <<<"$limit")" != false ]; }

# reap <container> <why>: remove a container whose command is gone. Its
# client died, so nothing else stops it: it would work on with the bot's
# token, count in the slice, and the next start under its name would fail.
reap() {
  local gone
  gone=$(docker rm -f "$1" 2>/dev/null) || gone=""
  [ -z "$gone" ] || log "removed the container $1: $2"
}

# A cycle that was killed, or whose last label change GitHub refused, leaves
# its issue marked as running. No rule below would look at it again. The
# comment follows the label change only: while the change fails, the next poll
# finds the issue again and must not say the same once more. A container of
# that issue is left only by a cycle whose client died, and goes.
gh_json issue list --repo "$repo" --state all --label tehas:running --limit 1000 --json number,state
marked_json=$json
marked=$(jq -r 'map(.number) | sort | .[]' <<<"$marked_json") || { log "ERROR: unreadable list of issues marked as running"; exit 1; }
for n in $marked; do
  ! tehas_cycle_running "$n" || continue
  [ "$dry" = 1 ] || reap "tehas-work-$n" "no cycle holds the lock of #$n"
  # A closed issue is nobody's to retry: the mark goes and nothing is said.
  if [ "$(jq -r --argjson n "$n" '.[] | select(.number == $n) | .state // "OPEN"' <<<"$marked_json")" = CLOSED ]; then
    if [ "$dry" = 1 ]; then
      log "would clear #$n: it is closed, marked tehas:running, and no cycle holds its lock"
      continue
    fi
    log "clear #$n: it is closed, marked tehas:running, and no cycle holds its lock"
    gh issue edit "$n" --repo "$repo" --remove-label tehas:running >/dev/null 2>&1 || log "WARN: label change on #$n failed"
    continue
  fi
  # The list was read before this loop. A cycle that ended since has taken
  # tehas:running off and said how it ended: parking it now would be false.
  gh_json api "repos/$repo/issues/$n"
  still=$(jq -r '(.labels // []) | any(.name == "tehas:running")' <<<"$json") ||
    { log "ERROR: GitHub's answer for #$n could not be read"; exit 1; }
  if [ "$still" != true ]; then
    log "skip #$n: tehas:running is gone from it since the list was read"
    continue
  fi
  if [ "$dry" = 1 ]; then
    log "would park #$n: it is marked tehas:running and no cycle holds its lock"
    continue
  fi
  log "park #$n: it is marked tehas:running and no cycle holds its lock"
  if gh issue edit "$n" --repo "$repo" --remove-label tehas:running --add-label needs-human-attention >/dev/null 2>&1; then
    say "$n" "Tehas found this issue marked \`tehas:running\` with no cycle behind it on \`$(hostname)\`: the cycle ended without changing the label, or never started. Look for a pull request it may have opened. The run log is \`~/tehas/logs/dispatch-work-$n.log\` there. To retry, apply \`tehas:ready\`. If it is on the issue already, nothing more is needed."
  else
    log "WARN: label change on #$n failed"
  fi
done

# A pull request marked tehas:refreshing whose refresh is not running: its
# issue has no cycle, or no refresh of this host names it, or the bot did not
# apply the label. Left in place it tells a person not to merge a pull request
# nobody works on. Asked where refreshes are on, or a refresh was ever started
# here: a host that never refreshed has no such mark of its own to clear.
# The issues a refresh of this host may own: those with a refresh in their
# history, and those whose running cycle is one. The owner of a pull request is
# the one whose latest start is a refresh of it. A record that cannot be read
# clears nothing this poll: a mark is never taken off on a guess.
refreshing=""
refresh_from=""
declare -A refresh_owner=()
if tehas_store history-show --kind cycle --how refresh; then
  refresh_from=$(tehas_store_get '[.rows[].issue] | unique | .[]')
  # The running cycles, as the loops above read them where any runs.
  for n in "${!took_how[@]}"; do
    [ "${took_how[$n]}" != refresh ] || refresh_from+=$'\n'"$n"
  done
  refresh_from=$(sort -nu <<<"$refresh_from")
  if [ "$TEHAS_REFRESH_CONFLICTS" = 1 ] || [ -n "$refresh_from" ]; then
    gh_json pr list --repo "$repo" --state open --label tehas:refreshing --limit 1000 --json number,labels
    refreshing=$(jq -r '.[] | select((.labels // []) | any(.name == "tehas:refreshing")) | .number | numbers' <<<"$json") ||
      { log "ERROR: unreadable list of pull requests marked as refreshing"; exit 1; }
  fi
  if [ -n "$refreshing" ]; then
    for n in $refresh_from; do
      if ! tehas_store approval-current "$n"; then
        log "WARN: the approval of #$n could not be read ($tehas_store_word), so no pull request is cleared of tehas:refreshing this poll"
        refreshing=""
        break
      fi
      pr=$(tehas_store_get '.current | select(. != null and .how == "refresh") | .refresh_pr // empty')
      [[ ! $pr =~ ^[1-9][0-9]{0,9}$ ]] || refresh_owner[$pr]=$n
    done
  fi
else
  log "WARN: the history of refreshes could not be read ($tehas_store_word), so no pull request is cleared of tehas:refreshing this poll"
fi
for pr in $refreshing; do
  owner=${refresh_owner[$pr]:-}
  why=""
  if [ -z "$owner" ]; then
    why="no refresh on this host names it"
  elif ! tehas_cycle_running "$owner"; then
    why="no cycle runs on #$owner"
  else
    label_actor "$pr" tehas:refreshing
    [ "$who" = "$bot" ] || why="it was applied by '${who:-unknown}', not by tehas"
  fi
  [ -n "$why" ] || continue
  if [ "$dry" = 1 ]; then
    log "would take tehas:refreshing off pull request #$pr: $why"
    continue
  fi
  if refresh_unmark "$pr"; then
    log "clear pull request #$pr: tehas:refreshing off, $why"
  else
    log "WARN: label change on pull request #$pr failed: --remove-label tehas:refreshing"
  fi
done

# A parked cycle keeps its workspace for a person to read, and the one before
# it as .before-retry. Those of an issue go together once no cycle has used any
# of them, or taken the issue's lock, for 7 days. With the workspace go what a
# cycle leaves outside it, the same names tehas stop removes: the agents'
# transcripts in ~/.pi/agent/ensemble-runs/issue-<issue>, the console in
# live/console-<issue>.txt, and the transcripts of the issue's planning session
# in ~/.pi/agent/ensemble-runs/plan-<issue>. An issue whose workspace is gone
# loses those three on their own, on the same rule. The issue's lock is taken
# for the removals, so no cycle starts while they go. Three issues a poll at
# most, so a poll stays short. A workspace goes only under the directory tehas
# work marked; the other three are looked for wherever the issue has them.
#
# Each name is built from the number the way libexec/stop builds it, never from
# a glob of what is there: the sweep of #5 touches nothing of #51, and the
# dated directories of ensemble-runs are the runner's, not tehas's, and stay for
# a person.
sweep_workspaces() {
  local works=${TEHAS_WORK_DIR%/*} base=${TEHAS_WORK_DIR##*/} p n lock e said
  local -A seen=()
  local -a list=() files=()
  local count=0 marked=0 young out
  # The workspaces go only where tehas work marked the directory as its own, as
  # they always have. The three a cycle leaves outside them are looked for
  # wherever the issue has them, so an orphan goes with no marker to ask for.
  marked=0
  [ -f "$works/.tehas-workspaces" ] && marked=1
  # The issues this host knows: those with a workspace of their own, and those
  # with a name in ensemble-runs or a console file. A name is matched whole, the
  # way libexec/stop builds it, so #5 reads nothing of #51 and a dated directory
  # of the runner is no issue's.
  if [ "$marked" = 1 ]; then
    for p in "$works/$base"-*; do
      [[ ${p##*/} =~ ^"$base"-([1-9][0-9]{0,9})(\.before-retry|\.images|\.state)?$ ]] || continue
      list+=("${BASH_REMATCH[1]}")
    done
  fi
  for p in "$HOME"/.pi/agent/ensemble-runs/issue-* "$HOME"/.pi/agent/ensemble-runs/plan-*; do
    [[ ${p##*/} =~ ^(issue|plan)-([1-9][0-9]{0,9})$ ]] || continue
    list+=("${BASH_REMATCH[2]}")
  done
  for p in "$TEHAS_HOME"/live/console-*.txt; do
    [[ ${p##*/} =~ ^console-([1-9][0-9]{0,9})\.txt$ ]] || continue
    list+=("${BASH_REMATCH[1]}")
  done
  for n in "${list[@]}"; do
    [ -z "${seen[$n]+set}" ] || continue
    seen[$n]=1
    # Three issues a poll at most, counting the ones it only would take.
    [ "$count" -lt 3 ] || return 0
    lock=$TEHAS_HOME/state/cycles/$n.lock
    ! tehas_cycle_running "$n" || continue
    # What this issue has on this host. A name that is no file is as untouched
    # as one that has not been used, so find is not asked about it.
    files=()
    [ "$marked" = 1 ] && files+=("$works/$base-$n" "$works/$base-$n".{before-retry,images,state})
    files+=("$HOME/.pi/agent/ensemble-runs/issue-$n" "$HOME/.pi/agent/ensemble-runs/plan-$n" \
      "$TEHAS_HOME/live/console-$n.txt")
    # The lock is asked about before anything is removed, as tehasbot clean asks
    # it: a lock that is no lock file is no proof of anything about the issue, and
    # taking it would write through it. It is asked of too, because a cycle can
    # take a lock between the two probes and the removals hold it. The whole set
    # is kept and the next poll tries again, so a name kept by one rule costs no
    # candidate of another: the refusal is said, as the lock that could not be
    # taken below is.
    if ! tehas_cycle_lock_free "$n"; then
      log "WARN: the lock of #$n is no lock file, so nothing of it was removed"
      continue
    fi
    # The age rule of tehasbot clean: young means this issue is kept, and so does
    # a name the poll cannot date, because an issue it cannot date is an issue it
    # does not touch. One find over all of them is not enough: it prints nothing
    # for a name it could not read and still ends 0, which would read as aged out.
    young=""
    for e in "$lock" "${files[@]}"; do
      [ -e "$e" ] || [ -L "$e" ] || continue
      out=$(find "$e" -maxdepth 0 -newermt "-7 days" 2>/dev/null) || { young=$e; break; }
      [ -n "$out" ] && { young=$e; break; }
    done
    [ -z "$young" ] || continue
    count=$((count + 1))
    if [ "$dry" = 1 ]; then
      log "would remove what #$n left on this host: no cycle has run on it for 7 days"
      continue
    fi
    # The lock is taken for the removals and goes with them, as tehas stop does.
    # One a cycle holds cannot be taken: then nothing of the issue is touched
    # and the next poll tries again.
    if ! flock -n "$lock" true; then
      log "WARN: could not take the lock of #$n, so nothing of it was removed"
      continue
    fi
    said=0
    for e in "${files[@]}"; do
      [ -e "$e" ] || [ -L "$e" ] || continue
      if flock -n "$lock" rm -rf -- "$e" 8>&-; then
        said=1
      else
        log "WARN: could not remove ${e#"$TEHAS_HOME"/} of #$n"
        said=0
        break
      fi
    done
    if [ "$said" = 1 ]; then
      log "removed what #$n left on this host: no cycle has run on it for 7 days"
    fi
  done
  return 0
}
sweep_workspaces
# The lock files of issues nothing has used for 30 days go, three a poll.
sweep=(sweep-locks) did=removed; [ "$dry" = 0 ] || { sweep+=(--dry-run); did="would remove"; }
if tehas_store "${sweep[@]}"; then
  for n in $(tehas_store_get '.removed[]'); do log "$did the lock of #$n: unused for 30 days"; done
else log "WARN: the unused cycle locks were not swept ($tehas_store_word): $tehas_store_line"; fi

# 1b. The pause switches end the poll here. Everything above cleaned up what
# this host already had; nothing below starts work: no cycle, no planning turn,
# no answer to a question, no retry by a tick. The reason is said on every dry
# run, and on a poll when it is news rather than a switch simply being where it
# was left.
if [ -n "$pause_holds" ]; then
  if [ "$dry" = 1 ] || [ "$pause_news" = 1 ]; then log "paused: $pause_holds"; fi
  exit 0
fi

# The open issues labelled tehas:ready or tehas:blocked, read once a poll.
ready_json=""
read_ready() {
  [ -z "$ready_json" ] || return 0
  gh_json issue list --repo "$repo" --state open --label tehas:ready --limit 1000 --json number,labels
  ready_json=$json
  gh_json issue list --repo "$repo" --state open --label tehas:blocked --limit 1000 --json number,labels
  ready_json=$(jq -sc '.[0] + (.[1] | map(select(any(.labels[]?.name; test("^tehas:(running|awaiting-merge|question|planning|refreshing|plan|refine)$")) | not)))
    | unique_by(.number)' <<<"$ready_json$json") || { log "ERROR: unreadable list of ready issues"; exit 1; }
}
ask=tehas:ready # the label that asked for the issue being decided
# count_waiting: how many of them could start now, as far as this host knows
# without asking GitHub more, in $waiting: no cycle and no planning session of
# theirs is open.
waiting=0
count_waiting() {
  local n list
  read_ready
  list=$(jq -r '.[] | select(any(.labels[]?.name; . == "tehas:ready")) | .number | tonumber? // empty' <<<"$ready_json") || { log "ERROR: unreadable list of ready issues"; exit 1; }
  waiting=0
  for n in $list; do
    plan_open "$n" || tehas_cycle_running "$n" || waiting=$((waiting + 1))
  done
}

# The free kilobytes of the host for this poll, read by disk_check and empty
# when there is no figure. disk_read says the read has been made: the poll
# asks once, whoever comes first of the two arms below.
disk_free=""
disk_read=""
# disk_check: the free disk of the host for this poll, in $disk_free. It is the
# one df of ~/tehas, the one docker info and the one df of Docker's own a poll
# makes (tehas_free_kb in lib/disk.sh), each bounded, so a Docker or a mount
# that does not answer leaves no figure and a hold rather than a poll that
# waits for it. The read is made once and its answer kept, also when it is
# nothing: a poll that reads nothing pays for the read once, and the next poll
# asks again so a host whose df recovers is not held on by the reading that
# failed. It is asked only after the slice and the endpoint had their say,
# which is why the arms below ask it and take the decision from what it left.
disk_check() {
  [ -n "$disk_read" ] || {
    disk_read=1
    disk_free=$(tehas_free_kb "$TEHAS_HOME") || disk_free=""
  }
}

# 3. Do not pile up unreviewed work, and do not promise memory the slice does
# not have. A running cycle is a pull request on its way, so it counts:
# otherwise the slots could overshoot the cap. Rules 2 and 3 hold back new
# cycles only; a question is still read while they hold. $hold says why and
# $why is the one word for it: slice, unreadable, disk, resources, limit, red,
# count, awaiting, pressure, room, full or lane, the first that applies.
# resources is a model endpoint that does not answer or does not offer the
# model: it holds planning turns and retries as well.
#
# The slice is read here, after the sweep above, which needs no slice. The
# room is read whenever the slice is usable, also when the slots are full, so
# that tehas status has the numbers.
room_mem=0
committed=0
slice_max=0
if tehas_slice_ok; then
  cid_files=()
  for n in $running; do cid_files+=("$TEHAS_HOME/state/cycles/$n.cid"); done
  if ! read -r room_mem committed slice_max _ mem_why mem_note < <(tehas_slice_room "$count" "${cid_files[@]}") ||
    ! [[ $room_mem =~ ^[0-9]+$ && $committed =~ ^[0-9]+$ && $slice_max =~ ^[0-9]+$ ]]; then
    # An answer that is not the numbers is never read as room.
    room_mem=0 committed=0 slice_max=0 mem_why=unreadable mem_note=""
  fi
  case "$mem_why" in
    pressure | unreadable | full) room_mem=0 ;;
    *) if [ "$room_mem" = 0 ]; then mem_why=room; else mem_why=""; fi ;;
  esac
else
  slice_hold="holding: $TEHAS_SLICE_WHY"
fi

mesh_check
hold=""
why=""
want=0
# A refresh takes a pull request out of awaiting-merge as it starts, so the
# cap of rule 3 does not hold it: $want_all is the room without that cap. With
# a lane, $want_all is the room of both, and $want_refresh of the lane alone.
want_all=0
want_refresh=""
cut=""
if [ -n "$slice_hold" ]; then
  why=slice
  hold=$slice_hold
elif [ "$mem_why" = unreadable ]; then
  # Before the count: this holds planning turns too, and tehas status warns
  # on it, whatever the slots say.
  why=unreadable
  hold="holding: the slice's use could not be read${mem_note:+: $mem_note}"
elif [ -n "$mesh_hold" ]; then
  why=resources
  hold=$mesh_hold
elif disk_check && [ -n "$disk_free" ] &&
  [ "$disk_free" -lt $((TEHAS_CYCLE_MIN_FREE_MB * 1024)) ]; then
  # Before the count: on a host whose slots are all taken a full disk is
  # still what stops the next cycle, and tehas status says so. Running
  # cycles are left alone; only new ones wait.
  why=disk
  hold="holding: $(gib $((disk_free * 1024))) free on the disk, under TEHAS_CYCLE_MIN_FREE=$TEHAS_CYCLE_MIN_FREE: no cycle starts"
elif disk_check && [ -z "$disk_free" ]; then
  # Read and answered nothing. The same word as a low figure, because both hold
  # every start and neither names a number a person can fix.
  why=disk
  hold="holding: the free disk space could not be read: no cycle starts"
elif [ "$limit_state" = expired ]; then
  why=limit
  hold="holding: the limit expired at $(jq -r .until <<<"$limit"): nothing starts until it is set again or cleared"
elif [ "$limit_state" = unreadable ]; then
  why=limit
  hold="holding: the limit cannot be read: nothing starts until it is set again or cleared ($(tehas_limit_file))"
elif [ -n "$limit_room" ] && [ "$limit_room" -le 0 ]; then
  why=limit
  hold="holding: the limit allows $(limit_cycles) at once and $count $([ "$count" = 1 ] && echo is || echo are) running${limit_reason:+: $limit_reason}"
elif branch_check && [ -n "$red_hold" ]; then
  # Before the count, so tehas status says it while the slots are full.
  why=red
  hold=$red_hold
elif [ "$free" -le 0 ]; then
  why=count
  hold="holding: $cycles cycles are running (limit $TEHAS_TICKET_CONCURRENCY)"
  if [ -n "$lane" ]; then
    hold="$hold; the refresh lane has $lane of $TEHAS_REFRESH_SLOTS free"
    want_all=$lane
    [ -z "$limit_room" ] || [ "$limit_room" -ge "$want_all" ] || want_all=$limit_room
    [ "$room_mem" -ge "$want_all" ] || want_all=$room_mem
    want_refresh=$want_all
  fi
else
  want_all=$((free + ${lane:-0}))
  [ -z "$limit_room" ] || [ "$limit_room" -ge "$want_all" ] || want_all=$limit_room
  [ "$room_mem" -ge "$want_all" ] || want_all=$room_mem
  if [ -n "$lane" ]; then
    want_refresh=$((lane < want_all ? lane : want_all))
  fi
  gh_json issue list --repo "$repo" --state open --label tehas:awaiting-merge --limit 1000 --json number
  awaiting=$(jq length <<<"$json") || { log "ERROR: unreadable list of issues awaiting merge"; exit 1; }
  room=$((max_awaiting - awaiting - count))
  if [ "$room" -le 0 ]; then
    why=awaiting
    if [ "$count" = 0 ]; then
      hold="holding: $awaiting issues await merge (limit $max_awaiting)"
    else
      hold="holding: $awaiting issues await merge and $count cycles are running (limit $max_awaiting)"
    fi
  elif [ -n "$mem_why" ]; then
    why=$mem_why
    case "$why" in
      pressure) hold="holding: tehas.slice is under memory pressure (full avg60 $(tehas_slice_pressure || echo unknown))" ;;
      room) hold="holding: tehas.slice has no room for another cycle ($(gib "$committed") of $(gib "$slice_max") promised, each cycle is given $TEHAS_CYCLE_RESERVE)" ;;
      full) hold="holding: tehas.slice holds as many containers as their ceilings fit ($((slice_max / (TEHAS_SLICE_CEILING_MB * 1048576))) of ${TEHAS_SLICE_CEILING_MB}m)" ;;
    esac
  else
    # $cut names the cap that cut the free slots, when one did.
    want=$((free < room ? free : room))
    cut=awaiting
    if [ -n "$limit_room" ] && [ "$limit_room" -lt "$want" ]; then
      want=$limit_room
      cut=limit
    fi
    if [ "$room_mem" -lt "$want" ]; then
      want=$room_mem
      cut=room
    fi
    # What the lane has free is kept from new cycles.
    if [ -n "$lane" ] && [ $((room_mem - lane)) -lt "$want" ]; then
      want=$((room_mem > lane ? room_mem - lane : 0))
      cut=lane
    fi
    if [ "$want" = 0 ] && [ "$cut" = lane ]; then
      why=lane
      hold="holding: tehas.slice has room for $room_mem more and the refresh lane keeps $lane"
    fi
  fi
fi
# Fewer start than there are free slots and issues waiting: the reason is
# said on every such poll, not only when it changes. Some start: the limit
# that cut it is the reason, and it holds nothing else back.
short=0
if [ "$free" -gt 0 ] && [ "$want" -lt "$free" ]; then
  count_waiting
  [ "$waiting" -le "$want" ] || short=1
fi
if [ "$short" = 1 ] && [ "$want" -gt 0 ]; then
  why=$cut
  case "$cut" in
    awaiting) hold="holding: $want of $free free slots start: $awaiting issues await merge and $count cycles are running (limit $max_awaiting)" ;;
    limit) hold="holding: $want of $free free slots start: the limit allows $(limit_cycles) at once${limit_reason:+: $limit_reason}" ;;
    lane) hold="holding: $want of $free free slots start: tehas.slice has room for $room_mem more and the refresh lane keeps $lane" ;;
    *) hold="holding: $want of $free free slots start: tehas.slice has room for $want more ($(gib "$committed") of $(gib "$slice_max") promised, each cycle is given $TEHAS_CYCLE_RESERVE)" ;;
  esac
  [ "$dry" = 0 ] || log "$hold"
fi
[ "$dry" = 1 ] || report_hold

# 4. Questions that wait for an answer. An answer is a box ticked in the
# bot's question comment, or for a planning session a reply after it, and it
# counts only from an allowed account.
# A planning turn runs as its own unit, tehas-plan-<issue>.service, and the
# poll does not wait for it. A session running on record is a turn still in
# flight (its unit holds state/plan-<issue>.json.lock), one that ended and
# left its exit status, which is posted now, or one that was cut off, for
# example by a restart of the host, which is reported as a failed turn. While
# one turn is in flight no other starts.
fresh=" "
plan_busy=""
# Parked issues with a box ticked, held or not: rule 5a leaves them.
park_ticked=" "
plan_sessions_must
for n in $(jq -r '.[] | select(.running == true) | .issue' <<<"$plan_open_json"); do
  if plan_in_flight "$n"; then
    plan_busy=$n
  elif [ "$dry" = 1 ]; then
    if [ -f "$(plan_state "$n").rc" ]; then
      log "would post the planning turn of #$n that ended"
    else
      log "would report the cut-off planning turn of #$n"
    fi
  elif ! plan_collect "$n"; then
    reap "tehas-plan-$n" "the planning turn of #$n was cut off"
    plan_recover "$n" || true
  fi
  fresh="$fresh$n "
done
# A planning turn whose outcome could not be posted is posted first: its
# session is waiting on a comment nobody has seen.
plan_sessions_must
for n in $(jq -r '.[] | select(.pending == true) | .issue' <<<"$plan_open_json"); do
  case "$fresh" in *" $n "*) continue ;; esac
  if [ "$dry" = 1 ]; then
    log "would post the waiting planning turn of #$n"
  else
    plan_post "$n" || true
  fi
  # Its question label is newer than the list read below.
  fresh="$fresh$n "
done
open_sessions=$(jq -r '.[].issue' <<<"$plan_open_json")

gh_json issue list --repo "$repo" --state open --label tehas:question --limit 1000 --json number,labels
asking_json=$json
asking=$(jq -r 'map(.number) | sort | .[]' <<<"$asking_json") || { log "ERROR: unreadable list of issues with a question"; exit 1; }
# A session whose issue was closed, or whose question label was taken off by
# hand, is over. It ends without a comment. A session that was running or
# waiting to be posted when this poll began is in $fresh, whatever became of
# it above, so it is never taken for a session that is over.
for n in $open_sessions; do
  case "$fresh" in *" $n "*) continue ;; esac
  case " ${asking//$'\n'/ } " in
    *" $n "*) ;;
    *) [ "$dry" = 1 ] || plan_close "$n" || true ;;
  esac
done
for n in $asking; do
  # The pause switch before its comments are read: a box ticked on the
  # control issue's question starts no cycle, runs no turn and spends no tick.
  control_ask "$n" "its question was answered" && continue
  have=" $(jq -r --argjson n "$n" '[.[] | select(.number == $n) | (.labels // [])[].name] | join(" ")' <<<"$asking_json") "
  # Which comment is the question is decided here, from this host's own
  # record on the state store, before a comment is read: the question of the
  # open planning session, else the question of the parked cycle, which the
  # store must still know as this issue's question on record. Everything on
  # the issue can be written with the bot's token. A record that could not be
  # read decides nothing: a tick then neither counts nor is undone.
  qid=""
  qkind=""
  plan_row=null
  if tehas_store plan-show "$n"; then
    plan_row=$(tehas_store_get '.planning | if type == "object" and .ended_at == null then . else null end') || plan_row=null
    [ -n "$plan_row" ] || plan_row=null
    qid=$(jq -r '.comment_id // empty | tostring' <<<"$plan_row")
    [[ $qid =~ ^[1-9][0-9]{0,15}$ ]] || qid=""
    if [ -z "$qid" ] && tehas_store park-show "$n"; then
      qid=$(tehas_store_get '.park.question // empty | tostring')
      [[ $qid =~ ^[1-9][0-9]{0,15}$ ]] || qid=""
    fi
    if tehas_store_looked && [ -n "$qid" ] && tehas_store question-known "$n" --id "$qid"; then
      if [ "$(tehas_store_get '.known')" = true ]; then
        qkind=$(tehas_store_get '.kind // ""')
      else
        qid=""
      fi
    fi
  fi
  if ! tehas_store_looked; then
    if [ "$tehas_store_rc" != 1 ]; then
      log "ERROR: the state store cannot be used: $tehas_store_line"
      exit 78
    fi
    log "skip #$n: its question on record could not be read ($tehas_store_word)"
    continue
  fi
  case "$qkind" in park | plan) ;; *) qid="" qkind="" ;; esac
  # shellcheck disable=SC2016  # $owner, $name and $number are GraphQL variables
  gh_json api graphql -F owner="${repo%%/*}" -F name="${repo##*/}" -F number="$n" \
    -f query='query($owner: String!, $name: String!, $number: Int!) {
      repository(owner: $owner, name: $name) { issue(number: $number) {
        comments(last: 100) { nodes { databaseId author { login } body createdAt lastEditedAt editor { login }
          userContentEdits(last: 100) { totalCount nodes { editor { login } } } } } } } }'
  # With nothing on record the newest question of the bot is still read, only
  # to be able to tell a person that their answer starts nothing.
  ans=$(q_answer "$bot" "$TEHAS_ALLOWED_LABELERS" "$qid" "$TEHAS_MILLWRIGHT_LOGIN" <<<"$json") || { log "ERROR: unreadable comments of #$n"; exit 1; }
  if [ "$(jq -r .asked <<<"$ans")" != true ]; then
    [ -z "$qid" ] || log "skip #$n: its question is not among the last 100 comments"
    continue
  fi
  kind=$(jq -r .kind <<<"$ans")
  tick=$(jq -r .tick.status <<<"$ans")
  by=$(jq -r '.tick.by // ""' <<<"$ans")
  # The marker must agree with where the comment is and with what kind of
  # question the host has on record.
  if [ -n "$qid" ] && { [ "$(jq -r .issue <<<"$ans")" != "$n" ] || [ "$kind" != "$qkind" ]; }; then
    log "skip #$n: the question on record does not belong to this issue"
    continue
  fi

  # The fixer answers planning questions only.
  [ "$tick" != fixer ] || [ "$kind" = plan ] || tick=stranger
  # A tick that is no answer is undone, so the boxes show what was accepted.
  if [ "$tick" = stranger ] || [ "$tick" = many ]; then
    log "skip #$n: boxes ticked by '${by:-unknown}' are no answer ($tick)"
    if [ "$dry" = 0 ]; then
      if [ "$tick" = many ]; then
        note="More than one box was ticked, so nothing was chosen. Tick one."
      else
        note="A box was ticked by an account that may not answer for this factory (${by:-unknown}). It was unticked."
      fi
      untick "$n" "$ans" "$note" || log "WARN: could not untick the question on #$n"
    fi
    tick=none
  fi

  case "$kind" in
    park)
      # Only a tick answers a parked cycle: a comment there is discussion.
      [ "$tick" = one ] || continue
      park_ticked="$park_ticked$n "
      # Only the question on record can start a cycle. A box in any other
      # comment is emptied, so that it cannot be taken for an order given.
      if [ "$qkind" != park ]; then
        log "skip #$n: a box was ticked in a question this host has no record of"
        if [ "$dry" = 0 ]; then
          untick "$n" "$ans" "This question is not one the factory is waiting on. To retry, apply \`tehas:ready\`." ||
            log "WARN: could not untick the question on #$n"
        fi
        continue
      fi
      # What was ticked is read from its text, not its place in the list.
      qbody=$(jq -r .body <<<"$ans") || qbody=""
      qbody=${qbody//$'\r'/}
      if ! grep -qix -e '- \[x\] Retry from a clean start' <<<"$qbody"; then
        # The record goes only with the label: while the label stays, the
        # next poll reads the same tick and tries again.
        if [ "$dry" = 0 ]; then
          if gh issue edit "$n" --repo "$repo" --remove-label tehas:question >/dev/null 2>&1; then
            tehas_store_try 3 question-answered "$n" --id "$qid" --by "$by" ||
              log "WARN: could not record the answer to the question of #$n ($tehas_store_word)"
          else
            log "WARN: label change on #$n failed: --remove-label tehas:question"
          fi
        fi
        continue
      fi
      # A retry counts only on an issue that is parked now. The tick is undone:
      # left in place it would start a cycle later, when the labels change.
      case "$have" in
        *" tehas:running "* | *" tehas:awaiting-merge "*) parked=0 ;;
        *" needs-human-attention "*) parked=1 ;;
        *) parked=0 ;;
      esac
      if [ "$parked" = 0 ]; then
        log "skip #$n: a retry was ticked but the issue is not parked"
        if [ "$dry" = 0 ]; then
          untick "$n" "$ans" "Retry was ticked, but this issue is not parked, so nothing was started." ||
            log "WARN: could not untick the question on #$n"
        fi
        continue
      fi
      # An issue closed since its cycle stopped is not work: the tick starts
      # nothing, and it stays as it is, as a tick held back by a hold does.
      work_ok "$n" || continue
      # An epic is not a change either: the tick starts nothing, and, as for a
      # hold, the issue and its tick stay as they are for a person.
      epic_ok "$n" || continue
      # Nor is an issue the loop says needs a change in another repository too:
      # the tick starts nothing and stays for a person, as an epic's does.
      cross_repo_holds "$n" "$have" || continue
      # The tick approves the text as it was at that moment, as the label does.
      issue_events "$n"
      unchanged_since "$n" "$(jq -r .tick.at <<<"$ans")" "$by ticked retry" "untick the box and tick it again" || continue
      if [ "$want" = 0 ]; then
        [ "$dry" = 1 ] && log "$hold"
        continue
      fi
      mesh_ok || exit 0
      image_ok "$n" || continue # this issue's own hold, as on the ready path
      image_missing_ok "$n" || continue
      if [ "$dry" = 1 ]; then
        log "would run a cycle for #$n (retry ticked by $by)"
        exit 0
      fi
      # Asked before anything changes: a tick must not be spent on a start
      # that cannot happen.
      units_ok "$n" || exit 1
      index_gate
      picked=("$n")
      starter[$n]=$by
      verb[$n]="retry ticked"
      how[$n]="retry tick"
      given_at[$n]=$(jq -r .tick.at <<<"$ans")
      given_how[$n]="retry-tick"
      given_comment[$n]=$(jq -r '.comment // "" | tostring' <<<"$ans")
      # The park: when the question was asked.
      given_since[$n]=$(jq -r '.asked_at // ""' <<<"$ans")
      # needs-human-attention stays: the cycle's --restart is the answer it
      # asked for, and pi-rukas takes it off.
      drop[$n]="--remove-label tehas:question"
      # A tehas:ready left on the issue would start a second cycle after this
      # one: one start uses up every request for it.
      [[ $have == *" tehas:ready "* ]] && drop[$n]+=" --remove-label tehas:ready"
      [[ $have == *" tehas:fixer-escalated "* ]] && drop[$n]+=" --remove-label tehas:fixer-escalated"
      # One tick is one start. The start takes the question off the record
      # and then marks the issue: when the mark fails the question goes back
      # on record, the poll ends here and the tick stays, so the next poll
      # tries again. Once the issue is marked the question is off the record,
      # so the tick can start nothing more. It is unticked then, so the comment
      # shows it was taken; a failure there is only a warning.
      # A start that failed before the issue was marked has spent nothing: the
      # tick stays, and the next poll tries again, as the comment above says.
      start_cycles
      started=$?
      [ "$started" = 0 ] || exit "$started"
      untick "$n" "$ans" || log "WARN: could not untick the retry on #$n; its question is no longer on record, so it starts nothing more"
      exit "$started"
      ;;
    plan)
      # A reply says more than a box, so it wins when both are there, and the
      # answer says what was ticked.
      # A person's answer wins over the fixer's, whichever came first.
      reply=$(jq -r '.reply.text // ""' <<<"$ans")
      reply_id=""
      fixer_said=""
      if [ -n "$reply" ]; then
        by=$(jq -r .reply.by <<<"$ans")
        reply_id=$(jq -r '.reply.id // "" | tostring' <<<"$ans")
        case "$reply_id" in *[!0-9]*) reply_id="" ;; esac
      elif [ "$tick" = one ]; then
        :
      elif [ "$tick" = held ]; then
        if pview=$(plan_view "$n"); then
          fixer_held "$n" "$pview" "$ans"
          rm -f "$pview"
        fi
        continue
      elif [ "$(jq -r '.fixer_reply != null' <<<"$ans")" = true ]; then
        fixer_said=reply
      elif [ "$tick" = fixer ]; then
        fixer_said=tick
      else
        continue
      fi
      if [ "$plan_row" = null ]; then
        [ "$dry" = 1 ] || plan_end "$n" "The record of this planning session is gone from the host, so it cannot continue. Apply \`tehas:plan\` to start a new one."
        continue
      fi
      # Only the question the session is waiting on counts: an older or stray
      # bot question must not run a turn. With an id on record the comment was
      # chosen by it and this always holds. It stops the case of a record that
      # names no question, where the newest question of the bot was read.
      if [ "$(jq -r '.comment_id // ""' <<<"$plan_row")" != "$(jq -r .comment <<<"$ans")" ]; then
        log "skip #$n: the question answered is not the one this session is waiting on"
        continue
      fi
      speaker="The operator"
      if [ -n "$fixer_said" ]; then
        if ! pview=$(plan_view "$n"); then
          log "skip #$n: its planning session on record could not be read"
          continue
        fi
        fixer_answer_ok "$n" "$pview" "$ans" "$fixer_said"
        fixer_ok_rc=$?
        rm -f "$pview"
        [ "$fixer_ok_rc" = 0 ] || continue
        speaker="The fixer"
        by=$TEHAS_MILLWRIGHT_LOGIN
        if [ "$fixer_said" = reply ]; then
          reply=$(jq -r '.fixer_reply.text' <<<"$ans")
          reply_id=$(jq -r '.fixer_reply.id // "" | tostring' <<<"$ans")
          case "$reply_id" in *[!0-9]*) reply_id="" ;; esac
        fi
      fi
      if [ -n "$reply" ]; then
        text="$speaker replied on the issue:

$reply"
        # The tick is not used, but it is not dropped without a word either.
        if [ "$tick" = one ]; then
          idx=$(jq -r .tick.index <<<"$ans")
          if [ "$idx" = "$(($(jq -r .boxes <<<"$ans") - 1))" ]; then
            choice="End this planning session"
          else
            choice=$(jq -r --argjson i "$idx" '.options[$i] // ""' <<<"$plan_row" 2>/dev/null) || choice=""
            [ -n "$choice" ] || choice="a box that matches no option on record"
          fi
          text="$text

A box was also ticked, by $(jq -r .tick.by <<<"$ans"): $choice"
        fi
      else
        idx=$(jq -r .tick.index <<<"$ans")
        # The last box is always the way out.
        if [ "$idx" = "$(($(jq -r .boxes <<<"$ans") - 1))" ]; then
          if [ -n "$fixer_said" ]; then
            log "skip #$n: the fixer's answer runs no turn: it would end the session, which only a person may"
            continue
          fi
          [ "$dry" = 1 ] || plan_end "$n" "Planning session ended by $by."
          continue
        fi
        choice=$(jq -r --argjson i "$idx" '.options[$i] // ""' <<<"$plan_row" 2>/dev/null) || choice=""
        if [ -z "$choice" ]; then
          log "skip #$n: the ticked box matches no option on record"
          continue
        fi
        text="$speaker chose: $choice"
      fi
      # An answer on an issue that is no longer work is discussion, not an
      # order: a closed issue runs no planning turn.
      if [ -n "$plan_busy" ]; then
        log "planning #$n waits: the turn of #$plan_busy is still running"
        continue
      fi
      work_ok "$n" || continue
      # Checked after the way out above, which runs no turn.
      slice_ok || continue
      limit_ok || continue
      mesh_ok || exit 0
      from=$by
      [ -z "$fixer_said" ] || from="$by, the fixer"
      if [ "$dry" = 1 ]; then
        log "would run a planning turn for #$n (answer from $from)"
        exit 0
      fi
      # The answer goes to the store as it is; the turn is given it from there.
      [ -e "$TEHAS_HOME/tmp" ] || mkdir -m 700 "$TEHAS_HOME/tmp" 2>/dev/null
      if ! answer_file=$(mktemp "$TEHAS_HOME/tmp/plan-answer.XXXXXX") || ! printf '%s\n' "$text" >"$answer_file"; then
        [ -z "${answer_file:-}" ] || rm -f "$answer_file"
        log "ERROR: could not write the answer for #$n, not starting a turn"
        exit 1
      fi
      log "planning #$n continues (answer from $from)"
      plan_turn "$n" next "$answer_file" "$reply_id" "$by"
      "$status_cmd"
      exit 0
      ;;
  esac
done

# 5. New planning sessions. The label approves the text, as tehas:ready does,
# so the text is read before the approval is checked: an edit made in between
# is then seen by the check. tehas:refine starts the same session with the
# refine brief (lib/refine-brief.md) after the issue's text: plan the request
# into one issue sized for one cycle. An issue with both labels is planned.
# tehas:question does not exclude an issue here: a person who applies either
# label to a parked issue asks for a session, as tehas:ready starts a cycle on
# one. plan_turn takes the question's label off with the label that asked.
# tehas:planning and tehas:running do exclude it: there the session or the
# cycle is already under way.
# A retry tick is answered by rule 4, which runs first and ends the poll, so a
# ticked Retry from a clean start still gets its cycle. What reaches this rule
# is a park whose tick was taken back or never given: it asks for nothing, and
# the start takes the question off under it, the record of its comment with it.
gh_json issue list --repo "$repo" --state open --label tehas:plan --limit 1000 --json number,labels
plan_list=$json
gh_json issue list --repo "$repo" --state open --label tehas:refine --limit 1000 --json number,labels
plans=$(jq -rs 'add | map((.labels | map(.name)) as $l
        | select((["tehas:planning", "tehas:running"] - $l | length) == 2)
        | {number, label: (if $l | index("tehas:plan") then "tehas:plan" else "tehas:refine" end)})
        | unique_by(.number) | .[] | "\(.number):\(.label)"' <<<"$plan_list
$json") || { log "ERROR: unreadable list of issues to plan"; exit 1; }
for entry in $plans; do
  n=${entry%%:*}
  plabel=${entry#*:}
  if [ -n "$plan_busy" ]; then
    log "planning #$n waits: the turn of #$plan_busy is still running"
    break
  fi
  slice_ok || break
  # Before the label is read: the control issue starts no planning session,
  # whoever applied the label, and no label of it is changed.
  control_ask "$n" "\`$plabel\`" && continue
  if ! limit_plan_ok; then
    [ "$dry" = 0 ] || log "planning #$n waits: the limit holds new planning turns"
    break
  fi
  gh_json issue view "$n" --repo "$repo" --json title,body
  brief=$json
  if ! approval "$n" "$plabel"; then
    [ -z "$refused" ] || clear_unauthorised "$n" "$plabel" "$refused"
    continue
  fi
  work_ok "$n" || continue
  mesh_ok || exit 0
  refine=""
  if [ "$plabel" = tehas:refine ]; then
    refine=$here/../lib/refine-brief.md
    if [ ! -s "$refine" ]; then
      log "ERROR: no refine brief at $refine, not refining #$n"
      continue
    fi
  fi
  if [ "$dry" = 1 ]; then
    log "would start a planning session for #$n (labelled by $who${refine:+, to refine it})"
    exit 0
  fi
  # The approved text, kept for the turn's unit until the turn ends. The
  # session's start takes the park's question off the record with it: its
  # boxes must not answer for the new session.
  plan_brief "$n" "$brief" "$refine" || exit 1
  log "start planning #$n (labelled by $who${refine:+, to refine it})"
  plan_turn "$n" first "$brief_file"
  "$status_cmd"
  exit 0
done

# 5a. A park the store says is owed a refine starts one, waiting as rule 5
# does. A tick of its boxes, a label, an answer or an edit since wins, and so
# does a ticket a planning session filed. One that cannot start is spent.
if ! tehas_store park-show --refine; then
  log "ERROR: the state store could not list the parks owed a refine ($tehas_store_word)"
  [ "$tehas_store_rc" = 1 ] && exit 1
  exit 78
fi
mapfile -t owed < <(tehas_store_get '.parks[] | select((.issue | type) == "number" and (.started_at | type) == "number")
  | "\(.issue) \(.started_at) \(.started_by // "-") \(.park_reason // "-") \(.question // "-") \(.body_sha256 // "-")"')
for owed_line in "${owed[@]}"; do
  read -r n started by preason qid sum <<<"$owed_line"
  [[ $n =~ ^[1-9][0-9]{0,9}$ ]] && [[ $started =~ ^[0-9]{1,11}$ ]] || continue
  if [ -n "$plan_busy" ]; then
    log "refining #$n waits: the turn of #$plan_busy is still running"
    break
  fi
  slice_ok || break
  if ! limit_plan_ok; then
    [ "$dry" = 0 ] || log "refining #$n waits: the limit holds new planning turns"
    break
  fi
  mesh_ok || exit 0
  if [[ $park_ticked == *" $n "* ]]; then
    log "skip #$n: not refined: a box of its park question is ticked"
    continue
  fi
  why=""
  if control_ask "$n" "a cycle that parked as \`$preason\` asked to be refined"; then
    why="it is the control issue"
  else
    gh_json issue view "$n" --repo "$repo" --json state,labels,title,body
    brief=$json
    have=" $(jq -r '[(.labels // [])[].name] | join(" ")' <<<"$brief") "
    for l in tehas:ready tehas:running tehas:blocked tehas:plan tehas:refine tehas:refined tehas:replaced; do
      [[ $have != *" $l "* ]] || why="it carries $l"
    done
    [ "$(jq -r '.state // ""' <<<"$brief")" = OPEN ] || why="it is closed"
    [[ $have == *" needs-human-attention "* && $have == *" tehas:question "* ]] || why="it is no longer parked"
    [ "$qid" != - ] || why="its park question was answered"
    jq -r '.body // "" | split("\n") | .[0] | rtrimstr("\r")' <<<"$brief" | grep -qE '^Replaces #[0-9]+$' &&
      why="a planning session filed it"
    tehas_allowed_labeler "$by" || why="its cycle was not started by an account that may label ($by)"
    [ "$sum" = - ] || [ "$sum" = "$(tehas_body_sha256 <<<"$brief")" ] || why="its text changed since its cycle began"
    if [ -z "$why" ] && ! unchanged_since "$n" "$(date -u -d "@$started" +%FT%TZ)" "its last cycle began" "apply tehas:refine"; then
      why="its text changed since its cycle began"
    fi
  fi
  if [ -n "$why" ]; then
    log "skip #$n: not refined: $why"
    if [ "$dry" = 0 ] && ! tehas_store_try 3 park-retry "$n" && [ "$tehas_store_word" != unparked ]; then
      log "WARN: the refine of #$n could not be spent on record ($tehas_store_word)"
    fi
    continue
  fi
  refine=$here/../lib/refine-brief.md
  if [ ! -s "$refine" ]; then
    log "ERROR: no refine brief at $refine, not refining #$n"
    break
  fi
  if [ "$dry" = 1 ]; then
    log "would start refining #$n (its cycle parked as $preason, started by $by)"
    exit 0
  fi
  plan_brief "$n" "$brief" "$refine" || exit 1
  # Spent first: a poll that fails after this never starts a second session.
  if ! tehas_store_try 3 park-retry "$n"; then
    rm -f "$brief_file"
    log "ERROR: the refine of #$n could not be spent on record ($tehas_store_word), not refining it"
    exit 1
  fi
  who=$by
  plabel=tehas:refine
  plan_auto=$preason
  log "start refining #$n (its cycle parked as $preason, started by $by)"
  plan_turn "$n" first "$brief_file"
  "$status_cmd"
  exit 0
done

# With no room for new work, a refresh may still have room.
if [ "$want" = 0 ]; then
  [ "$dry" = 1 ] && log "$hold"
  { [ "$want_all" -gt 0 ] && [ -n "$(refresh_requests)" ]; } || exit 0
fi

# 4a. A cycle a provider outage parked starts again once, without a tick, now
# that nothing holds cycles back and the model endpoint answers. The store
# lists the parks that owe one (park-show --automatic): an outage park of a
# cycle started on an approval, not itself that retry, whose retry no start
# has spent. The start rests on the account that started the cycle that parked,
# as its start on record names it, while it is still allowed and nobody else
# changed the text since that cycle began. A park that cannot start anything
# has its retry spent (park-retry); a second park of the kind waits for a
# person. A list that cannot be read ends the poll before anything is done.
owed=()
if [ "$want" -gt 0 ]; then
  if ! tehas_store park-show --automatic; then
    log "ERROR: the state store could not list the parks owed a retry ($tehas_store_word)"
    [ "$tehas_store_rc" = 1 ] && exit 1
    exit 78
  fi
  mapfile -t owed < <(tehas_store_get '.parks[] | select((.issue | type) == "number" and (.started_at | type) == "number")
    | "\(.issue) \(.started_at) \(.started_by // "")"')
fi
for owed_line in "${owed[@]}"; do
  read -r n started by <<<"$owed_line"
  [[ $n =~ ^[1-9][0-9]{0,9}$ ]] && [[ $started =~ ^[0-9]{1,11}$ ]] || continue
  ! tehas_cycle_running "$n" || continue
  gh_json issue view "$n" --repo "$repo" --json state,labels
  have=" $(jq -r '[(.labels // [])[].name] | join(" ")' <<<"$json") "
  # A label of a person's decides it, in rule 6 or by waiting.
  [[ $have != *" tehas:ready "* ]] || continue
  control_ask "$n" "a cycle its provider outage parked asked to start again" && continue
  # A list that could not be read is no reason to spend the retry.
  if ! plan_sessions; then
    log "wait #$n: the open planning sessions could not be read ($plan_open_word)"
    continue
  fi
  if [ "$(jq -r '.state // ""' <<<"$json")" != OPEN ] || [[ $have != *" needs-human-attention "* ]] ||
    [[ $have == *" tehas:running "* ]] || plan_open "$n" || ! tehas_allowed_labeler "$by" ||
    ! unchanged_since "$n" "$(date -u -d "@$started" +%FT%TZ)" "its last cycle began" "apply tehas:ready"; then
    log "skip #$n: its retry after a provider outage is not started; it waits for a person"
    if [ "$dry" = 0 ] && ! tehas_store park-retry "$n" && [ "$tehas_store_word" != unparked ]; then
      log "WARN: the retry of #$n after a provider outage could not be spent on record ($tehas_store_word)"
    fi
    continue
  fi
  if [ "$dry" = 1 ]; then
    log "would run a cycle for #$n (retry after a provider outage, started by $by)"
    exit 0
  fi
  units_ok "$n" || exit 1
  index_gate
  picked=("$n")
  starter[$n]=$by
  verb[$n]=requeued
  # The text was checked unchanged since the parked cycle began, so the
  # approval record stands on that time. The store records the approval of
  # this retry at now: it is the poll's own decision.
  given_at[$n]=$(date -u -d "@$started" +%FT%TZ)
  given_how[$n]=outage-retry
  how[$n]="start of the cycle a provider outage parked"
  drop[$n]=""
  [[ $have != *" tehas:question "* ]] || drop[$n]="--remove-label tehas:question"
  say "$n" "Tehas starts this issue again on its own: its last cycle was parked by a provider outage, and the model endpoint answers again. It does this once. If the new cycle is parked the same way, it waits for a person."
  start_cycles
  exit $?
done

# 6. and 7. Candidates: urgent first, then the tehas:next issues the poll
# counts, then the rest of them, each by number. The order is needed
# before the candidates are cut to the free slots, so whose urgent label counts
# is settled for every issue that carries one and could still be picked. An
# issue with an open planning session or a live cycle is out of contention for
# a reason this poll knows without asking GitHub; it keeps its place by number
# either way, and the candidate loop says why it starts nothing. A failed
# events read of any issue asked about here ends the poll. Who applied
# tehas:ready is read again when the issue is picked, so no start rests on this
# ordering read.
read_ready
carrying=$(jq -r '.[] | select((.labels // []) | any(.name == "tehas:urgent")) | .number | tonumber? // empty' <<<"$ready_json") ||
  { log "ERROR: unreadable list of ready issues"; exit 1; }
urgent=()
for n in $carrying; do
  [ "$want" -gt 0 ] || break
  if plan_open "$n" || tehas_cycle_running "$n"; then
    continue
  fi
  label_actor "$n" tehas:urgent
  if tehas_allowed_labeler "$who"; then
    urgent+=("$n")
  else
    deny_label ignore "$n" tehas:urgent
  fi
done
carrying=$(jq -r '.[] | select((.labels // []) | any(.name == "tehas:next")) | .number | tonumber? // empty' <<<"$ready_json") ||
  { log "ERROR: unreadable list of ready issues"; exit 1; }
next=()
for n in $carrying; do
  [ "$want" -gt 0 ] || break
  if plan_open "$n" || tehas_cycle_running "$n"; then
    continue
  fi
  order_label "$n" tehas:next && next+=("$n")
done
urgent_json=$(printf '%s\n' "${urgent[@]}" | jq -sc 'map(tonumber)') ||
  { log "ERROR: unreadable urgent issue list"; exit 1; }
next_json=$(printf '%s\n' "${next[@]}" | jq -sc 'map(tonumber)') ||
  { log "ERROR: unreadable list of next issues"; exit 1; }
candidates=$(jq -r --argjson u "$urgent_json" --argjson x "$next_json" '
           (reduce $u[] as $i ({}; .[$i | tostring] = true)) as $us
         | (reduce $x[] as $i ({}; .[$i | tostring] = true)) as $xs
         | [.[] | .number as $n | ($n | tonumber | tostring) as $k
             | {number: $n, urgent: ($us[$k] == true), next: ($xs[$k] == true)}]
         | sort_by([(.urgent | not), (.next | not), .number]) | .[] | "\(if .urgent then "u" elif .next then "n" else "x" end) \(.number)"' <<<"$ready_json") ||
  { log "ERROR: unreadable list of ready issues"; exit 1; }
# The groups are put in order here, one grep each, rather than left to the
# sort's key: urgent, then the refreshes, then the tehas:next issues the poll
# counts, then the rest of them.
order=$(printf '%s\n' "$candidates" | grep '^u ')
for n in $(refresh_requests); do order+=$'\n'"r $n"; done
order+=$'\n'$(printf '%s\n' "$candidates" | grep '^n ')
order+=$'\n'$(printf '%s\n' "$candidates" | grep '^x ')
ready_picked=0
refresh_picked=0

while read -r kind n; do
  [ -n "${n:-}" ] || continue
  case "$kind" in u | r | n | x) ;; *) log "ERROR: candidate $n carries no kind"; exit 1 ;; esac
  [ "${#picked[@]}" -lt "$want_all" ] || break
  case " ${picked[*]} " in *" $n "*) continue ;; esac
  if [ "$kind" = r ]; then
    if [ -n "$want_refresh" ] && [ "$refresh_picked" -ge "$want_refresh" ]; then
      log "wait #$n: the refresh lane is full ($((TEHAS_REFRESH_SLOTS - lane + refresh_picked)) of $TEHAS_REFRESH_SLOTS)"
      continue
    fi
    refresh_ok "$n" || continue
    picked+=("$n")
    refresh_picked=$((refresh_picked + 1))
    continue
  fi
  # The gate's answer is this poll's answer: the issues of the lowest kind
  # after the one that asked are held by it alone, with no call to GitHub about
  # them.
  if [ "$kind" = x ] && [ "$gate_asked" = 1 ] && [ "$gate_answer" != 0 ]; then
    log "wait #$n: the low-priority gate is closed (exit $gate_answer)"
    continue
  fi
  [ "$ready_picked" -lt "$want" ] || continue
  have=" $(jq -r --argjson n "$n" '[.[] | select((.number | tonumber?) == $n) | (.labels // [])[].name] | join(" ")' <<<"$ready_json") "
  # One issue is in one flow at a time. A cycle's park question would hide the
  # session's question, and the session would then end with nobody told. The
  # record counts as well as the label: between turns only the record shows
  # that a session is open.
  if ! plan_sessions; then
    log "skip #$n: the open planning sessions could not be read ($plan_open_word)"
    continue
  fi
  if plan_open "$n" || [[ $have == *" tehas:planning "* ]]; then
    log "skip #$n: a planning session is open on it; end it first"
    continue
  fi
  # The pause switch, whatever its label and whoever applied one: said before
  # the issue's events are read, so it costs no GitHub call and no label change.
  control_ask "$n" "\`tehas:ready\`" && continue
  # The label asks for a fresh cycle. It gets one when this one has ended, and
  # stays on the issue until then. A running cycle is never stopped for it.
  if tehas_cycle_running "$n"; then
    log "wait #$n: its cycle is still running"
    continue
  fi
  by_fixer=0
  ask=tehas:ready
  [[ $have == *" tehas:ready "* ]] || ask=tehas:blocked
  if ! approval "$n" "$ask"; then
    if [ "$ask" = tehas:ready ] && [ -n "$refused" ] && tehas_millwright_is "$refused"; then
      fixer_ok "$n" || continue
      by_fixer=1
    else
      [ "$ask" != tehas:ready ] || [ -z "$refused" ] || clear_unauthorised "$n" tehas:ready "$refused"
      continue
    fi
  fi
  if [[ $have == *" tehas:blocked "* ]]; then
    blocked_ok "$n" || continue
  fi
  # Asked after the label approves the issue: an issue no account is allowed
  # to start costs no call, and the label is not changed until start_cycles.
  work_ok "$n" || continue
  # Asked of the answer work_ok already read, and before every later ask: an
  # issue whose fix lies in another repository spends no call of its own on the
  # pull requests, the images or the park that its start would never reach.
  # An epic is a plan, not a change: it never starts a cycle.
  epic_ok "$n" || continue
  # Nor does one whose fix the loop says lives on the other side too.
  cross_repo_holds "$n" "$have" || continue
  # With TEHAS_SIZE_MAX_FILES, a body that names too many files is held too.
  size_ok "$n" "$have" || continue
  open_pr "$n"
  if [ -n "$pr_url" ]; then
    clear_pr_open "$n"
    continue
  fi
  image_ok "$n" || continue
  # Asked of the text the label approved, with no call of its own: an issue
  # that says a file goes there and links nothing waits for its owner instead
  # of spending a cycle on a premise it cannot see.
  image_missing_ok "$n" || continue
  # A relabelled start on the very text the last cycle parked on asks for a spent
  # attempt: it is logged once, until the body changes or the park is ticked.
  park_holds "$n" && continue
  # The gate of rule 7, asked for the first issue of the lowest kind that
  # reached this point: an issue that waits for another reason asks nothing.
  if [ "$kind" = x ] && ! low_gate "$n"; then continue; fi
  picked+=("$n")
  ready_picked=$((ready_picked + 1))
  starter[$n]=$who
  verb[$n]=labelled
  how[$n]="\`$ask\` label"
  given_at[$n]=$at
  given_how[$n]=label
  if [ "$by_fixer" = 1 ]; then
    verb[$n]="labelled by the fixer"
    how[$n]="\`tehas:ready\` label as the fixer, on $(jq -r .by <<<"$tehas_millwright_rests_on")'s approval of $(jq -r .at <<<"$tehas_millwright_rests_on")"
    given_how[$n]=fixer
  fi
  drop[$n]="--remove-label $ask"
  [ "$ask" = tehas:blocked ] || [[ $have != *" tehas:blocked "* ]] || drop[$n]+=" --remove-label tehas:blocked"
  # What an earlier cycle left goes with the start, only what is there: gh refuses
  # a label the repository lacks. needs-human-attention is pi-rukas's to clear
  # (the cycle starts with --restart).
  for l in tehas:awaiting-merge tehas:question tehas:fixer-escalated; do
    [[ $have == *" $l "* ]] && drop[$n]+=" --remove-label $l"
  done
done <<<"$order"

if [ "$dry" = 1 ]; then
  log "$count cycles running, room for $want more"
fi
if [ "${#picked[@]}" = 0 ]; then
  [ "$dry" = 1 ] && log "nothing to do"
  exit 0
fi
if [ "$dry" = 1 ]; then
  for n in "${picked[@]}"; do log "would run a cycle for #$n (${verb[$n]} by ${starter[$n]})"; done
  exit 0
fi

units_ok "${picked[0]}" || exit 1
index_gate
start_cycles
exit $?
