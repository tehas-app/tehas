#!/usr/bin/env bash
# One poll of the queue: tehasbot dispatch. console/src/run.rs loads the settings
# and runs tehas-dispatch, console/src/usage/dispatch.txt is its text. Only a path:
# test/dispatch_guard_test.sh runs a copy of this file for the tehas-dispatch
# beside it, and install.sh takes a home with env.sh and this file for tehas's.
#
# Exit: the command's; 78 no console.
here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
console=${TEHAS_SETTINGS_CMD:-$here/console}
[ -x "$console" ] || { echo "tehas: no console at $console to load the settings: run install.sh" >&2; exit 78; }
exec "$console" run "$here" "$EUID" "$BASH" tehasbot dispatch "$@"
