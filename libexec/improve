#!/usr/bin/env bash
# One run of the improvement loop: read the cycles that ended since the last
# run, ask a model what could be better, and file one issue per finding that
# is not already in the issue stack.
#
# The findings are about the factory and about pi-rukas, so pi-rukas does not
# run here: the analyst is plain Pi with one prompt, lib/improve-prompt.md.
# What it reads holds issue text and model output, which may be written to
# steer it. So it is given the records read-only and one directory to write
# to, and nothing else: no token, no repository, no tool that runs a command
# or opens a connection. This script makes every GitHub call, checks the one
# file the analyst leaves against a fixed shape, and writes the issue itself.
# test/improve_run_test.sh pins what the container is given. It runs in
# tehas.slice, as every sandbox container does, with limits of its own: one
# CPU, 2g of memory and no swap. Without a usable slice a run with records to
# read stops before it calls GitHub, and the records wait.
#
#   records    $TEHAS_HOME/tmp/improve/window/<issue>-<stamp>, written when a
#              cycle ends (lib/improve.sh). A run takes the five oldest and
#              leaves the rest for the next. An analyst stopped at its bound
#              halves that number for the next run, down to one, in
#              state/improve.cap; one that finishes in time doubles it again.
#              What a stopped analyst's file holds is filed, and the records
#              it does not name go back to the window
#   filed      at most 3 issues a run, labelled tehas:improvement; none in a
#              repository where TEHAS_IMPROVE_MAX_OPEN such issues are open,
#              10 unless the instance says otherwise. A finding of the
#              category pi-rukas goes to TEHAS_IMPROVE_RUKAS_REPO where that
#              is set. One of the category boundary is an issue in each, each
#              naming its own half, linked both ways and labelled
#              cross-project too; with no repository for pi-rukas, one issue
#              with both halves. Both repositories are read for duplicates,
#              and each has that limit to itself. With
#              TEHAS_IMPROVE_RUKAS_SKIP=1 a finding of the category pi-rukas
#              is dropped and counted as skipped
#   issues     each filed issue names the product's issues its cycles worked,
#              and says what working on it means: a finding about the factory
#              is built where it is filed, one about pi-rukas is fixed in
#              pi-rukas and never worked around in another repository. The
#              line names the other repository when the finding speaks of
#              issues of one, so a person reading it sees which repository
#              holds the fix. A filed issue whose text names a repository
#              other than the one it is filed in also carries cross-project,
#              which is what the dispatcher holds a cycle back for
#   rechecked  when one of those issues is worked on again, the analyst says
#              whether the problem came back, and that is a comment on the
#              filed issue with the pi-rukas commit the new cycle ran; at most
#              10 a run. Of a closed issue, the comment says whether the
#              commit that closed it is in that build, and "not in this
#              build" rather than "yes" when it is not, or that the build is
#              unknown. Nothing is closed or reopened
#   logs       the whole log of each cycle a finding names, gzipped, as assets
#              of the release tehas-improve-logs; over 5 MB, in numbered pieces
#   removed    a run's records when it finishes; anything in tmp/improve, and
#              the per-cycle files and the kept analyst output in logs/, after
#              seven days
#
# Usage: tehasbot improve     (one line per run on standard output)
#
# Exit: 0 the run finished, also with an analyst stopped at its bound that left
#         a good file, or there was nothing to do, or the loop is off, or a
#         limit holds runs (tehas limit: planning off, expired or unreadable);
#       1 the analyst or GitHub failed and the records were kept; what a
#         failed analyst printed is in logs/improve-analyst-<stamp>.log;
#      64 an argument, this command takes none;
#      78 the instance settings are invalid, or there are records to read and
#         tehas.slice is not usable on this host; the records were kept.
#
# Instance settings: TEHAS_IMPROVE_REPO, the repository issues are filed in.
# Unset, the loop is off. TEHAS_IMPROVE_RUKAS_REPO, optional, the repository
# for what only a change in pi-rukas can fix. TEHAS_IMPROVE_RUKAS_SKIP, 1 to
# file no such finding at all. TEHAS_IMPROVE_MAX_OPEN, how many
# of the loop's issues may be open in one repository. TEHAS_REPO, the product a cycle
# worked on. PI_ENSEMBLE_SUBAGENT_MODEL and
# PI_ENSEMBLE_SUBAGENT_PROVIDER, the model that reads.
set -uo pipefail

[ "$#" = 0 ] || { echo "usage: tehasbot improve" >&2; exit 64; }

here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source=lib/config.sh
. "$here/../lib/config.sh"
# shellcheck source=lib/sandbox.sh
. "$here/../lib/sandbox.sh"
# shellcheck source=lib/improve.sh
. "$here/../lib/improve.sh"
# shellcheck source=lib/slice.sh
. "$here/../lib/slice.sh"
# shellcheck source=lib/status.sh
. "$here/../lib/status.sh"
# shellcheck source=lib/limit.sh
. "$here/../lib/limit.sh"
tehas_load || exit 78
if ! tehas_improve_on; then
  echo "tehas improve: TEHAS_IMPROVE_REPO is not set, the improvement loop is off"
  exit 0
fi
tehas_require TEHAS_REPO PI_ENSEMBLE_SUBAGENT_MODEL PI_ENSEMBLE_SUBAGENT_PROVIDER

repo=$TEHAS_IMPROVE_REPO
rukas=${TEHAS_IMPROVE_RUKAS_REPO:-$repo}
repos=("$repo")
[ "$rukas" = "$repo" ] || repos+=("$rukas")
label=tehas:improvement
# Not "cross": bash reads an assignment to a name of an arithmetic operator as
# arithmetic, and shellcheck says so.
cross_label=cross-project
tag=tehas-improve-logs
max_run=3
max_open=$TEHAS_IMPROVE_MAX_OPEN
max_recheck=10
chunk=$((5 * 1024 * 1024))
# The analyst's bound, in seconds. A window of nine cycles took 27 minutes,
# so 30 cut off half the runs.
bound=3600
max_take=5
capf=$TEHAS_HOME/state/improve.cap
old=$((7 * 24 * 60)) # minutes
base=$(tehas_improve_dir)
window=$base/window
logs=$TEHAS_HOME/logs
prompt=$here/../lib/improve-prompt.md

say() { printf '%s improve: %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*"; }

[ -r "$prompt" ] || { say "no prompt at $prompt"; exit 1; }
mkdir -p "$window" "$TEHAS_HOME/state" "$logs" || exit 1
exec 9>"$TEHAS_HOME/state/improve.lock"
flock -n 9 || { say "another run is going, leaving it to that one"; exit 0; }

# The records of a run return to the window; the rest of it goes.
give_back() { # <run directory>
  local d
  mkdir -p "$window"
  for d in "$1"/in/cycles/*/; do
    [ -d "$d" ] || continue
    d=${d%/}
    rm -rf "${window:?}/$(basename "$d")"
    mv "$d" "$window/"
  done
  rm -rf "$1"
}

# --- Sweep -------------------------------------------------------------------
# A run directory here was left by a run that was killed: this one holds the
# lock. Then whatever is over seven days old goes, analysed or not.
for d in "$base"/run-*/; do
  [ -d "$d" ] && give_back "${d%/}"
done
find "$window" -mindepth 1 -maxdepth 1 -mmin "+$old" -exec rm -rf {} +
find "$base" -mindepth 1 -maxdepth 1 -name '.new.*' -mmin "+$old" -exec rm -rf {} +

# --- Look --------------------------------------------------------------------
# The records in a directory, by name. Anything else there is removed.
recs=()
look() { # <directory>
  local d r
  recs=()
  for d in "$1"/*/; do
    [ -d "$d" ] || continue
    d=${d%/}
    r=$(basename "$d")
    if [[ $r =~ ^[0-9]+-[0-9]{6}-[0-9]{6}$ ]]; then recs+=("$r"); else rm -rf "$d"; fi
  done
}
look "$window"
[ "${#recs[@]}" -gt 0 ] || { say "cycles=0, nothing to read"; exit 0; }

# A run is held, as a planning turn is, by a limit with planning off and by
# one that expired or cannot be read (tehas limit). The records wait.
limit=$(tehas_limit_read)
if tehas_limit_holds "$limit" || [ "$(jq -r .plan <<<"$limit")" = false ]; then
  say "cycles=${#recs[@]}, held by the limit: $(tehas_limit_line "$limit" | sed 's/^limit *//')"
  exit 0
fi

# The analyst runs in the slice or not at all. Asked before GitHub is, and
# only now: a run with nothing to read starts no container.
tehas_slice_ok || { echo "tehas improve: $TEHAS_SLICE_WHY" >&2; exit 78; }

# --- The issue stack ---------------------------------------------------------
stack=$(mktemp "$base/.stack.XXXXXX") || exit 1
trap 'rm -f "$stack" "$stack.open" "$stack.closed" "$stack.all"' EXIT
fields=number,title,state,labels,body
since=$(date -u -d '30 days ago' +%Y-%m-%d)
stack_of() { # <repository>: its open issues and those closed in 30 days
  gh issue list --repo "$1" --state open --limit 500 --json "$fields" >"$stack.open" &&
    gh issue list --repo "$1" --state closed --limit 200 --search "closed:>=$since" \
      --json "$fields" >"$stack.closed" &&
    jq -s --arg repo "$1" 'add | map({repo: $repo, number, title, state, labels: [.labels[].name],
      cycles: [(.body // "") | scan("\\*\\*Cycles:\\*\\* ([^\n]*)") | .[0] | split(", ")[]
        | select(test("^[0-9]+-[0-9]{6}-[0-9]{6}$"))],
      body: ((.body // "")[0:4000])})' "$stack.open" "$stack.closed"
}
got=1
for r in "${repos[@]}"; do stack_of "$r" || got=0; done >"$stack.all"
if [ "$got" = 0 ] || ! jq -s add "$stack.all" >"$stack"; then
  say "cycles=${#recs[@]} failed: GitHub did not give the issue stack, the records wait"
  exit 1
fi
# Each repository has its own limit: one that is full takes no more, and a
# run waits only when every one is.
rooms=$(jq -c --arg l "$label" --argjson max "$max_open" '
  . as $all | [$ARGS.positional[] as $r | {key: $r, value: ([$max - ([$all[]
    | select(.repo == $r and .state == "OPEN" and (.labels | index($l) != null))] | length), 0] | max)}]
  | from_entries' "$stack" --args "${repos[@]}")
if [ "$(jq 'add' <<<"$rooms")" -le 0 ]; then
  say "cycles=${#recs[@]} waiting: $max_open open issues carry $label in ${repos[*]}, the limit of each"
  exit 0
fi

# --- Take the window ---------------------------------------------------------
# The records are moved out one by one and the window stays, so a cycle that
# ends now writes into it for the next run. Renaming the window instead would
# lose a record written between its mkdir and its mv.
stamp=$(date -u +%y%m%d-%H%M%S)
run=$base/run-$stamp
# A cycle may have ended while the stack was fetched: its record comes along.
look "$window"
[ "${#recs[@]}" -gt 0 ] || { say "cycles=0, nothing to read"; exit 0; }
# The oldest first: they are the nearest to the sweep.
cap=$(head -c 8 "$capf" 2>/dev/null)
[[ $cap =~ ^[1-9]$ ]] && [ "$cap" -le "$max_take" ] || cap=$max_take
mapfile -t recs < <(printf '%s\n' "${recs[@]}" | sort -t- -k2,3 | head -n "$cap")
left=$(($(find "$window" -mindepth 1 -maxdepth 1 | wc -l) - ${#recs[@]}))
took=1
if mkdir -p "$run/in/cycles" "$run/out" && mv "$stack" "$run/in/issues.json"; then
  for r in "${recs[@]}"; do mv "$window/$r" "$run/in/cycles/" || took=0; done
else
  took=0
fi
if [ "$took" = 0 ]; then
  [ ! -d "$run" ] || give_back "$run"
  say "cycles=${#recs[@]} failed: could not take the window"
  exit 1
fi
look "$run/in/cycles"
fail() {
  give_back "$run"
  say "cycles=${#recs[@]} failed: $*"
  exit 1
}

# --- The analyst -------------------------------------------------------------
# A run that was killed leaves its container running under this name.
docker rm -f tehas-improve >/dev/null 2>&1 || true
mapfile -d '' -t hosts < <(tehas_sandbox_hosts)
# Its own models.json, on the endpoint picked now, and the tokens it names.
if ! tehas_model_keys_ok || ! tehas_models_resolve "$run/models.json" >/dev/null; then
  fail "no usable $(tehas_models_file): run install.sh"
fi
keys=()
while read -r k; do
  [ -z "$k" ] || [ -z "${!k:-}" ] || keys+=(-e "$k")
done < <(tehas_model_key_names)
ask=$(cat "$prompt")
ask=${ask//@MINUTES@/$((bound / 60))}
# Not given the lock: a client that outlives a killed run would hold it, and
# every later run would stand back until the bound.
timeout -k 60 "$bound" docker run --rm --init --name tehas-improve \
  --cgroup-parent tehas.slice --cpus 1 --memory 2g --memory-swap 2g --pids-limit 1024 --cpu-shares 1024 \
  -e HOME=/home/vscode "${keys[@]}" -w /improve \
  -v "$run/in:/improve/in:ro" -v "$run/out:/improve/out" \
  -v "$run/models.json:/home/vscode/.pi/agent/models.json:ro" \
  "${hosts[@]}" "$PI_ENSEMBLE_IMAGE" \
  pi -p --no-session --no-extensions --no-skills --no-prompt-templates --no-context-files \
  --tools read,grep,find,ls,write \
  --provider "$PI_ENSEMBLE_SUBAGENT_PROVIDER" --model "$PI_ENSEMBLE_SUBAGENT_MODEL" \
  "$ask" >"$run/analyst.log" 2>&1 </dev/null 9>&-
arc=$?
# A client that timeout killed leaves its container working on.
[ "$arc" = 0 ] || docker rm -f tehas-improve >/dev/null 2>&1 || true
notes=()
# 124 is the bound, 137 the kill that follows it when the client did not stop.
# Half of what this run took, not of the cap: fewer records than the cap can
# be too many already. A run in time doubles it rather than going back to
# five at once, which would only hit the bound again.
cut=0
case $arc in
  0) next=$((cap * 2)) ;;
  124 | 137) cut=1 next=$((${#recs[@]} / 2)) ;;
  *) next=$cap ;;
esac
[ "$next" -le "$max_take" ] || next=$max_take
[ "$next" -ge 1 ] || next=1
echo "$next" >"$capf" 2>/dev/null || true
# What the analyst printed goes with the run. Of a run that failed on it, it
# is kept under the run's stamp until the sweep, so a person can still read
# it after later runs.
kept=$logs/improve-analyst-$stamp.log
blame() {
  if cp "$run/analyst.log" "$kept" 2>/dev/null; then
    fail "$*, its output is in $kept"
  fi
  fail "$*"
}
# An analyst stopped at its bound was asked to keep its file up to date, so
# a file that passes the check is filed. Without one, it failed like any other.
why=""
[ "$cut" = 0 ] || why="the analyst ended with $arc at its bound of $((bound / 60)) minutes; the next run takes at most $next; "
[ "$arc" = 0 ] || [ "$cut" = 1 ] || blame "the analyst ended with $arc"

# --- Check -------------------------------------------------------------------
# A link would have this script read a file of the analyst's choosing.
found=$run/out/findings.json
if [ -L "$found" ] || [ ! -f "$found" ]; then blame "${why}the analyst left no findings.json"; fi
[ "$(stat -c %s "$found")" -le 1048576 ] || blame "${why}findings.json is over 1 MB"

# One program decides what is filed. A finding that is not the shape asked
# for is dropped; a file that is not is an error. A title is compared in lower
# case without punctuation, with the open issues and with the findings before
# it. A body without a Done-when section is the wrong shape too: a cycle that
# is given a proposal with no bar to check itself against spends its rounds
# inventing one, so such a finding is counted invalid and not filed. The model's
# body is untrusted, so the section has to hold up when read as markdown: text
# in a code fence or an HTML comment is not a heading and not a bar, and the
# section is the last thing in the body, as the prompt asks.
#
# A recheck is taken only for an issue this loop filed, named by a cycle of
# the same product issue as the new one: the model cannot have a comment put
# anywhere else.
# shellcheck disable=SC2016  # a jq program: the variables are jq's
check='
  def clean($allow): explode | all(.[]; . as $c | ($c >= 32 and $c != 127) or ($allow | index($c) != null));
  def norm: (ascii_downcase | gsub("[^a-z0-9 ]"; "") | gsub(" +"; " ") | sub("^ "; "") | sub(" $"; "")) as $n
    | if $n == "" then . else $n end;
  # Nothing a person can read: spaces, tabs, and the blanks a copy-pasted
  # line or a model can leave behind that no one can see.
  def blank: test("^[ \t\u00a0\u2000-\u200f\u2800\u3000]*$");
  # The line that is "## Done when" and nothing else but spaces around it.
  def heading: test("^[ \t]*##[ ]+Done[ ]+when[ ]*$");
  # Three of either kind, with nothing before them but spaces. A fence holds
  # the text a model pasted in, so what it holds is not markdown: a heading or
  # an item inside one is not a bar. What a fence hides becomes a blank line,
  # so a section hidden by one is not found and text hidden by one is not a
  # bar.
  def fence: test("^[ \t]*(`{3,}|~{3,})");
  def scrub: reduce .[] as $l ({in: false, out: []};
      (if .in then (if ($l | fence) then { in: false, line: "" } else { in: true, line: "" } end)
       else (if ($l | fence) then { in: true, line: "" } else { in: false, line: $l } end) end)
      as $s | { in: $s.in, out: (.out + [$s.line]) }) | .out;
  # The lines a person can read, in $v, and for each one whether it is the
  # heading or an item. The bar is real when there is one heading, the line
  # under it is an item, the last line of the body is an item, and nothing
  # between them is prose or another heading. Counts and index lists only: an
  # and over a filter that can yield nothing reads as true, so each side is a
  # number first.
  def item: test("^[ \t]*[-*][ ]|^[ \t]*[0-9]+[.] ");
  def done_when: gsub("\r"; "") | split("\n") | map(sub("<!--.*$"; "")) | scrub
    | [ .[] | select(blank | not) ] as $v
    | ($v | length) as $n
    | ([ range(0; $n) as $i | ($v[$i] | heading) ]) as $hd
    | (([ $hd[] | select(.) ]) | length) as $heads
    | ([ $hd | to_entries[] | select(.value) | .key ]) as $hi
    | ([ $hd | to_entries[] | select((.value | not) and ($v[.key] | item)) | .key ]) as $all
    | ([ $all[] | select(. > $hi[0]) ]) as $ii
    | (([ range(($hi[0] + 1); $n) as $j
         | ($v[$j] | item) | if . then 0 else 1 end ] | add) // 0) as $stray
    | ($heads == 1) and (($ii | length) >= 1) and ($ii[0] == ($hi[0] + 1))
      and ($ii[-1] == ($n - 1)) and ($stray == 0);
  def valid($numbers):
    type == "object"
    and (.title | type == "string" and length >= 1 and length <= 100 and clean([]))
    and (.category | type == "string" and IN("dispatcher", "cycle", "pi-rukas", "console", "gate", "docs", "boundary"))
    and (.category != "boundary" or all(.factory_part, .rukas_part;
      type == "string" and length >= 1 and length <= 3000 and clean([9, 10, 13])))
    and (.body | type == "string" and length >= 1 and length <= 6000 and clean([9, 10, 13]) and done_when)
    and (.evidence | type == "string" and length <= 3000 and clean([9, 10, 13]))
    and (.cycles | type == "array" and length >= 1 and all(.[]; type == "string" and IN($cycles[])))
    and (.duplicate_of == null or (.duplicate_of | IN($numbers[])));
  # The stack repositories a finding speaks of: named as owner/name: anywhere in
  # its text, or named by an issue of the stack that cites one of its cycles and
  # is filed in a repository beside the one the finding is filed in. That
  # citation is the strongest tell there is, since the finding rests on a cycle
  # whose issue is open there, and the loop writes it itself on the Cycles line,
  # so a model cannot word a finding into it or out of it.
  def speaks($f; $repos; $cited):
    [ $repos[] | . as $r
      | select(([$f.title, $f.body, $f.evidence,
                 (if ($f | has("factory_part")) then $f.factory_part else "" end),
                 (if ($f | has("rukas_part")) then $f.rukas_part else "" end)]
                | join("\n") | contains("\($r):"))
              or
              ([$f.cycles[]] | any(. as $c | any($cited[]; .r == $r and .c == $c)))) ];
  # Every pair of a stack repository and a cycle its issues cite, as the issue
  # itself carries them: the Cycles line of its body, read by stack_of above.
  # A repository the host names but holds no issue in is a stack repository
  # still, so the pairs are not the test of it. The repository is cut out of the
  # pair here, in $r, so the test of a name in the text of a finding and the
  # test of the citation share it; jq reads a filter that cannot be reached as
  # written, and the two are joined by or.
  def cited_by($issues): [ $issues[]
    | select((.repo | type) == "string") | . as $i | (.cycles // [])[]
    | select(type == "string") | {r: $i.repo, c: .} ] | unique;
  def rechecked($issues):
    type == "object"
    and (.repo | type == "string") and (.number | type == "number")
    and (.cycle | type == "string" and IN($cycles[]))
    and (.seen | type == "boolean")
    and (.note | type == "string" and length >= 1 and length <= 1500 and clean([9, 10, 13]))
    and (. as $u | any($issues[]; .repo == $u.repo and .number == $u.number
      and (.labels | index($label) != null) and (.cycles | index($u.cycle) == null)
      and any(.cycles[]; split("-")[0] == ($u.cycle | split("-")[0]))));
  if type == "object" and (.findings | type == "array") then . else error("not the shape asked for") end
  | $stack[0] as $issues
  | ($issues | map(select(.state == "OPEN") | .title | norm)) as $open
  | ($issues | map(.number)) as $numbers
  | .findings as $all
  | [$all[] | select(valid($numbers))] as $valid
  | [$valid[] | select($skip_rukas == "0" or .category != "pi-rukas")] as $good
  | (reduce ($good[] | select(.duplicate_of == null)) as $f ({seen: $open, keep: []};
      ($f.title | norm) as $t
      | if (.seen | index($t)) != null then . else {seen: (.seen + [$t]), keep: (.keep + [$f])} end)
    | .keep) as $keep
  | (reduce $keep[] as $f ({room: $rooms, left: $max_run, file: []};
      (if $f.category == "pi-rukas" then [$rukas] elif $f.category == "boundary" then [$repo, $rukas] | unique
       else [$repo] end) as $to
      | if .left >= ($to | length) and all($to[] as $r | .room[$r]; . > 0)
        then reduce $to[] as $r (.; .room[$r] -= 1) | .left -= ($to | length) | .file += [$f] else . end)
    | .file) as $file
  # The repositories of the stack, as the host read them: a text that names one
  # of them is the tell of where the fix of a finding lives, so it needs no name
  # the model typed and no url it could invent. Every repository the loop files
  # in is a stack repository whether or not TEHAS_IMPROVE_RUKAS_REPO names it,
  # so a finding about pi-rukas in a host that files it with the rest is read
  # the same way. The repository for pi-rukas is a stack repository of its own
  # even where its findings are not filed, since the text of a finding names it
  # all the same and the label is about where the fix lives, not where an issue
  # about it went.
  | (($issues | map(.repo) | map(select(type == "string"))) + [$repo, $rukas]
     | unique) as $stack_repos
  # Each finding of $file with the stack repositories it speaks of beside it, as
  # others. Beside the finding and not in it: the shape of a finding is what the
  # analyst was asked for and is checked exactly as it was given.
  | [ $file[] | . as $f | . + {others: speaks($f; $stack_repos; cited_by($issues))} ] as $filed
  | {found: ($all | length), invalid: (($all | length) - ($valid | length)),
     skipped: (($valid | length) - ($good | length)),
     duplicates: (($good | length) - ($keep | length)),
     of: ([$good[] | .duplicate_of | select(. != null) | "#\(.)"] | unique | join(",")),
     over: (($keep | length) - ($file | length)),
     file: $filed,
     recheck: ([(.followups | if type == "array" then .[] else empty end) | select(rechecked($issues))
       | {repo, number, cycle, seen, note}] | unique_by([.repo, .number, .cycle]) | .[0:$max_recheck])}'
cycles=$(printf '%s\n' "${recs[@]}" | jq -R . | jq -s -c .)
plan=$(jq -c --argjson cycles "$cycles" --argjson rooms "$rooms" --argjson max_run "$max_run" \
  --arg repo "$repo" --arg rukas "$rukas" --arg label "$label" --arg skip_rukas "$TEHAS_IMPROVE_RUKAS_SKIP" \
  --argjson max_recheck "$max_recheck" --slurpfile stack "$run/in/issues.json" \
  "$check" "$found" 2>/dev/null) || blame "${why}findings.json is not the shape asked for"
skipped=$(jq .skipped <<<"$plan")
[ "$skipped" = 0 ] || notes+=("skipped=$skipped")

# Of a stopped analyst, a record that a finding or a followup names, valid or
# not, was read; the rest may not have been and go back for a later run.
if [ "$cut" = 1 ]; then
  named=$(jq -r '[(.findings | arrays | .[] | objects | .cycles | arrays | .[]),
    (.followups | arrays | .[] | objects | .cycle)] | .[] | strings' "$found" 2>/dev/null)
  back=0
  mkdir -p "$window"
  for r in "${recs[@]}"; do
    grep -qxF -- "$r" <<<"$named" && continue
    rm -rf "${window:?}/$r"
    mv "$run/in/cycles/$r" "$window/" && back=$((back + 1))
  done
  notes+=("stopped=$arc" "returned=$back")
  cp "$run/analyst.log" "$kept" 2>/dev/null && notes+=("output=$kept")
fi

# --- File --------------------------------------------------------------------
release() {
  gh release view "$tag" --repo "$repo" >/dev/null 2>&1 ||
    gh release create "$tag" --repo "$repo" --prerelease --title "Cycle logs of the improvement loop" \
      --notes "The whole logs of the cycles that issues labelled $label refer to." >/dev/null 2>&1
}
# Pack and upload the whole log of one cycle, once a run. What the issue says
# about it is left in up/<record>.links.
upload() { # <record>
  local rec=$1 raw=$logs/work-$1.jsonl dir=$run/up/$1 name=ticket-$1.log out=$run/up/$1.links f
  [ ! -f "$out" ] || return 0
  mkdir -p "$dir" || return 1
  if [ ! -f "$raw" ]; then
    echo "- \`$rec\`: the log is no longer on the host" >"$out"
    return 0
  fi
  cat "$raw" >"$dir/$name"
  [ ! -f "$raw.err" ] || cat "$raw.err" >>"$dir/$name"
  if tehas_improve_secret "$dir/$name"; then
    echo "- \`$rec\`: not uploaded, the log holds something shaped like a token" >"$out"
    notes+=("secret-shape=$rec")
    return 0
  fi
  if ! tehas_improve_pack "$dir/$name" "$dir/gz" "$name" "$chunk"; then
    echo "- \`$rec\`: not uploaded, the log could not be packed" >"$out"
    notes+=("not-packed=$rec")
    return 0
  fi
  if ! release || ! gh release upload "$tag" "$dir"/gz/*.gz --repo "$repo" --clobber >/dev/null 2>&1; then
    echo "- \`$rec\`: the log could not be uploaded" >"$out"
    notes+=("not-uploaded=$rec")
    return 0
  fi
  printf '%s\n' "$dir"/gz/*.gz | sort -V | while IFS= read -r f; do
    f=$(basename "$f")
    echo "- [$f](https://github.com/$repo/releases/download/$tag/$f)"
  done >"$out"
}

# The body is this script's: the model's text goes in with every mention
# broken and every HTML comment shown, and its evidence inside a fence it
# cannot close.
# shellcheck disable=SC2016  # a jq program: the variables are jq's
body='
  def defuse: gsub("@(?=[A-Za-z0-9])"; "@\u200b") | gsub("<!--"; "&lt;!--");
  "_Filed by the tehas improvement loop, read by the model `\($model)`. It is a proposal: nothing works on it until a person labels it._",
  "", "**Category:** \(.category)", "", "**Working on it:** \($does)",
  # Where else the fix lives, when the finding speaks of a repository of the
  # stack beside the one this issue is filed in. A person reads it before
  # labelling; the dispatcher holds a cycle back on the label that goes with it.
  # The list is given in, and not read from the finding: it is the loop that
  # reads the stack, and what the loop read is what a person can trust.
  (if $others == "" then empty else "", "**Names:** \($others)" end), "",
  "**Issues:** \([.cycles[] | "\($product)#\(split("-")[0])"] | unique | join(", "))", "", (.body | defuse), "",
  (if .category != "boundary" then empty
   elif $half == "both" then "**The factory\u0027s half**", "", (.factory_part | defuse), "",
     "**The half for pi-rukas**", "", (.rukas_part | defuse), ""
   else "**This repository\u0027s half**", "", (if $half == "factory" then .factory_part else .rukas_part end | defuse), "",
     "**The other half**, filed in \($other_repo)\(if $other == "" then "" else ": \($other)" end)", "",
     (if $half == "factory" then .rukas_part else .factory_part end | defuse), "" end),
  "**Evidence**", "", "````text", (.evidence | gsub("`{3,}"; "\u0027\u0027\u0027")), "````", "",
  "**Cycles:** \(.cycles | unique | join(", "))", "", "**Whole logs**", "", ($links | rtrimstr("\n"))'

filed=()
failed=0
n=$(jq '.file | length' <<<"$plan")
if [ "$n" -gt 0 ]; then
  # It fails when the label is there already, which is fine.
  for r in "${repos[@]}"; do
    gh label create "$label" --repo "$r" --color 5319e7 \
      --description "Tehas: filed by the improvement loop, a proposal" >/dev/null 2>&1 || true
  done
fi
# The label that says a cycle here cannot make the change on its own is created
# wherever an issue of this run carries it: beside the loop's own label on the
# two halves of a boundary finding, and on any other finding whose text names a
# repository the loop knows of besides the one the issue is filed in.
if jq -e '[.file[] | select((.category == "boundary") or (((.others // []) | map(select(type == "string"))) | length > 0))]
  | length > 0' <<<"$plan" >/dev/null; then
  for r in "${repos[@]}"; do
    gh label create "$cross_label" --repo "$r" --color 0e8a16 \
      --description "Needs a change on both sides of the factory and pi-rukas" >/dev/null 2>&1 || true
  done
fi
# open_issue <repository> <working on it> <half> <other repository> <other url> <label>...
# Open one issue of the finding $f; its url is left in $url.
open_issue() {
  local to=$1 does=$2 half=$3 other_repo=$4 other=$5 opts=() l others
  shift 5
  for l in "$@"; do opts+=(--label "$l"); done
  # The stack repositories the finding speaks of, none of them this one. A
  # comma-separated list is what the body wants, so they are joined here; the
  # plan always carries the list, never a bare repository name.
  others=$(jq -r --arg to "$to" '[(.others // [])[] | select(type == "string") | select(. != $to)] | join(", ")' <<<"$f") || return 1
  jq -r --arg links "$links" --arg model "$PI_ENSEMBLE_SUBAGENT_MODEL" --arg product "$TEHAS_REPO" \
    --arg does "$does" --arg half "$half" --arg other_repo "$other_repo" --arg other "$other" \
    --arg others "$others" \
    "$body" <<<"$f" >"$run/body.md" || return 1
  url=$(gh issue create --repo "$to" --title "$(jq -r .title <<<"$f")" --body-file "$run/body.md" "${opts[@]}") ||
    return 1
  # A number alone is an issue of TEHAS_IMPROVE_REPO.
  if [ "$to" = "$repo" ]; then filed+=("#${url##*/}"); else filed+=("$to#${url##*/}"); fi
}
for ((i = 0; i < n; i++)); do
  f=$(jq -c ".file[$i]" <<<"$plan")
  links=""
  while IFS= read -r rec; do
    upload "$rec" || fail "could not write under $run"
    links+=$(cat "$run/up/$rec.links")$'\n'
  done < <(jq -r '.cycles | unique | .[]' <<<"$f")
  # The body is what a cycle is given as its task, so it says whose fix it is.
  category=$(jq -r .category <<<"$f")
  # A finding that speaks of a repository besides the one its issue is filed in
  # carries cross-project beside the loop's own label, whether or not its
  # category chose two repositories already. The label is the dispatcher's tell
  # that one cycle here cannot make the change on its own; the body names the
  # repository it has to make it in.
  cross_opts=()
  [ "$category" = boundary ] && cross_opts+=("$cross_label")
  to=$repo
  [ "$category" != pi-rukas ] || to=$rukas
  if [ "$(jq -r --arg to "$to" '[(.others // [])[] | select(type == "string") | select(. != $to)] | length > 0' <<<"$f")" = true ]; then
    cross_opts+=("$cross_label")
  fi
  if [ "$category" = boundary ] && [ "$rukas" != "$repo" ]; then
    # One issue a side, each naming its own half; the second links the first
    # in its body, the first is told of the second in a comment. When the
    # second is refused, the first says so: its title keeps a later run from
    # filing the pair again, so a person files the other half.
    open_issue "$repo" "This is the factory's half of a problem at the boundary with pi-rukas. Only that half is fixed in this repository, once a person applies \`tehas:ready\`. The half for pi-rukas is filed in $rukas and is not worked around here." \
      factory "$rukas" "" "$label" "${cross_opts[@]}" || { failed=1; break; }
    first=$url
    if ! open_issue "$rukas" "This is the half for pi-rukas of a problem at the boundary with the factory that runs it. Only that half is fixed here; the factory's half is filed in $repo. Nothing starts until a person applies \`tehas:ready\`." \
      rukas "$repo" "$first" "$label" "${cross_opts[@]}"; then
      gh issue comment "${first##*/}" --repo "$repo" --body "GitHub refused the half for pi-rukas, so it is not filed in $rukas, and the loop will not file it again. Until a person files it there from the text above, this issue stands alone." >/dev/null 2>&1 ||
        notes+=("not-corrected=#${first##*/}")
      notes+=("half-filed=#${first##*/}")
      failed=1
      break
    fi
    gh issue comment "${first##*/}" --repo "$repo" --body "The half for pi-rukas is filed as $url." >/dev/null 2>&1 ||
      notes+=("not-linked=#${first##*/}")
    continue
  fi
  if [ "$category" = boundary ]; then
    open_issue "$repo" "This is a problem at the boundary between the factory and pi-rukas, and this repository is not pi-rukas. A cycle here fixes only the factory's half, once a person applies \`tehas:ready\`; for the half for pi-rukas it changes no code and writes down what has to change there." \
      both "" "" "$label" "${cross_opts[@]}" || { failed=1; break; }
    continue
  fi
  to=$repo
  does="This is a problem in the factory. It is fixed in this repository: a cycle builds the fix once a person applies \`tehas:ready\`."
  if [ "$category" = pi-rukas ]; then
    to=$rukas
    does="This is a problem in pi-rukas. It is fixed here, in pi-rukas, and not worked around in $TEHAS_REPO. Nothing starts until a person applies \`tehas:ready\`. When a host runs the fix and one of the issues below is worked on again, the loop says here whether the problem came back."
    [ "$to" != "$repo" ] ||
      does="This is a problem in pi-rukas, and this repository is not pi-rukas. A cycle here cannot fix it and must not work around it: it changes no code, writes down what has to change in pi-rukas, and hands off."
  fi
  open_issue "$to" "$does" "" "" "" "$label" "${cross_opts[@]}" || { failed=1; break; }
done
issues=none
[ "${#filed[@]}" = 0 ] || issues=$(IFS=,; echo "${filed[*]}")
[ "$failed" = 0 ] || fail "GitHub refused an issue; filed before that: $issues"

# --- Recheck -----------------------------------------------------------------
# A comment that GitHub refuses is noted and the run goes on: its findings are
# filed, and a second run would file nothing new and lose the records anyway.
#
# Before it says "seen again" of a closed issue, the comment says whether the
# fix was in the build the cycle ran. The fix is the commit GitHub closed the
# issue with; the build is the commit the runner's result named (buildCommit),
# else, for a record written before tehas kept it, the image label's. Only for
# an issue of TEHAS_IMPROVE_RUKAS_REPO: the record names no commit of the
# factory.
# Without a build, or without an answer, the comment says the build is
# unknown rather than claim either.

# fix_of <repository> <number>: the commit of the last close, when a commit
# closed it. Nothing for an issue closed by hand.
fix_of() {
  local c
  c=$(gh api --paginate "repos/$1/issues/$2/events" \
    --jq '.[] | select(.event == "closed") | .commit_id // "-"' 2>/dev/null | tail -n 1)
  [[ $c =~ ^[0-9a-f]{40}$ ]] && printf '%s\n' "$c"
  return 0
}
# in_build <repository> <fix> <build>: yes, no or unknown. GitHub's compare
# answers what git merge-base --is-ancestor <fix> <build> would; the host
# keeps no clone of pi-rukas.
in_build() {
  local st
  st=$(gh api "repos/$1/compare/$2...$3" --jq .status 2>/dev/null) || st=""
  case $st in
    identical | ahead) echo yes ;;
    behind | diverged) echo no ;;
    *) echo unknown ;;
  esac
}
# shellcheck disable=SC2016  # a jq program: the variables are jq's
comment='
  def defuse: gsub("@(?=[A-Za-z0-9])"; "@\u200b") | gsub("<!--"; "&lt;!--");
  "_The tehas improvement loop, read by the model `\($model)`. A model wrote this: check it against the log._", "",
  "\($product)#\(.cycle | split("-")[0]) was worked on again: cycle `\(.cycle)`, with pi-rukas at \(if $rukas == "" then "a commit the record does not name" else "`\($rukas)`" end)\(if $image == "" then "" else ", image `\($image)`" end).", "",
  ($fix[0:12]) as $f | ($build[0:12]) as $b | (if .seen then "yes" else "no" end) as $said
  | "**Seen again:** \(if $fix == "" then $said
      elif $in == "yes" then "\($said), with the fix `\($f)` in this build"
      elif $in == "no" and .seen then "not in this build: the fix `\($f)` is not in `\($b)`, so this cycle ran without it"
      elif $in == "no" then "no, though the fix `\($f)` is not in `\($b)`"
      elif $build == "" then "\($said), build unknown: the record names no commit of \(.repo) that this cycle ran, so whether the fix `\($f)` was in it is not known"
      else "\($said), build unknown: GitHub did not say whether the fix `\($f)` is in `\($b)`" end)", "",
  (.note | defuse), "",
  "**Whole log**", "", ($links | rtrimstr("\n"))'
rechecked=0
n=$(jq '.recheck | length' <<<"$plan")
for ((i = 0; i < n; i++)); do
  f=$(jq -c ".recheck[$i]" <<<"$plan")
  rec=$(jq -r .cycle <<<"$f")
  to=$(jq -r '"\(.repo)#\(.number)"' <<<"$f")
  upload "$rec" || fail "could not write under $run"
  rukas_at=$(jq -r '[.buildCommit, .rukas] | map(strings | select(test("^[0-9a-f]{7,40}$"))) | first // ""' \
    "$run/in/cycles/$rec/cycle.json" 2>/dev/null) || rukas_at=""
  image_at=$(jq -r '.image // "" | if type == "string" and test("^sha256:[0-9a-f]{64}$") then . else "" end' \
    "$run/in/cycles/$rec/cycle.json" 2>/dev/null) || image_at=""
  fix="" build="" in=""
  state=$(jq -r --arg r "${to%#*}" --argjson n "${to##*#}" \
    '[.[] | select(.repo == $r and .number == $n) | .state][0] // ""' "$run/in/issues.json" 2>/dev/null) || state=""
  [ "$state" != CLOSED ] || fix=$(fix_of "${to%#*}" "${to##*#}")
  if [ -n "$fix" ]; then
    [ "$rukas" = "$repo" ] || [ "${to%#*}" != "$rukas" ] || build=$rukas_at
    in=unknown
    [ -z "$build" ] || in=$(in_build "${to%#*}" "$fix" "$build")
  fi
  jq -r --arg links "$(cat "$run/up/$rec.links")" --arg model "$PI_ENSEMBLE_SUBAGENT_MODEL" \
    --arg product "$TEHAS_REPO" --arg rukas "$rukas_at" --arg image "$image_at" \
    --arg fix "$fix" --arg build "$build" --arg in "$in" "$comment" <<<"$f" >"$run/body.md"
  if gh issue comment "${to##*#}" --repo "${to%#*}" --body-file "$run/body.md" >/dev/null 2>&1; then
    rechecked=$((rechecked + 1))
  else
    notes+=("not-commented=$to")
  fi
done

# --- Clean up ----------------------------------------------------------------
rm -rf "$run"
[ "$left" -le 0 ] || notes+=("left=$left")
say "cycles=${#recs[@]} $(jq -r '"findings=\(.found) invalid=\(.invalid) duplicates=\(.duplicates) of=\(if .of == "" then "none" else .of end) over=\(.over)"' <<<"$plan") filed=${#filed[@]} issues=$issues rechecked=$rechecked${notes[*]:+ ${notes[*]}}"
