#!/usr/bin/env bash
# Take tehas's state labels off closed issues, and put tehas:shipped on the
# ones a merged pull request closed. A label that says a closed issue awaits a
# merge, or waits for a cycle, is wrong on the issue page, in label searches
# and on the dashboard's links. tehas dispatch runs this once a poll, after the
# rest of the poll, and passes on --dry-run.
#
# Usage:
#   tidy               take the state labels off closed issues, and put
#                      tehas:shipped on the ones a merged pull request closed
#   tidy --dry-run     say what it would change, change nothing
#   tidy -h|--help     print this text and exit 0
#
# Exit: 0 nothing was left to remove, or all of it came off; 1 the search
# failed, timed out or could not be read, or a label change failed (each is
# logged, and the issues after it are still tidied); 64 an argument this
# command does not know; 78 instance settings are missing or malformed.
#
# The console holds the rule (console/src/tidy.rs; the read's answer is
# console/src/shipped.rs's): which names are state labels, which come off, and
# whether the read of what closed them is asked about. This command checks the
# settings, makes the two searches and makes the edits. tehas:shipped, the label
# of a merge, needs-human-attention and the labels a person chooses never come
# off. tehasbot status gives the same label from the same read, and tidy logs it.
#
# Instance settings (lib/config.sh): TEHAS_REPO, whose closed issues are tidied,
# and TEHAS_CONTROL_ISSUE, which takes no label: it is not work.
set -uo pipefail

show_usage() {
  sed -n '2,/^[^#]/p' "$0" | sed -n '/^#/s/^# \{0,1\}//p'
}
unknown_argument() {
  printf 'tehas tidy: unknown argument: %s\n' "$1" >&2
  show_usage >&2
  exit 64
}

dry=0
if [ "$#" -gt 0 ]; then
  case "$1" in
    -h | --help)
      [ "$#" = 1 ] || unknown_argument "$2"
      show_usage
      exit 0
      ;;
    --dry-run) dry=1 ;;
    *) unknown_argument "$1" ;;
  esac
fi
[ "$#" -le 1 ] || unknown_argument "$2"

here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source=lib/config.sh
. "$here/../lib/config.sh"
# shellcheck source=lib/cycles.sh
. "$here/../lib/cycles.sh"
# shellcheck source=lib/shipped.sh
. "$here/../lib/shipped.sh"
tehas_load || exit 78
tehas_require TEHAS_REPO TEHAS_CONTROL_ISSUE
console=$here/console
[ -x "$console" ] || { printf 'tehas tidy: no console beside this command at %s, run install.sh\n' "$console" >&2; exit 78; }
repo=$TEHAS_REPO
wait=${TEHAS_TIDY_WAIT:-60}
[[ $wait =~ ^[1-9][0-9]{0,4}$ ]] || { tehas_err "TEHAS_TIDY_WAIT is not a number of seconds: $wait"; exit 78; }
# The same bound covers the calls of the console beside the command: a console
# that stops answering holds the poll, and the poll's lock with it, the way a
# hung gh call would. A console is a build of this checkout and answers at once,
# so the bound is a ceiling and not a wait anyone tunes.
console_wait=${TEHAS_CONSOLE_WAIT:-30}
[[ $console_wait =~ ^[1-9][0-9]{0,3}$ ]] || console_wait=30
control=$TEHAS_CONTROL_ISSUE

log() { printf '%s %s\n' "$(date -u +%FT%TZ)" "$*"; }

# One search a poll, the most recently updated first: the closed issues that carry
# a state label, up to the page of the read, the rest on later polls. The names and
# the page come from the console that reads the plan below, so the three cannot drift
# apart: `states` prints one name a line, the labels to take off and tehas:shipped
# last of all, and the search is made for the names before it - a search for the
# label of a merge alone would take it off the closed issues of a merge. A new state
# label joins that list on purpose, and console/src/tidy.rs pins it. Each call of the
# poll may take TEHAS_TIDY_WAIT seconds [60, from the environment] and none is retried.
if ! all=$(timeout -k 1 "$console_wait" "$console" tidy states 2>&1) || [ -z "$all" ]; then
  printf 'tehas tidy: the console names no state labels, run install.sh\n' >&2
  exit 78
fi
# The last name of the list is the label tidy gives and never takes off
# (console/src/tidy.rs), so it is out of the search: a search that named it
# would take the label of a merge off the closed issues of a merge.
states=${all%$'\n'*}
[ -n "$states" ] || { printf 'tehas tidy: the console names no state labels\n' >&2; exit 78; }
# The ceiling of the list one read may name and the name of the label of a
# merge, both from the console that reads the plan below: the page of the query
# it prints, and the one word it compares, so none of the three can drift apart.
# The console alone says what a page is - it refuses 0, a padded number and a
# page past its own query - so nothing is re-checked here.
call() { timeout -k 1 "$console_wait" "$console" "$@"; }
page=$(call shipped page 2>&1) || page=""
[[ $page =~ ^[0-9]+$ ]] || { printf 'tehas tidy: the console gave no page\n' >&2; exit 78; }
shipped_label=$(call shipped label 2>/dev/null) || shipped_label=
shipped_label=${shipped_label:-$tehas_shipped_label}
# GitHub reads labels joined by commas as any of them. Each name is read whole
# into one term of the search, so a name that spells oddly is still one term on
# the way to GitHub.
query=label:
while IFS= read -r name; do
  [ -n "$name" ] || continue
  query=$query'"'"$name"'",'
done <<<"$states"
query=${query%,}

# An empty answer is a poll with nothing to tidy; an answer that is no list of
# issues at all is a failed search, which is what `console tidy plan` answers
# with 1 for. Its words are the console's own reason, kept for the log.
search_failed() { log "WARN: tidy: the search for closed issues with state labels failed"; exit 1; }
found=$(timeout -k 1 "$wait" gh issue list --repo "$repo" --state closed --search "$query" \
  --limit "$page" --json number,state,labels 2>/dev/null) || search_failed
if ! plan=$(call tidy plan --control "$control" "$page" <<<"$found" 2>&1); then
  log "WARN: tidy: the console could not read the answer of the search as a list of issues: $plan"
  exit 1
fi

# One line per closed issue with a state label to take off, as the console made
# it: the number, its state labels joined by one space, whether it already
# carries the label of a merge, and whether the closer read is asked about it.
# Every name of the second field is a state label of the console's and nothing
# else, so it is safe to pass to the edit and to write to the log.
#
# Each issue is probed for its cycle once, before the read is asked, and the
# locked issues are dropped here: the page of the read is spent only on issues
# the poll can act on, so a waiting issue takes no candidate's place. The two
# passes below read the verdict instead of taking the lock a second time, and
# each numbers a closed issue by its digits alone, which is what makes the
# number a key of the two arrays.
declare -A skip asked
numbers=""
ask_count=0
while IFS=$'\t' read -r n off carries ask; do
  [[ $n =~ ^[0-9]+$ ]] || continue
  tehas_cycle_running "$n" && { skip["$n"]=1; continue; }
  [ "$ask" = yes ] || continue
  asked["$n"]=1
  ask_count=$((ask_count + 1))
  numbers=$numbers" number:$n"
done <<<"$plan"

# Whether a closed issue was closed by a merge comes from the read of
# lib/shipped.sh - one GraphQL search a poll, not one per issue, and only for
# the issues the plan said may still earn the label. GitHub caps the terms of a
# search, so past the page it would answer nothing at all and those issues wait
# for a later poll. console/src/shipped.rs draws the verdict of the whole read
# into `close_read`: 0 answered, 1 no answer at all, and nothing is labelled on
# a guess.
shipped=""
close_read=0
if [ -n "$numbers" ]; then
  # shellcheck disable=SC2016  # $q is a GraphQL variable
  if ! closers=$(timeout -k 1 "$wait" gh api graphql -f q="repo:$repo is:issue is:closed$numbers" \
    -f query="$(tehas_shipped_query "$console")" 2>/dev/null); then
    close_read=1
  elif ! shipped=$(printf '%s' "$closers" |
    tehas_shipped_numbers "$console" --control "$control" 2>/dev/null); then
    # An empty list of a whole answer is a poll that shipped nothing, which is no
    # failure; no list at all is a read that failed.
    tehas_shipped_whole "$console" "$closers" || close_read=1
  fi
  # A read that did not answer is one line for the poll: the state labels still
  # go and no label is earned, but the log does not call it "no merged closer".
  [ "$close_read" = 0 ] || log "WARN: tidy: the read of what closed these issues failed, $shipped_label was not added for $ask_count issues"
fi

rc=0
while IFS=$'\t' read -r n off carries ask; do
  [[ $n =~ ^[0-9]+$ ]] || continue
  [ "${skip["$n"]:-}" = 1 ] && continue
  # A merge is what earns the label. The answer says which of the issues the read
  # was asked about earned it; one past the page was never asked, and is no more
  # labelled than one it answered for. Only a read that answered for the whole
  # poll says anything per issue: a failed read said so once, and repeats of it
  # read as 100 issues a person closed by hand.
  ship=0
  if [ "$close_read" = 0 ] && [ "${asked["$n"]:-}" = 1 ]; then
    if printf '%s\n' "$shipped" | grep -qxF -- "$n"; then
      ship=1
    else
      log "WARN: tidy #$n: no merged pull request was read as the closer, $shipped_label was not added"
    fi
  fi
  if [ "$dry" = 1 ]; then
    log "tidy #$n: would remove $off"
    if [ "$ship" = 1 ]; then log "tidy #$n: would add $shipped_label"; fi
    continue
  fi
  args=()
  # shellcheck disable=SC2206  # the console joins the labels of one field with spaces
  for l in ${off:-}; do args+=(--remove-label "$l"); done
  if [ "$ship" = 1 ]; then args+=(--add-label "$shipped_label"); fi
  if timeout -k 1 "$wait" gh issue edit "$n" --repo "$repo" "${args[@]}" >/dev/null 2>&1; then
    log "tidy #$n: removed $off"
    if [ "$ship" = 1 ]; then log "tidy #$n: added $shipped_label"; fi
  else
    log "WARN: tidy #$n: could not remove $off"
    rc=1
  fi
done <<<"$plan"
exit "$rc"
