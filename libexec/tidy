#!/usr/bin/env bash
# Take tehas's state labels off closed issues, and put tehas:shipped on the
# ones a merged pull request closed. A label that says a closed issue awaits a
# merge, or waits for a cycle, is wrong on the issue page, in label searches
# and on the dashboard's links. tehas dispatch runs this once a poll, after the
# rest of the poll, and passes on --dry-run.
#
# Usage:
#   tidy               take the state labels off closed issues, and put
#                      tehas:shipped on the ones a merged pull request closed
#   tidy --dry-run     say what it would change, change nothing
#   tidy -h|--help     print this text and exit 0
#
# Exit: 0 nothing was left to remove, or all of it came off; 1 the search
# failed, timed out or could not be read, or a label change failed (each is
# logged, and the issues after it are still tidied); 64 an argument this
# command does not know; 78 instance settings are missing or malformed.
#
# The state labels are those that say work is in progress or waiting:
# tehas:running, tehas:awaiting-merge, tehas:question, tehas:planning,
# tehas:refreshing, tehas:blocked, tehas:ready, tehas:plan and tehas:refine. Not
# tehas:shipped, which tidy adds and never removes: it is the record of a
# merge, not the labels a person chooses (tehas:urgent, tehas:next,
# tehas:prototype and the like), and not needs-human-attention, which nothing
# in tehas removes. A new state label is added to the list on purpose, and
# test/tidy_test.sh pins it.
#
# One search a poll: the closed issues that carry a state label, up to 100,
# the most recently updated first; the rest come on later polls. The search may
# take TEHAS_TIDY_WAIT seconds [60, from the environment], and each label
# change as long. A closed issue whose cycle still holds its lock on this host
# waits for that cycle.
# Each removal is logged as "tidy #N: removed <labels>". When the labels come
# off an issue whose last closed event is a merged pull request, the same edit
# adds tehas:shipped and an extra line says "added tehas:shipped"; a dry run
# says "would add tehas:shipped". The closer is read one GraphQL call per issue
# it tidies, the way libexec/status reads it: the closing pull request is only
# in the issue's closed event. An issue that already carries the label gets no
# second add, and a closer this command cannot read is never taken for a merge:
# the labels still come off, nothing is added, and the issue is logged as a
# WARN.
#
# Instance settings (lib/config.sh): TEHAS_REPO, required.
set -uo pipefail

show_usage() {
  sed -n '2,/^[^#]/p' "$0" | sed -n '/^#/s/^# \{0,1\}//p'
}
unknown_argument() {
  printf 'tehas tidy: unknown argument: %s\n' "$1" >&2
  show_usage >&2
  exit 64
}

dry=0
if [ "$#" -gt 0 ]; then
  case "$1" in
    -h | --help)
      [ "$#" = 1 ] || unknown_argument "$2"
      show_usage
      exit 0
      ;;
    --dry-run) dry=1 ;;
    *) unknown_argument "$1" ;;
  esac
fi
[ "$#" -le 1 ] || unknown_argument "$2"

here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source=lib/config.sh
. "$here/../lib/config.sh"
# shellcheck source=lib/cycles.sh
. "$here/../lib/cycles.sh"
tehas_load || exit 78
tehas_require TEHAS_REPO
repo=$TEHAS_REPO
wait=${TEHAS_TIDY_WAIT:-60}
[[ $wait =~ ^[1-9][0-9]{0,4}$ ]] || { tehas_err "TEHAS_TIDY_WAIT is not a number of seconds: $wait"; exit 78; }

states=(tehas:running tehas:awaiting-merge tehas:question tehas:planning tehas:refreshing tehas:blocked tehas:ready tehas:plan tehas:refine)

log() { printf '%s %s\n' "$(date -u +%FT%TZ)" "$*"; }

# Whether the last closed event of issue $1 is a merged pull request. Anything
# the read cannot answer - no closed event, a person as the closer, a call that
# failed or hung - is a no, so no issue is labelled shipped on a guess.
closed_by_merge() {
  local answer
  # shellcheck disable=SC2016  # $q is a GraphQL variable
  answer=$(timeout "$wait" gh api graphql -f q="repo:$repo is:issue is:closed number:$1" -f query='
    query($q: String!) { search(type: ISSUE, query: $q, first: 1) { nodes { ... on Issue {
      timelineItems(itemTypes: [CLOSED_EVENT], last: 1) { nodes { ... on ClosedEvent {
        closer { ... on PullRequest { merged } } } } } } } } }' 2>/dev/null) || return 1
  jq -e '.data.search.nodes[0].timelineItems.nodes[0].closer.merged == true' \
    <<<"$answer" >/dev/null 2>&1
}

# One search a poll, for the closed issues that carry a state label.
# GitHub's search reads labels joined by commas as any of them.
query="label:$(printf '"%s",' "${states[@]}")"
query=${query%,}
# An empty answer is a failure too, not a list of no issues: jq -e fails on it.
search_failed() { log "WARN: tidy: the search for closed issues with state labels failed"; exit 1; }
found=$(timeout "$wait" gh issue list --repo "$repo" --state closed --search "$query" \
  --limit 100 --json number,state,labels 2>/dev/null) || search_failed
# The state is checked again: an open issue is never touched. Each line is the
# number, the state labels to take off and whether the issue already carries
# tehas:shipped, tab separated so that the list of labels stays one field.
todo=$(jq -er --args '
  ($ARGS.positional) as $states
  | if type != "array" then error("not a list") else . end
  | ([.[] | select(.state == "CLOSED")
    | [(.labels // [])[].name] as $have
    | [$states[] | select(. as $s | any($have[]; . == $s))] as $off
    | select($off | length > 0)
    | [.number, ($off | join(" ")), (if ($have | index("tehas:shipped")) then "yes" else "no" end)]
    | @tsv] | join("\n"))' "${states[@]}" <<<"$found" 2>/dev/null) || search_failed

rc=0
while IFS=$'\t' read -r n off shipped; do
  [[ $n =~ ^[0-9]+$ ]] || continue
  ! tehas_cycle_running "$n" || continue
  # A merge is what earns the label. When the closer cannot be read the labels
  # still come off and nothing is added; an issue that already carries the
  # label needs no read at all, so a WARN is never printed for it.
  ship=0
  if [ "$shipped" = yes ]; then
    :
  elif closed_by_merge "$n"; then
    ship=1
  else
    log "WARN: tidy #$n: could not read what closed the issue, tehas:shipped was not added"
  fi
  if [ "$dry" = 1 ]; then
    log "tidy #$n: would remove $off"
    [ "$ship" = 1 ] && log "tidy #$n: would add tehas:shipped"
    continue
  fi
  args=()
  for l in $off; do args+=(--remove-label "$l"); done
  [ "$ship" = 1 ] && args+=(--add-label tehas:shipped)
  if timeout "$wait" gh issue edit "$n" --repo "$repo" "${args[@]}" >/dev/null 2>&1; then
    log "tidy #$n: removed $off"
    [ "$ship" = 1 ] && log "tidy #$n: added tehas:shipped"
  else
    log "WARN: tidy #$n: could not remove $off"
    rc=1
  fi
done <<<"$todo"
exit "$rc"
