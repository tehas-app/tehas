#!/usr/bin/env bash
# Write the dashboard's energy file: $TEHAS_HOME/live/energy.json.
#
# One sample of what the model mesh draws, for the Energy use section of
# the game view. It works only when the model backend is a viiwork mesh: it
# asks the mesh for its cluster snapshot (GET /v1/cluster) and keeps only the
# machines that are alive and serve a model the factory uses, and only those
# models: a machine that serves other models is not the factory's draw. Per
# machine, the draw now, the kWh of the last 24 hours and 30 days and host RAM;
# per model, the slots, how many are busy and what serves it: the version of
# the mesh software and the engine behind the model, by the mesh's id for it
# and, from a mesh that says so (viiwork v2.9.2), by its name for people and
# the engine's own version; and the mesh's draw over the last 30 minutes, one sample per 15 seconds. Each
# sample also carries, per machine, the mesh's running count of tokens for the
# factory's models, where the mesh reports one: the live meter shows its rate.
# The file names the mesh software and where its project lives.
#
# The dashboard can be on the internet, and so can this file. The version of
# the mesh software, the engine names and the engines' versions are in it. An
# engine version is copied only when it is a plain version: letters, digits
# and . + _ -, at most 40 characters. Addresses, node ids and GPUs are not
# copied. Deterministic, no model, one HTTP call.
#
# The mesh is the one the factory's model provider points at (models.json),
# its main endpoint or else its backup, asked with the endpoint's token,
# unless TEHAS_ENERGY_URL names a cluster URL, which is asked with none.
# TEHAS_ENERGY=off removes the file, and with it the section.
#
#   one answers with a cluster snapshot        the file is rewritten
#   else one gives no answer, a timeout, a     the file is left as it is
#   server error (5xx) or a busy answer
#   (408, 429)
#   any other answers                          the file is removed: not viiwork
#
# Usage: tehasbot energy               one sample
#        tehasbot energy --every       one sample at every 15-second mark, for ever
#
# Prints nothing; exit 0 unless the file cannot be written.
set -uo pipefail

here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source=lib/models.sh
. "$here/../lib/models.sh"
: "${TEHAS_HOME:=$HOME/tehas}"
period=15
window=1800
live=$TEHAS_HOME/live
file=$live/energy.json

case "${1:-}" in
  "") ;;
  --every)
    while :; do
      "$0" || true
      sleep $((period - $(date +%s) % period))
    done ;;
  *) echo "usage: tehasbot energy [--every]" >&2; exit 64 ;;
esac

mkdir -p "$live"
if [ "${TEHAS_ENERGY:-}" = off ]; then
  rm -f "$file"
  exit 0
fi

# Where to ask: TEHAS_ENERGY_URL, else the provider's endpoint and then its
# backup, each with its token. The first that answers with a cluster snapshot
# is sampled. With none, one that did not answer or was busy leaves the file
# as it is, and otherwise it is removed.
models_file=${TEHAS_MODELS_FILE:-$HOME/.pi/agent/models.json}
provider=${PI_ENSEMBLE_SUBAGENT_PROVIDER:-fleet}
asks=()
if [ -n "${TEHAS_ENERGY_URL:-}" ]; then
  asks=("$TEHAS_ENERGY_URL|")
else
  for end in main backup; do
    base=$(tehas_endpoint_url "$provider" "$end" "$models_file")
    [ -n "$base" ] || continue
    base=${base%/}
    asks+=("${base%/v1}/v1/cluster|$(tehas_endpoint_key "$provider" "$end" "$models_file")")
  done
fi
if [ "${#asks[@]}" = 0 ]; then
  rm -f "$file"
  exit 0
fi
body=""
later=0
for ask in "${asks[@]}"; do
  # The body, then the HTTP status on a line of its own.
  answer=$(curl -sS -K <(_tehas_endpoint_auth "${ask#*|}") -m 5 -w '\n%{http_code}' "${ask%%|*}" 2>/dev/null) ||
    { later=1; continue; }
  code=${answer##*$'\n'}
  answer=${answer%$'\n'*}
  case "$code" in 5* | 408 | 429) later=1; continue ;; esac
  if [ "$code" = 200 ] &&
    printf '%s' "$answer" | jq -e 'type == "object" and (.members | type == "array")' >/dev/null 2>&1; then
    body=$answer
    break
  fi
done
if [ -z "$body" ]; then
  [ "$later" = 1 ] || rm -f "$file"
  exit 0
fi

# Exactly one value: an object with a samples array, or null.
prev=$(jq -c 'if type == "object" and (.samples | type == "array") then {samples} else null end' \
  "$file" 2>/dev/null | head -n1)
[ -n "$prev" ] || prev=null
now=${TEHAS_ENERGY_NOW:-$(date +%s)}

printf '%s' "$body" | jq --argjson prev "$prev" --argjson now "$now" \
  --argjson period "$period" --argjson window "$window" '
  def r2: (. * 100 | round) / 100;
  def positive: if type == "number" and . > 0 then r2 else null end;
  def total(f): map(f | select(. != null)) | if length == 0 then null else add | r2 end;
  def slot: . / $period | floor;
  def num: if type == "number" then . else 0 end;
  def text: if type == "string" and length > 0 then . else null end;
  # What an engine prints after its number can be a path or a host name.
  def plain: text | if . != null and test("^[A-Za-z0-9.+_-]{1,40}$") then . else null end;
  ([env | to_entries[]
    | select(.key | test("^PI_ENSEMBLE_(SUBAGENT_MODEL|MODEL_[A-Z0-9_]+)$"))
    | .value | select(length > 0)] | unique) as $factory
  | [.members[] | select(type == "object")
     | select(.state == "alive" and (.status | type == "object") and (.node | type == "string"))]
    | sort_by(.node) as $alive
  | ($alive | map(.status as $s
      | ($s.power | if type == "object" then . else {} end) as $p
      | ($p.available == true and ($p.watts | type == "number") and $p.watts >= 0) as $reads
      | {
      name: .node,
      source: (if $reads and ($p.source | type == "string") then $p.source else null end),
      watts: (if $reads then ($p.watts | round) else null end),
      kWh24h: ($s.energy_kwh_24h | positive),
      kWh30d: ($s.energy_kwh_30d | positive),
      ramUsedMb: (if ($s.host_mem_used_mb | type) == "number" then $s.host_mem_used_mb else null end),
      ramTotalMb: (if ($s.host_mem_total_mb | type) == "number" then $s.host_mem_total_mb else null end),
      serves: ([$s.models[]? | select(type == "object" and (.slots | num) > 0) | .name] | any(.[]; IN($factory[])))
    }) | map(select(.serves) | del(.serves))) as $hosts
  | ([$alive[] | .node as $n
      | (.status.ver | text | if . == null then null else ltrimstr("v") | text end) as $ver
      | .status.models[]?
      | select(type == "object")
      | {name, host: $n, version: $ver, engine: (.engine | text),
         engineName: (.engine_name | text), engineVersion: (.engine_version | plain),
         slots: (.slots | num), busy: (.busy | num), queued: (.queued | num)}]
     | group_by(.name)
     | map({
         name: .[0].name,
         hosts: (map(select(.slots > 0) | .host) | unique),
         # One element per distinct set of values, sorted: a mesh in the
         # middle of an upgrade, or a model on two engines, has more than one.
         # An engine version alone names nothing and is left out.
         engines: (map(select(.slots > 0) | {version, engine, engineName, engineVersion}
                       | select(.version != null or .engine != null or .engineName != null)) | unique),
         slots: (map(.slots) | add),
         busy: (map(.busy) | add),
         queued: (map(.queued) | add)
       })
     | map(select(.slots > 0 and (.name | IN($factory[]))))) as $models
  | ($alive | map({key: .node, value: ([.status.models[]?
        | select(type == "object") | select(.name | IN($factory[]))
        | .tokens_total | select(type == "number" and . >= 0)]
        | if length == 0 then null else add | floor end)})
     | map(select(.value != null)) | from_entries) as $tokens
  | ({t: $now, w: ($hosts | map(select(.watts != null) | {key: .name, value: .watts}) | from_entries)}
     + (if ($tokens | length) > 0 then {k: $tokens} else {} end)) as $sample
  | {
      generatedAt: ($now | todate),
      source: "viiwork",
      sourceUrl: "https://github.com/janit/viiwork",
      periodSeconds: $period,
      factoryModels: $factory,
      totals: {
        watts: ($hosts | total(.watts)),
        kWh24h: ($hosts | total(.kWh24h)),
        kWh30d: ($hosts | total(.kWh30d)),
        hosts: ($hosts | length),
        reporting: ($hosts | map(select(.watts != null)) | length),
        energyHosts: ($hosts | map(select(.kWh24h != null)) | length)
      },
      hosts: $hosts,
      models: $models,
      samples: ([($prev.samples // [])[]
                 | select(type == "object")
                 | select((.t | type == "number") and (.w | type == "object"))
                 | select(.t > $now - $window and .t <= $now and (.t | slot) != ($now | slot))]
                + [$sample] | sort_by(.t))
    }' >"$file.new" 2>/dev/null || { rm -f "$file.new"; exit 1; }
mv "$file.new" "$file"
exit 0
