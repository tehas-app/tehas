#!/usr/bin/env bash
# Build the code index that a cycle's agents search, or refresh it.
#
# pi-rukas tells its agents to find code with the codebase_memory tools. Those
# answer from an index that nothing builds on its own: interactive pi-rukas
# builds it in /start, which a headless cycle never runs. Without an index
# every search in a cycle fails and the agents fall back to reading files.
#
# The index is kept in the host's own directory, $TEHAS_HOME/state/index, under
# the name of the tree it was made from. No container is given that directory:
# tehas work and tehas plan copy it into the cache directory of the container
# they start, so a cycle reads the host's index and changes only its own copy.
# This command runs the indexer in the sandbox image, over a clone mounted at
# the path a cycle works in, so the index it writes is the one a cycle looks
# for. The clone is made at the tip the product checkout last fetched, mounted
# read-only and removed afterwards. The cycle's workspace is not touched.
#
# The index is as fresh as its last run. The dispatcher runs this before each
# cycle, so a cycle starts with an index of the tree it is cloned from. What
# the cycle changes after that is not in it.
#
# Called before a cycle, it is done only when the directory holds index data
# and its record names the branch's tip. The record alone is not enough: on a
# host upgraded from the version that kept the index in a cache volume, the
# record names the tip while this directory is empty, and every cycle would be
# given nothing to search. Only a database counts as index data, and after a
# run that wrote one the leftovers of earlier runs are removed, so what a cycle
# is copied stays the size of the index.
#
# Usage: tehas index                  build the index
#        tehas index --before-cycle   what the dispatcher runs: the caller
#                                     holds the dispatcher's lock and has
#                                     seen that no cycle runs, and nothing is
#                                     done when the index directory already
#                                     holds the branch's tip
#
# Exit status: 0 the index was built, or was already current,
#              1 the sandbox image is missing or the indexer failed, did not
#                finish in time, or, before a cycle, failed at this tip before
#              3 a cycle is running, or a poll or another index run holds the
#                dispatcher's lock; nothing was done.
#             64 an argument this command does not know.
#             78 the instance settings are invalid, or tehas.slice is not
#                usable on this host; nothing was done.
#
# What the container is given is pinned by test/index_test.sh: the clone, the
# host's index directory, which is the only thing it may write, and nothing
# else. No network, no token, no settings. It runs in tehas.slice with a
# cycle's limits (lib/slice.sh), so the dispatcher counts its memory with the
# cycles'. Without a usable slice nothing is cloned and nothing starts.
set -uo pipefail

# How long the indexer may run, in seconds. The dispatcher's lock is held for
# all of it, and no poll is processed meanwhile. Indexing takes minutes; this
# bounds an indexer that hangs.
index_bound=1800

cycle=0
case "$#:${1:-}" in
  0:) ;;
  1:--before-cycle) cycle=1 ;;
  *) echo "usage: tehas index [--before-cycle]" >&2; exit 64 ;;
esac

here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source=lib/config.sh
. "$here/../lib/config.sh"
# shellcheck source=lib/cycles.sh
. "$here/../lib/cycles.sh"
# shellcheck source=lib/sandbox.sh
. "$here/../lib/sandbox.sh"
# shellcheck source=lib/slice.sh
. "$here/../lib/slice.sh"
tehas_load || exit 78
tehas_require TEHAS_REPO
tehas_checkout || exit 78
branch=$(tehas_branch) || exit 78
src=$TEHAS_WORK_REPO
repo=$TEHAS_WORK_DIR
image=$PI_ENSEMBLE_IMAGE
marker=$TEHAS_HOME/state/index.json
# The tip the indexer last failed at. Apart from the marker, which install.sh
# reads as "an index was built".
failed=$TEHAS_HOME/state/index.failed
index=$(tehas_index_dir)
log=$TEHAS_HOME/logs/index-$(date -u +%y%m%d-%H%M%S).log

base=$(git -C "$src" rev-parse -q --verify "refs/remotes/origin/$branch^{commit}") ||
  { echo "tehas index: $src has no origin/$branch, nothing was indexed" >&2; exit 78; }

# Does <dir> hold something a cycle could search? Only a database counts.
# The indexer's own logs, its configuration and the staging file of a run that
# was stopped are not something an agent searches.
has_index_data() { # <dir>
  local f
  for f in "$1"/*.db; do
    [ -e "$f" ] || continue
    [ "$f" = "$1/_config.db" ] && continue
    return 0
  done
  return 1
}

# Remove what earlier runs left in <dir>, so the copy a cycle is given stays
# the size of the index and not of everything the indexer ever wrote. A staging
# file is how the indexer writes: a run that was stopped leaves one behind,
# about half the size of the database it was writing, and nothing reads it
# again. A database named for another tree is what a host keeps after the path
# it indexes changed. Only a run that wrote its own database removes the others.
prune_index() { # <dir> <epoch this run started>
  local dir=$1 started=$2 f fresh=0 left=0
  for f in "$dir"/*.db; do
    [ -f "$f" ] && [ "$(stat -c %Y "$f")" -ge "$started" ] && { fresh=1; break; }
  done
  for f in "$dir"/*; do
    [ -f "$f" ] || continue # the indexer's logs are a directory
    case "$f" in
      *_config.db) continue ;;
      *.db)
        [ "$fresh" = 1 ] && [ "$(stat -c %Y "$f")" -lt "$started" ] || continue
        ;;
    esac
    rm -f "$f" && left=$((left + 1))
  done
  [ "$left" = 0 ] || echo "tehas index: removed $left file(s) an earlier run left in $dir"
}

# The index is written only under the dispatcher's lock and while no cycle is
# running: a poll holds that lock while it starts cycles, and a cycle reads
# the index for as long as it lives. Called by the dispatcher, the lock is
# held by the caller, who has also looked at the cycles.
mkdir -p "$TEHAS_HOME/state" "$TEHAS_HOME/logs" "$TEHAS_HOME/tmp" "$index"
if [ "$cycle" = 0 ]; then
  exec 8>"$TEHAS_HOME/state/dispatch.lock"
  flock -n 8 || { echo "tehas index: the dispatcher's lock is held by a poll or another index run, nothing was indexed; run it again in a moment" >&2; exit 3; }
  running=$(tehas_cycles_running | tr '\n' ' ')
  [ -z "$running" ] ||
    { echo "tehas index: a cycle is running (issue ${running% }), nothing was indexed; run it again afterwards" >&2; exit 3; }
elif has_index_data "$index" && [ "$(jq -r '.commit // empty' "$marker" 2>/dev/null)" = "$base" ]; then
  echo "tehas index: ${TEHAS_REPO##*/} is already indexed at ${base:0:12}"
  exit 0
elif [ "$(cat "$failed" 2>/dev/null)" = "$base" ]; then
  # Without this every idle poll would run the same failing indexer again.
  echo "tehas index: the indexer failed at ${base:0:12}, not tried again before the branch moves; run tehas index to try now" >&2
  exit 1
fi

# No container starts outside the slice, and none with half its limits. Asked
# here, not at the top: a run that finds the lock held or the index current
# has no container to start.
TEHAS_SLICE_LIMITS=()
tehas_slice_ok || { echo "tehas index: $TEHAS_SLICE_WHY" >&2; exit 78; }
tehas_slice_limits || true
if [ "${#TEHAS_SLICE_LIMITS[@]}" != 12 ] || [ "${TEHAS_SLICE_LIMITS[1]}" != tehas.slice ]; then
  echo "tehas index: the container limits could not be made, not starting" >&2
  exit 78
fi

if ! docker image inspect "$image" >/dev/null 2>&1; then
  echo "tehas index: no sandbox image $image, nothing was indexed; build it with $TEHAS_HOME/sandbox/build.sh" >&2
  exit 1
fi

tree=$(mktemp -d "$TEHAS_HOME/tmp/index.XXXXXX") || exit 1
trap 'rm -rf "$tree"' EXIT
if ! { git init -q -b "$branch" "$tree" &&
  git -C "$tree" fetch -q --no-tags "$src" "+refs/remotes/origin/$branch:refs/remotes/origin/$branch" &&
  git -C "$tree" checkout -q -B "$branch" "$base"; }; then
  echo "tehas index: could not clone $src, nothing was indexed" >&2
  exit 1
fi

started=$(date +%s)
# A run that was killed leaves its container under this name, and every later
# run would fail on the name.
docker rm -f tehas-index >/dev/null 2>&1 || true
timeout -k 30 "$index_bound" docker run --rm --name tehas-index --network none \
  "${TEHAS_SLICE_LIMITS[@]}" \
  --user "$(id -u):$(id -g)" -e HOME=/home/vscode \
  -e "CBM_CACHE_DIR=$(tehas_sandbox_cache_dir)" \
  -w "$repo" -v "$tree:$repo:ro" \
  -v "$index:$(tehas_sandbox_cache_dir)" \
  --entrypoint codebase-memory-mcp "$image" \
  cli index_repository --repo-path "$repo" >"$log" 2>"$log.err"
rc=$?

# The indexer answers with one JSON object. Anything else is a failure.
answer=$(grep '^{' "$log" | tail -n 1)
if [ "$rc" != 0 ] || [ "$(jq -r '.status // empty' <<<"$answer" 2>/dev/null)" != indexed ]; then
  case "$rc" in
    124) echo "tehas index: the indexer did not finish within ${index_bound}s, see $log and $log.err" >&2 ;;
    *) echo "tehas index: the indexer failed (exit $rc), see $log and $log.err" >&2 ;;
  esac
  echo "$base" >"$failed"
  # timeout stops the docker client, not the container.
  docker rm -f tehas-index >/dev/null 2>&1 || true
  exit 1
fi

nodes=$(jq -r '.nodes // 0' <<<"$answer")
edges=$(jq -r '.edges // 0' <<<"$answer")
jq -n --arg commit "$base" --arg branch "$branch" --argjson nodes "$nodes" --argjson edges "$edges" \
  --argjson at "$(date +%s)" '{commit: $commit, branch: $branch, nodes: $nodes, edges: $edges, at: $at}' \
  >"$marker.new" && mv "$marker.new" "$marker"
rm -f "$failed"
# Only a run that wrote its index prunes. A failed one may have left the half
# written database where a later run can still find it.
prune_index "$index" "$started"
echo "tehas index: ${TEHAS_REPO##*/} indexed at ${base:0:12} on $branch, $nodes nodes, $edges edges, $(($(date +%s) - started))s"
