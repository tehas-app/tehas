#!/usr/bin/env bash
# Build the code index that a cycle's agents search, or refresh it. The run is
# tehas-cycle's, and console/cycle/src/index.rs says what it does. This loads the
# settings and takes the lock, because the indexer's docker client inherits the
# descriptor on purpose: a client that outlives the run still writes the index.
#
# Usage: tehas index                  build the index
#        tehas index --before-cycle   what the dispatcher's unit runs: nothing
#                                     is done when the index directory already
#                                     holds the branch's tip, or when the
#                                     indexer failed at that tip before
#
# Exit status: 0 the index was built, or was already current,
#              1 the sandbox image is missing or the indexer failed, did not
#                finish in time, or what another sandbox image wrote could not
#                be set aside, or, before a cycle, failed at this tip before
#              3 a cycle is running, another index run holds its lock, or a
#                poll held the dispatcher's lock for the whole wait; nothing
#                was done.
#             64 an argument this command does not know.
#             78 the instance settings are invalid, tehas.slice is not usable
#                on this host, or no tehas-cycle stands beside this command;
#                nothing was done.
set -uo pipefail

case "$#:${1:-}" in
  0: | 1:--before-cycle) ;;
  *) echo "usage: tehas index [--before-cycle]" >&2; exit 64 ;;
esac

here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source=lib/config.sh
. "$here/../lib/config.sh"
tehas_load || exit 78
tehas_require TEHAS_REPO
tehas_checkout || exit 78
branch=$(tehas_branch) || exit 78
base=$(git -C "$TEHAS_WORK_REPO" rev-parse -q --verify "refs/remotes/origin/$branch^{commit}") ||
  { echo "tehas index: $TEHAS_WORK_REPO has no origin/$branch, nothing was indexed" >&2; exit 78; }

[ -x "$here/tehas-cycle" ] || { echo "tehas index: no tehas-cycle beside this command, run install.sh" >&2; exit 78; }
mkdir -p "$TEHAS_HOME/state"
exec 7>>"$TEHAS_HOME/state/index.lock"
flock -n 7 || { echo "tehas index: another index run holds its lock, nothing was indexed; run it again in a moment" >&2; exit 3; }
exec "$here/tehas-cycle" index "$branch" "$base" "$@"
