#!/usr/bin/env bash
# Load the instance's settings, then run a command of the console under them.
# A command whose only bash was this load is a line in bin/tehas or
# bin/tehasbot, and that line names this file.
#
# Usage: with-settings tehas|tehasbot <command> [arguments]
#
# The console runs `check` on the same words first, so a bad argument is 64
# whatever the settings hold. A command with no check passes it.
#
# Exit: the console's; 78 the settings are missing or malformed, or no console
# stands beside this file.
set -uo pipefail

here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
# Named before the load: tehas_load clears the TEHAS_* of the host.
console=${TEHAS_CONSOLE:-$here/console}
[ -x "$console" ] || { echo "${*:1:2}: no console at $console: run install.sh" >&2; exit 78; }
"$console" check "$@" || exit

# shellcheck source=lib/config.sh
. "$here/../lib/config.sh"
tehas_load || exit 78
exec "$console" "$@"
