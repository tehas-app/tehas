#!/usr/bin/env bash
# tehasbot: what the timers and services run; tehas, beside it, is for a person.
#
# Usage:
#   tehasbot dispatch             one poll of the issue queue (the timer)
#   tehasbot cycle <issue>        one cycle and its report (tehas-cycle@<issue>.service)
#   tehasbot status               write the queue snapshot, live/status.json
#   tehasbot health               write the health file, live/health.json
#   tehasbot energy [--every]     sample the model mesh's power (the service)
#   tehasbot top [--every]        publish the host section for the dashboard
#                                 (the service)
#   tehasbot protolab             build the Protolab pages (the timer)
#   tehasbot preview [--sweep]    keep the previews of pull requests (the timers)
#   tehasbot improve              one run of the improvement loop (the timer)
#   tehasbot refresh              find the pull requests to refresh (the timer)
#   tehasbot review               review the branch since the last review
#   tehasbot clean                remove what the host can make again (the timer)
#   tehasbot disk --publish       the reading for factory_disk (the timer)
#   tehasbot mcp serve            the read-only MCP server (the service)
#   tehasbot github-token [--check]  the GitHub App's token (the gh shim)
#   tehasbot help                 this text
#
# Exit: the status of the command that ran; 64 a command this does not know;
# 78 no console for a command that needs one.
set -uo pipefail

libexec=$(cd "$(dirname "${BASH_SOURCE[0]}")/../libexec" && pwd) ||
  { echo "tehasbot: no libexec directory beside $(dirname "${BASH_SOURCE[0]}")" >&2; exit 1; }

console=${TEHAS_CONSOLE:-$libexec/console}

usage() {
  sed -n '2,/^[^#]/p' "$0" | sed -n '/^#/s/^# \{0,1\}//p'
}

# under_settings <command> [arguments]: the command under the instance's settings.
under_settings() {
  if [ ! -x "$console" ]; then
    case $1 in
      clean) printf 'tehas clean: no console beside this command at %s, run install.sh\n' "$console" >&2 ;;
      preview) echo "tehas: no console beside this command ($console), run install.sh" >&2 ;;
      protolab) echo "tehasbot protolab: no console to build the pages with; run install.sh" >&2 ;;
      refresh) echo "tehas: no console at $console to load the settings: run install.sh" >&2 ;;
      *) echo "tehasbot $1: no console at $console: run install.sh" >&2 ;;
    esac
    exit 78
  fi
  exec "$console" run "$libexec" "$EUID" "$BASH" tehasbot "$@"
}

case "${1-help}" in
  help | -h | --help)
    usage
    exit 0
    ;;
  health | status | top | refresh | clean)
    under_settings "$@"
    ;;
  # The pages and the previews are served by another user.
  preview)
    umask 022
    under_settings "$@"
    ;;
  # A checkout has no console built, so a `console' on the PATH is taken too, as
  # tehas export does.
  protolab)
    umask 022
    [ -x "$console" ] || console=$(command -v console 2>/dev/null) || console=$libexec/console
    under_settings protolab
    ;;
  dispatch | cycle | improve | review | github-token)
    file=$libexec/$1
    shift
    exec "$file" "$@"
    ;;
  mcp)
    [ "${2-}" != serve ] || under_settings "$@"
    exec "$console" tehasbot "$@"
    ;;
  energy) shift; exec "$libexec/console" energy "$@" ;;
  disk) # factory_disk's reading: only --publish writes.
    [ "${2-}${3:+x}" = --publish ] || { echo "tehasbot disk: usage: tehasbot disk --publish" >&2; exit 64; }
    exec "$console" tehasbot "$@"
    ;;
  *)
    printf 'tehasbot: unknown command: %s\n' "$1" >&2
    usage >&2
    exit 64
    ;;
esac
