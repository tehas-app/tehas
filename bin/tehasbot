#!/usr/bin/env bash
# tehasbot: what the timers and services run. Nothing here is for a person to
# type in daily use; the command for that is tehas, beside this file.
#
# Usage:
#   tehasbot dispatch             one poll of the issue queue (the timer)
#   tehasbot status               write the queue snapshot, live/status.json
#   tehasbot health               write the health file, live/health.json
#   tehasbot energy [--every]     sample the model mesh's power (the service)
#   tehasbot protolab             build the Protolab pages (the timer)
#   tehasbot help                 this text
#
# Each command is a script in ../libexec, and this only chooses one and runs
# it with the remaining arguments: it loads no settings and calls nothing
# else. The exit status is the script's. The scripts call each other by the
# path of their own directory, not through this command.
#
# Exit: the status of the command that ran; 64 a command this does not know.
set -uo pipefail

libexec=$(cd "$(dirname "${BASH_SOURCE[0]}")/../libexec" && pwd) ||
  { echo "tehasbot: no libexec directory beside $(dirname "${BASH_SOURCE[0]}")" >&2; exit 1; }

usage() {
  sed -n '2,/^[^#]/p' "$0" | sed -n '/^#/s/^# \{0,1\}//p'
}

case "${1-help}" in
  help | -h | --help)
    usage
    exit 0
    ;;
  dispatch | status | health | energy | protolab)
    file=$libexec/$1
    shift
    exec "$file" "$@"
    ;;
  *)
    printf 'tehasbot: unknown command: %s\n' "$1" >&2
    usage >&2
    exit 64
    ;;
esac
