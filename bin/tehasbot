#!/usr/bin/env bash
# tehasbot: what the timers and services run. `tehasbot help` lists the
# commands; the console chooses one and runs it (console/src/front.rs).
#
# Exit: the command's; 1 no libexec beside this file; 78 no console.
libexec=$(cd "$(dirname "${BASH_SOURCE[0]}")/../libexec" && pwd) ||
  { echo "tehasbot: no libexec directory beside $(dirname "${BASH_SOURCE[0]}")" >&2; exit 1; }
console=${TEHAS_CONSOLE:-$libexec/console}
[ -x "$console" ] || { echo "tehasbot: no console at $console: run install.sh" >&2; exit 78; }
# The pages and the previews are served by another user. Safe Rust sets no umask.
case ${1-} in preview | protolab) umask 022 ;; esac
exec "$console" front "$libexec" "$EUID" "$BASH" tehasbot "$@"
