#!/usr/bin/env bash
# The tehas dispatcher: one poll of the GitHub issue queue.
#
# Deterministic, no model. It picks at most one open issue labelled
# tehas:ready, runs a pi-rukas /work cycle for it with tehas-work, and
# reports the outcome back on the issue (and the token usage on the PR). The
# poll also runs one turn of a planning session, when an answer is waiting.
# A systemd timer runs it every two minutes; a cycle in progress simply makes
# the following polls wait.
#
# Usage:
#   tehas-dispatch               one poll
#   tehas-dispatch --dry-run     say what a poll would do, change nothing
#   tehas-dispatch --init-labels create the tehas labels in the repository
#   tehas-dispatch -h|--help     print this text and exit 0
#
# Exit: 0 the poll ran, or there was nothing to do; 64 an argument this command
# does not know, which starts no poll; 78 instance settings are missing or
# malformed; 1 a call to GitHub failed or its answer could not be read.
#
# Rules, in order:
#   1. Label tehas:pause on the control issue stops all dispatch.
#   2. No new cycle while TEHAS_MAX_AWAITING tehas PRs wait for a human.
#   3. A box ticked by an allowed account in the bot's question comment is an
#      answer: on a parked cycle, "Retry from a clean start" starts a fresh
#      cycle. The awaiting-merge limit holds that back too. The tick counts
#      only on a parked issue, and it is unticked when it is used. A comment
#      is a question only if this host has its id on record, in
#      $TEHAS_HOME/state: the planning record, or park-<issue>.id.
#   4. A reply or a ticked option on a planning question runs the next turn
#      of that session. An issue whose tehas:plan label was applied by an
#      allowed account starts a session. Neither waits for the awaiting-merge
#      limit: a planning turn opens no pull request.
#   5. An issue is eligible only if its tehas:ready label was applied by an
#      account in TEHAS_ALLOWED_LABELERS. The bot is never in that list. An
#      issue with an open planning session is not eligible until it is ended.
#   6. tehas:urgent first, then the lowest issue number. One at a time.
#
# Instance settings (lib/config.sh; defaults in brackets):
#   TEHAS_REPO              owner/name of the product repository, required
#   TEHAS_CONTROL_ISSUE     issue that carries tehas:pause, required
#   TEHAS_ALLOWED_LABELERS  space-separated logins, required
#   TEHAS_MAX_AWAITING      open tehas:awaiting-merge issues allowed [3]
#   TEHAS_WORK_REPO         checkout cycles run in [$TEHAS_HOME/repos/<name>]
#   TEHAS_BRANCH            branch work lands on [the checkout's origin/HEAD]
#   TEHAS_PLAN_MAX_TURNS    turns a planning session may take [20]
# From the environment, for tests: TEHAS_WORK_CMD, TEHAS_STATUS_CMD,
# TEHAS_INDEX_CMD, TEHAS_PLAN_CMD.
set -uo pipefail

# The usage is this file's own header comment: every line from the second to the
# first one that is not a comment, with the leading "# " removed. So the text
# cannot drift from the code; unlike a fixed line range it needs no number kept
# in step with the header.
show_usage() {
  sed -n '2,/^[^#]/p' "$0" | sed -n '/^#/s/^# \{0,1\}//p'
}

unknown_argument() {
  printf 'tehas-dispatch: unknown argument: %s\n' "$1" >&2
  show_usage >&2
  exit 64
}

# Arguments are read before the instance settings, so --help answers on a host
# with no instance yet, and an argument this command does not know reaches
# neither gh nor $TEHAS_HOME. Before this check a poll ignored anything it did
# not recognise: a typo such as --dryrun ran a real poll and could start a cycle.
mode=poll
if [ "$#" -gt 0 ]; then
  case "$1" in
    -h | --help) mode=help ;;
    --dry-run) mode=dry ;;
    --init-labels) mode=labels ;;
    # An empty argument is an argument too: it is not a poll.
    *) unknown_argument "$1" ;;
  esac
fi
# At most one argument. A second is refused, never combined with the first, so
# --dry-run --init-labels cannot be read as two intents at once.
if [ "$#" -gt 1 ]; then
  unknown_argument "$2"
fi
if [ "$mode" = help ]; then
  show_usage
  exit 0
fi
dry=0
[ "$mode" = dry ] && dry=1

here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source=lib/config.sh
. "$here/../lib/config.sh"
tehas_load || exit 78
# shellcheck source=lib/questions.sh
. "$here/../lib/questions.sh"

log() { printf '%s %s\n' "$(date -u +%FT%TZ)" "$*"; }

if [ "$mode" = labels ]; then
  tehas_require TEHAS_REPO
  repo=$TEHAS_REPO
  mk() { gh label create "$1" --repo "$repo" --color "$2" --description "$3" --force >/dev/null && echo "label $1"; }
  mk tehas:ready 0e8a16 "Tehas: eligible for dispatch (apply by hand to authorize a cycle)"
  mk tehas:urgent d93f0b "Tehas: dispatch before other ready issues"
  mk tehas:running 1d76db "Tehas: a /work cycle owns this issue"
  mk tehas:awaiting-merge fbca04 "Tehas: PR open and reviewed, waiting for a human"
  mk tehas:pause 000000 "Tehas: on the control issue, stops all dispatch"
  mk needs-human-attention b60205 "Cycle parked; the handoff comment says what to do"
  mk tehas:question 5319e7 "Tehas: a question on this issue waits for an answer"
  mk tehas:plan 0e8a16 "Tehas: start a planning session on this issue (apply by hand)"
  mk tehas:planning 1d76db "Tehas: a planning turn is running for this issue"
  exit 0
fi

tehas_require TEHAS_REPO TEHAS_CONTROL_ISSUE TEHAS_ALLOWED_LABELERS \
  PI_ENSEMBLE_SUBAGENT_MODEL PI_ENSEMBLE_SUBAGENT_PROVIDER
repo=$TEHAS_REPO
control=$TEHAS_CONTROL_ISSUE
allowed=" $TEHAS_ALLOWED_LABELERS "
max_awaiting=$TEHAS_MAX_AWAITING
checkout=$TEHAS_WORK_REPO
workdir=$TEHAS_WORK_DIR
work=${TEHAS_WORK_CMD:-tehas-work}
status_cmd=${TEHAS_STATUS_CMD:-tehas-status}
index_cmd=${TEHAS_INDEX_CMD:-tehas-index}
plan_cmd=${TEHAS_PLAN_CMD:-tehas-plan}
# Known before anything is touched: a cycle must never start from a guess,
# nor in a checkout of another repository.
tehas_checkout || exit 78
branch=$(tehas_branch) || exit 78

mkdir -p "$TEHAS_HOME/state" "$TEHAS_HOME/logs"
exec 8>"$TEHAS_HOME/state/dispatch.lock"
flock -n 8 || { [ "$dry" = 1 ] && log "another dispatch holds the lock (a cycle is running)"; exit 0; }

# gh_json <gh arguments>: the answer in $json. A failed call ends the poll:
# no rule below may be decided on an answer that never came. Always call it as
# a plain command, never in a pipe or $( ), where its exit would be lost.
json=""
gh_json() { json=$(gh "$@" 2>/dev/null) || { log "ERROR: gh $1 $2 failed"; exit 1; }; }

# say <issue> <text>, label <issue> <gh issue edit options...>: comment on an
# issue and change its labels. A failure is a warning in the log, not the end
# of the poll.
say() { gh issue comment "$1" --repo "$repo" --body "$2" >/dev/null 2>&1 || log "WARN: comment on #$1 failed"; }
label() {
  local n=$1
  shift
  gh issue edit "$n" --repo "$repo" "$@" >/dev/null 2>&1 || log "WARN: label change on #$n failed: $*"
}

# post_question <kind> <issue> <turn> <result.json>: post a question comment.
# Its id is left in $posted. Returns 1 when it could not be posted.
posted=""
post_question() {
  local body
  body=$(q_render "$1" "$2" "$3" "$4") || return 1
  posted=$(gh api "repos/$repo/issues/$2/comments" -f body="$body" --jq .id 2>/dev/null) || return 1
  [ -n "$posted" ]
}
# untick <issue> <answer> [note]: empty every box of a question comment. With
# a note, say it on the issue, but only once the untick has worked: if the box
# stays ticked the next poll sees the same tick, and the note would be posted
# every poll. Returns 1 when the comment could not be changed.
untick() {
  gh api -X PATCH "repos/$repo/issues/comments/$(jq -r .comment <<<"$2")" \
    -f body="$(jq -r .body <<<"$2" | q_untick)" >/dev/null 2>&1 || return 1
  [ -z "${3:-}" ] || say "$1" "$3"
}

# park_id <issue>: print the path of the file that holds the id of the park
# question this host posted on the issue. An agent in a container holds the
# bot's token: it can post a comment with a marker, edit the bot's comments
# and apply labels. It cannot write here, so this file is what makes a comment
# the factory's own question. One line, the comment's number.
park_id() { printf '%s/state/park-%s.id\n' "$TEHAS_HOME" "$1"; }
# shellcheck source=lib/planning.sh
. "$here/../lib/planning.sh"

# Do not burn an issue on a mesh that cannot answer: every agent would fail
# and the issue would park. Leave it queued and look again next poll.
mesh_ok() {
  local mesh model=$PI_ENSEMBLE_SUBAGENT_MODEL
  mesh=$(jq -r --arg p "$PI_ENSEMBLE_SUBAGENT_PROVIDER" '.providers[$p].baseUrl // ""' "$HOME/.pi/agent/models.json" 2>/dev/null)
  if [ -n "$mesh" ] && [ -n "$model" ] &&
    ! curl -fsS -m 10 "$mesh/models" 2>/dev/null | jq -e --arg m "$model" '.data | any(.id == $m)' >/dev/null 2>&1; then
    log "holding: the mesh at $mesh does not offer $model right now"
    return 1
  fi
}

# approval <issue> <label>: who applied the label most recently, and when, in
# $who and $at; the issue's events in $events. Returns 1, with the reason
# logged, unless that was an allowed account and the text is still what it
# approved. A failed call to GitHub ends the poll.
events=""
who=""
at=""
approval() {
  local n=$1 name=$2 ready
  # Who applied the label most recently, and when?
  gh_json api "repos/$repo/issues/$n/events?per_page=100" --paginate
  events=$json
  ready=$(jq -rs --arg l "$name" 'add // [] | map(select(.event == "labeled" and .label.name == $l)) | last
                  | "\(.actor.login // "") \(.created_at // "")"' <<<"$events") ||
    { log "ERROR: unreadable label events of #$n"; exit 1; }
  who=${ready%% *}
  at=${ready#* }
  # No name is nobody: a deleted account or a missing event never matches.
  case "${who:+$allowed}" in
    *" $who "*) ;;
    *)
      log "skip #$n: $name was applied by '${who:-unknown}', not an allowed account"
      return 1
      ;;
  esac
  unchanged_since "$n" "$at" "$who applied $name"
}

# unchanged_since <issue> <time> <what happened then> [how to approve again]
# Needs $events. An approval covers the text that was there when it was given.
# A title or body changed afterwards by anyone else has not been approved by
# anybody: the issue waits until an allowed account approves it again. Returns
# 1, with the reason logged, if that happened.
unchanged_since() {
  local n=$1 since=$2 what=$3 again=${4:-apply the label again} renamed edited editors edited_at stale e
  renamed=$(jq -rs --arg at "$since" 'add // [] | map(select(.event == "renamed" and ($at == "" or .created_at > $at)))
                  | map(.actor.login // "") | join(" ")' <<<"$events") ||
    { log "ERROR: unreadable label events of #$n"; exit 1; }
  # shellcheck disable=SC2016  # $owner, $name and $number are GraphQL variables
  gh_json api graphql -F owner="${repo%%/*}" -F name="${repo##*/}" -F number="$n" \
    -f query='query($owner: String!, $name: String!, $number: Int!) {
      repository(owner: $owner, name: $name) { issue(number: $number) { lastEditedAt editor { login } } } }'
  edited=$(jq -r '.data.repository.issue | "\(.editor.login // "") \(.lastEditedAt // "")"' <<<"$json") ||
    { log "ERROR: unreadable edit record of #$n"; exit 1; }
  editors=$renamed
  edited_at=${edited#* }
  if [ -n "$edited_at" ] && { [ -z "$since" ] || [[ $edited_at > $since ]]; }; then
    editors="$editors ${edited%% *}"
    [ -n "${edited%% *}" ] || editors="$editors unknown"
  fi
  stale=""
  for e in $editors; do
    case "$allowed" in *" $e "*) ;; *) stale=$e ;; esac
  done
  if [ -n "$stale" ]; then
    log "skip #$n: its text was changed by '$stale' after $what; $again to approve it"
    return 1
  fi
}

# Cycles start from the product's default branch; keep the checkout current.
# tehas-work clones the cycle's workspace from it. No container is ever given
# this checkout, so running git here runs nothing an agent wrote. Put it back
# on the branch only when it is clean: never discard someone's changes.
refresh_checkout() {
  if [ -z "$(git -C "$checkout" status --porcelain --untracked-files=no)" ]; then
    git -C "$checkout" checkout -q "$branch" || log "WARN: could not switch $checkout to $branch"
  else
    log "WARN: $checkout has uncommitted changes, leaving its branch alone"
  fi
  if ! git -C "$checkout" fetch -q origin || ! git -C "$checkout" merge -q --ff-only "origin/$branch"; then
    log "WARN: could not fast-forward $checkout"
  fi
}

# wait_for <pid>: wait for a background run and return its exit status. Keep
# the dashboard's queue current while it runs.
wait_for() {
  local pid=$1 ticks=0
  while kill -0 "$pid" 2>/dev/null; do
    [ $((ticks % 12)) = 0 ] && "$status_cmd"
    ticks=$((ticks + 1))
    sleep 10
  done
  wait "$pid"
}

# run_cycle <issue> <who> <verb> <authorised by> <gh issue edit options...>
# One /work cycle, from marking the issue as taken to reporting the outcome.
# The options take the issue out of the queue it came from.
run_cycle() {
  local issue=$1 who=$2 verb=$3 how=$4 started restart rc mins state status step cbranch usage pr summary stopped
  shift 4
  comment() { say "$issue" "$1"; }
  relabel() { label "$issue" "$@"; }

  log "start #$issue ($verb by $who)"
  # The cycle runs only once the issue is marked as taken. If the label cannot
  # be changed, the issue would stay in its queue and every later poll would
  # start the same issue again.
  if ! gh issue edit "$issue" --repo "$repo" --add-label tehas:running "$@" >/dev/null 2>&1; then
    log "ERROR: could not mark #$issue as running, not starting a cycle"
    exit 1
  fi
  # A park question of an earlier cycle is used up by this start, whichever
  # way it came about. Its boxes must not answer for the new cycle.
  rm -f "$(park_id "$issue")"
  comment "Tehas cycle started on \`$(hostname)\` at $(date -u +'%F %H:%M') UTC (authorized by @$who's $how). This issue is owned by the cycle until \`tehas:running\` is removed."

  refresh_checkout

  # The agents search an index of the tree the cycle is about to be cloned from.
  # A cycle without a fresh index still works, so a failure here is a warning.
  "$index_cmd" --before-cycle >>"$TEHAS_HOME/logs/dispatch-work-$issue.log" 2>&1 ||
    log "WARN: the code index was not refreshed, see $TEHAS_HOME/logs/dispatch-work-$issue.log"

  started=$(date +%s)
  # A relabelled issue gets a fresh cycle, not whatever the last one parked.
  # The workspace is new every time, so the record of an earlier cycle is kept
  # here, on the host.
  restart=""
  mkdir -p "$TEHAS_HOME/state/cycles"
  [ -e "$TEHAS_HOME/state/cycles/$issue" ] && restart=--restart
  : >"$TEHAS_HOME/state/cycles/$issue"
  "$work" "$issue" $restart >>"$TEHAS_HOME/logs/dispatch-work-$issue.log" 2>&1 &
  wait_for $!
  rc=$?
  mins=$((($(date +%s) - started) / 60))

  # The one thing read back from the tree the container wrote, and only as data.
  state=$workdir/.pi/work-state/$issue.json
  # The file is written inside the container, and what the bot posts from it is
  # trusted later, so only plain characters are kept.
  status=$(jq -r '.pipelineState.status // "unknown"' "$state" 2>/dev/null | tr -cd 'A-Za-z0-9_.-')
  step=$(jq -r '.pipelineState.currentStep // "-"' "$state" 2>/dev/null | tr -cd 'A-Za-z0-9_.-')
  status=${status:-unknown}
  step=${step:--}
  cbranch=$(jq -r '.pipelineState.branchName // ""' "$state" 2>/dev/null || echo "")
  # The numbers are summed as numbers. Anything else in their place counts as
  # nothing: a string would be joined up by the sum and posted word for word.
  usage=$(jq -r '
    def n: tonumber? // 0;
    [.eventLog[] | select(.usage) | {role: ((.role // "driver" | tostring | gsub("[^A-Za-z0-9_.-]"; "")) as $r | if $r == "" then "driver" else $r end),
                                     u: (.usage | {turns: (.turns | n), input: (.input | n), output: (.output | n), cacheRead: (.cacheRead | n)})}] as $e
    | if ($e | length) == 0 then "" else
        (["| Role | Dispatches | Turns | Input | Output | Cache read |", "|---|---|---|---|---|---|"]
         + ($e | group_by(.role) | map("| \(.[0].role) | \(length) | \(map(.u.turns) | add) | \(map(.u.input) | add) | \(map(.u.output) | add) | \(map(.u.cacheRead) | add) |"))
         + ["| **total** | \($e | length) | \($e | map(.u.turns) | add) | \($e | map(.u.input) | add) | \($e | map(.u.output) | add) | \($e | map(.u.cacheRead) | add) |"])
        | join("\n") end' "$state" 2>/dev/null || echo "")

  pr=""
  if [ -n "$cbranch" ]; then
    # The branch name comes from a file the cycle wrote. Only a pull request the
    # bot itself opened counts, so it cannot point at somebody else's.
    pr=$(gh pr list --repo "$repo" --head "$cbranch" --author "@me" --state open --json url --jq '.[0].url // ""' 2>/dev/null || echo "")
  fi

  summary="status \`$status\`, last step \`$step\`, $mins min"
  if [ "$rc" = 0 ] && [ "$status" = merged ]; then
    relabel --remove-label tehas:running
    comment "Tehas cycle finished: $summary. The change was merged."
  elif [ "$rc" = 0 ] && [ -n "$pr" ]; then
    relabel --remove-label tehas:running --add-label tehas:awaiting-merge
    comment "Tehas cycle finished: $summary. Pull request waiting for a human: $pr"
    gh pr comment "$pr" --body "Tehas cycle for #$issue: $summary.

${usage:-No token usage was recorded for this cycle.}" >/dev/null 2>&1 || log "WARN: comment on $pr failed"
  else
    relabel --remove-label tehas:running --add-label needs-human-attention
    stopped="Tehas cycle stopped without a pull request: $summary (runner exit $rc). Read the handoff comment if there is one; the run log is \`~/tehas/logs/dispatch-work-$issue.log\` on \`$(hostname)\`."
    jq -n --arg text "$stopped

${usage}" '{text: $text, question: null}' >"$TEHAS_HOME/state/park-$issue.json"
    if post_question park "$issue" 1 "$TEHAS_HOME/state/park-$issue.json"; then
      # On record before the label shows it: a tick counts only in the comment
      # named here. Without the record a tick starts nothing and says so.
      printf '%s\n' "$posted" >"$(park_id "$issue")" ||
        log "WARN: could not record the park question of #$issue, its boxes will not work"
      # A separate call: a repository without this label must still get the
      # parking label above. The poll only reads questions on issues that
      # carry this label, so without it the boxes do nothing: say so.
      if ! gh issue edit "$issue" --repo "$repo" --add-label tehas:question >/dev/null 2>&1; then
        log "WARN: label change on #$issue failed: --add-label tehas:question"
        rm -f "$(park_id "$issue")"
        comment "The boxes above cannot be used: the label \`tehas:question\` could not be added (run \`tehas-dispatch --init-labels\` on the host). To retry, remove \`needs-human-attention\` and apply \`tehas:ready\` again."
      fi
    else
      # Without the boxes there is nothing to tick: say the old way.
      comment "$stopped To retry, remove \`needs-human-attention\` and apply \`tehas:ready\` again.

${usage}"
    fi
    rm -f "$TEHAS_HOME/state/park-$issue.json"
  fi
  log "done #$issue rc=$rc status=$status step=$step minutes=$mins pr=${pr:-none}"
  "$status_cmd"
}

[ "$dry" = 0 ] && "$status_cmd"

# The repository must still answer to its configured name. After a rename
# GitHub redirects some calls and answers others with an empty list, so the
# queue would look empty for ever with no error.
gh_json repo view "$repo" --json nameWithOwner
actual=$(jq -r '.nameWithOwner // ""' <<<"$json") || actual=""
if [ "${actual,,}" != "${repo,,}" ]; then
  log "ERROR: $repo is now ${actual:-unknown} on GitHub: set TEHAS_REPO in $TEHAS_INSTANCE_DIR/instance.env and the checkout's origin"
  exit 1
fi

# 1. Pause switch.
gh_json issue view "$control" --repo "$repo" --json labels
paused=$(jq -r '.labels | any(.name == "tehas:pause")' <<<"$json") || { log "ERROR: unreadable answer for issue #$control"; exit 1; }
if [ "$paused" != false ]; then
  [ "$dry" = 1 ] && log "paused: issue #$control carries tehas:pause"
  exit 0
fi

# 2. Do not pile up unreviewed work. This holds back new cycles only; a
# question is still read while it holds.
gh_json issue list --repo "$repo" --state open --label tehas:awaiting-merge --limit 100 --json number
awaiting=$(jq length <<<"$json") || { log "ERROR: unreadable list of issues awaiting merge"; exit 1; }
held=0
[ "$awaiting" -ge "$max_awaiting" ] && held=1

# 3. Questions that wait for an answer. An answer is a box ticked in the
# bot's question comment, or for a planning session a reply after it, and it
# counts only from an allowed account.
# A planning turn that was running when the last poll ended was cut off, for
# example by a restart of the host: this poll holds the lock, so nothing runs.
# It is reported first, as a failed turn.
fresh=" "
for st in "$TEHAS_HOME"/state/plan-*.json; do
  [ -f "$st" ] || continue
  plan_record_number "$st" || continue
  n=$plan_n
  [ "$(jq -r '.running // false' "$st" 2>/dev/null)" = true ] || continue
  if [ "$dry" = 1 ]; then
    log "would report the cut-off planning turn of #$n"
  else
    plan_recover "$n" || true
  fi
  fresh="$fresh$n "
done
# A planning turn whose outcome could not be posted is posted first: its
# session is waiting on a comment nobody has seen.
for st in "$TEHAS_HOME"/state/plan-*.json; do
  [ -f "$st" ] || continue
  plan_record_number "$st" || continue
  n=$plan_n
  case "$fresh" in *" $n "*) continue ;; esac
  [ "$(jq -r '.pending // false' "$st" 2>/dev/null)" = true ] || continue
  if [ "$dry" = 1 ]; then
    log "would post the waiting planning turn of #$n"
  else
    plan_post "$n" || true
  fi
  # Its question label is newer than the list read below.
  fresh="$fresh$n "
done

gh_json issue list --repo "$repo" --state open --label tehas:question --limit 100 --json number,labels
asking_json=$json
asking=$(jq -r 'map(.number) | sort | .[]' <<<"$asking_json") || { log "ERROR: unreadable list of issues with a question"; exit 1; }
# A session whose issue was closed, or whose question label was taken off by
# hand, is over. Its record goes without a comment. A record that was running
# or waiting to be posted when this poll began is in $fresh, whatever became
# of it above, so it is never taken for a session that is over.
for st in "$TEHAS_HOME"/state/plan-*.json; do
  [ -f "$st" ] || continue
  plan_record_number "$st" || continue
  n=$plan_n
  case "$fresh" in *" $n "*) continue ;; esac
  case " ${asking//$'\n'/ } " in
    *" $n "*) ;;
    *) [ "$dry" = 1 ] || rm -f "$st" "$st.out" "$st.answer" "$st.brief" ;;
  esac
done
bot=""
for n in $asking; do
  if [ -z "$bot" ]; then
    gh_json api user
    bot=$(jq -r '.login // ""' <<<"$json") || bot=""
    [ -n "$bot" ] || { log "ERROR: the bot's own login could not be read"; exit 1; }
    case "$allowed" in
      *" $bot "*) log "ERROR: the bot account $bot is in TEHAS_ALLOWED_LABELERS; the bot never authorises work"; exit 78 ;;
    esac
  fi
  have=" $(jq -r --argjson n "$n" '[.[] | select(.number == $n) | (.labels // [])[].name] | join(" ")' <<<"$asking_json") "
  # Which comment is the question is decided here, from this host's own
  # files, before a comment is read: the planning record's, else the parked
  # cycle's. Everything on the issue can be written with the bot's token.
  st=$(plan_state "$n")
  qid=""
  qkind=""
  if [ -f "$st" ]; then
    qid=$(jq -r '.comment // ""' "$st" 2>/dev/null) || qid=""
    qkind=plan
  fi
  case "$qid" in '' | *[!0-9]*) qid="" ;; esac
  if [ -z "$qid" ]; then
    qid=$(cat "$(park_id "$n")" 2>/dev/null) || qid=""
    qkind=park
    case "$qid" in
      '' | *[!0-9]*)
        qid=""
        qkind=""
        ;;
    esac
  fi
  # shellcheck disable=SC2016  # $owner, $name and $number are GraphQL variables
  gh_json api graphql -F owner="${repo%%/*}" -F name="${repo##*/}" -F number="$n" \
    -f query='query($owner: String!, $name: String!, $number: Int!) {
      repository(owner: $owner, name: $name) { issue(number: $number) {
        comments(last: 100) { nodes { databaseId author { login } body createdAt lastEditedAt editor { login } } } } } }'
  # With nothing on record the newest question of the bot is still read, only
  # to be able to tell a person that their answer starts nothing.
  ans=$(q_answer "$bot" "$TEHAS_ALLOWED_LABELERS" "$qid" <<<"$json") || { log "ERROR: unreadable comments of #$n"; exit 1; }
  if [ "$(jq -r .asked <<<"$ans")" != true ]; then
    [ -z "$qid" ] || log "skip #$n: its question is not among the last 100 comments"
    continue
  fi
  kind=$(jq -r .kind <<<"$ans")
  tick=$(jq -r .tick.status <<<"$ans")
  by=$(jq -r '.tick.by // ""' <<<"$ans")
  # The marker must agree with where the comment is and with what kind of
  # question the host has on record.
  if [ -n "$qid" ] && { [ "$(jq -r .issue <<<"$ans")" != "$n" ] || [ "$kind" != "$qkind" ]; }; then
    log "skip #$n: the question on record does not belong to this issue"
    continue
  fi

  # A tick that is no answer is undone, so the boxes show what was accepted.
  if [ "$tick" = stranger ] || [ "$tick" = many ]; then
    log "skip #$n: boxes ticked by '${by:-unknown}' are no answer ($tick)"
    if [ "$dry" = 0 ]; then
      if [ "$tick" = many ]; then
        note="More than one box was ticked, so nothing was chosen. Tick one."
      else
        note="A box was ticked by an account that may not answer for this factory (${by:-unknown}). It was unticked."
      fi
      untick "$n" "$ans" "$note" || log "WARN: could not untick the question on #$n"
    fi
    tick=none
  fi

  case "$kind" in
    park)
      # Only a tick answers a parked cycle: a comment there is discussion.
      [ "$tick" = one ] || continue
      # Only the question on record can start a cycle. A box in any other
      # comment is emptied, so that it cannot be taken for an order given.
      if [ "$qkind" != park ]; then
        log "skip #$n: a box was ticked in a question this host has no record of"
        if [ "$dry" = 0 ]; then
          untick "$n" "$ans" "This question is not one the factory is waiting on. To retry, remove \`needs-human-attention\` and apply \`tehas:ready\` again." ||
            log "WARN: could not untick the question on #$n"
        fi
        continue
      fi
      # What was ticked is read from its text, not its place in the list.
      qbody=$(jq -r .body <<<"$ans") || qbody=""
      qbody=${qbody//$'\r'/}
      if ! grep -qix -e '- \[x\] Retry from a clean start' <<<"$qbody"; then
        # The record goes only with the label: while the label stays, the
        # next poll reads the same tick and tries again.
        if [ "$dry" = 0 ]; then
          if gh issue edit "$n" --repo "$repo" --remove-label tehas:question >/dev/null 2>&1; then
            rm -f "$(park_id "$n")"
          else
            log "WARN: label change on #$n failed: --remove-label tehas:question"
          fi
        fi
        continue
      fi
      # A retry counts only on an issue that is parked now. The tick is undone:
      # left in place it would start a cycle later, when the labels change.
      case "$have" in
        *" tehas:running "* | *" tehas:awaiting-merge "*) parked=0 ;;
        *" needs-human-attention "*) parked=1 ;;
        *) parked=0 ;;
      esac
      if [ "$parked" = 0 ]; then
        log "skip #$n: a retry was ticked but the issue is not parked"
        if [ "$dry" = 0 ]; then
          untick "$n" "$ans" "Retry was ticked, but this issue is not parked, so nothing was started." ||
            log "WARN: could not untick the question on #$n"
        fi
        continue
      fi
      # The tick approves the text as it was at that moment, as the label does.
      gh_json api "repos/$repo/issues/$n/events?per_page=100" --paginate
      events=$json
      unchanged_since "$n" "$(jq -r .tick.at <<<"$ans")" "$by ticked retry" "untick the box and tick it again" || continue
      if [ "$held" = 1 ]; then
        [ "$dry" = 1 ] && log "holding: $awaiting issues await merge (limit $max_awaiting)"
        continue
      fi
      mesh_ok || exit 0
      if [ "$dry" = 1 ]; then
        log "would run a cycle for #$n (retry ticked by $by)"
        exit 0
      fi
      # One tick is one start. Unticking edits the comment as the bot, so the
      # bot becomes its last editor and the tick cannot be read a second time.
      if ! untick "$n" "$ans"; then
        log "ERROR: could not use up the retry tick on #$n, not starting a cycle"
        continue
      fi
      run_cycle "$n" "$by" "retry ticked" "retry tick" --remove-label needs-human-attention --remove-label tehas:question
      exit 0
      ;;
    plan)
      # A reply says more than a box, so it wins when both are there.
      reply=$(jq -r '.reply.text // ""' <<<"$ans")
      if [ -n "$reply" ]; then
        by=$(jq -r .reply.by <<<"$ans")
      elif [ "$tick" != one ]; then
        continue
      fi
      if [ ! -f "$st" ]; then
        [ "$dry" = 1 ] || plan_end "$n" "The record of this planning session is gone from the host, so it cannot continue. Apply \`tehas:plan\` to start a new one."
        continue
      fi
      # Only the question the session is waiting on counts: an older or stray
      # bot question must not run a turn. With an id on record the comment was
      # chosen by it and this always holds. It stops the case of a record that
      # names no question, where the newest question of the bot was read.
      if [ "$(jq -r '.comment // ""' "$st" 2>/dev/null)" != "$(jq -r .comment <<<"$ans")" ]; then
        log "skip #$n: the question answered is not the one this session is waiting on"
        continue
      fi
      if [ -n "$reply" ]; then
        text="The operator replied on the issue:

$reply"
      else
        idx=$(jq -r .tick.index <<<"$ans")
        # The last box is always the way out.
        if [ "$idx" = "$(($(jq -r .boxes <<<"$ans") - 1))" ]; then
          [ "$dry" = 1 ] || plan_end "$n" "Planning session ended by $by."
          continue
        fi
        choice=$(jq -r --argjson i "$idx" '.options[$i] // ""' "$st" 2>/dev/null) || choice=""
        if [ -z "$choice" ]; then
          log "skip #$n: the ticked box matches no option on record"
          continue
        fi
        text="The operator chose: $choice"
      fi
      mesh_ok || exit 0
      if [ "$dry" = 1 ]; then
        log "would run a planning turn for #$n (answer from $by)"
        exit 0
      fi
      printf '%s\n' "$text" >"$st.answer"
      log "planning #$n continues (answer from $by)"
      plan_turn "$n" next "$st.answer"
      "$status_cmd"
      exit 0
      ;;
  esac
done

# 4. New planning sessions. The label approves the text, as tehas:ready does,
# so the text is read before the approval is checked: an edit made in between
# is then seen by the check.
gh_json issue list --repo "$repo" --state open --label tehas:plan --limit 100 --json number,labels
plans=$(jq -r '[.[] | (.labels | map(.name)) as $l
        | select((["tehas:planning", "tehas:question", "tehas:running"] - $l | length) == 3) | .number]
        | sort | .[]' <<<"$json") || { log "ERROR: unreadable list of issues to plan"; exit 1; }
for n in $plans; do
  gh_json issue view "$n" --repo "$repo" --json title,body
  brief=$json
  approval "$n" tehas:plan || continue
  mesh_ok || exit 0
  if [ "$dry" = 1 ]; then
    log "would start a planning session for #$n (labelled by $who)"
    exit 0
  fi
  st=$(plan_state "$n")
  rm -f "$st" "$st.out" "$st.answer"
  jq -r '"# \(.title // "")\n\n\(.body // "")"' <<<"$brief" >"$st.brief" ||
    { log "ERROR: unreadable text of #$n"; exit 1; }
  log "start planning #$n (labelled by $who)"
  plan_turn "$n" first "$st.brief"
  "$status_cmd"
  exit 0
done

if [ "$held" = 1 ]; then
  [ "$dry" = 1 ] && log "holding: $awaiting issues await merge (limit $max_awaiting)"
  exit 0
fi

# 5. and 6. Candidates: urgent first, then by number.
gh_json issue list --repo "$repo" --state open --label tehas:ready --limit 100 --json number,labels
ready_json=$json
candidates=$(jq -r '[.[] | (.labels | map(.name)) as $l
          | select(($l | index("tehas:running") | not) and ($l | index("tehas:awaiting-merge") | not)
                   and ($l | index("needs-human-attention") | not))
          | {number, urgent: ($l | index("tehas:urgent") != null)}]
         | sort_by([(.urgent | not), .number]) | .[].number' <<<"$ready_json") ||
  { log "ERROR: unreadable list of ready issues"; exit 1; }

if [ -n "$candidates" ]; then
  mesh_ok || exit 0
fi

issue=""
have=""
for n in $candidates; do
  have=" $(jq -r --argjson n "$n" '[.[] | select(.number == $n) | (.labels // [])[].name] | join(" ")' <<<"$ready_json") "
  # One issue is in one flow at a time. A cycle's park question would hide the
  # session's question, and the session would then end with nobody told. The
  # record counts as well as the label: between turns only the record shows
  # that a session is open.
  if [ -e "$(plan_state "$n")" ] || [[ $have == *" tehas:planning "* ]]; then
    log "skip #$n: a planning session is open on it; end it first"
    continue
  fi
  approval "$n" tehas:ready || continue
  issue=$n
  break
done

if [ -z "$issue" ]; then
  [ "$dry" = 1 ] && log "nothing to do"
  exit 0
fi
if [ "$dry" = 1 ]; then
  log "would run a cycle for #$issue (labelled by $who)"
  exit 0
fi

# A parked issue retried by its labels still carries the label of its old
# question. It goes with the start. Only then: gh refuses to remove a label
# the repository does not have.
old_question=()
[[ $have == *" tehas:question "* ]] && old_question=(--remove-label tehas:question)
run_cycle "$issue" "$who" labelled "\`tehas:ready\` label" --remove-label tehas:ready "${old_question[@]}"
