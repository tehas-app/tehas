#!/usr/bin/env bash
# tehas: the command a person types on the host. `tehas help` lists the
# commands; the console chooses one and runs it (console/src/front.rs).
#
# Exit: the command's; 1 no libexec beside this file; 78 no console. With no
# console tehas setup runs its script, which builds one from a checkout.
libexec=$(cd "$(dirname "${BASH_SOURCE[0]}")/../libexec" && pwd) ||
  { echo "tehas: no libexec directory beside $(dirname "${BASH_SOURCE[0]}")" >&2; exit 1; }
console=${TEHAS_CONSOLE:-$libexec/console}
[ -x "$console" ] || [ "${1-}" != setup ] || exec "$libexec/setup" "${@:2}"
[ -x "$console" ] || { echo "tehas: no console at $console: run install.sh" >&2; exit 78; }
exec "$console" front "$libexec" "$EUID" "$BASH" tehas "$@"
