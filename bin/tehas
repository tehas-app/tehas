#!/usr/bin/env bash
# tehas: the command a person types on the host.
#
# Usage:
#   tehas dispatch [--dry-run]       one poll of the issue queue, by hand
#   tehas work <issue> [--restart]   one cycle for an issue, by hand
#   tehas plan <issue> ...           one turn of a planning session, by hand
#   tehas dev [<name>]               an interactive session on the host, by hand
#   tehas index                      build the code index the agents search
#   tehas update [--check]           bring this host up to date with the platform
#   tehas labels                     create the tehas labels in the repository
#   tehas status [--json]            print the state of the factory
#   tehas api [--json]               what this factory speaks, for a program
#   tehas limit [set ...|clear]      an outside cap on what this factory starts
#   tehas drain [--wait S] [--json]  start nothing new, wait for running cycles
#   tehas history [--json] [--after C] [--issue N]  the cycles that ended
#   tehas export --after C <dir>     copy them elsewhere, masked
#   tehas top [--once|--json]        one screen of what the factory is doing
#   tehas analytics report|export    the factory's last 365 days of runs
#   tehas mcp key                    a new key for the read-only MCP server
#   tehas pause [reason]             stop this host from starting new work
#   tehas resume                     lift this host's pause flag
#   tehas stop <issue> [--keep-workspace]  end a cycle by hand, clear what it left
#   tehas help [command]             this text, or the text of one command
#
# Each command is a script in ../libexec, and this only chooses one and runs
# it with the remaining arguments: it loads no settings and calls nothing
# else. The exit status is the script's. What the timers and services run is
# tehasbot, beside this file.
#
# Exit: the status of the command that ran; 64 a command this does not know.
set -uo pipefail

libexec=$(cd "$(dirname "${BASH_SOURCE[0]}")/../libexec" && pwd) ||
  { echo "tehas: no libexec directory beside $(dirname "${BASH_SOURCE[0]}")" >&2; exit 1; }

# The text of a script is its own header comment: every line from the second to
# the first one that is not a comment, with the leading "# " removed.
usage_of() {
  sed -n '2,/^[^#]/p' "$1" | sed -n '/^#/s/^# \{0,1\}//p'
}

# script <command>: the file behind a command, or nothing.
script() {
  case "$1" in
    dispatch | work | plan | dev | index | update | labels | top | pause | resume | stop | api | limit | drain | history | export | mcp) echo "$libexec/$1" ;;
    status) echo "$libexec/summary" ;;
    analytics) echo "$libexec/analytics-cmd" ;;
  esac
}

unknown() {
  printf 'tehas: unknown command: %s\n' "$1" >&2
  usage_of "$0" >&2
  exit 64
}

case "${1-help}" in
  help | -h | --help)
    if [ "$#" -le 1 ] || [ "$2" = help ]; then
      usage_of "$0"
      exit 0
    fi
    file=$(script "$2")
    [ -n "$file" ] || unknown "$2"
    usage_of "$file"
    exit 0
    ;;
esac

file=$(script "$1")
[ -n "$file" ] || unknown "$1"
shift
# The same text for every command, whether or not its script knows --help.
case "$#:${1-}" in
  1:-h | 1:--help)
    usage_of "$file"
    exit 0
    ;;
esac
exec "$file" "$@"
