#!/usr/bin/env bash
# tehas: the command a person types on the host.
#
# Usage:
#   tehas dispatch [--dry-run]       one poll of the issue queue, by hand
#   tehas work <issue> [--restart]   one cycle for an issue, by hand
#   tehas plan <issue> ...           one turn of a planning session, by hand
#   tehas dev [<name>]               an interactive session on the host, by hand
#   tehas index                      build the code index the agents search
#   tehas setup [options]            write this host's instance and start the factory
#   tehas update [--check]           bring this host up to date with the platform
#   tehas labels                     create the tehas labels in the repository
#   tehas check-product [--sandbox]  check the product against the contract
#   tehas init-product [--dry-run]   propose the missing contract files
#   tehas status [--json]            print the state of the factory
#   tehas api [--json]               what this factory speaks, for a program
#   tehas disk [--full] [--json]     how full this host is, and what fills it
#   tehas limit [set ...|clear]      an outside cap on what this factory starts
#   tehas drain [--wait S] [--json]  start nothing new, wait for running cycles
#   tehas history [--json] [--after C] [--issue N]  the cycles that ended
#   tehas export --after C <dir>     copy them elsewhere, masked
#   tehas state pack|unpack -        move a stopped factory's state to another machine
#   tehas top [--once|--json]        one screen of what the factory is doing
#   tehas analytics report|export    the factory's last 365 days of runs
#   tehas mcp key                    a new key for the read-only MCP server
#   tehas pause [reason]             stop this host from starting new work
#   tehas resume                     lift this host's pause flag
#   tehas stop <issue> [--keep-workspace]  end a cycle by hand, clear what it left
#   tehas help [command]             this text, or the text of one command
#
# Each command is a script in ../libexec or a verb of the console. This runs
# one with the remaining arguments and loads no settings: with-settings does
# that for a verb that needs them. The timers and services run tehasbot.
#
# Exit: the status of the command that ran; 64 a command this does not know;
# 78 the text of a command the console holds, and no console.
set -uo pipefail

libexec=$(cd "$(dirname "${BASH_SOURCE[0]}")/../libexec" && pwd) ||
  { echo "tehas: no libexec directory beside $(dirname "${BASH_SOURCE[0]}")" >&2; exit 1; }
console=${TEHAS_CONSOLE:-$libexec/console}

# The text of a script is its own header comment: every line from the second to
# the first one that is not a comment, with the leading "# " removed.
usage_of() {
  sed -n '2,/^[^#]/p' "$1" | sed -n '/^#/s/^# \{0,1\}//p'
}

# script <command>: the file behind a command, or nothing.
script() {
  case "$1" in
    dispatch | work | plan | dev | index | setup | update | history | export | check-product | init-product) echo "$libexec/$1" ;;
  esac
}

# verb <command>: whether the command is a verb of the console.
verb() {
  case "$1" in
    status | disk | state | limit | pause | analytics | top | api | labels | resume | drain | stop | mcp) ;;
    *) return 1 ;;
  esac
}

unknown() {
  printf 'tehas: unknown command: %s\n' "$1" >&2
  usage_of "$0" >&2
  exit 64
}

# text <command>: print the text of a command and end.
text() {
  # A checkout that has built no console still shows what setup will do.
  local own=$libexec/../console/src/usage/setup.txt
  [ "$1" != setup ] || [ -x "$console" ] || [ ! -r "$own" ] || exec cat "$own"
  if verb "$1" || [ "$1" = update ] || [ "$1" = setup ]; then
    [ -x "$console" ] || { echo "tehas $1: no console at $console, so no text to show: run install.sh" >&2; exit 78; }
    exec "$console" usage "$1"
  fi
  file=$(script "$1")
  [ -n "$file" ] || unknown "$1"
  usage_of "$file"
  exit 0
}

case "${1-help}" in
  help | -h | --help)
    if [ "$#" -le 1 ] || [ "$2" = help ]; then
      usage_of "$0"
      exit 0
    fi
    text "$2"
    ;;
esac

verb "$1" || [ -n "$(script "$1")" ] || unknown "$1"
# The same text for every command, whether or not it knows --help.
case "$#:${2-}" in
  2:-h | 2:--help) text "$1" ;;
esac
case "$1" in
  status | disk) exec "$console" tehas "$@" ;;
  top)
    [ -x "$console" ] || { echo "tehas top: no console at $console, run install.sh" >&2; exit 1; }
    exec "$console" tehas "$@"
    ;;
  state | limit | pause | analytics | api | labels | resume | drain | stop) exec "$libexec/with-settings" tehas "$@" ;;
  mcp) [ "${2-}" != serve ] || exec "$libexec/with-settings" tehas "$@"; exec "$console" tehas "$@" ;;
esac
file=$(script "$1")
shift
exec "$file" "$@"
