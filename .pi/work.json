{
  "version": 1,
  "verify": {
    "fast": "scripts/verify.sh --changed",
    "full": "scripts/verify.sh",
    "test": "scripts/lean-test.sh {file}",
    "format": "rustfmt --edition 2021 {file}",
    "roster": "scripts/lean-roster.sh {dir} {report}",
    "testDirs": [
      "console/tests",
      "console/analytics/tests",
      "console/contractor/tests",
      "console/core/tests",
      "console/cycle/tests",
      "console/dispatch/tests",
      "console/front/tests",
      "console/proxy/tests",
      "console/store/tests"
    ],
    "testGlob": "*.rs"
  },
  "budgets": {
    "specify": {
      "turns": 800,
      "tokens": 150000000,
      "minutes": 45
    },
    "build": {
      "turns": 800,
      "tokens": 150000000,
      "minutes": 60
    },
    "challenge": {
      "turns": 800,
      "tokens": 150000000,
      "minutes": 30
    },
    "review": {
      "turns": 800,
      "tokens": 150000000,
      "minutes": 45
    }
  }
}
