run
--pull=never
--rm
--name
tehas-check-product-@RANDOM@-gates
--cgroup-parent
tehas.slice
--memory
2048m
--memory-swap
2048m
--memory-reservation
2g
--cpus
15.00
--pids-limit
4096
--cpu-shares
1024
--user
@UID@:@GID@
-e
HOME=/home/vscode
-v
@T@/home/tehas/tmp/widget/check-product.@RANDOM@:@T@/home/tehas/tmp/widget/check-product.@RANDOM@
-w
@T@/home/tehas/tmp/widget/check-product.@RANDOM@/tree
--entrypoint
bash
tehas/pi-rukas:uid@UID@
-c
sh .pi/worktree-setup && sh -c "$1" && sh -c "$2"
gates
make full
make smoke
