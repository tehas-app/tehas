run
--rm
--cgroup-parent
tehas.slice
--memory
4g
--memory-swap
4g
--user
@UID@:@GID@
-e
HOME=/home/vscode
-v
@T@/home/tehas/tmp/widget/check-product.@RANDOM@:@T@/home/tehas/tmp/widget/check-product.@RANDOM@
-w
@T@/home/tehas/tmp/widget/check-product.@RANDOM@/clone
--entrypoint
bash
tehas/pi-rukas:uid@UID@
-c
set -e\nmissing=\ncommand -v bun >/dev/null 2>&1 || { echo "no bun in the sandbox image" >&2; missing=1; }\n[ -z "$missing" ] || exit 69\necho 'install extension/: bun install --frozen-lockfile' >&2\n(cd 'extension' && bun install --frozen-lockfile)\n
