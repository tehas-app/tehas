run
--rm
--cgroup-parent
tehas.slice
--memory
2048m
--memory-swap
2048m
--memory-reservation
2g
--cpus
15.00
--pids-limit
4096
--cpu-shares
1024
--cap-drop
ALL
--cap-add
CHOWN
--cap-add
FOWNER
--security-opt
no-new-privileges:true
--tmpfs
/tmp:rw,exec,nosuid,nodev,size=1024m,mode=1777
--user
@UID@:@GID@
-e
HOME=/home/vscode
--add-host=models:192.0.2.9
--network
tehas-egress
-e
HTTPS_PROXY=http://tehas-egress:3128
-e
HTTP_PROXY=http://tehas-egress:3128
-e
https_proxy=http://tehas-egress:3128
-e
http_proxy=http://tehas-egress:3128
-e
NO_PROXY=localhost,127.0.0.1
-e
no_proxy=localhost,127.0.0.1
-e
NODE_USE_ENV_PROXY=1
-w
@T@/home/tehas/work/widget
-v
@T@/home/tehas/work/widget-7:@T@/home/tehas/work/widget
--entrypoint
bash
tehas/pi-rukas:uid@UID@
-c
set -e\nmissing=\ncommand -v bun >/dev/null 2>&1 || { echo "no bun in the sandbox image" >&2; missing=1; }\n[ -z "$missing" ] || exit 69\necho 'install extension/: bun install --frozen-lockfile' >&2\n(cd 'extension' && bun install --frozen-lockfile)\n
