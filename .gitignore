# State pi-rukas keeps in the product checkout during a cycle.
.pi/work-state/
.pi/permissions.json
.pi/decisions.json
# Worktrees of parked or running cycles.
.worktrees/
# Local tool state of people working on this repository.
.claude/
.serena/
# Scratch directories pi-rukas makes in the product checkout during a cycle.
/tmp/
# The private list of names for scripts/check-generic.sh. Never committed.
/scripts/check-generic.names
# The console's build: install.sh compiles it here.
/console/target/
# What a cargo build whose workspace root is this repository leaves behind.
# The gate builds the console, so an unignored target/ at the root reads as
# dirt to a gate that checks the tree is clean.
/target/
