[Unit]
Description=Tehas: one run of the improvement loop, reads the cycles that ended

[Service]
Type=oneshot
ExecStart=/bin/bash -c ". %h/tehas/env.sh && exec %h/tehas/bin/tehasbot improve >> %h/tehas/logs/improve.log 2>&1"
# The analyst is given sixty minutes and one more to be killed, and the uploads
# follow it.
TimeoutStartSec=90min
