[Unit]
Description=Tehas: remove what the host can make again

[Service]
Type=oneshot
ExecStart=/bin/bash -c ". %h/tehas/env.sh && exec %h/tehas/bin/tehasbot clean >> %h/tehas/logs/clean.log 2>&1"
# Three steps: a walk of the kept workspaces, one docker prune, and the scratch
# under tmp/. A host with a full disk is the slow case, and it is still minutes.
TimeoutStartSec=30min
