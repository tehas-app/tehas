# Installed by "sudo ./bootstrap.sh slice" to /etc/systemd/system, and started
# by 96-tehas-memory-online.rules when a memory block comes online. One reload
# of the system manager, so tehas.slice takes its MemoryMax from the memory the
# host has now. Why a oneshot, and what the limits below are for, is in the
# manual's slice section. Never started by hand and never at boot.
[Unit]
Description=Tehas: reload systemd so tehas.slice follows memory added to the host
# udevd pulls this in for each block that comes online; systemd coalesces the
# requests into the one run of a oneshot that has not finished.
Conflicts=shutdown.target
Before=shutdown.target
# A device that flaps memory online would ask for the reload without limit.
# systemd reads these two in [Unit] only.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=oneshot
# The path of the Ubuntu systemd this ships with. A reload that hangs would
# hold every later memory-online event in the same unfinished run.
TimeoutStartSec=60
ExecStart=/usr/bin/systemctl daemon-reload
