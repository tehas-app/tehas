# The edge router: one server for everything tehas publishes by name. Plain
# HTTP, bound to the instance's TEHAS_HOST_ADDR in router.compose.yaml; the
# proxy in front of the host carries the certificate.
#
# It picks by the first label of the Host header, so no domain is written here:
#   plugin-<name>.  a plugin's view, and
#   plugins.        the plugins' sign-in: both only by the gate,
#                   tehas-plugin-gate, at TEHAS_PLUGIN_GATE_ADDR
#   uat-<number>.   the preview of that pull request, a container named
#                   tehas-preview-<number> that `tehasbot preview` runs
#   uat-main.       the preview of the default branch, a container named
#                   tehas-preview-main that the same command runs
#   item-<number>.  that item's page and its files, as the item store wrote
#                   them under $TEHAS_HOME/items
#   anything else   the items by path: the list at /, an item at /<number>/
#
# This file is fixed. Nothing writes it when a preview comes or goes: Docker's
# own name lookup finds the container, and a name it does not find is a 404.
#
# It is a server of its own, apart from the dashboard, because an item's files
# and a preview are somebody's HTML and script.
{
    auto_https off
    admin off
}
:8081 {
    header X-Robots-Tag "noindex, nofollow"
    header X-Content-Type-Options "nosniff"

    # A dot after the label, or a dash under TEHAS_EDGE_ONE_LEVEL: the gate
    # checks the whole name. A plugin's name is a letter and up to 11 more.
    @plugin header_regexp plugin Host (?i)^(plugin-[a-z][a-z0-9]{0,11}|plugins)[.-]
    # Any other name that starts so: no plugin can have it.
    @noplugin header_regexp noplugin Host (?i)^plugin
    @preview header_regexp preview Host ^uat-([1-9][0-9]{0,8})\.
    @main header_regexp main Host ^uat-main\.
    @item header_regexp item Host ^item-([1-9][0-9]{0,8})\.
    # A uat- or item- name that is neither of the above: no number, or one
    # that starts with a zero.
    @odd header_regexp odd Host ^(uat|item)-
    @look path /fun/*.css /fun/*.ttf /fun/*.woff2 /fun/*.svg
    @kept path */.*
    @hostfiles path /files/*
    @pathfiles path_regexp ^/[0-9]+/files/.

    route {
        # The plugins' names first, and only to the gate: nothing of the
        # previews or the items answer them. The gate sets its own
        # headers; what it says about sniffing this server has already said.
        # The address is the gate's own, which router.compose.yaml always
        # gives; the loopback is for a caddy run without it.
        handle @plugin {
            reverse_proxy {$TEHAS_PLUGIN_GATE_ADDR:127.0.0.1:8095} {
                header_down -X-Robots-Tag
                header_down -X-Content-Type-Options
            }
        }
        handle @noplugin {
            respond "No plugin is set at this address." 404
        }

        # A preview answers for itself. What it says about indexing and
        # sniffing is dropped: this server has already said it.
        handle @preview {
            reverse_proxy tehas-preview-{re.preview.1}:8080 {
                header_down -X-Robots-Tag
                header_down -X-Content-Type-Options
            }
        }

        handle @main {
            reverse_proxy tehas-preview-main:8080 {
                header_down -X-Robots-Tag
                header_down -X-Content-Type-Options
            }
        }

        # From here on, the items.
        header Referrer-Policy "no-referrer"
        # The pages are rebuilt in place; a browser asks again every time.
        header Cache-Control "no-cache"
        # What the item store keeps for itself: stamps, lists, work in progress.
        respond @kept 404
        # The typeface, the style sheets and the sprites, shared with the
        # dashboard. Its page and its scripts stay there.
        handle @look {
            root * /srv/fun
            # Each page names the theme file and the logo it is drawn with, here
            # as on the docs server: nothing in this file picks a look.
            uri strip_prefix /fun
            file_server
        }
        # One item under a name of its own, so one item's script is a
        # stranger to another's.
        handle @item {
            root * /srv/items/{re.item.1}
            # An item's files, served as they are. The sandbox gives each one
            # an origin with nothing in it. Scripts may run.
            handle @hostfiles {
                header Content-Security-Policy "sandbox allow-scripts allow-forms allow-modals allow-pointer-lock"
                # A sandboxed page asks for its own scripts and data as a stranger.
                header Access-Control-Allow-Origin "*"
                file_server
            }
            # The page the item store wrote: no script, nothing from elsewhere.
            handle {
                header Content-Security-Policy "default-src 'none'; style-src 'self'; img-src 'self' data:; media-src 'self'; font-src 'self'; frame-src 'self'; base-uri 'none'; form-action 'none'"
                file_server
            }
        }
        handle @odd {
            respond "No such address." 404
        }
        # The items by path: their list, and every item for a host that has
        # no domain for the edge.
        handle {
            root * /srv/items
            handle @pathfiles {
                header Content-Security-Policy "sandbox allow-scripts allow-forms allow-modals allow-pointer-lock"
                header Access-Control-Allow-Origin "*"
                file_server
            }
            handle {
                header Content-Security-Policy "default-src 'none'; style-src 'self'; img-src 'self' data:; media-src 'self'; font-src 'self'; frame-src 'self'; base-uri 'none'; form-action 'none'"
                file_server
            }
        }
    }
    handle_errors {
        # The gate is stopped, or the router cannot reach its address.
        @gatedown {
            header_regexp Host (?i)^plugin
            expression `{err.status_code} in [502, 503, 504]`
        }
        respond @gatedown "The plugins' gate is not answering. Its unit is tehas-plugin-gate.service." 503
        # No container of that name, or one that does not answer.
        @nopreview expression `{err.status_code} in [502, 503, 504]`
        respond @nopreview "No preview is running at this address. One is built within five minutes of a push to a pull request or to the default branch. A pull request's is removed when it is closed." 404
        respond "{err.status_code} {err.status_text}" {err.status_code}
    }
}
