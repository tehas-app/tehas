# Tehas operating manual. Plain HTTP, private network only (bound to the
# instance's TEHAS_HOST_ADDR in docs.compose.yaml). Renders the installed docs/*.md
# through one layout template; there is no build step.
{
    auto_https off
    admin off
}
:8080 {
    root * /srv/docs
    # Search engines stay out unless the instance sets TEHAS_INDEXING=1. The
    # pages and robots.txt read the same setting. The live data and the
    # Markdown copies of the pages are never indexed.
    @unlisted expression `"{$TEHAS_INDEXING:0}" != "1"`
    header @unlisted X-Robots-Tag "noindex, nofollow"
    @data path /live/* /health /healthz *.md
    header @data X-Robots-Tag "noindex"
    # The pages, their scripts and their stylesheets go out compressed: zstd
    # where the browser speaks it and gzip elsewhere. The files under /live/ and
    # the two health addresses are left alone, because the dashboard's console
    # reads them with Range requests, whose offsets count the file's own bytes,
    # and an encoded body has none of those (host/fun/dashboard-view.js).
    @compress not path /live/* /health /healthz
    encode @compress zstd gzip
    # route keeps this order: the 404 has to see the path before the rewrite.
    # No page here is meant to be read as another type than the one it is sent as.
    header X-Content-Type-Options "nosniff"
    route {
        # /host/ belongs to a host that fronts the domain, never to tehas: the
        # dashboard reads a 404 for /host/bridge.json as "no host". See "The
        # host bridge" in api.md.
        @host path /host /host/*
        respond @host 404
        # Dashboard data: the queue snapshot and the running cycle's console.
        # Plain files written by the dispatcher; the page polls them, the
        # console with Range requests so it only fetches what is new.
        handle_path /live/* {
            root * /srv/live
            # Only the finished files: not a half-written one, not a dotfile.
            @unfinished path *.new /.*
            respond @unfinished 404
            # Only the files the manual lists: "Files under live/" in api.md.
            # The two lists are one, and test/edge_test.sh says so; a name a
            # writer adds under live/ is served once both name it. The health
            # handlers below read /srv/live outside this list on purpose.
            @unnamed not path /status.json /running.json /endings.json /epics.json /health.json /health.down /dispatch.json /demand.json /energy.json /analytics.json /orders.json /top.json /panels.json /disk.json /platform.json /rukas.json /previews.json /protolab.json /cycles/*.json /console-*.txt /console-*.txt.now
            respond @unnamed 404
            header Cache-Control "no-store"
            file_server
        }
        # Factory health for monitors, at /health and /healthz: the file
        # `tehasbot health` writes. 200 normally; 503 with the same body while
        # `tehasbot health` keeps the marker live/health.down in place.
        @health path /health /healthz
        @health_down {
            path /health /healthz
            file {
                root /srv/live
                try_files /health.down
            }
        }
        handle @health_down {
            root * /srv/live
            rewrite * /health.json
            header Content-Type "application/health+json"
            header Cache-Control "no-store"
            file_server {
                status 503
            }
        }
        handle @health {
            root * /srv/live
            rewrite * /health.json
            header Content-Type "application/health+json"
            header Cache-Control "no-store"
            file_server
        }
        # The instance's design (TEHAS_DESIGN) picks the front page: the
        # business page for beesknees26, the default, and the factory floor for
        # pixel. Both are always at /business and /floor too. Static pages are
        # outside both; their assets stay under /fun/. The plain dashboard is
        # at /dashboard.
        redir /fun /
        redir /fun/ /
        # The pages keep their names and are revalidated every time: install.sh
        # may have replaced them, and a page is small enough to ask about. The
        # scripts and stylesheets it names keep their content under a hashed
        # name, cached for ever, which is why a page is never cached.
        @business expression `path('/business') || (path('/') && "{$TEHAS_DESIGN:beesknees26}" != "pixel")`
        handle @business {
            root * /srv/fun
            rewrite * /business.html
            header Cache-Control "no-cache"
            templates
            file_server
        }
        @front path / /floor
        handle @front {
            root * /srv/fun
            rewrite * /index.html
            header Cache-Control "no-cache"
            # A template only for the absolute address in its share tags.
            templates
            file_server
        }
        handle_path /fun/* {
            root * /srv/fun
            # Each page names the theme file, the logo and the share card it is
            # drawn with, from TEHAS_DESIGN as the template reads it. Nothing
            # here rewrites a look.
            # install.sh keeps the previous copy of a replaced file beside it.
            @backup path *.prev
            respond @backup 404
            # install.sh gives every script and stylesheet a page names by tag
            # a name with the first 12 hex digits of its content in it, so a
            # name always holds the same bytes and may be cached for ever. The
            # theme file, which a template names at the request, stays as it is
            # and is revalidated.
            @hashed path_regexp ^/[A-Za-z0-9_.-]+\.[0-9a-f]{12}\.(js|css)$
            header @hashed Cache-Control "public, max-age=31536000, immutable"
            file_server
        }
        # For agents: the entry point. A template, so its links are absolute
        # from the request and no host name is kept in the file. robots.txt and
        # the sitemap are for the same reason, and to follow TEHAS_INDEXING.
        @llms path /llms.txt /robots.txt /sitemap.xml
        handle @llms {
            templates {
                mime text/plain text/xml
            }
            file_server
        }
        # The manual pages as Markdown, which llms.txt links to.
        @markdown path_regexp ^/[a-z0-9-]+\.md$
        handle @markdown {
            header Content-Type "text/markdown; charset=utf-8"
            file_server
        }
        # Never hand out the fragments, the backups or the layout as files.
        @source path *.md *.frag *.prev /_layout.html
        respond @source 404
        rewrite * /_layout.html
        header Cache-Control "no-cache"
        templates
        file_server
    }
}
