# Versions of everything tehas needs on a host, in one place. Read by
# bootstrap.sh (which installs them) and by sandbox/build.sh (the sandbox image
# takes its shellcheck, its jq, its Rust and rustup, its node, gh and bun, its
# npm trees, its Playwright pin and its Caddy digest from here). OSV_SCANNER is the one pin here that bootstrap.sh does not install: it
# is the scanner the gate of .github/workflows/verify.yml downloads for the
# advisory check.
# Shell KEY=value lines, no logic.
#
# scripts/tag-release.sh moves every version here, and the npm trees beside
# it, to the newest release of the same major before it tags, with what pairs
# with it (scripts/pins.sh). A new major waits for a person.
#
# Change a version on purpose: update the line and its checksum together, run
# `./bootstrap.sh user` on the host, rebuild the sandbox image, and rerun the
# contract test before a cycle uses it.
#
# An npm tool is pinned by a lockfile, not by a download. Its tree is
# host/npm/<name>/ or host/sandbox/npm/<name>/, beside this file: package.json
# names one version and package-lock.json fixes every package in the tree by
# hash. Change one together with its _LOCK_SHA256 here:
#
#   cd host/npm/ctx7            # or host/npm/pi, host/npm/parallel-web-cli,
#                               # or host/sandbox/npm/playwright
#   npm install --package-lock-only --ignore-scripts
#   sha256sum package-lock.json # put that value here next to the version
#   grep '"ctx7":' package.json # and the new version in that package.json
#
# bootstrap.sh checks both halves before it installs anything: the file's
# sha256, and the version the lockfile pins for that package. npm ci then
# refuses any package whose hash does not match the lockfile.
#
# Caddy is pinned by digest wherever a container starts it
# (edge/docs.compose.yaml, edge/router.compose.yaml and preview/Dockerfile in
# this repository). Change these two lines and those three together;
# test/edge_test.sh checks they agree. A digest comes from
# `docker pull caddy:<version>` and
# `docker inspect --format '{{index .RepoDigests 0}}' caddy:<version>`.

NODE_VERSION=22.23.5
GH_VERSION=2.104.0
BUN_VERSION=1.4.4
SHELLCHECK_VERSION=0.11.0
# One jq on the host, in the sandbox image and in CI: a jq program behaves the
# same in all three only when they run the same version.
JQ_VERSION=1.8.2
PI_VERSION=1.5.0
CTX7_VERSION=0.10.0
PARALLEL_CLI_VERSION=0.9.4
PLAYWRIGHT_VERSION=1.65.0
RUST_VERSION=1.100.0
RUSTUP_VERSION=1.29.3
VIPUNE_VERSION=0.20.3
# The embedding model vipune $VIPUNE_VERSION reads, at the revision it asks
# for. The sandbox image carries it, since a cycle cannot download it.
VIPUNE_MODEL=BAAI/bge-small-en-v1.5
VIPUNE_MODEL_REVISION=5c38ec7c405ec4b44b94cc5a9bb96e735b38267a
OO_VERSION=0.10.1
CBM_VERSION=0.12.1
# OSV-Scanner, which the gate scans the lockfiles of this repository with.
OSV_SCANNER_VERSION=2.7.1

# pi-rukas is not pinned: the host's clone and the sandbox image follow the
# newest tag of the major version this tehas works with (release:<major>), so
# a new pi-rukas arrives with the next tehas update. Before 1.0 that is every
# 0.Y.Z; a new major version waits for a tehas change.
# Each image is labelled with the commit it was built on. See console/core/src/rukas.rs.
PI_RUKAS_REPO=https://github.com/trail-openers/pi-rukas.git
PI_RUKAS_FOLLOW=release:0

# Where tehas update and the installer read releases of tehas itself from,
# owner/name on GitHub. An instance may name another in instance.env.
TEHAS_RELEASE_REPO=tehas-app/tehas

# SHA-256 of the release archives for linux x86_64. Node, gh and bun were
# compared with each publisher's own list on 2026-11-02. shellcheck publishes
# none, so its value is what the release served on 2026-10-08. rustup-init is
# the value in the publisher's .sha256 file next to it.
NODE_SHA256=cdeb8670a0c81f51b4dc4ac61919f9b1ad917b304bf8221eb939570663d240f8
GH_SHA256=98cb101ad87dbbd3f6b2f2bfcbd43197ccd07643140121d8a9cfaa91eadbc24e
BUN_SHA256=bf8ccbfb2b0b80159e0f9a6d15c55317add8077534dbc6130a3edb52fccb395c
SHELLCHECK_SHA256=8c3be12b05d5c177a04c29e3c78ce89ac86f1595681cab149b65b97c4e227198
# jq-linux-amd64, a static binary: the value in the release's sha256sum.txt,
# compared with the download on 2026-11-02.
JQ_SHA256=b1c22172dd303f3be49e935aa56aa48a8b7a46e0bc838b4997d3bb451495870f
RUSTUP_SHA256=b1c8cb14e30889e7e2999e6b69e62d9e9b9ffc0f4df8180564d306d9680e6c55
# codebase-memory-mcp's installer script at the tag v$CBM_VERSION.
CBM_INSTALLER_SHA256=13049c7cc51bc508d68b8ecb8a9fd9574ecb7c6f2c9dd5a19bf7d4c187321145
# The sum of osv-scanner_linux_amd64, taken from the osv-scanner_SHA256SUMS the
# release of v$OSV_SCANNER_VERSION publishes beside its binaries, and compared
# with that download on 2026-11-09.
OSV_SCANNER_SHA256=fb7dab19a8bd9bbe5c3189f09d4b7ee1820c9553a23bac202648a56efd2f6ee8
# The two files of that model vipune reads: its ONNX graph and its tokenizer.
VIPUNE_MODEL_SHA256_ONNX=828e1496d7fabb79cfa4dcd84fa38625c0d3d21da474a00f08db0f559940cf35
VIPUNE_MODEL_SHA256_TOKENIZER=d241a60d5e8f04cc1b2b3e9ef7a4921b27bf526d9f6050ab90f9267a1f9e5c66

# sha256 of each npm lockfile named above. It is what tells bootstrap.sh and
# sandbox/build.sh that the tree they are about to install is the one recorded
# here; npm ci then checks every package in it against the lockfile's own hashes.
PI_LOCK_SHA256=29c028c991eb134347a1906b3305ebfb5f2a40bfbf0d28d9a2690a6dd491f6d2
CTX7_LOCK_SHA256=3a0e52fa910401fad06bbbe2670dabdc760863ddd3a63ce7c305ab7989a469c8
PARALLEL_CLI_LOCK_SHA256=6cffbea8547542bd505a1eb34f1c0632510a629b778d260c8c8f492b779b32ee
PLAYWRIGHT_LOCK_SHA256=8fe9d602df1cdb0f36fa3e28c654ce436c1151de189418ada8f40bd86aa417e4

# Caddy, named by digest wherever a container starts it. The version is the
# record of what this digest is; both were taken from caddy:2.11.7 on 2026-11-02.
CADDY_VERSION=2.11.9
CADDY_DIGEST=sha256:0c2243efcf437ab7f7a978f1027fcf0d4f9be8a75df27b1b3fbc5dbe0ffa8cf0
