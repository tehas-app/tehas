#!/usr/bin/env bash
# gh, acting as the factory's GitHub App. host/env.sh puts this directory first
# on PATH, and git's github.com credential helper names this file. Each call takes a token from
# tehasbot github-token, which keeps one and makes a new one before it runs
# out, so a command that runs for hours never holds a token that expired.
# Given TEHAS_GH_TOKEN in its environment it uses that instead and asks for no
# token of its own: the dispatcher's poll takes one at its start and gives it
# to every gh child of the poll, so twenty calls of a poll run the token
# program once and not twenty times (#938).
#
# The real gh is $TEHAS_HOME/bin/gh, where bootstrap.sh installs it.
#
# Writes are measured before anything is throttled (#649 part 1): a call that
# writes to GitHub appends one line to $TEHAS_HOME/state/github-writes.log, the
# time, the kind, the repository, the number, gh's status and 403 or 429. The
# console decides which call that is and writes the line: see `console gh`.
# A read is never logged and goes straight to gh.
#
# On a read-only instance (TEHAS_READ_ONLY=1, #608) the console runs no write
# at all: it says `read-only: would gh <kind> <repo>#<n>` and exits 0. Without
# a console that can be run the shim then runs nothing, not even a read.
#
# Exit: gh's own; 0 for a write a read-only instance refused; 1 when no token
# could be had (tehasbot github-token says why), or read-only with no console.
set -uo pipefail

home=${TEHAS_HOME:-$HOME/tehas}
if [ -n "${TEHAS_GH_TOKEN:-}" ]; then
  # The dispatcher's poll holds the app's token and gives it to every gh child
  # of the poll as TEHAS_GH_TOKEN (#938). The token has at least 10 minutes
  # left and a poll lasts under a minute, so the poll's calls use it and none
  # of them runs tehasbot github-token. An empty value asks for one as before:
  # the poll sets the name only when the program gave it a token.
  GH_TOKEN=$TEHAS_GH_TOKEN
  export GH_TOKEN
else
  GH_TOKEN=$("$home/bin/tehasbot" github-token) || exit 1
  export GH_TOKEN
fi

# Which call is a write and the line it leaves are the console's (`console gh`,
# console/src/gh_shim.rs): a read execs gh from there at once. A console that
# is missing or cannot be run still leaves gh working, with the token above
# and no line in the log, so a host that needs repair keeps its gh.
shopt -s execfail
console=$home/libexec/console
log=${TEHAS_GITHUB_WRITES_LOG:-$home/state/github-writes.log}
[ ! -x "$console" ] || exec "$console" gh "$home/bin/gh" "$log" "$@"
if [ "${TEHAS_READ_ONLY:-0}" = 1 ]; then
  echo "gh: TEHAS_READ_ONLY=1 and no console at $console to refuse a write: nothing was run" >&2
  exit 1
fi
exec "$home/bin/gh" "$@"
