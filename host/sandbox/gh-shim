#!/bin/sh
# gh in a cycle's container. When the host gives the container the GitHub App's
# token directory (lib/sandbox.sh), every call reads the token the host keeps
# fresh there, so a cycle that runs past the hour of one token still pushes and
# comments. Without it, gh is called with the GH_TOKEN the container was given.
# Installed over nothing: the image's gh stays at /usr/bin/gh, and this goes
# earlier on PATH, in /usr/local/bin.
#
# A call that GitHub refuses for a rate limit is tried once more: the output of
# the first call is kept in files under ${TMPDIR:-/tmp} and thrown away, and
# after TEHAS_GH_RETRY_WAIT seconds [60] the same arguments are run again. One
# retry only, and only that call. A call that reads standard input (-, an
# argument that ends in @-, or one that ends in =-, such as --body-file=-) is
# run at once, because its input cannot be read twice.
#
# TEHAS_GH_BIN names the real gh and TEHAS_GH_RETRY_WAIT the pause; both are
# seams for test/gh_shim_test.sh, and the image sets neither.
#
# Exit: gh's own status, or the host's for a relayed call; 0 for a call a
# read-only instance refused; 1 when the token file is there and cannot be
# read, or the host did not answer the relay.
# Lint: scripts/test.sh lints it with shellcheck -x, which takes the shell from
# the shebang; test/gh_shim_test.sh names that shell with -s sh.
real=${TEHAS_GH_BIN:-/usr/bin/gh}
f=/run/tehas/github/token
if [ -r "$f" ]; then
  GH_TOKEN=$(cat "$f") || exit 1
  export GH_TOKEN
fi
# A read-only instance (TEHAS_READ_ONLY=1, #608): a call that may write to
# GitHub is not run. The shim says what it would have done and exits 0, so the
# cycle goes on. What reads is a short list; anything else counts as a write.
# `gh api` reads with -X GET, with no method and no field, or as a graphql
# query that names no mutation. A refused `pr create` leaves its title, branch
# and body in the workspace's git directory, tehas-read-only-pr.md.
if [ "${TEHAS_READ_ONLY:-0}" = 1 ]; then
  write=1
  case "$1 ${2:-}" in
  "issue view" | "issue list" | "issue status" | "pr view" | "pr list" | "pr status" | "pr checks" | "pr diff" | \
    "repo view" | "repo clone" | "label list" | "run view" | "run list" | "release view" | "release list" | "release download" | \
    "auth status" | "auth token" | "auth git-credential" | "auth setup-git" | "search "* | "--version "* | "version "*) write= ;;
  "api "*)
    method='' fields='' graphql='' mutation='' prev=''
    for a in "$@"; do
      case $prev in -X | --method) method=$a ;; esac
      case $a in
      -X?*) method=${a#-X} ;;
      --method=*) method=${a#--method=} ;;
      -f | -F | --field | --raw-field | --input) fields=1 ;;
      graphql) graphql=1 ;;
      *[Mm][Uu][Tt][Aa][Tt][Ii][Oo][Nn]*) mutation=1 ;;
      esac
      prev=$a
    done
    case $method in
    [Gg][Ee][Tt]) write= ;;
    "") if [ -n "$graphql" ]; then [ -n "$mutation" ] || write=; elif [ -z "$fields" ]; then write=; fi ;;
    esac
    ;;
  esac
  if [ -n "$write" ]; then
    echo "read-only: would gh $1 ${2:-}" >&2
    if [ "$1 ${2:-}" = "pr create" ] && [ -n "${PI_ENSEMBLE_WORKSPACE_ROOT:-}" ] &&
      dir=$(git -C "$PI_ENSEMBLE_WORKSPACE_ROOT" rev-parse --absolute-git-dir 2>/dev/null); then
      title='' head='' body='' file='' prev=''
      for a in "$@"; do
        case $prev in
        -t | --title) title=$a ;;
        -H | --head) head=$a ;;
        -b | --body) body=$a ;;
        -F | --body-file) file=$a ;;
        esac
        prev=$a
      done
      {
        printf '# %s\n\nBranch: %s\n\n' "$title" "${head:-$(git -C "$PI_ENSEMBLE_WORKSPACE_ROOT" branch --show-current 2>/dev/null)}"
        if [ -n "$file" ]; then cat -- "$file"; else printf '%s\n' "$body"; fi
      } >"$dir/tehas-read-only-pr.md" 2>/dev/null
    fi
    exit 0
  fi
fi
# A cycle's issue writes go through the host (console/cycle/src/relay.rs): its
# token reads issues and cannot write them. The request is a directory of this
# process's own: the arguments, each ended by a NUL, the body file copied, and
# ready made last. The host answers in res.<pid>, done made last, and is waited
# for TEHAS_RELAY_WAIT seconds [120]. TEHAS_RELAY_DIR is a seam for the tests.
relay=${TEHAS_RELAY_DIR:-/run/tehas/relay}
if [ -d "$relay" ] && [ "$1" = issue ]; then
  case ${2:-} in
  create | edit | comment)
    req=$relay/req.$$ res=$relay/res.$$
    rm -rf "$req" "$res"
    mkdir "$req" || exit 1
    printf '%s\0' "$@" >"$req/args" || exit 1
    prev=''
    for a in "$@"; do
      file=''
      case $prev in -F | --body-file) file=$a ;; esac
      case $a in --body-file=*) file=${a#--body-file=} ;; esac
      if [ "$file" = - ]; then
        cat >"$req/body" || exit 1
      elif [ -n "$file" ]; then
        cat -- "$file" >"$req/body" || exit 1
      fi
      prev=$a
    done
    : >"$req/ready" || exit 1
    wait=${TEHAS_RELAY_WAIT:-120}
    n=0
    until [ -e "$res/done" ]; do
      if [ "$n" -ge "$wait" ]; then
        rm -rf "$req"
        echo "gh-shim: the host did not answer the relay" >&2
        exit 1
      fi
      sleep 1
      n=$((n + 1))
    done
    cat "$res/out"
    cat "$res/err" >&2
    rc=$(cat "$res/rc")
    rm -rf "$res"
    case $rc in '' | *[!0-9]*) rc=1 ;; esac
    exit "$rc"
    ;;
  esac
fi
for a in "$@"; do
  case $a in - | *@- | *=-) exec "$real" "$@" ;; esac
done

# The call, with its two streams kept in files of their own: what GitHub
# answered is read before the shim decides whether to ask again. The files
# belong to the one call, so they are named after its process.
out=${TMPDIR:-/tmp}/gh-shim.$$.out
err=${TMPDIR:-/tmp}/gh-shim.$$.err
"$real" "$@" >"$out" 2>"$err"
rc=$?
if [ "$rc" = 0 ]; then
  cat "$out"
  cat "$err" >&2
  rm -f "$out" "$err"
  exit 0
fi
# GitHub's own words: the number of the status and, for a 403, the sentence
# that says the limit, which GitHub puts on a line of its own from the number.
limited=$(tr '[:upper:]' '[:lower:]' <"$err")
case $limited in *http\ 429*) limited=yes ;; *http\ 403*rate\ limit*) limited=yes ;; *) limited= ;; esac
if [ -z "$limited" ]; then
  cat "$out"
  cat "$err" >&2
  rm -f "$out" "$err"
  exit "$rc"
fi
wait=${TEHAS_GH_RETRY_WAIT:-60}
echo "gh-shim: rate limited, trying once more in $wait s" >&2
sleep "$wait"
"$real" "$@" >"$out" 2>"$err"
rc=$?
cat "$out"
cat "$err" >&2
rm -f "$out" "$err"
exit "$rc"
