# What a release tarball has to hold, so scripts/pack-release.sh and its test
# read one list rather than each keeping their own. A plain list, read and not
# run: a line `[name]` starts a section, the lines after it are its entries, one
# path per line, and `#` lines and blank lines are skipped.
#
#   dirs     the directories of the checkout that install.sh copies from: its
#            own bin/, libexec/ and lib/ and the host/ files it installs beside
#            them
#   plain    the top-level files an adopter needs to install, and CHANGELOG.md,
#            which says what an adopter does after updating to the release
#   extra    directories below the top that an adopter reads: the example
#            instance, whose values tehas update names when a release asks for
#            a setting, and api/, whose settings-rules.json holds the rules
#            of the instance settings for a tool with no factory to ask
#
# The console/ directory is in neither: the console comes from pack-release.sh's
# --console, and an adopter has no toolchain to build its source with. If
# install.sh reads a file outside these, a release packed without it is broken
# on the adopter's host, so test/pack_release_test.sh reads the sources of
# install.sh's own file table and refuses one that no section of this file
# covers.

[dirs]
bin
libexec
lib
host

[plain]
install.sh
bootstrap.sh
LICENSE
NOTICE
AGENTS.md
CHANGELOG.md

[extra]
instances/example
api
