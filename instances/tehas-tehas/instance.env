# The tehas instance that works on tehas itself: host tehas-tehas, user boss,
# product tehas-app/tehas. It is the worked example the manual refers to.

TEHAS_REPO=tehas-app/tehas
TEHAS_CONTROL_ISSUE=1
TEHAS_ALLOWED_LABELERS="janit"

# The model endpoint is models.json next to this file.
PI_ENSEMBLE_SUBAGENT_MODEL=qwen3.8-flash-next
PI_ENSEMBLE_SUBAGENT_PROVIDER=fleet

# The review loop (lens review, fixes, adversarial re-check, review again) may
# run 3 hours, not pi-rukas's default 90 minutes. At 90 minutes most cycles
# ran out after one fix round and handed off with a draft pull request.
PI_ENSEMBLE_REVIEW_WALL_CLOCK_MS=10800000

# Two settings are private network addresses and are not kept in this
# repository. They are in a file on the host, ~/.config/tehas/private.env:
#   PI_ENSEMBLE_HOST_ALIASES=gb1:<address>   the model host's name resolves on
#                                            the private network only, so the
#                                            sandbox is told its address
#   TEHAS_HOST_ADDR=<address>                the dashboard on the host's private
#                                            address: http://tehas-tehas:8080
if [ -r "$HOME/.config/tehas/private.env" ]; then
  # shellcheck source=/dev/null
  . "$HOME/.config/tehas/private.env"
fi

# This instance is published on the internet as the showcase for tehas, so
# search engines may index it.
TEHAS_INDEXING=1

# Visitor analytics on the public pages.
TEHAS_ANALYTICS_SRC=https://ea.trippi.app/ea.js
TEHAS_ANALYTICS_SITE=tehas
TEHAS_ANALYTICS_COOKIE=1

# The names of the edge are made under this domain: a preview of pull request
# 12 is uat-12.tehas.app and the Protolab's list is lab.tehas.app.
TEHAS_DOMAIN=tehas.app
TEHAS_PREVIEWS=1

# The improvement loop files what it finds in this repository. It is public,
# so the logs a finding names can be read by anyone.
TEHAS_IMPROVE_REPO=tehas-app/tehas

# What only a change in pi-rukas can fix is not filed at all: the pi-rukas
# developers read this host's cycles through its MCP server.
TEHAS_IMPROVE_RUKAS_SKIP=1

# A day of cycles filled the default of 10. Each repository may hold 30 open
# issues of the loop before it files no more there.
TEHAS_IMPROVE_MAX_OPEN=30

# At most four issues are worked on side by side. A ceiling: the dispatcher
# starts fewer while tehas.slice has no room. The slice holds 75% of the host's
# 29 GB, each container may use up to a quarter of that, and the reserve is
# left at its default of 2g. The highest peak seen in a cycle on 11 Oct was
# 1.4 GB.
TEHAS_TICKET_CONCURRENCY=4
# Running cycles and pull requests that wait for a review, together. Six is
# also the default at a ceiling of four.
TEHAS_MAX_AWAITING=6

# A cycle is given the images its issue text links, so that explore and plan
# see a screenshot beside the code: issue 97 was built in the wrong place five
# times over a picture no cycle could read. The model reads images
# (models.json says so), and the dispatcher holds every cycle while the model
# endpoint does not answer one.
# pi-rukas passes the images to the model since v0.12.80 (#1213).
TEHAS_WORK_IMAGES=1

# The factory merges the branch into its own pull requests that conflict with
# it, as a cycle on the approving person's word. The image's pi-rukas takes
# --continue-pr since v0.13.0. tehas-refresh.timer is enabled by hand.
TEHAS_REFRESH_CONFLICTS=1
