# Tehas instance settings. One host, one product repository.
#
# Copy this directory, fill it in, and point the host at it:
#   echo /path/to/your/instance >~/.config/tehas/instance-dir
# or keep the two files in ~/.config/tehas, which is the default place.
#
# This is a shell file of KEY=value lines, sourced as written by every tehas
# command. Keep it writable by the tehas user only. No secrets here: the bot
# token goes in ~/.config/tehas/env.
#
# What is set here wins over the environment. `./install.sh --check` tells you
# what is missing or malformed.

# --- Required ----------------------------------------------------------------

# The product repository the dispatcher polls, as owner/name.
TEHAS_REPO=example-owner/example-product

# Number of an issue in that repository. The label tehas:pause on it stops the
# dispatcher. Create the issue first and keep it open.
TEHAS_CONTROL_ISSUE=1

# GitHub logins whose tehas:ready label starts a cycle, separated by spaces.
# The dispatcher checks who applied the label, not just that it is there.
# Never put the bot account in this list.
TEHAS_ALLOWED_LABELERS="example-owner"

# Model and provider for every pi-rukas subagent role. Both must be listed in
# models.json next to this file. The session's own model is set by the product
# repository, in its .pi/settings.json.
PI_ENSEMBLE_SUBAGENT_MODEL=example-model
PI_ENSEMBLE_SUBAGENT_PROVIDER=local

# --- Optional (the value shown is the default) -------------------------------

# Address the docs server and dashboard bind to, port 8080. The default keeps
# them on the host itself. Set the host's private address to reach them from
# other devices.
#TEHAS_HOST_ADDR=127.0.0.1

# Search engines. The default tells them to stay out: every page says noindex
# and robots.txt disallows everything. 1 lets them index the dashboard and the
# manual, for an instance that is meant to be found. It only matters when the
# docs server is reachable from the internet at all.
#TEHAS_INDEXING=0

# Visitor analytics. With a script address and a site name, every page of the
# dashboard and the manual loads that script. Without them there is none.
# COOKIE=1 adds data-cookie="true" to the tag, for a script that then sets a
# persistent cookie; that usually needs the visitor's consent.
#TEHAS_ANALYTICS_SRC=https://stats.example/ea.js
#TEHAS_ANALYTICS_SITE=example
#TEHAS_ANALYTICS_COOKIE=0

# Address people reach the Protolab at, when that is not port 8081 of the
# dashboard's own host: a host name of its own, with no path. The dashboard
# links to it.
#TEHAS_PROTOLAB_URL=https://lab.example
# The domain the names of the edge are made under: a preview of pull request
# 12 is uat-12.<domain>, the Protolab's page of ticket 7 is lab-7.<domain> and
# its list is lab.<domain>. See "Previews and the Protolab on the internet" in
# the manual for what the domain and the proxy in front of the host need.
#TEHAS_DOMAIN=example.org
# A running preview of every open pull request whose branch is in the product
# repository. Needs TEHAS_DOMAIN and a preview/Dockerfile in the product.
#TEHAS_PREVIEWS=1
#TEHAS_PREVIEW_MAX=5
#TEHAS_PREVIEW_MIN_FREE=5g

# Workstreams one cycle may run side by side, inside that one container. Each
# is a developer agent and its review loop, so this multiplies model calls.
# Lower it for a model endpoint with few slots.
#TEHAS_CONCURRENCY=4

# The most issues worked on side by side, each in a cycle and a container of
# its own [the host's CPUs minus one]. A ceiling: every container runs in the
# slice /etc/systemd/system/tehas.slice (sudo ./bootstrap.sh slice), which
# holds 75% of the host's memory, and the dispatcher starts a cycle only while
# the slice has room for one more TEHAS_CYCLE_RESERVE. There is no CPU or
# memory budget to set. Every cycle runs TEHAS_CONCURRENCY workstreams, so
# this multiplies model calls too: lower it when the model backends cannot
# serve that many.
#TEHAS_TICKET_CONCURRENCY=3

# Memory one container is promised, as a floor inside the slice and as the
# unit the dispatcher counts room in [2g]. Each container may use up to a
# quarter of the slice. With the default the host needs about 11 GiB of
# memory; a smaller host sets it lower.
#TEHAS_CYCLE_RESERVE=2g

# The improvement loop. With a repository named here, as owner/name, every
# cycle that ends leaves a record, and every three hours a model reads them
# and files what could be better as issues there, labelled tehas:improvement.
# The bot account needs write access to it. The whole logs of the cycles an
# issue names are uploaded to a release of that repository: in a public
# repository anyone can read them. Unset, there is no loop.
#TEHAS_IMPROVE_REPO=example-owner/example-factory

# Where the loop files what only a change in pi-rukas can fix: a repository
# of pi-rukas the operator works on. The bot account needs the triage role there and the
# repository needs issues switched on. Unset, those findings go with the rest.
#TEHAS_IMPROVE_RUKAS_REPO=example-owner/pi-rukas

# How many of the loop's issues may be open in one repository before it files
# no more there.
#TEHAS_IMPROVE_MAX_OPEN=10

# name:address pairs the sandbox needs to resolve, separated by commas, for
# example the model host when its name only resolves on a private network.
#PI_ENSEMBLE_HOST_ALIASES=models.example:192.0.2.10

# Where the product checkout is, and the branch work lands on. By default the
# checkout is $TEHAS_HOME/repos/<name> and the branch is the repository's
# default branch, read from the checkout.
#TEHAS_WORK_REPO=$HOME/tehas/repos/example-product
#TEHAS_BRANCH=main

# Open issues that may wait for a human merge, plus running cycles, before new
# cycles are held [TEHAS_TICKET_CONCURRENCY plus 2], and seconds before a
# cycle is given up.
#TEHAS_MAX_AWAITING=4
#TEHAS_WORK_TIMEOUT=21600

# Seconds a cycle may go without a line added to any of its logs before it is
# stopped as stalled [3600]. Longer than TEHAS_VERIFY_TIMEOUT: a gate can
# print nothing while it runs.
#TEHAS_WORK_STALL=3600

# Give a cycle and a planning session the images its issue text links: png,
# jpg, webp and gif, at most 8 and 10 megabytes, only for an issue opened by
# an owner, member or collaborator. One more read-only mount in the container.
# An issue whose text links an image waits while models.json does not say the
# model reads one, "input": ["text", "image"]; an issue that links none
# starts.
#TEHAS_WORK_IMAGES=1

# Seconds one run of the product's gate may take inside a cycle. A gate that
# takes longer is stopped and the cycle parks.
#TEHAS_VERIFY_TIMEOUT=1800

# A planning session (label tehas:plan): turns it may take, and seconds per turn.
#TEHAS_PLAN_MAX_TURNS=20
#TEHAS_PLAN_TIMEOUT=3600

# The sandbox image cycles run in. Built by sandbox/build.sh under this name.
#PI_ENSEMBLE_IMAGE=tehas/pi-rukas:uid1000
