# Tehas instance settings: the optional ones. Every line is commented out and
# shows the default, or an example where there is none. To turn one on, copy the line to instance.env and remove
# the #. This file is a reference: no command reads it.

# Address the docs server and dashboard bind to, port 8080. The default keeps
# them on the host itself. Set the host's private address to reach them from
# other devices.
#TEHAS_HOST_ADDR=127.0.0.1

# A model for one role instead of PI_ENSEMBLE_SUBAGENT_MODEL. Unset, the role
# uses that one. The roles are DEVELOPER, OPS, EXPLORE, ADVERSARIAL_DEVELOPER
# and CODE_REVIEW_SPECIALIST (all six lens reviewers); any other name is
# refused. The provider defaults to PI_ENSEMBLE_SUBAGENT_PROVIDER. Each model
# must be listed in models.json under its provider.
#PI_ENSEMBLE_MODEL_CODE_REVIEW_SPECIALIST=example-small-model
#PI_ENSEMBLE_PROVIDER_CODE_REVIEW_SPECIALIST=local

# Search engines. The default tells them to stay out: every page says noindex
# and robots.txt disallows everything. 1 lets them index the dashboard and the
# manual, for an instance that is meant to be found. It only matters when the
# docs server is reachable from the internet at all.
#TEHAS_INDEXING=0

# Visitor analytics. With a script address and a site name, every page of the
# dashboard and the manual loads that script. Without them there is none.
# COOKIE=1 adds data-cookie="true" to the tag, for a script that then sets a
# persistent cookie; that usually needs the visitor's consent.
#TEHAS_ANALYTICS_SRC=https://stats.example/ea.js
#TEHAS_ANALYTICS_SITE=example
#TEHAS_ANALYTICS_COOKIE=0

# The look of every page: pixel (the factory as a 16-bit game), paper (plain
# type on a light page), beesknees (a business application) or beesknees26
# (its 2026 redraw, which will replace it). Without it, pixel. Restart the docs server and the edge router after a change.
#TEHAS_THEME=pixel
# The front page: floor (the game view) or business (the business page). Both
# are always at /floor and /business. Without it, floor.
#TEHAS_LAYOUT=floor

# The factory's own analytics, not the visitor analytics above: 365 days of
# runs, issue events and one sample per poll in ~/tehas/state/analytics.db,
# written by ~/tehas/libexec/analytics. on or off; anything else stops every
# command with 78. off stops every write and leaves the file as it is.
#TEHAS_ANALYTICS=on

# Publish what `tehas top` draws, without the console of a cycle, to
# live/top.json, for the Host panel of the dashboard: the load averages, the
# share of the cpus and of the memory, the fifteen processes that used the most
# CPU (pid and short command name only, never a command line), and the units.
# Off unless the instance says so, because the dashboard can be on the internet.
# It governs the published file only: `tehas top` in a terminal always works.
#TEHAS_TOP=0

# Address people reach the Protolab at, when that is not port 8081 of the
# dashboard's own host: a host name of its own, with no path. The dashboard
# links to it.
#TEHAS_PROTOLAB_URL=https://lab.example
# The domain the names of the edge are made under: a preview of pull request
# 12 is uat-12.<domain>, the Protolab's page of ticket 7 is lab-7.<domain> and
# its list is lab.<domain>. See "Previews and the Protolab on the internet" in
# the manual for what the domain and the proxy in front of the host need.
#TEHAS_DOMAIN=example.org
# A running preview of every open pull request whose branch is in the product
# repository. Needs TEHAS_DOMAIN and a preview/Dockerfile in the product.
#TEHAS_PREVIEWS=1
#TEHAS_PREVIEW_MAX=5
#TEHAS_PREVIEW_MIN_FREE=5g

# Workstreams one cycle may run side by side, inside that one container [1].
# The factory fans out across issues instead. Above 1 only together with
# TEHAS_TICKET_CONCURRENCY=1: with both above 1 every command stops with 78.
#TEHAS_CONCURRENCY=1

# The most issues worked on side by side, each in a cycle and a container of
# its own [the host's CPUs minus one]. A ceiling: every container runs in the
# slice /etc/systemd/system/tehas.slice (sudo ./bootstrap.sh slice), which
# holds 75% of the host's memory, and the dispatcher starts a cycle only while
# the slice has room for one more TEHAS_CYCLE_RESERVE. There is no CPU or
# memory budget to set: each container's CPU quota is the host's CPUs less
# one over this, counted at most 4. Lower it when the model backends cannot
# serve that many cycles.
#TEHAS_TICKET_CONCURRENCY=3

# Memory one container is promised, as a floor inside the slice and as the
# unit the dispatcher counts room in [2g]. Each container may use up to a
# quarter of the slice. With the default the host needs about 11 GiB of
# memory; a smaller host sets it lower.
#TEHAS_CYCLE_RESERVE=2g

# The improvement loop. With a repository named here, as owner/name, every
# cycle that ends leaves a record, and every three hours a model reads them
# and files what could be better as issues there, labelled tehas:improvement.
# The bot account needs write access to it. The whole logs of the cycles an
# issue names are uploaded to a release of that repository: in a public
# repository anyone can read them. Unset, there is no loop.
#TEHAS_IMPROVE_REPO=example-owner/example-factory

# Where the loop files what only a change in pi-rukas can fix: a repository
# of pi-rukas the operator works on. The bot account needs the triage role there and the
# repository needs issues switched on. Unset, those findings go with the rest.
#TEHAS_IMPROVE_RUKAS_REPO=example-owner/pi-rukas

# How many of the loop's issues may be open in one repository before it files
# no more there.
#TEHAS_IMPROVE_MAX_OPEN=10

# The fixer: an account that decides on parked issues from outside this
# factory. Its tehas:ready starts a cycle only on an issue a person approved
# before, its text unchanged since, and it may answer planning questions in a
# session a person started. A machine account of its own with write
# access to the product repository, never the bot and never one of
# TEHAS_ALLOWED_LABELERS. Unset, there is no fixer.
#TEHAS_FIXER_LOGIN=example-fixer

# How many cycles the fixer may start on one issue since a person last
# approved it.
#TEHAS_FIXER_MAX_RETRIES=2

# How many planning questions the fixer may answer in one session. It never
# answers two turns in a row, and a person's answer to the same question wins.
#TEHAS_FIXER_MAX_PLAN_ANSWERS=3

# Refreshes: 1 has the factory resolve conflicts in its own pull requests that
# wait for a merge. Once an hour tehasbot refresh asks GitHub which of them
# conflict with the branch, and the dispatcher starts a cycle that merges the
# branch in and pushes to the same pull request, on the word of the person
# whose approval the pull request rests on. It starts cycles with no fresh
# label, so it is off unless the instance says so. It needs a sandbox image
# whose pi-rukas takes --continue-pr.
#TEHAS_REFRESH_CONFLICTS=1

# How many times one pull request may be refreshed since the person's approval
# its cycle rests on. A refresh that parks is not tried again.
#TEHAS_REFRESH_MAX=2

# The check that runs on every push to the branch work lands on, by its name
# on GitHub. While it failed on the branch's head commit the poll starts no new
# cycle and logs "holding: <branch> is red at <sha>": every cycle would find
# the gate red on its base. Running cycles go on and planning turns are not
# held. A check that is pending, missing or cannot be read holds nothing.
# Unset, the poll does not ask.
#TEHAS_BRANCH_CHECK=verify

# Free disk below which the poll starts no cycle, read on the file system of
# ~/tehas and on the one Docker keeps its images on, whichever has less. The
# poll says "holding: <n> GiB free on the disk, under TEHAS_CYCLE_MIN_FREE=<value>:
# no cycle starts", and holds the same way when it can read no figure at all.
# Running cycles are left alone and a planning turn is not held, so what the
# host works on finishes; only new cycles wait. Previews have their own,
# lower, bound in TEHAS_PREVIEW_MIN_FREE. A size such as 512m or 10g, else
# every command stops with 78.
#TEHAS_CYCLE_MIN_FREE=10g

# The gate for the lowest issues: a command the poll runs before it starts an
# issue it puts on neither the urgent list nor the tehas:next list, at most once
# a poll. Only its exit status is read, and only 0 lets those issues start: a
# missing file, one that is not executable, a run that outlives
# TEHAS_LOW_GATE_WAIT and any other status hold them, while urgent and
# tehas:next issues go ahead. It is given nothing of the poll's environment but
# PATH, and what it prints goes to ~/tehas/logs/low-gate.log, rewritten at every
# ask: that is where a gate says why it closed. It may not sit under ~/tehas or
# in this directory, which a merged pull request can change, and it gets no
# memory or CPU ceiling of its own: make it short, cheap and one that leaves
# nothing running. The log says "low issues wait: TEHAS_LOW_GATE answered S"
# once when the hold begins and "low issues may start: TEHAS_LOW_GATE answered
# 0" once when it ends. No running cycle is stopped by it. Unset, there is no
# gate and every ready issue is started as before. The manual says the rest,
# under tehas dispatch.
#TEHAS_LOW_GATE=/home/tehas/bin/cheap-power

# How many seconds that command gets before its answer is a closed gate, 1 to
# 600. It is asked to end at the end of that, and killed ten seconds after that
# if it does not. The poll holds its own lock while it waits, so a longer bound
# only delays every later poll.
#TEHAS_LOW_GATE_WAIT=60

# name:address pairs the sandbox needs to resolve, separated by commas, for
# example the model host when its name only resolves on a private network.
#PI_ENSEMBLE_HOST_ALIASES=models.example:192.0.2.10

# The code-review severity that blocks a change in a cycle: CRITICAL, HIGH,
# MEDIUM or LOW. pi-rukas reads this name itself, and it wins over the severity
# the product repository's doctrine (AGENTS.md, or CLAUDE.md when it has one)
# states. Unset, or anything other than those four words, pi-rukas uses the
# severity that doctrine states, and MEDIUM when it states none. tehas passes
# this line through without checking it. A CRITICAL finding blocks a change
# whatever this says. Leave it unset and the product decides: a product states
# its own bar in its AGENTS.md.
#PI_ENSEMBLE_REVIEW_THRESHOLD=MEDIUM

# Where the product checkout is, and the branch work lands on. By default the
# checkout is $TEHAS_HOME/repos/<name> and the branch is the repository's
# default branch, read from the checkout.
#TEHAS_WORK_REPO=$HOME/tehas/repos/example-product
#TEHAS_BRANCH=main

# Where tehas update takes new versions from: release (a published release,
# into ~/tehas/versions) or git (the platform checkout, for a host that
# develops tehas). Unset, a host with ~/tehas/current uses releases and one
# with a platform checkout uses the checkout. The releases are read from the
# repository versions.env names; name another here.
#TEHAS_UPDATE_FROM=release
#TEHAS_RELEASE_REPO=tehas-app/tehas

# Open issues that may wait for a human merge, plus running cycles, before new
# cycles are held [TEHAS_TICKET_CONCURRENCY plus 2], and seconds before a
# cycle is given up, at most 25200: the cycle's unit stops it after 8 hours.
#TEHAS_MAX_AWAITING=4
#TEHAS_WORK_TIMEOUT=21600

# Seconds a cycle may go without a line added to any of its logs before it is
# stopped as stalled [3600]. Longer than TEHAS_VERIFY_TIMEOUT: a gate can
# print nothing while it runs.
#TEHAS_WORK_STALL=3600

# Give a cycle and a planning session the images its issue text links: png,
# jpg, webp and gif, at most 8 and 10 megabytes, only for an issue opened by
# an owner, member or collaborator. One more read-only mount in the container. The model
# must read images and say so in models.json: "input": ["text", "image"].
#TEHAS_WORK_IMAGES=1

# With TEHAS_WORK_IMAGES=1: have the model describe each of those images in
# words first, into images.md beside them, for the steps that are not shown
# the pixels. One request per image, at most 8, 60 seconds each.
#TEHAS_WORK_DESCRIBE=1

# Give a cycle and a planning session the text files its issue text links:
# md, txt, csv, json, yaml, log, html, css and js, at most 16, 1 MB each and
# 4 MB together. The same read-only mount as the images, with or without them.
# The pi-rukas that tehas pins does not read them yet.
#TEHAS_WORK_FILES=1

# With TEHAS_WORK_IMAGES=1 or TEHAS_WORK_FILES=1: take the images and files of
# the issue's comments too, those an allowed account wrote and nobody edited
# after the label or the retry tick.
#TEHAS_WORK_COMMENTS=1

# With TEHAS_WORK_IMAGES=1 or TEHAS_WORK_FILES=1: unpack a zip the issue links
# into the same read-only directory. A zip is taken by its first bytes, not its
# name, and every file in it goes through the checks of a linked one: an image
# or a text file, nothing else. At most 2 archives, each at most 4 MB, and the
# files in them count against the limits above. The archive is not kept.
#TEHAS_WORK_ZIPS=1

# Seconds one run of the product's gate may take inside a cycle. A gate that
# takes longer is stopped and the cycle parks.
#TEHAS_VERIFY_TIMEOUT=1800

# A setting that only works around a pi-rukas defect says so here, with the
# release that fixes it, and names the pi-rukas issue in a comment beside it.
# Once the sandbox image has that release, tehas work refuses a cycle (78)
# until the setting and its entry are removed. Entries are NAME@VERSION,
# separated by single spaces.
#TEHAS_RUKAS_WORKAROUNDS="PI_ENSEMBLE_SOME_SETTING@0.12.81"

# A planning session (label tehas:plan): turns it may take, and seconds per turn,
# at most 7200: a turn runs as its own unit, stopped a quarter of an hour later.
#TEHAS_PLAN_MAX_TURNS=20
#TEHAS_PLAN_TIMEOUT=7200

# The sandbox image cycles run in. Built by sandbox/build.sh under this name:
# the repository it builds, with the tag of this host's uid put on it, so a
# setting whose repository is another one leaves the cleaner no dated tags to
# take. Only the tag is the instance's to change.
#PI_ENSEMBLE_IMAGE=tehas/pi-rukas:uid1000

# The cleaner. tehasbot clean, from tehas-clean.timer every hour, removes what
# the host can make again once nothing has touched it for this many hours: the
# build output in a kept workspace (the 7-day sweep keeps the workspace itself),
# the cycle's copy of the code index, Docker's build cache of that age, and old
# files under ~/tehas/tmp/dl and ~/tehas/tmp/node-compile-cache and old
# ~/tehas/tmp/tehas-test.* directories. It starts no work, so the pause label
# does not stop it. The timer is installed but not enabled: turn it on with
# `systemctl --user enable --now tehas-clean.timer`.
#TEHAS_CLEAN_AFTER=24

# The directory names it removes, separated by single spaces. The default is
# the build output of the toolchains tehas hosts; a name here adds to it only
# when the whole list is written again. A name with a slash, a bare `.` or `..`,
# or `.git` or `.pi`, stops every command with 78.
#TEHAS_CLEAN_DIRS="target node_modules __pycache__ .venv .pytest_cache .mypy_cache .next .turbo .gradle"

# What tehas work measures of an approved body when it records the size of a
# start in ~/tehas/state/sizes.jsonl: the bytes and the lines of it it reads.
# The measure's pass is not free and a body may be a paste of anything, so a
# body past either is measured from its front. Each holds what the other leaves
# unbounded -- the lines, a body of many short ones; the bytes, a body of one
# huge one -- so a start needs both. A whole number of at least 1.
#TEHAS_SIZE_MAX_BYTES=131072
#TEHAS_SIZE_MAX_LINES=1000

# The count of files an issue's own body may name before the dispatcher holds
# the issue instead of starting it, and asks for it to be narrowed: see the
# dispatcher's hold in the manual, at Limits that hold work back. Unset, a wide
# issue starts as any other. A whole number of at least 1. What the buckets are
# worth -- how often an issue of each size ships, and how long it takes -- is
# the Size line of `tehas analytics report`.
#TEHAS_SIZE_MAX_FILES=6

# How many seconds `tehas update` and a real run of `install.sh` wait for
# ~/tehas/state/update.lock before they say another update is running. A whole
# number, 0 to refuse at once, at most 300; anything else is the default of 10.
# It is not read from this file: the loader drops a name it does not know, so
# put it in the environment of the run that needs it, and see the manual under
# tehas update.
#TEHAS_UPDATE_LOCK_WAIT=10

# The GitHub App the factory acts as: its ID, the ID of the installation that
# reaches TEHAS_REPO, and its login, <slug>[bot]. All three or none. The app's
# private key is ~/.config/tehas/github-app.pem (mode 600), never in this
# directory. See the manual under tehasbot github-token.
#TEHAS_GITHUB_APP_ID=1234567
#TEHAS_GITHUB_APP_INSTALLATION=12345678
#TEHAS_BOT_LOGIN=example-factory-bot[bot]
