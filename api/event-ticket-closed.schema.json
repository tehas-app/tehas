{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tehas-app/tehas/api/event-ticket-closed.schema.json",
  "title": "The data of ticket.closed",
  "description": "A ticket the factory follows is recorded closed. Witness: Closed in the tickets port's history. Version 1 of the events. host/docs/api.md, \"Events\", says what each field means. The object is closed; a minor release may add an optional field. console/tests/events_contract.rs checks the samples beside this file against it.",
  "type": "object",
  "required": [
    "ticket",
    "reason",
    "at"
  ],
  "additionalProperties": false,
  "properties": {
    "ticket": {
      "description": "The ticket, in the ports' shape.",
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "Number": {
          "type": "integer",
          "minimum": 1
        },
        "Key": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:/-]{1,128}$"
        }
      },
      "oneOf": [
        {
          "required": [
            "Number"
          ]
        },
        {
          "required": [
            "Key"
          ]
        }
      ]
    },
    "reason": {
      "description": "Why it closed, in the ports' shape: Done, NotPlanned, or Duplicate of a ticket.",
      "oneOf": [
        {
          "enum": [
            "Done",
            "NotPlanned"
          ]
        },
        {
          "type": "object",
          "required": [
            "Duplicate"
          ],
          "additionalProperties": false,
          "properties": {
            "Duplicate": {
              "description": "The ticket it repeats.",
              "type": "object",
              "minProperties": 1,
              "additionalProperties": false,
              "properties": {
                "Number": {
                  "type": "integer",
                  "minimum": 1
                },
                "Key": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9._:/-]{1,128}$"
                }
              },
              "oneOf": [
                {
                  "required": [
                    "Number"
                  ]
                },
                {
                  "required": [
                    "Key"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "at": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$",
      "description": "When."
    }
  }
}
