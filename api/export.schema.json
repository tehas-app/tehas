{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tehas-app/tehas/api/export.schema.json",
  "title": "tehas export --json",
  "description": "What tehas export --json --after CURSOR <dir> prints, version 1: the object tehas history --json prints for the runs it copied, with `version`, the layout of the export directory, and `to`, the directory. `runs` is the same as in history.schema.json, which test/json_contract_test.sh compares. host/docs/api.md says what each field means. Every object is closed, so a field tehas adds must be added here too; a program that reads the object still accepts fields it does not know. test/json_contract_test.sh checks the samples beside this file against it and what the command prints.",
  "type": "object",
  "required": [
    "api",
    "version",
    "runs",
    "next",
    "to"
  ],
  "additionalProperties": false,
  "properties": {
    "api": {
      "const": 1
    },
    "version": {
      "description": "The layout of the export directory, as <dir>/export.json says it.",
      "const": 1
    },
    "runs": {
      "type": "array",
      "items": {
        "required": [
          "cursor",
          "kind",
          "issue",
          "ended",
          "outcome"
        ],
        "additionalProperties": false,
        "properties": {
          "cursor": {
            "type": "string",
            "pattern": "^[0-9]{1,10}-[1-9][0-9]{0,8}-[1-9][0-9]{0,14}$"
          },
          "kind": {
            "enum": [
              "work",
              "plan"
            ]
          },
          "issue": {
            "type": "integer",
            "minimum": 1,
            "maximum": 999999999
          },
          "ended": {
            "type": "string",
            "format": "date-time"
          },
          "started": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          "outcome": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "turn": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          },
          "progress": {
            "description": "Where the step a cycle ended in was, as its driver reported it. Driver-specific and may change in a minor release: a program shows it, and does not decide on it. Left out when nothing of it is known.",
            "type": "object",
            "minProperties": 1,
            "additionalProperties": false,
            "properties": {
              "step": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40
              },
              "stepNumber": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1000
              },
              "stepTotal": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1000
              },
              "round": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1000
              }
            }
          },
          "cap": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "parkReason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "failureKind": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "failureCause": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          },
          "provider": {
            "type": "boolean"
          },
          "parked": {
            "type": "boolean"
          },
          "repeat": {
            "type": "integer",
            "minimum": 1
          },
          "pr": {
            "type": "string",
            "maxLength": 200
          },
          "by": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "how": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "auto": {
            "type": "boolean"
          },
          "filed": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 200
            }
          }
        }
      }
    },
    "next": {
      "description": "The cursor to keep: the last run copied, or the cursor given to --after when none was.",
      "type": "string",
      "minLength": 1
    },
    "to": {
      "description": "The directory written, an absolute name.",
      "type": "string",
      "pattern": "^/"
    }
  }
}
