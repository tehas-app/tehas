{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tehas-app/tehas/api/plugin.schema.json",
  "title": "tehas plugin --json",
  "description": "What tehas plugin --json prints, version 1: each plugin of TEHAS_PLUGINS, its pin, what is granted at the pin and its state. Plugins are a feature still being built, so this is not contract until the release that ships them, and a later step of the feature adds fields. Every object is closed, so a field tehas adds must be added here too. unbuilt is a plugin that is set and granted and not yet fetched or built at its pin; building, one tehas update is building; ready, one that may run; refused says why in refusal. image is the local image's id, a local fact: null before a build and for a plugin with no build. last_run is the newest run in the state store, null before the first: its kind, trigger, start and end in seconds since the epoch (end null while it runs), result (done, failed, timeout or lost, null while it runs) and the model tokens it used. tokens_today is the model tokens of its runs that started today, UTC. manifest_sha256 is the sha256 of the pin's tehas-plugin.json and bases the Dockerfile's base images by digest, which two hosts that build one commit share. The tests of console/ops/src/plugin.rs hold what the command prints to the samples beside this file, and those of console/core/src/plugin/schema.rs hold the samples to this schema.",
  "type": "object",
  "required": [
    "api",
    "plugins"
  ],
  "additionalProperties": false,
  "properties": {
    "api": {
      "const": 1
    },
    "plugins": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": [
          "name",
          "url",
          "commit",
          "grants",
          "state",
          "refusal",
          "image",
          "manifest_sha256",
          "bases",
          "last_run",
          "tokens_today"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]{0,11}$"
          },
          "url": {
            "type": "string",
            "pattern": "^https://"
          },
          "commit": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "grants": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^(view|product|model:[1-9][0-9]{0,8}|hook:after:work|action:[a-z-]{1,16})$"
            }
          },
          "state": {
            "enum": [
              "unbuilt",
              "building",
              "ready",
              "refused"
            ]
          },
          "refusal": {
            "type": [
              "string",
              "null"
            ]
          },
          "image": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "manifest_sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9a-f]{64}$"
          },
          "bases": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "@sha256:[0-9a-f]{64}$"
            }
          },
          "last_run": {
            "type": [
              "object",
              "null"
            ],
            "required": [
              "kind",
              "trigger",
              "start",
              "end",
              "result",
              "tokens"
            ],
            "additionalProperties": false,
            "properties": {
              "kind": {
                "enum": [
                  "refresh",
                  "hook"
                ]
              },
              "trigger": {
                "enum": [
                  "timer",
                  "host",
                  "action",
                  "cycle"
                ]
              },
              "start": {
                "type": "integer",
                "minimum": 0
              },
              "end": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "result": {
                "enum": [
                  "done",
                  "failed",
                  "timeout",
                  "lost",
                  null
                ]
              },
              "tokens": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "tokens_today": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}
