    "refresh": {
      "label": "Refresh",
      "args": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    }
  },
  "views": [
    {
      "id": "host",
      "entry": "dist/view/index.html",
      "open": "dock"
    }
  ],
  "vendor": {},
  "solid": "2.0.3"
}
