{
  "plugin": 2,
  "spec": "2.0.0-r8",
  "name": "hoststats",
  "label": "Host",
  "runtime": "starlingmonkey",
  "timeout": 120,
  "asks": [
    "view:host",
    "feed:host",
    "action:refresh"
