{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tehas-app/tehas/api/status.schema.json",
  "title": "tehas status --json",
  "description": "The object tehas status --json prints, version 1. host/docs/api.md says what each field means. Every object is closed, so a field tehas adds must be added here too; a program that reads the object still accepts fields it does not know. test/status_contract_test.sh checks the samples beside this file against it.",
  "type": "object",
  "required": ["api", "time", "age", "stale", "state", "reasons", "paused", "limit", "running", "planning", "demand", "hold", "held", "room", "versions"],
  "additionalProperties": false,
  "properties": {
    "api": {"const": 1},
    "time": {"type": "string", "format": "date-time"},
    "age": {"type": "integer", "minimum": 0},
    "stale": {"type": "boolean"},
    "state": {"enum": ["pass", "warn", "fail"]},
    "reasons": {"type": "array", "items": {"type": "string"}},
    "paused": {
      "type": "object",
      "required": ["local", "label"],
      "additionalProperties": false,
      "properties": {
        "local": {"type": "boolean"},
        "label": {"type": "boolean"}
      }
    },
    "readOnly": {"const": true},
    "testFeatures": {
      "type": "object",
      "required": ["read", "features"],
      "additionalProperties": false,
      "properties": {
        "read": {"type": "boolean"},
        "features": {"type": "array", "items": {"type": "string"}}
      }
    },
    "allHands": {"type": "boolean"},
    "pushFault": {
      "type": "object",
      "required": ["at", "login", "line"],
      "additionalProperties": false,
      "properties": {
        "at": {"type": ["string", "null"]},
        "login": {"type": ["string", "null"]},
        "line": {"type": ["string", "null"]}
      }
    },
    "limit": {
      "type": "object",
      "required": ["state"],
      "additionalProperties": false,
      "properties": {
        "state": {"enum": ["none", "ok", "expired", "unreadable"]},
        "cycles": {"type": "integer", "minimum": 0},
        "plan": {"type": "boolean"},
        "until": {"type": "string", "format": "date-time"}
      }
    },
    "order": {
      "type": "object",
      "required": ["state"],
      "additionalProperties": false,
      "properties": {
        "state": {"enum": ["none", "ok", "expired", "unreadable"]},
        "issues": {"type": "array", "maxItems": 200, "items": {"type": "integer", "minimum": 1}},
        "only": {"type": "boolean"},
        "until": {"type": "string", "format": "date-time"},
        "reason": {"type": "string", "maxLength": 200}
      }
    },
    "running": {
      "description": "The running cycles of the factory. A cycle outsourced to a contractor is one of them, as a cycle on this host is: this host's supervisor holds its lock while the contractor runs it.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["issue", "since"],
        "additionalProperties": false,
        "properties": {
          "issue": {"type": "integer", "minimum": 1},
          "since": {"type": "string", "format": "date-time"},
          "progress": {
            "description": "Where the cycle's step is, as its driver reports it. Driver-specific and may change in a minor release: a program shows it, and does not decide on it. Left out when nothing of it is known.",
            "type": "object",
            "minProperties": 1,
            "additionalProperties": false,
            "properties": {
              "step": {"type": "string"},
              "stepNumber": {"type": "integer", "minimum": 1},
              "stepTotal": {"type": "integer", "minimum": 1},
              "round": {"type": "integer", "minimum": 1},
              "roundLimit": {"type": "integer", "minimum": 1},
              "stepSince": {"type": "string", "format": "date-time"}
            }
          }
        }
      }
    },
    "planning": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["issue", "turn"],
        "additionalProperties": false,
        "properties": {
          "issue": {"type": "integer", "minimum": 1},
          "turn": {"type": "integer", "minimum": 1},
          "since": {"type": "string", "format": "date-time"}
        }
      }
    },
    "demand": {
      "type": ["object", "null"],
      "required": ["waiting"],
      "additionalProperties": false,
      "properties": {
        "waiting": {"type": "integer", "minimum": 0},
        "oldestWait": {"type": "integer", "minimum": 0},
        "refreshHold": {"type": "string"},
        "labelAlone": {"type": "array", "items": {"type": "integer", "minimum": 1}}
      }
    },
    "hold": {
      "type": ["object", "null"],
      "required": ["why", "text"],
      "additionalProperties": false,
      "properties": {
        "why": {"type": "string"},
        "text": {"type": "string"}
      }
    },
    "held": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["issue", "why", "text", "clear"],
        "additionalProperties": false,
        "properties": {
          "issue": {"type": "integer", "minimum": 1},
          "why": {"type": "string"},
          "text": {"type": "string"},
          "clear": {"type": "string"}
        }
      }
    },
    "prototypes": {
      "description": "The issues with a Protolab page, as the Protolab last listed them. Its fields may change in a minor release: a program shows them, and does not decide on them. Left out when there is no such list.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["issue"],
        "additionalProperties": false,
        "properties": {
          "issue": {"type": "integer", "minimum": 1},
          "builtAt": {"type": "string", "format": "date-time"}
        }
      }
    },
    "previews": {
      "description": "The previews of the open pull requests, as the previews last listed them, newest pull request first. The preview of the default branch is not one of them. Left out when there is no such list, as on a host that does not run previews.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["number", "state"],
        "additionalProperties": false,
        "properties": {
          "number": {"type": "integer", "minimum": 1},
          "state": {"description": "The preview's own word: building, serving, build-failed, no-recipe, over-limit or no-space. An open list: later releases add words.", "type": "string", "minLength": 1},
          "url": {"description": "Where the preview answers; there only while it serves.", "type": "string", "pattern": "^https://"}
        }
      }
    },
    "room": {
      "description": "Free places as the last poll counted them. A cycle outsourced to a contractor takes a place as a cycle on this host does.",
      "type": ["object", "null"],
      "required": [],
      "additionalProperties": false,
      "properties": {
        "cycles": {"type": "integer"},
        "refreshes": {"type": "integer", "minimum": 0},
        "maxAwaiting": {"type": "integer"},
        "slice": {"type": "integer", "minimum": 0},
        "limit": {"type": "integer", "minimum": 0}
      }
    },
    "contractors": {
      "description": "The contractors of outsource, as live/contractors.json last had them: how many have each status, how many cycles are outsourced, and each contractor. Present only while the factory has outsource on; left out otherwise. Its fields may change while outsource is still being built: a program shows them, and does not decide on them.",
      "type": "object",
      "required": ["idle", "working", "stopping", "silent", "resting", "draining", "revoked", "outsourced", "list"],
      "additionalProperties": false,
      "properties": {
        "idle": {"type": "integer", "minimum": 0},
        "working": {"type": "integer", "minimum": 0},
        "stopping": {"type": "integer", "minimum": 0},
        "silent": {"type": "integer", "minimum": 0},
        "resting": {"type": "integer", "minimum": 0},
        "draining": {"type": "integer", "minimum": 0},
        "revoked": {"type": "integer", "minimum": 0},
        "outsourced": {"type": "integer", "minimum": 0},
        "list": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "status", "jobsDone", "jobsLost"],
            "additionalProperties": false,
            "properties": {
              "name": {"type": "string"},
              "status": {"enum": ["idle", "working", "stopping", "silent", "resting", "draining", "revoked"]},
              "issue": {"type": "integer", "minimum": 1},
              "lastSeenAt": {"type": "string", "format": "date-time"},
              "jobsDone": {"type": "integer", "minimum": 0},
              "jobsLost": {"type": "integer", "minimum": 0},
              "image": {"type": "string", "description": "The id of the sandbox image the contractor last reported."},
              "rukas": {"type": "string", "description": "The pi-rukas version that image is labelled with."},
              "memMb": {"type": "integer", "minimum": 0, "description": "The free memory it last reported, in MiB."},
              "diskKb": {"type": "integer", "minimum": 0, "description": "The free disk it last reported, in KiB."},
              "reportedAt": {"type": "string", "format": "date-time", "description": "When the factory took its last report."}
            }
          }
        }
      }
    },
    "versions": {
      "type": "object",
      "required": ["platform", "rukas"],
      "additionalProperties": false,
      "properties": {
        "platform": {
          "type": "object",
          "required": ["release", "commit", "latest", "behind"],
          "additionalProperties": false,
          "properties": {
            "release": {"type": ["string", "null"]},
            "commit": {"type": ["string", "null"]},
            "latest": {"type": ["string", "null"]},
            "behind": {"type": ["boolean", "null"]}
          }
        },
        "rukas": {
          "type": "object",
          "required": ["version", "latest", "behind"],
          "additionalProperties": false,
          "properties": {
            "version": {"type": ["string", "null"]},
            "latest": {"type": ["string", "null"]},
            "behind": {"type": ["boolean", "null"]}
          }
        }
      }
    }
  }
}
