      "reason": "expected rust: the report in bash is gone"
    },
    {
      "name": "TEHAS_SCRATCH_DIR",
      "rule": "scratch-dir",
      "when": "given",
      "default": null,
      "reason": "expected an absolute path such as /mnt/scratch"
    },
    {
      "name": "TEHAS_ANALYTICS_SRC",
      "rule": "script-address",
      "when": "given",
      "default": "",
      "reason": "expected the https address of a script"
    },
    {
      "name": "TEHAS_ANALYTICS_SITE",
      "rule": "site-name",
      "when": "given",
      "default": "",
      "reason": "expected one word of letters, digits, dots and dashes"
    },
    {
      "name": "TEHAS_IMPROVE_REPO",
      "rule": "repo",
      "when": "given",
      "default": "",
      "reason": "expected owner/name"
    },
    {
      "name": "TEHAS_IMPROVE_RUKAS_REPO",
      "rule": "repo",
      "when": "given",
      "default": "",
      "reason": "expected owner/name"
