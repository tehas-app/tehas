      "name": "TEHAS_SLICE_CONTAINERS",
      "rule": "slice-containers",
      "when": "always",
      "default": "4",
      "reason": "expected a whole number from 2 to 16"
    },
    {
      "name": "TEHAS_CLEAN_AFTER",
      "rule": "clean-after",
      "when": "always",
      "default": "24",
      "reason": "expected a whole number of hours of at least 1"
    },
    {
      "name": "TEHAS_WORKSPACE_KEEP_DAYS",
      "rule": "keep-days",
      "when": "always",
      "default": "7",
      "reason": "expected a whole number of days of at least 1"
    },
    {
      "name": "TEHAS_POLL_BUDGET",
      "rule": "poll-budget",
      "when": "always",
      "default": "cpu=5,wall=30,writes=0",
      "reason": "expected cpu=<s>,wall=<s>,writes=<n>, any part left out"
    },
    {
      "name": "TEHAS_SIZE_MAX_BYTES",
      "rule": "measure-bound",
      "when": "always",
      "default": "131072",
      "reason": "expected a whole number of at least 1"
    },
    {
      "name": "TEHAS_SIZE_MAX_LINES",
      "rule": "measure-bound",
      "when": "always",
      "default": "1000",
      "reason": "expected a whole number of at least 1"
    },
    {
      "name": "TEHAS_BUILD_TIMEOUT",
      "rule": "count",
      "when": "given",
      "default": null,
      "reason": "expected a positive whole number"
    },
    {
      "name": "PI_RUKAS_FOLLOW",
      "rule": "follow",
      "when": "named",
      "default": null,
      "reason": "expected release, release:<line>, branch:<name> or commit:<40 hex>"
    },
    {
      "name": "TEHAS_BRANCH",
      "rule": "one-word",
      "when": "given",
      "default": null,
      "reason": "expected one word"
    },
    {
      "name": "TEHAS_DOMAIN",
      "rule": "domain",
      "when": "given",
      "default": "",
      "reason": "expected a domain such as example.org, in lower case, with no scheme and no path"
    },
    {
      "name": "TEHAS_PROTOLAB_URL",
      "rule": "lab-address",
      "when": "given",
      "default": null,
      "reason": "expected an address such as https://lab.example, with no path and no slash at the end"
    },
    {
      "name": "TEHAS_ENERGY_SOURCE_URL",
      "rule": "site-address",
      "when": "given",
      "default": null,
      "reason": "expected an https address such as https://example.com/mesh"
    },
    {
      "name": "TEHAS_UPDATE_FROM",
      "rule": "one-of",
      "when": "given",
      "default": null,
      "words": [
        "git",
        "release"
      ],
      "reason": "expected git or release"
    },
    {
      "name": "TEHAS_RELEASE_REPO",
      "rule": "repo",
      "when": "given",
      "default": null,
      "reason": "expected owner/name"
    },
    {
      "name": "TEHAS_SIZE_MAX_FILES",
      "rule": "count",
      "when": "given",
      "default": "",
      "reason": "expected a positive whole number"
    },
    {
      "name": "TEHAS_CYCLE_REPORT",
      "rule": "one-of",
      "when": "given",
      "default": null,
      "words": [
        "rust"
