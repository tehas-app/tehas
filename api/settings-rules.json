    {
      "name": "TEHAS_IMPROVE_MAX_OPEN",
      "rule": "count",
      "when": "given",
      "default": "10",
      "reason": "expected a positive whole number"
    },
    {
      "name": "TEHAS_GITHUB_APP_ID",
      "rule": "app-id",
      "when": "given",
      "default": "",
      "reason": "expected the ID GitHub shows, a whole number"
    },
    {
      "name": "TEHAS_MILLWRIGHT_APP",
      "rule": "app-login",
      "when": "given",
      "default": null,
      "reason": "expected the login of a GitHub App, <slug>[bot]"
    },
    {
      "name": "TEHAS_OWNER",
      "rule": "person",
      "when": "given",
      "default": "",
      "reason": "expected the GitHub login of one person: GitHub assigns no app's bot"
    },
    {
      "name": "TEHAS_RUKAS_WORKAROUNDS",
      "rule": "workarounds",
      "when": "given",
      "default": "",
      "reason": "expected NAME@VERSION entries separated by single spaces, such as PI_ENSEMBLE_COMMENT_RETENTION@0.12.80"
    },
    {
      "name": "TEHAS_BRANCH_CHECK",
      "rule": "branch-check",
      "when": "given",
      "default": "",
      "reason": "expected the name of a check, words of letters, digits and ._()/- separated by single spaces"
    },
    {
      "name": "TEHAS_ISSUE_TYPES",
      "rule": "issue-types",
      "when": "given",
      "default": null,
      "reason": "expected kind=Type pairs, such as improvement=Improvement prototype=Prototype, not improvement"
    },
    {
      "name": "TEHAS_CLEAN_DIRS",
      "rule": "clean-dirs",
      "when": "given",
      "default": "target node_modules __pycache__ .venv .pytest_cache .mypy_cache .next .turbo .gradle",
      "reason": "expected directory names of letters, digits and ._-, separated by single spaces"
    },
    {
      "name": "TEHAS_REPO",
      "rule": "repo",
      "when": "required",
      "default": null,
      "reason": "expected owner/name"
    },
    {
      "name": "TEHAS_CONTROL_ISSUE",
      "rule": "count",
      "when": "required",
      "default": null,
      "reason": "expected a positive whole number"
    },
    {
      "name": "TEHAS_ALLOWED_LABELERS",
      "rule": "logins",
      "when": "required",
      "default": null,
      "reason": "expected GitHub logins separated by single spaces"
    },
    {
      "name": "PI_ENSEMBLE_SUBAGENT_MODEL",
      "rule": "one-word",
      "when": "required",
      "default": null,
      "reason": "expected one word"
    },
    {
      "name": "PI_ENSEMBLE_SUBAGENT_PROVIDER",
      "rule": "one-word",
      "when": "required",
      "default": null,
      "reason": "expected one word"
    },
    {
      "name": "TEHAS_CONTAINER_MEMORY",
      "rule": "container-size",
      "when": "required",
      "default": null,
      "reason": "expected a size of at least 6m, such as 512m or 2g"
    },
    {
      "name": "TEHAS_REVIEW_REPO",
      "rule": "repo",
      "when": "required",
      "default": "",
      "reason": "expected owner/name"
    }
