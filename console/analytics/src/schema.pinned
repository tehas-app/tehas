user_version 8

-- index issue_events_at
CREATE INDEX issue_events_at ON issue_events (at);

-- index runs_ended
CREATE INDEX runs_ended ON runs (ended);

-- index runs_issue
CREATE INDEX runs_issue ON runs (issue, started);

-- table issue_events
CREATE TABLE issue_events (
  at INTEGER NOT NULL,
  issue INTEGER NOT NULL,
  event TEXT NOT NULL CHECK (event IN ('ready', 'started', 'ended', 'awaiting', 'merged', 'closed', 'stopped')),
  PRIMARY KEY (issue, event)
);

-- table meta
CREATE TABLE meta (
  key TEXT PRIMARY KEY,
  value TEXT NOT NULL
);

-- table run_gate_runs
CREATE TABLE run_gate_runs (
  run_id TEXT NOT NULL REFERENCES runs (id) ON DELETE CASCADE,
  seq INTEGER NOT NULL,
  command TEXT,
  tier TEXT,
  step TEXT,
  ok INTEGER,
  ms INTEGER,
  at INTEGER,
  PRIMARY KEY (run_id, seq)
);

-- table run_roles
CREATE TABLE run_roles (
  run_id TEXT NOT NULL REFERENCES runs (id) ON DELETE CASCADE,
  role TEXT NOT NULL,
  model TEXT,
  provider TEXT,
  dispatches INTEGER,
  turns INTEGER,
  input INTEGER,
  output INTEGER,
  cache_read INTEGER,
  cache_write INTEGER,
  ms INTEGER,
  tool_calls INTEGER,
  tool_errors INTEGER,
  PRIMARY KEY (run_id, role)
);

-- table run_steps
CREATE TABLE run_steps (
  run_id TEXT NOT NULL REFERENCES runs (id) ON DELETE CASCADE,
  step TEXT NOT NULL,
  round INTEGER NOT NULL,
  started INTEGER,
  ended INTEGER,
  seconds INTEGER,
  PRIMARY KEY (run_id, step, round)
);

-- table runs
CREATE TABLE runs (
  id TEXT PRIMARY KEY,
  kind TEXT NOT NULL CHECK (kind IN ('work', 'plan')),
  issue INTEGER NOT NULL,
  attempt INTEGER,
  how TEXT,
  started INTEGER NOT NULL,
  ended INTEGER,
  seconds INTEGER,
  queue_wait INTEGER,
  outcome TEXT CHECK (outcome IN ('offered', 'merged', 'handoff', 'parked', 'failed', 'refused', 'stopped')),
  status TEXT,
  exit_code INTEGER,
  last_step TEXT,
  failed_step TEXT,
  cap TEXT,
  park_reason TEXT,
  review_held INTEGER,
  failure_kind TEXT,
  failure_cause TEXT,
  provider_outage INTEGER,
  endpoint TEXT CHECK (endpoint IN ('main', 'backup')),
  pr INTEGER,
  tehas_version TEXT,
  tehas_commit TEXT,
  rukas_version TEXT,
  rukas_commit TEXT,
  image TEXT,
  input INTEGER,
  output INTEGER,
  cache_read INTEGER,
  cache_write INTEGER,
  turns INTEGER,
  dispatches INTEGER,
  oom_kills INTEGER,
  forks_refused INTEGER,
  concurrent INTEGER,
  runner_ms INTEGER,
  result_schema INTEGER,
  gate_runs INTEGER,
  gate_ms INTEGER,
  driver TEXT CHECK (driver IN ('classic', 'lean')),
  tool_calls INTEGER,
  tool_errors INTEGER,
  result_driver TEXT CHECK (result_driver IN ('classic', 'lean'))
);

-- table samples
CREATE TABLE samples (
  at INTEGER PRIMARY KEY,
  in_line INTEGER,
  running INTEGER,
  awaiting INTEGER,
  stopped INTEGER,
  planning INTEGER,
  cycle_limit INTEGER,
  paused INTEGER,
  held TEXT
);
