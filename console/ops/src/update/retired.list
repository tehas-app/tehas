# The files an older tehas installed that this one does not, as paths under
# $TEHAS_HOME. install.sh finds each one there and removes it once systemd has
# the new units (console update retired, src/update/report.rs). One path a
# line, in the order --check names them; a line from # is a comment. A path
# that ends with a slash is a directory, removed with what it holds.
#
# The commands of before bin/tehas, one file each in bin/, and the console of
# before it was a compiled program. The libraries the bash poll sourced. The
# Protolab's server files of before the edge router. The wrappers of what is
# now a verb of the console, the libraries of what is now a verb of
# tehas-cycle, and the jq program of the bash report. The libraries whose last
# callers moved into the console, the scripts that only exec'd it, the release
# list of before it was a plain file (lib/release.list), and the scripts that
# took a lock for tehas-cycle, which takes it itself.
bin/tehas-console.ts
bin/tehas-dispatch
bin/tehas-energy
bin/tehas-health
bin/tehas-index
bin/tehas-protolab
bin/tehas-status
bin/tehas-test
bin/tehas-work
lib/analytics.sh
lib/describe.sh
lib/edge.sh
lib/history-listing.jq
lib/history-repeats.jq
lib/models.sh
lib/park-fields.jq
lib/private.sh
libexec/analytics-cmd
libexec/api
libexec/check-product
libexec/clean
libexec/dev
libexec/dispatch
libexec/github-token
libexec/improve
libexec/plan
libexec/review
libexec/console.ts
libexec/cycle
lib/limit.sh
lib/live.sh
lib/headless.sh
lib/improve.sh
lib/improve-prompt.md
lib/planning.sh
lib/refresh.sh
lib/status.sh
lib/sizing.sh
libexec/disk
libexec/drain
libexec/energy
libexec/export
libexec/health
libexec/history
libexec/index
libexec/init-product
libexec/labels
libexec/limit
libexec/mcp
libexec/pause
libexec/preview
libexec/protolab
libexec/refresh
libexec/resume
libexec/state
libexec/status
libexec/stop
libexec/summary
libexec/tidy
libexec/top
libexec/top-publish
libexec/with-settings
libexec/work
lib/disk.sh
lib/top.sh
lib/update-release.sh
lib/release.sh
lib/attachments.sh
lib/history-lines.jq
lib/cycles.sh
lib/labels.sh
lib/millwright.sh
lib/sandbox.sh
lib/slice.sh
lib/questions.sh
lib/store.sh
lib/rukas.sh
edge/protolab.Caddyfile
edge/protolab.compose.yaml
# The energy file of energy use, which left core in 2.0: nothing writes or
# reads it, and the docs server would serve the last one for ever.
live/energy.json
# The host panel's file, which left core in 2.0: nothing writes or reads it,
# and the docs server would serve the last one for ever.
live/top.json
# What outsource installed while a test turned it on: its two programs, their
# stamps, and the file of its contractors. Outsource was dropped in 2.0.
libexec/tehas-proxy
libexec/tehas-proxy.stamp
libexec/tehas-contractor
libexec/tehas-contractor.stamp
live/contractors.json
# The stand-in for vipune in the sandbox image, which sent a cycle's memory
# calls to the factory while outsource was on.
sandbox/vipune-shim
# The two directories of state/ only outsource wrote, and only while a test
# turned it on: a contractor's job files with the proxy's downloads, and the
# factory's memory of the cycles, one database a cycle, which went with each
# cycle. A cycle's own memory is in its workspace and stays. state/memory
# itself and state/images are left alone. A path that ends with a slash is a
# directory.
state/outsource/
state/memory/cycles/
# The Protolab's list of its pages and its log, parked in 2.0: nothing writes,
# reads or rotates them any more.
live/protolab.json
logs/protolab.log
logs/protolab.log.1
# The panels' copy for the dashboard, which left core in 2.0: nothing writes
# or reads it, and the docs server would serve the last one for ever.
live/panels.json
