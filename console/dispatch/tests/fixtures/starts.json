{
  "from": "console/dispatch/src/decide/starts.rs",
  "cases": [
    {"case": "a blocked issue is recorded with its reason and its edge, and the issue that started as a start",
     "queue": ["7 tehas:blocked", 8],
     "label_events": {"7": ["tehas:blocked=alice"]},
     "notes": {"7": [[10, "alice", "Blocked by #12.\n\n<!-- tehas:blocked by=12 -->"]]},
     "states": {"7": {"12": "OPEN"}},
     "expect": {"exit": 0, "picked": [8],
                "starts": ["7 blocked", "8 start"],
                "edges": [{"issue": 7, "kind": "marker", "on": 12, "by": "alice"}],
                "holds": ["12 no-approval"]}},
    {"case": "a closed blocker is no edge",
     "queue": ["7 tehas:blocked"],
     "label_events": {"7": ["tehas:blocked=alice"]},
     "notes": {"7": [[10, "alice", "<!-- tehas:blocked by=12,13 -->"]]},
     "states": {"7": {"12": "CLOSED", "13": "OPEN"}},
     "expect": {"exit": 0, "picked": [],
                "starts": ["7 blocked"],
                "edges": [{"issue": 7, "kind": "marker", "on": 13, "by": "alice"}],
                "holds": ["13 no-approval"]}},
    {"case": "an open blocked-by link is an edge that names no issue",
     "queue": [7, 8], "work": {"7": {"issue_dependencies_summary": {"blocked_by": 2}}},
     "expect": {"exit": 0, "picked": [8],
                "starts": ["7 blocked-link", "8 start"],
                "edges": [{"issue": 7, "kind": "link", "open": 2}],
                "holds": []}},
    {"case": "a ready issue the room ran out before is no-room, its own holds not read",
     "queue": [7, 8],
     "expect": {"exit": 0, "picked": [7], "starts": ["7 start", "8 no-room"]}},
    {"case": "with --only, a ranked issue that is not ready is not-ready, and a ready one outside the order waits",
     "settings": {"TEHAS_MAX_CYCLES": 3},
     "queue": [7, 8],
     "snapshot": {"order": {"state": "ok", "issues": [9, 8], "only": true}},
     "expect": {"exit": 0, "picked": [8], "starts": ["9 not-ready", "8 start", "7 not-in-order"]}},
    {"case": "a paused factory records every ranked issue as paused",
     "queue": [7],
     "snapshot": {"control": {"labels": [{"name": "tehas:pause"}]}, "order": {"state": "ok", "issues": [7], "only": false}},
     "expect": {"exit": 0, "picked": [], "starts": ["7 paused"]}},
    {"case": "a factory with no room records the ranked issues as held, with the hold's line",
     "queue": [7],
     "snapshot": {"limit": {"state": "ok", "cycles": 0, "plan": true}, "order": {"state": "ok", "issues": [7], "only": false}},
     "expect": {"picked": [], "starts": ["7 held"]}}
  ]
}
