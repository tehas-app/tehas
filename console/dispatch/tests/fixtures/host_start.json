{
  "from": "#1967: tehas start approves an issue from the host",
  "cases": [
    {"case": "an approved issue with no label starts at the next poll, from the host and with no label taken off",
     "snapshot": {"ready": [], "issues": {"12": {"events": []}},
       "host_starts": [{"issue": 12, "at": 1793404000, "body_sha256": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855", "title_sha256": null, "labels": []}]},
     "expect": {"exit": 0, "picked": [12],
       "log": ["start #12 (started from the host)"],
       "actions": [{"start": 12, "by": "host", "given": "host", "at": "2026-10-30T23:46:40Z", "remove": [], "verb": "started from the host"}]}},
    {"case": "a host start on an issue that carries tehas:ready takes the label off too",
     "snapshot": {"ready": [{"number": 12, "labels": [{"name": "tehas:ready"}]}], "issues": {"12": {"events": []}},
       "host_starts": [{"issue": 12, "at": 1793404000, "body_sha256": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855", "title_sha256": null, "labels": [{"name": "tehas:ready"}]}]},
     "expect": {"exit": 0, "picked": [12],
       "actions": [{"start": 12, "given": "host", "remove": ["tehas:ready"]}]}},
    {"case": "a paused factory starts nothing on a host approval",
     "snapshot": {"ready": [], "issues": {"12": {"events": []}},
       "pause_flag": {"by": "boss", "at": "2026-10-15T10:00:00Z", "reason": "waiting"},
       "host_starts": [{"issue": 12, "at": 1793404000, "body_sha256": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855", "title_sha256": null, "labels": []}]},
     "expect": {"exit": 0, "picked": []}},
    {"case": "a limit of no cycles starts nothing on a host approval",
     "snapshot": {"ready": [], "issues": {"12": {"events": []}},
       "limit": {"state": "ok", "cycles": 0, "plan": true},
       "host_starts": [{"issue": 12, "at": 1793404000, "body_sha256": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855", "title_sha256": null, "labels": []}]},
     "expect": {"exit": 0, "picked": []}},
    {"case": "a host approval waits while its issue's cycle runs",
     "settings": {"TEHAS_TICKET_CONCURRENCY": 2},
     "snapshot": {"ready": [], "issues": {"12": {"events": []}},
       "running": [{"issue": 12, "how": "label", "took": 1793404795, "heard": 1793404795}],
       "host_starts": [{"issue": 12, "at": 1793404000, "body_sha256": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855", "title_sha256": null, "labels": []}]},
     "expect": {"exit": 0, "picked": [], "log": ["wait #12: its cycle is still running"]}},
    {"case": "an open blocker holds a host approval",
     "snapshot": {"ready": [], "issues": {"12": {"events": [], "work": {"number": 12, "state": "open", "issue_dependencies_summary": {"blocked_by": 1}}}},
       "host_starts": [{"issue": 12, "at": 1793404000, "body_sha256": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855", "title_sha256": null, "labels": []}]},
     "expect": {"exit": 0, "picked": [], "log": ["wait #12: a blocked-by link holds it: 1 blocker is open"]}},
    {"case": "the start order holds a host approval it leaves out with only",
     "snapshot": {"ready": [], "issues": {"12": {"events": []}},
       "order": {"state": "ok", "issues": [40], "only": true},
       "host_starts": [{"issue": 12, "at": 1793404000, "body_sha256": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855", "title_sha256": null, "labels": []}]},
     "expect": {"exit": 0, "picked": [], "log": ["wait #12: not in the start order (--only)"]}},
    {"case": "the start order puts a host approval first",
     "settings": {"TEHAS_TICKET_CONCURRENCY": 3},
     "queue": [7],
     "snapshot": {"issues": {"12": {"events": []}},
       "order": {"state": "ok", "issues": [12], "only": false},
       "host_starts": [{"issue": 12, "at": 1793404000, "body_sha256": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855", "title_sha256": null, "labels": []}]},
     "expect": {"exit": 0, "picked": [12, 7]}},
    {"case": "a text changed since the host approved it starts nothing and says how to approve it again",
     "snapshot": {"ready": [], "issues": {"12": {"events": []}},
       "host_starts": [{"issue": 12, "at": 1793404000, "body_sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "title_sha256": null, "labels": []}]},
     "expect": {"exit": 0, "picked": [],
       "log": ["skip #12: its title or text changed since the host approved it at 2026-10-30T23:46:40Z; run `tehas start 12` again to approve it"]}},
    {"case": "an open pull request holds a host approval and takes no label off",
     "snapshot": {"ready": [], "issues": {"12": {"events": [], "prs": [{"state": "OPEN", "url": "https://github.com/acme/widget/pull/30"}]}},
       "host_starts": [{"issue": 12, "at": 1793404000, "body_sha256": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855", "title_sha256": null, "labels": []}]},
     "expect": {"exit": 0, "picked": [], "log": ["skip #12: pull request https://github.com/acme/widget/pull/30 is open and closes it"],
       "no_actions": [{"issue": 12}]}},
    {"case": "a list of host approvals that cannot be read starts none and the labelled issues still start",
     "queue": [7],
     "snapshot": {"host_starts": {"failed": true}},
     "expect": {"exit": 0, "picked": [7],
       "log": ["WARN: the host's approvals could not be read from the state store: no issue starts on one this poll"]}}
  ]
}
