     "snapshot": {"awaiting": [{"number": 5}]}, "expect": {"picked": [7]}},
    {"case": "at the cap nothing is started, whatever slots are free",
     "settings": {"TEHAS_TICKET_CONCURRENCY": 3, "TEHAS_MAX_AWAITING": 2}, "ready_n": [7, 8], "hold": [9],
     "snapshot": {"awaiting": [{"number": 5}]}, "dry": true,
     "expect": {"picked": [], "log": ["holding: 1 issues await merge and 1 cycles are running (limit 2)"]}},
    {"case": "an issue that is not approved does not use a slot",
     "settings": {"TEHAS_TICKET_CONCURRENCY": 2}, "ready_n": [7, 8, 9],
