     "urgent_by": {"8": "alice"},
     "expect": {"exit": 0, "picked": [8, 3]}},
    {"case": "when the urgent label events cannot be read nothing is started and no label changes",
     "settings": {"TEHAS_TICKET_CONCURRENCY": 2}, "ready_n": [3, "8!"],
     "after": {"issues": {"8": {"events": {"failed": true}}}},
     "expect": {"exit": 1, "nothing": true, "log": ["ERROR: gh api repos/acme/widget/issues/8/events?per_page=100 failed"]}},
    {"case": "label events that are not JSON end the poll, whatever label is being read",
     "settings": {"TEHAS_TICKET_CONCURRENCY": 2}, "ready_n": [3, "8!"],
     "after": {"issues": {"8": {"events": "not json"}}},
     "expect": {"exit": 1, "nothing": true, "log": ["ERROR: unreadable label events of #8"]}},
    {"case": "label events that answer with an object end the poll too",
     "settings": {"TEHAS_TICKET_CONCURRENCY": 2}, "ready_n": [3, "8!"],
     "after": {"issues": {"8": {"events": {"message": "Bad credentials"}}}},
     "expect": {"exit": 1, "nothing": true, "log": ["ERROR: unreadable label events of #8"]}},
    {"case": "a running cycle takes a slot",
     "settings": {"TEHAS_TICKET_CONCURRENCY": 2}, "ready_n": [7, 8], "hold": [9], "expect": {"picked": [7]}},
    {"case": "with every slot taken nothing is started, and no ready issue is looked at",
     "settings": {"TEHAS_TICKET_CONCURRENCY": 2}, "ready_n": [7, 8], "hold": [9, 10],
