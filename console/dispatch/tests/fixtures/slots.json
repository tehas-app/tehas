{
  "from": "test/dispatch_slots_test.sh",
  "not_ported": [
    "the index is refreshed once, before the first start: the index run is the start's (#254)",
    "the urgent labelling of an issue is read once, the ready labelling again at the decision: a count of calls (#253 part 4)",
    "a cycle that does not start does not stop the next one, and the poll ends with 1: the start is #254's"
  ],
  "cases": [
    {"case": "two slots: two issues are started in order",
     "settings": {"TEHAS_TICKET_CONCURRENCY": 2}, "ready_n": [7, 8],
     "expect": {"exit": 0, "picked": [7, 8], "actions": [
       {"start": 7, "remove": ["tehas:ready"]}, {"start": 8, "remove": ["tehas:ready"]}]}},
    {"case": "a ceiling of one: the second issue waits",
     "ready_n": [7, 8], "expect": {"picked": [7]}},
    {"case": "the ceiling defaults to the stubbed host's CPUs minus one: seven",
     "settings": {"TEHAS_TICKET_CONCURRENCY": 7}, "ready_n": [7, 8, 9, 10, 11, 12, 13, 14],
     "hold": [20, 21, 22, 23, 24, 25, 26],
     "expect": {"picked": [], "log": ["holding: 7 cycles are running (limit 7)"]}},
    {"case": "below the ceiling, no more cycles start than the containers' ceilings fit in the slice",
     "settings": {"TEHAS_TICKET_CONCURRENCY": 7}, "ready_n": [7, 8, 9, 10, 11, 12, 13, 14],
     "expect": {"picked": [7, 8, 9, 10]}},
    {"case": "below the ceiling, no more cycles start than the containers' ceilings fit in the slice: four are there",
     "settings": {"TEHAS_TICKET_CONCURRENCY": 7},
     "children": [["a", 1073741824, 0, 0], ["b", 1073741824, 0, 0], ["c", 1073741824, 0, 0], ["d", 1073741824, 0, 0]],
     "expect": {"picked": [], "log": ["holding: tehas.slice holds as many containers as their ceilings fit (4 of 5120m)"],
                "report": {"why": "full", "room": 0}}},
    {"case": "with TEHAS_SLICE_CONTAINERS=6 six cycles start in the same slice, each ceiling a sixth",
     "settings": {"TEHAS_TICKET_CONCURRENCY": 7, "TEHAS_SLICE_CONTAINERS": 6}, "ready_n": [7, 8, 9, 10, 11, 12, 13, 14],
     "expect": {"picked": [7, 8, 9, 10, 11, 12]}},
    {"case": "with TEHAS_SLICE_CONTAINERS=6 six containers fill the slice",
     "settings": {"TEHAS_TICKET_CONCURRENCY": 7, "TEHAS_SLICE_CONTAINERS": 6},
     "children": [["a", 1073741824, 0, 0], ["b", 1073741824, 0, 0], ["c", 1073741824, 0, 0], ["d", 1073741824, 0, 0], ["e", 1073741824, 0, 0], ["f", 1073741824, 0, 0]],
     "expect": {"picked": [], "log": ["holding: tehas.slice holds as many containers as their ceilings fit (6 of 3413m)"],
                "report": {"why": "full", "room": 0}}},
    {"case": "an urgent issue is started first",
     "settings": {"TEHAS_TICKET_CONCURRENCY": 2}, "ready_n": [7, "8!", 9], "expect": {"picked": [8, 7]}},
    {"case": "urgent from an allowed account moves an issue ahead of a lower number",
     "settings": {"TEHAS_TICKET_CONCURRENCY": 2}, "ready_n": [3, "8!"], "expect": {"exit": 0, "picked": [8, 3]}},
    {"case": "urgent applied by the bot is ignored, and the poll says so",
     "settings": {"TEHAS_TICKET_CONCURRENCY": 2}, "ready_n": [3, "8!"], "urgent_by": {"8": "tehas-bot"},
     "expect": {"exit": 0, "picked": [3, 8], "log": ["ignore #8: tehas:urgent was applied by 'tehas-bot', not an allowed account"]}},
    {"case": "urgent applied by an account outside the list is ignored",
     "settings": {"TEHAS_TICKET_CONCURRENCY": 2}, "ready_n": [3, "8!"], "urgent_by": {"8": "mallory"},
     "expect": {"exit": 0, "picked": [3, 8], "log": ["ignore #8: tehas:urgent was applied by 'mallory', not an allowed account"]}},
    {"case": "an urgent label with no account in its event is ignored",
     "settings": {"TEHAS_TICKET_CONCURRENCY": 2}, "ready_n": [3, "8!"], "urgent_by": {"8": ""},
     "expect": {"exit": 0, "picked": [3, 8], "log": ["ignore #8: tehas:urgent was applied by 'unknown', not an allowed account"]}},
    {"case": "an urgent label with no labelling event is ignored",
     "settings": {"TEHAS_TICKET_CONCURRENCY": 2}, "ready_n": [3, "8!"],
     "after": {"issues": {"8": {"events": [{"event": "labeled", "label": {"name": "tehas:ready"}, "actor": {"login": "alice"}}]}}},
     "expect": {"exit": 0, "picked": [3, 8], "log": ["ignore #8: tehas:urgent was applied by 'unknown', not an allowed account"]}},
    {"case": "the most recent urgent labelling decides",
     "settings": {"TEHAS_TICKET_CONCURRENCY": 2}, "ready_n": [3, "8!"],
     "after": {"issues": {"8": {"events": [
       {"event": "labeled", "label": {"name": "tehas:ready"}, "actor": {"login": "alice"}},
       {"event": "labeled", "label": {"name": "tehas:urgent"}, "actor": {"login": "mallory"}},
       {"event": "unlabeled", "label": {"name": "tehas:urgent"}, "actor": {"login": "mallory"}},
       {"event": "labeled", "label": {"name": "tehas:urgent"}, "actor": {"login": "alice"}}]}}},
     "expect": {"exit": 0, "picked": [8, 3]}},
    {"case": "an ignored urgent label leaves the issue ready on its own label",
