     "expect": {"actions": [{"start": 8, "remove": ["tehas:ready"]}]}},
    {"case": "a dry run reports the order a real poll would take",
     "settings": {"TEHAS_TICKET_CONCURRENCY": 2}, "ready_n": [3, "8!"], "urgent_by": {"8": "mallory"}, "dry": true,
     "expect": {"exit": 0, "picked": [3, 8], "nothing": true, "log": [
       "ignore #8: tehas:urgent was applied by 'mallory', not an allowed account",
       "would run a cycle for #3 (labelled by alice)\nwould run a cycle for #8 (labelled by alice)"]}},
    {"case": "an urgent issue this poll cannot start is not asked about",
