      }
     ]
    }
   },
   "expect": {
    "exit": 0,
    "picked": [],
    "nothing": true,
    "log": [
     "tehas:pause was taken off #1 by 'tehas-bot'"
    ],
    "log_lacks": [
     "would run a cycle"
    ]
   }
  },
