{
 "suite": "test/dispatch_guard_test.sh",
 "later": [
  "a poll runs tidy once, after the cycles it starts, and the other cases of tidy: the poll's end, PR 4",
  "a poll that stops before the bot's login runs no tidy: the poll's end, PR 4"
 ],
 "not_ported": [
  "the checkout, the arguments, --help and the instance's settings: the command and lib/config.sh, which run before a snapshot is read",
  "all-hands on the control issue starts nothing and holds nothing: the factory API's command, not the poll",
  "when the labels cannot be changed nothing is said on the issue, and the poll goes on: the comment follows a label change that worked, which the caller does",
  "an old record file stops the poll, and the files that do not: the store's import, read before the snapshot"
 ],
 "cases": [
  {
   "case": "a renamed repository stops the poll and says its new name",
   "snapshot": {
    "repo": "acme/gadget"
   },
   "expect": {
    "exit": 1,
    "picked": [],
    "log": [
     "ERROR: acme/widget is now acme/gadget on GitHub: set TEHAS_REPO"
    ]
   }
  },
  {
   "case": "a repository that cannot be looked up stops the poll",
   "dry": true,
   "snapshot": {
    "repo": null
   },
   "expect": {
    "exit": 1,
    "log": [
     "ERROR: gh repo view failed"
    ],
    "log_lacks": [
     "nothing to do"
    ]
   }
  },
  {
   "case": "the repository's name is compared without regard to case",
   "dry": true,
   "snapshot": {
    "repo": "Acme/Widget"
   },
   "expect": {
    "exit": 0,
    "log": [
     "would run a cycle for #7"
    ]
   }
  },
  {
   "case": "the pause label on the control issue stops dispatch",
   "dry": true,
   "snapshot": {
    "control": {
     "labels": [
      {
       "name": "tehas:pause"
      }
     ]
    }
   },
   "expect": {
    "log": [
     "paused: issue #1 carries tehas:pause"
    ],
    "picked": []
   }
  },
  {
   "case": "the pause flag stops dispatch, and deciding it asks GitHub nothing",
   "dry": true,
   "snapshot": {
    "pause_flag": {
     "by": "boss",
     "at": "2026-10-15T10:00:00Z",
     "reason": "waiting for the gate"
    },
    "control": {
     "labels": {
      "failed": true
     }
    }
   },
   "expect": {
    "exit": 0,
    "picked": [],
    "log": [
     "paused: the flag tehas pause wrote at 2026-10-15T10:00:00Z holds this host"
    ],
    "log_lacks": [
     "would run a cycle"
    ]
   }
  },
  {
   "case": "a flag that cannot be read starts nothing and is said",
   "snapshot": {
    "pause_flag": "unreadable"
   },
   "expect": {
    "exit": 0,
    "picked": [],
    "nothing": true,
    "log": [
     "state/pause.json is not a pause flag: taking it as paused"
    ]
   }
  },
  {
   "case": "a flag written by hand with no reason still holds the host",
   "dry": true,
   "snapshot": {
    "pause_flag": {
     "by": "boss",
     "at": "2026-10-15T10:00:00Z",
     "reason": ""
    }
   },
   "expect": {
    "exit": 0,
    "picked": [],
    "log": [
     "holds this host"
    ]
   }
  },
  {
   "case": "a pause the bot removed leaves the factory paused, and says who",
   "dry": true,
   "snapshot": {
    "control": {
     "events": [
      {
       "event": "labeled",
       "label": {
        "name": "tehas:pause"
       },
       "actor": {
        "login": "alice"
       },
       "created_at": "2026-10-15T09:00:00Z"
      },
      {
       "event": "unlabeled",
       "label": {
        "name": "tehas:pause"
       },
       "actor": {
        "login": "tehas-bot"
       },
